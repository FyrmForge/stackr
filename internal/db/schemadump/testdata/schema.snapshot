table shares
  col id TEXT notnull=0 default=- pk=1
  col org_id TEXT notnull=1 default=- pk=0
  col slug TEXT notnull=1 default=- pk=0
  col kind TEXT notnull=1 default=- pk=0
  col source TEXT notnull=1 default=- pk=0
  col options TEXT notnull=1 default=- pk=0
  col user TEXT notnull=1 default=- pk=0
  col password_ref TEXT notnull=1 default=- pk=0
  col created_at DATETIME notnull=1 default=- pk=0
  fk org_id -> orgs(id) on_update=NO ACTION on_delete=CASCADE
  index (auto) unique=1 origin=pk partial=0 (id)
  index (auto) unique=1 origin=u partial=0 (org_id,slug)
  sql CREATE TABLE shares ( id TEXT PRIMARY KEY, org_id TEXT NOT NULL REFERENCES orgs (id) ON DELETE CASCADE, slug TEXT NOT NULL, kind TEXT NOT NULL CHECK (kind IN ('nfs', 'smb')), source TEXT NOT NULL, options TEXT NOT NULL, user TEXT NOT NULL, password_ref TEXT NOT NULL, created_at DATETIME NOT NULL, UNIQUE (org_id, slug) )
table stacks
  col id TEXT notnull=0 default=- pk=1
  col org_id TEXT notnull=1 default=- pk=0
  col name TEXT notnull=1 default=- pk=0
  col slug TEXT notnull=1 default=- pk=0
  col description TEXT notnull=1 default=- pk=0
  col settings TEXT notnull=1 default=- pk=0
  col config_connector_id TEXT notnull=1 default=- pk=0
  col config_repo TEXT notnull=1 default=- pk=0
  col config_branch TEXT notnull=1 default=- pk=0
  col config_path TEXT notnull=1 default=- pk=0
  col created_at DATETIME notnull=1 default=- pk=0
  col placement_id TEXT notnull=0 default=- pk=0
  fk org_id -> orgs(id) on_update=NO ACTION on_delete=CASCADE
  fk placement_id -> placements(id) on_update=NO ACTION on_delete=RESTRICT
  index (auto) unique=1 origin=pk partial=0 (id)
  index (auto) unique=1 origin=u partial=0 (org_id,slug)
  sql CREATE TABLE stacks ( id TEXT PRIMARY KEY, org_id TEXT NOT NULL REFERENCES orgs (id) ON DELETE CASCADE, name TEXT NOT NULL, slug TEXT NOT NULL, description TEXT NOT NULL, settings TEXT NOT NULL, config_connector_id TEXT NOT NULL, config_repo TEXT NOT NULL, config_branch TEXT NOT NULL, config_path TEXT NOT NULL, created_at DATETIME NOT NULL, placement_id TEXT REFERENCES placements (id) ON DELETE RESTRICT, UNIQUE (org_id, slug) )
table tiers
  col id TEXT notnull=0 default=- pk=1
  col org_id TEXT notnull=1 default=- pk=0
  col slug TEXT notnull=1 default=- pk=0
  col position INTEGER notnull=1 default=- pk=0
  col locked BOOLEAN notnull=1 default=1 pk=0
  col created_at DATETIME notnull=1 default=- pk=0
  fk org_id -> orgs(id) on_update=NO ACTION on_delete=CASCADE
  index (auto) unique=1 origin=pk partial=0 (id)
  index (auto) unique=1 origin=u partial=0 (org_id,slug)
  sql CREATE TABLE tiers ( id TEXT PRIMARY KEY, org_id TEXT NOT NULL REFERENCES orgs (id) ON DELETE CASCADE, slug TEXT NOT NULL, position INTEGER NOT NULL, locked BOOLEAN NOT NULL DEFAULT 1, created_at DATETIME NOT NULL, UNIQUE (org_id, slug) )
table tile_vips
  col tile_id TEXT notnull=0 default=- pk=1
  col node_id TEXT notnull=1 default=- pk=0
  col vip TEXT notnull=1 default=- pk=0
  fk tile_id -> tiles(id) on_update=NO ACTION on_delete=CASCADE
  index (auto) unique=1 origin=pk partial=0 (tile_id)
  sql CREATE TABLE tile_vips ( tile_id TEXT PRIMARY KEY REFERENCES tiles (id) ON DELETE CASCADE, node_id TEXT NOT NULL, vip TEXT NOT NULL )
table tiles
  col id TEXT notnull=0 default=- pk=1
  col stack_id TEXT notnull=1 default=- pk=0
  col environment_id TEXT notnull=1 default=- pk=0
  col name TEXT notnull=1 default=- pk=0
  col slug TEXT notnull=1 default=- pk=0
  col kind TEXT notnull=1 default=- pk=0
  col git_url TEXT notnull=1 default=- pk=0
  col git_branch TEXT notnull=1 default=- pk=0
  col image_ref TEXT notnull=1 default=- pk=0
  col dockerfile_path TEXT notnull=1 default=- pk=0
  col build_context TEXT notnull=1 default=- pk=0
  col watch_paths TEXT notnull=1 default=- pk=0
  col env_json TEXT notnull=1 default=- pk=0
  col build_args TEXT notnull=1 default=- pk=0
  col volumes TEXT notnull=1 default=- pk=0
  col command TEXT notnull=1 default=- pk=0
  col container_port INTEGER notnull=1 default=- pk=0
  col published_ports TEXT notnull=1 default=- pk=0
  col endpoint_protocol TEXT notnull=1 default=- pk=0
  col health_path TEXT notnull=1 default=- pk=0
  col healthcheck_cmd TEXT notnull=1 default=- pk=0
  col healthcheck_interval_s INTEGER notnull=1 default=- pk=0
  col healthcheck_timeout_s INTEGER notnull=1 default=- pk=0
  col healthcheck_retries INTEGER notnull=1 default=- pk=0
  col healthcheck_start_period_s INTEGER notnull=1 default=- pk=0
  col cpu_limit REAL notnull=1 default=- pk=0
  col mem_limit_mb INTEGER notnull=1 default=- pk=0
  col user TEXT notnull=1 default=- pk=0
  col shm_size_mb INTEGER notnull=1 default=- pk=0
  col privileged INTEGER notnull=1 default=- pk=0
  col devices TEXT notnull=1 default=- pk=0
  col restart_policy TEXT notnull=1 default=- pk=0
  col depends_on TEXT notnull=1 default=- pk=0
  col files TEXT notnull=1 default=- pk=0
  col shared_net TEXT notnull=1 default=- pk=0
  col replicas INTEGER notnull=1 default=- pk=0
  col update_policy TEXT notnull=1 default=- pk=0
  col tag_policy TEXT notnull=1 default=- pk=0
  col schedule TEXT notnull=1 default=- pk=0
  col trigger TEXT notnull=1 default=- pk=0
  col paused INTEGER notnull=1 default=- pk=0
  col timeout_minutes INTEGER notnull=1 default=- pk=0
  col provision_from TEXT notnull=0 default=- pk=0
  col default_access TEXT notnull=0 default=- pk=0
  col on_remove TEXT notnull=0 default=- pk=0
  col slice_access TEXT notnull=1 default=- pk=0
  col created_at DATETIME notnull=1 default=- pk=0
  col updated_at DATETIME notnull=1 default=- pk=0
  col lan TEXT notnull=1 default='' pk=0
  col host_network INTEGER notnull=1 default=0 pk=0
  col expires_at DATETIME notnull=0 default=- pk=0
  col branch_of TEXT notnull=0 default=- pk=0
  col version_days INTEGER notnull=0 default=- pk=0
  col quota_gb INTEGER notnull=0 default=- pk=0
  col cors_origins TEXT notnull=1 default='[]' pk=0
  col slice_url TEXT notnull=0 default=- pk=0
  fk environment_id -> environments(id) on_update=NO ACTION on_delete=CASCADE
  fk stack_id -> stacks(id) on_update=NO ACTION on_delete=CASCADE
  index (auto) unique=1 origin=pk partial=0 (id)
  index (auto) unique=1 origin=u partial=0 (environment_id,slug)
  sql CREATE TABLE tiles ( id TEXT PRIMARY KEY, stack_id TEXT NOT NULL REFERENCES stacks (id) ON DELETE CASCADE, environment_id TEXT NOT NULL REFERENCES environments (id) ON DELETE CASCADE, name TEXT NOT NULL, slug TEXT NOT NULL, kind TEXT NOT NULL CHECK (kind IN ('service', 'image', 'operated', 'cron', 'function', 'slice')), git_url TEXT NOT NULL, git_branch TEXT NOT NULL, image_ref TEXT NOT NULL, dockerfile_path TEXT NOT NULL, build_context TEXT NOT NULL, watch_paths TEXT NOT NULL, env_json TEXT NOT NULL, build_args TEXT NOT NULL, volumes TEXT NOT NULL, -- mount lines: volume-slug:/container/path command TEXT NOT NULL, container_port INTEGER NOT NULL, published_ports TEXT NOT NULL, endpoint_protocol TEXT NOT NULL, health_path TEXT NOT NULL, healthcheck_cmd TEXT NOT NULL, healthcheck_interval_s INTEGER NOT NULL, healthcheck_timeout_s INTEGER NOT NULL, healthcheck_retries INTEGER NOT NULL, healthcheck_start_period_s INTEGER NOT NULL, cpu_limit REAL NOT NULL, mem_limit_mb INTEGER NOT NULL, user TEXT NOT NULL, shm_size_mb INTEGER NOT NULL, privileged INTEGER NOT NULL, devices TEXT NOT NULL, restart_policy TEXT NOT NULL, depends_on TEXT NOT NULL, files TEXT NOT NULL, shared_net TEXT NOT NULL, replicas INTEGER NOT NULL, update_policy TEXT NOT NULL CHECK (update_policy IN ('manual', 'auto')), tag_policy TEXT NOT NULL, schedule TEXT NOT NULL, -- cron: the cron expression (CRON_TZ= allowed) trigger TEXT NOT NULL CHECK (trigger IN ('', 'manual', 'on_deploy')), -- function only paused INTEGER NOT NULL, -- cron only: stored intent, the schedule is off timeout_minutes INTEGER NOT NULL, -- cron, function: a run's timeout, no cap provision_from TEXT, -- slice only: <stack>:<env>:<tile> as written, refs and all default_access TEXT CHECK (default_access IN ('read', 'write')), -- slice only on_remove TEXT CHECK (on_remove IN ('keep', 'drop')), -- slice only: the data when the tile goes slice_access TEXT NOT NULL, -- consumers: JSON [{from, access}], from a slice tile slug in this env created_at DATETIME NOT NULL, updated_at DATETIME NOT NULL, lan TEXT NOT NULL DEFAULT '', host_network INTEGER NOT NULL DEFAULT 0, expires_at DATETIME, branch_of TEXT, version_days INTEGER, quota_gb INTEGER, cors_origins TEXT NOT NULL DEFAULT '[]', slice_url TEXT CHECK (slice_url IN ('direct', 'pooled')), UNIQUE (environment_id, slug) )
table users
  col id TEXT notnull=0 default=- pk=1
  col email TEXT notnull=1 default=- pk=0
  col password_hash TEXT notnull=1 default=- pk=0
  col name TEXT notnull=1 default=- pk=0
  col role TEXT notnull=1 default=- pk=0
  col active INTEGER notnull=1 default=- pk=0
  col avatar_path TEXT notnull=1 default=- pk=0
  col theme TEXT notnull=1 default=- pk=0
  col created_at DATETIME notnull=1 default=- pk=0
  col updated_at DATETIME notnull=1 default=- pk=0
  col time_zone TEXT notnull=1 default='' pk=0
  index (auto) unique=1 origin=pk partial=0 (id)
  index (auto) unique=1 origin=u partial=0 (email)
  sql CREATE TABLE users ( id TEXT PRIMARY KEY, email TEXT NOT NULL UNIQUE, password_hash TEXT NOT NULL, name TEXT NOT NULL, role TEXT NOT NULL CHECK (role IN ('admin', 'user')), active INTEGER NOT NULL, avatar_path TEXT NOT NULL, theme TEXT NOT NULL, created_at DATETIME NOT NULL, updated_at DATETIME NOT NULL , time_zone TEXT NOT NULL DEFAULT '')
table volumes
  col id TEXT notnull=0 default=- pk=1
  col scope_kind TEXT notnull=1 default=- pk=0
  col scope_id TEXT notnull=1 default=- pk=0
  col instance_id TEXT notnull=0 default=- pk=0
  col slug TEXT notnull=1 default=- pk=0
  col name TEXT notnull=1 default=- pk=0
  col orphaned_at DATETIME notnull=0 default=- pk=0
  col created_at DATETIME notnull=1 default=- pk=0
  col node_id TEXT notnull=1 default='' pk=0
  fk instance_id -> operated_instances(id) on_update=NO ACTION on_delete=SET NULL
  index (auto) unique=1 origin=pk partial=0 (id)
  index (auto) unique=1 origin=u partial=0 (scope_kind,scope_id,slug)
  sql CREATE TABLE volumes ( id TEXT PRIMARY KEY, scope_kind TEXT NOT NULL CHECK (scope_kind IN ('env', 'stack', 'org')), scope_id TEXT NOT NULL, instance_id TEXT REFERENCES operated_instances (id) ON DELETE SET NULL, slug TEXT NOT NULL, name TEXT NOT NULL, orphaned_at DATETIME, created_at DATETIME NOT NULL, node_id TEXT NOT NULL DEFAULT '', UNIQUE (scope_kind, scope_id, slug) )
trigger backup_destinations_keep_runs: CREATE TRIGGER backup_destinations_keep_runs BEFORE DELETE ON backup_destinations WHEN EXISTS (SELECT 1 FROM backup_runs WHERE dest_id = OLD.id) AND (OLD.org_id IS NULL OR EXISTS (SELECT 1 FROM orgs WHERE id = OLD.org_id)) BEGIN SELECT RAISE(ABORT, 'backup destination still has runs'); END
trigger environments_scope_cascade: CREATE TRIGGER environments_scope_cascade AFTER DELETE ON environments BEGIN DELETE FROM params WHERE scope_kind = 'env' AND scope_id = old.id; DELETE FROM backup_schedules WHERE volume_id IN (SELECT id FROM volumes WHERE scope_kind = 'env' AND scope_id = old.id); UPDATE volumes SET orphaned_at = COALESCE(orphaned_at, CURRENT_TIMESTAMP), node_id = CASE WHEN node_id = '' THEN old.node_id ELSE node_id END WHERE scope_kind = 'env' AND scope_id = old.id; DELETE FROM positions WHERE scope_kind = 'env' AND scope_id = old.id; DELETE FROM annotations WHERE scope_kind = 'env' AND scope_id = old.id; END
trigger exit_ladders_env_cascade: CREATE TRIGGER exit_ladders_env_cascade AFTER DELETE ON environments BEGIN DELETE FROM exit_ladders WHERE scope_kind = 'env' AND scope_id = old.id; END
trigger exit_ladders_node_cascade: CREATE TRIGGER exit_ladders_node_cascade AFTER DELETE ON nodes BEGIN DELETE FROM exit_ladders WHERE scope_kind = 'node' AND scope_id = old.id; END
trigger exit_ladders_org_cascade: CREATE TRIGGER exit_ladders_org_cascade AFTER DELETE ON orgs BEGIN DELETE FROM exit_ladders WHERE scope_kind = 'org' AND scope_id = old.id; END
trigger exit_ladders_stack_cascade: CREATE TRIGGER exit_ladders_stack_cascade AFTER DELETE ON stacks BEGIN DELETE FROM exit_ladders WHERE scope_kind = 'stack' AND scope_id = old.id; END
trigger exit_ladders_tile_cascade: CREATE TRIGGER exit_ladders_tile_cascade AFTER DELETE ON tiles BEGIN DELETE FROM exit_ladders WHERE scope_kind = 'tile' AND scope_id = old.id; END
trigger ingress_picks_env_cascade: CREATE TRIGGER ingress_picks_env_cascade AFTER DELETE ON environments BEGIN DELETE FROM ingress_picks WHERE scope_kind = 'env' AND scope_id = old.id; END
trigger ingress_picks_org_cascade: CREATE TRIGGER ingress_picks_org_cascade AFTER DELETE ON orgs BEGIN DELETE FROM ingress_picks WHERE scope_kind = 'org' AND scope_id = old.id; END
trigger ingress_picks_stack_cascade: CREATE TRIGGER ingress_picks_stack_cascade AFTER DELETE ON stacks BEGIN DELETE FROM ingress_picks WHERE scope_kind = 'stack' AND scope_id = old.id; END
trigger ingress_picks_tile_cascade: CREATE TRIGGER ingress_picks_tile_cascade AFTER DELETE ON tiles BEGIN DELETE FROM ingress_picks WHERE scope_kind = 'tile' AND scope_id = old.id; END
trigger jobs_tiles_insert: CREATE TRIGGER jobs_tiles_insert AFTER INSERT ON jobs BEGIN INSERT OR IGNORE INTO job_tiles (job_id, tile_id) SELECT NEW.id, value FROM json_each(NEW.lock_set); END
trigger jobs_tiles_update: CREATE TRIGGER jobs_tiles_update AFTER UPDATE OF lock_set ON jobs WHEN OLD.lock_set IS NOT NEW.lock_set BEGIN DELETE FROM job_tiles WHERE job_id = NEW.id; INSERT OR IGNORE INTO job_tiles (job_id, tile_id) SELECT NEW.id, value FROM json_each(NEW.lock_set); END
trigger orgs_scope_cascade: CREATE TRIGGER orgs_scope_cascade AFTER DELETE ON orgs BEGIN DELETE FROM params WHERE scope_kind = 'org' AND scope_id = old.id; DELETE FROM params WHERE scope_kind = 'org_pr' AND scope_id = old.id; DELETE FROM backup_schedules WHERE volume_id IN (SELECT id FROM volumes WHERE scope_kind = 'org' AND scope_id = old.id); UPDATE volumes SET orphaned_at = COALESCE(orphaned_at, CURRENT_TIMESTAMP) WHERE scope_kind = 'org' AND scope_id = old.id; DELETE FROM positions WHERE scope_kind = 'org' AND scope_id = old.id; DELETE FROM annotations WHERE scope_kind = 'org' AND scope_id = old.id; END
trigger security_events_no_delete: CREATE TRIGGER security_events_no_delete BEFORE DELETE ON security_events WHEN NOT EXISTS (SELECT 1 FROM settings WHERE key = 'security_events_pruning') BEGIN SELECT RAISE(ABORT, 'security_events is append only'); END
trigger security_events_no_update: CREATE TRIGGER security_events_no_update BEFORE UPDATE ON security_events BEGIN SELECT RAISE(ABORT, 'security_events is append only'); END
trigger stacks_scope_cascade: CREATE TRIGGER stacks_scope_cascade AFTER DELETE ON stacks BEGIN DELETE FROM params WHERE scope_kind = 'stack_pr' AND scope_id = old.id; DELETE FROM backup_schedules WHERE volume_id IN (SELECT id FROM volumes WHERE scope_kind = 'stack' AND scope_id = old.id); UPDATE volumes SET orphaned_at = COALESCE(orphaned_at, CURRENT_TIMESTAMP) WHERE scope_kind = 'stack' AND scope_id = old.id; DELETE FROM positions WHERE scope_kind = 'stack' AND scope_id = old.id; DELETE FROM annotations WHERE scope_kind = 'stack' AND scope_id = old.id; END
trigger tiers_scope_cascade: CREATE TRIGGER tiers_scope_cascade AFTER DELETE ON tiers BEGIN DELETE FROM params WHERE scope_kind = 'tier' AND scope_id = old.id; END
