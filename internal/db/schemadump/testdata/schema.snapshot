table annotations
  col id TEXT notnull=0 default=- pk=1
  col scope_kind TEXT notnull=1 default=- pk=0
  col scope_id TEXT notnull=1 default=- pk=0
  col kind TEXT notnull=1 default=- pk=0
  col x INTEGER notnull=1 default=- pk=0
  col y INTEGER notnull=1 default=- pk=0
  col w INTEGER notnull=1 default=- pk=0
  col h INTEGER notnull=1 default=- pk=0
  col text TEXT notnull=1 default=- pk=0
  col created_at DATETIME notnull=1 default=- pk=0
  index (auto) unique=1 origin=pk partial=0 (id)
  index annotations_scope unique=0 origin=c partial=0 (scope_kind,scope_id)
  sql CREATE TABLE annotations ( id TEXT PRIMARY KEY, scope_kind TEXT NOT NULL CHECK (scope_kind IN ('home', 'org', 'stack', 'env')), scope_id TEXT NOT NULL, kind TEXT NOT NULL CHECK (kind IN ('note', 'box')), x INTEGER NOT NULL, y INTEGER NOT NULL, w INTEGER NOT NULL, h INTEGER NOT NULL, text TEXT NOT NULL, created_at DATETIME NOT NULL )
table api_keys
  col id TEXT notnull=0 default=- pk=1
  col user_id TEXT notnull=1 default=- pk=0
  col org_id TEXT notnull=0 default=- pk=0
  col name TEXT notnull=1 default=- pk=0
  col token_hash TEXT notnull=1 default=- pk=0
  col created_at DATETIME notnull=1 default=- pk=0
  col level TEXT notnull=1 default='' pk=0
  col stack_id TEXT notnull=0 default=- pk=0
  col expires_at DATETIME notnull=0 default=- pk=0
  col last_used_at DATETIME notnull=0 default=- pk=0
  fk org_id -> orgs(id) on_update=NO ACTION on_delete=CASCADE
  fk stack_id -> stacks(id) on_update=NO ACTION on_delete=CASCADE
  fk user_id -> users(id) on_update=NO ACTION on_delete=CASCADE
  index (auto) unique=1 origin=pk partial=0 (id)
  index (auto) unique=1 origin=u partial=0 (token_hash)
  sql CREATE TABLE api_keys ( id TEXT PRIMARY KEY, user_id TEXT NOT NULL REFERENCES users (id) ON DELETE CASCADE, org_id TEXT REFERENCES orgs (id) ON DELETE CASCADE, name TEXT NOT NULL, token_hash TEXT NOT NULL UNIQUE, created_at DATETIME NOT NULL , level TEXT NOT NULL DEFAULT '', stack_id TEXT REFERENCES stacks (id) ON DELETE CASCADE, expires_at DATETIME, last_used_at DATETIME)
table backup_destinations
  col id TEXT notnull=0 default=- pk=1
  col org_id TEXT notnull=0 default=- pk=0
  col kind TEXT notnull=1 default=- pk=0
  col name TEXT notnull=1 default=- pk=0
  col endpoint TEXT notnull=1 default=- pk=0
  col region TEXT notnull=1 default=- pk=0
  col bucket TEXT notnull=1 default=- pk=0
  col access_key TEXT notnull=1 default=- pk=0
  col secret_key TEXT notnull=1 default=- pk=0
  col archive_key TEXT notnull=1 default=- pk=0
  col shared INTEGER notnull=1 default=- pk=0
  col created_at DATETIME notnull=1 default=- pk=0
  col approved_endpoint TEXT notnull=1 default='' pk=0
  col approved_by TEXT notnull=1 default='' pk=0
  fk org_id -> orgs(id) on_update=NO ACTION on_delete=CASCADE
  index (auto) unique=1 origin=pk partial=0 (id)
  sql CREATE TABLE backup_destinations ( id TEXT PRIMARY KEY, org_id TEXT REFERENCES orgs (id) ON DELETE CASCADE, -- NULL = admin-global kind TEXT NOT NULL CHECK (kind IN ('local', 's3')), name TEXT NOT NULL, endpoint TEXT NOT NULL, region TEXT NOT NULL, bucket TEXT NOT NULL, access_key TEXT NOT NULL, secret_key TEXT NOT NULL, -- encrypted archive_key TEXT NOT NULL, -- encrypted shared INTEGER NOT NULL, created_at DATETIME NOT NULL , approved_endpoint TEXT NOT NULL DEFAULT '', approved_by TEXT NOT NULL DEFAULT '')
table backup_groups
  col id TEXT notnull=0 default=- pk=1
  col node_id TEXT notnull=1 default=- pk=0
  col node_name TEXT notnull=1 default=- pk=0
  col label TEXT notnull=1 default=- pk=0
  col reason TEXT notnull=1 default=- pk=0
  col dest_id TEXT notnull=1 default=- pk=0
  col warning TEXT notnull=1 default=- pk=0
  col status TEXT notnull=1 default=- pk=0
  col error TEXT notnull=1 default=- pk=0
  col created_at DATETIME notnull=1 default=- pk=0
  col finished_at DATETIME notnull=0 default=- pk=0
  index (auto) unique=1 origin=pk partial=0 (id)
  sql CREATE TABLE backup_groups ( id TEXT PRIMARY KEY, node_id TEXT NOT NULL, -- no FK: groups outlive a removed node node_name TEXT NOT NULL, label TEXT NOT NULL, -- "node h3, 14 Oct" reason TEXT NOT NULL CHECK (reason IN ('manual', 'remove')), dest_id TEXT NOT NULL, warning TEXT NOT NULL, -- "" or the local-fallback warning status TEXT NOT NULL, error TEXT NOT NULL, created_at DATETIME NOT NULL, finished_at DATETIME )
table backup_runs
  col id TEXT notnull=0 default=- pk=1
  col kind TEXT notnull=1 default=- pk=0
  col volume_id TEXT notnull=0 default=- pk=0
  col schedule_id TEXT notnull=0 default=- pk=0
  col dest_id TEXT notnull=1 default=- pk=0
  col trigger TEXT notnull=1 default=- pk=0
  col status TEXT notnull=1 default=- pk=0
  col object_key TEXT notnull=1 default=- pk=0
  col size_bytes INTEGER notnull=1 default=- pk=0
  col error TEXT notnull=1 default=- pk=0
  col created_at DATETIME notnull=1 default=- pk=0
  col finished_at DATETIME notnull=0 default=- pk=0
  col group_id TEXT notnull=0 default=- pk=0
  col recovery_gen INTEGER notnull=1 default=0 pk=0
  col master_gen INTEGER notnull=1 default=0 pk=0
  col wal_start TEXT notnull=0 default=- pk=0
  col wal_stop TEXT notnull=0 default=- pk=0
  fk dest_id -> backup_destinations(id) on_update=NO ACTION on_delete=CASCADE
  fk group_id -> backup_groups(id) on_update=NO ACTION on_delete=SET NULL
  fk schedule_id -> backup_schedules(id) on_update=NO ACTION on_delete=SET NULL
  fk volume_id -> volumes(id) on_update=NO ACTION on_delete=SET NULL
  index (auto) unique=1 origin=pk partial=0 (id)
  index backup_runs_dest unique=0 origin=c partial=0 (dest_id)
  index backup_runs_group unique=0 origin=c partial=0 (group_id)
  index backup_runs_kind unique=0 origin=c partial=0 (kind)
  index backup_runs_volume unique=0 origin=c partial=0 (volume_id)
  sql CREATE TABLE backup_runs ( id TEXT PRIMARY KEY, kind TEXT NOT NULL CHECK (kind IN ('volume', 'panel')), volume_id TEXT REFERENCES volumes (id) ON DELETE SET NULL, schedule_id TEXT REFERENCES backup_schedules (id) ON DELETE SET NULL, dest_id TEXT NOT NULL REFERENCES backup_destinations (id) ON DELETE CASCADE, trigger TEXT NOT NULL, status TEXT NOT NULL, object_key TEXT NOT NULL, size_bytes INTEGER NOT NULL, error TEXT NOT NULL, created_at DATETIME NOT NULL, finished_at DATETIME , group_id TEXT REFERENCES backup_groups (id) ON DELETE SET NULL, recovery_gen INTEGER NOT NULL DEFAULT 0, master_gen INTEGER NOT NULL DEFAULT 0, wal_start TEXT, wal_stop TEXT)
table backup_schedules
  col id TEXT notnull=0 default=- pk=1
  col volume_id TEXT notnull=1 default=- pk=0
  col method TEXT notnull=1 default=- pk=0
  col dest_id TEXT notnull=0 default=- pk=0
  col cron TEXT notnull=1 default=- pk=0
  col timezone TEXT notnull=1 default=- pk=0
  col keep INTEGER notnull=1 default=- pk=0
  col mode TEXT notnull=1 default=- pk=0
  col created_at DATETIME notnull=1 default=- pk=0
  fk dest_id -> backup_destinations(id) on_update=NO ACTION on_delete=SET NULL
  fk volume_id -> volumes(id) on_update=NO ACTION on_delete=CASCADE
  index (auto) unique=1 origin=pk partial=0 (id)
  sql CREATE TABLE backup_schedules ( id TEXT PRIMARY KEY, volume_id TEXT NOT NULL REFERENCES volumes (id) ON DELETE CASCADE, method TEXT NOT NULL, dest_id TEXT REFERENCES backup_destinations (id) ON DELETE SET NULL, -- NULL = local default cron TEXT NOT NULL, timezone TEXT NOT NULL, keep INTEGER NOT NULL, mode TEXT NOT NULL, created_at DATETIME NOT NULL )
table bindings
  col id TEXT notnull=0 default=- pk=1
  col provision_id TEXT notnull=1 default=- pk=0
  col consumer_tile_id TEXT notnull=1 default=- pk=0
  col access TEXT notnull=1 default=- pk=0
  col db_user TEXT notnull=1 default=- pk=0
  col db_password TEXT notnull=1 default=- pk=0
  col outputs TEXT notnull=1 default=- pk=0
  col created_at DATETIME notnull=1 default=- pk=0
  fk consumer_tile_id -> tiles(id) on_update=NO ACTION on_delete=CASCADE
  fk provision_id -> provisions(id) on_update=NO ACTION on_delete=CASCADE
  index (auto) unique=1 origin=pk partial=0 (id)
  index (auto) unique=1 origin=u partial=0 (provision_id,consumer_tile_id)
  sql CREATE TABLE bindings ( id TEXT PRIMARY KEY, provision_id TEXT NOT NULL REFERENCES provisions (id) ON DELETE CASCADE, consumer_tile_id TEXT NOT NULL REFERENCES tiles (id) ON DELETE CASCADE, access TEXT NOT NULL CHECK (access IN ('read', 'write')), db_user TEXT NOT NULL, db_password TEXT NOT NULL, -- encrypted outputs TEXT NOT NULL, -- encrypted JSON created_at DATETIME NOT NULL, UNIQUE (provision_id, consumer_tile_id) )
table cluster_ca
  col id INTEGER notnull=0 default=- pk=1
  col current_fp TEXT notnull=1 default=- pk=0
  col previous_fp TEXT notnull=1 default='' pk=0
  col rollover_started_at DATETIME notnull=0 default=- pk=0
  col rollover_finished_at DATETIME notnull=0 default=- pk=0
  col break_glass_at DATETIME notnull=0 default=- pk=0
  sql CREATE TABLE cluster_ca ( id INTEGER PRIMARY KEY CHECK (id = 1), current_fp TEXT NOT NULL, previous_fp TEXT NOT NULL DEFAULT '', rollover_started_at DATETIME, rollover_finished_at DATETIME, break_glass_at DATETIME )
table connector_shares
  col connector_id TEXT notnull=1 default=- pk=1
  col org_id TEXT notnull=1 default=- pk=2
  fk connector_id -> connectors(id) on_update=NO ACTION on_delete=CASCADE
  fk org_id -> orgs(id) on_update=NO ACTION on_delete=CASCADE
  index (auto) unique=1 origin=pk partial=0 (connector_id,org_id)
  index connector_shares_org unique=0 origin=c partial=0 (org_id)
  sql CREATE TABLE connector_shares ( connector_id TEXT NOT NULL REFERENCES connectors (id) ON DELETE CASCADE, org_id TEXT NOT NULL REFERENCES orgs (id) ON DELETE CASCADE, PRIMARY KEY (connector_id, org_id) )
table connectors
  col id TEXT notnull=0 default=- pk=1
  col org_id TEXT notnull=0 default=- pk=0
  col kind TEXT notnull=1 default=- pk=0
  col name TEXT notnull=1 default=- pk=0
  col host TEXT notnull=1 default=- pk=0
  col settings TEXT notnull=1 default=- pk=0
  col created_at DATETIME notnull=1 default=- pk=0
  col share_all INTEGER notnull=1 default=0 pk=0
  col capabilities TEXT notnull=1 default='["git"]' pk=0
  col checked_at DATETIME notnull=0 default=- pk=0
  col check_error TEXT notnull=1 default='' pk=0
  fk org_id -> orgs(id) on_update=NO ACTION on_delete=CASCADE
  index (auto) unique=1 origin=pk partial=0 (id)
  index (auto) unique=1 origin=u partial=0 (org_id,host)
  index connectors_org_kind unique=1 origin=c partial=0 (org_id,kind)
  index connectors_server_name unique=1 origin=c partial=1 (name) where org_id IS NULL
  sql CREATE TABLE "connectors" ( id TEXT PRIMARY KEY, org_id TEXT REFERENCES orgs (id) ON DELETE CASCADE, kind TEXT NOT NULL, name TEXT NOT NULL, host TEXT NOT NULL, settings TEXT NOT NULL, -- encrypted: holds the App private key created_at DATETIME NOT NULL, share_all INTEGER NOT NULL DEFAULT 0, capabilities TEXT NOT NULL DEFAULT '["git"]', checked_at DATETIME, check_error TEXT NOT NULL DEFAULT '', -- server connector: every org may use it UNIQUE (org_id, host) )
table credentials
  col id TEXT notnull=0 default=- pk=1
  col org_id TEXT notnull=1 default=- pk=0
  col name TEXT notnull=1 default=- pk=0
  col url TEXT notnull=1 default=- pk=0
  col username TEXT notnull=1 default=- pk=0
  col password TEXT notnull=1 default=- pk=0
  col created_at DATETIME notnull=1 default=- pk=0
  fk org_id -> orgs(id) on_update=NO ACTION on_delete=CASCADE
  index (auto) unique=1 origin=pk partial=0 (id)
  index (auto) unique=1 origin=u partial=0 (org_id,name)
  sql CREATE TABLE credentials ( id TEXT PRIMARY KEY, org_id TEXT NOT NULL REFERENCES orgs (id) ON DELETE CASCADE, name TEXT NOT NULL, url TEXT NOT NULL, username TEXT NOT NULL, password TEXT NOT NULL, -- encrypted created_at DATETIME NOT NULL, UNIQUE (org_id, name) )
table dns_domains
  col id TEXT notnull=0 default=- pk=1
  col connector_id TEXT notnull=1 default=- pk=0
  col org_id TEXT notnull=0 default=- pk=0
  col name TEXT notnull=1 default=- pk=0
  col share_all INTEGER notnull=1 default=- pk=0
  col org_ids TEXT notnull=1 default=- pk=0
  col created_at DATETIME notnull=1 default=- pk=0
  col resource_id TEXT notnull=0 default=- pk=0
  col scope TEXT notnull=1 default='' pk=0
  col records TEXT notnull=1 default='[]' pk=0
  fk connector_id -> connectors(id) on_update=NO ACTION on_delete=CASCADE
  fk org_id -> orgs(id) on_update=NO ACTION on_delete=CASCADE
  fk resource_id -> domain_resources(id) on_update=NO ACTION on_delete=SET NULL
  index (auto) unique=1 origin=pk partial=0 (id)
  index (auto) unique=1 origin=u partial=0 (name)
  index dns_domains_connector unique=0 origin=c partial=0 (connector_id)
  sql CREATE TABLE dns_domains ( id TEXT PRIMARY KEY, connector_id TEXT NOT NULL REFERENCES connectors (id) ON DELETE CASCADE, org_id TEXT REFERENCES orgs (id) ON DELETE CASCADE, name TEXT NOT NULL UNIQUE, share_all INTEGER NOT NULL, org_ids TEXT NOT NULL, created_at DATETIME NOT NULL , resource_id TEXT REFERENCES domain_resources (id) ON DELETE SET NULL, scope TEXT NOT NULL DEFAULT '', records TEXT NOT NULL DEFAULT '[]')
table dns_records
  col id TEXT notnull=0 default=- pk=1
  col dns_domain_id TEXT notnull=0 default=- pk=0
  col zone TEXT notnull=1 default=- pk=0
  col name TEXT notnull=1 default=- pk=0
  col type TEXT notnull=1 default=- pk=0
  col value TEXT notnull=1 default=- pk=0
  col ttl INTEGER notnull=1 default=- pk=0
  col domain_id TEXT notnull=0 default=- pk=0
  col created_at DATETIME notnull=1 default=- pk=0
  col adopted INTEGER notnull=1 default=0 pk=0
  col kind TEXT notnull=1 default='app' pk=0
  col put_back_at DATETIME notnull=0 default=- pk=0
  col handed_back_at DATETIME notnull=0 default=- pk=0
  fk dns_domain_id -> dns_domains(id) on_update=NO ACTION on_delete=SET NULL
  fk domain_id -> domains(id) on_update=NO ACTION on_delete=SET NULL
  index (auto) unique=1 origin=pk partial=0 (id)
  index dns_records_addr unique=1 origin=c partial=1 (zone,name,type) where kind != 'custom' AND handed_back_at IS NULL
  index dns_records_custom unique=1 origin=c partial=1 (zone,name,type,value) where kind = 'custom' AND handed_back_at IS NULL
  sql CREATE TABLE "dns_records" ( id TEXT PRIMARY KEY, dns_domain_id TEXT REFERENCES dns_domains (id) ON DELETE SET NULL, zone TEXT NOT NULL, name TEXT NOT NULL, type TEXT NOT NULL, value TEXT NOT NULL, ttl INTEGER NOT NULL, domain_id TEXT REFERENCES domains (id) ON DELETE SET NULL, created_at DATETIME NOT NULL, adopted INTEGER NOT NULL DEFAULT 0, kind TEXT NOT NULL DEFAULT 'app', put_back_at DATETIME, handed_back_at DATETIME )
table domain_resources
  col id TEXT notnull=0 default=- pk=1
  col level TEXT notnull=1 default=- pk=0
  col org_id TEXT notnull=0 default=- pk=0
  col stack_id TEXT notnull=0 default=- pk=0
  col host TEXT notnull=1 default=- pk=0
  col include_env_on_default INTEGER notnull=1 default=- pk=0
  col acme_email TEXT notnull=1 default=- pk=0
  col declared INTEGER notnull=1 default=- pk=0
  col created_at DATETIME notnull=1 default=- pk=0
  fk org_id -> orgs(id) on_update=NO ACTION on_delete=CASCADE
  fk stack_id -> stacks(id) on_update=NO ACTION on_delete=CASCADE
  index (auto) unique=1 origin=pk partial=0 (id)
  index (auto) unique=1 origin=u partial=0 (host)
  sql CREATE TABLE domain_resources ( id TEXT PRIMARY KEY, level TEXT NOT NULL CHECK (level IN ('instance', 'org', 'stack')), org_id TEXT REFERENCES orgs (id) ON DELETE CASCADE, stack_id TEXT REFERENCES stacks (id) ON DELETE CASCADE, host TEXT NOT NULL UNIQUE, include_env_on_default INTEGER NOT NULL, acme_email TEXT NOT NULL, declared INTEGER NOT NULL, created_at DATETIME NOT NULL, CHECK ( (level = 'instance' AND org_id IS NULL AND stack_id IS NULL) OR (level = 'org' AND org_id IS NOT NULL AND stack_id IS NULL) OR (level = 'stack' AND org_id IS NULL AND stack_id IS NOT NULL) ) )
table domains
  col id TEXT notnull=0 default=- pk=1
  col tile_id TEXT notnull=1 default=- pk=0
  col host TEXT notnull=1 default=- pk=0
  col path TEXT notnull=1 default=- pk=0
  col container_port INTEGER notnull=1 default=- pk=0
  col https INTEGER notnull=1 default=- pk=0
  col force_https INTEGER notnull=1 default=- pk=0
  col redirect_to TEXT notnull=1 default=- pk=0
  col auto INTEGER notnull=1 default=- pk=0
  col resource_id TEXT notnull=0 default=- pk=0
  col position INTEGER notnull=1 default=- pk=0
  col proxy_json TEXT notnull=1 default=- pk=0
  col raw_caddy TEXT notnull=1 default=- pk=0
  col created_at DATETIME notnull=1 default=- pk=0
  col records TEXT notnull=1 default='[]' pk=0
  fk resource_id -> domain_resources(id) on_update=NO ACTION on_delete=NO ACTION
  fk tile_id -> tiles(id) on_update=NO ACTION on_delete=CASCADE
  index (auto) unique=1 origin=pk partial=0 (id)
  index idx_domains_host_path unique=1 origin=c partial=0 (host,path)
  sql CREATE TABLE domains ( id TEXT PRIMARY KEY, tile_id TEXT NOT NULL REFERENCES tiles (id) ON DELETE CASCADE, host TEXT NOT NULL, path TEXT NOT NULL, container_port INTEGER NOT NULL, https INTEGER NOT NULL, force_https INTEGER NOT NULL, redirect_to TEXT NOT NULL, auto INTEGER NOT NULL, -- the resource that named an auto or apex host; NULL for a literal. -- A resource that names one cannot be deleted. NO ACTION, not RESTRICT: -- RESTRICT fires mid-cascade, so an org or stack delete would fail on -- its own resource before the cascade reached the tile's domains. resource_id TEXT REFERENCES domain_resources (id), position INTEGER NOT NULL, proxy_json TEXT NOT NULL, raw_caddy TEXT NOT NULL, -- admin-only created_at DATETIME NOT NULL , records TEXT NOT NULL DEFAULT '[]')
table env_moves
  col id TEXT notnull=0 default=- pk=1
  col env_id TEXT notnull=1 default=- pk=0
  col from_node TEXT notnull=1 default=- pk=0
  col to_node TEXT notnull=1 default=- pk=0
  col live BOOLEAN notnull=1 default=- pk=0
  col phase TEXT notnull=1 default=- pk=0
  col bytes INTEGER notnull=1 default=- pk=0
  col started_at DATETIME notnull=1 default=- pk=0
  col finished_at DATETIME notnull=0 default=- pk=0
  col error TEXT notnull=1 default=- pk=0
  col placement_move_id TEXT notnull=0 default=- pk=0
  fk env_id -> environments(id) on_update=NO ACTION on_delete=CASCADE
  index (auto) unique=1 origin=pk partial=0 (id)
  index env_moves_env unique=0 origin=c partial=0 (env_id,started_at)
  sql CREATE TABLE env_moves ( id TEXT PRIMARY KEY, env_id TEXT NOT NULL REFERENCES environments (id) ON DELETE CASCADE, from_node TEXT NOT NULL, to_node TEXT NOT NULL, live BOOLEAN NOT NULL, phase TEXT NOT NULL CHECK (phase IN ('queued', 'syncing', 'stopping', 'copying', 'final', 'starting', 'cleaning', 'done', 'rolled_back')), bytes INTEGER NOT NULL, started_at DATETIME NOT NULL, finished_at DATETIME, error TEXT NOT NULL , placement_move_id TEXT)
table environments
  col id TEXT notnull=0 default=- pk=1
  col stack_id TEXT notnull=1 default=- pk=0
  col name TEXT notnull=1 default=- pk=0
  col slug TEXT notnull=1 default=- pk=0
  col type TEXT notnull=1 default=- pk=0
  col base_env_id TEXT notnull=0 default=- pk=0
  col settings TEXT notnull=1 default=- pk=0
  col color TEXT notnull=1 default=- pk=0
  col position INTEGER notnull=1 default=- pk=0
  col network TEXT notnull=1 default=- pk=0
  col release_id TEXT notnull=0 default=- pk=0
  col from_kind TEXT notnull=1 default=- pk=0
  col from_branch TEXT notnull=1 default=- pk=0
  col auto INTEGER notnull=1 default=- pk=0
  col created_at DATETIME notnull=1 default=- pk=0
  col locked BOOLEAN notnull=1 default=1 pk=0
  col node_id TEXT notnull=1 default='' pk=0
  col subnet TEXT notnull=1 default='' pk=0
  col placement_id TEXT notnull=1 default='' pk=0
  fk base_env_id -> environments(id) on_update=NO ACTION on_delete=SET NULL
  fk release_id -> releases(id) on_update=NO ACTION on_delete=SET NULL
  fk stack_id -> stacks(id) on_update=NO ACTION on_delete=CASCADE
  index (auto) unique=1 origin=pk partial=0 (id)
  index (auto) unique=1 origin=u partial=0 (stack_id,slug)
  sql CREATE TABLE environments ( id TEXT PRIMARY KEY, stack_id TEXT NOT NULL REFERENCES stacks (id) ON DELETE CASCADE, name TEXT NOT NULL, slug TEXT NOT NULL, type TEXT NOT NULL CHECK (type IN ('static', 'ephemeral')), base_env_id TEXT REFERENCES environments (id) ON DELETE SET NULL, settings TEXT NOT NULL, color TEXT NOT NULL, position INTEGER NOT NULL, network TEXT NOT NULL, release_id TEXT REFERENCES releases (id) ON DELETE SET NULL, from_kind TEXT NOT NULL CHECK (from_kind IN ('branch', 'promote')), from_branch TEXT NOT NULL, auto INTEGER NOT NULL, created_at DATETIME NOT NULL, locked BOOLEAN NOT NULL DEFAULT 1, node_id TEXT NOT NULL DEFAULT '', subnet TEXT NOT NULL DEFAULT '', placement_id TEXT NOT NULL DEFAULT '', UNIQUE (stack_id, slug) )
table exit_ladders
  col scope_kind TEXT notnull=1 default=- pk=1
  col scope_id TEXT notnull=1 default=- pk=2
  col position INTEGER notnull=1 default=- pk=3
  col target_id TEXT notnull=1 default=- pk=0
  index (auto) unique=1 origin=pk partial=0 (scope_kind,scope_id,position)
  index (auto) unique=1 origin=u partial=0 (scope_kind,scope_id,target_id)
  index exit_ladders_node unique=0 origin=c partial=0 (target_id)
  sql CREATE TABLE "exit_ladders" ( scope_kind TEXT NOT NULL CHECK (scope_kind IN ('org', 'stack', 'env', 'tile', 'node')), scope_id TEXT NOT NULL, position INTEGER NOT NULL CHECK (position >= 0), target_id TEXT NOT NULL, PRIMARY KEY (scope_kind, scope_id, position), UNIQUE (scope_kind, scope_id, target_id) )
