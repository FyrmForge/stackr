  col id TEXT notnull=0 default=- pk=1
  col scope_kind TEXT notnull=1 default=- pk=0
  col scope_id TEXT notnull=1 default=- pk=0
  col instance_id TEXT notnull=0 default=- pk=0
  col slug TEXT notnull=1 default=- pk=0
  col name TEXT notnull=1 default=- pk=0
  col orphaned_at DATETIME notnull=0 default=- pk=0
  col created_at DATETIME notnull=1 default=- pk=0
  col node_id TEXT notnull=1 default='' pk=0
  fk instance_id -> managed_instances(id) on_update=NO ACTION on_delete=SET NULL
  index (auto) unique=1 origin=pk partial=0 (id)
  index (auto) unique=1 origin=u partial=0 (scope_kind,scope_id,slug)
trigger backup_destinations_keep_runs: CREATE TRIGGER backup_destinations_keep_runs BEFORE DELETE ON backup_destinations WHEN EXISTS (SELECT 1 FROM backup_runs WHERE dest_id = OLD.id) AND (OLD.org_id IS NULL OR EXISTS (SELECT 1 FROM orgs WHERE id = OLD.org_id)) BEGIN SELECT RAISE(ABORT, 'backup destination still has runs'); END
trigger environments_scope_cascade: CREATE TRIGGER environments_scope_cascade AFTER DELETE ON environments BEGIN DELETE FROM params WHERE scope_kind = 'env' AND scope_id = old.id; DELETE FROM backup_schedules WHERE volume_id IN (SELECT id FROM volumes WHERE scope_kind = 'env' AND scope_id = old.id); UPDATE volumes SET orphaned_at = COALESCE(orphaned_at, CURRENT_TIMESTAMP), node_id = CASE WHEN node_id = '' THEN old.node_id ELSE node_id END WHERE scope_kind = 'env' AND scope_id = old.id; DELETE FROM positions WHERE scope_kind = 'env' AND scope_id = old.id; DELETE FROM annotations WHERE scope_kind = 'env' AND scope_id = old.id; END
trigger exit_ladders_env_cascade: CREATE TRIGGER exit_ladders_env_cascade AFTER DELETE ON environments BEGIN DELETE FROM exit_ladders WHERE scope_kind = 'env' AND scope_id = old.id; END
trigger exit_ladders_node_cascade: CREATE TRIGGER exit_ladders_node_cascade AFTER DELETE ON nodes BEGIN DELETE FROM exit_ladders WHERE scope_kind = 'node' AND scope_id = old.id; END
trigger exit_ladders_org_cascade: CREATE TRIGGER exit_ladders_org_cascade AFTER DELETE ON orgs BEGIN DELETE FROM exit_ladders WHERE scope_kind = 'org' AND scope_id = old.id; END
trigger exit_ladders_stack_cascade: CREATE TRIGGER exit_ladders_stack_cascade AFTER DELETE ON stacks BEGIN DELETE FROM exit_ladders WHERE scope_kind = 'stack' AND scope_id = old.id; END
trigger exit_ladders_tile_cascade: CREATE TRIGGER exit_ladders_tile_cascade AFTER DELETE ON tiles BEGIN DELETE FROM exit_ladders WHERE scope_kind = 'tile' AND scope_id = old.id; END
trigger ingress_picks_env_cascade: CREATE TRIGGER ingress_picks_env_cascade AFTER DELETE ON environments BEGIN DELETE FROM ingress_picks WHERE scope_kind = 'env' AND scope_id = old.id; END
trigger ingress_picks_org_cascade: CREATE TRIGGER ingress_picks_org_cascade AFTER DELETE ON orgs BEGIN DELETE FROM ingress_picks WHERE scope_kind = 'org' AND scope_id = old.id; END
trigger ingress_picks_stack_cascade: CREATE TRIGGER ingress_picks_stack_cascade AFTER DELETE ON stacks BEGIN DELETE FROM ingress_picks WHERE scope_kind = 'stack' AND scope_id = old.id; END
trigger ingress_picks_tile_cascade: CREATE TRIGGER ingress_picks_tile_cascade AFTER DELETE ON tiles BEGIN DELETE FROM ingress_picks WHERE scope_kind = 'tile' AND scope_id = old.id; END
trigger jobs_tiles_insert: CREATE TRIGGER jobs_tiles_insert AFTER INSERT ON jobs BEGIN INSERT OR IGNORE INTO job_tiles (job_id, tile_id) SELECT NEW.id, value FROM json_each(NEW.lock_set); END
trigger jobs_tiles_update: CREATE TRIGGER jobs_tiles_update AFTER UPDATE OF lock_set ON jobs WHEN OLD.lock_set IS NOT NEW.lock_set BEGIN DELETE FROM job_tiles WHERE job_id = NEW.id; INSERT OR IGNORE INTO job_tiles (job_id, tile_id) SELECT NEW.id, value FROM json_each(NEW.lock_set); END
trigger orgs_scope_cascade: CREATE TRIGGER orgs_scope_cascade AFTER DELETE ON orgs BEGIN DELETE FROM params WHERE scope_kind = 'org' AND scope_id = old.id; DELETE FROM params WHERE scope_kind = 'org_pr' AND scope_id = old.id; DELETE FROM backup_schedules WHERE volume_id IN (SELECT id FROM volumes WHERE scope_kind = 'org' AND scope_id = old.id); UPDATE volumes SET orphaned_at = COALESCE(orphaned_at, CURRENT_TIMESTAMP) WHERE scope_kind = 'org' AND scope_id = old.id; DELETE FROM positions WHERE scope_kind = 'org' AND scope_id = old.id; DELETE FROM annotations WHERE scope_kind = 'org' AND scope_id = old.id; END
trigger security_events_no_delete: CREATE TRIGGER security_events_no_delete BEFORE DELETE ON security_events WHEN NOT EXISTS (SELECT 1 FROM settings WHERE key = 'security_events_pruning') BEGIN SELECT RAISE(ABORT, 'security_events is append only'); END
trigger security_events_no_update: CREATE TRIGGER security_events_no_update BEFORE UPDATE ON security_events BEGIN SELECT RAISE(ABORT, 'security_events is append only'); END
trigger stacks_scope_cascade: CREATE TRIGGER stacks_scope_cascade AFTER DELETE ON stacks BEGIN DELETE FROM params WHERE scope_kind = 'stack_pr' AND scope_id = old.id; DELETE FROM backup_schedules WHERE volume_id IN (SELECT id FROM volumes WHERE scope_kind = 'stack' AND scope_id = old.id); UPDATE volumes SET orphaned_at = COALESCE(orphaned_at, CURRENT_TIMESTAMP) WHERE scope_kind = 'stack' AND scope_id = old.id; DELETE FROM positions WHERE scope_kind = 'stack' AND scope_id = old.id; DELETE FROM annotations WHERE scope_kind = 'stack' AND scope_id = old.id; END
trigger tiers_scope_cascade: CREATE TRIGGER tiers_scope_cascade AFTER DELETE ON tiers BEGIN DELETE FROM params WHERE scope_kind = 'tier' AND scope_id = old.id; END
