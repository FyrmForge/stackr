  sql CREATE TABLE host_grants ( id TEXT PRIMARY KEY, stack_id TEXT NOT NULL UNIQUE REFERENCES stacks (id) ON DELETE CASCADE, lines TEXT NOT NULL, approved_by TEXT NOT NULL REFERENCES users (id), created_at DATETIME NOT NULL )
