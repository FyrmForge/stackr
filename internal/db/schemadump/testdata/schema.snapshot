  index runs_status unique=0 origin=c partial=0 (status)
  index runs_tile unique=0 origin=c partial=0 (tile_id,created_at)
  sql CREATE TABLE runs ( id TEXT PRIMARY KEY, tile_id TEXT NOT NULL REFERENCES tiles (id) ON DELETE CASCADE, release_id TEXT REFERENCES releases (id) ON DELETE SET NULL, job_id TEXT NOT NULL, -- '' when the run never got a job (cancelled at the door) trigger TEXT NOT NULL CHECK (trigger IN ('schedule', 'manual', 'deploy')), status TEXT NOT NULL CHECK (status IN ('queued', 'running', 'ok', 'failed', 'cancelled')), exit_code INTEGER, reason TEXT NOT NULL, created_at DATETIME NOT NULL, started_at DATETIME, finished_at DATETIME , peak_mem_bytes INTEGER, cpu_ms INTEGER)
table security_events
  col id TEXT notnull=0 default=- pk=1
  col at DATETIME notnull=1 default=- pk=0
  col action TEXT notnull=1 default=- pk=0
  col actor_id TEXT notnull=1 default='' pk=0
  col key_id TEXT notnull=1 default='' pk=0
  col target_kind TEXT notnull=1 default='' pk=0
  col target_id TEXT notnull=1 default='' pk=0
  col ip TEXT notnull=1 default='' pk=0
  col user_agent TEXT notnull=1 default='' pk=0
  col detail TEXT notnull=1 default='' pk=0
  index (auto) unique=1 origin=pk partial=0 (id)
  index security_events_action unique=0 origin=c partial=0 (action,at)
  index security_events_actor unique=0 origin=c partial=0 (actor_id,at)
  index security_events_at unique=0 origin=c partial=0 (at)
  index security_events_target unique=0 origin=c partial=0 (target_kind,target_id,at)
  sql CREATE TABLE security_events ( id TEXT PRIMARY KEY, at DATETIME NOT NULL, action TEXT NOT NULL, actor_id TEXT NOT NULL DEFAULT '', -- user id, '' = nobody (a failed login) key_id TEXT NOT NULL DEFAULT '', -- the API key behind the act, if any target_kind TEXT NOT NULL DEFAULT '', target_id TEXT NOT NULL DEFAULT '', ip TEXT NOT NULL DEFAULT '', user_agent TEXT NOT NULL DEFAULT '', detail TEXT NOT NULL DEFAULT '' )
table server_config_plans
  col id TEXT notnull=0 default=- pk=1
  col commit_sha TEXT notnull=1 default=- pk=0
  col summary TEXT notnull=1 default=- pk=0
  col plan TEXT notnull=1 default=- pk=0
  col status TEXT notnull=1 default=- pk=0
  col error TEXT notnull=1 default=- pk=0
  col created_at DATETIME notnull=1 default=- pk=0
  col decided_at DATETIME notnull=0 default=- pk=0
  col source TEXT notnull=1 default=- pk=0
  col file TEXT notnull=1 default=- pk=0
  col ticked TEXT notnull=1 default='[]' pk=0
  col confirmed INTEGER notnull=1 default=0 pk=0
  index (auto) unique=1 origin=pk partial=0 (id)
  index server_config_plans_created unique=0 origin=c partial=0 (created_at DESC)
  sql CREATE TABLE server_config_plans ( id TEXT PRIMARY KEY, commit_sha TEXT NOT NULL, summary TEXT NOT NULL, plan TEXT NOT NULL, -- JSON serverconfig.Plan status TEXT NOT NULL CHECK (status IN ('pending', 'clean', 'error', 'superseded', 'applied', 'rejected')), error TEXT NOT NULL, created_at DATETIME NOT NULL, decided_at DATETIME, source TEXT NOT NULL CHECK (source IN ('repo', 'local')), file TEXT NOT NULL, ticked TEXT NOT NULL DEFAULT '[]', confirmed INTEGER NOT NULL DEFAULT 0 )
table sessions
  col id TEXT notnull=0 default=- pk=1
  col subject_id TEXT notnull=0 default=- pk=0
  col token TEXT notnull=1 default=- pk=0
  col expires_at DATETIME notnull=1 default=- pk=0
  col created_at DATETIME notnull=1 default=CURRENT_TIMESTAMP pk=0
  index (auto) unique=1 origin=pk partial=0 (id)
  index (auto) unique=1 origin=u partial=0 (token)
  index idx_sessions_subject_id unique=0 origin=c partial=1 (subject_id) where subject_id IS NOT NULL
  index idx_sessions_token unique=0 origin=c partial=0 (token)
  sql CREATE TABLE sessions ( id TEXT PRIMARY KEY, subject_id TEXT, token TEXT NOT NULL UNIQUE, expires_at DATETIME NOT NULL, created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP )
table settings
  col key TEXT notnull=0 default=- pk=1
  col value TEXT notnull=1 default=- pk=0
