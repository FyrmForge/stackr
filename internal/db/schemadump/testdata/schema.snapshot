  col secret_key TEXT notnull=1 default=- pk=0
  col archive_key TEXT notnull=1 default=- pk=0
  col shared INTEGER notnull=1 default=- pk=0
  col created_at DATETIME notnull=1 default=- pk=0
  col approved_endpoint TEXT notnull=1 default='' pk=0
  col approved_by TEXT notnull=1 default='' pk=0
  fk org_id -> orgs(id) on_update=NO ACTION on_delete=CASCADE
  index (auto) unique=1 origin=pk partial=0 (id)
table backup_groups
  col id TEXT notnull=0 default=- pk=1
  col node_id TEXT notnull=1 default=- pk=0
  col node_name TEXT notnull=1 default=- pk=0
  col label TEXT notnull=1 default=- pk=0
  col reason TEXT notnull=1 default=- pk=0
  col dest_id TEXT notnull=1 default=- pk=0
  col warning TEXT notnull=1 default=- pk=0
  col status TEXT notnull=1 default=- pk=0
  col error TEXT notnull=1 default=- pk=0
  col created_at DATETIME notnull=1 default=- pk=0
  col finished_at DATETIME notnull=0 default=- pk=0
  index (auto) unique=1 origin=pk partial=0 (id)
table backup_runs
  col id TEXT notnull=0 default=- pk=1
  col kind TEXT notnull=1 default=- pk=0
  col volume_id TEXT notnull=0 default=- pk=0
  col schedule_id TEXT notnull=0 default=- pk=0
  col dest_id TEXT notnull=1 default=- pk=0
  col trigger TEXT notnull=1 default=- pk=0
  col status TEXT notnull=1 default=- pk=0
  col object_key TEXT notnull=1 default=- pk=0
  col size_bytes INTEGER notnull=1 default=- pk=0
  col error TEXT notnull=1 default=- pk=0
  col created_at DATETIME notnull=1 default=- pk=0
  col finished_at DATETIME notnull=0 default=- pk=0
  col group_id TEXT notnull=0 default=- pk=0
  col recovery_gen INTEGER notnull=1 default=0 pk=0
  col master_gen INTEGER notnull=1 default=0 pk=0
  fk dest_id -> backup_destinations(id) on_update=NO ACTION on_delete=CASCADE
  fk group_id -> backup_groups(id) on_update=NO ACTION on_delete=SET NULL
  fk schedule_id -> backup_schedules(id) on_update=NO ACTION on_delete=SET NULL
  fk volume_id -> volumes(id) on_update=NO ACTION on_delete=SET NULL
  index (auto) unique=1 origin=pk partial=0 (id)
  index backup_runs_dest unique=0 origin=c partial=0 (dest_id)
  index backup_runs_group unique=0 origin=c partial=0 (group_id)
  index backup_runs_kind unique=0 origin=c partial=0 (kind)
  index backup_runs_volume unique=0 origin=c partial=0 (volume_id)
table backup_schedules
  col id TEXT notnull=0 default=- pk=1
  col volume_id TEXT notnull=1 default=- pk=0
  col method TEXT notnull=1 default=- pk=0
  col dest_id TEXT notnull=0 default=- pk=0
  col cron TEXT notnull=1 default=- pk=0
  col timezone TEXT notnull=1 default=- pk=0
  col keep INTEGER notnull=1 default=- pk=0
  col mode TEXT notnull=1 default=- pk=0
  col created_at DATETIME notnull=1 default=- pk=0
  fk dest_id -> backup_destinations(id) on_update=NO ACTION on_delete=SET NULL
  fk volume_id -> volumes(id) on_update=NO ACTION on_delete=CASCADE
  index (auto) unique=1 origin=pk partial=0 (id)
table bindings
  col id TEXT notnull=0 default=- pk=1
  col provision_id TEXT notnull=1 default=- pk=0
  col consumer_tile_id TEXT notnull=1 default=- pk=0
  col access TEXT notnull=1 default=- pk=0
  col db_user TEXT notnull=1 default=- pk=0
  col db_password TEXT notnull=1 default=- pk=0
  col outputs TEXT notnull=1 default=- pk=0
  col created_at DATETIME notnull=1 default=- pk=0
  fk consumer_tile_id -> tiles(id) on_update=NO ACTION on_delete=CASCADE
  fk provision_id -> provisions(id) on_update=NO ACTION on_delete=CASCADE
  index (auto) unique=1 origin=pk partial=0 (id)
  index (auto) unique=1 origin=u partial=0 (provision_id,consumer_tile_id)
table cluster_ca
  col id INTEGER notnull=0 default=- pk=1
  col current_fp TEXT notnull=1 default=- pk=0
  col previous_fp TEXT notnull=1 default='' pk=0
  col rollover_started_at DATETIME notnull=0 default=- pk=0
  col rollover_finished_at DATETIME notnull=0 default=- pk=0
  col break_glass_at DATETIME notnull=0 default=- pk=0
table connector_shares
  col connector_id TEXT notnull=1 default=- pk=1
  col org_id TEXT notnull=1 default=- pk=2
  fk connector_id -> connectors(id) on_update=NO ACTION on_delete=CASCADE
  fk org_id -> orgs(id) on_update=NO ACTION on_delete=CASCADE
  index (auto) unique=1 origin=pk partial=0 (connector_id,org_id)
  index connector_shares_org unique=0 origin=c partial=0 (org_id)
table connectors
  col id TEXT notnull=0 default=- pk=1
  col org_id TEXT notnull=0 default=- pk=0
  col kind TEXT notnull=1 default=- pk=0
  col name TEXT notnull=1 default=- pk=0
  col host TEXT notnull=1 default=- pk=0
  col settings TEXT notnull=1 default=- pk=0
  col created_at DATETIME notnull=1 default=- pk=0
  col share_all INTEGER notnull=1 default=0 pk=0
  col capabilities TEXT notnull=1 default='["git"]' pk=0
  col checked_at DATETIME notnull=0 default=- pk=0
  col check_error TEXT notnull=1 default='' pk=0
  fk org_id -> orgs(id) on_update=NO ACTION on_delete=CASCADE
  index (auto) unique=1 origin=pk partial=0 (id)
  index (auto) unique=1 origin=u partial=0 (org_id,host)
  index connectors_org_kind unique=1 origin=c partial=0 (org_id,kind)
  index connectors_server_name unique=1 origin=c partial=1 (name) where org_id IS NULL
table credentials
  col id TEXT notnull=0 default=- pk=1
  col org_id TEXT notnull=1 default=- pk=0
  col name TEXT notnull=1 default=- pk=0
  col url TEXT notnull=1 default=- pk=0
  col username TEXT notnull=1 default=- pk=0
  col password TEXT notnull=1 default=- pk=0
  col created_at DATETIME notnull=1 default=- pk=0
  fk org_id -> orgs(id) on_update=NO ACTION on_delete=CASCADE
  index (auto) unique=1 origin=pk partial=0 (id)
  index (auto) unique=1 origin=u partial=0 (org_id,name)
table dns_domains
  col id TEXT notnull=0 default=- pk=1
  col connector_id TEXT notnull=1 default=- pk=0
  col org_id TEXT notnull=0 default=- pk=0
  col name TEXT notnull=1 default=- pk=0
  col share_all INTEGER notnull=1 default=- pk=0
  col org_ids TEXT notnull=1 default=- pk=0
  col created_at DATETIME notnull=1 default=- pk=0
  col resource_id TEXT notnull=0 default=- pk=0
  col scope TEXT notnull=1 default='' pk=0
  col records TEXT notnull=1 default='[]' pk=0
  fk connector_id -> connectors(id) on_update=NO ACTION on_delete=CASCADE
  fk org_id -> orgs(id) on_update=NO ACTION on_delete=CASCADE
  fk resource_id -> domain_resources(id) on_update=NO ACTION on_delete=SET NULL
  index (auto) unique=1 origin=pk partial=0 (id)
  index (auto) unique=1 origin=u partial=0 (name)
  index dns_domains_connector unique=0 origin=c partial=0 (connector_id)
table dns_records
  col id TEXT notnull=0 default=- pk=1
  col dns_domain_id TEXT notnull=0 default=- pk=0
  col zone TEXT notnull=1 default=- pk=0
  col name TEXT notnull=1 default=- pk=0
  col type TEXT notnull=1 default=- pk=0
  col value TEXT notnull=1 default=- pk=0
  col ttl INTEGER notnull=1 default=- pk=0
  col domain_id TEXT notnull=0 default=- pk=0
  col created_at DATETIME notnull=1 default=- pk=0
  col adopted INTEGER notnull=1 default=0 pk=0
  col kind TEXT notnull=1 default='app' pk=0
  col put_back_at DATETIME notnull=0 default=- pk=0
  col handed_back_at DATETIME notnull=0 default=- pk=0
  fk dns_domain_id -> dns_domains(id) on_update=NO ACTION on_delete=SET NULL
  fk domain_id -> domains(id) on_update=NO ACTION on_delete=SET NULL
  index (auto) unique=1 origin=pk partial=0 (id)
  index dns_records_addr unique=1 origin=c partial=1 (zone,name,type) where kind != 'custom' AND handed_back_at IS NULL
  index dns_records_custom unique=1 origin=c partial=1 (zone,name,type,value) where kind = 'custom' AND handed_back_at IS NULL
table domain_resources
  col id TEXT notnull=0 default=- pk=1
