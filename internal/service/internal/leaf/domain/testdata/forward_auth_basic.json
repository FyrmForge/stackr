{
  "admin": {
    "listen": "0.0.0.0:2019"
  },
  "apps": {
    "http": {
      "servers": {
        "http": {
          "listen": [
            ":80"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "static_response",
                  "headers": {
                    "Location": [
                      "https://{http.request.host}{http.request.uri}"
                    ]
                  },
                  "status_code": 308
                }
              ],
              "match": [
                {
                  "host": [
                    "app.example.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 404
                }
              ]
            }
          ]
        },
        "https": {
          "automatic_https": {
            "disable_redirects": true
          },
          "listen": [
            ":443"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "authentication",
                  "providers": {
                    "http_basic": {
                      "accounts": [
                        {
                          "password": "<bcrypt>",
                          "username": "u"
                        }
                      ],
                      "hash": {
                        "algorithm": "bcrypt"
                      }
                    }
                  }
                },
                {
                  "handle_response": [
                    {
                      "match": {
                        "status_code": [
                          2
                        ]
                      },
                      "routes": [
                        {
                          "handle": [
                            {
                              "handler": "vars"
                            }
                          ]
                        },
                        {
                          "handle": [
                            {
                              "handler": "headers",
                              "request": {
                                "delete": [
                                  "X-User"
                                ]
                              }
                            }
                          ]
                        },
                        {
                          "handle": [
                            {
                              "handler": "headers",
                              "request": {
                                "set": {
                                  "X-User": [
                                    "{http.reverse_proxy.header.X-User}"
                                  ]
                                }
                              }
                            }
                          ],
                          "match": [
                            {
                              "not": [
                                {
                                  "vars": {
                                    "{http.reverse_proxy.header.X-User}": [
                                      ""
                                    ]
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "routes": [
                        {
                          "handle": [
                            {
                              "handler": "copy_response"
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "handler": "reverse_proxy",
                  "headers": {
                    "request": {
                      "delete": [
                        "X-Original-Url",
                        "X-Original-Method"
                      ],
                      "set": {
                        "Host": [
                          "{http.reverse_proxy.upstream.hostport}"
                        ],
                        "X-Forwarded-Host": [
                          "{http.request.host}"
                        ],
                        "X-Forwarded-Method": [
                          "{http.request.method}"
                        ],
                        "X-Forwarded-Uri": [
                          "{http.request.uri}"
                        ]
                      }
                    }
                  },
                  "rewrite": {
                    "method": "GET",
                    "uri": "/?"
                  },
                  "upstreams": [
                    {
                      "dial": "authelia:9091"
                    }
                  ]
                },
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "web-r1:8080"
                    },
                    {
                      "dial": "web-r2:8080"
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "app.example.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 404
                }
              ]
            }
          ]
        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          {
            "issuers": [
              {
                "email": "ops@stackr.io",
                "module": "acme"
              }
            ]
          }
        ]
      }
    }
  }
}
