{
  "admin": {
    "listen": "0.0.0.0:2019"
  },
  "apps": {
    "http": {
      "servers": {
        "http": {
          "listen": [
            ":80"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "static_response",
                  "headers": {
                    "Location": [
                      "https://app.example.com{http.request.uri}"
                    ]
                  },
                  "status_code": 301
                }
              ],
              "match": [
                {
                  "host": [
                    "old.example.com"
                  ]
                }
              ],
              "terminal": true
            }
          ]
        },
        "https": {
          "automatic_https": {
            "disable_redirects": true
          },
          "listen": [
            ":443"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "static_response",
                  "headers": {
                    "Location": [
                      "https://app.example.com{http.request.uri}"
                    ]
                  },
                  "status_code": 301
                }
              ],
              "match": [
                {
                  "host": [
                    "old.example.com"
                  ]
                }
              ],
              "terminal": true
            }
          ]
        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          {
            "issuers": [
              {
                "email": "ops@stackr.io",
                "module": "acme"
              }
            ]
          }
        ]
      }
    }
  }
}
