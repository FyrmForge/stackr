{
  "admin": {
    "listen": "0.0.0.0:2019"
  },
  "apps": {
    "http": {
      "servers": {
        "http": {
          "listen": [
            ":80"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "static_response",
                  "headers": {
                    "Location": [
                      "https://{http.request.host}{http.request.uri}"
                    ]
                  },
                  "status_code": 308
                }
              ],
              "match": [
                {
                  "host": [
                    "app.example.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "10.0.0.5:80"
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "pve.example.com"
                  ]
                }
              ],
              "terminal": true
            }
          ]
        },
        "https": {
          "automatic_https": {
            "disable_redirects": true
          },
          "listen": [
            ":443"
          ],
          "listener_wrappers": [
            {
              "routes": [
                {
                  "handle": [
                    {
                      "handler": "proxy",
                      "upstreams": [
                        {
                          "dial": [
                            "10.0.0.5:443"
                          ]
                        }
                      ]
                    }
                  ],
                  "match": [
                    {
                      "tls": {
                        "sni": [
                          "pve.example.com"
                        ]
                      }
                    }
                  ]
                }
              ],
              "wrapper": "layer4"
            },
            {
              "wrapper": "tls"
            }
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "web-r1:8080"
                    },
                    {
                      "dial": "web-r2:8080"
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "app.example.com"
                  ]
                }
              ],
              "terminal": true
            }
          ]
        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          {
            "issuers": [
              {
                "email": "ops@stackr.io",
                "module": "acme"
              }
            ]
          }
        ]
      }
    }
  }
}
