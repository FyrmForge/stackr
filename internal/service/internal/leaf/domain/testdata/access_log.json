{
  "admin": {
    "listen": "0.0.0.0:2019"
  },
  "apps": {
    "http": {
      "metrics": {
        "per_host": true
      },
      "servers": {
        "http": {
          "listen": [
            ":80"
          ],
          "logs": {},
          "routes": [
            {
              "handle": [
                {
                  "early": true,
                  "handler": "log_append",
                  "key": "user_agent",
                  "value": "{http.request.header.User-Agent}"
                }
              ]
            },
            {
              "handle": [
                {
                  "handler": "static_response",
                  "headers": {
                    "Location": [
                      "https://{http.request.host}{http.request.uri}"
                    ]
                  },
                  "status_code": 308
                }
              ],
              "match": [
                {
                  "host": [
                    "app.example.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 404
                }
              ]
            }
          ]
        },
        "https": {
          "automatic_https": {
            "disable_redirects": true
          },
          "listen": [
            ":443"
          ],
          "logs": {},
          "routes": [
            {
              "handle": [
                {
                  "early": true,
                  "handler": "log_append",
                  "key": "user_agent",
                  "value": "{http.request.header.User-Agent}"
                }
              ]
            },
            {
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "web-r1:8080"
                    },
                    {
                      "dial": "web-r2:8080"
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "app.example.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 404
                }
              ]
            }
          ]
        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          {
            "issuers": [
              {
                "email": "ops@stackr.io",
                "module": "acme"
              }
            ]
          }
        ]
      }
    }
  },
  "logging": {
    "logs": {
      "access": {
        "encoder": {
          "fields": {
            "request\u003eheaders": {
              "filter": "delete"
            },
            "request\u003euri": {
              "filter": "regexp",
              "regexp": "\\?.*$",
              "value": ""
            },
            "resp_headers": {
              "filter": "delete"
            }
          },
          "format": "filter",
          "wrap": {
            "format": "json"
          }
        },
        "include": [
          "http.log.access"
        ],
        "writer": {
          "output": "stdout"
        }
      },
      "default": {
        "exclude": [
          "http.log.access"
        ]
      }
    }
  }
}
