package filebrowse

import (
	"net/url"
	"path"

	"github.com/labstack/echo/v4"

	"github.com/FyrmForge/stackr/internal/stackrd/infra/runtime"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components/form"
)

func browseURL(base, dir string) string {
	return base + "?path=" + url.QueryEscape(dir)
}

// Browser is the listing fragment. base is the files route it re-fetches
// itself from; every navigation swaps the whole fragment in place.
templ Browser(c echo.Context, base, dir string, entries []Entry, canWrite bool) {
	<div id="file-browser">
		<div class="flex items-center gap-1 text-xs font-mono text-rw-muted mb-2 flex-wrap">
			for i, cr := range crumbs(dir) {
				if i > 0 {
					<span class="text-rw-faint">/</span>
				}
				<button type="button" hx-get={ browseURL(base, cr.Path) } hx-target="#file-browser" hx-swap="outerHTML" class="hover:text-rw-text transition-colors">{ cr.Name }</button>
			}
		</div>
		if len(entries) == 0 {
			<div class="rounded-xl border border-dashed border-rw-border flex flex-col items-center py-10">
				<svg class="h-6 w-6 text-rw-faint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
					<path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path>
				</svg>
				<p class="text-xs text-rw-faint mt-3">Nothing here yet</p>
				if canWrite {
					<p class="text-[11px] text-rw-faint/70 mt-1">Upload a file to get started</p>
				}
			</div>
		} else {
			<div class="panel overflow-x-auto">
				<table class="w-full text-sm">
					<tbody>
						for _, e := range entries {
							<tr class="border-b border-rw-border last:border-0">
								<td class="px-3 py-1.5 font-mono">
									if e.Dir {
										<button type="button" hx-get={ browseURL(base, path.Join(dir, e.Name)) } hx-target="#file-browser" hx-swap="outerHTML" class="link">{ e.Name + "/" }</button>
									} else {
										<span class="text-rw-text">{ e.Name }</span>
									}
								</td>
								<td class="px-3 py-1.5 text-right text-xs text-rw-muted whitespace-nowrap">
									if !e.Dir {
										{ runtime.FmtBytes(e.Size) }
									}
								</td>
								<td class="px-3 py-1.5 text-xs text-rw-faint whitespace-nowrap">
									if !e.ModTime.IsZero() {
										{ e.ModTime.Format("Jan 2 2006 15:04") }
									}
								</td>
								<td class="px-3 py-1.5 text-right whitespace-nowrap">
									if !e.Dir {
										<a href={ templ.SafeURL(base + "/download?path=" + url.QueryEscape(path.Join(dir, e.Name))) } class="text-xs link mr-2">Download</a>
									}
									if canWrite {
										<form hx-post={ base + "/delete" } hx-target="#file-browser" hx-swap="outerHTML" hx-confirm={ "Delete " + e.Name + "? This cannot be undone." } class="inline">
											@form.CSRFField(c)
											<input type="hidden" name="path" value={ dir }/>
											<input type="hidden" name="target" value={ path.Join(dir, e.Name) }/>
											if e.Dir {
												<input type="hidden" name="dir" value="1"/>
											}
											<button type="submit" class="text-xs text-rw-danger hover:text-rw-text transition-colors">Delete</button>
										</form>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		if canWrite {
			// One button: picking a file submits immediately, no separate
			// Upload step, no native "No file chosen" widget.
			<form hx-post={ base + "/upload" } hx-target="#file-browser" hx-swap="outerHTML" hx-encoding="multipart/form-data" class="mt-3">
				@form.CSRFField(c)
				<input type="hidden" name="path" value={ dir }/>
				<label class="btn btn-ghost btn-sm cursor-pointer inline-flex items-center gap-1.5">
					<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"></path><path d="m7 8 5-5 5 5"></path><path d="M5 21h14"></path></svg>
					Upload file
					<input type="file" name="file" required class="hidden" onchange="this.form.requestSubmit()"/>
				</label>
			</form>
		}
	</div>
}

// ErrorFrag keeps the fragment (and a way back) when a backend op fails.
templ ErrorFrag(base, msg string) {
	<div id="file-browser">
		<p class="text-xs text-rw-danger break-all">{ msg }</p>
		<button type="button" hx-get={ browseURL(base, "/") } hx-target="#file-browser" hx-swap="outerHTML" class="btn btn-ghost btn-sm mt-2">Back to root</button>
	</div>
}

// Loader lazy-loads the browser when its tab opens.
templ Loader(base string) {
	<div hx-get={ browseURL(base, "/") } hx-trigger="load" hx-swap="outerHTML">
		<p class="text-xs text-rw-faint">Loading…</p>
	</div>
}
