package search

// resultList is the fragment htmx swaps into #search-results on every
// keystroke. Rows are plain links, the palette JS in main.js drives
// arrow-key selection via the data-search-row hooks.
templ resultList(rs []result, q string) {
	if q == "" {
		<p class="px-4 py-6 text-sm text-rw-faint">Search stacks, tiles, variables, settings…</p>
	} else if len(rs) == 0 {
		<p class="px-4 py-6 text-sm text-rw-faint">No matches for “{ q }”.</p>
	} else {
		for _, r := range rs {
			<a href={ templ.SafeURL(r.Href) } data-search-row class="flex items-center gap-3 px-4 py-2 text-sm transition-colors hover:bg-rw-raised">
				<span class="shrink-0 w-24 text-xs px-1.5 py-0.5 rounded bg-rw-inset text-rw-faint text-center truncate">{ r.Kind }</span>
				<span class="truncate text-rw-text">{ r.Title }</span>
				if r.Context != "" {
					<span class="ml-auto truncate text-xs text-rw-faint">{ r.Context }</span>
				}
			</a>
		}
	}
}
