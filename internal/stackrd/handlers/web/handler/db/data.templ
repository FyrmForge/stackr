package db

import (
	"net/url"
	"strconv"

	"github.com/labstack/echo/v4"

	"github.com/FyrmForge/stackr/internal/stackrd/infra/managedtiles"
	"github.com/FyrmForge/stackr/internal/stackrd/store/repo"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components/form"
)

// url builds the fragment's own URL for a page of the current table.
func (v dataView) url(page int) string {
	q := url.Values{"db": {v.sc.creds.DB}, "table": {v.table}, "page": {strconv.Itoa(page)}}
	if v.sc.locked {
		q.Set("locked", "1")
	}
	return v.sc.base + "?" + q.Encode()
}

// levelURL addresses a drill-down level: no db = the database list, db
// without table = that database's table list, both = the grid.
func (v dataView) levelURL(db, table string) string {
	q := url.Values{}
	if db != "" {
		q.Set("db", db)
	}
	if table != "" {
		q.Set("table", table)
	}
	if v.sc.locked {
		q.Set("locked", "1")
	}
	if len(q) == 0 {
		return v.sc.base
	}
	return v.sc.base + "?" + q.Encode()
}

// cellURL is the inline-edit form endpoint for one cell.
func (v dataView) cellURL(ctid, col, val string) string {
	q := url.Values{"db": {v.sc.creds.DB}, "table": {v.table}, "page": {strconv.Itoa(v.page)},
		"ctid": {ctid}, "col": {col}, "val": {val}}
	if v.sc.locked {
		q.Set("locked", "1")
	}
	return v.sc.base + "/cell?" + q.Encode()
}

func (v dataView) pages() int {
	n := int(v.total) / pgPageSize
	if int(v.total)%pgPageSize != 0 || n == 0 {
		n++
	}
	return n
}

// dataHidden carries the scope through every mutating form.
templ dataHidden(v dataView) {
	<input type="hidden" name="db" value={ v.sc.creds.DB }/>
	<input type="hidden" name="table" value={ v.table }/>
	<input type="hidden" name="page" value={ strconv.Itoa(v.page) }/>
	if v.sc.locked {
		<input type="hidden" name="locked" value="1"/>
	}
}

// dataBrowser is the tables/rows grid. Everything it does swaps the whole
// fragment back in place.
templ dataBrowser(c echo.Context, v dataView) {
	<div id="data-browser">
		<div class="flex items-center gap-1 text-xs font-mono text-rw-muted mb-3 flex-wrap">
			if !v.sc.locked {
				<button type="button" hx-get={ v.levelURL("", "") } hx-target="#data-browser" hx-swap="outerHTML" class="hover:text-rw-text transition-colors">databases</button>
			}
			if v.sc.chosen {
				if !v.sc.locked {
					<span class="text-rw-faint">/</span>
				}
				<button type="button" hx-get={ v.levelURL(v.sc.creds.DB, "") } hx-target="#data-browser" hx-swap="outerHTML" class="hover:text-rw-text transition-colors">{ v.sc.creds.DB }</button>
			}
			if v.table != "" {
				<span class="text-rw-faint">/</span>
				<span class="text-rw-text">{ v.table }</span>
				<span class="ml-auto text-rw-faint">{ strconv.FormatInt(v.total, 10) } rows</span>
			}
		</div>
		if v.banner != "" {
			<p class="text-xs text-rw-danger break-all mb-2">{ v.banner }</p>
		}
		if v.err != "" {
			<p class="text-xs text-rw-danger break-all">{ v.err }</p>
		} else if v.atDBs {
			<div class="panel">
				for _, db := range v.sc.dbs {
					<button type="button" hx-get={ v.levelURL(db, "") } hx-target="#data-browser" hx-swap="outerHTML" class="flex items-center justify-between w-full px-4 py-2.5 border-b border-rw-border last:border-0 text-left hover:bg-rw-raised transition-colors">
						<span class="text-sm font-mono text-rw-text">{ db }</span>
						if db == v.sc.d.DBName {
							<span class="text-[10px] px-1.5 py-0.5 rounded bg-rw-inset text-rw-faint">primary</span>
						} else {
							<span class="text-[10px] px-1.5 py-0.5 rounded bg-rw-inset text-rw-faint">provisioned</span>
						}
					</button>
				}
			</div>
		} else if v.table == "" {
			if len(v.tables) == 0 {
				<div class="rounded-xl border border-dashed border-rw-border flex flex-col items-center py-10">
					<svg class="h-6 w-6 text-rw-faint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
						<ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
						<path d="M3 5v14a9 3 0 0 0 18 0V5"></path>
						<path d="M3 12a9 3 0 0 0 18 0"></path>
					</svg>
					<p class="text-xs text-rw-faint mt-3">No tables in this database yet</p>
				</div>
			} else {
				<div class="panel">
					for _, t := range v.tables {
						<button type="button" hx-get={ v.levelURL(v.sc.creds.DB, t) } hx-target="#data-browser" hx-swap="outerHTML" class="flex items-center w-full px-4 py-2.5 border-b border-rw-border last:border-0 text-left hover:bg-rw-raised transition-colors">
							<span class="text-sm font-mono text-rw-text">{ t }</span>
						</button>
					}
				</div>
			}
		} else {
				<div class="panel overflow-x-auto">
					<table class="w-full text-sm">
						<thead>
							<tr class="border-b border-rw-border">
								for _, col := range v.cols {
									<th class="px-3 py-2 text-left text-xs font-semibold text-rw-faint whitespace-nowrap">{ col }</th>
								}
								if v.canWrite {
									<th></th>
								}
							</tr>
						</thead>
						<tbody>
							for _, row := range v.rows {
								<tr class="border-b border-rw-border last:border-0">
									for i, col := range v.cols {
										<td class="px-3 py-1.5 font-mono text-xs max-w-64 truncate" title={ cellTitle(row[i+1]) }>
											if v.canWrite {
												<button type="button" hx-get={ v.cellURL(row[0], col, cellEditValue(row[i+1])) } hx-target="closest td" hx-swap="innerHTML" class="block w-full text-left truncate hover:text-rw-accent transition-colors">
													@cellValue(row[i+1])
												</button>
											} else {
												@cellValue(row[i+1])
											}
										</td>
									}
									if v.canWrite {
										<td class="px-3 py-1.5 text-right">
											<form hx-post={ v.sc.base + "/delete" } hx-target="#data-browser" hx-swap="outerHTML" hx-confirm="Delete this row?">
												@form.CSRFField(c)
												@dataHidden(v)
												<input type="hidden" name="ctid" value={ row[0] }/>
												<button type="submit" class="text-xs text-rw-danger hover:text-rw-text transition-colors">Delete</button>
											</form>
										</td>
									}
								</tr>
							}
						</tbody>
					</table>
				</div>
				<div class="flex items-center gap-2 mt-3">
					if v.page > 1 {
						<button type="button" hx-get={ v.url(v.page - 1) } hx-target="#data-browser" hx-swap="outerHTML" class="btn btn-ghost btn-sm">&larr; Prev</button>
					}
					if v.pages() > 1 {
						<span class="text-xs text-rw-faint">page { strconv.Itoa(v.page) } / { strconv.Itoa(v.pages()) }</span>
					}
					if v.page < v.pages() {
						<button type="button" hx-get={ v.url(v.page + 1) } hx-target="#data-browser" hx-swap="outerHTML" class="btn btn-ghost btn-sm">Next &rarr;</button>
					}
				</div>
				if v.canWrite {
					<details class="mt-4">
						<summary class="text-xs text-rw-muted cursor-pointer hover:text-rw-text transition-colors">Add row</summary>
						<form hx-post={ v.sc.base + "/insert" } hx-target="#data-browser" hx-swap="outerHTML" class="mt-2 space-y-2">
							@form.CSRFField(c)
							@dataHidden(v)
							<div class="flex flex-wrap gap-2">
								for _, col := range v.cols {
									<div>
										<label class="label font-mono">{ col }</label>
										<input type="text" name={ "v_" + col } placeholder="default" class="input w-40 font-mono text-xs"/>
									</div>
								}
							</div>
							<button type="submit" class="btn btn-primary btn-sm">Insert</button>
							<p class="text-xs text-rw-faint">Empty fields use the column default.</p>
						</form>
				</details>
			}
		}
	</div>
}

// cellValue renders one cell: NULL faint, everything else as-is.
templ cellValue(raw string) {
	if raw == managedtiles.PGNull {
		<span class="text-rw-faint italic">NULL</span>
	} else if raw == "" {
		<span class="text-rw-faint">&nbsp;</span>
	} else {
		{ raw }
	}
}

func cellTitle(raw string) string {
	if raw == managedtiles.PGNull {
		return "NULL"
	}
	return raw
}

// cellEditValue is what the edit form prefills, NULLs start empty.
func cellEditValue(raw string) string {
	if raw == managedtiles.PGNull {
		return ""
	}
	return raw
}

// dataCellForm swaps into a <td>: input + save/cancel + a NULL checkbox.
templ dataCellForm(c echo.Context, sc *dataScope, table, page, ctid, col, val string) {
	<form hx-post={ sc.base + "/update" } hx-target="#data-browser" hx-swap="outerHTML" class="flex items-center gap-1.5">
		@form.CSRFField(c)
		<input type="hidden" name="db" value={ sc.creds.DB }/>
		<input type="hidden" name="table" value={ table }/>
		<input type="hidden" name="page" value={ page }/>
		if sc.locked {
			<input type="hidden" name="locked" value="1"/>
		}
		<input type="hidden" name="ctid" value={ ctid }/>
		<input type="hidden" name="col" value={ col }/>
		<input type="text" name="value" value={ val } autofocus class="input font-mono text-xs !py-0.5 min-w-32"/>
		<label class="flex items-center gap-1 text-[10px] text-rw-faint whitespace-nowrap">
			<input type="checkbox" name="null" value="1"/>
			NULL
		</label>
		<button type="submit" class="text-xs text-rw-success hover:text-rw-text transition-colors">Save</button>
		<button type="button" hx-get={ sc.base + "?" + cellCancelQuery(sc, table, page) } hx-target="#data-browser" hx-swap="outerHTML" class="text-xs text-rw-muted hover:text-rw-text transition-colors">Cancel</button>
	</form>
}

func cellCancelQuery(sc *dataScope, table, page string) string {
	q := url.Values{"db": {sc.creds.DB}, "table": {table}, "page": {page}}
	if sc.locked {
		q.Set("locked", "1")
	}
	return q.Encode()
}

// pgDBPanel is the drawer behind a postgres slice card: Overview for the
// facts, Database for the grid, one provisioned database, browsed with its
// own credentials.
templ pgDBPanel(d *repo.Tile, p *repo.Provision, tab string) {
	<div class="flex items-center justify-between px-6 py-5 border-b border-rw-border">
		<div class="flex items-center gap-3 min-w-0">
			<span class="flex h-9 w-9 items-center justify-center rounded-lg bg-rw-inset text-rw-muted shrink-0">
				<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
					<ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
					<path d="M3 5v14a9 3 0 0 0 18 0V5"></path>
					<path d="M3 12a9 3 0 0 0 18 0"></path>
				</svg>
			</span>
			<div class="min-w-0">
				<div class="text-lg font-semibold text-rw-text truncate">{ p.DBName }</div>
				<div class="text-xs text-rw-faint truncate">database · { d.Name }</div>
			</div>
		</div>
		<button type="button" data-drawer-close class="flex h-8 w-8 items-center justify-center rounded-lg text-rw-muted hover:text-rw-text hover:bg-rw-raised transition-colors" aria-label="Close">
			<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"></path></svg>
		</button>
	</div>
	<nav class="flex gap-1 px-6 border-b border-rw-border">
		@drawerTab("/dbs/" + d.ID + "/pgdbs/" + p.DBName + "/panel", tab, "overview", "Overview")
		if d.Status == "running" {
			@drawerTab("/dbs/" + d.ID + "/pgdbs/" + p.DBName + "/panel", tab, "database", "Database")
			@drawerTab("/dbs/" + d.ID + "/pgdbs/" + p.DBName + "/panel", tab, "logs", "Logs")
		}
	</nav>
	<div class="p-6">
		if tab == "database" {
			<div hx-get={ "/dbs/" + d.ID + "/data?locked=1&db=" + url.QueryEscape(p.DBName) } hx-trigger="load" hx-swap="outerHTML">
				<p class="text-xs text-rw-faint">Loading…</p>
			</div>
		} else if tab == "logs" {
			@components.LogView("/dbs/"+d.ID+"/logs/stream", false)
			<p class="text-xs text-rw-faint mt-2">These are <span class="text-rw-muted">{ d.Name }</span>'s container logs. A provisioned database has no container of its own.</p>
		} else {
			<div class="panel p-5 space-y-2 text-sm font-mono">
				@connRow("Database", p.DBName)
				@connRow("User", p.DBUser)
				@connRow("Instance", d.Name)
			</div>
			if d.Status != "running" {
				<p class="text-xs text-rw-faint mt-2">The instance is not running. Deploy it to browse this database.</p>
			}
			<a href={ templ.SafeURL("/dbs/" + d.ID + "/panel") } hx-get={ "/dbs/" + d.ID + "/panel" } hx-target="#drawer-body" class="btn btn-ghost btn-sm mt-6">Open { d.Name }</a>
		}
	</div>
}
