package db

import (
	"github.com/FyrmForge/stackr/internal/stackrd/infra/managedtiles"
	"github.com/FyrmForge/stackr/internal/stackrd/store/repo"
	"github.com/FyrmForge/stackr/internal/stackrd/infra/runtime"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/filebrowse"
)

// volumePanel is the drawer behind a database's tucked volume card: Overview
// for the volume's facts, Tree for its files.
templ volumePanel(d *repo.Tile, v managedtiles.DataVolume, tab string) {
	<div class="flex items-center justify-between px-6 py-5 border-b border-rw-border">
		<div class="flex items-center gap-3 min-w-0">
			<span class="flex h-9 w-9 items-center justify-center rounded-lg bg-rw-inset text-rw-muted shrink-0">
				<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
					<path d="M22 12H2"></path>
					<path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path>
					<line x1="6" x2="6.01" y1="16" y2="16"></line>
				</svg>
			</span>
			<div class="min-w-0">
				<div class="text-lg font-semibold text-rw-text truncate">{ v.Name }</div>
				<div class="text-xs text-rw-faint truncate">data volume · { d.Name }</div>
			</div>
		</div>
		<button type="button" data-drawer-close class="flex h-8 w-8 items-center justify-center rounded-lg text-rw-muted hover:text-rw-text hover:bg-rw-raised transition-colors" aria-label="Close">
			<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"></path></svg>
		</button>
	</div>
	<nav class="flex gap-1 px-6 border-b border-rw-border">
		@drawerTab("/dbs/" + d.ID + "/volume/panel", tab, "overview", "Overview")
		if v.Mountpoint != "" {
			@drawerTab("/dbs/" + d.ID + "/volume/panel", tab, "tree", "Tree")
		}
	</nav>
	<div class="p-6">
		if tab == "tree" {
			@filebrowse.Loader("/dbs/" + d.ID + "/volume/files")
		} else {
			<div class="panel p-5 space-y-2 text-sm font-mono">
				@connRow("Docker volume", v.Name)
				@connRow("Size on disk", runtime.FmtBytes(v.SizeBytes))
				if v.MountPath != "" {
					@connRow("Mount path", v.MountPath)
				}
				if v.Mountpoint != "" {
					@connRow("Host path", v.Mountpoint)
				}
				if len(v.UsedBy) > 0 {
					@connRow("In use by", v.UsedBy[0])
				}
			</div>
			if v.Mountpoint == "" {
				<p class="text-xs text-rw-faint mt-2">Docker doesn't know this volume yet. It is created on the first deploy.</p>
			}
			<a href={ templ.SafeURL("/dbs/" + d.ID + "/panel") } hx-get={ "/dbs/" + d.ID + "/panel" } hx-target="#drawer-body" class="btn btn-ghost btn-sm mt-6">Open { d.Name }</a>
		}
	</div>
}
