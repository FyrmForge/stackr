package db

import (
	"github.com/labstack/echo/v4"
	"github.com/FyrmForge/stackr/internal/stackrd/store/repo"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components"
)

// dbPage is the full-page view: the same tabbed panel the canvas drawer
// shows, wrapped in the shell, one settings screen, two frames, mirroring
// appPage. It used to be a separate two-column layout, which meant the page
// silently lacked the drawer's Logs, Metrics and provisioned-databases
// sections, and its forms had no #panel-content to swap into.
templ dbPage(c echo.Context, d *repo.Tile, tab string, td tabData) {
	@components.Shell(c, d.Name) {
		<nav class="mb-4 flex items-center gap-1.5 text-sm text-rw-muted">
			<a href={ templ.SafeURL("/projects/" + d.StackID) } class="hover:text-rw-text transition-colors">&larr; stack</a>
			<span class="text-rw-faint">/</span>
			<span class="text-rw-text">{ d.Name }</span>
		</nav>
		<div class="panel !p-0 overflow-hidden" data-ws-room={ "project:" + d.StackID }>
			@dbPanel(c, d, tab, td, false)
		</div>
	}
}

templ connRow(label, value string) {
	<div class="flex justify-between gap-4">
		<span class="text-rw-faint">{ label }</span>
		<span class="text-rw-text break-all">{ value }</span>
	</div>
}
