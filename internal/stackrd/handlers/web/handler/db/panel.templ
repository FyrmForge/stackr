package db

import (
	"strconv"
	"strings"

	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components/form"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/graph"
	"github.com/FyrmForge/stackr/internal/stackrd/infra/managedtiles"
	"github.com/FyrmForge/stackr/internal/stackrd/store/repo"
	"github.com/labstack/echo/v4"
)

templ dbPanel(c echo.Context, d *repo.Tile, tab string, td tabData, inDrawer bool) {
	<div id="panel-header">
		@dbPanelHeader(c, d, inDrawer)
	</div>
	<div id="panel-content">
		@dbPanelContent(c, d, tab, td)
	</div>
}

// dbPanelHeaderOOB re-renders just the header out of band: Deploy/Stop/Start
// change status but not which tab is open, so the body is left as-is.
templ dbPanelHeaderOOB(c echo.Context, d *repo.Tile, inDrawer bool) {
	<div id="panel-header" hx-swap-oob="true">
		@dbPanelHeader(c, d, inDrawer)
	</div>
	@components.FlashOOB(c)
}

templ dbPanelHeader(c echo.Context, d *repo.Tile, inDrawer bool) {
	@components.PanelHeader(components.PanelHead{
		Title: d.Name, Subtitle: d.Engine, Location: components.TileLocation(c),
		Scope: graph.ScopeSuffix(d.ScopeKind), Status: d.Status, InDrawer: inDrawer,
	}, dbIcon(), dbActions(c, d))
}

templ dbIcon() {
	<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
		<ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
		<path d="M3 5v14a9 3 0 0 0 18 0V5"></path>
		<path d="M3 12a9 3 0 0 0 18 0"></path>
	</svg>
}

templ dbActions(c echo.Context, d *repo.Tile) {
	if d.Status == "running" {
		<form hx-post={ "/dbs/" + d.ID + "/stop" } hx-swap="none">
			@form.CSRFField(c)
			<button type="submit" class="btn btn-ghost btn-sm">Stop</button>
		</form>
	} else {
		<form hx-post={ "/dbs/" + d.ID + "/deploy" } hx-swap="none">
			@form.CSRFField(c)
			<button type="submit" class="btn btn-primary btn-sm">Deploy</button>
		</form>
	}
}

templ dbPanelContent(c echo.Context, d *repo.Tile, tab string, td tabData) {
	// Same tab vocabulary as a service tile: Overview for what it is, Settings
	// for what you can change. A database used to have neither.
	@components.PanelTabs() {
		@components.PanelTab("/dbs/"+d.ID+"/panel/content", dbTab(tab), "connection", "Overview")
		@components.PanelTab("/dbs/"+d.ID+"/panel/content", dbTab(tab), "logs", "Logs")
		@components.PanelTab("/dbs/"+d.ID+"/panel/content", dbTab(tab), "metrics", "Metrics")
		if managedtiles.Engines[d.Engine].DataBrowser {
			@components.PanelTab("/dbs/"+d.ID+"/panel/content", dbTab(tab), "data", nounTitle(managedtiles.Engines[d.Engine].UnitNoun))
		}
		@components.PanelTab("/dbs/"+d.ID+"/panel/content", dbTab(tab), "backups", "Backups")
		@components.PanelTab("/dbs/"+d.ID+"/panel/content", dbTab(tab), "settings", "Settings")
	}
	<div class="p-6">
		switch tab {
			case "data":
				@dbData(d)
			case "logs":
				@components.LogView("/dbs/"+d.ID+"/logs/stream", false)
			case "metrics":
				@components.MetricsFrag("/dbs/"+d.ID+"/metrics", "1h", td.cpu, td.mem, td.rx, td.tx)
			case "backups":
				// Fetched rather than rendered here: the same fragment serves the
				// volume tiles in the app panel.
				<div hx-get={ "/tiles/" + d.ID + "/backups" } hx-trigger="load" hx-swap="innerHTML">
					<p class="text-xs text-rw-faint">Loading…</p>
				</div>
			case "settings":
				@dbSettings(c, d, td.domains, td.fileOwned)
			default:
				@dbConnection(c, d)
		}
	</div>
}

// dbConnection is shared by the full page (dbPage) and the drawer. It is the
// read-only Overview: how to reach this instance. Its
// forms moved to the Settings tab, a database was the one tile kind whose
// settings hid inside a tab called "Connection".
templ dbConnection(c echo.Context, d *repo.Tile) {
	<div class="panel p-5 space-y-2 text-sm font-mono">
		<!-- exactly what this tile publishes about itself, under the names a
		     consumer references, so the drawer can't call a bucket a database,
		     and a new engine needs no rows written here. -->
		for _, cv := range managedtiles.Conn(d) {
			@connVarRow(d, cv)
		}
		if d.ExternalPort > 0 {
			@connRow("External port", strconv.Itoa(d.ExternalPort))
		}
	</div>
	<p class="text-xs text-rw-faint mt-2">
		Services can reference these as
		<span class="font-mono text-rw-muted">{ "${{ tile." + d.Slug + "." + managedtiles.DefaultOutput(d.Engine) + " }}" }</span>
		in their variables, no copy-pasting needed.
	</p>
	if managedtiles.CanProvision(d.Engine) {
		<h3 class="text-sm font-semibold uppercase tracking-wide text-rw-faint mt-8 mb-4">Provisioned { sliceLabel(d.Engine) }</h3>
		<div hx-get={ "/dbs/" + d.ID + "/provisions" } hx-trigger="load" hx-swap="innerHTML">
			<p class="text-xs text-rw-faint">Loading…</p>
		</div>
	}
}

// dbSettings is the Settings tab: everything about this instance you can change.
templ dbSettings(c echo.Context, d *repo.Tile, domains []repo.Domain, fileOwned bool) {
	// Every field here is config-modeled, so on a managed stack the save is
	// refused. Say it up front AND disable the inputs, a form that looks
	// editable and 409s on submit is worse than one that admits it.
	if fileOwned {
		<div class="panel border-rw-warning/30 bg-rw-warning/5 px-4 py-2.5 mb-4 text-sm text-rw-muted">
			This instance is declared in <span class="font-mono text-rw-text">stackr-compose.yml</span>:
			its fields are read-only here. Change them in the repo.
		</div>
	}
	<h3 class="text-xs font-semibold uppercase tracking-wide text-rw-faint mb-3">Instance</h3>
	<form hx-post={ "/dbs/" + d.ID + "/port" } hx-target="#panel-content" hx-swap="innerHTML" class="space-y-3">
		@form.CSRFField(c)
		<div class="flex flex-wrap gap-2 items-end">
			<div>
				<label class="label">External port (0 = internal only)</label>
				<input type="number" name="external_port" value={ strconv.Itoa(d.ExternalPort) } min="0" max="65535" disabled?={ fileOwned } class="input w-40"/>
			</div>
			<div>
				<label class="label">CPU limit (cores)</label>
				<input type="number" name="cpu_limit" value={ fmtLimit(d.CPULimit) } step="0.1" min="0" disabled?={ fileOwned } class="input w-32"/>
			</div>
			<div>
				<label class="label">Memory limit (MB)</label>
				<input type="number" name="mem_limit_mb" value={ strconv.Itoa(d.MemLimitMB) } min="0" disabled?={ fileOwned } class="input w-32"/>
			</div>
			<div>
				<label class="label">Shm size (MB, 0 = default)</label>
				<input type="number" name="shm_size_mb" value={ strconv.Itoa(d.ShmSizeMB) } min="0" disabled?={ fileOwned } class="input w-32"/>
			</div>
			if !fileOwned {
				<button type="submit" class="btn btn-primary whitespace-nowrap">Apply</button>
			}
		</div>
		<div>
			<label class="label">Image (empty = { managedtiles.Engines[d.Engine].DefaultImage })</label>
			<input type="text" name="image_ref" value={ imageOverride(d) } placeholder={ managedtiles.Engines[d.Engine].DefaultImage } class="input font-mono w-full"/>
			<p class="text-xs text-rw-faint mt-1">Per-instance override: a version pin or a wire-compatible build. You own upgrade compatibility.</p>
		</div>
		<div>
			<label class="label">Update policy (registry watcher)</label>
			<select name="update_policy" class="input w-64">
				<option value="off" selected?={ d.UpdatePolicy != "notify" && d.UpdatePolicy != "auto" }>Off</option>
				<option value="notify" selected?={ d.UpdatePolicy == "notify" }>Notify on new version</option>
				<option value="auto" selected?={ d.UpdatePolicy == "auto" }>Auto-deploy new versions</option>
			</select>
		</div>
		<p class="text-xs text-rw-faint">0 = unlimited. A running database is redeployed with the new settings.</p>
	</form>
	if managedtiles.SpeaksHTTP(d.Engine) {
		<h3 class="text-sm font-semibold uppercase tracking-wide text-rw-faint mt-8 mb-3">Domains</h3>
		<p class="text-xs text-rw-faint mb-3">
			Puts Traefik in front of this instance on port { strconv.Itoa(managedtiles.Engines[d.Engine].Port) } is how a public bucket gets a real URL.
			Wire-protocol engines can't be proxied, so this only appears for HTTP ones.
		</p>
		if len(domains) > 0 {
			<ul class="space-y-1 mb-3">
				for _, dom := range domains {
					<li class="flex items-center gap-2 text-xs">
						<a href={ templ.SafeURL(domScheme(dom) + dom.Host) } target="_blank" rel="noopener" class="link font-mono">{ dom.Host }</a>
						if dom.Path != "" && dom.Path != "/" {
							<span class="font-mono text-rw-faint">{ dom.Path }</span>
						}
						if dom.HTTPS {
							<span class="text-[10px] px-1.5 py-0.5 rounded bg-rw-success/15 text-rw-success">https</span>
						}
						if !fileOwned {
							<form hx-post={ "/dbs/" + d.ID + "/domains/" + dom.ID + "/delete" } hx-target="#panel-content" hx-swap="innerHTML" hx-confirm={ "Remove " + dom.Host + "? Anything using its public URL breaks." } class="ml-auto">
								@form.CSRFField(c)
								<button type="submit" class="btn btn-ghost btn-sm">Remove</button>
							</form>
						}
					</li>
				}
			</ul>
		}
		if !fileOwned {
			<form hx-post={ "/dbs/" + d.ID + "/domains" } hx-target="#panel-content" hx-swap="innerHTML" class="flex flex-wrap items-end gap-2">
				@form.CSRFField(c)
				<div class="flex-1 min-w-48">
					<label class="label" for={ "dbdom-" + d.ID }>Host</label>
					<input id={ "dbdom-" + d.ID } type="text" name="host" placeholder="cdn.example.com" required class="input font-mono"/>
				</div>
				<div>
					<label class="label" for={ "dbdompath-" + d.ID }>Path</label>
					<input id={ "dbdompath-" + d.ID } type="text" name="path" placeholder="/" class="input font-mono !w-24"/>
				</div>
				<label class="flex items-center gap-1.5 text-xs text-rw-muted pb-2">
					<input type="checkbox" name="https" value="1" checked/>
					https
				</label>
				<button type="submit" class="btn btn-ghost btn-sm">Add domain</button>
			</form>
		}
	}
	if managedtiles.CanProvision(d.Engine) {
		<h3 class="text-sm font-semibold uppercase tracking-wide text-rw-faint mt-8 mb-3">Sharing</h3>
		<form hx-post={ "/dbs/" + d.ID + "/scope" } hx-target="#panel-content" hx-swap="innerHTML" class="flex flex-wrap gap-2 items-end">
			@form.CSRFField(c)
			<div>
				<label class="label">Shared with</label>
				<select name="scope_kind" class="input w-auto">
					<option value="env" selected?={ d.ScopeKind != "stack" && d.ScopeKind != "org" }>This environment</option>
					<option value="stack" selected?={ d.ScopeKind == "stack" }>Whole stack</option>
					<option value="org" selected?={ d.ScopeKind == "org" }>Whole organization</option>
				</select>
			</div>
			<button type="submit" class="btn btn-ghost btn-sm">Save scope</button>
			<p class="w-full text-xs text-rw-faint">Controls which services may provision a database here. This environment keeps it private, stack or organization lets services elsewhere share this instance.</p>
		</form>
	}
	<div class="mt-8 pt-6 border-t border-rw-border">
		if fileOwned {
			<p class="text-xs text-rw-faint">Remove it from the config file to delete it.</p>
		} else {
			@components.ConfirmDanger(c, components.ConfirmCfg{
				PostURL: "/dbs/" + d.ID + "/delete",
				Want:    d.Slug,
				Path:    d.Slug,
				Warning: "Deleting this database removes its container and everything provisioned from it.",
				Kept:    "The data volume is kept on the host.",
				Label:   "Delete database",
				ID:      "db-delete",
				Target:  "#panel-content",
				Swap:    "innerHTML",
			})
		}
	</div>
}

// dbData is the Data tab: the tables/rows browser, lazy-loaded so the tab
// switch stays instant even when the first psql round-trip is slow.
templ dbData(d *repo.Tile) {
	if d.Status != "running" {
		<p class="text-sm text-rw-muted">Deploy the database to browse its data.</p>
	} else {
		<div hx-get={ "/dbs/" + d.ID + "/data" } hx-trigger="load" hx-swap="outerHTML">
			<p class="text-xs text-rw-faint">Loading…</p>
		</div>
	}
}

// dbTab resolves the open tab. A db panel opens on Overview when nothing is
// asked for; naming that here keeps "which tab is lit" a plain comparison in
// the shared component.
// imageOverride shows the image only when it differs from the engine default,
// so the input reads empty (= default) unless a pin is actually active.
func imageOverride(d *repo.Tile) string {
	if eng, ok := managedtiles.Engines[d.Engine]; ok && d.ImageRef == eng.DefaultImage {
		return ""
	}
	return d.ImageRef
}

func dbTab(tab string) string {
	if tab == "" {
		return "connection"
	}
	return tab
}

// domScheme is the link prefix for a domain row.
func domScheme(d repo.Domain) string {
	if d.HTTPS {
		return "https://"
	}
	return "http://"
}

// fmtLimit renders a cores value without trailing zeros ("0.5", "2").
func fmtLimit(v float64) string {
	return strconv.FormatFloat(v, 'f', -1, 64)
}

// connVarRow shows one published connection detail. Secrets are masked but
// still copyable, seeing the shape is useful, shoulder-surfing the value is
// not.
templ connVarRow(d *repo.Tile, cv managedtiles.ConnVar) {
	<div class="flex items-center gap-3">
		<span class="text-rw-faint w-32 shrink-0">{ cv.Name }</span>
		<span class="text-rw-muted select-none truncate">{ masked(d, cv) }</span>
		<button type="button" data-copy={ cv.Value } class="btn btn-ghost btn-sm">Copy</button>
	</div>
}

// masked hides the credential without hiding the value's shape: a url keeps
// its host and database, a bare password becomes dots.
func masked(d *repo.Tile, cv managedtiles.ConnVar) string {
	if !cv.Secret {
		return cv.Value
	}
	if d.DBPassword != "" && strings.Contains(cv.Value, d.DBPassword) && cv.Value != d.DBPassword {
		return strings.ReplaceAll(cv.Value, d.DBPassword, "••••••••")
	}
	return "••••••••"
}

// nounTitle capitalises a registry noun for use as a label.
func nounTitle(noun string) string {
	if noun == "" {
		return ""
	}
	return strings.ToUpper(noun[:1]) + noun[1:]
}

// sliceLabel names an engine's provisioned units in the plural.
func sliceLabel(engine string) string {
	noun := managedtiles.Engines[engine].SliceNoun
	if noun == "" {
		noun = "slice"
	}
	return noun + "s"
}
