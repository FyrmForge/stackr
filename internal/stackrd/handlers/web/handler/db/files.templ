package db

import (
	"github.com/FyrmForge/stackr/internal/stackrd/store/repo"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/filebrowse"
)

// drawerTab is a tab button for the small drawers (volume, bucket, pg
// database), same look as the db panel's tabs, but it re-fetches the whole
// drawer with ?tab=.
templ drawerTab(base, active, key, label string) {
	<button
		hx-get={ base + "?tab=" + key }
		hx-target="#drawer-body"
		class={ "px-3 py-2.5 text-sm border-b-2 -mb-px transition-colors",
			templ.KV("border-rw-accent text-rw-text font-medium", active == key || (active == "" && key == "overview")),
			templ.KV("border-transparent text-rw-muted hover:text-rw-text", !(active == key || (active == "" && key == "overview"))) }
	>{ label }</button>
}

// bucketPanel is the drawer behind an s3 bucket slice card: Overview for what
// the bucket is, Tree for its objects.
templ bucketPanel(d *repo.Tile, bucket string, public bool, tab string) {
	<div class="flex items-center justify-between px-6 py-5 border-b border-rw-border">
		<div class="flex items-center gap-3 min-w-0">
			<span class="flex h-9 w-9 items-center justify-center rounded-lg bg-rw-inset text-rw-muted shrink-0">
				<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
					<ellipse cx="12" cy="5" rx="8" ry="2.5"></ellipse>
					<path d="M4 5l1.5 13a6.5 2.5 0 0 0 13 0L20 5"></path>
				</svg>
			</span>
			<div class="min-w-0">
				<div class="text-lg font-semibold text-rw-text truncate">{ bucket }</div>
				<div class="text-xs text-rw-faint truncate">bucket · { d.Name }</div>
			</div>
		</div>
		<button type="button" data-drawer-close class="flex h-8 w-8 items-center justify-center rounded-lg text-rw-muted hover:text-rw-text hover:bg-rw-raised transition-colors" aria-label="Close">
			<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"></path></svg>
		</button>
	</div>
	<nav class="flex gap-1 px-6 border-b border-rw-border">
		@drawerTab("/dbs/" + d.ID + "/buckets/" + bucket + "/panel", tab, "overview", "Overview")
		if d.Status == "running" {
			@drawerTab("/dbs/" + d.ID + "/buckets/" + bucket + "/panel", tab, "tree", "Tree")
			@drawerTab("/dbs/" + d.ID + "/buckets/" + bucket + "/panel", tab, "logs", "Logs")
		}
	</nav>
	<div class="p-6">
		if tab == "tree" {
			@filebrowse.Loader(bucketFilesBase(d, bucket))
		} else if tab == "logs" {
			@components.LogView("/dbs/"+d.ID+"/logs/stream", false)
			<p class="text-xs text-rw-faint mt-2">These are <span class="text-rw-muted">{ d.Name }</span>'s container logs. A bucket has no container of its own.</p>
		} else {
			<div class="panel p-5 space-y-2 text-sm font-mono">
				@connRow("Bucket", bucket)
				@connRow("Instance", d.Name)
				if public {
					@connRow("Visibility", "public read")
				} else {
					@connRow("Visibility", "private")
				}
			</div>
			if d.Status != "running" {
				<p class="text-xs text-rw-faint mt-2">The instance is not running. Deploy it to browse this bucket.</p>
			}
			<a href={ templ.SafeURL("/dbs/" + d.ID + "/panel") } hx-get={ "/dbs/" + d.ID + "/panel" } hx-target="#drawer-body" class="btn btn-ghost btn-sm mt-6">Open { d.Name }</a>
		}
	</div>
}
