package notification

import (
	"strconv"

	"github.com/labstack/echo/v4"
	"github.com/FyrmForge/stackr/internal/stackrd/store/repo"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components/form"
)

templ notificationsPage(c echo.Context, ns []repo.Notification) {
	@components.Shell(c, "Notifications") {
		<div class="flex flex-wrap items-center gap-3 mb-8">
			<h1 class="text-2xl font-semibold text-rw-text tracking-tight">Notifications</h1>
			if len(ns) > 0 {
				<span class="flex items-center gap-2 ml-auto">
					<form hx-post="/notifications/read">
						@form.CSRFField(c)
						<button type="submit" class="btn btn-ghost btn-sm">Mark all read</button>
					</form>
					<form hx-post="/notifications/clear" hx-confirm="Delete all notifications?">
						@form.CSRFField(c)
						<button type="submit" class="btn btn-danger btn-sm">Clear all</button>
					</form>
				</span>
			}
		</div>
		if len(ns) == 0 {
			<p class="text-rw-muted text-sm">Nothing yet. Failed deploys and cron runs land here.</p>
		} else {
			<ul class="space-y-2 max-w-3xl">
				for _, n := range ns {
					<li>
						<a
							if n.Link != "" {
								href={ templ.SafeURL(n.Link) }
							}
							class={ "panel px-5 py-4 flex items-start gap-4 transition-colors",
								templ.KV("hover:border-rw-accent/50", n.Link != ""),
								templ.KV("border-l-2 !border-l-rw-accent", !n.Read) }
						>
							<span class={ "mt-0.5 shrink-0", kindTone(n.Kind) }>
								@kindIcon(n.Kind)
							</span>
							<span class="min-w-0 flex-1">
								<span class="block text-sm text-rw-text">{ n.Title }</span>
								if n.Body != "" {
									<span class="block text-xs text-rw-muted font-mono mt-1 whitespace-pre-wrap break-all line-clamp-3">{ n.Body }</span>
								}
							</span>
							<span class="text-xs text-rw-faint shrink-0">{ n.CreatedAt.Local().Format("Jan 2 15:04") }</span>
						</a>
					</li>
				}
			</ul>
		}
	}
}

func kindTone(kind string) string {
	switch kind {
	case "deploy_done":
		return "text-rw-success"
	default:
		return "text-rw-danger"
	}
}

templ kindIcon(kind string) {
	<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		switch kind {
		case "deploy_done":
			<path d="M20 6 9 17l-5-5"></path>
		case "cron_failed":
			<circle cx="12" cy="12" r="10"></circle>
			<path d="M12 6v6l4 2"></path>
		default:
			<circle cx="12" cy="12" r="10"></circle>
			<path d="M12 8v4M12 16h.01"></path>
		}
	</svg>
}

// Bell is the icon-rail button + unread badge; swapped in live via
// /notifications/badge (websocket-pushed, slow-poll fallback).
templ Bell(c echo.Context, unread int) {
	<a
		href="/notifications"
		title="Notifications"
		class="relative flex h-9 w-9 items-center justify-center rounded-lg transition-colors text-rw-muted hover:text-rw-text hover:bg-rw-raised"
	>
		<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
			<path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
		</svg>
		if unread > 0 {
			<span class="absolute -top-0.5 -right-0.5 min-w-4 h-4 px-1 rounded-full bg-rw-danger text-white text-[10px] font-semibold flex items-center justify-center">
				{ badgeCount(unread) }
			</span>
		}
	</a>
}

func badgeCount(n int) string {
	if n > 99 {
		return "99+"
	}
	return strconv.Itoa(n)
}
