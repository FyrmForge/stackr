package backups

import (
	"strconv"

	"github.com/labstack/echo/v4"

	"github.com/FyrmForge/stackr/internal/stackrd/store/repo"
	"github.com/FyrmForge/stackr/internal/stackrd/infra/runtime"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components/form"
)

// frag is the whole Backups tab. Every action inside it posts back and swaps
// this same fragment, so the drawer never navigates away mid-configuration.
templ frag(c echo.Context, v view) {
	<div id="backups-tab" hx-target="#backups-tab" hx-swap="outerHTML">
		if len(v.Dests) == 0 {
			<p class="text-sm text-rw-muted">
				No backup destination is set up yet. Add one in this organization's
				settings (or ask an admin for a server-wide one) and it will appear here.
			</p>
		} else {
			if v.Kind == repo.BackupVolume && v.VolErr != "" {
				<p class="text-sm text-rw-muted">{ v.VolErr }</p>
			} else {
				for _, cv := range v.Configs {
					@configPanel(c, v, cv)
				}
				@addForm(c, v)
			}
		}
	</div>
}

templ configPanel(c echo.Context, v view, cv configView) {
	<div class="panel p-5 mb-4 space-y-4">
		<div class="flex items-center gap-2">
			<span class="text-sm font-medium text-rw-text">
				if cv.Kind == repo.BackupDump {
					Database dump
				} else {
					Volume archive
				}
			</span>
			<span class="text-xs text-rw-faint">{ cv.DestName }</span>
			if !cv.Enabled {
				<span class="text-xs px-1.5 py-0.5 rounded bg-rw-danger/15 text-rw-danger">paused</span>
			}
			<span class="ml-auto flex items-center gap-1.5">
				<form hx-post={ "/backups/" + cv.ID + "/run" }>
					@form.CSRFField(c)
					<button type="submit" class="btn btn-ghost btn-sm">Run now</button>
				</form>
				<form hx-post={ "/backups/" + cv.ID + "/delete" } hx-confirm="Remove this schedule? Archives already uploaded are kept.">
					@form.CSRFField(c)
					<button type="submit" class="btn btn-danger btn-sm">Remove</button>
				</form>
			</span>
		</div>
		<form hx-post={ "/backups/" + cv.ID + "/save" } class="space-y-4">
			@form.CSRFField(c)
			@fields(v, &cv.Backup)
			<label class="flex items-center gap-2 text-sm text-rw-text cursor-pointer">
				<input type="checkbox" name="enabled" value="1" checked?={ cv.Enabled } class="accent-rw-accent"/>
				Run on schedule
			</label>
			<button type="submit" class="btn btn-primary btn-sm">Save</button>
		</form>
		@history(c, cv)
	</div>
}

// fields are the same inputs for a new schedule and an existing one.
templ fields(v view, b *repo.Backup) {
	<div class="grid gap-4 sm:grid-cols-2">
		@kindChoice(v, b)
		<label class="block">
			<span class="block text-xs text-rw-faint mb-1">Destination</span>
			<select name="destination_id" class="input">
				for _, d := range v.Dests {
					<option value={ d.ID } selected?={ d.ID == b.DestinationID }>
						{ d.Name }
						if d.Global() {
							(server-wide)
						}
					</option>
				}
			</select>
		</label>
		<label class="block">
			<span class="block text-xs text-rw-faint mb-1">Schedule (cron)</span>
			<input type="text" name="cron" value={ b.Cron } placeholder="0 3 * * *" required class="input font-mono"/>
		</label>
		<label class="block">
			<span class="block text-xs text-rw-faint mb-1">Timezone</span>
			<input type="text" name="timezone" value={ b.Timezone } placeholder="Europe/London, empty is server time" class="input"/>
		</label>
		<label class="block">
			<span class="block text-xs text-rw-faint mb-1">Keep the newest</span>
			<input type="number" name="keep_latest" min="0" value={ strconv.Itoa(b.KeepLatest) } class="input"/>
		</label>
	</div>
	if v.VolErr == "" {
		@modeToggle(b.ContainerMode)
	}
}

// kindChoice appears on database tiles only. A dump is the right answer for a
// database, it is application-consistent and restorable into a different
// version, so it is the default, but archiving the data volume is allowed
// because some engines ship no dump tool worth the name.
templ kindChoice(v view, b *repo.Backup) {
	if v.Kind == repo.BackupDump && v.VolErr == "" && b.ID == "" {
		<label class="block">
			<span class="block text-xs text-rw-faint mb-1">What to back up</span>
			<select name="kind" class="input">
				<option value="dump">Database dump (recommended)</option>
				<option value="volume">Archive of the data volume</option>
			</select>
			if v.Slices > 0 {
				<span class="block text-xs text-rw-faint mt-1">
					A dump covers this instance's own database, not the logical dbs cut from it. Archive the volume for those.
				</span>
			}
		</label>
	}
}

// modeToggle is the three-way choice that decides how consistent the archive
// is. It is a plain radio group on purpose, the trade-off between the three
// is the whole point, so each one carries its own sentence.
templ modeToggle(mode string) {
	<fieldset class="space-y-2">
		<legend class="text-xs text-rw-faint mb-1">While a volume archive is written (dumps ignore this)</legend>
		@modeOption(mode, repo.ModePause, "Pause the container (recommended)",
			"Freezes it for the seconds the local archive takes, then resumes before the upload. The copy is point-in-time.")
		@modeOption(mode, repo.ModeStop, "Stop the container",
			"For services that misbehave when frozen. Same consistency as pausing, but the downtime is the whole archive.")
		@modeOption(mode, repo.ModeLive, "Leave it running",
			"No downtime, but anything written mid-archive can land half-copied. Databases restored from a live archive may not open.")
	</fieldset>
}

templ modeOption(current, value, label, help string) {
	<label class="flex gap-3 items-start cursor-pointer">
		<input type="radio" name="container_mode" value={ value } checked?={ current == value } class="accent-rw-accent mt-1"/>
		<span class="text-sm">
			<span class="text-rw-text">{ label }</span>
			<span class="block text-xs text-rw-faint">{ help }</span>
		</span>
	</label>
}

templ history(c echo.Context, cv configView) {
	<div>
		<h4 class="text-xs font-semibold uppercase tracking-wide text-rw-faint mb-2">History</h4>
		if len(cv.Runs) == 0 {
			<p class="text-xs text-rw-faint">No runs yet.</p>
		} else {
			<ul class="space-y-1.5">
				for _, r := range cv.Runs {
					<li class="flex flex-wrap items-center gap-2 text-xs">
						<span class="text-rw-muted font-mono">{ r.CreatedAt.Format("2006-01-02 15:04") }</span>
						if r.Status == "done" {
							<span class="text-rw-muted">{ runtime.FmtBytes(r.SizeBytes) }</span>
						} else {
							<span class="text-rw-danger">{ r.Status }</span>
						}
						if r.Trigger != "schedule" {
							<span class="text-rw-faint">{ r.Trigger }</span>
						}
						if r.Error != "" {
							<span class="text-rw-danger truncate">{ r.Error }</span>
						}
						if r.Status == "done" {
							<form class="ml-auto" hx-post={ "/backups/" + cv.ID + "/restore" }
								hx-confirm="Restore this archive? The current data is overwritten. A pre-restore backup is taken first.">
								@form.CSRFField(c)
								<input type="hidden" name="run_id" value={ r.ID }/>
								<button type="submit" class="btn btn-ghost btn-sm">Restore</button>
							</form>
						}
					</li>
				}
			</ul>
		}
	</div>
}

templ addForm(c echo.Context, v view) {
	<form hx-post={ "/tiles/" + v.Tile.ID + "/backups" } class="panel p-5 space-y-4">
		@form.CSRFField(c)
		<h4 class="text-sm font-medium text-rw-text">Add a schedule</h4>
		@fields(v, &repo.Backup{KeepLatest: 7, ContainerMode: repo.ModePause})
		<button type="submit" class="btn btn-primary btn-sm">Add backup</button>
	</form>
}
