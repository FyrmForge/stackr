package register

import (
	"github.com/labstack/echo/v4"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components/form"
)

templ registerPage(c echo.Context, f RegisterForm, errors map[string]string) {
	@components.Layout(c, "Register") {
		<div class="max-w-md mx-auto pt-24 px-6">
			<div class="flex items-center gap-2.5 justify-center mb-8">
				<img src={ components.StaticURL("images/logo-mark.png") } alt="" class="h-10 w-10"/>
				<span class="text-xl font-semibold text-rw-text">stackr</span>
			</div>
			<div class="panel p-8 shadow-rw">
				<h2 class="text-lg font-semibold text-rw-text mb-1 text-center">Create your admin account</h2>
				<p class="text-sm text-rw-muted text-center mb-6">You own this install. Setting up your organization comes next.</p>
				@registerForm(c, f, errors)
			</div>
		</div>
	}
}

templ registerForm(c echo.Context, f RegisterForm, errors map[string]string) {
	<form
		id="register-form"
		hx-post="/register"
		hx-swap="outerHTML"
		hx-target="#register-form"
	>
		@form.CSRFField(c)
		if form.GetError(errors, "general") != "" {
			<div class="mb-4 px-4 py-3 rounded-lg border bg-rw-danger/10 border-rw-danger/40 text-rw-danger text-sm">
				{ form.GetError(errors, "general") }
			</div>
		}
		<div class="mb-5">
			<label for="name" class="label">Name</label>
			<input
				type="text"
				id="name"
				name="name"
				value={ f.Name }
				class="input"
				autocomplete="name"
				hx-post="/register/validate/name"
				hx-trigger="blur"
				hx-swap="none"
			/>
			@form.FieldError("name", form.GetError(errors, "name"))
		</div>
		<div class="mb-5">
			<label for="email" class="label">Email</label>
			<input
				type="email"
				id="email"
				name="email"
				value={ f.Email }
				class="input"
				autocomplete="username"
				hx-post="/register/validate/email"
				hx-trigger="blur"
				hx-swap="none"
			/>
			@form.FieldError("email", form.GetError(errors, "email"))
		</div>
		<div class="mb-6">
			<label for="password" class="label">Password</label>
			<input
				type="password"
				id="password"
				name="password"
				class="input"
				autocomplete="new-password"
				hx-post="/register/validate/password"
				hx-trigger="blur"
				hx-swap="none"
			/>
			@form.FieldError("password", form.GetError(errors, "password"))
			<p class="mt-1.5 text-xs text-rw-faint">At least 8 characters with uppercase, lowercase, a number, and a special character.</p>
		</div>
		<div class="mb-6">
			<label for="confirm_password" class="label">Confirm password</label>
			<input
				type="password"
				id="confirm_password"
				name="confirm_password"
				class="input"
				autocomplete="new-password"
			/>
			@form.FieldError("confirm_password", form.GetError(errors, "confirm_password"))
		</div>
		<button type="submit" class="btn btn-primary w-full">Create account</button>
	</form>
}
