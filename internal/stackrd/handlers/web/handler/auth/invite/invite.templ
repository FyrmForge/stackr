package invite

import (
	"github.com/labstack/echo/v4"
	"github.com/FyrmForge/stackr/internal/stackrd/store/repo"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components/form"
)

// JoinForm holds the invite-registration form values.
type JoinForm struct {
	Name     string `form:"name"`
	Email    string `form:"email"`
	Password string `form:"password"`
}

templ invitePage(c echo.Context, org *repo.Org, inv *repo.Invite, f JoinForm, errors map[string]string) {
	@components.Layout(c, "Join "+org.Name) {
		<div class="max-w-md mx-auto pt-24 px-6">
			<div class="flex items-center gap-2.5 justify-center mb-8">
				<img src={ components.StaticURL("images/logo-mark.png") } alt="" class="h-10 w-10"/>
				<span class="text-xl font-semibold text-rw-text">stackr</span>
			</div>
			<div class="panel p-8 shadow-rw">
				<h2 class="text-lg font-semibold text-rw-text mb-1 text-center">Join { org.Name }</h2>
				<p class="text-sm text-rw-muted text-center mb-6">You've been invited as <span class="text-rw-text">{ inv.Role }</span>. Create your account to join.</p>
				<form id="invite-form" hx-post={ "/invite/" + inv.ID } hx-swap="outerHTML" hx-target="#invite-form">
					@form.CSRFField(c)
					if form.GetError(errors, "general") != "" {
						<div class="mb-4 px-4 py-3 rounded-lg border bg-rw-danger/10 border-rw-danger/40 text-rw-danger text-sm">
							{ form.GetError(errors, "general") }
						</div>
					}
					<div class="mb-5">
						<label for="name" class="label">Name</label>
						<input type="text" id="name" name="name" value={ f.Name } autocomplete="name" class="input"/>
						@form.FieldError("name", form.GetError(errors, "name"))
					</div>
					<div class="mb-5">
						<label for="email" class="label">Email</label>
						<input type="email" id="email" name="email" value={ f.Email } readonly?={ inv.Email != "" } autocomplete="username" class="input"/>
						@form.FieldError("email", form.GetError(errors, "email"))
					</div>
					<div class="mb-6">
						<label for="password" class="label">Password</label>
						<input type="password" id="password" name="password" autocomplete="new-password" class="input"/>
						@form.FieldError("password", form.GetError(errors, "password"))
						<p class="mt-1.5 text-xs text-rw-faint">At least 8 characters.</p>
					</div>
					<div class="mb-6">
						<label for="confirm_password" class="label">Confirm password</label>
						<input type="password" id="confirm_password" name="confirm_password" autocomplete="new-password" class="input"/>
						@form.FieldError("confirm_password", form.GetError(errors, "confirm_password"))
					</div>
					<button type="submit" class="btn btn-primary w-full">Join { org.Name }</button>
				</form>
				<p class="text-xs text-rw-faint text-center mt-4">Already have an account? <a href="/login" class="link">Log in</a> first, then reopen the invite link.</p>
			</div>
		</div>
	}
}

templ invalidPage(c echo.Context) {
	@components.Layout(c, "Invite invalid") {
		<div class="max-w-md mx-auto pt-24 px-6 text-center">
			<div class="flex items-center gap-2.5 justify-center mb-8">
				<img src={ components.StaticURL("images/logo-mark.png") } alt="" class="h-10 w-10"/>
				<span class="text-xl font-semibold text-rw-text">stackr</span>
			</div>
			<div class="panel p-8 shadow-rw">
				<h2 class="text-lg font-semibold text-rw-text mb-2">This invite link is no longer valid</h2>
				<p class="text-sm text-rw-muted">It may have expired, been revoked, or already been used. Ask the org owner for a new one.</p>
			</div>
		</div>
	}
}
