package org

import (
	"strconv"

	"github.com/labstack/echo/v4"

	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components/form"
	"github.com/FyrmForge/stackr/internal/stackrd/infra/registry"
	"github.com/FyrmForge/stackr/internal/stackrd/store/repo"
)

// registryView is the Registry tab: what can push, and what has been pushed.
type registryView struct {
	Org     *repo.Org
	Creds   []repo.OrgRegistryCredential
	Images  []registryImage
	Host    string // the address a docker login goes to
	Err     string // the registry is down or unreachable; the page still renders
	NewCred string // the plaintext of a credential just minted, shown once
	CanEdit bool
}

// registryImage is one repository plus the tags expanded under it.
type registryImage struct {
	Name  string // full repository path, what docker pulls
	Short string // the part below the org's namespace
	Tags  []registryTag
	Open  bool
}

type registryTag struct {
	Tag    string
	Digest string
	SizeMB int64
	RunsOn string // "stack/tile" when a live deployment references it
}

templ orgRegistryPage(c echo.Context, v registryView) {
	@settingsShell(c, v.Org, "registry") {
		@form.Section("Push credentials", form.ScopeOrg,
			"Images live under "+registry.Namespace(v.Org.Slug)+"*. A credential reaches those and nothing else.") {
			if v.NewCred != "" {
				<div class="panel px-3 py-2.5 mb-4 border-rw-accent/60">
					<p class="text-sm text-rw-text mb-1">Copy this now. It is stored hashed and will not be shown again.</p>
					<code class="font-mono text-xs text-rw-muted break-all">
						docker login { v.Host } -u { v.Org.Slug } -p { v.NewCred }
					</code>
				</div>
			}
			if len(v.Creds) == 0 {
				<p class="text-sm text-rw-faint mb-5">Nothing here yet.</p>
			} else {
				<ul class="space-y-2 mb-5">
					for _, cr := range v.Creds {
						<li class="panel px-3 py-2.5 flex flex-wrap items-center gap-2">
							<span class="font-mono text-sm text-rw-text">{ cr.Name }</span>
							<span class="font-mono text-xs text-rw-muted">{ cr.Prefix }…</span>
							if cr.System {
								<span class="text-[10px] px-1.5 py-0.5 rounded bg-rw-warn/15 text-rw-warn">stackr deploys</span>
							}
							<span class="text-xs text-rw-faint">{ lastUsed(cr) }</span>
							if v.CanEdit && !cr.System {
								<form
									hx-post={ "/orgs/" + v.Org.Slug + "/settings/registry/credentials/delete" }
									hx-confirm="Revoke this credential? Anything pushing with it stops working."
									class="ml-auto"
								>
									@form.CSRFField(c)
									<input type="hidden" name="id" value={ cr.ID }/>
									<button type="submit" class="btn btn-ghost btn-sm">Revoke</button>
								</form>
							}
						</li>
					}
				</ul>
			}
			if v.CanEdit {
				@form.SettingsForm(c, "/orgs/"+v.Org.Slug+"/settings/registry/credentials") {
					@form.Field("New credential", "A name you will recognise in the list, like \"github-actions\".") {
						<input type="text" name="name" required placeholder="github-actions" class="input font-mono"/>
					}
					@form.Save("Create")
				}
			}
		}
		@form.Section("Images", form.ScopeOrg, "What this organization has pushed. Deleting a tag frees its space at the next nightly cleanup.") {
			if v.Err != "" {
				<p class="text-sm text-rw-warn mb-5">{ v.Err }</p>
			} else if len(v.Images) == 0 {
				<p class="text-sm text-rw-faint mb-5">Nothing pushed yet.</p>
			} else {
				<ul class="space-y-2">
					for _, im := range v.Images {
						<li class="panel px-3 py-2.5">
							<a
								href={ templ.SafeURL("/orgs/" + v.Org.Slug + "/settings/registry?image=" + im.Name) }
								class="font-mono text-sm text-rw-text hover:text-rw-accent transition-colors"
							>
								{ im.Short }
							</a>
							if im.Open {
								<ul class="mt-2 space-y-1">
									for _, t := range im.Tags {
										<li class="flex flex-wrap items-center gap-2 text-xs">
											<span class="font-mono text-rw-text">{ t.Tag }</span>
											<span class="text-rw-muted">{ strconv.FormatInt(t.SizeMB, 10) } MB</span>
											<span class="font-mono text-rw-faint truncate">{ t.Digest }</span>
											if t.RunsOn != "" {
												<span class="text-[10px] px-1.5 py-0.5 rounded bg-rw-warn/15 text-rw-warn">
													deployed on { t.RunsOn }
												</span>
											} else if v.CanEdit {
												<form
													hx-post={ "/orgs/" + v.Org.Slug + "/settings/registry/tags/delete" }
													hx-confirm={ "Delete " + im.Short + ":" + t.Tag + "?" }
													class="ml-auto"
												>
													@form.CSRFField(c)
													<input type="hidden" name="image" value={ im.Name }/>
													<input type="hidden" name="tag" value={ t.Tag }/>
													<button type="submit" class="btn btn-ghost btn-sm">Delete</button>
												</form>
											}
										</li>
									}
								</ul>
							}
						</li>
					}
				</ul>
			}
		}
	}
}

// lastUsed reads as a date or as "never": a credential nobody has used is the
// one worth revoking, so it should be obvious at a glance.
func lastUsed(cr repo.OrgRegistryCredential) string {
	if !cr.LastUsedAt.Valid {
		return "never used"
	}
	return "last used " + cr.LastUsedAt.Time.Format("2006-01-02")
}
