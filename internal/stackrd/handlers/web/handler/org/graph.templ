package org

import (
	"github.com/labstack/echo/v4"

	stackrmw "github.com/FyrmForge/stackr/internal/stackrd/handlers/middleware"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/graph"
	"github.com/FyrmForge/stackr/internal/stackrd/service/notify"
	"github.com/FyrmForge/stackr/internal/stackrd/store/repo"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components/canvas"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components/form"
)

// orgGraphPage is the top level: an organization's stacks as cards, reached by
// "/" as well as its own URL. There is no list view above or beside it, the
// canvas is the organization. Creating a stack happens here, since this is the
// only place that shows them all.
templ orgGraphPage(c echo.Context, o *repo.Org, g graph.Graph, plan *repo.ConfigPlan, pending int) {
	@components.ShellFull(c, o.Name) {
		<div class="flex flex-wrap items-center gap-x-3 gap-y-2 px-4 sm:px-6 py-3 min-h-14 border-b border-rw-border bg-rw-surface shrink-0">
			@components.Avatar(o.AvatarPath, o.Name, "h-7 w-7 text-xs")
			<h1 class="text-lg font-semibold text-rw-text tracking-tight">{ o.Name }</h1>
			<span class="text-xs text-rw-faint font-mono">/{ o.Slug }</span>
			<div class="ml-auto flex items-center gap-2">
				<!-- the only route to members, invites, connectors and org
				     variables: the org used to be a card on its own canvas -->
				<a href={ templ.SafeURL("/orgs/" + o.Slug + "/settings") } class="text-sm text-rw-faint hover:text-rw-text transition-colors">Settings</a>
				<div class="relative">
					<button type="button" data-create-toggle class="btn btn-primary btn-sm">+ Create stack</button>
					@createStackMenu(c)
				</div>
			</div>
		</div>
		@orgPlanBanner(o, plan, pending, "/orgs/"+o.Slug)
		@canvas.Canvas(canvas.Opts{
			SaveURL: "/orgs/" + o.Slug + "/graph/positions",
			WSRoom:  notify.OrgRoom(o.ID),
			CSRF:    csrf(c),
			Empty:   "This organization has no stacks yet. Create one to get started.",
			// container flows rolled up onto the stack and instance cards
			// (buildOrgGraph's nodeOf + graph.RollupTraffic)
			Traffic: true,
		}, g)
		@canvas.Chrome(true)
	}
}

// createStackMenu mirrors the tile-create modal one level down (graph.js owns
// the open/close wiring via data-create-toggle / data-create-close).
templ createStackMenu(c echo.Context) {
	<div id="create-menu" class="hidden fixed inset-0 z-40">
		<div class="absolute inset-0 scrim" data-create-close></div>
		<div class="relative panel w-full max-w-md mx-auto mt-16 sm:mt-24 p-5 shadow-rw text-left">
			<div class="flex items-center justify-between mb-4">
				<h2 class="text-sm font-semibold text-rw-text">New stack</h2>
				<button type="button" data-create-close class="graph-ctrl !h-7 !w-7" aria-label="Close">&times;</button>
			</div>
			<form hx-post="/projects" class="space-y-2.5">
				@form.CSRFField(c)
				<input type="text" name="name" placeholder="stack name" required class="input"/>
				<button type="submit" class="btn btn-primary btn-sm w-full">Create stack</button>
			</form>
			<p class="text-xs text-rw-faint mt-3">It starts with one environment, Production.</p>
		</div>
	</div>
}

// orgsGraphPage is the root canvas at "/": one card per organization the viewer
// belongs to. Its header carries only the create button, canvas settings live
// on the canvas itself, in the floating control column. Creating an org is also
// still possible from the sidebar badge, which is the only route to it from
// anywhere else.
templ orgsGraphPage(c echo.Context, g graph.Graph) {
	@components.ShellFull(c, "Organizations") {
		<div class="flex flex-wrap items-center gap-x-3 gap-y-2 px-4 sm:px-6 py-3 min-h-14 border-b border-rw-border bg-rw-surface shrink-0">
			<h1 class="text-lg font-semibold text-rw-text tracking-tight">Organizations</h1>
			if stackrmw.IsAdmin(c) {
				<div class="ml-auto flex items-center gap-2">
					<a href="/setup" class="btn btn-primary btn-sm">+ Create organization</a>
				</div>
			}
		</div>
		@canvas.Canvas(canvas.Opts{
			SaveURL: "/graph/positions",
			CSRF:    csrf(c),
			Empty:   homeEmptyText(c),
		}, g)
		@canvas.Chrome(false)
	}
}

// homeEmptyText is what the root canvas says to someone with no organizations.
// Only a server admin can make one, so for everyone else this page is where
// they wait, and it has to say who to ask.
func homeEmptyText(c echo.Context) string {
	if stackrmw.IsAdmin(c) {
		return "Welcome to stackr. Create your first organization with the button above."
	}
	return "You are not in an organization yet. Ask an administrator to add you."
}

func csrf(c echo.Context) string {
	if v, ok := c.Get("csrf").(string); ok {
		return v
	}
	return ""
}
