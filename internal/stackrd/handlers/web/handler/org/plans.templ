package org

import (
	"github.com/labstack/echo/v4"

	"github.com/FyrmForge/stackr/internal/stackrd/config/stackconf"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components"
	"github.com/FyrmForge/stackr/internal/stackrd/store/repo"
)

// orgPlansPage is every config plan in the org, grouped by what it changes.
templ orgPlansPage(c echo.Context, o *repo.Org, groups []planGroup) {
	@components.Shell(c, o.Name+": plans") {
		<nav class="mb-4 flex items-center gap-1.5 text-sm text-rw-muted">
			<a href={ templ.SafeURL("/orgs/" + o.Slug) } class="hover:text-rw-text transition-colors">{ o.Name }</a>
			<span class="text-rw-faint">/</span>
			<span class="text-rw-text">plans</span>
		</nav>
		<h1 class="text-2xl font-semibold text-rw-text tracking-tight mb-1">Config plans</h1>
		<p class="text-sm text-rw-muted mb-8">Every plan a config file has produced, newest first.</p>
		if len(groups) == 0 {
			<p class="text-sm text-rw-muted">No plans yet. They appear when a bound config file changes.</p>
		}
		for _, g := range groups {
			<div class="mb-8">
				<h2 class="text-sm font-semibold uppercase tracking-wide text-rw-faint mb-3">
					<a href={ templ.SafeURL(g.Href) } class="hover:text-rw-text transition-colors">{ g.Title }</a>
				</h2>
				<ul class="space-y-2">
					for _, r := range g.Rows {
						<li>
							<a href={ templ.SafeURL(r.Href) } class="panel px-4 py-3 flex flex-wrap items-center gap-3 text-sm hover:border-rw-accent/50 transition-colors">
								@planStatus(r.Plan.Status)
								<span class="text-rw-text">{ r.Plan.Summary }</span>
								if r.Plan.EnvSlug != "" {
									<span class="text-xs px-1.5 py-0.5 rounded bg-rw-inset text-rw-muted font-mono">{ r.Plan.EnvSlug }</span>
								} else {
									// A stack-scoped plan carried no chip at all, so it read as
									// an unlabelled duplicate of the env plan beside it rather
									// than as the wider one that also creates the stack's
									// shared instances.
									<span class="text-xs px-1.5 py-0.5 rounded bg-rw-inset text-rw-faint">all environments</span>
								}
								if r.Plan.CommitSHA != "" {
									<span class="text-xs text-rw-faint font-mono">{ short8(r.Plan.CommitSHA) }</span>
								}
								<span class="text-xs text-rw-faint ml-auto">{ r.Plan.CreatedAt.Local().Format("Jan 2 15:04") }</span>
							</a>
						</li>
					}
				</ul>
			</div>
		}
	}
}

// orgPlanPage reviews one org plan. The stack equivalent is planPage in
// handler/project; they read alike on purpose, because they answer the same
// question at two levels.
templ orgPlanPage(c echo.Context, o *repo.Org, cp *repo.ConfigPlan, work *repo.WorkItem) {
	@components.Shell(c, o.Name+": plan") {
		<nav class="mb-4 flex items-center gap-1.5 text-sm text-rw-muted">
			<a href={ templ.SafeURL("/orgs/" + o.Slug) } class="hover:text-rw-text transition-colors">{ o.Name }</a>
			<span class="text-rw-faint">/</span>
			<a href={ templ.SafeURL("/orgs/" + o.Slug + "/plans") } class="hover:text-rw-text transition-colors">plans</a>
			<span class="text-rw-faint">/</span>
			<span class="text-rw-text">plan</span>
		</nav>
		<div class="flex items-center gap-3 mb-2">
			<h1 class="text-2xl font-semibold text-rw-text tracking-tight">Organization plan</h1>
			@planStatus(cp.Status)
		</div>
		@components.PlanBody(c, orgPlanWorkCfg(o, cp, work), stackconf.ParsePlan(cp))
	}
}

// orgPlanWorkCfg is the settings plan page's config: this org's endpoints plus
// the apply banner. The page is addressed by id while an apply is live, because
// the apply can rename the org out from under the slug it was opened on.
func orgPlanWorkCfg(o *repo.Org, cp *repo.ConfigPlan, work *repo.WorkItem) components.PlanViewCfg {
	cfg := orgPlanCfg(o, cp, "/orgs/"+o.Slug+"/plans/"+cp.ID)
	cfg.Work, cfg.PollURL = work, "/orgs/"+o.ID+"/plans/"+cp.ID
	return withoutButtonsWhileApplying(cfg, work)
}

// withoutButtonsWhileApplying takes the decision away for as long as one is
// already being carried out. The plan stays "pending" for the whole apply, so
// both buttons would otherwise stay live: a Reject clicked mid-run is written
// and then overwritten by the apply's own "applied" at the end, and the org is
// built anyway by something the operator just said no to.
func withoutButtonsWhileApplying(cfg components.PlanViewCfg, work *repo.WorkItem) components.PlanViewCfg {
	if work != nil && !work.Done() {
		cfg.ApproveURL, cfg.RejectURL, cfg.InputURL = "", "", ""
	}
	return cfg
}

// orgPlanCfg points the shared plan view at this org's endpoints. base is the
// URL prefix the buttons hang off, which differs between the plans page and the
// wizard's step 3.
func orgPlanCfg(o *repo.Org, cp *repo.ConfigPlan, base string) components.PlanViewCfg {
	cfg := components.PlanViewCfg{
		Summary:   cp.Summary,
		Commit:    cp.CommitSHA,
		When:      cp.CreatedAt.Local().Format("Jan 2 15:04:05"),
		Status:    cp.Status,
		StoredErr: cp.Error,
		ReplanURL: "/orgs/" + o.Slug + "/settings/config",
	}
	if cp.Status == "pending" {
		cfg.ApproveURL = base + "/approve"
		cfg.RejectURL = base + "/reject"
		cfg.InputURL = base + "/inputs"
	}
	return cfg
}

templ planStatus(status string) {
	<span
		class={ "text-xs px-1.5 py-0.5 rounded shrink-0",
			templ.KV("bg-rw-warning/15 text-rw-warning", status == "pending"),
			templ.KV("bg-rw-danger/15 text-rw-danger", status == "error"),
			templ.KV("bg-rw-inset text-rw-muted", status != "pending" && status != "error") }
	>{ status }</span>
}

// orgPlanBanner is the org canvas strip: the same idea as planBanner on the
// stack and env canvases, so a plan is visible at whatever level it belongs to.
// It refreshes itself on any room event, because plans land asynchronously.
templ orgPlanBanner(o *repo.Org, plan *repo.ConfigPlan, pending int, selfURL string) {
	<div
		id="plan-banner"
		data-ws-refresh="org"
		hx-get={ selfURL }
		hx-trigger="refresh"
		hx-select="#plan-banner"
		hx-swap="outerHTML"
		class="contents"
	>
		if pending > 0 {
			<a
				href={ templ.SafeURL(bannerHref(o, plan, pending, selfURL)) }
				class={ "relative z-40 flex items-center gap-2 px-4 sm:px-6 py-2 text-sm border-b border-rw-border shrink-0 transition-colors",
					templ.KV("bg-rw-danger/10 text-rw-danger hover:bg-rw-danger/20", pending == 1 && plan != nil && plan.Status == "error"),
					templ.KV("bg-rw-warning/10 text-rw-warning hover:bg-rw-warning/20", pending != 1 || plan == nil || plan.Status != "error") }
			>
				if pending == 1 && plan != nil && plan.Status == "error" {
					<span>Config invalid. View details</span>
				} else if pending == 1 && plan != nil {
					<span>Config plan pending: { plan.Summary }. View</span>
				} else {
					<span>{ planCount(pending) }. View</span>
				}
			</a>
		}
	</div>
}

// bannerHref goes straight to the plan when there is exactly one to look at,
// and to the list when there is more than one.
func bannerHref(o *repo.Org, plan *repo.ConfigPlan, pending int, selfURL string) string {
	if pending == 1 && plan != nil {
		return "/orgs/" + o.Slug + "/plans/" + plan.ID + planReturn(selfURL)
	}
	return "/orgs/" + o.Slug + "/plans"
}
