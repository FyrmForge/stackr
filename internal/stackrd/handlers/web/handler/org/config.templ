package org

import (
	"github.com/labstack/echo/v4"

	"github.com/FyrmForge/stackr/internal/stackrd/config/orgconf"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components/form"
	"github.com/FyrmForge/stackr/internal/stackrd/store/repo"
)

// The org config-as-code page: the binding form (the stack pattern, one level
// up) plus the org plan history with approve/reject.
templ orgConfigPage(c echo.Context, o *repo.Org, ghConns []repo.Connector, plans []repo.ConfigPlan) {
	@settingsShell(c, o, "config") {
		@form.Section("Export", form.ScopeOrg, "This organization's live state as a stackr-org.yml, the way out of panel-first and into config-as-code. Secrets come out as declarations, never values.") {
			<a href={ templ.SafeURL("/orgs/" + o.Slug + "/settings/config/export") } class="btn btn-ghost btn-sm" download="stackr-org.yml">
				Download stackr-org.yml
			</a>
		}
		@form.Section("Config as code", form.ScopeOrg, "One file declares the whole organization. Its plans are always applied by hand.") {
			if len(ghConns) == 0 {
				<p class="text-sm text-rw-muted">Connect GitHub first. The org file is fetched through a connector. <a href={ templ.SafeURL("/orgs/" + o.Slug + "/settings/connectors") } class="link">Connectors</a></p>
			} else {
				<form hx-post={ "/orgs/" + o.Slug + "/settings/config" } class="space-y-3 max-w-xl">
					@form.CSRFField(c)
					<div>
						<label class="label">Connector</label>
						<select name="connector_id" class="input">
							<option value="">(unbind)</option>
							for _, cn := range ghConns {
								<option value={ cn.ID } selected?={ cn.ID == o.ConfigConnectorID }>{ cn.Name }</option>
							}
						</select>
					</div>
					<div>
						<label class="label">Repository (owner/name)</label>
						<input type="text" name="repo" value={ o.ConfigRepo } placeholder="you/serverconfig" class="input font-mono"/>
					</div>
					<div class="grid grid-cols-2 gap-2">
						<div>
							<label class="label">Branch (empty = default)</label>
							<input type="text" name="branch" value={ o.ConfigBranch } class="input font-mono"/>
						</div>
						<div>
							<label class="label">File path (empty = { orgconf.DefaultPath })</label>
							<input type="text" name="path" value={ o.ConfigPath } placeholder={ orgconf.DefaultPath } class="input font-mono"/>
						</div>
					</div>
					<div class="flex gap-2">
						<button type="submit" class="btn btn-primary btn-sm">Save & plan</button>
						if o.ConfigManaged() {
							<button type="submit" name="plan_only" value="1" class="btn btn-ghost btn-sm">Plan now</button>
						}
					</div>
				</form>
			}
		}
		if len(plans) > 0 {
			<p class="text-sm text-rw-muted mt-6">
				<a href={ templ.SafeURL("/orgs/" + o.Slug + "/plans") } class="link">Plans for this organization</a>
			</p>
		}
	}
}

func short8(s string) string {
	if len(s) > 8 {
		return s[:8]
	}
	return s
}
