package org

import (
	"strconv"

	"github.com/labstack/echo/v4"

	"github.com/FyrmForge/stackr/internal/stackrd/config/orgconf"
	"github.com/FyrmForge/stackr/internal/stackrd/config/stackconf"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/avatar"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components/form"
	"github.com/FyrmForge/stackr/internal/stackrd/infra/githubapp"
	"github.com/FyrmForge/stackr/internal/stackrd/store/repo"
)

// The onboarding wizard. Every step past the first is a thin shell over the
// handler that already does the work, reached on the step's own /setup/ route
// so the handler lands back in the wizard without being told to. Wizard
// position lives in the URL, so there is no session state to lose.

// setupShell is the bare centred page every step shares. total is how many
// dots the stepper draws, which the branch decides; step 0 draws none, for the
// branch question itself, where there is no org and so no branch yet.
templ setupShell(c echo.Context, title, subtitle string, step, total int) {
	@components.Layout(c, "Setup: "+title) {
		<div class="max-w-xl mx-auto mt-16 px-6 pb-16">
			<div class="flex items-center gap-2.5 justify-center mb-7">
				<img src={ components.StaticURL("images/logo-mark.png") } alt="" class="h-9 w-9"/>
				<span class="text-xl font-semibold text-rw-text">stackr</span>
			</div>
			if step > 0 {
				@setupStepper(step, total)
			}
			<div class="panel p-8 shadow-rw">
				if subtitle == "" {
					<h2 class="text-lg font-semibold text-rw-text mb-6">{ title }</h2>
				} else {
					<h2 class="text-lg font-semibold text-rw-text mb-1">{ title }</h2>
					<p class="text-sm text-rw-muted mb-6">{ subtitle }</p>
				}
				{ children... }
			</div>
		</div>
	}
}

// The dots are a picture of where you are, so they carry one label for the whole
// group and are hidden from screen readers individually, read out one at a
// time they are just "1 2 3 4 5" with nothing saying which one you are on.
templ setupStepper(step, total int) {
	<div class="flex items-center justify-center gap-2 mb-6" role="group" aria-label={ stepperLabel(step, total) }>
		for i := 1; i <= total; i++ {
			if i > 1 {
				<span class="w-6 h-px bg-rw-border" aria-hidden="true"></span>
			}
			<span
				class={ "h-6 w-6 rounded-full text-xs font-semibold flex items-center justify-center " + setupDotClass(i, step) }
				aria-hidden="true"
				if i == step {
					aria-current="step"
				}
			>
				{ stepLabel(i) }
			</span>
		}
	</div>
}

// setupNav is the one secondary action every step carries: move on without
// doing this step ("Skip for now"), or move on because it is already done
// ("Continue"). Same place, same shape, on all six.
templ setupNav(href, label string) {
	<a href={ templ.SafeURL(href) } class="btn btn-ghost btn-sm w-full mt-3">{ label }</a>
}

// Step 1. The only step with no org yet, and the fork the rest of the wizard
// hangs off: a config-managed org is named and given its domains by its file,
// so asking for either here throws the answer away seconds later. Both buttons
// post to /orgs, which makes the draft.
templ setupBranchPage(c echo.Context) {
	@setupShell(c, "Set up your organization", "Stacks, variables, domains and people all live inside one.", 0, 0) {
		<form hx-post="/orgs" class="space-y-3">
			@form.CSRFField(c)
			<button type="submit" name="mode" value="config" class="w-full text-left panel px-4 py-3.5 hover:border-rw-accent transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-rw-accent/60">
				<span class="block text-sm font-semibold text-rw-text">Describe it in a config file</span>
				<span class="block mt-0.5 text-xs text-rw-muted">One file in a GitHub repo declares the whole organization, its name included.</span>
			</button>
			<button type="submit" name="mode" value="ui" class="w-full text-left panel px-4 py-3.5 hover:border-rw-accent transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-rw-accent/60">
				<span class="block text-sm font-semibold text-rw-text">Fill it in here</span>
				<span class="block mt-0.5 text-xs text-rw-muted">Name it, connect GitHub and add a domain, step by step.</span>
			</button>
		</form>
	}
}

// The UI branch's name step. It posts to Rename, the same handler the settings
// General tab uses: the slug moves with the name either way.
templ setupNamePage(c echo.Context, o *repo.Org) {
	@setupShell(c, "Name your organization", "It becomes the slug in every URL below it.", setupStepNo(o, "name"), setupTotal(o)) {
		@setupNameForm(c, o, setupNamePrefill(o), "")
	}
}

// The form is its own swap target so a refused name can come back with the name
// still in the box. A redirect to the step would hand back an empty field and
// the reason as a toast in the corner, which is a retype for a typo.
templ setupNameForm(c echo.Context, o *repo.Org, value, errMsg string) {
	<div id="setup-name">
		<form hx-post={ "/orgs/" + o.Slug + "/setup/name" } hx-encoding="multipart/form-data" hx-target="#setup-name" hx-swap="outerHTML" class="space-y-5">
			@form.CSRFField(c)
			<div>
				<label class="label" for="setup-org-name">Organization name</label>
				<input
					type="text"
					id="setup-org-name"
					name="name"
					required
					autofocus
					value={ value }
					data-logo-initials-source
					class={ "input", templ.KV("border-rw-danger", errMsg != "") }
					if errMsg != "" {
						aria-invalid="true"
						aria-describedby="setup-org-name-error"
					}
				/>
				if errMsg != "" {
					<p id="setup-org-name-error" class="mt-1.5 text-xs text-rw-danger">{ errMsg }</p>
				}
			</div>
			<div>
				<span class="label">Logo</span>
				@logoPicker("setup-org-logo", o.AvatarPath, value)
				<p class="mt-1.5 text-xs text-rw-faint">PNG, JPEG, GIF or WebP, up to 2 MB. Falls back to initials.</p>
			</div>
			<button type="submit" class="btn btn-primary w-full">Continue</button>
		</form>
		@setupSwitchToConfig(c, o)
	</div>
}

// The mirror of setupSwitchToUI: picking the wrong branch on step 1 must not be
// a one-way door. Offered on the name step only, once a connector or a domain
// exists, the file would be describing an org that already has hand-made parts.
templ setupSwitchToConfig(c echo.Context, o *repo.Org) {
	<form hx-post={ "/orgs/" + o.Slug + "/setup/mode" } class="mt-3">
		@form.CSRFField(c)
		<input type="hidden" name="mode" value="config"/>
		<button type="submit" class="btn btn-ghost btn-sm w-full">Describe it in a config file instead</button>
	</form>
}

// Step 2. A GitHub App manifest has to be posted by the browser to github.com,
// so this stays a native form; the wizard flag rides a cookie set server-side
// because GitHub sends the user back on its own URL.
templ setupConnectorPage(c echo.Context, o *repo.Org, conns []repo.Connector, repos []githubapp.Repo, loaded bool) {
	@setupShell(c, "Connect GitHub", "A private GitHub App for this organization, so there are no tokens to copy around.", setupStepNo(o, "connector"), setupTotal(o)) {
		if loaded {
			@setupConnectorBody(c, o, conns, repos)
		} else {
			<div hx-get={ "/orgs/" + o.Slug + "/setup/connector?body=1" } hx-trigger="load" hx-swap="outerHTML">
				@components.Loading("Reading repositories.")
			</div>
		}
	}
}

templ setupConnectorBody(c echo.Context, o *repo.Org, conns []repo.Connector, repos []githubapp.Repo) {
	<div>
		if len(conns) == 0 {
			// templint:ignore no-native-form-actions -- response is the auto-submitting redirect page; must replace the document
			<form method="post" action={ templ.SafeURL("/orgs/" + o.Slug + "/setup/connector") } class="space-y-5">
				@form.CSRFField(c)
				<input type="hidden" name="setup" value="1"/>
				<div>
					<label class="label" for="setup-gh-org">GitHub organization (optional)</label>
					<input type="text" id="setup-gh-org" name="gh_org" placeholder="my-github-org" class="input"/>
					<p class="mt-1.5 text-xs text-rw-faint">Leave empty to use your personal account.</p>
				</div>
				<button type="submit" class="btn btn-primary w-full">Connect GitHub</button>
			</form>
			@setupNav(setupNextURL(o, "connector"), "Skip for now")
		} else if len(repos) == 0 {
			// The app exists but GitHub has not been told which repos it may see,
			// so nothing can be cloned yet and config as code would fail on the
			// next step. Installing is part of connecting, not an afterthought.
			<p class="text-sm text-rw-muted mb-5">The app is created. Now choose the repositories it may access, otherwise stackr cannot read any of them.</p>
			<a href={ templ.SafeURL(connectorInstallURL(conns)) } target="_blank" rel="noopener" class="btn btn-primary w-full">Install it on GitHub</a>
			@setupNav("/orgs/"+o.Slug+"/setup/connector", "I installed it, check again")
		} else {
			<p class="text-sm text-rw-muted mb-3">Connected and installed on { repoCount(len(repos)) }.</p>
			<ul class="space-y-2 mb-5">
				for _, r := range firstRepos(repos, 5) {
					<li class="panel px-3 py-2 font-mono text-xs text-rw-muted">{ r.FullName }</li>
				}
				if n := moreRepos(repos, 5); n > 0 {
					<li class="panel px-3 py-2 text-xs text-rw-faint">{ strconv.Itoa(n) } more</li>
				}
			</ul>
			<a href={ templ.SafeURL(setupNextURL(o, "connector")) } class="btn btn-primary w-full">Continue</a>
			@setupNav(connectorInstallURL(conns), "Change which repositories it can see")
		}
	</div>
}

// Step 3. Same binding form as the settings page, minus the plan history.
// Values are checked when the file is applied, not while you type.
templ setupConfigPage(c echo.Context, o *repo.Org, conns []repo.Connector, repos []githubapp.Repo, loaded bool) {
	@setupShell(c, "Config as code", "One file in a repo declares the whole organization. Its plans are always applied by hand.", setupStepNo(o, "config"), setupTotal(o)) {
		if loaded {
			@setupConfigBody(c, o, conns, repos)
		} else {
			<div hx-get={ "/orgs/" + o.Slug + "/setup/config?body=1" } hx-trigger="load" hx-swap="outerHTML">
				@components.Loading("Reading repositories.")
			</div>
		}
	}
}

templ setupConfigBody(c echo.Context, o *repo.Org, conns []repo.Connector, repos []githubapp.Repo) {
	<div>
		if len(conns) == 0 {
			<p class="text-sm text-rw-muted mb-5">This needs a GitHub connector, and this organization has none yet.</p>
			<a href={ templ.SafeURL("/orgs/" + o.Slug + "/setup/connector") } class="btn btn-primary w-full">Connect GitHub</a>
			@setupSwitchToUI(c, o)
		} else if len(repos) == 0 {
			// A connector whose app is installed nowhere can read no file, so
			// binding one here would only fail at plan time.
			<p class="text-sm text-rw-muted mb-5">The GitHub app for this organization is not installed on any repository yet, so there is nothing for it to read. Install it, then come back.</p>
			<a href={ templ.SafeURL(connectorInstallURL(conns)) } target="_blank" rel="noopener" class="btn btn-primary w-full">Install it on GitHub</a>
			@setupNav("/orgs/"+o.Slug+"/setup/config", "I installed it, check again")
			@setupSwitchToUI(c, o)
		} else {
			<form hx-post={ "/orgs/" + o.Slug + "/setup/config" } class="space-y-5">
				@form.CSRFField(c)
				<div>
					<label class="label" for="setup-conn">Connector</label>
					<select id="setup-conn" name="connector_id" class="input">
						for _, cn := range conns {
							<option value={ cn.ID } selected?={ cn.ID == o.ConfigConnectorID }>{ cn.Name }</option>
						}
					</select>
				</div>
				@repoPicker(o, repos)
				<button type="submit" class="btn btn-primary w-full">Save and plan</button>
			</form>
			@setupSwitchToUI(c, o)
		}
	</div>
}

// Step 3, second screen. Binding a file produces a plan and the plan is the
// decision, so it belongs to the step that made it rather than to a settings
// page the wizard has not let anyone reach yet. Same review component the plans
// page uses; only the buttons differ.
templ setupPlanPage(c echo.Context, o *repo.Org, cp *repo.ConfigPlan) {
	@setupShell(c, "Review the plan", "This is what applying the config file does to this organization.", setupStepNo(o, "plan"), setupTotal(o)) {
		@components.PlanBody(c, setupPlanCfg(o, cp), stackconf.ParsePlan(cp))
	}
}

// The config branch's only way out of the config step. Walking past an
// unapplied file would leave an org with config_repo set, no config ever
// reconciled, and a placeholder for a name, the second of the two bugs this
// wizard was rebuilt for. Switching clears the binding instead.
templ setupSwitchToUI(c echo.Context, o *repo.Org) {
	<form hx-post={ "/orgs/" + o.Slug + "/setup/mode" } class="mt-3">
		@form.CSRFField(c)
		<input type="hidden" name="mode" value="ui"/>
		<button type="submit" class="btn btn-ghost btn-sm w-full">Fill it in here instead</button>
	</form>
}

// Discard sits on the summary because that is the page every gated route lands
// an owner on, so it is the one place an abandoned draft is always reachable
// from. It is a real delete, which is why it asks first.
templ setupDiscard(c echo.Context, o *repo.Org) {
	<form hx-post={ "/orgs/" + o.Slug + "/delete" } hx-confirm="Delete this organization and everything set up in it?" class="mt-8 pt-4 border-t border-rw-border text-center">
		@form.CSRFField(c)
		<button type="submit" class="inline-block px-4 py-3.5 text-xs text-rw-faint hover:text-rw-danger transition-colors">Discard this organization</button>
	</form>
}

// domainHeading / domainSubtitle: a managed org is not being asked for a
// domain, so the step does not tell it to point an A record anywhere.
func domainHeading(o *repo.Org) string {
	if o.ConfigManaged() {
		return "Domains"
	}
	return "Add a domain"
}

func domainSubtitle(o *repo.Org) string {
	if o.ConfigManaged() {
		return ""
	}
	return "Stacks generate their hostnames under it. Point an A record at this server first."
}

// Step 4. Prefilled with the org slug under the server's own domain when
// BASE_URL says what that is; empty otherwise, since a LAN install has no base
// domain to guess from.
templ setupDomainPage(c echo.Context, o *repo.Org, res []repo.DomainResource) {
	@setupShell(c, domainHeading(o), domainSubtitle(o), setupStepNo(o, "domain"), setupTotal(o)) {
		if o.ConfigManaged() {
			// Read-only rather than prose: the same box the other branch asks
			// for, showing what the file already declares. It used to be a
			// paragraph pointing at /servers/local, which is adminOnly and so
			// 404s for an org owner who is not a server admin.
			<div class="space-y-2">
				for _, r := range res {
					<input type="text" value={ r.Host } readonly aria-label="Domain" class="input font-mono text-rw-muted cursor-default"/>
				}
				if len(res) == 0 {
					<input type="text" value={ setupDomainPrefill(o) } readonly aria-label="Domain" class="input font-mono text-rw-muted cursor-default"/>
				}
			</div>
			if len(res) == 0 {
				<p class="mt-1.5 text-xs text-rw-faint">Default. Add a <span class="font-mono">domains:</span> block to your config file to change it.</p>
			} else {
				<p class="mt-1.5 text-xs text-rw-faint">Domains managed by config.</p>
			}
			@setupNav(setupNextURL(o, "domain"), "Continue")
		} else {
			<form hx-post={ "/orgs/" + o.Slug + "/setup/domain" } class="space-y-5">
				@form.CSRFField(c)
				<div>
					<label class="label" for="setup-host">Host</label>
					<input type="text" id="setup-host" name="host" required value={ setupDomainPrefill(o) } placeholder="example.com" class="input font-mono"/>
					<p class="mt-1.5 text-xs text-rw-faint">A bare lowercase hostname, unique across the server.</p>
				</div>
				<label class="flex items-center gap-2 text-sm text-rw-muted cursor-pointer">
					<input type="checkbox" name="include_env_on_default" value="1" class="accent-rw-accent"/>
					Include env slug on the default env (api.prod.stack instead of api.stack)
				</label>
				<button type="submit" class="btn btn-primary w-full">Add domain</button>
			</form>
			@setupNav(setupNextURL(o, "domain"), "Skip for now")
		}
	}
}

// Step 5. The same People panel and list the settings tab shows. Continue is
// the primary action here, so the panel's own add button steps back to a
// secondary the way it does nowhere else.
templ setupTeamPage(c echo.Context, o *repo.Org, rows []personRow, candidates []repo.User, canMail bool) {
	@setupShell(c, "Add people", "Everyone gets an invitation to accept, whether or not they already have an account.", setupStepNo(o, "team"), setupTotal(o)) {
		<div class="rounded-lg border border-rw-border bg-rw-inset/40 p-4">
			@peoplePanel(c, o, "/orgs/"+o.Slug+"/setup/team", candidates, canMail)
		</div>
		if len(rows) > 0 {
			<div class="mt-6">
				@peopleList(c, o, rows, "/orgs/"+o.Slug+"/setup/team", canMail, true)
			</div>
		}
		<a href={ templ.SafeURL(setupNextURL(o, "team")) } class="btn btn-primary w-full mt-6">Continue</a>
	}
}

// This page is where every gated route lands its owner (plan 29), so it has to
// read as the thing standing between them and the org, not as a victory lap.
// Once Finish has been pressed the wizard is reachable again from the summary
// links, and then the old copy is the true one.
func doneHeading(o *repo.Org) string {
	if o.SetupDoneAt == nil {
		if o.Name == setupDraftName {
			// Saying "Finish setting up Untitled organization" over a page whose
			// body is "this has no name yet" is the page arguing with itself.
			return "Finish setting up this organization"
		}
		return "Finish setting up " + o.Name
	}
	return o.Name + " is ready"
}

func doneSubtitle(o *repo.Org) string {
	if o.SetupDoneAt == nil {
		return "Nothing else in this organization opens until you do."
	}
	return "Anything skipped is one tab away in settings."
}

// Step 6.
templ setupDonePage(c echo.Context, o *repo.Org, done []setupItem) {
	@setupShell(c, doneHeading(o), doneSubtitle(o), setupStepNo(o, "done"), setupTotal(o)) {
		<ul class="space-y-2 mb-6">
			for _, it := range done {
				<li class="panel px-3 py-2.5 flex items-center gap-2 text-sm">
					if it.Done {
						<span class="text-rw-success">✓</span>
						<span class="text-rw-text">{ it.Label }</span>
					} else {
						<span class="text-rw-faint">•</span>
						<span class="text-rw-muted">{ it.Label }</span>
					}
					if it.Href != "" {
						<a href={ templ.SafeURL(it.Href) } class="ml-auto -my-2.5 px-3 py-3.5 text-xs text-rw-faint hover:text-rw-text transition-colors">Edit</a>
					}
				</li>
			}
		</ul>
		if o.Name == setupDraftName {
			// Nothing has named this org yet, and on this branch only the apply
			// can: finishing here would leave an organization called
			// "Untitled organization" living at a random slug forever.
			<p class="text-sm text-rw-muted mb-4">This organization has no name yet. Its config file gives it one when the plan is applied.</p>
			<a href={ templ.SafeURL("/orgs/" + o.Slug + "/setup/config") } class="btn btn-primary w-full">Back to the config file</a>
		} else {
			<form hx-post={ "/orgs/" + o.Slug + "/setup/done" }>
				@form.CSRFField(c)
				<button type="submit" class="btn btn-primary w-full">Finish and go to { o.Name }</button>
			</form>
		}
		if o.SetupDoneAt == nil {
			@setupDiscard(c, o)
		}
	}
}

// peoplePanel is shared by wizard step 5 and the People settings tab: one add
// flow, whoever the person is. Every address becomes an invite bound to it,
// emailed when this server can send mail and copyable either way, an account
// is never joined to an org it did not agree to, and answering differently for
// an address that has one would make this an account-existence oracle for any
// org owner (TestAddMemberAlwaysInvites). The roster below is a shortcut to
// filling the field in, not a second path.
//
// Server admins get the roster to pick from, because they can already see
// every account. Org owners who are not admins do not: a browsable list would
// let any org owner enumerate the whole server's users.
templ peoplePanel(c echo.Context, o *repo.Org, base string, candidates []repo.User, canMail bool) {
	if len(candidates) > 0 {
		<div class="mb-5">
			<span class="label">People on this server</span>
			<ul class="space-y-2 mt-1.5">
				for _, u := range candidates {
					<li class="panel px-3 py-2 flex items-center gap-2">
						@components.Avatar(u.AvatarPath, u.Name, "h-7 w-7 text-xs")
						<span class="min-w-0 flex-1">
							<span class="block text-sm text-rw-text truncate">{ u.Name }</span>
							<span class="block text-xs text-rw-faint truncate">{ u.Email }</span>
						</span>
						<form hx-post={ base + "/members" } class="flex items-center gap-1.5">
							@form.CSRFField(c)
							<input type="hidden" name="email" value={ u.Email }/>
							<select name="role" aria-label={ "Role for " + u.Name } class="input !w-24 !py-1 text-xs">
								<option value="member">member</option>
								<option value="viewer">viewer</option>
								<option value="owner">owner</option>
							</select>
							<button type="submit" class="btn btn-ghost btn-sm">Invite</button>
						</form>
					</li>
				}
			</ul>
		</div>
	}
	<form hx-post={ base + "/members" } class="people-add space-y-4">
		@form.CSRFField(c)
		<div>
			<label class="label" for="people-email">Email address</label>
			<input type="email" id="people-email" name="email" required placeholder="person@example.com" class="input"/>
			<p class="mt-1.5 text-xs text-rw-faint">
				if canMail {
					They get an invitation to accept, emailed to this address.
				} else {
					They get an invitation to accept. This server sends no mail, so the link is yours to send.
				}
			</p>
		</div>
		@roleButtons()
		<div class="flex items-end gap-3">
			<div>
				<label class="label" for="people-expires">Invite expires after (days)</label>
				<input type="number" id="people-expires" name="expires_days" value="14" min="1" max="365" class="input w-32"/>
			</div>
			<button type="submit" class="btn btn-ghost btn-sm people-add-submit">Add to organization</button>
		</div>
	</form>
}

// peopleList is the org's people in one list: members, invites nobody has
// accepted yet, and invites that ran out. They come from different tables but
// they are the same question (who is in this org) so they are one list, and
// the buttons on a row are whatever that row's state allows.
templ peopleList(c echo.Context, o *repo.Org, rows []personRow, base string, canMail bool, isOwner bool) {
	<ul class="space-y-2">
		for _, p := range rows {
			<li class="panel px-3 py-2.5 flex flex-wrap items-center gap-2">
				@components.Avatar(p.AvatarPath, p.Name, "h-8 w-8 text-xs")
				<span class="min-w-[12rem] flex-1">
					<span class="block text-sm text-rw-text truncate">{ p.Name }</span>
					switch p.State {
						case "member":
							<span class="block text-xs text-rw-faint truncate">{ p.Email }</span>
						case "expired":
							<span class="block text-xs text-rw-danger truncate">Invite expired { p.Invite.ExpiresAt.Local().Format("Jan 2 2006") }</span>
						default:
							<span class="block text-xs text-rw-warning truncate">Invited, expires { p.Invite.ExpiresAt.Local().Format("Jan 2 2006") }</span>
					}
				</span>
				if p.State == "member" && isOwner && !isSelf(c, p.UserID) {
					<form hx-post={ base + "/members/" + p.UserID + "/role" } class="flex items-center gap-1.5">
						@form.CSRFField(c)
						<select name="role" aria-label={ "Role for " + p.Name } class="input !w-24 !py-1 text-xs">
							<option value="owner" selected?={ p.Role == "owner" }>owner</option>
							<option value="member" selected?={ p.Role == "member" }>member</option>
							<option value="viewer" selected?={ p.Role == "viewer" }>viewer</option>
						</select>
						<button type="submit" class="btn btn-ghost btn-sm">Set</button>
					</form>
					<form hx-post={ base + "/members/" + p.UserID + "/remove" } hx-confirm={ "Remove " + p.Name + " from " + o.Name + "?" }>
						@form.CSRFField(c)
						<button type="submit" class="btn btn-danger btn-sm">Remove</button>
					</form>
				} else {
					<span class="text-xs px-1.5 py-0.5 rounded bg-rw-inset text-rw-muted">{ p.Role }</span>
					if isOwner {
						switch p.State {
							case "pending":
								<button type="button" data-copy={ inviteURL(c, p.Invite.ID) } class="btn btn-ghost btn-sm">Copy invite</button>
								if canMail {
									<form hx-post={ base + "/invites/" + p.Invite.ID + "/resend" }>
										@form.CSRFField(c)
										<button type="submit" class="btn btn-ghost btn-sm">Resend</button>
									</form>
								}
								<form hx-post={ base + "/invites/" + p.Invite.ID + "/delete" }>
									@form.CSRFField(c)
									<button type="submit" class="btn btn-danger btn-sm">Revoke</button>
								</form>
							case "expired":
								<form hx-post={ base + "/invites/" + p.Invite.ID + "/reinvite" }>
									@form.CSRFField(c)
									<button type="submit" class="btn btn-primary btn-sm">Reinvite</button>
								</form>
								<form hx-post={ base + "/invites/" + p.Invite.ID + "/delete" }>
									@form.CSRFField(c)
									<button type="submit" class="btn btn-ghost btn-sm">Remove</button>
								</form>
						}
					}
				}
			</li>
		}
	</ul>
}

// roleButtons is the role picker as a segmented control: the radio itself is
// hidden and the label carries the selected state, so it reads like the rest of
// the form's controls instead of like a browser radio.
templ roleButtons() {
	<fieldset>
		<legend class="label">Role</legend>
		<div class="flex gap-2">
			for _, r := range []string{"owner", "member", "viewer"} {
				<label class="flex-1 cursor-pointer">
					<input type="radio" name="role" value={ r } checked?={ r == "member" } class="peer sr-only"/>
					<span class="block text-center rounded-lg border border-rw-border bg-rw-inset px-3 py-1.5 text-sm text-rw-muted transition-colors hover:text-rw-text peer-checked:border-rw-accent peer-checked:bg-rw-accent/10 peer-checked:text-rw-text peer-focus-visible:ring-2 peer-focus-visible:ring-rw-accent/40">{ r }</span>
				</label>
			}
		</div>
	</fieldset>
}

// repoPicker is the repository, branch and file-path trio of the config-as-code
// form. The repository list is rendered here rather than fetched: the install
// gate one step earlier already loaded it. Branch and path are looked up from
// the picked repo (main.js), because neither is knowable until there is one.
//
// The field still accepts anything typed. An app installed seconds ago can list
// nothing yet, and refusing what the user knows is there would be worse than a
// plan that reports "repo not found".
templ repoPicker(o *repo.Org, repos []githubapp.Repo) {
	<div data-repo-picker data-picker-base={ "/orgs/" + o.Slug + "/settings/connectors" } class="space-y-5">
		<div>
			<label class="label" for="setup-repo">Repository (owner/name)</label>
			<div class="relative">
				<input
					type="text"
					id="setup-repo"
					name="repo"
					value={ o.ConfigRepo }
					required
					placeholder="you/serverconfig"
					autocomplete="off"
					role="combobox"
					aria-expanded="false"
					aria-autocomplete="list"
					aria-controls="setup-repo-list"
					data-combo-input
					class="input font-mono"
				/>
				<ul id="setup-repo-list" role="listbox" aria-label="Repositories" hidden data-combo-list class="combo-list">
					for _, r := range repos {
						<li role="option" aria-selected="false" data-value={ r.FullName } data-branch={ r.DefaultBranch } class="combo-option">{ r.FullName }</li>
					}
				</ul>
			</div>
			<p class="mt-1.5 text-xs text-rw-faint">Type to filter what this connector can see.</p>
		</div>
		<div class="grid grid-cols-2 gap-3">
			<div>
				<label class="label" for="setup-branch">Branch</label>
				<input type="text" id="setup-branch" name="branch" value={ o.ConfigBranch } list="setup-branch-list" autocomplete="off" data-branch-input class="input font-mono"/>
				<datalist id="setup-branch-list" data-branch-list></datalist>
			</div>
			<div>
				<label class="label" for="setup-path">File path</label>
				<input type="text" id="setup-path" name="path" value={ o.ConfigPath } placeholder={ orgconf.DefaultPath } autocomplete="off" data-path-input class="input font-mono"/>
				<p data-path-note aria-live="polite" class="mt-1.5 text-xs text-rw-faint"></p>
			</div>
		</div>
	</div>
}

// logoPicker is the org logo field on both the wizard's first step and the
// General settings tab. The file input is the browser's own, and its "Choose
// File" chrome cannot be styled, so it hides behind the tile it fills in.
// current is the logo already saved, if any: it shows in the tile until a new
// file replaces it, so the field reads as "this is the logo" rather than as an
// empty box beside one.
templ logoPicker(id, current, name string) {
	<label for={ id } class="flex items-center gap-3 cursor-pointer">
		<span class="h-11 w-11 shrink-0 rounded-xl bg-rw-inset border border-dashed border-rw-border flex items-center justify-center overflow-hidden text-sm font-semibold text-rw-faint">
			if url := avatar.URL(current); url != "" {
				<img data-logo-img src={ url } alt="" class="h-full w-full object-cover"/>
				<span data-logo-initials class="hidden"></span>
			} else {
				<img data-logo-img alt="" class="hidden h-full w-full object-cover"/>
				<span data-logo-initials>
					if name != "" {
						{ components.Initials(name) }
					}
				</span>
			}
		</span>
		<span data-logo-name class="text-sm text-rw-muted">Choose an image</span>
		<input type="file" id={ id } name="logo" accept={ avatar.Accept } aria-label="Organization logo" data-logo-input class="sr-only"/>
	</label>
}
