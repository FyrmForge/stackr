package org

import (
	"strconv"

	"github.com/labstack/echo/v4"

	"github.com/FyrmForge/stackr/internal/stackrd/store/repo"
	settingspage "github.com/FyrmForge/stackr/internal/stackrd/handlers/web/handler/settings"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components/form"
)

// The organization's settings. This used to be a drawer behind the org's own
// card on its canvas, reachable only if you thought to click it, while the
// org-scoped connectors lived on the global settings page and org variables
// had no UI at all. All three are here now.

func nav(o *repo.Org, active string) []form.NavItem {
	base := "/orgs/" + o.Slug + "/settings"
	return []form.NavItem{
		{Label: "General", Href: base + "/general", Active: active == "general"},
		{Label: "People", Href: base + "/members", Active: active == "members"},
		{Label: "Connectors", Href: base + "/connectors", Active: active == "connectors"},
		{Label: "Variables", Href: base + "/variables", Active: active == "variables"},
		{Label: "Domains", Href: base + "/domains", Active: active == "domains"},
		{Label: "Backups", Href: base + "/backups", Active: active == "backups"},
		{Label: "Registry", Href: base + "/registry", Active: active == "registry"},
		{Label: "Defaults", Href: base + "/defaults", Active: active == "defaults"},
		{Label: "Config as code", Href: base + "/config", Active: active == "config"},
	}
}

templ settingsShell(c echo.Context, o *repo.Org, active string) {
	@components.Shell(c, o.Name+": settings") {
		<nav class="mb-4 flex items-center gap-1.5 text-sm text-rw-muted">
			<a href={ templ.SafeURL("/orgs/" + o.Slug) } class="hover:text-rw-text transition-colors">{ o.Name }</a>
			<span class="text-rw-faint">/</span>
			<span class="text-rw-text">settings</span>
		</nav>
		<h1 class="text-2xl font-semibold text-rw-text tracking-tight mb-1">{ o.Name }</h1>
		<p class="text-sm text-rw-muted mb-8 font-mono">/{ o.Slug }</p>
		@form.SettingsLayout(nav(o, active)) {
			{ children... }
		}
	}
}

templ orgGeneralPage(c echo.Context, o *repo.Org, isOwner bool, stacks int, otherOrgs []repo.Org, envColors []envColorRow) {
	@settingsShell(c, o, "general") {
		@form.Section("Organization", form.ScopeOrg, "The name is the slug in every URL below it, so renaming moves them.") {
			if isOwner {
				@form.SettingsFormUpload(c, "/orgs/"+o.Slug+"/rename") {
					@form.Field("Logo", "PNG, JPEG, GIF or WebP, up to 2 MB. Falls back to initials.") {
						@logoPicker("org-logo", o.AvatarPath, o.Name)
						if o.AvatarPath != "" {
							<label class="flex items-center gap-2 text-xs text-rw-faint mt-2">
								<input type="checkbox" name="remove_logo" value="1" class="accent-rw-accent"/>
								Remove it and go back to initials
							</label>
						}
					}
					@form.Field("Name", "Renaming breaks existing links.") {
						<input type="text" name="name" value={ o.Name } required class="input"/>
					}
					@form.Save("Save")
				}
			} else {
				@form.Field("Name", "Only an owner can rename this organization.") {
					<input type="text" value={ o.Name } disabled class="input"/>
				}
			}
		}
		if isOwner {
			@form.DangerSection("") {
				if len(otherOrgs) > 0 {
					<div class="mb-5">
						<p class="text-sm text-rw-muted mb-2">Move a stack here from another organization. Its connectors are re-resolved against this org.</p>
						<a href="/" class="btn btn-ghost btn-sm">Choose a stack on the canvas</a>
					</div>
				}
				if stacks == 0 {
					@components.ConfirmDanger(c, components.ConfirmCfg{
						PostURL: "/orgs/" + o.Slug + "/delete",
						Want:    o.Slug,
						Path:    o.Slug,
						Warning: "Deleting this organization removes its members, connectors, domain resources and settings.",
						Label:   "Delete organization",
						ID:      "org-delete",
					})
				} else {
					<p class="text-sm text-rw-faint">This organization still holds { stackCount(stacks) }. Move or delete them before it can be deleted.</p>
				}
			}
		}
		if len(envColors) > 0 {
			@form.Section("Environment colours", form.ScopeOrg, "The default colour for every environment with this slug, in every stack here. A stack can override it in its own settings.") {
				<ul class="space-y-2">
					for _, row := range envColors {
						<li class="panel px-4 py-3 flex flex-wrap items-center gap-3">
							<span class="text-sm text-rw-text font-mono w-28 truncate">{ row.Slug }</span>
							if o.ConfigManaged() || !isOwner {
								@components.EnvDot(row.CSS, "h-4 w-4")
								<span class="ml-auto">
									@components.EnvColorSource(row.Source)
								</span>
							} else {
								<form hx-post={ "/orgs/" + o.Slug + "/settings/env-colors" } class="flex flex-wrap items-center gap-3 flex-1">
									@form.CSRFField(c)
									<input type="hidden" name="slug" value={ row.Slug }/>
									@components.EnvColorPicker(row.Current)
									<span class="ml-auto flex items-center gap-2">
										@components.EnvColorSource(row.Source)
										<button type="submit" class="btn btn-ghost btn-sm">Save</button>
									</span>
								</form>
							}
						</li>
					}
				</ul>
				if o.ConfigManaged() {
					<p class="text-xs text-rw-faint mt-3">This organization is managed from its config repository. Set <code class="font-mono">defaults.env_colors</code> there.</p>
				}
			}
		}
	}
}

// orgMembersPage is the People tab: the add panel on top, then everyone in the
// org (members and invites alike) in one list.
templ orgMembersPage(c echo.Context, o *repo.Org, rows []personRow, candidates []repo.User, canMail bool, isOwner bool) {
	@settingsShell(c, o, "members") {
		if isOwner {
			@form.Section("Add people", form.ScopeOrg, "Everyone gets an invite link to accept, and that link is a credential.") {
				@peoplePanel(c, o, "/orgs/"+o.Slug, candidates, canMail)
			}
		}
		@form.Section("People", form.ScopeOrg, "Owners manage the organization. Members have full access to its stacks, viewers are read-only.") {
			@peopleList(c, o, rows, "/orgs/"+o.Slug, canMail, isOwner)
		}
	}
}

templ orgBackupsPage(c echo.Context, o *repo.Org, dests []repo.BackupDestination) {
	@settingsShell(c, o, "backups") {
		@settingspage.DestinationsSection(c, dests, "/orgs/"+o.Slug+"/settings/backups/destinations", false)
	}
}

templ orgConnectorsPage(c echo.Context, o *repo.Org, conns settingspage.OrgConnectors) {
	@settingsShell(c, o, "connectors") {
		@form.Section("Connectors", form.ScopeOrg, "A private GitHub App for this organization, so there are no tokens to copy around.") {
			if len(conns.Items) > 0 {
				<ul class="space-y-2 mb-5">
					for _, cn := range conns.Items {
						<li class="panel px-4 py-3 flex flex-wrap items-center gap-3">
							<span class="text-sm text-rw-text">{ cn.Name }</span>
							if cn.Connected {
								<a href={ templ.SafeURL("https://github.com/apps/" + cn.Slug + "/installations/new") } target="_blank" rel="noopener" class="btn btn-ghost btn-sm ml-auto">Manage installation</a>
							} else {
								<span class="text-rw-faint text-xs ml-auto">setup not finished</span>
							}
							<form hx-post={ "/orgs/" + o.Slug + "/settings/connectors/" + cn.ID + "/delete" } hx-confirm="Remove this connector? Stacks using it fall back to unauthenticated clones and PR environments stop working.">
								@form.CSRFField(c)
								<button type="submit" class="btn btn-danger btn-sm">Remove</button>
							</form>
						</li>
					}
				</ul>
			}
			// A GitHub App manifest must be posted by the browser to github.com,
			// so this one form is a native POST rather than an htmx request.
			// templint:ignore no-native-form-actions -- response is the auto-submitting redirect page; must replace the document
			<form method="post" action={ templ.SafeURL("/orgs/" + o.Slug + "/settings/connectors/github") } class="space-y-4">
				@form.CSRFField(c)
				@form.Field("GitHub organization", "Leave empty to use your personal account.") {
					<input type="text" name="gh_org" placeholder="my-github-org" class="input"/>
				}
				<button type="submit" class="btn btn-primary btn-sm">Connect GitHub</button>
			</form>
		}
	}
}

templ orgVariablesPage(c echo.Context, o *repo.Org, vars []repo.Variable, cfg components.VarsEditCfg, events []repo.AuditEvent) {
	@settingsShell(c, o, "variables") {
		@form.Section("Organization variables", form.ScopeOrg, "Shared by every stack here. Reference one as ${{ org.vars.NAME }} or ${{ org.secrets.NAME }}.") {
			@components.VarsEditor(c, vars, cfg)
		}
		@form.Section("Secret activity", form.ScopeOrg, "Every read and write of these secrets.") {
			@components.AuditList(events)
		}
	}
}

templ orgDomainsPage(c echo.Context, o *repo.Org, res []repo.DomainResource, canWrite bool) {
	@settingsShell(c, o, "domains") {
		@form.Section("Organization domains", form.ScopeOrg, "Every stack in this organization can generate per-environment hostnames under one of these, like app.stack."+firstResHostOr(res, "example.com")+". Hosts are unique across the whole server.") {
			if len(res) > 0 {
				<ul class="space-y-2 mb-5">
					for _, r := range res {
						<li class="panel px-3 py-2.5 flex flex-wrap items-center gap-2">
							<span class="font-mono text-sm text-rw-text">{ r.Host }</span>
							if r.IncludeEnvOnDefault {
								<span class="text-xs px-1.5 py-0.5 rounded bg-rw-inset text-rw-muted">env slug on default env</span>
							}
							if canWrite && !o.ConfigManaged() {
								<form hx-post={ "/orgs/" + o.Slug + "/settings/domains/delete" } hx-confirm={ "Remove \"" + r.Host + "\"? New auto hostnames stop nesting under it." } class="ml-auto">
									@form.CSRFField(c)
									<input type="hidden" name="id" value={ r.ID }/>
									<button type="submit" class="btn btn-ghost btn-sm">Delete</button>
								</form>
							}
						</li>
					}
				</ul>
			} else {
				<p class="text-sm text-rw-faint mb-5">No domains yet.</p>
			}
			if o.ConfigManaged() {
				<p class="text-sm text-rw-faint">Declare this organization's domains under <span class="font-mono text-rw-text">domains:</span> in its config file.</p>
			} else if canWrite {
				@form.SettingsForm(c, "/orgs/"+o.Slug+"/settings/domains") {
					@form.Field("Host", "A bare lowercase hostname, e.g. example.com.") {
						<input type="text" name="host" required placeholder="example.com" class="input font-mono"/>
					}
					<label class="flex items-center gap-2 text-sm text-rw-muted cursor-pointer">
						<input type="checkbox" name="include_env_on_default" value="1" class="accent-rw-accent"/>
						Include env slug on default env (api.prod.stack instead of api.stack)
					</label>
					@form.Save("Add domain")
				}
			}
		}
	}
}

// firstResHostOr is the first resource's host, or a placeholder for the blurb.
func firstResHostOr(res []repo.DomainResource, fallback string) string {
	if len(res) > 0 {
		return res[0].Host
	}
	return fallback
}

// orgVarsPanel is the canvas drawer view of the org's variables: inline row
// editing, no standing form (components.VarsEdit).
templ orgVarsPanel(c echo.Context, o *repo.Org, vars []repo.Variable, cfg components.VarsEditCfg) {
	@components.PanelHeader(components.PanelHead{
		Title: varsPanelTitle("Organization", cfg.Class), Subtitle: o.Name, InDrawer: true,
	}, orgVarsPanelIcon(), orgVarsPanelActions(o))
	<div class="px-4 sm:px-6 py-5" hx-target="#drawer-body" hx-swap="innerHTML" hx-vals={ "{\"class\":\"" + cfg.Class + "\"}" }>
		@components.VarsEdit(c, vars, cfg)
	</div>
}

// varsPanelTitle names the drawer after the card that opened it.
func varsPanelTitle(scope, class string) string {
	if class == "secret" {
		return scope + " secrets"
	}
	return scope + " variables"
}

templ orgVarsPanelActions(o *repo.Org) {
	<a href={ templ.SafeURL("/orgs/" + o.Slug + "/settings/variables") } class="btn btn-ghost btn-sm">All settings</a>
}

// orgVarsPanelIcon matches the vars card's tag glyph on the canvas.
templ orgVarsPanelIcon() {
	<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
		<path d="M4 7V5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v2"></path>
		<path d="M9 20h6"></path>
		<path d="M12 4v16"></path>
	</svg>
}

func stackCount(n int) string {
	if n == 1 {
		return "1 stack"
	}
	return strconv.Itoa(n) + " stacks"
}
