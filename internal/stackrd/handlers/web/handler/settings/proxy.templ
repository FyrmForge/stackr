package settings

import (
	"github.com/labstack/echo/v4"

	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components/form"
)

// The /admin/proxy page: the live static config, the verbatim override
// editor, and the operator's named dynamic entries.
templ proxyPage(c echo.Context, current, override string, names []string, entries map[string]string, trusted string, trustCloudflare bool) {
	@page(c, "proxy", "Traefik escape hatches: a verbatim static-config override and hand-written dynamic entries.") {
		<div class="space-y-10">
			<section>
				<h2 class="text-sm font-semibold uppercase tracking-wide text-rw-faint mb-3">Trusted proxies</h2>
				<form hx-post="/admin/proxy/trusted" class="space-y-2">
					@form.CSRFField(c)
					<textarea name="trusted_proxies" aria-label="Trusted proxy CIDRs" rows="4" placeholder="one CIDR per line" class="input font-mono text-xs w-full">{ trusted }</textarea>
					<label class="flex items-center gap-2 text-sm text-rw-text cursor-pointer">
						<input type="checkbox" name="trust_cloudflare" value="1" checked?={ trustCloudflare } class="accent-rw-accent"/>
						Trust Cloudflare
					</label>
					<p class="text-xs text-rw-faint">Fetched from cloudflare.com on save and restart.</p>
					if override != "" {
						<p class="text-xs text-rw-warn">The static override below replaces this list.</p>
					}
					<button type="submit" class="btn btn-primary btn-sm">Save</button>
				</form>
			</section>
			<section>
				<div class="flex items-center gap-2 mb-1">
					<h2 class="text-sm font-semibold uppercase tracking-wide text-rw-faint">Static config</h2>
					if override != "" {
						<span class="text-[10px] px-1.5 py-0.5 rounded bg-rw-warn/15 text-rw-warn">override active, differs from generated</span>
					}
				</div>
				<p class="text-xs text-rw-faint mb-3">
					The current <span class="font-mono">traefik.yml</span>. Saving an override replaces the generated file verbatim (replace, not merge) and restarts Traefik; empty reverts to generated. Generated-default improvements stop reaching this server while an override is active.
				</p>
				<form hx-post="/admin/proxy/override" class="space-y-2">
					@form.CSRFField(c)
					<textarea name="static_override" rows="14" data-code="yaml" placeholder={ current } class="input font-mono text-xs w-full">{ override }</textarea>
					<div class="flex gap-2">
						<button type="submit" class="btn btn-primary btn-sm">Save override</button>
					</div>
					<p class="text-xs text-rw-faint">Leave empty and save to clear the override. The box's placeholder shows the config currently on disk.</p>
				</form>
			</section>
			<section>
				<h2 class="text-sm font-semibold uppercase tracking-wide text-rw-faint mb-1">Custom dynamic entries</h2>
				<p class="text-xs text-rw-faint mb-3">
					Named YAML files written into the dynamic dir (<span class="font-mono">custom-&lt;name&gt;.yml</span>): global middlewares like <span class="font-mono">authelia@file</span>, LAN routes to machines that aren't tiles, TCP passthroughs. Traefik's file provider picks changes up live. Generated <span class="font-mono">app-*.yml</span> files stay stackr-owned.
				</p>
				if len(names) > 0 {
					<ul class="space-y-2 mb-4">
						for _, n := range names {
							<li class="panel px-4 py-2.5">
								<details>
									<summary class="flex items-center gap-3 text-sm cursor-pointer list-none">
										<span class="font-mono text-rw-text">custom-{ n }.yml</span>
										<form hx-post="/admin/proxy/entry/delete" hx-confirm={ "Remove custom-" + n + ".yml? Anything routed through it breaks." } class="ml-auto">
											@form.CSRFField(c)
											<input type="hidden" name="name" value={ n }/>
											<button type="submit" class="btn btn-ghost btn-sm">Remove</button>
										</form>
									</summary>
									<pre class="mt-2 text-xs font-mono text-rw-muted whitespace-pre-wrap">{ entries[n] }</pre>
								</details>
							</li>
						}
					</ul>
				}
				<form hx-post="/admin/proxy/entry" class="space-y-2">
					@form.CSRFField(c)
					<input type="text" name="name" placeholder="entry name, e.g. authelia" required class="input w-64"/>
					<textarea name="yaml" rows="8" data-code="yaml" required placeholder="http:
  middlewares:
    authelia:
      forwardAuth:
        address: http://authelia:9091/api/verify?rd=https://auth.example.com" class="input font-mono text-xs w-full"></textarea>
					<button type="submit" class="btn btn-primary btn-sm">Save entry</button>
					<p class="text-xs text-rw-faint">Saving an existing name replaces that entry.</p>
				</form>
			</section>
		</div>
	}
}
