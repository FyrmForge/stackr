package settings

import (
	"github.com/labstack/echo/v4"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components/form"
)

type upgradeView struct {
	Version    string
	Upgradable bool
	Latest     string
	Available  bool
	CheckErr   string
	Archive    string
}

templ upgradePage(c echo.Context, v upgradeView) {
	@page(c, "update", "Everything scoped to this installation.") {
		@form.Section("Update", form.ScopeInstance, "Backs up the panel, then restarts it on the new release.") {
			<div id="upgrade" class="space-y-3 text-sm">
				<p class="text-rw-text">Running <span class="font-mono">{ v.Version }</span></p>
				if !v.Upgradable {
					<p class="text-rw-muted">Dev build, no upgrades.</p>
				} else {
					<div hx-get="/admin/update/check" hx-trigger="load" hx-swap="outerHTML">
						<p class="text-rw-muted">Checking for updates.</p>
					</div>
				}
			</div>
		}
		if v.Archive != "" {
			@form.Section("Going back", form.ScopeInstance, "Puts back the data and the build from before the upgrade. The panel cannot restore itself. Run this on the manager.") {
				<pre class="text-xs font-mono text-rw-muted whitespace-pre-wrap">scripts/restore.sh { v.Archive }</pre>
			}
		}
	}
}

// upgradeStatus is the release check's answer, swapped into the page on load.
templ upgradeStatus(c echo.Context, v upgradeView) {
	if v.Available {
		<form hx-post="/admin/update" hx-target="#upgrade" hx-swap="innerHTML" hx-disabled-elt="find button" hx-confirm={ "Upgrade to " + v.Latest + "? The panel restarts." }>
			@form.CSRFField(c)
			<input type="hidden" name="version" value={ v.Latest }/>
			<button type="submit" class="btn btn-primary btn-sm">Upgrade to { v.Latest }</button>
		</form>
	} else if v.Latest != "" {
		<p class="text-rw-muted">Up to date.</p>
	}
	if v.CheckErr != "" {
		<p class="text-rw-danger">{ v.CheckErr }</p>
	}
}

// upgradeWait replaces the button once swarm has the new image. main.js polls
// /api/health and reloads when the build answering is tag.
templ upgradeWait(tag, from string) {
	<div data-upgrade-wait={ tag } class="space-y-2">
		<p class="text-rw-text">Restarting on { tag }. This page reloads when it is back.</p>
		<p data-upgrade-late hidden class="text-rw-muted">Still not back. A version that fails to start rolls back to { from } on its own.</p>
	</div>
}

templ upgradeBadge(tag string) {
	if tag != "" {
		<a href="/admin/update" title={ "Update to " + tag } class="relative flex h-9 w-9 items-center justify-center rounded-lg text-rw-muted hover:text-rw-text hover:bg-rw-raised transition-colors">
			<svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
				<path d="M12 19V5M5 12l7-7 7 7"></path>
			</svg>
			<span class="absolute top-1.5 right-1.5 h-2 w-2 rounded-full bg-rw-accent"></span>
		</a>
	}
}
