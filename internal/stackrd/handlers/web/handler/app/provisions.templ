package app

import (
	"strings"

	"github.com/labstack/echo/v4"

	"github.com/FyrmForge/stackr/internal/stackrd/infra/managedtiles"
	"github.com/FyrmForge/stackr/internal/stackrd/store/repo"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components/form"
)

// provisionRow pairs a provision with its instance tile's display name.
type provisionRow struct {
	P            repo.Provision
	InstanceName string
	Ref          string // the reference expression a consumer copies
}

// instanceScope labels a shared instance's reach for the picker.
func instanceScope(i repo.Tile) string {
	return i.Engine + " · " + managedtiles.ScopeLabel(i.ScopeKind)
}

// provisionsFrag is the lazy-loaded "Shared databases" section on a service's
// settings tab: existing provisions + a form to provision from a shared
// postgres instance in the environment.
templ provisionsFrag(c echo.Context, a *repo.Tile, rows []provisionRow, instances []repo.Tile, attachable []managedtiles.SharedDB) {
	<div id="provisions-frag">
		if len(rows) == 0 {
			<p class="text-rw-muted text-sm">No provisioned databases.</p>
		} else {
			<ul class="space-y-2">
				for _, r := range rows {
					<li class="panel px-4 py-3 flex items-center justify-between gap-3">
						<span class="text-sm text-rw-text min-w-0">
							{ r.InstanceName }
							<span class="text-rw-faint font-mono text-xs ml-1">{ r.P.DBName }</span>
						</span>
						<span class="flex items-center gap-2 shrink-0">
							<span class="font-mono text-xs text-rw-muted">{ r.Ref }</span>
							<button type="button" data-copy={ r.Ref } class="btn btn-ghost btn-sm">Copy</button>
							<form
								hx-post={ "/apps/" + a.ID + "/provisions/" + r.P.ID + "/detach" }
								hx-target="#provisions-frag"
								hx-swap="outerHTML"
								hx-confirm="Detach this database? Data is kept (drop it from the instance's panel)."
							>
								@form.CSRFField(c)
								<button type="submit" class="btn btn-danger btn-sm">Detach</button>
							</form>
						</span>
					</li>
				}
			</ul>
		}
		if len(instances) == 0 {
			<p class="text-xs text-rw-faint mt-3">Add a managed tile (a database or object storage) in this environment, or scoped to the stack/org, to provision from it.</p>
		} else {
			<form
				hx-post={ "/apps/" + a.ID + "/provision" }
				hx-target="#provisions-frag"
				hx-swap="outerHTML"
				class="flex flex-wrap gap-2 mt-3 items-end"
			>
				@form.CSRFField(c)
				<label class="block">
					<span class="label">Instance</span>
					<select name="instance_id" class="input w-auto">
						for _, i := range instances {
							<option value={ i.ID }>{ i.Name } · { instanceScope(i) }</option>
						}
					</select>
				</label>
				<label class="block">
					<span class="label">Env var</span>
					<input type="text" name="env_var" value="DATABASE_URL" placeholder="blank = don't set" class="input w-44 font-mono"/>
				</label>
				<button type="submit" class="btn btn-primary btn-sm">Provision database</button>
			</form>
			<p class="text-xs text-rw-faint mt-2">Creates a logical database inside the managed tile. If an env var is named it's set to the connection url and the service redeploys; otherwise reference the secret value yourself and redeploy.</p>
		}
		if len(attachable) > 0 {
			<div class="mt-4 pt-4 border-t border-rw-border">
				<div class="label mb-1">Attach to an existing database</div>
				<form
					hx-post={ "/apps/" + a.ID + "/provisions/attach" }
					hx-target="#provisions-frag"
					hx-swap="outerHTML"
					class="flex flex-wrap gap-2 items-end"
				>
					@form.CSRFField(c)
					<label class="block">
						<span class="label">Database</span>
						<select name="provision_id" class="input w-auto">
							for _, sd := range attachable {
								<option value={ sd.Provision.ID }>{ sd.Instance.Name } / { sd.Provision.DBName } ({ attachUsers(sd) })</option>
							}
						</select>
					</label>
					<label class="block">
						<span class="label">Env var</span>
						<input type="text" name="env_var" value="DATABASE_URL" placeholder="blank = don't set" class="input w-44 font-mono"/>
					</label>
					<button type="submit" class="btn btn-ghost btn-sm">Attach</button>
				</form>
				<p class="text-xs text-rw-faint mt-2">Shares the same database and credentials as another tile in this environment. For cron jobs or workers that operate on the same data.</p>
			</div>
		}
	</div>
}

// attachUsers labels who already shares a database.
func attachUsers(sd managedtiles.SharedDB) string {
	if len(sd.Consumers) == 0 {
		return "unused"
	}
	return "used by " + strings.Join(sd.Consumers, ", ")
}
