package app

import (
	"strconv"
	"strings"
	"time"

	"github.com/labstack/echo/v4"
	"github.com/FyrmForge/stackr/internal/stackrd/infra/githubapp"
	"github.com/FyrmForge/stackr/internal/stackrd/infra/proxy"
	"github.com/FyrmForge/stackr/internal/stackrd/store/repo"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components/form"
)

// metricsFrag delegates to the shared charts fragment with this app's URLs.
templ metricsFrag(a *repo.Tile, rangeKey string, cpu, mem, rx, tx []components.TimePoint) {
	@components.MetricsFrag("/apps/"+a.ID+"/metrics", rangeKey, cpu, mem, rx, tx)
}

// breadcrumb is the clickable trail above the full-page panel.
type breadcrumb struct {
	StackName string
	StackHref string
	EnvName   string // "" hides the env segment
	EnvHref   string
}

// appPage is the full-page view: the exact same tabbed panel the canvas
// drawer shows, wrapped in the shell, one settings screen, two frames.
templ appPage(c echo.Context, a *repo.Tile, tab string, crumb breadcrumb, openRun *repo.CronRun, deployments []repo.Deployment, domains []repo.Domain, cpu, mem, rx, tx []components.TimePoint, runs []repo.CronRun, vol volumeView, httpLog []proxy.AccessEntry, configMode string, node placementView) {
	@components.Shell(c, a.Name) {
		<nav class="mb-4 flex items-center gap-1.5 text-sm text-rw-muted">
			<a href={ templ.SafeURL(crumb.StackHref) } class="hover:text-rw-text transition-colors">{ crumb.StackName }</a>
			if crumb.EnvName != "" {
				<span class="text-rw-faint">/</span>
				<a href={ templ.SafeURL(crumb.EnvHref) } class="hover:text-rw-text transition-colors">{ crumb.EnvName }</a>
			}
			<span class="text-rw-faint">/</span>
			<span class="text-rw-text">{ a.Name }</span>
		</nav>
		<div class="panel !p-0 overflow-hidden" data-ws-room={ "project:" + a.StackID }>
			@appPanel(c, a, tab, openRun, deployments, domains, cpu, mem, rx, tx, runs, vol, httpLog, configMode, node, false)
		</div>
	}
}

templ domainsSection(c echo.Context, a *repo.Tile, domains []repo.Domain) {
	<details class="mb-4">
		<summary class="btn btn-ghost btn-sm cursor-pointer inline-flex items-center gap-1.5 select-none">
			<span class="text-rw-accentHi">+</span> Add domain
		</summary>
		<form hx-post={ "/apps/" + a.ID + "/domains" } hx-target="#panel-content" hx-swap="innerHTML" class="flex flex-wrap gap-2 mt-3 items-center">
			@form.CSRFField(c)
			<input type="text" name="host" placeholder="app.example.com or *.example.com" required class={ inputCls + " !w-56" }/>
			// The handler has always read a path; without an input every route was
			// forced to "/", so path-based routing was unreachable from the UI.
			<input type="text" name="path" placeholder="/ (path prefix)" title="Route only requests under this path prefix to this service" class={ inputCls + " !w-32" }/>
			<input type="number" name="container_port" placeholder="port" min="1" max="65535" class={ inputCls + " !w-24" }/>
			<input type="text" name="redirect_to" placeholder="redirect to (optional)" title="Requests to this host 301 to the given host instead of being served" class={ inputCls + " !w-48" }/>
			<input type="text" name="rule" placeholder="traefik rule (optional)" title="Replaces the host and path match. The host still picks the certificate." class={ inputCls + " !w-56" }/>
			<input type="number" name="priority" placeholder="priority" title="Higher wins when routes overlap" class={ inputCls + " !w-24" }/>
			<input type="text" name="middlewares" placeholder="middlewares, comma separated" title="A stack middleware name, or stack/name from another stack" class={ inputCls + " !w-56" }/>
			<label class="text-sm text-rw-muted flex items-center gap-1.5">
				<input type="checkbox" name="https" value="1" checked/> HTTPS
			</label>
			<button type="submit" class="btn btn-primary">Add</button>
		</form>
		<form hx-post={ "/apps/" + a.ID + "/domains/auto" } hx-target="#panel-content" hx-swap="innerHTML" class="mt-2">
			@form.CSRFField(c)
			<button type="submit" class="btn btn-ghost btn-sm" title="Generate a hostname under the nearest domain resource (stack, organization, or server)">Add auto domain</button>
		</form>
	</details>
	if len(domains) == 0 {
		<p class="text-rw-muted text-sm">No domains yet.</p>
	} else {
		<ul class="space-y-2">
			for _, d := range domains {
				<li class="panel px-4 py-3">
					<div class="flex flex-wrap items-center justify-between gap-2">
						<span class="text-sm text-rw-text min-w-0">
							if d.HTTPS {
								<a href={ templ.SafeURL("https://" + d.Host) } target="_blank" rel="noopener" class="hover:underline hover:text-rw-accentHi transition-colors">{ "https://" + d.Host }</a>
							} else {
								<a href={ templ.SafeURL("http://" + d.Host) } target="_blank" rel="noopener" class="hover:underline hover:text-rw-accentHi transition-colors">{ "http://" + d.Host }</a>
							}
							if d.Path != "" && d.Path != "/" {
								<span class="font-mono text-rw-faint">{ d.Path }</span>
							}
							if d.Rule != "" {
								<span class="font-mono text-xs text-rw-faint">{ d.Rule }</span>
							}
							if d.Priority != 0 {
								<span class="text-xs text-rw-faint">priority { strconv.Itoa(d.Priority) }</span>
							}
							if d.Middlewares != "" {
								<span class="text-xs text-rw-faint">via { strings.Join(d.MiddlewareList(), ", ") }</span>
							}
							if d.RedirectTo != "" {
								<span class="text-rw-faint">301 → { d.RedirectTo }</span>
							} else {
								<span class="text-rw-faint">→ :{ strconv.Itoa(d.ContainerPort) }</span>
							}
							if d.CertPEM != "" {
								<span class="text-xs text-rw-warn ml-1" title="Serving an uploaded certificate instead of Let's Encrypt">custom cert</span>
							}
						</span>
						<span class="flex items-center gap-2 shrink-0 ml-auto">
							<form hx-post={ "/apps/" + a.ID + "/domains/" + d.ID + "/https" } hx-target="#panel-content" hx-swap="innerHTML">
								@form.CSRFField(c)
								if d.HTTPS {
									<button type="submit" class="btn btn-ghost btn-sm" title="Serve over plain HTTP instead">Disable HTTPS</button>
								} else {
									<button type="submit" class="btn btn-ghost btn-sm" title="Serve over HTTPS (Let's Encrypt)">Enable HTTPS</button>
								}
							</form>
							<form hx-post={ "/apps/" + a.ID + "/domains/" + d.ID + "/delete" } hx-target="#panel-content" hx-swap="innerHTML" hx-confirm="Remove this domain?">
								@form.CSRFField(c)
								<button type="submit" class="btn btn-danger btn-sm">Remove</button>
							</form>
						</span>
					</div>
					if d.HTTPS && d.RedirectTo == "" {
						<details class="mt-1">
							<summary class="text-xs text-rw-faint hover:text-rw-text cursor-pointer select-none">Custom certificate</summary>
							<form hx-post={ "/apps/" + a.ID + "/domains/" + d.ID + "/cert" } hx-target="#panel-content" hx-swap="innerHTML" class="space-y-2 mt-2">
								@form.CSRFField(c)
								<textarea name="cert_pem" rows="3" placeholder="-----BEGIN CERTIFICATE----- (full chain)" class={ inputCls + " font-mono text-xs" }>{ d.CertPEM }</textarea>
								<textarea name="key_pem" rows="3" placeholder="-----BEGIN PRIVATE KEY-----" class={ inputCls + " font-mono text-xs" }></textarea>
								<button type="submit" class="btn btn-primary btn-sm">Save</button>
							</form>
							if d.CertPEM != "" {
								<form hx-post={ "/apps/" + a.ID + "/domains/" + d.ID + "/cert" } hx-target="#panel-content" hx-swap="innerHTML" class="mt-2">
									@form.CSRFField(c)
									<button type="submit" class="btn btn-ghost btn-sm" title="Back to Let's Encrypt">Remove (use Let's Encrypt)</button>
								</form>
							}
						</details>
					}
				</li>
			}
		</ul>
	}
}

// cronActions replaces Deploy for cron-kind apps: run immediately or
// pause/resume the schedule.
templ cronActions(c echo.Context, a *repo.Tile, openRun *repo.CronRun) {
	@runAction(c, a, openRun)
	<form hx-post={ "/apps/" + a.ID + "/cron/toggle" } hx-swap="none">
		@form.CSRFField(c)
		if a.Status == "paused" {
			<button type="submit" class="btn btn-ghost btn-sm">Resume</button>
		} else {
			<button type="submit" class="btn btn-ghost btn-sm">Pause</button>
		}
	</form>
}

// functionActions: Run now is the primary act; no schedule, so no pause.
templ functionActions(c echo.Context, a *repo.Tile, openRun *repo.CronRun) {
	@runAction(c, a, openRun)
	if !components.UpperEnv(c) {
		<form hx-post={ "/apps/" + a.ID + "/deploy" }>
			@form.CSRFField(c)
			<button type="submit" class="btn btn-ghost btn-sm">Deploy</button>
		</form>
	}
}

// runAction is the primary header button of a cron or function tile: Run now,
// or (while a run is in flight) a busy button and the Stop that ends it.
// Stop cancels the run's context; the one-shot container goes with it and the
// row closes as "stopped", not failed.
templ runAction(c echo.Context, a *repo.Tile, openRun *repo.CronRun) {
	if openRun != nil {
		<button type="button" class="btn btn-primary btn-sm btn-busy" disabled aria-live="polite"><span>Running</span></button>
		<form hx-post={ "/apps/" + a.ID + "/runs/" + openRun.ID + "/stop" } hx-swap="none">
			@form.CSRFField(c)
			<button type="submit" class="btn btn-ghost btn-sm">Stop</button>
		</form>
	} else {
		<form hx-post={ "/apps/" + a.ID + "/run" } hx-swap="none">
			@form.CSRFField(c)
			<button type="submit" class="btn btn-primary btn-sm">Run now</button>
		</form>
	}
}

// runLogs is the Logs tab of a cron or function tile: every recent run in one
// stream, oldest first, each line tagged with the run's short id. A picker per
// run read like a file browser, not a log, the run id is what tells runs
// apart, and typing it in the search box narrows the view to that run.
templ runLogs(a *repo.Tile, runs []repo.CronRun) {
	if len(runs) == 0 {
		<p class="text-rw-muted text-sm">No runs yet. Hit Run now to make one.</p>
	} else {
		@components.LogView("/apps/"+a.ID+"/runs/logs/stream", true)
	}
}

// runsList renders cron run history: outcome, id, start time, duration, what
// triggered it, and the output behind an expandable row. A run with no
// finished_at is still going, the row says so and the panel's websocket
// refresh fills it in when it lands.
//
// The <details> carry a stable id and data-keep-open so a row left open
// survives that refresh; without it the swap collapsed whatever the operator
// was reading. Not hx-preserve: that keeps the whole old node, so a row that
// finished while open would be restored to its "running" copy and never
// update. main.js carries the open state across and nothing else.
templ runsList(runs []repo.CronRun) {
	if len(runs) == 0 {
		<p class="text-rw-muted text-sm">No runs yet.</p>
	} else {
		<ul class="space-y-1.5">
			for _, r := range runs {
				<li class="panel px-4 py-2.5">
					<details id={ "run-" + r.ID } data-keep-open>
						<summary class="flex items-center gap-3 text-sm cursor-pointer list-none">
							if r.Running() {
								<span class="text-rw-warn shrink-0">running</span>
							} else {
								switch r.Status {
									case "ok":
										<span class="text-rw-success shrink-0">ok</span>
									case "skipped":
										<span class="text-rw-warn shrink-0">skipped</span>
									case "stopped":
										<!-- someone hit Stop: over, but not a failure -->
										<span class="text-rw-faint shrink-0">stopped</span>
									default:
										<span class="text-rw-danger shrink-0">failed</span>
								}
							}
							<span class="text-rw-faint text-xs font-mono">{ r.ID[:8] }</span>
							<span class="text-rw-faint text-xs">{ r.StartedAt.Local().Format("Jan 2 15:04:05") }</span>
							<span class="text-rw-muted text-xs">{ runTrigger(r) }</span>
							<span class="text-rw-faint text-xs ml-auto">{ runDuration(r) }</span>
						</summary>
						if r.Output != "" {
							<div class="mt-2">
								@components.LogText(r.Output)
							</div>
						} else if r.Running() {
							<p class="mt-2 text-xs text-rw-faint">Still running.</p>
						} else {
							<p class="mt-2 text-xs text-rw-faint">No output.</p>
						}
					</details>
				</li>
			}
		</ul>
	}
}

// runTrigger names what started a run, with who asked for it when a person
// did ("manual web · admin@example.com").
func runTrigger(r repo.CronRun) string {
	t := r.Trigger
	if t == "" {
		return ""
	}
	if r.Actor != "" {
		t += " · " + r.Actor
	}
	return t
}

// passPlaceholder hints whether a basic-auth password is already set (the
// hash is never echoed back; blank keeps it).
func passPlaceholder(a *repo.Tile) string {
	if a.BasicAuthHash != "" {
		return "unchanged"
	}
	return ""
}

// fmtLimit renders a cores value without trailing zeros ("0.5", "2").
func fmtLimit(v float64) string {
	return strconv.FormatFloat(v, 'f', -1, 64)
}

// runDuration formats how long a run took, e.g. "4s" or "2m10s".
func runDuration(r repo.CronRun) string {
	if r.Running() {
		return ""
	}
	d := r.FinishedAt.Time.Sub(r.StartedAt).Round(time.Second)
	if d < 0 {
		return ""
	}
	return d.String()
}

templ cronSettingsForm(c echo.Context, a *repo.Tile, managed bool) {
	<form hx-post={ "/apps/" + a.ID + "/settings" } hx-target="#panel-content" hx-swap="innerHTML" class="space-y-4">
		@form.CSRFField(c)
		@field("Image") {
			<input type="text" name="image_ref" value={ a.ImageRef } placeholder="alpine:3" required disabled?={ managed } class={ inputCls + " font-mono" }/>
		}
		@updatePolicyField(a.UpdatePolicy, managed)
		@field("Schedule (cron, CRON_TZ= prefix for timezones)") {
			<input type="text" name="cron" value={ a.Cron } placeholder="0 3 * * *" required disabled?={ managed } class={ inputCls + " font-mono" }/>
		}
		@field("Command (empty = image CMD)") {
			<input type="text" name="command" value={ a.Command } placeholder="sh /scripts/cleanup.sh" disabled?={ managed } class={ inputCls + " font-mono" }/>
		}
		@field("Max runtime (minutes)") {
			<input type="number" name="timeout_minutes" value={ strconv.Itoa(a.TimeoutMinutes) } min="1" max="1440" disabled?={ managed } class={ inputCls + " !w-28" }/>
		}
		<div class="grid grid-cols-2 gap-2">
			@field("CPU limit (cores, 0 = unlimited)") {
				<input type="number" name="cpu_limit" value={ fmtLimit(a.CPULimit) } step="0.1" min="0" disabled?={ managed } class={ inputCls }/>
			}
			@field("Memory limit (MB, 0 = unlimited)") {
				<input type="number" name="mem_limit_mb" value={ strconv.Itoa(a.MemLimitMB) } min="0" disabled?={ managed } class={ inputCls }/>
			}
		</div>
		<label class="text-sm text-rw-muted flex items-center gap-2">
			<input type="checkbox" name="allow_overlap" value="1" checked?={ a.AllowOverlap } disabled?={ managed }/>
			Allow overlapping runs (next tick starts even if the previous run is still going)
		</label>
		@envInVariablesNote()
		if managed {
		<p class="text-xs text-rw-faint">The config file owns every field here. Change them in the repo.</p>
		} else {
		<button type="submit" class="btn btn-primary">Save</button>
		}
	</form>
}

// functionSettingsForm is the cron form minus the schedule: a function's
// trigger is manual (Run now) and optionally its own deploy finishing.
// image source only, like crons, git-built functions work through
// config-as-code; add the source picker here when someone needs it in the UI.
templ functionSettingsForm(c echo.Context, a *repo.Tile, managed bool) {
	<form hx-post={ "/apps/" + a.ID + "/settings" } hx-target="#panel-content" hx-swap="innerHTML" class="space-y-4">
		@form.CSRFField(c)
		@field("Image") {
			<input type="text" name="image_ref" value={ a.ImageRef } placeholder="alpine:3" required disabled?={ managed } class={ inputCls + " font-mono" }/>
		}
		@updatePolicyField(a.UpdatePolicy, managed)
		@field("Command (empty = image CMD)") {
			<input type="text" name="command" value={ a.Command } placeholder="sh /scripts/bootstrap.sh" disabled?={ managed } class={ inputCls + " font-mono" }/>
		}
		@field("Trigger") {
			<select name="run_on_deploy" disabled?={ managed } class={ inputCls }>
				<option value="" selected?={ !a.RunOnDeploy }>Manual only</option>
				<option value="1" selected?={ a.RunOnDeploy }>Manual + after each deploy</option>
			</select>
		}
		@field("Depends on (tile[:started|healthy|completed] per line; bulk starts only)") {
			<textarea name="depends_on" rows="2" placeholder="sonarr&#10;init:completed" disabled?={ managed } class={ inputCls + " font-mono text-sm" }>{ a.DependsOn }</textarea>
		}
		@field("Max runtime (minutes)") {
			<input type="number" name="timeout_minutes" value={ strconv.Itoa(a.TimeoutMinutes) } min="1" max="1440" disabled?={ managed } class={ inputCls + " !w-28" }/>
		}
		<div class="grid grid-cols-2 gap-2">
			@field("CPU limit (cores, 0 = unlimited)") {
				<input type="number" name="cpu_limit" value={ fmtLimit(a.CPULimit) } step="0.1" min="0" disabled?={ managed } class={ inputCls }/>
			}
			@field("Memory limit (MB, 0 = unlimited)") {
				<input type="number" name="mem_limit_mb" value={ strconv.Itoa(a.MemLimitMB) } min="0" disabled?={ managed } class={ inputCls }/>
			}
		</div>
		<label class="text-sm text-rw-muted flex items-center gap-2">
			<input type="checkbox" name="allow_overlap" value="1" checked?={ a.AllowOverlap } disabled?={ managed }/>
			Allow overlapping runs (a new trigger starts even if the previous run is still going)
		</label>
		@envInVariablesNote()
		if managed {
		<p class="text-xs text-rw-faint">The config file owns every field here. Change them in the repo.</p>
		} else {
		<button type="submit" class="btn btn-primary">Save</button>
		}
	</form>
}

// updatePolicyField is the registry-watcher policy select, shared by every
// image-source settings form.
templ updatePolicyField(policy string, managed bool) {
	@field("Update policy (registry watcher)") {
		<select name="update_policy" disabled?={ managed } class={ inputCls }>
			<option value="off" selected?={ policy != "notify" && policy != "auto" }>Off</option>
			<option value="notify" selected?={ policy == "notify" }>Notify on new version</option>
			<option value="auto" selected?={ policy == "auto" }>Auto-deploy new versions</option>
		</select>
	}
}

templ settingsForm(c echo.Context, a *repo.Tile, managed bool, node placementView) {
	if a.Kind == "cron" {
		@cronSettingsForm(c, a, managed)
	} else if a.Kind == "function" {
		@functionSettingsForm(c, a, managed)
	} else {
		@serviceSettingsForm(c, a, managed, node)
	}
}

// panelSection is a titled block inside the settings tab. The tab used to be
// one undifferentiated scroll of thirteen controls; the headings (and the
// jump-links above them) are what make it navigable.
templ panelSection(id, title, help string) {
	<section id={ id } class="pt-6 mt-6 border-t border-rw-border first:pt-0 first:mt-0 first:border-0">
		<h4 class="text-xs font-semibold uppercase tracking-wide text-rw-faint mb-1">{ title }</h4>
		if help != "" {
			<p class="text-xs text-rw-faint mb-3">{ help }</p>
		} else {
			<div class="mb-3"></div>
		}
		{ children... }
	</section>
}

// sectionJump renders the settings tab's in-panel navigation.
templ sectionJump(items []sectionLink) {
	<nav class="flex flex-wrap gap-1.5 mb-2" aria-label="Settings sections">
		for _, it := range items {
			<a href={ templ.SafeURL("#" + it.ID) } class="text-xs px-2 py-1 rounded-md bg-rw-inset text-rw-muted hover:text-rw-text transition-colors">{ it.Label }</a>
		}
	</nav>
}

type sectionLink struct {
	ID    string
	Label string
}

func serviceSections(a *repo.Tile) []sectionLink {
	out := []sectionLink{{"sec-source", "Source"}}
	if a.SourceType == "git" {
		out = append(out, sectionLink{"sec-build", "Build"})
	}
	out = append(out,
		sectionLink{"sec-runtime", "Runtime"},
		sectionLink{"sec-placement", "Placement"},
		sectionLink{"sec-network", "Networking"},
		sectionLink{"sec-resources", "Resources"},
		sectionLink{"sec-health", "Health"},
		sectionLink{"sec-startup", "Startup"},
	)
	return out
}

templ serviceSettingsForm(c echo.Context, a *repo.Tile, managed bool, node placementView) {
	@sectionJump(serviceSections(a))
	<form hx-post={ "/apps/" + a.ID + "/settings" } hx-target="#panel-content" hx-swap="innerHTML" class="space-y-4">
		@form.CSRFField(c)
		@panelSection("sec-source", "Source", "Where this service's image comes from.") {
		@field("Source type") {
			<select name="source_type" disabled?={ managed } class={ inputCls }>
				<option value="git" selected?={ a.SourceType == "git" }>Git repository</option>
				<option value="image" selected?={ a.SourceType == "image" }>Docker image</option>
			</select>
		}
		<div data-source-show="git">
		@field("Git connector (for private repos, PR envs and the repo list)") {
			<select name="connector_id" disabled?={ managed } class={ inputCls } hx-get={ "/apps/" + a.ID + "/connectors" } hx-trigger="load" hx-target="this" hx-swap="innerHTML">
				<option value="">None (public repo / manual URL)</option>
			</select>
		}
		</div>
		<div data-source-show="git">
			@field("Git URL") {
				<input type="text" name="git_url" value={ a.GitURL } list="repo-options" placeholder="https://github.com/user/repo.git or git@..." disabled?={ managed } class={ inputCls }/>
				<datalist id="repo-options" hx-get={ "/apps/" + a.ID + "/repos" } hx-trigger="load" hx-target="this" hx-swap="innerHTML"></datalist>
			}
		</div>
		<div data-source-show="git">
			@field("Branch") {
				<input type="text" name="git_branch" value={ a.GitBranch } list="branch-options" disabled?={ managed } class={ inputCls } placeholder="main"/>
				<datalist id="branch-options" hx-get={ "/apps/" + a.ID + "/branches" } hx-trigger="load" hx-target="this" hx-swap="innerHTML">
					@branchOptions(nil)
				</datalist>
			}
		</div>
		<div data-source-show="image">
			@field("Image") {
				<input type="text" name="image_ref" value={ a.ImageRef } placeholder="nginx:latest" disabled?={ managed } class={ inputCls }/>
			}
		</div>
		<div data-source-show="image">
			@updatePolicyField(a.UpdatePolicy, managed)
		</div>
		}
		@panelSection("sec-build", "Build", "How the image is built and when a push triggers a deploy.") {
			<div data-source-show="git">
				@field("Dockerfile path") {
					<input type="text" name="dockerfile_path" value={ a.DockerfilePath } disabled?={ managed } class={ inputCls }/>
				}
			</div>
			<div data-source-show="git">
				@field("Build context") {
					<input type="text" name="build_context" value={ a.BuildContext } disabled?={ managed } class={ inputCls }/>
				}
			</div>
			<div data-source-show="git">
				@field("Watch paths (regex per line, ! prefix ignores; empty = deploy on any push)") {
					<textarea name="watch_paths" rows="2" placeholder="^apps/web/&#10;!\.md$" disabled?={ managed } class={ inputCls + " font-mono text-sm" }>{ a.WatchPaths }</textarea>
				}
			</div>
			<div data-source-show="git">
				@field("Build args (KEY=VALUE per line)") {
					<textarea name="build_args" rows="2" data-code="env" placeholder="ARG=value" disabled?={ managed } class={ inputCls + " font-mono text-sm" }>{ a.BuildArgs }</textarea>
				}
			</div>
			<label class="text-sm text-rw-muted flex items-center gap-2" data-source-show="git">
				<input type="checkbox" name="wait_for_ci" value="1" checked?={ a.WaitForCI } disabled?={ managed }/>
				Wait for CI before push deploys (the commit's checks must pass first)
			</label>
			@field("Volumes (name-or-path:/container/path per line)") {
				<textarea name="volumes" rows="2" placeholder="pgdata:/var/lib/postgresql/data" disabled?={ managed } class={ inputCls + " font-mono text-sm" }>{ a.Volumes }</textarea>
			}
			@field("Files (repo/path:/container/path[:template] per line, shipped from the git repo at deploy, read-only; :template resolves ${{ }} in the file)") {
				<textarea name="files" rows="2" placeholder="config/loki.yml:/etc/loki/config.yml&#10;conf.yml:/app/user-data/conf.yml:template" disabled?={ managed } class={ inputCls + " font-mono text-sm" }>{ a.Files }</textarea>
			}
		}
		@panelSection("sec-runtime", "Runtime", "How the container itself runs. Changes apply on the next deploy.") {
			@field("Command (overrides the image CMD; quoted words group, no shell)") {
				<input type="text" name="command" value={ a.Command } placeholder="-config.file=/etc/loki/config.yml" disabled?={ managed } class={ inputCls + " font-mono text-sm" }/>
			}
			<div class="grid grid-cols-3 gap-2">
				@field("User (uid[:gid], empty = image default)") {
					<input type="text" name="user" value={ a.User } placeholder="1000:1000" disabled?={ managed } class={ inputCls + " font-mono" }/>
				}
				@field("Shm size (MB, 0 = default)") {
					<input type="number" name="shm_size_mb" value={ strconv.Itoa(a.ShmSizeMB) } min="0" disabled?={ managed } class={ inputCls }/>
				}
				@field("Restart policy") {
					<select name="restart_policy" disabled?={ managed } class={ inputCls }>
						<option value="" selected?={ a.RestartPolicy != "on-failure" && a.RestartPolicy != "no" }>Always</option>
						<option value="on-failure" selected?={ a.RestartPolicy == "on-failure" }>On failure</option>
						<option value="no" selected?={ a.RestartPolicy == "no" }>Never</option>
					</select>
				}
			</div>
			<details open?={ a.Privileged || a.Devices != "" }>
				<summary class="text-sm text-rw-muted cursor-pointer select-none">Host access</summary>
				<div class="mt-2 space-y-3">
					<label class="text-sm flex items-center gap-2">
						<input type="checkbox" name="privileged" value="1" checked?={ a.Privileged } disabled?={ managed }/>
						<span>Privileged</span>
						<span class="text-xs text-rw-danger">full host access: the container can do anything root on the host can</span>
					</label>
					@field("Devices (host[:container[:perms]] per line)") {
						<textarea name="devices" rows="2" placeholder="/dev/kmsg" disabled?={ managed } class={ inputCls + " font-mono text-sm" }>{ a.Devices }</textarea>
					}
				</div>
			</details>
		}
		@placementSection(c, a, managed, node)
		@panelSection("sec-network", "Networking", "How traffic reaches this service. Domains are managed below, outside this form.") {
			@field("Container port") {
				<input type="number" name="container_port" value={ strconv.Itoa(a.ContainerPort) } min="0" max="65535" disabled?={ managed } class={ inputCls }/>
			}
			<div class="grid grid-cols-2 gap-2">
				@field("Basic auth user (empty = no auth)") {
					<input type="text" name="basic_auth_user" value={ a.BasicAuthUser } autocomplete="off" disabled?={ managed } class={ inputCls }/>
				}
				@field("Basic auth password") {
					<input type="password" name="basic_auth_pass" placeholder={ passPlaceholder(a) } autocomplete="new-password" disabled?={ managed } class={ inputCls }/>
				}
			</div>
			<label class="text-sm text-rw-muted flex items-center gap-2">
				<input type="checkbox" name="sec_headers" value="1" checked?={ a.SecHeaders } disabled?={ managed }/>
				Security headers (HSTS, nosniff, deny framing)
			</label>
			@field("Published ports (host:container[/udp] per line, bypasses the proxy, applies on next deploy)") {
				<textarea name="published_ports" rows="2" placeholder="8443:8443&#10;9000:9000/udp" disabled?={ managed } class={ inputCls + " font-mono text-sm" }>{ a.PublishedPorts }</textarea>
			}
			<details open?={ a.TraefikOverride != "" }>
				<summary class="text-sm text-rw-muted cursor-pointer select-none">Raw Traefik config override</summary>
				<div class="mt-2">
					@field("Replaces the generated dynamic config for this app verbatim (empty = generated)") {
						<textarea name="traefik_override" rows="6" data-code="yaml" placeholder={ "http:\n  routers:\n    " + a.Slug + ": {rule: \"Host(`x`)\", entryPoints: [websecure], tls: {certResolver: le}, service: " + a.Slug + "}\n  services:\n    " + a.Slug + ": {loadBalancer: {servers: [{url: \"http://" + a.Slug + ":" + strconv.Itoa(a.ContainerPort) + "\"}]}}" } disabled?={ managed } class={ inputCls + " font-mono text-sm" }>{ a.TraefikOverride }</textarea>
					}
					<p class="text-xs text-rw-faint mt-1">Address the backend by slug (<span class="font-mono">http://{ a.Slug }:{ strconv.Itoa(a.ContainerPort) }</span>), and the container carries the slug as a network alias, so the override is authorable in git before the tile exists.</p>
				</div>
			</details>
		}
		@panelSection("sec-resources", "Resources", "Caps for this service. 0 means unlimited; empty inherits the environment's default.") {
			<div class="grid grid-cols-2 gap-2">
				@field("CPU limit (cores, 0 = unlimited)") {
					<input type="number" name="cpu_limit" value={ fmtLimit(a.CPULimit) } step="0.1" min="0" disabled?={ managed } class={ inputCls }/>
				}
				@field("Memory limit (MB, 0 = unlimited)") {
					<input type="number" name="mem_limit_mb" value={ strconv.Itoa(a.MemLimitMB) } min="0" disabled?={ managed } class={ inputCls }/>
				}
			</div>
			<p class="text-xs text-rw-faint">Limits apply on the next deploy.</p>
		}
		@panelSection("sec-health", "Health", "Runs as a docker-native HEALTHCHECK: gates deploys and keeps watching after; a failing check turns the tile amber.") {
			@field("Healthcheck command (optional)") {
				<input type="text" name="healthcheck_cmd" value={ a.HealthcheckCmd } placeholder="curl -f http://localhost:8080/health" disabled?={ managed } class={ inputCls }/>
			}
			<div class="grid grid-cols-4 gap-2">
				@field("Interval (s)") {
					<input type="number" name="healthcheck_interval_s" value={ strconv.Itoa(a.HealthcheckIntervalS) } min="0" placeholder="5" disabled?={ managed } class={ inputCls }/>
				}
				@field("Timeout (s)") {
					<input type="number" name="healthcheck_timeout_s" value={ strconv.Itoa(a.HealthcheckTimeoutS) } min="0" placeholder="30" disabled?={ managed } class={ inputCls }/>
				}
				@field("Retries") {
					<input type="number" name="healthcheck_retries" value={ strconv.Itoa(a.HealthcheckRetries) } min="0" placeholder="3" disabled?={ managed } class={ inputCls }/>
				}
				@field("Start period (s)") {
					<input type="number" name="healthcheck_start_period_s" value={ strconv.Itoa(a.HealthcheckStartPeriodS) } min="0" placeholder="0" disabled?={ managed } class={ inputCls }/>
				}
			</div>
			@envInVariablesNote()
		}
		@panelSection("sec-startup", "Startup", "Bulk starts (config apply) wait on these; a manual deploy of just this tile does not.") {
			@field("Depends on (tile[:started|healthy|completed] per line)") {
				<textarea name="depends_on" rows="2" placeholder="db:healthy&#10;migrate:completed&#10;cache" disabled?={ managed } class={ inputCls + " font-mono text-sm" }>{ a.DependsOn }</textarea>
			}
		}
		<div class="pt-4">
			if managed {
		<p class="text-xs text-rw-faint">The config file owns every field here. Change them in the repo.</p>
			} else {
			<button type="submit" class="btn btn-primary">Save settings</button>
			}
			<p class="text-xs text-rw-faint mt-2">Covers the sections above. Domains and databases below save on their own.</p>
		</div>
	</form>
}

const inputCls = "input"

// branchOptions renders datalist options; falls back to common branch names
// when the repo's branches couldn't be fetched (bad URL, auth, no git URL yet).
templ branchOptions(branches []string) {
	if len(branches) == 0 {
		<option value="main"></option>
		<option value="master"></option>
		<option value="develop"></option>
	} else {
		for _, b := range branches {
			<option value={ b }></option>
		}
	}
}

templ field(label string) {
	<div>
		<label class="label">{ label }</label>
		{ children... }
	</div>
}

// envInVariablesNote points env editing at the Variables tab, which keeps
// values hidden until revealed, the Settings form used to print secrets in
// a plain textarea.
templ envInVariablesNote() {
	<div class="panel px-4 py-2.5 text-sm text-rw-muted">
		Environment variables live in the <span class="text-rw-text font-medium">Variables</span> tab. Values stay hidden there until you reveal them.
	</div>
}

templ connectorOptions(conns []repo.Connector, selected string) {
	<option value="">None (public repo / manual URL)</option>
	for _, cn := range conns {
		<option value={ cn.ID } selected?={ cn.ID == selected }>{ cn.Name }</option>
	}
}

templ repoOptions(repos []githubapp.Repo) {
	for _, r := range repos {
		<option value={ "https://github.com/" + r.FullName } data-branch={ r.DefaultBranch }></option>
	}
}

// placementSection is where this tile is allowed to run
// (docs/plans/32-multi-node-ui.md, tile drawer).
//
// Home node is read-only and always has been: it is set on first deploy and
// changed only by a completed move, because it says which machine's disk the
// data is on. Editing it in place would point the tile at an empty volume on
// another box and swarm would report that as healthy.
templ placementSection(c echo.Context, a *repo.Tile, managed bool, node placementView) {
	@panelSection("sec-placement", "Placement", "Which node this runs on. Changes apply on the next deploy.") {
		if a.HomeNode != "" {
			<div class="rounded-lg border border-rw-border bg-rw-inset px-3 py-2.5 space-y-2">
				<div class="flex flex-wrap items-center gap-2">
					<span class="text-xs text-rw-muted">Home node</span>
					// The hostname, not the swarm node id. Every other screen
					// says worker-2.example.test; this one said
					// omocc45vg6a5a4zz6p4xo7u8d.
					<span class="text-xs font-mono text-rw-text">{ homeNodeName(a, node) }</span>
					<button
						type="button"
						class="ml-auto btn btn-ghost btn-sm"
						hx-get={ "/servers/move/" + a.ID }
						hx-target="#modal-host"
						hx-swap="innerHTML"
					>Move</button>
				</div>
				<p class="text-xs text-rw-warn">
					This tile holds a volume, and a volume is a directory on that machine's disk.
					It does not follow the tile: started on another node without moving the data
					first, it starts empty.
				</p>
			</div>
		}
		@field("Replicas (volume tiles are always one: two writers on one volume corrupt it)") {
			<input
				type="number"
				name="replicas"
				value={ strconv.Itoa(max(a.Replicas, 1)) }
				min="1"
				max="50"
				disabled?={ managed || a.HomeNode != "" }
				class={ inputCls }
			/>
		}
		@field("Node group (empty = any node)") {
			<input type="text" name="node_group" value={ a.NodeGroup } placeholder="any" disabled?={ managed } class={ inputCls + " font-mono" }/>
		}
	}
}

// homeNodeName prefers the machine's name over the swarm id it is stored as.
// Falls back to the raw id when the node has left the swarm, which is worth
// showing plainly rather than hiding behind a blank.
func homeNodeName(a *repo.Tile, node placementView) string {
	if node.Name != "" {
		return node.Name
	}
	return a.HomeNode
}
