package app

import (
	"strconv"
	"strings"

	"github.com/labstack/echo/v4"
	"github.com/FyrmForge/stackr/internal/stackrd/infra/proxy"
	"github.com/FyrmForge/stackr/internal/stackrd/store/repo"
	"github.com/FyrmForge/stackr/internal/stackrd/infra/runtime"
	"github.com/FyrmForge/stackr/internal/stackrd/config/varref"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components/form"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/filebrowse"
)

// appPanel is the full right-drawer for an app: fixed header + tabbed content.
templ appPanel(c echo.Context, a *repo.Tile, tab string, openRun *repo.CronRun, deployments []repo.Deployment, domains []repo.Domain, cpu, mem, rx, tx []components.TimePoint, runs []repo.CronRun, vol volumeView, httpLog []proxy.AccessEntry, configMode string, node placementView, inDrawer bool) {
	@panelHeaderBox(c, a, openRun, inDrawer, false)
	if a.HasImageUpdate() {
		<div class="px-6 py-2 bg-rw-warn/10 border-y border-rw-warn/40 text-sm text-rw-warn flex items-center gap-2 flex-wrap">
			<span class="font-semibold">New image version available</span>
			<span class="font-mono text-xs">{ shortDigest(a.LatestDigest) }</span>
			if a.UpdatePolicy == "auto" {
				<span class="text-xs opacity-75">auto-update queued by the watcher</span>
			} else {
				<span class="text-xs opacity-75">deploy to update</span>
			}
		</div>
	}
	<div id="panel-content">
		@panelContent(c, a, tab, deployments, domains, cpu, mem, rx, tx, runs, vol, httpLog, configMode, node)
	</div>
}

// PanelHeaderOOB re-renders just the header out of band. Deploy/Run/Pause
// change a tile's status but not which tab the user is reading, so they refresh
// the header and leave the body alone, before this they redirected the whole
// page, which is what closed the drawer.
templ panelHeaderOOB(c echo.Context, a *repo.Tile, openRun *repo.CronRun, inDrawer bool) {
	@panelHeaderBox(c, a, openRun, inDrawer, true)
	@components.FlashOOB(c)
}

// headerBoxAttrs wires #panel-header to refresh itself on a project event, so
// a run that finishes while the operator is reading Settings still flips the
// badge, and a pause or resume from the API reaches an open panel.
//
// oob marks the copy that rides back on an action response. An out-of-band
// swap replaces the element attributes and all, so both copies carry the same
// wiring or it is lost the first time someone hits Run now.
func headerBoxAttrs(a *repo.Tile, inDrawer, oob bool) templ.Attributes {
	url := "/apps/" + a.ID + "/panel/header"
	if inDrawer {
		url += "?drawer=1"
	}
	at := templ.Attributes{
		"id":              "panel-header",
		"data-ws-refresh": "project",
		"hx-get":          url,
		"hx-trigger":      "refresh",
		"hx-target":       "this",
		"hx-swap":         "innerHTML",
	}
	if oob {
		at["hx-swap-oob"] = "true"
	}
	return at
}

templ panelHeaderBox(c echo.Context, a *repo.Tile, openRun *repo.CronRun, inDrawer, oob bool) {
	<div { headerBoxAttrs(a, inDrawer, oob)... }>
		@panelHeader(c, a, openRun, inDrawer)
	</div>
}

templ panelHeader(c echo.Context, a *repo.Tile, openRun *repo.CronRun, inDrawer bool) {
	@components.PanelHeader(components.PanelHead{
		Title: a.Name, Subtitle: appSubtitle(a), Location: components.TileLocation(c), LocationColor: components.TileLocationColor(c),
		Status: headerStatus(a, openRun), InDrawer: inDrawer,
	}, appIcon(a), appActions(c, a, openRun))
}

// headerStatus: a cron or function with a run in flight reads "running", the
// way a service does while its container is up. tiles.status never says so,
// a cron's own row is idle or paused between ticks, by design (a failed run
// must not redden the stack card), so the open run row is the only source.
func headerStatus(a *repo.Tile, openRun *repo.CronRun) string {
	if openRun != nil {
		return "running"
	}
	return a.Status
}

// shortDigest trims "sha256:..." to its first 12 hex chars for display.
func shortDigest(d string) string {
	s := strings.TrimPrefix(d, "sha256:")
	if len(s) > 12 {
		s = s[:12]
	}
	return s
}

// appSubtitle: what this tile is built from, the image it runs, or where its
// source comes from.
func appSubtitle(a *repo.Tile) string {
	if a.SourceType == "image" && a.ImageRef != "" {
		return a.ImageRef
	}
	return a.SourceType
}

// appIcon is the header mark. The glyphs match canvas.templ strokeIcon on
// purpose: the same tile must not read as a cube here and a clock there.
templ appIcon(a *repo.Tile) {
	<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
		switch a.Kind {
			case "cron":
				<circle cx="12" cy="12" r="10"></circle>
				<path d="M12 6v6l4 2"></path>
			case "function":
				<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
			default:
				<path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
				<path d="m3.3 7 8.7 5 8.7-5"></path>
				<path d="M12 22V12"></path>
		}
	</svg>
}

// appActions are the header buttons a service or cron offers. A volume has
// none: nothing to deploy, nothing to stop.
templ appActions(c echo.Context, a *repo.Tile, openRun *repo.CronRun) {
	if a.Kind == "cron" {
		@cronActions(c, a, openRun)
	} else if a.Kind == "function" {
		@functionActions(c, a, openRun)
	} else if a.Kind != "volume" {
		if a.Status == "running" {
			<form hx-post={ "/apps/" + a.ID + "/stop" } hx-swap="none">
				@form.CSRFField(c)
				<button type="submit" class="btn btn-ghost btn-sm">Stop</button>
			</form>
			<form hx-post={ "/apps/" + a.ID + "/restart" } hx-swap="none">
				@form.CSRFField(c)
				<button type="submit" class="btn btn-ghost btn-sm">Restart</button>
			</form>
		}
		if !components.UpperEnv(c) {
			<form hx-post={ "/apps/" + a.ID + "/deploy" }>
				@form.CSRFField(c)
				<button type="submit" class="btn btn-primary btn-sm">Deploy</button>
			</form>
		}
	}
}

templ panelContent(c echo.Context, a *repo.Tile, tab string, deployments []repo.Deployment, domains []repo.Domain, cpu, mem, rx, tx []components.TimePoint, runs []repo.CronRun, vol volumeView, httpLog []proxy.AccessEntry, configMode string, node placementView) {
	@components.PanelTabs() {
		if a.Kind == "volume" {
			@components.PanelTab("/apps/"+a.ID+"/panel/content", tab, "overview", "Overview")
			@components.PanelTab("/apps/"+a.ID+"/panel/content", tab, "tree", "Tree")
			@components.PanelTab("/apps/"+a.ID+"/panel/content", tab, "backups", "Backups")
			@components.PanelTab("/apps/"+a.ID+"/panel/content", tab, "settings", "Settings")
		} else {
			if a.Kind == "cron" || a.Kind == "function" {
				// Runs and Deployments are two different histories: what the
				// tile did, and what was built and shipped to make it able to.
				// They shared the "deployments" key until now, so a cron's
				// builds, image tags and rollback were unreachable.
				@components.PanelTab("/apps/"+a.ID+"/panel/content", tab, "runs", "Runs")
				@components.PanelTab("/apps/"+a.ID+"/panel/content", tab, "logs", "Logs")
				@components.PanelTab("/apps/"+a.ID+"/panel/content", tab, "deployments", "Deployments")
			} else {
				@components.PanelTab("/apps/"+a.ID+"/panel/content", tab, "overview", "Overview")
				@components.PanelTab("/apps/"+a.ID+"/panel/content", tab, "deployments", "Deployments")
				@components.PanelTab("/apps/"+a.ID+"/panel/content", tab, "logs", "Logs")
				@components.PanelTab("/apps/"+a.ID+"/panel/content", tab, "http", "HTTP")
			}
			@components.PanelTab("/apps/"+a.ID+"/panel/content", tab, "variables", "Variables")
			if a.Kind != "cron" && a.Kind != "function" {
				@components.PanelTab("/apps/"+a.ID+"/panel/content", tab, "metrics", "Metrics")
			}
			@components.PanelTab("/apps/"+a.ID+"/panel/content", tab, "settings", "Settings")
		}
	}
	<div class="p-6">
		switch tab {
		case "overview":
			if a.Kind == "volume" {
				@volumeOverview(a, vol)
			} else {
				<!-- passive view: websocket-pushed refresh (slow poll as fallback) -->
				<div
					data-ws-refresh="project"
					hx-get={ "/apps/" + a.ID + "/panel/content?tab=overview" }
					hx-trigger="refresh, every 120s"
					hx-target="#panel-content"
					hx-swap="innerHTML"
				>
					@overviewTab(a, deployments, domains, node)
				</div>
			}
		case "tree":
			@filebrowse.Loader("/apps/" + a.ID + "/volume/files")
		case "backups":
			// The same fragment the db panel's Backups tab fetches.
			<div hx-get={ "/tiles/" + a.ID + "/backups" } hx-trigger="load" hx-swap="innerHTML">
				<p class="text-xs text-rw-faint">Loading…</p>
			</div>
		case "logs":
			if a.Kind == "cron" || a.Kind == "function" {
				@runLogs(a, runs)
			} else {
				@components.LogView("/apps/"+a.ID+"/logs/stream", false)
			}
		case "runs":
			<!-- passive view: websocket-pushed refresh (slow poll as fallback) -->
			<div
				data-ws-refresh="project"
				hx-get={ "/apps/" + a.ID + "/panel/content?tab=runs" }
				hx-trigger="refresh, every 120s"
				hx-target="#panel-content"
				hx-swap="innerHTML"
			>
				@runsList(runs)
			</div>
		case "http":
			<div
				hx-get={ "/apps/" + a.ID + "/panel/content?tab=http" }
				hx-trigger="every 10s"
				hx-target="#panel-content"
				hx-swap="innerHTML"
			>
				@httpTab(httpLog)
			</div>
		case "variables":
			@variablesTab(c, a)
		case "metrics":
			@metricsFrag(a, "1h", cpu, mem, rx, tx)
		case "settings":
			if a.Kind == "volume" {
				@volumeSettings(c, a, vol)
			} else {
				@settingsTab(c, a, domains, configMode, node)
			}
		default:
			<!-- passive view: websocket-pushed refresh (slow poll as fallback);
			     forms tabs never refresh -->
			<div
				data-ws-refresh="project"
				hx-get={ "/apps/" + a.ID + "/panel/content?tab=deployments" }
				hx-trigger="refresh, every 120s"
				hx-target="#panel-content"
				hx-swap="innerHTML"
			>
				@deploymentsTab(c, a, deployments)
			</div>
		}
	</div>
}

// overviewTab is the service landing view: status, last build, published
// URLs/ports. deployments carries at most the latest one here.
templ overviewTab(a *repo.Tile, deployments []repo.Deployment, domains []repo.Domain, node placementView) {
	<div class="space-y-5">
		<div class="grid grid-cols-2 gap-3">
			<div class="panel p-4">
				<div class="label">Status</div>
				@components.StatusBadge(a.Status)
				// Which machine, and whether it is answering. "stopped" on its
				// own sends the operator to this tile's logs when the reason is
				// that the node is off.
				if node.Name != "" {
					<div class="text-xs mt-1.5">
						if node.Down() {
							<span class="text-rw-warn">{ placementReason(node) }</span>
						} else {
							<span class="text-rw-faint">on <span class="font-mono">{ node.Name }</span></span>
						}
					</div>
				}
			</div>
			<div class="panel p-4">
				<div class="label">Last deployment</div>
				if len(deployments) == 0 {
					<span class="text-sm text-rw-faint">never deployed</span>
				} else {
					<a href={ templ.SafeURL("/deployments/" + deployments[0].ID) } class="text-sm link">
						@components.StatusBadge(deployments[0].Status)
					</a>
					<div class="text-xs text-rw-faint mt-1.5">
						{ deployments[0].CreatedAt.Local().Format("Jan 2 15:04") }
						if len(deployments[0].CommitSHA) >= 7 {
							· <span class="font-mono">{ deployments[0].CommitSHA[:7] }</span>
						}
					</div>
				}
			</div>
		</div>
		<div>
			<div class="label">URLs</div>
			if len(domains) == 0 {
				<p class="text-sm text-rw-faint">No domains attached. Add one in Settings.</p>
			} else {
				<ul class="space-y-1.5">
					for _, d := range domains {
						<li class="flex flex-wrap items-center gap-2 text-sm">
							if d.HTTPS {
								<a href={ templ.SafeURL("https://" + d.Host) } target="_blank" rel="noopener" class="link font-mono text-xs">{ "https://" + d.Host }</a>
								<span class="text-[10px] font-semibold uppercase tracking-wide text-rw-success">https</span>
							} else {
								<a href={ templ.SafeURL("http://" + d.Host) } target="_blank" rel="noopener" class="link font-mono text-xs">{ "http://" + d.Host }</a>
								<span class="text-[10px] font-semibold uppercase tracking-wide text-rw-warn">http only</span>
							}
							<span class="text-rw-faint text-xs">→ :{ strconv.Itoa(d.ContainerPort) }</span>
						</li>
					}
				</ul>
			}
		</div>
		<div>
			<div class="label">Ports</div>
			if a.ContainerPort == 0 && a.ExternalPort == 0 {
				<p class="text-sm text-rw-faint">No ports configured.</p>
			} else {
				<ul class="space-y-1 text-sm text-rw-muted">
					if a.ContainerPort != 0 {
						<li>container port <span class="font-mono text-rw-text">{ strconv.Itoa(a.ContainerPort) }</span> (proxied via domains above)</li>
					}
					if a.ExternalPort != 0 {
						<li>host port <span class="font-mono text-rw-text">{ strconv.Itoa(a.ExternalPort) }</span> published directly</li>
					}
				</ul>
			}
		</div>
	</div>
}

// httpTab: the tile's proxied requests from Traefik's access log, newest
// first, refreshed on a slow poll.
templ httpTab(entries []proxy.AccessEntry) {
	if len(entries) == 0 {
		<p class="text-sm text-rw-faint">No HTTP traffic recorded yet. Requests appear once a domain routes here.</p>
	} else {
		<div class="overflow-x-auto">
			<table class="w-full text-xs font-mono">
				<thead>
					<tr class="text-left text-rw-faint">
						<th class="py-1.5 pr-3 font-medium">time</th>
						<th class="py-1.5 pr-3 font-medium">method</th>
						<th class="py-1.5 pr-3 font-medium">path</th>
						<th class="py-1.5 pr-3 font-medium">status</th>
						<th class="py-1.5 pr-3 font-medium">ms</th>
						<th class="py-1.5 font-medium">client</th>
					</tr>
				</thead>
				<tbody>
					for _, e := range entries {
						<tr class="border-t border-rw-border text-rw-muted">
							<td class="py-1.5 pr-3 whitespace-nowrap">{ e.Time.Local().Format("15:04:05") }</td>
							<td class="py-1.5 pr-3">{ e.Method }</td>
							<td class="py-1.5 pr-3 max-w-[16rem] truncate text-rw-text">{ e.Path }</td>
							if e.Status >= 500 {
								<td class="py-1.5 pr-3 text-rw-danger">{ strconv.Itoa(e.Status) }</td>
							} else if e.Status >= 400 {
								<td class="py-1.5 pr-3 text-rw-warn">{ strconv.Itoa(e.Status) }</td>
							} else {
								<td class="py-1.5 pr-3 text-rw-success">{ strconv.Itoa(e.Status) }</td>
							}
							<td class="py-1.5 pr-3">{ strconv.FormatInt(e.MS, 10) }</td>
							<td class="py-1.5 truncate max-w-[10rem]">{ e.Client }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// logsTab: last 200 container log lines, refreshed on a slow poll.
// plain tail, live follow/search lands with the proper logs view.

// liveDeployment indexes the deployment whose image is the one in use: the
// newest done build that produced a tag (the list comes back newest-first), or
// -1 when nothing has shipped. Rolling back to it re-uses the image already
// running, so that row gets no button. The newest *done* one, not the newest
// one: after a failed deploy the image in use is the row below it.
func liveDeployment(ds []repo.Deployment) int {
	for i, d := range ds {
		if d.Status == "done" && d.ImageTag != "" {
			return i
		}
	}
	return -1
}

templ deploymentsTab(c echo.Context, a *repo.Tile, deployments []repo.Deployment) {
	if len(deployments) == 0 {
		<p class="text-rw-muted text-sm">No deployments yet. Hit Deploy to build the first one.</p>
	} else {
		{{ live := liveDeployment(deployments) }}
		<ul class="space-y-2">
			for i, d := range deployments {
				<li class="panel px-4 py-3 flex flex-wrap items-center gap-x-3 gap-y-2 hover:border-rw-accent/50 transition-colors">
					<a href={ templ.SafeURL("/deployments/" + d.ID) } class="flex items-center justify-between gap-3 flex-1 min-w-0 basis-48">
						<span class="text-sm text-rw-text font-mono">{ d.ID[:8] }</span>
						<span class="text-xs text-rw-faint whitespace-nowrap">{ d.CreatedAt.Format("Jan 2 15:04") }</span>
						@components.StatusBadge(d.Status)
					</a>
					<a href={ templ.SafeURL("/deployments/" + d.ID) } class="btn btn-ghost btn-sm shrink-0">Logs</a>
					if d.Status == "done" && d.ImageTag != "" && i != live {
						<form hx-post={ "/apps/" + a.ID + "/rollback" } hx-confirm="Roll back to this deployment's image?" class="shrink-0">
							@form.CSRFField(c)
							<input type="hidden" name="image_tag" value={ d.ImageTag }/>
							<button type="submit" class="btn btn-ghost btn-sm">Rollback</button>
						</form>
					}
				</li>
			}
		</ul>
	}
}

templ variablesTab(c echo.Context, a *repo.Tile) {
	<p class="text-xs text-rw-faint mb-3">
		Values may reference other tiles, the stack or the org:
		<span class="font-mono text-rw-muted">{ "${{ tile.db.DATABASE_URL }}" }</span>.
		References resolve at deploy time; start a value with the reference syntax for suggestions.
	</p>
	<div id="vars-panel" hx-get={ "/apps/" + a.ID + "/vars" } hx-trigger="load" hx-swap="innerHTML">
		<p class="text-rw-muted text-sm">Loading variables…</p>
	</div>
}

// varsFrag is the Variables tab body: stored rows first (the thing you read),
// then the raw editor for bulk import, then the secret form, secrets never go
// through the raw editor, which is rendered in plain text and diffed into
// config plans.
templ varsFrag(c echo.Context, a *repo.Tile, vars []repo.Variable, sources []varref.Source, events []repo.AuditEvent, configMode string, pendingRemoval map[string]bool) {
	<div id="vars-view">
		if len(vars) == 0 {
			<p class="text-rw-muted text-sm">No variables set yet.</p>
		} else {
			<ul class="space-y-1.5">
				for _, v := range vars {
					<li class={ "panel px-4 py-2.5 flex items-start gap-3 text-sm font-mono", templ.KV("opacity-60", pendingRemoval[v.Name]) }>
						<span class="text-rw-accentHi shrink-0">{ v.Name }</span>
						<span class="text-rw-faint">=</span>
						if v.Secret {
							<span class="flex-1 break-all text-rw-text" data-secret data-value-url={ "/apps/" + a.ID + "/vars/value?name=" + v.Name }>••••••••</span>
							<button type="button" data-reveal class="text-rw-faint hover:text-rw-text shrink-0" aria-label={ "Reveal " + v.Name }>
								<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"></path>
									<circle cx="12" cy="12" r="3"></circle>
								</svg>
							</button>
							<span class="text-[10px] px-1.5 py-0.5 rounded bg-rw-warn/15 text-rw-warn shrink-0">secret</span>
						} else {
							// break-all, not truncate: a ${{ }} reference cut off mid-name
							// is unreadable, and a value is worth a second line.
							<span class="flex-1 break-all text-rw-text">{ v.Value }</span>
							if isRef(v.Value) {
								<span class="text-[10px] px-1.5 py-0.5 rounded bg-rw-accent/15 text-rw-accentHi shrink-0">reference</span>
							}
						}
						// Every row deletes, not just secrets: a plain variable could
						// previously only be removed by hand-editing the raw block.
						// Except under ui_edits: block, the file owns the env blob
						// there, and DeleteVar refuses, so the × would only 409.
						if pendingRemoval[v.Name] {
							<span class="ml-auto text-[10px] px-1.5 py-0.5 rounded bg-rw-warn/15 text-rw-warn shrink-0">pending removal</span>
						} else if configMode != repo.UIEditsBlock || v.Secret {
							<form hx-post={ "/apps/" + a.ID + "/vars/delete" } hx-target="#vars-panel" hx-swap="innerHTML" class="shrink-0">
								@form.CSRFField(c)
								<input type="hidden" name="name" value={ v.Name }/>
								<button type="submit" class="text-rw-faint hover:text-rw-danger" aria-label={ "Delete " + v.Name }>×</button>
							</form>
						}
					</li>
				}
			</ul>
		}
		if configMode == repo.UIEditsBlock {
			<p class="text-xs text-rw-faint mt-4">The config file owns these. Secrets below stay editable.</p>
		} else {
			<button type="button" data-vars-edit class="btn btn-ghost btn-sm mt-4">Edit variables</button>
		}
	</div>
	<div id="vars-edit" class="hidden">
		<form hx-post={ "/apps/" + a.ID + "/env" } hx-target="#panel-content" hx-swap="innerHTML" class="space-y-4">
			@form.CSRFField(c)
			@field("Environment variables (KEY=VALUE per line)") {
				<textarea name="env" rows="10" data-code="env" data-refs={ refsJSON(sources) } placeholder={ "KEY=value\nDB=${{ tile.db.DATABASE_URL }}" } class={ inputCls + " font-mono text-sm" }>{ a.Env }</textarea>
			}
			@field("Build args (KEY=VALUE per line)") {
				<textarea name="build_args" rows="3" data-code="env" placeholder="ARG=value" class={ inputCls + " font-mono text-sm" }>{ a.BuildArgs }</textarea>
			}
			<div class="flex gap-2">
				<button type="submit" class="btn btn-primary">Save variables</button>
				<button type="button" data-vars-cancel class="btn btn-ghost">Cancel</button>
			</div>
		</form>
	</div>
	<form hx-post={ "/apps/" + a.ID + "/vars/secret" } hx-target="#vars-panel" hx-swap="innerHTML" class="mt-6 panel p-4 space-y-3">
		@form.CSRFField(c)
		<div class="label">Add a secret</div>
		<p class="text-xs text-rw-faint">Secrets are stored encrypted and never shown in the raw editor or a config plan.</p>
		<div class="flex gap-2">
			<label class="sr-only" for="secret-name">Secret name</label>
			<input id="secret-name" name="name" required placeholder="API_TOKEN" class={ inputCls + " font-mono text-sm" }/>
			<label class="sr-only" for="secret-value">Secret value</label>
			<input id="secret-value" name="value" type="password" required placeholder="value" class={ inputCls + " font-mono text-sm" }/>
			<button type="submit" class="btn btn-primary shrink-0">Add</button>
		</div>
	</form>
	if len(events) > 0 {
		<div class="mt-6">
			<div class="label mb-2">Secret activity</div>
			@components.AuditList(events)
		</div>
	}
}

templ settingsTab(c echo.Context, a *repo.Tile, domains []repo.Domain, configMode string, node placementView) {
	// configMode is "" on a UI-managed stack, else the stack's ui_edits mode.
	// block keeps the config-owned inputs read-only; stage leaves them editable
	// and holds the save in the env's pending set until someone applies it.
	if configMode == repo.UIEditsBlock {
		<div class="panel border-rw-warning/30 bg-rw-warning/5 px-4 py-2.5 mb-4 text-sm text-rw-muted">
			This stack is managed by <span class="font-mono text-rw-text">stackr-compose.yml</span>:
			every field on this form is read-only; change them in the repo.
			Secrets stay editable in the <span class="text-rw-text">Variables</span> tab.
		</div>
	} else if configMode == repo.UIEditsStage {
		<div class="panel border-rw-accent/30 bg-rw-accent/5 px-4 py-2.5 mb-4 text-sm text-rw-muted">
			This stack is managed by <span class="font-mono text-rw-text">stackr-compose.yml</span> with
			<span class="font-mono text-rw-text">ui_edits: stage</span>. Edits here are staged for review,
			and the next config plan shows them as drift.
		</div>
	}
	@settingsForm(c, a, configMode == repo.UIEditsBlock, node)
	if a.Kind != "cron" {
		<h3 class="text-sm font-semibold uppercase tracking-wide text-rw-faint mt-8 mb-4">Domains</h3>
		@domainsSection(c, a, domains)

	}
	<h3 class="text-sm font-semibold uppercase tracking-wide text-rw-faint mt-8 mb-4">Managed databases</h3>
	<div hx-get={ "/apps/" + a.ID + "/provisions" } hx-trigger="load" hx-swap="innerHTML">
		<p class="text-xs text-rw-faint">Loading…</p>
	</div>
	if a.Kind == "service" {
		<h3 class="text-sm font-semibold uppercase tracking-wide text-rw-faint mt-8 mb-4">Storage</h3>
		<div hx-get={ "/apps/" + a.ID + "/storage" } hx-trigger="load" hx-swap="innerHTML">
			<p class="text-xs text-rw-faint">Loading…</p>
		</div>
	}
	<div class="mt-8 pt-6 border-t border-rw-border">
		// Labelled per kind: a cron tile's delete button used to say "Delete app".
		@components.ConfirmDanger(c, components.ConfirmCfg{
			PostURL: "/apps/" + a.ID + "/delete",
			Want:    a.Slug,
			Path:    a.Slug,
			Warning: "Deleting this " + kindNoun(a) + " removes its container, its domains and its settings.",
			Kept:    "Volumes and databases it holds are kept on the host.",
			Label:   "Delete " + kindNoun(a),
			ID:      "tile-delete",
		})
	</div>
}

// kindNoun names a tile the way its own panel should refer to it.
func kindNoun(a *repo.Tile) string {
	switch a.Kind {
	case "cron":
		return "scheduled service"
	case "function":
		return "function"
	case "volume":
		return "volume"
	}
	return "service"
}

// volumeOverview shows what backs the volume and where it's mounted.
templ volumeOverview(a *repo.Tile, vol volumeView) {
	<div class="space-y-3">
		<div class="grid grid-cols-2 gap-3">
			<div class="panel p-4">
				<div class="label">Attached to</div>
				if a.AttachedTileID != "" {
					<span class="text-sm text-rw-text">{ attachedName(a, vol.Services) }</span>
					<span class="text-xs text-rw-faint font-mono block mt-0.5">{ a.MountPath }</span>
				} else {
					<span class="text-sm text-rw-faint">detached</span>
				}
			</div>
			<div class="panel p-4">
				<div class="label">Docker volume</div>
				<span class="text-sm text-rw-text font-mono">{ a.DockerVolume() }</span>
			</div>
			<div class={ "panel p-4", templ.KV("border-rw-warn", vol.OverLimit(a)) }>
				<div class="label">Size</div>
				if vol.SizeBytes < 0 {
					<span class="text-sm text-rw-faint">not measured yet</span>
				} else {
					<span class={ "text-sm", templ.KV("text-rw-warn", vol.OverLimit(a)), templ.KV("text-rw-text", !vol.OverLimit(a)) }>
						{ runtime.FmtBytes(vol.SizeBytes) }
					</span>
					if a.MaxSizeMB > 0 {
						<span class="text-xs text-rw-faint block mt-0.5">of { strconv.Itoa(a.MaxSizeMB) } MB expected</span>
					}
				}
			</div>
		</div>
		if vol.OverLimit(a) {
			<p class="text-xs text-rw-warn">Past its expected size. Nothing is enforcing this: docker's local volume driver has no quota, so the volume keeps growing until the host disk fills.</p>
		}
		<p class="text-xs text-rw-faint">Data persists across redeploys and service deletion. Cleanup lives on the <a href="/servers/local" class="link">server's Volumes page</a>.</p>
	</div>
}

// volumeView is the volume-tile slice of panel data. SizeBytes is -1 when
// docker has not measured the volume (never deployed, or the scan failed).
type volumeView struct {
	Services  []repo.Tile
	SizeBytes int64
}

// OverLimit reports whether a measured volume has passed its declared ceiling.
// Unknown size or no ceiling is never "over".
func (v volumeView) OverLimit(a *repo.Tile) bool {
	return a.MaxSizeMB > 0 && v.SizeBytes >= 0 && v.SizeBytes > int64(a.MaxSizeMB)*1024*1024
}

// volumeSettings: attach/detach and the danger zone.
templ volumeSettings(c echo.Context, a *repo.Tile, vol volumeView) {
	<form hx-post={ "/apps/" + a.ID + "/attach" } hx-target="#panel-content" hx-swap="innerHTML" class="space-y-3 max-w-md">
		@form.CSRFField(c)
		<div>
			<label class="label">Attached service (redeploys on change)</label>
			<select name="attach_tile_id" class="input">
				<option value="">Detached</option>
				for _, s := range vol.Services {
					<option value={ s.ID } selected?={ s.ID == a.AttachedTileID }>{ s.Name }</option>
				}
			</select>
		</div>
		<div>
			<label class="label">Mount path (inside the container)</label>
			<input type="text" name="mount_path" value={ a.MountPath } placeholder="/data" class="input font-mono"/>
		</div>
		<div>
			<label class="label">Expected size in MB (0 = none)</label>
			<input type="number" name="max_size_mb" min="0" value={ strconv.Itoa(a.MaxSizeMB) } class="input"/>
			<p class="settings-help">A warning threshold, not a quota: docker's local driver cannot cap a volume, so this only changes what the Overview tab tells you.</p>
		</div>
		<button type="submit" class="btn btn-primary btn-sm">Save</button>
	</form>
	<div class="mt-8 pt-6 border-t border-rw-border">
		if a.AttachedTileID != "" {
			<p class="text-xs text-rw-faint mb-2">Detach before deleting.</p>
		}
		if a.AttachedTileID == "" {
			@components.ConfirmDanger(c, components.ConfirmCfg{
				PostURL: "/apps/" + a.ID + "/delete",
				Want:    a.Slug,
				Path:    a.Slug,
				Warning: "Deleting this volume tile removes the tile.",
				Kept:    "The docker volume and its data stay on the host; clean up from the server's Volumes page.",
				Label:   "Delete volume",
				ID:      "volume-tile-delete",
			})
		}
	</div>
}

// attachedName resolves the attached service's display name.
func attachedName(a *repo.Tile, envServices []repo.Tile) string {
	for i := range envServices {
		if envServices[i].ID == a.AttachedTileID {
			return envServices[i].Name
		}
	}
	return "unknown"
}

// placementReason says why a pinned tile cannot run, per node state. Each
// line names the cause and the fix: "not answering" for a drained node sent
// the operator to the network when the answer was the Activate button.
func placementReason(node placementView) string {
	switch node.Status {
	case "draining":
		return node.Name + " is draining, so this tile cannot run. Activate that server, or move the tile to another one."
	case "pending":
		return node.Name + " has not finished joining yet, so this tile cannot run."
	case "gone":
		return node.Name + " is no longer in the swarm, so this tile cannot run. Its volumes are on that machine."
	}
	return node.Name + " is not answering, so this tile cannot run. Nothing here is wrong with the tile."
}
