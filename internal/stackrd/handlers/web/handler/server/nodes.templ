package server

import (
	"fmt"
	"strconv"
	"time"

	"github.com/labstack/echo/v4"

	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components/form"
	"github.com/FyrmForge/stackr/internal/stackrd/infra/nodes"
	"github.com/FyrmForge/stackr/internal/stackrd/infra/runtime"
	"github.com/FyrmForge/stackr/internal/stackrd/infra/volmove"
	"github.com/FyrmForge/stackr/internal/stackrd/store/repo"
)

// nodesPage is the servers list: one row per swarm node, read from the swarm
// on every load and mirrored into the servers table
// (docs/plans/32-multi-node-ui.md).
templ nodesPage(c echo.Context, rows []nodes.Row, isManager, agentUp bool, panelHost string) {
	@components.Shell(c, "Servers") {
		<div class="flex items-center gap-3 mb-8">
			<h1 class="text-2xl font-semibold text-rw-text tracking-tight">Servers</h1>
			if isManager {
				<button
					type="button"
					class="btn btn-primary btn-sm ml-auto"
					hx-get="/servers/add"
					hx-target="#modal-host"
					hx-swap="innerHTML"
				>Add node</button>
			}
		</div>

		<div
			id="nodes-live"
			hx-get="/servers"
			hx-trigger="every 15s"
			hx-select="#nodes-live"
			hx-swap="outerHTML"
		>
			<div class="panel overflow-x-auto">
				<table class="w-full text-sm">
					<thead>
						<tr class="text-left text-xs uppercase tracking-wide text-rw-faint border-b border-rw-border">
							<th class="px-4 py-2.5 font-medium">Name</th>
							<th class="px-4 py-2.5 font-medium">Address</th>
							<th class="px-4 py-2.5 font-medium">Role</th>
							<th class="px-4 py-2.5 font-medium">Group</th>
							<th class="px-4 py-2.5 font-medium">Status</th>
							<th class="px-4 py-2.5 font-medium">Ping</th>
							<th class="px-4 py-2.5 font-medium">Containers</th>
							<th class="px-4 py-2.5 font-medium">Engine</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-rw-border">
						for _, row := range rows {
							@nodeRow(c, row, panelHost)
						}
					</tbody>
				</table>
			</div>
		</div>

		// Reports the state the system is in and what to do about it. The old
		// copy said the agent "is created when a node is added", which is the
		// happy path stated as a fact: the operator reading it had just added a
		// node, and it had not been created.
		if !agentUp && len(rows) > 1 {
			<p class="text-sm text-rw-warn mt-4">
				The node agent is not running, so exec, stats, volume browse and volume moves
				will not work on anything off this machine. Everything already deployed keeps
				running. Check the panel logs for "node agent service", then add a node again
				to retry starting it.
			</p>
		}
	}
}

templ nodeRow(c echo.Context, row nodes.Row, panelHost string) {
	<tr class="hover:bg-rw-inset/40 transition-colors">
		<td class="px-4 py-3">
			<a href={ templ.SafeURL("/servers/" + row.Server.ID) } class="font-medium text-rw-text hover:text-rw-accent transition-colors">
				{ row.Server.Name }
			</a>
			if row.Server.Hostname != "" && row.Server.Hostname != row.Server.Name {
				<div class="text-xs text-rw-faint font-mono">{ row.Server.Hostname }</div>
			}
			if row.Node != nil && row.Node.Self {
				<span class="text-[10px] px-1.5 py-0.5 rounded bg-rw-accent/15 text-rw-accentHi">panel</span>
			}
		</td>
		<td class="px-4 py-3 font-mono text-xs text-rw-muted">{ orDash(row.Server.Address) }</td>
		<td class="px-4 py-3 text-xs text-rw-muted">{ orDash(row.Server.Role) }</td>
		<td class="px-4 py-3 text-xs text-rw-muted font-mono">{ orDash(nodeGroupOf(row)) }</td>
		<td class="px-4 py-3">
			@statusChip(row)
		</td>
		<td class="px-4 py-3 text-xs font-mono">
			@pingCell(row)
		</td>
		<td class="px-4 py-3 text-xs text-rw-muted font-mono">{ strconv.Itoa(row.Containers) }</td>
		// Engine skew is the first suspect when one node misbehaves, so it is
		// on the list rather than a click away.
		<td class="px-4 py-3 text-xs text-rw-faint font-mono">{ orDash(engineOf(row)) }</td>
	</tr>
	if row.Status == "pending" {
		<tr class="bg-rw-inset/30">
			<td colspan="8" class="px-4 py-3">
				@joinInstructions(c, row, panelHost)
			</td>
		</tr>
	}
}

// joinInstructions is what a pending row shows: the one-line script, or the
// button to mint a fresh key once the hour is up.
templ joinInstructions(c echo.Context, row nodes.Row, panelHost string) {
	if row.JoinKey == nil {
		<div class="flex flex-wrap items-center gap-3">
			// Used and expired are one state here on purpose: what an operator
			// does about either is the same, and saying "expired" about a key
			// that was used two seconds ago reads as a clock problem. A key is
			// spent the moment the script is fetched, so any join that fails
			// after that (no sudo password, a blocked port, the wrong machine)
			// needs a fresh one, which is what this button is for.
			<span class="text-xs text-rw-muted">
				This node's join key is no longer usable. A key is spent as soon as the
				script is fetched, and expires after an hour either way.
			</span>
			<form hx-post={ "/servers/" + row.Server.ID + "/join-key" } hx-target="#nodes-live" hx-select="#nodes-live" hx-swap="outerHTML">
				@form.CSRFField(c)
				<button type="submit" class="btn btn-ghost btn-sm">New script</button>
			</form>
		</div>
	} else {
		<p class="text-xs text-rw-muted mb-2">
			Run this on <span class="font-mono text-rw-text">{ row.Server.Address }</span>. The key works once and
			expires { humanUntil(row.JoinKey.ExpiresAt) }.
		</p>
		<code class="block rounded-lg bg-rw-bg border border-rw-border px-3 py-2 font-mono text-xs text-rw-text overflow-x-auto">
			{ joinCommand(panelHost, row.JoinKey.Key) }
		</code>
		<p class="text-[11px] text-rw-faint mt-2">
			Open between the nodes: 2377/tcp, 7946/tcp and udp, and 4789/udp. The script
			checks 2377 before it joins; the
			others cannot be checked until after, so a node that joins and then reads down or
			times out here is one of them being blocked.
		</p>
		// The way out of a pasted-in-the-wrong-window join command, and the
		// way to drop a row added by mistake. Neither existed: New script only
		// appeared once the key was already dead, and a pending row had no
		// Remove at all.
		<div class="flex flex-wrap items-center gap-3 mt-3">
			<form hx-post={ "/servers/" + row.Server.ID + "/join-key" } hx-target="#nodes-live" hx-select="#nodes-live" hx-swap="outerHTML">
				@form.CSRFField(c)
				<button type="submit" class="btn btn-ghost btn-sm">Replace this key</button>
			</form>
			<form
				hx-post={ "/servers/" + row.Server.ID + "/remove" }
				hx-target="#nodes-live"
				hx-select="#nodes-live"
				hx-swap="outerHTML"
				hx-confirm={ "Remove " + row.Server.Name + "? Its join key stops working and the row goes. Nothing on the machine itself is touched." }
			>
				@form.CSRFField(c)
				<button type="submit" class="btn btn-ghost btn-sm text-rw-danger">Remove</button>
			</form>
			<span class="text-[11px] text-rw-faint">
				Replacing the key stops the command above from working.
			</span>
		</div>
	}
}

templ statusChip(row nodes.Row) {
	switch row.Status {
		case "ready":
			<span class="text-xs px-1.5 py-0.5 rounded bg-rw-success/15 text-rw-success">ready</span>
		case "draining":
			<span class="text-xs px-1.5 py-0.5 rounded bg-rw-warn/15 text-rw-warn">draining</span>
		case "pending":
			<span class="text-xs px-1.5 py-0.5 rounded bg-rw-inset text-rw-faint">pending</span>
		default:
			<span class="text-xs px-1.5 py-0.5 rounded bg-rw-danger/15 text-rw-danger">
				down
				if row.Server.LastSeenAt.Valid {
					· { humanSince(row.Server.LastSeenAt.Time) }
				}
			</span>
	}
}

// pingCell renders the manager's TCP connect time to the node's swarm port.
// The manager's own row reads "self": it does not ping itself.
templ pingCell(row nodes.Row) {
	if row.Node != nil && row.Node.Self {
		<span class="text-rw-faint">self</span>
	} else if row.PingMs == nodes.PingUnknown {
		<span class="text-rw-faint" title="the manager pings every 30 seconds">not measured yet</span>
	} else if row.PingMs < 0 {
		<span class="text-rw-danger">timeout</span>
	} else if row.PingMs > 100 {
		<span class="text-rw-warn">{ pingText(row.PingMs) }</span>
	} else {
		<span class="text-rw-muted">{ pingText(row.PingMs) }</span>
	}
}

// --- modals ---------------------------------------------------------------

templ addNodeModal(c echo.Context) {
	@components.Modal("Add node", "A machine on the same private network or tunnel") {
		<form hx-post="/servers/add" hx-target="#modal-host" hx-swap="innerHTML">
			@form.CSRFField(c)
			<div class="modal-body">
				<div>
					<label class="label" for="node-name">Name</label>
					<input id="node-name" type="text" name="name" placeholder="worker-1" required class="input" autofocus/>
					<p class="settings-help">What this node is called in stackr. Its hostname arrives with the join.</p>
				</div>
				<div>
					<label class="label" for="node-addr">Address</label>
					<input id="node-addr" type="text" name="address" placeholder="10.0.0.20" required class="input font-mono"/>
					<p class="settings-help">
						A private address: a LAN, a provider private network, or a tunnel. Public addresses are
						refused, because the data plane between nodes is plain VXLAN.
					</p>
				</div>
			</div>
			<div class="modal-foot">
				<button type="button" class="btn btn-ghost" data-modal-close>Cancel</button>
				<button type="submit" class="btn btn-primary">Create join script</button>
			</div>
		</form>
	}
}

// joinModal is what Add node shows on success: the one-line script, which is
// the only time the key is ever displayed.
templ joinModal(c echo.Context, sv *repo.Server, key *repo.JoinKey, panelHost string, agentErr string) {
	@components.Modal("Join "+sv.Name, "Run this on "+sv.Address) {
		<div class="modal-body">
			if agentErr != "" {
				<p class="text-xs text-rw-danger">{ agentErr }</p>
			}
			<code class="block rounded-lg bg-rw-bg border border-rw-border px-3 py-2 font-mono text-xs text-rw-text overflow-x-auto">
				{ joinCommand(panelHost, key.Key) }
			</code>
			<p class="text-xs text-rw-faint">
				The key works once and expires { humanUntil(key.ExpiresAt) }. The script installs docker if
				it is missing, points the node at this panel's registry, and joins as a worker. It is
				refused if it is used from outside your private network.
			</p>
			<div class="modal-warn">
				Open between the nodes: 2377/tcp, 7946/tcp and udp, and 4789/udp. Only 2377 is
				checked before the join.
			</div>
		</div>
		<div class="modal-foot">
			<button
				type="button"
				class="btn btn-primary"
				data-modal-close
				hx-get="/servers"
				hx-select="#nodes-live"
				hx-target="#nodes-live"
				hx-swap="outerHTML"
			>Done</button>
		</div>
	}
}

// drainModal splits what happens by itself from what does not. Swarm moves
// stateless tasks on its own; a tile with a volume never moves on its own,
// because its data is a directory on this node's disk
// (docs/plans/32-multi-node-ui.md, Drain).
templ drainModal(c echo.Context, sv *repo.Server, stateless []runtime.NodeTaskInfo, pinned []pinnedTile) {
	@components.Modal("Drain "+sv.Name+"?", "Tasks move off; the node stays in the swarm") {
		<div class="modal-body">
			<div>
				<div class="label">Moves on its own</div>
				if len(stateless) == 0 {
					<p class="text-xs text-rw-faint">Nothing.</p>
				} else {
					<div class="modal-list">
						for _, t := range stateless {
							<div class="modal-list-row">
								<span class="font-mono text-rw-text">{ t.Service }</span>
								<span class="ml-auto text-rw-faint">{ t.State }</span>
							</div>
						}
					</div>
				}
			</div>
			<div>
				<div class="label">Pinned here</div>
				if len(pinned) == 0 {
					<p class="text-xs text-rw-faint">Nothing. Nothing on this node holds a volume.</p>
				} else {
					<p class="text-xs text-rw-muted mb-2">
						These hold volumes on this machine's disk. Draining does not move them and
						starting one elsewhere would start it empty, so move each one first.
					</p>
					<div class="modal-list">
						for _, p := range pinned {
							<div class="modal-list-row">
								<span class="font-mono text-rw-text">{ p.Tile.Name }</span>
								<button
									type="button"
									class="ml-auto btn btn-ghost btn-sm"
									hx-get={ "/servers/move/" + p.Tile.ID }
									hx-target="#modal-host"
									hx-swap="innerHTML"
								>Move to…</button>
							</div>
						}
					</div>
				}
			</div>
		</div>
		<div class="modal-foot">
			<button type="button" class="btn btn-ghost" data-modal-close>Cancel</button>
			<form hx-post={ "/servers/" + sv.ID + "/drain" }>
				@form.CSRFField(c)
				// Disabled is a hint to the browser; the refusal that counts is
				// in handler.Drain.
				<button type="submit" class="btn btn-primary" disabled?={ len(pinned) > 0 }>Drain</button>
			</form>
		</div>
	}
}

// removeModal is drain plus the thing that cannot be undone: the volumes on
// that machine are unreachable the moment it leaves, so they are named, and
// the node's name has to be typed.
templ removeModal(c echo.Context, sv *repo.Server, stateless []runtime.NodeTaskInfo, pinned []pinnedTile, vols []runtime.VolumeInfo, volErr string) {
	@components.Modal("Remove "+sv.Name+"?", "Drains, then leaves the swarm for good") {
		<div class="modal-body">
			<div>
				<div class="label">Moves on its own</div>
				if len(stateless) == 0 {
					<p class="text-xs text-rw-faint">Nothing.</p>
				} else {
					<div class="modal-list">
						for _, t := range stateless {
							<div class="modal-list-row">
								<span class="font-mono text-rw-text">{ t.Service }</span>
								<span class="ml-auto text-rw-faint">{ t.State }</span>
							</div>
						}
					</div>
				}
			</div>
			if len(pinned) > 0 {
				<div>
					<div class="label">Pinned here</div>
					<div class="modal-list">
						for _, p := range pinned {
							<div class="modal-list-row">
								<span class="font-mono text-rw-text">{ p.Tile.Name }</span>
								<button
									type="button"
									class="ml-auto btn btn-ghost btn-sm"
									hx-get={ "/servers/move/" + p.Tile.ID }
									hx-target="#modal-host"
									hx-swap="innerHTML"
								>Move to…</button>
							</div>
						}
					</div>
				</div>
			}
			<div class="modal-danger">
				if volErr != "" {
					The volumes on this node cannot be listed: { volErr }
				} else if len(vols) == 0 {
					No volumes on this node.
				} else {
					<div class="font-medium mb-1">{ strconv.Itoa(len(vols)) } volumes stay on that machine and become unreachable:</div>
					<div class="font-mono">
						for i, v := range vols {
							if i < 8 {
								<div>{ v.Name } · { runtime.FmtBytes(v.SizeBytes) }</div>
							}
						}
						if len(vols) > 8 {
							<div>and { strconv.Itoa(len(vols)-8) } more</div>
						}
					</div>
				}
			</div>
			<div>
				<label class="label" for="confirm-name">Type <span class="font-mono text-rw-text">{ sv.Name }</span> to confirm</label>
				// name= and form=: the handler re-checks what was typed, so the
				// box has to be submitted, and it lives outside the form it
				// belongs to.
				<input id="confirm-name" name="confirm" form="remove-node-form" type="text" class="input font-mono" data-confirm-input={ sv.Name } autocomplete="off"/>
			</div>
		</div>
		<div class="modal-foot">
			<button type="button" class="btn btn-ghost" data-modal-close>Cancel</button>
			<form id="remove-node-form" hx-post={ "/servers/" + sv.ID + "/remove" }>
				@form.CSRFField(c)
				<button type="submit" class="btn btn-danger" data-confirm-submit disabled>Remove</button>
			</form>
		</div>
	}
}

// moveModal copies a tile's volume to another node. Opened from the drawer's
// Placement section, from Drain and Remove, and from a blocking row on a
// config plan page, one modal, three doors
// (docs/plans/32-multi-node-ui.md, Move modal).
templ moveModal(c echo.Context, t *repo.Tile, targets []runtime.Node, vols []volmove.VolumeSize, sizeBytes int64, sizeErr string, mv *volmove.Move) {
	@components.Modal("Move "+t.Name+" to another node", "") {
		if mv != nil {
			@moveProgress(t, mv)
		} else {
			<form hx-post={ "/servers/move/" + t.ID } hx-target="#modal-host" hx-swap="innerHTML">
				@form.CSRFField(c)
				<div class="modal-body">
					if len(targets) == 0 {
						<p class="text-xs text-rw-faint">
							No other ready node to move to
							if t.NodeGroup != "" {
								in group <span class="font-mono">{ t.NodeGroup }</span>
							}
							.
						</p>
					} else {
						<div>
							<label class="label" for="move-target">Target</label>
							<select id="move-target" name="target" class="input">
								for _, n := range targets {
									<option value={ n.ID }>{ nodeLabel(n) }</option>
								}
							</select>
						</div>
					}
					<div class="text-xs text-rw-muted">
						if sizeErr != "" {
							<span class="text-rw-danger">{ sizeErr }</span>
						} else if len(vols) == 0 {
							Nothing to move.
						} else {
							// Every volume by name, not one total. A tile can mount
							// more than one and the operator has to be able to see
							// that all of them are going.
							<p class="mb-1">
								if len(vols) == 1 {
									One volume moves:
								} else {
									All { strconv.Itoa(len(vols)) } volumes move:
								}
							</p>
							<ul class="space-y-0.5">
								for _, v := range vols {
									<li class="flex items-center gap-2">
										<span class="font-mono text-rw-text">{ v.Name }</span>
										<span class="font-mono">{ runtime.FmtBytes(v.Bytes) }</span>
									</li>
								}
							</ul>
							if len(vols) > 1 {
								<p class="mt-1">
									Total <span class="font-mono text-rw-text">{ runtime.FmtBytes(sizeBytes) }</span>
								</p>
							}
						}
					</div>
					<div class="modal-warn">
						Each volume is copied while { t.Name } keeps running, then it is stopped for a short
						second pass that copies only what changed. It starts on the target once every volume
						has arrived. The copies on this node are left alone either way, so delete them from
						its server page when you no longer want them.
					</div>
				</div>
				<div class="modal-foot">
					<button type="button" class="btn btn-ghost" data-modal-close>Cancel</button>
					<button type="submit" class="btn btn-primary" disabled?={ len(targets) == 0 }>Move</button>
				</div>
			</form>
		}
	}
}

// moveProgress is the same modal once the copy is running: rsync's own byte
// counters, so the bar and the ETA are measured rather than guessed.
templ moveProgress(t *repo.Tile, mv *volmove.Move) {
	<div
		class="modal-body"
		hx-get={ "/servers/move/" + t.ID }
		hx-trigger="every 2s"
		hx-target="#modal-host"
		hx-swap="innerHTML"
	>
		<div class="flex items-center gap-2 text-sm">
			<span class="text-rw-text">{ movePhaseWord(mv.Phase) }</span>
			if mv.Phase == volmove.PhaseFailed {
				<span class="ml-auto text-xs px-1.5 py-0.5 rounded bg-rw-danger/15 text-rw-danger">failed</span>
			} else if mv.Phase == volmove.PhaseDone {
				<span class="ml-auto text-xs px-1.5 py-0.5 rounded bg-rw-success/15 text-rw-success">done</span>
			}
		</div>
		if mv.Error != "" {
			<p class="text-xs text-rw-danger font-mono">{ mv.Error }</p>
			<p class="text-xs text-rw-muted">{ t.Name } is back on the node it started on and its data was not touched.</p>
		} else {
			// templint:ignore inline-style -- the width is live data (rsync bytes), not design
			<div class="move-bar move-bar-lg" style={ templ.SafeCSS(barWidth(mv)) }>
				<span class="move-bar-fill"></span>
			</div>
			<div class="flex items-center gap-2 text-xs text-rw-muted font-mono">
				<span>{ runtime.FmtBytes(mv.Bytes) }</span>
				if mv.Total > 0 {
					<span class="text-rw-faint">of { runtime.FmtBytes(mv.Total) }</span>
				}
				if eta, ok := mv.ETA(); ok {
					<span class="ml-auto text-rw-faint">{ humanDuration(eta) } left</span>
				}
			</div>
		}
	</div>
	<div class="modal-foot">
		<button type="button" class="btn btn-ghost" data-modal-close>Close</button>
	</div>
}

// --- helpers --------------------------------------------------------------

// pinnedTile is one volume-holding tile living on a node, for the drain and
// remove lists.
type pinnedTile struct {
	Tile repo.Tile
}

func orDash(s string) string {
	if s == "" {
		return "-"
	}
	return s
}

func boolStr(b bool) string {
	if b {
		return "1"
	}
	return "0"
}

func nodeGroupOf(row nodes.Row) string {
	if row.Node == nil {
		return ""
	}
	return row.Node.Group
}

func engineOf(row nodes.Row) string {
	if row.Node == nil {
		return ""
	}
	return row.Node.EngineVersion
}

func nodeLabel(n runtime.Node) string {
	if n.Group != "" {
		return n.Hostname + " · " + n.Group
	}
	return n.Hostname
}

// joinCommand is the one line an operator pastes on the new node.
// joinCommand is what the operator pastes on the node.
//
// `| sudo sh` and not a bare `| sh`: the script needs root, and the key is
// spent the moment the URL is fetched, so a run that dies on the root check
// has already burned it and the operator has to come back for another one.
//
// No `-f` either. The panel answers a refused key with a script that prints
// why; `-f` makes curl throw the body away and print `curl: (22)` instead, so
// the one message written for this moment never arrives.
func joinCommand(panelHost, key string) string {
	return "curl -sSL " + panelHost + "/join/" + key + " | sudo sh"
}

func movePhaseWord(p volmove.Phase) string {
	switch p {
	case volmove.PhaseQueued:
		return "Waiting to start"
	case volmove.PhaseCopy:
		return "Copying, still running"
	case volmove.PhaseStop:
		return "Stopping for the final sync"
	case volmove.PhaseDelta:
		return "Final sync"
	case volmove.PhaseStart:
		return "Starting on the target"
	case volmove.PhaseDone:
		return "Moved"
	}
	return "Failed"
}

// barWidth carries the progress percentage into CSS as a custom property, so
// the width lives in a stylesheet rule rather than a style attribute.
func barWidth(mv *volmove.Move) string {
	pct := 0
	if mv.Total > 0 {
		pct = int(float64(mv.Bytes) / float64(mv.Total) * 100)
	}
	if mv.Phase == volmove.PhaseDone {
		pct = 100
	}
	if pct > 100 {
		pct = 100
	}
	return "--pct:" + strconv.Itoa(pct) + "%"
}

func humanDuration(d time.Duration) string {
	switch {
	case d < time.Minute:
		return fmt.Sprintf("%ds", int(d.Seconds()))
	case d < time.Hour:
		return fmt.Sprintf("%dm", int(d.Minutes()))
	}
	return fmt.Sprintf("%dh %dm", int(d.Hours()), int(d.Minutes())%60)
}

func humanSince(t time.Time) string { return humanDuration(time.Since(t)) + " ago" }

func humanUntil(t time.Time) string {
	d := time.Until(t)
	if d <= 0 {
		return "now"
	}
	return "in " + humanDuration(d)
}

