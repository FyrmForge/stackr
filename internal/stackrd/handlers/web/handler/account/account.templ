package account

import (
	"strings"

	"github.com/labstack/echo/v4"
	v1 "github.com/FyrmForge/stackr/internal/stackrd/handlers/api/v1"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/avatar"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/notify"
	"github.com/FyrmForge/stackr/internal/stackrd/store/repo"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components/form"
)

// nav is the account sub-navigation. Each section is its own URL so it can be
// linked to and survives a reload.
func nav(active string) []form.NavItem {
	return []form.NavItem{
		{Label: "Profile", Href: "/account/profile", Active: active == "profile"},
		{Label: "API keys", Href: "/account/apikeys", Active: active == "apikeys"},
		{Label: "Notifications", Href: "/account/notifications", Active: active == "notifications"},
		{Label: "Appearance", Href: "/account/appearance", Active: active == "appearance"},
	}
}

templ page(c echo.Context, active, title string) {
	@components.Shell(c, "Account") {
		<h1 class="text-2xl font-semibold text-rw-text tracking-tight mb-1">Account</h1>
		<p class="text-sm text-rw-muted mb-8">{ title }</p>
		@form.SettingsLayout(nav(active)) {
			{ children... }
		}
	}
}

templ profilePage(c echo.Context, u *repo.User) {
	@page(c, "profile", "Your details and sign-in credentials.") {
		@form.Section("Profile", form.ScopeUser, "How you appear in this install. Your email is also your sign-in identifier.") {
			@form.SettingsFormUpload(c, "/account/profile") {
				@form.Field("Avatar", "PNG, JPEG, GIF or WebP, up to 2 MB. Shown at icon size, not cropped or resized, so a square image looks best.") {
					<div class="flex items-center gap-3">
						@components.Avatar(u.AvatarPath, u.Name, "h-12 w-12 text-sm")
						<input type="file" name="avatar" accept={ avatar.Accept } class="input"/>
					</div>
					if u.AvatarPath != "" {
						<label class="flex items-center gap-2 text-xs text-rw-faint mt-2">
							<input type="checkbox" name="remove_avatar" value="1" class="accent-rw-accent"/>
							Remove it and go back to initials
						</label>
					}
				}
				@form.Field("Display name", "") {
					<input type="text" name="name" value={ u.Name } class="input" autocomplete="name"/>
				}
				@form.Field("Email", "Changing this changes how you log in.") {
					<input type="email" name="email" value={ u.Email } required class="input" autocomplete="email"/>
				}
				@form.Save("")
			}
		}
		@form.Section("Password", form.ScopeUser, "Changing your password does not sign out your other sessions.") {
			@form.SettingsForm(c, "/account/password") {
				// Password managers match a saved login by its username, and a
				// password form without one is what Chrome warns about. A
				// type=hidden field does not count for it, so this is a real
				// text input hidden by CSS and kept out of the tab order. The
				// server ignores the field; the session says who this is.
				<input type="text" name="username" autocomplete="username" value={ u.Email } class="sr-only" tabindex="-1" readonly aria-hidden="true"/>
				@form.Field("Current password", "") {
					<input type="password" name="current_password" required class="input" autocomplete="current-password"/>
				}
				@form.Field("New password", "At least 8 characters.") {
					<input type="password" name="new_password" required minlength="8" class="input" autocomplete="new-password"/>
				}
				@form.Field("Confirm new password", "") {
					<input type="password" name="confirm_password" required minlength="8" class="input" autocomplete="new-password"/>
				}
				@form.Save("Change password")
			}
		}
	}
}

templ apiKeysPage(c echo.Context, keys []repo.APIKey, newKey string) {
	@page(c, "apikeys", "Programmatic access for the CLI and CI.") {
		if newKey != "" {
			<div class="panel px-4 py-3 mb-5 border-rw-success/40 bg-rw-success/5">
				<p class="text-sm text-rw-text mb-2">Your new key. Copy it now, it is not shown again.</p>
				<div class="flex items-center gap-2">
					<code class="flex-1 min-w-0 truncate font-mono text-xs text-rw-accentHi">{ newKey }</code>
					<button type="button" data-copy={ newKey } class="btn btn-ghost btn-sm">Copy</button>
				</div>
			</div>
		}
		@form.Section("Create a key", form.ScopeUser, "Use with the x-api-key header. The token is shown once, at creation.") {
			@form.SettingsForm(c, "/account/apikeys") {
				@form.Field("Key name", "Something that says where it is used, like ci or laptop.") {
					<input type="text" name="name" required class="input" placeholder="ci"/>
				}
				@form.Field("Permissions", "A key can never grant more than you already have.") {
					// data-scope-presets marks the region the preset buttons act
					// on, so the script never has to know the form's shape.
					<div data-scope-presets>
						<div class="flex gap-2 mb-3">
							<button type="button" data-scope-preset="read" class="btn btn-ghost btn-sm">Read only</button>
							<button type="button" data-scope-preset="all" class="btn btn-ghost btn-sm">Everything</button>
							<button type="button" data-scope-preset="none" class="btn btn-ghost btn-sm">Clear</button>
						</div>
						for _, group := range v1.ScopeGroups {
							if scopes := v1.ScopesIn(group); len(scopes) > 0 {
								<fieldset class="mb-3">
									<legend class="text-xs font-semibold uppercase tracking-wide text-rw-faint mb-1">{ group }</legend>
									<div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-1">
										for _, sc := range scopes {
											<label class={ "flex items-center gap-2 text-sm", templ.KV("opacity-40", sc.Write && !CanGrantWrite(c)) }>
												<input
													type="checkbox"
													name="scopes"
													value={ sc.Name }
													class="accent-rw-accent"
													if sc.Write {
														data-scope-write
													}
													if sc.Write && !CanGrantWrite(c) {
														disabled
													}
												/>
												<span class="font-mono text-xs text-rw-accentHi">{ sc.Name }</span>
												<span class="text-rw-faint text-xs truncate">{ sc.Desc }</span>
											</label>
										}
									</div>
								</fieldset>
							}
						}
					</div>
					if !CanGrantWrite(c) {
						<p class="text-xs text-rw-faint mt-1.5">Write permissions need content-write access in your organization.</p>
					}
				}
				@form.Save("Create key")
			}
			<p class="text-xs text-rw-faint mt-4">Full API reference at <a href="/api/openapi.json" class="link">/api/openapi.json</a>.</p>
		}
		@form.Section("Your keys", form.ScopeUser, "") {
			if len(keys) == 0 {
				<p class="text-sm text-rw-faint">No API keys yet.</p>
			} else {
				<ul class="space-y-2">
					for _, k := range keys {
						<li class="panel px-4 py-3 flex items-center justify-between gap-3">
							<span class="text-sm text-rw-text min-w-0">
								{ k.Name } <span class="text-rw-faint text-xs">{ k.CreatedAt.Format("Jan 2 2006") }</span>
								if scopes := strings.Join(k.ScopeList(), " "); scopes != "" {
									<div class="text-rw-faint text-xs font-mono truncate mt-0.5">{ scopes }</div>
								}
							</span>
							<form hx-post={ "/account/apikeys/" + k.ID + "/delete" } hx-confirm="Revoke this key? Anything using it stops working immediately.">
								@form.CSRFField(c)
								<button type="submit" class="btn btn-danger btn-sm">Revoke</button>
							</form>
						</li>
					}
				</ul>
			}
		}
	}
}

templ notificationsPage(c echo.Context, prefs map[string]bool) {
	@page(c, "notifications", "What reaches your notification center.") {
		@form.Section("Notification preferences", form.ScopeUser, "Yours alone: nobody else's choices affect these, and changing them affects nobody else.") {
			@form.SettingsForm(c, "/account/notifications") {
				<div class="space-y-2">
					for _, k := range notify.Kinds {
						<label class="flex items-center gap-2 text-sm text-rw-muted cursor-pointer">
							<input type="checkbox" name={ k.Kind } value="1" checked?={ prefs[k.Kind] } class="accent-rw-accent"/>
							{ k.Label }
						</label>
					}
				</div>
				@form.Save("")
			}
			<p class="text-xs text-rw-faint mt-4">
				Delivery is in-app only for now. See the <a href="/notifications" class="link">notification center</a>. Email and webhooks come later.
			</p>
		}
	}
}

templ appearancePage(c echo.Context, theme string) {
	@page(c, "appearance", "How stackr looks for you.") {
		@form.Section("Theme", form.ScopeUser, "Applies wherever you sign in.") {
			@form.SettingsForm(c, "/account/appearance") {
				<div class="space-y-2">
					for _, o := range themeOptions {
						<label class="flex items-center gap-2 text-sm text-rw-muted cursor-pointer">
							<input type="radio" name="theme" value={ o.Value } checked?={ theme == o.Value } class="accent-rw-accent"/>
							{ o.Label }
						</label>
					}
				</div>
				@form.Save("")
			}
		}
	}
}
