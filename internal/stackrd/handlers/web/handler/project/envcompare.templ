package project

import (
	"strconv"

	"github.com/labstack/echo/v4"

	"github.com/FyrmForge/stackr/internal/stackrd/config/envcompare"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components/form"
	"github.com/FyrmForge/stackr/internal/stackrd/store/repo"
)

// envCompareWidget is the pill bottom-left of the stack canvas and the panel
// it opens: the commits on the bound branch and which environment runs which,
// and the tiles compared against the first environment. It refreshes on every
// project event and after its own actions (both swap the whole widget;
// graph.js restores the open state and the tab).
templ envCompareWidget(c echo.Context, p *repo.Stack, res envcompare.Result, colors map[string]string, log commitLog) {
	<div
		id="env-compare"
		class="absolute bottom-4 left-4 z-10"
		hx-get={ "/projects/" + p.ID + "/envs/compare" }
		hx-trigger="refresh"
		hx-swap="outerHTML"
		data-ws-refresh="project"
	>
		if len(res.Envs) > 0 {
			<details class="env-compare" data-env-compare>
				<summary class="env-pill">
					// The bar talks commits. Config drift lives in the Tiles tab.
					for _, e := range res.Envs {
						<span class="flex items-center gap-1.5 text-rw-text">
							@components.EnvDot(colors[e.ID], "")
							{ e.Name }
							if behind, off, found := log.envRun(e.ID); found && off {
								<span class="text-rw-warn" title="Runs a commit the branch does not contain">off branch</span>
							} else if found && behind > 0 {
								<span class="text-rw-warn" title={ strconv.Itoa(behind) + " commit" + plural(behind) + " behind " + log.Branch }>↑{ strconv.Itoa(behind) }</span>
							}
						</span>
					}
					if log.sameCommit(res.Envs) {
						<span class="pl-2.5 ml-0.5 border-l border-rw-border text-rw-success">same commit</span>
					}
				</summary>
				<div class="env-tabs">
					<input type="radio" name="env-tab" id="env-tab-commits" value="commits" class="sr-only" checked/>
					<input type="radio" name="env-tab" id="env-tab-tiles" value="tiles" class="sr-only" disabled?={ len(res.Envs) < 2 }/>
					<div class="flex items-center gap-1 px-2 pt-2 border-b border-rw-border">
						<label for="env-tab-commits" class="env-tab">Commits</label>
						if len(res.Envs) > 1 {
							<label for="env-tab-tiles" class="env-tab">Tiles</label>
						}
						<span class="ml-auto pr-1 pb-1.5 text-rw-faint truncate">
							if log.Branch != "" {
								// The way out of the panel: the log says where a commit
								// runs, the releases page is where it is acted on.
								<a href={ templ.SafeURL(stackURL(p) + "/releases") } class="hover:text-rw-text transition-colors">{ log.Repo } · { log.Branch }</a>
							}
						</span>
					</div>
					<div class="env-tab-commits">
						@commitList(log)
					</div>
					<div class="env-tab-tiles">
						<div class="env-compare-grid border-b border-rw-border" data-cols={ strconv.Itoa(len(res.Envs)) }>
							<span class="px-3 py-2 text-rw-faint">tile</span>
							for _, e := range res.Envs {
								<span class="px-2 py-2 flex items-center gap-1.5 font-medium text-rw-text cursor-default" data-env-node={ "env:" + e.Slug }>
									@components.EnvDot(colors[e.ID], "")
									<span class="truncate">{ e.Name }</span>
								</span>
							}
						</div>
						if len(res.Rows) == 0 {
							<p class="px-3 py-3 text-rw-faint">No tiles yet.</p>
						}
						for _, row := range res.Rows {
							@compareRow(c, p, res, row, colors)
						}
					</div>
				</div>
			</details>
		}
	</div>
}

func cellCount(cell envcompare.Cell, intended bool) int {
	n := 0
	for _, k := range cell.Keys {
		if k.Intended == intended {
			n++
		}
	}
	return n
}

func rowOpens(row envcompare.Row) bool {
	for _, cell := range row.Cells {
		if len(cell.Keys) > 0 {
			return true
		}
	}
	return false
}

templ compareCell(cell envcompare.Cell) {
	switch cell.State {
		case "ref":
			<span class="px-2 py-1.5 text-rw-faint">reference</span>
		case "same":
			<span class="px-2 py-1.5 text-rw-faint">same</span>
		case "missing":
			<span class="px-2 py-1.5 text-rw-danger">missing</span>
		case "intended":
			<span class="px-2 py-1.5 text-rw-muted">{ strconv.Itoa(len(cell.Keys)) } intended</span>
		default:
			<span class="px-2 py-1.5 text-rw-warn">
				{ strconv.Itoa(cellCount(cell, false)) } differs
				if n := cellCount(cell, true); n > 0 {
					<span class="text-rw-faint">· { strconv.Itoa(n) } intended</span>
				}
			</span>
	}
}

templ compareRow(c echo.Context, p *repo.Stack, res envcompare.Result, row envcompare.Row, colors map[string]string) {
	if rowOpens(row) {
		<details class="group border-b border-rw-border last:border-b-0">
			<summary class="env-compare-grid cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-rw-raised" data-cols={ strconv.Itoa(len(res.Envs)) }>
				<span class="px-3 py-1.5 font-mono text-rw-text truncate flex items-center gap-1.5">
					<span class="text-rw-faint transition-transform group-open:rotate-90" aria-hidden="true">&#9656;</span>
					{ row.Slug }
				</span>
				for _, cell := range row.Cells {
					@compareCell(cell)
				}
			</summary>
			<div class="bg-rw-raised/60 pb-2">
				for _, cell := range row.Cells[1:] {
					for _, k := range cell.Keys {
						<div class="env-compare-grid" data-cols={ strconv.Itoa(len(res.Envs)) }>
							<span class="px-3 py-1 pl-7 font-mono text-rw-muted truncate" title={ k.Name }>{ k.Name }</span>
							<span class="px-2 py-1 font-mono text-rw-faint truncate" title={ k.Ref }>{ orDash(k.Ref) }</span>
							for _, other := range row.Cells[1:] {
								if other.EnvID == cell.EnvID {
									<span class={ "px-2 py-1 font-mono truncate", templ.KV("text-rw-text", !k.Intended), templ.KV("text-rw-faint", k.Intended) } title={ k.Val }>
										{ orDash(k.Val) }
										if k.Intended {
											<span class="text-rw-faint"> · intended</span>
										}
									</span>
								} else {
									<span></span>
								}
							}
						</div>
					}
				}
				<div class="env-compare-grid mt-1" data-cols={ strconv.Itoa(len(res.Envs)) }>
					<span></span>
					<span></span>
					for _, cell := range row.Cells[1:] {
						<span class="px-2 flex flex-col items-start gap-1">
							if cellCount(cell, false) > 0 {
								<form hx-post={ "/envs/" + cell.EnvID + "/intended" } hx-target="#env-compare" hx-swap="outerHTML" hx-confirm={ "Mark the " + strconv.Itoa(cellCount(cell, false)) + " differing keys on " + row.Slug + " as intended? They stop counting until they change again." }>
									@form.CSRFField(c)
									<input type="hidden" name="tile" value={ row.Slug }/>
									<button type="submit" class="btn btn-ghost btn-sm">Mark intended</button>
								</form>
								if !p.ConfigManaged() {
									<form hx-post={ "/envs/" + cell.EnvID + "/copy" } hx-target="#env-compare" hx-swap="outerHTML" hx-confirm={ "Copy " + row.Slug + " from " + res.Envs[0].Name + " and deploy it here?" }>
										@form.CSRFField(c)
										<input type="hidden" name="tile" value={ row.Slug }/>
										<button type="submit" class="btn btn-ghost btn-sm">Copy from { res.Envs[0].Name }</button>
									</form>
								}
							}
						</span>
					}
				</div>
			</div>
		</details>
	} else {
		<div class="env-compare-grid border-b border-rw-border last:border-b-0" data-cols={ strconv.Itoa(len(res.Envs)) }>
			<span class="px-3 py-1.5 pl-7 font-mono text-rw-text truncate">{ row.Slug }</span>
			for _, cell := range row.Cells {
				@compareCell(cell)
			}
		</div>
	}
}

func orDash(s string) string {
	if s == "" {
		return "-"
	}
	return s
}
