package project

import (
	"strconv"
	"strings"

	"github.com/labstack/echo/v4"
	"github.com/FyrmForge/stackr/internal/stackrd/config/envcompare"
	"github.com/FyrmForge/stackr/internal/stackrd/infra/managedtiles"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/graph"
	"github.com/FyrmForge/stackr/internal/stackrd/store/repo"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components/canvas"
)

// envURL builds the canonical slug path for an environment's canvas.
// Handlers fill p.OrgSlug on load; the seeded org slug is the fallback.
func envURL(p *repo.Stack, e *repo.Environment) string {
	return "/" + orgSlugOf(p) + "/" + p.Slug + "/" + e.Slug
}

// stackURL is the stack canvas path, the level above an environment.
func stackURL(p *repo.Stack) string {
	return "/" + orgSlugOf(p) + "/" + p.Slug
}

// stackSettingsURL is the stack settings page path.
func stackSettingsURL(p *repo.Stack) string {
	return "/" + orgSlugOf(p) + "/" + p.Slug + "/settings"
}

func orgSlugOf(p *repo.Stack) string {
	if p.OrgSlug == "" {
		// Orphaned stack, no slug is right, the org id is at least honest.
		return p.OrgID
	}
	return p.OrgSlug
}

// crumbs is the canvas header's path: <org>/<stack>/<env>, every segment a
// link one level up. It replaces the page title on the stack and environment
// canvases, so the header says where you are as well as what you are looking
// at, and the ← beside it is just the last segment's parent.
//
// The org segment is the slug: repo.Stack carries OrgSlug for URL building but
// not the org's display name, and one more query per page render to prettify a
// breadcrumb is not worth it.
//
// env == nil renders the stack level, where the trail simply stops.
templ crumbs(p *repo.Stack, env *repo.Environment, envs []repo.Environment, colors map[string]string) {
	<nav class="flex items-center gap-1.5 text-lg font-semibold tracking-tight min-w-0" aria-label="Breadcrumb">
		<a href={ templ.SafeURL("/orgs/" + orgSlugOf(p)) } class="text-rw-muted hover:text-rw-text transition-colors truncate">{ orgSlugOf(p) }</a>
		<span class="text-rw-faint" aria-hidden="true">/</span>
		if env == nil {
			<span class="text-rw-text truncate">{ p.Name }</span>
		} else {
			<a href={ templ.SafeURL(stackURL(p)) } class="text-rw-muted hover:text-rw-text transition-colors truncate">{ p.Name }</a>
			<span class="text-rw-faint" aria-hidden="true">/</span>
			@envPicker(p, env, envs, colors)
		}
	</nav>
}

// envPicker is the breadcrumb's last segment: the current environment, and a
// menu of its siblings. A <details> rather than scripted state, the platform
// already closes it on click-away and reopens it on the keyboard, and the row
// of pills it replaces was the whole environment list spelled out.
templ envPicker(p *repo.Stack, env *repo.Environment, envs []repo.Environment, colors map[string]string) {
	<details class="relative shrink-0">
		<summary class="flex items-center gap-1.5 cursor-pointer list-none [&::-webkit-details-marker]:hidden text-rw-text hover:text-rw-accentHi transition-colors">
			@components.EnvDot(colors[env.ID], "")
			{ env.Name }
			if env.Type == "ephemeral" {
				<span class="text-xs font-normal text-rw-faint">temp</span>
			}
			<svg class="h-3.5 w-3.5 text-rw-faint" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 8l4 4 4-4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
		</summary>
		<div class="absolute left-0 top-full mt-1.5 z-40 panel py-1 min-w-40 shadow-rw">
			for _, e := range envs {
				<a
					href={ templ.SafeURL(envURL(p, &e)) }
					class={ "flex items-center gap-2 px-3 py-1.5 text-sm font-normal whitespace-nowrap transition-colors",
						templ.KV("bg-rw-accent/15 text-rw-accentHi", e.ID == env.ID),
						templ.KV("text-rw-muted hover:text-rw-text hover:bg-rw-surface2", e.ID != env.ID) }
				>
					@components.EnvDot(colors[e.ID], "")
					{ e.Name }
					if e.Type == "ephemeral" {
						<span class="text-rw-faint ml-1">temp</span>
					}
				</a>
			}
		</div>
	</details>
}

templ graphPage(c echo.Context, p *repo.Stack, env *repo.Environment, envs []repo.Environment, colors map[string]string, g graph.Graph, pendingPlan *repo.ConfigPlan, stagedCount int, cmp envcompare.Result, log commitLog) {
	@components.ShellFull(c, p.Name + ": architecture") {
		if colors[env.ID] != "" {
			<!-- the band: which environment this canvas is, at a glance. Top of the page, above the bar -->
			// templint:ignore inline-style -- the colour is data (a user-picked hex), not design
			<div class="h-[3px] shrink-0" style={ templ.SafeCSS("background:" + colors[env.ID]) }></div>
		}
		<div class="flex flex-wrap items-center gap-x-3 gap-y-2 px-4 sm:px-6 py-3 min-h-14 border-b border-rw-border bg-rw-surface shrink-0">
			<a href={ templ.SafeURL(stackURL(p)) } class="text-rw-muted hover:text-rw-text transition-colors" title="Up to the stack">&larr;</a>
			@crumbs(p, env, envs, colors)
			<a href={ templ.SafeURL(envURL(p, env) + "/logs") } class="text-sm text-rw-faint hover:text-rw-text transition-colors">Logs</a>
			<a href={ templ.SafeURL(stackSettingsURL(p)) } class="text-sm text-rw-faint hover:text-rw-text transition-colors">Settings</a>
			<div class="ml-auto flex items-center gap-2">
				if !p.ConfigManaged() {
					<div class="relative">
						<button type="button" data-create-toggle class="btn btn-primary btn-sm">+ Create</button>
						@createMenu(c, p, env, g)
					</div>
				} else {
					<span class="text-xs text-rw-text-dim" title="This stack is managed by its config file. Edit the file to change its structure.">Managed by config</span>
				}
			</div>
		</div>

		@planBanner(p, pendingPlan, envURL(p, env))

		@canvas.Canvas(canvas.Opts{
			SaveURL: "/envs/" + env.ID + "/graph/positions",
			WSRoom:  "project:" + p.ID,
			CSRF:    csrf(c),
			Empty:   emptyCanvasText(stagedCount),
			Traffic: true,
		}, g) {
			@stagingBox(p, env, stagedCount)
			@envCompareWidget(c, p, cmp, colors, log)
		}
		@canvas.Chrome(true)
	}
}


func intOr(v *int) string {
	if v == nil {
		return ""
	}
	return strconv.Itoa(*v)
}

func floatOr(v *float64) string {
	if v == nil {
		return ""
	}
	return strconv.FormatFloat(*v, 'f', -1, 64)
}

// createMenu is the create modal: three tabs (service / cron / managed),
// service tab is source-first with a GitHub repo picker fed by the org's
// connectors. Forms post to existing routes with from=canvas so the handler
// returns to the canvas with the new node. Tab/backdrop/source-switch logic
// lives in graph.js.
templ createMenu(c echo.Context, p *repo.Stack, env *repo.Environment, g graph.Graph) {
	<div id="create-menu" class="hidden fixed inset-0 z-40">
		<div class="absolute inset-0 scrim" data-create-close></div>
		<div class="relative panel w-full max-w-md mx-auto mt-16 sm:mt-24 p-5 shadow-rw text-left max-h-[85vh] overflow-y-auto">
			<div class="flex items-center justify-between mb-4">
				<h2 class="text-sm font-semibold text-rw-text">Create tile</h2>
				<button type="button" data-create-close class="graph-ctrl !h-7 !w-7" aria-label="Close">&times;</button>
			</div>
			<div class="flex gap-1 mb-4 border-b border-rw-border" role="tablist">
				<button type="button" data-ctab="service" class="px-3 py-1.5 text-sm text-rw-text border-b-2 border-rw-accent -mb-px">Service</button>
				<button type="button" data-ctab="cron" class="px-3 py-1.5 text-sm text-rw-muted border-b-2 border-transparent -mb-px">Cron job</button>
				<button type="button" data-ctab="function" class="px-3 py-1.5 text-sm text-rw-muted border-b-2 border-transparent -mb-px">Function</button>
				<button type="button" data-ctab="db" class="px-3 py-1.5 text-sm text-rw-muted border-b-2 border-transparent -mb-px">Managed</button>
				<button type="button" data-ctab="volume" class="px-3 py-1.5 text-sm text-rw-muted border-b-2 border-transparent -mb-px">Volume</button>
			</div>

			<form hx-post={ "/projects/" + p.ID + "/apps" } data-cpane="service" class="space-y-2.5">
				<input type="hidden" name="csrf_token" value={ csrf(c) }/>
				<input type="hidden" name="from" value="canvas"/>
				<input type="hidden" name="env_id" value={ env.ID }/>
				<input type="hidden" name="connector_id"/>
				<select name="source_type" data-create-source class="input">
					<option value="git" selected>GitHub repository</option>
					<option value="git-manual">Git URL (public / manual)</option>
					<option value="image">Docker image</option>
				</select>
				<div data-src="git">
					<select data-repo-pick class="input font-mono text-sm" hx-get={ "/projects/" + p.ID + "/repos" } hx-trigger="load" hx-swap="beforeend">
						<option value="">Pick a repository…</option>
					</select>
				</div>
				<div data-src="git git-manual" class="space-y-2.5">
					<input type="text" name="git_url" placeholder="https://github.com/user/repo" class="input font-mono text-sm"/>
					<input type="text" name="git_branch" placeholder="branch (default: main)" class="input font-mono text-sm"/>
				</div>
				<div data-src="image" class="hidden">
					<input type="text" name="image_ref" placeholder="image, e.g. nginx:latest" class="input font-mono text-sm"/>
				</div>
				<input type="text" name="name" placeholder="service name" required class="input"/>
				<div data-src="git git-manual image">
					<input type="number" name="container_port" placeholder="container port, e.g. 8080" min="1" max="65535" class="input"/>
					<p class="text-xs text-rw-faint mt-1">The port your app listens on, needed for domains and PR preview URLs.</p>
				</div>
				<button type="submit" class="btn btn-primary btn-sm w-full">Create service</button>
			</form>

			<form hx-post={ "/projects/" + p.ID + "/apps" } data-cpane="cron" class="space-y-2.5 hidden">
				<input type="hidden" name="csrf_token" value={ csrf(c) }/>
				<input type="hidden" name="from" value="canvas"/>
				<input type="hidden" name="env_id" value={ env.ID }/>
				<input type="hidden" name="kind" value="cron"/>
				<input type="hidden" name="connector_id"/>
				<select name="source_type" data-create-source class="input">
					<option value="image" selected>Docker image</option>
					<option value="git">GitHub repository</option>
					<option value="git-manual">Git URL (public / manual)</option>
				</select>
				<div data-src="image">
					<input type="text" name="image_ref" placeholder="image, e.g. alpine:3" class="input font-mono text-sm"/>
				</div>
				<div data-src="git" class="hidden">
					<select data-repo-pick class="input font-mono text-sm" hx-get={ "/projects/" + p.ID + "/repos" } hx-trigger="load" hx-swap="beforeend">
						<option value="">Pick a repository…</option>
					</select>
				</div>
				<div data-src="git git-manual" class="hidden space-y-2.5">
					<input type="text" name="git_url" placeholder="https://github.com/user/repo" class="input font-mono text-sm"/>
					<input type="text" name="git_branch" placeholder="branch (default: main)" class="input font-mono text-sm"/>
				</div>
				<input type="text" name="name" placeholder="cron job name" required class="input"/>
				<input type="text" name="cron" placeholder="0 3 * * *" title="Cron schedule: minute hour day month weekday" required class="input font-mono text-sm"/>
				<input type="text" name="command" placeholder="command (empty = image CMD)" class="input font-mono text-sm"/>
				<button type="submit" class="btn btn-primary btn-sm w-full">Create cron job</button>
			</form>

			<form hx-post={ "/projects/" + p.ID + "/apps" } data-cpane="function" class="space-y-2.5 hidden">
				<input type="hidden" name="csrf_token" value={ csrf(c) }/>
				<input type="hidden" name="from" value="canvas"/>
				<input type="hidden" name="env_id" value={ env.ID }/>
				<input type="hidden" name="kind" value="function"/>
				<input type="hidden" name="connector_id"/>
				<select name="source_type" data-create-source class="input">
					<option value="image" selected>Docker image</option>
					<option value="git">GitHub repository</option>
					<option value="git-manual">Git URL (public / manual)</option>
				</select>
				<div data-src="image">
					<input type="text" name="image_ref" placeholder="image, e.g. alpine:3" class="input font-mono text-sm"/>
				</div>
				<div data-src="git" class="hidden">
					<select data-repo-pick class="input font-mono text-sm" hx-get={ "/projects/" + p.ID + "/repos" } hx-trigger="load" hx-swap="beforeend">
						<option value="">Pick a repository…</option>
					</select>
				</div>
				<div data-src="git git-manual" class="hidden space-y-2.5">
					<input type="text" name="git_url" placeholder="https://github.com/user/repo" class="input font-mono text-sm"/>
					<input type="text" name="git_branch" placeholder="branch (default: main)" class="input font-mono text-sm"/>
				</div>
				<input type="text" name="name" placeholder="function name" required class="input"/>
				<input type="text" name="command" placeholder="command (empty = image CMD)" class="input font-mono text-sm"/>
				<label class="text-xs text-rw-muted flex items-center gap-2">
					<input type="checkbox" name="run_on_deploy" value="1"/>
					Run after each deploy (always runnable manually)
				</label>
				<button type="submit" class="btn btn-primary btn-sm w-full">Create function</button>
			</form>

			<form hx-post={ "/projects/" + p.ID + "/dbs" } data-cpane="db" class="space-y-2.5 hidden">
				<input type="hidden" name="csrf_token" value={ csrf(c) }/>
				<input type="hidden" name="from" value="canvas"/>
				<input type="hidden" name="env_id" value={ env.ID }/>
				<input type="text" name="name" placeholder="instance name" required class="input"/>
				<select name="engine" class="input">
					for _, e := range managedtiles.EngineOptions() {
						<option value={ e.Name }>{ e.Label }</option>
					}
				</select>
				<select name="scope" class="input" title="Who can provision from this instance">
					<option value="env">This environment only</option>
					<option value="stack">Shared across the stack</option>
				</select>
				<button type="submit" class="btn btn-primary btn-sm w-full">Create instance</button>
			</form>

			<form hx-post={ "/projects/" + p.ID + "/apps" } data-cpane="volume" class="space-y-2.5 hidden">
				<input type="hidden" name="csrf_token" value={ csrf(c) }/>
				<input type="hidden" name="from" value="canvas"/>
				<input type="hidden" name="env_id" value={ env.ID }/>
				<input type="hidden" name="kind" value="volume"/>
				<input type="text" name="name" placeholder="volume name" required class="input"/>
				<select name="attach_tile_id" class="input">
					<option value="">Detached (attach later)</option>
					for _, n := range g.Nodes {
						if n.Kind == graph.KindApp {
							<option value={ strings.TrimPrefix(n.ID, "app:") }>{ "attach to " + n.Name }</option>
						}
					}
				</select>
				<input type="text" name="mount_path" placeholder="/data (container path when attached)" class="input font-mono text-sm"/>
				<p class="text-xs text-rw-faint">Persistent storage that survives redeploys. One service per volume; attaching redeploys the service.</p>
				<button type="submit" class="btn btn-primary btn-sm w-full">Create volume</button>
			</form>
		</div>
	</div>
}


func csrf(c echo.Context) string {
	if v, ok := c.Get("csrf").(string); ok {
		return v
	}
	return ""
}

// emptyCanvasText: a created tile is staged, not drawn, so the plain empty
// state contradicts the click that just happened.
func emptyCanvasText(stagedCount int) string {
	if stagedCount > 0 {
		return "Nothing applied yet. Review the pending change."
	}
	return "No tiles in this environment yet."
}
