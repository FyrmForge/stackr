package project

import (
	"github.com/labstack/echo/v4"
	"github.com/FyrmForge/stackr/internal/stackrd/store/repo"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components"
)

// envLogsPage is the environment-wide combined log viewer: every tile's
// container merged into one live stream, tile-badged, filling the viewport.
templ envLogsPage(c echo.Context, p *repo.Stack, env *repo.Environment) {
	@components.ShellFull(c, p.Name + ": logs") {
		<div class="flex items-center gap-1.5 px-4 sm:px-6 py-3 border-b border-rw-border bg-rw-surface shrink-0 text-sm text-rw-muted">
			<a href={ templ.SafeURL(envURL(p, env)) } class="text-rw-muted hover:text-rw-text transition-colors" title="Back to the canvas">&larr;</a>
			<a href={ templ.SafeURL("/projects/" + p.ID) } class="hover:text-rw-text transition-colors ml-1.5">{ p.Name }</a>
			<span class="text-rw-faint">/</span>
			<a href={ templ.SafeURL(envURL(p, env)) } class="hover:text-rw-text transition-colors">{ env.Name }</a>
			<span class="text-rw-faint">/</span>
			<span class="text-rw-text">logs</span>
		</div>
		@components.LogViewFull("/envs/"+env.ID+"/logs/stream", true)
	}
}
