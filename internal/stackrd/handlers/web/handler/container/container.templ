package container

import (
	"fmt"
	"net/url"
	"strings"
	"github.com/labstack/echo/v4"
	"github.com/FyrmForge/stackr/internal/stackrd/infra/runtime"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components/form"
)

templ listPage(c echo.Context, cs []ctRow, showNode bool, unreachable []string, showStopped bool, stopped int) {
	@components.Shell(c, "Containers") {
		<h1 class="text-2xl font-semibold text-rw-text tracking-tight mb-6">Containers</h1>
		// hx-get carries the stopped filter: the poll replaces this whole
		// element, so a toggle held in the page would be wiped every 120s.
		<div
			id="containers-table"
			data-ws-room="containers"
			data-ws-refresh="containers"
			hx-get={ listURL(showStopped) }
			hx-trigger="refresh, every 120s"
			hx-select="#containers-table"
			hx-swap="outerHTML"
			class="panel overflow-x-auto"
		>
			// Every deploy leaves its predecessor behind: swarm keeps a few
			// generations of each task, so a rig deployed a handful of times
			// showed 22 rows of which 15 were corpses and the one row that
			// mattered was buried. Hidden by
			// default, never silently: the count is in the link, because an
			// exited agent or proxy row is the only place its remove button
			// lives.
			if stopped > 0 {
				<p class="px-4 py-3 text-sm text-rw-muted border-b border-rw-border">
					if showStopped {
						{ fmt.Sprint(stopped) } stopped
						<a href="/containers" class="link ml-1">hide</a>
					} else {
						{ fmt.Sprint(stopped) } stopped, not listed
						<a href="/containers?stopped=1" class="link ml-1">show</a>
					}
				</p>
			}
			// Inside the swapped region on purpose: the poll below replaces
			// #containers-table, so a banner outside it would still name a node
			// that came back minutes ago.
			if len(unreachable) > 0 {
				<p class="px-4 py-3 text-sm text-rw-warn border-b border-rw-border">
					No answer from { strings.Join(unreachable, ", ") }.
					Containers on
					if len(unreachable) == 1 {
						it are
					} else {
						them are
					}
					not listed here, and anything running there is still running. Check the
					<a href="/servers" class="link">servers page</a>.
				</p>
			}
			<table class="w-full text-sm">
				<thead>
					<tr class="text-left text-rw-faint border-b border-rw-border">
						<th class="py-3 px-4 font-medium">Name</th>
						if showNode {
							<th class="py-3 px-4 font-medium">Node</th>
						}
						<th class="py-3 px-4 font-medium">Image</th>
						<th class="py-3 px-4 font-medium">State</th>
						<th class="py-3 px-4"></th>
					</tr>
				</thead>
				<tbody>
					for _, ct := range cs {
						<tr class="border-b border-rw-border/60 last:border-0 hover:bg-rw-raised/50 transition-colors">
							<td class="py-3 px-4">
								<a href={ templ.SafeURL(ct.path("")) } class="text-rw-text hover:text-rw-accentHi transition-colors">{ ct.Name }</a>
							</td>
							if showNode {
								<td class="py-3 px-4 text-rw-muted">{ ct.NodeName }</td>
							}
							<td class="py-3 px-4 text-rw-muted">{ ct.Image }</td>
							<td class="py-3 px-4">
								@components.StatusBadge(ct.State)
							</td>
							<td class="py-3 px-4 text-right">
								<div class="flex gap-3 justify-end items-center">
									<a href={ templ.SafeURL(ct.path("/logs")) } class="link">logs</a>
									<a href={ templ.SafeURL(ct.path("/term")) } class="link">terminal</a>
									// The badge is a guard on a container the panel depends on,
									// so it applies to a running one. An exited generation of
									// the agent or the proxy cuts nothing off, and withholding
									// remove there just means every upgrade leaves a row nobody
									// can ever clear.
									if ct.System != "" && ct.State == "running" {
										<span class="text-xs px-1.5 py-0.5 rounded bg-rw-inset text-rw-faint" title={ systemTitle(ct.System) }>{ ct.System }</span>
									} else if ct.System != "" {
										<span class="text-xs px-1.5 py-0.5 rounded bg-rw-inset text-rw-faint" title={ systemTitle(ct.System) + " This one has already exited, so it is safe to remove." }>{ ct.System }</span>
										<form hx-post={ ct.path("/remove") } hx-confirm={ "Remove this stopped " + ct.System + " container? It is a previous version that has already been replaced." }>
											@form.CSRFField(c)
											<button type="submit" class="text-rw-danger hover:text-rw-text transition-colors">remove</button>
										</form>
									} else {
										if ct.State == "running" {
											<form hx-post={ ct.path("/stop") } hx-confirm="Stop this container? If it belongs to a tile, stackr will show it as offline until redeployed.">
												@form.CSRFField(c)
												<button type="submit" class="text-rw-warn hover:text-rw-text transition-colors">stop</button>
											</form>
										} else {
											<form hx-post={ ct.path("/start") }>
												@form.CSRFField(c)
												<button type="submit" class="text-rw-success hover:text-rw-text transition-colors">start</button>
											</form>
										}
										<form hx-post={ ct.path("/remove") } hx-confirm="Force-remove this container?">
											@form.CSRFField(c)
											<button type="submit" class="text-rw-danger hover:text-rw-text transition-colors">remove</button>
										</form>
									}
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ detailPage(c echo.Context, d *runtime.ContainerDetail, st runtime.ContainerStats, node string) {
	@components.Shell(c, d.Name) {
		<div class="flex items-center gap-3 mb-6">
			<a href="/containers" class="text-rw-muted hover:text-rw-text transition-colors">&larr;</a>
			<h1 class="text-2xl font-semibold text-rw-text tracking-tight">{ d.Name }</h1>
			@components.StatusBadge(d.State)
		</div>
		if d.State == "running" && st.MemBytes > 0 {
			<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
				@statCell("CPU", fmt.Sprintf("%.1f%%", st.CPUPct))
				@statCell("Memory", fmt.Sprintf("%.0f MB", float64(st.MemBytes)/(1024*1024)))
				@statCell("Net in (total)", humanBytes(st.RxBytes))
				@statCell("Net out (total)", humanBytes(st.TxBytes))
			</div>
		}
		<div class="panel p-5 space-y-3 text-sm">
			@row("Image", d.Image)
			@row("Started", d.Started)
			for _, p := range d.Ports {
				@row("Port", p)
			}
			for _, m := range d.Mounts {
				@row("Mount", m)
			}
			for _, n := range d.Networks {
				@row("Network", n)
			}
		</div>
		<div class="mt-4 flex gap-4">
			// nodeQuery, not a bare id: a container id means nothing to the
			// manager's daemon when the container is on a worker.
			<a href={ templ.SafeURL("/containers/" + d.ID + "/logs" + nodeQuery(node)) } class="link">View logs</a>
			<a href={ templ.SafeURL("/containers/" + d.ID + "/term" + nodeQuery(node)) } class="link">Open terminal</a>
		</div>
	}
}

templ row(label, value string) {
	<div class="flex gap-4">
		<span class="text-rw-faint w-24 shrink-0">{ label }</span>
		<span class="text-rw-text font-mono break-all">{ value }</span>
	</div>
}

templ logsPage(c echo.Context, d *runtime.ContainerDetail, node string) {
	@components.ShellFull(c, d.Name + " logs") {
		<div class="flex items-center gap-3 px-4 sm:px-6 py-3 border-b border-rw-border bg-rw-surface shrink-0">
			<a href="/containers" class="text-rw-muted hover:text-rw-text transition-colors">&larr;</a>
			<h1 class="text-sm font-semibold text-rw-text">{ d.Name }: logs</h1>
		</div>
		@components.LogViewFull(streamURL(d.ID, node), false)
	}
}

templ statCell(label, value string) {
	<div class="panel px-4 py-3">
		<div class="text-xs text-rw-faint mb-1">{ label }</div>
		<div class="text-sm text-rw-text font-mono">{ value }</div>
	</div>
}

// systemTitle explains why a container's stop/remove actions are withheld.
func systemTitle(role string) string {
	switch role {
	case "panel":
		return "This is the stackr panel itself. Stopping it would lock you out."
	case "agent":
		return "The node agent. Stopping it cuts this node off from the panel."
	case "registry":
		return "The image registry. Every server pulls tile images from it, so stopping it breaks the next deploy."
	}
	return "The shared Traefik proxy. Removing it would kill all routing."
}

func humanBytes(b uint64) string {
	switch {
	case b >= 1<<30:
		return fmt.Sprintf("%.1f GB", float64(b)/(1<<30))
	case b >= 1<<20:
		return fmt.Sprintf("%.1f MB", float64(b)/(1<<20))
	case b >= 1<<10:
		return fmt.Sprintf("%.1f KB", float64(b)/(1<<10))
	}
	return fmt.Sprintf("%d B", b)
}

// nodeQuery is the ?node= suffix, or nothing on a single-node install where
// the empty node correctly means "here".
func nodeQuery(node string) string {
	if node == "" {
		return ""
	}
	return "?node=" + url.QueryEscape(node)
}

// streamURL keeps the node on the log stream: the container id alone means
// nothing to the manager's own daemon when the container is on a worker.
func streamURL(id, node string) string {
	u := "/containers/" + id + "/logs/stream"
	if node != "" {
		u += "?node=" + node
	}
	return u
}

// listURL keeps the stopped filter on the poll that replaces the table.
func listURL(showStopped bool) string {
	if showStopped {
		return "/containers?stopped=1"
	}
	return "/containers"
}
