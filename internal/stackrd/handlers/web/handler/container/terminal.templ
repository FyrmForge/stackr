package container

import (
	"github.com/labstack/echo/v4"
	"github.com/FyrmForge/stackr/internal/stackrd/infra/runtime"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components"
)

templ termPage(c echo.Context, d *runtime.ContainerDetail, node string, down bool) {
	@components.Shell(c, d.Name + " terminal") {
		<link rel="stylesheet" href={ components.StaticURL("css/xterm.css") }/>
		<div class="flex items-center gap-3 mb-6">
			<a href="/containers" class="text-rw-muted hover:text-rw-text transition-colors">&larr;</a>
			<h1 class="text-xl font-semibold text-rw-text">{ d.Name }: terminal</h1>
		</div>
		if down {
			<p class="text-sm text-rw-warn">Node not answering.</p>
		} else {
			<div id="term" class="panel overflow-hidden p-2"></div>
			<script src={ components.StaticURL("js/xterm.min.js") }></script>
			@termScript(d.ID, node)
		}
	}
}

templ termScript(id, node string) {
	<script data-container-id={ id } data-node={ node }>
		(function() {
			const id = document.currentScript.dataset.containerId;
			// The node travels with the id: a container id means nothing to
			// the manager's daemon when the container is on a worker.
			const node = document.currentScript.dataset.node;
			const q = node ? '?node=' + encodeURIComponent(node) : '';
			// Literal on purpose: a terminal is black in both themes. Tying it to
			// a surface token would give a light-theme terminal a pale background
			// under output that assumes a dark one.
			const term = new Terminal({ fontSize: 14, cursorBlink: true, theme: { background: '#000000' } });
			term.open(document.getElementById('term'));
			const proto = location.protocol === 'https:' ? 'wss' : 'ws';
			const ws = new WebSocket(proto + '://' + location.host + '/containers/' + id + '/term/ws' + q);
			ws.binaryType = 'arraybuffer';
			ws.onopen = function() {
				ws.send(JSON.stringify({type: 'resize', cols: term.cols, rows: term.rows}));
			};
			ws.onmessage = function(e) { term.write(new Uint8Array(e.data)); };
			ws.onclose = function() { term.write('\r\n[disconnected]\r\n'); };
			term.onData(function(data) { ws.send(new TextEncoder().encode(data)); });
			term.onResize(function(s) { ws.send(JSON.stringify({type: 'resize', cols: s.cols, rows: s.rows})); });
			window.addEventListener('resize', function() { /* no fit addon; fixed 80x24 default */ });
		})();
	</script>
}
