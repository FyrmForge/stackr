package components

import (
	"time"

	"github.com/FyrmForge/stackr/internal/stackrd/service"
)

// MetricRange maps a picker key to its window; unknown keys fall back to 1h.
// The rule lives in the service so the panel's picker and the API's ?range=
// cannot answer differently; this stays as the name the templates call.
func MetricRange(key string) (string, time.Duration) { return service.MetricRange(key) }

// MetricsFrag is the range picker + charts; swaps itself on range change and
// auto-refreshes on a slow poll (samples land every 30s). metricsURL is the
// owning panel's fragment endpoint (e.g. "/apps/<id>/metrics").
templ MetricsFrag(metricsURL, rangeKey string, cpu, mem, rx, tx []TimePoint) {
	<div
		id="metrics-frag"
		data-ws-refresh="server"
		hx-get={ metricsURL + "?range=" + rangeKey }
		hx-trigger="refresh, every 120s"
		hx-swap="outerHTML"
	>
		<div class="flex justify-end gap-1 mb-3">
			for _, k := range []string{"1h", "6h", "24h"} {
				<button
					hx-get={ metricsURL + "?range=" + k }
					hx-target="#metrics-frag"
					hx-swap="outerHTML"
					class={ "px-2.5 py-1 rounded-md text-xs font-mono transition-colors",
						templ.KV("bg-rw-inset text-rw-text", k == rangeKey),
						templ.KV("text-rw-muted hover:text-rw-text", k != rangeKey) }
				>{ k }</button>
			}
		</div>
		<div class="grid grid-cols-1 gap-4">
			@MetricChart("CPU", "%", cpu, 100)
			@MetricChart("Memory", " MB", mem, 0)
			@MetricChart("Network in", " KB/s", rx, 0)
			@MetricChart("Network out", " KB/s", tx, 0)
		</div>
	</div>
}
