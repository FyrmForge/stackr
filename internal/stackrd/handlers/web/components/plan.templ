package components

import (
	"strings"

	"github.com/labstack/echo/v4"

	"github.com/FyrmForge/stackr/internal/stackrd/config/stackconf"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components/form"
)

// PlanBody is one review of one plan, wherever it is being reviewed: the org
// plan page, a stack's plan page, and step 3 of the onboarding wizard. They
// used to be three layouts over the same data, which meant the wizard taught
// people to read a plan one way and the settings page another.
//
// Org plans and stack plans both parse into stackconf.Plan, so the only thing
// the caller supplies is where its buttons post to.
type PlanViewCfg struct {
	Summary   string // the stored plan's one-line summary
	Commit    string
	When      string // already formatted; the caller owns the timezone
	EnvSlug   string
	EnvColor  string // envcolor CSS value for the dot before EnvSlug
	Status    string // pending | applied | rejected | error
	StoredErr string // the plan row's own error text, if it failed to build

	// ApproveURL and RejectURL are empty on a plan nobody can decide any more.
	ApproveURL string
	RejectURL  string
	// InputURL collects a declared-but-unset value: it upserts the variable,
	// re-plans, and lands back on the new plan. Empty hides the boxes, which
	// is right when the values belong to a scope this plan cannot write yet:
	// an org plan cannot set secrets for stacks it has not created.
	InputURL string
	// ReplanURL recomputes the plan from the file as it is now. A stored plan
	// goes stale the moment the repo or the org moves on, and the only other
	// way to refresh it was to re-submit the binding form.
	ReplanURL string
	// Extra is rendered next to the buttons, and on its own when the plan has
	// none (an errored plan): the wizard puts "Decide later" there, since
	// skipping is a wizard idea and not a plan one, and a screen with no way
	// forward is a dead end.
	Extra templ.Component
}

// planBlocked is why approve is disabled, or "" when it is not. A missing
// value is an input, not a fault (see stackconf.Input), so it never blocks.
func planBlocked(cfg PlanViewCfg, p *stackconf.Plan) string {
	if p != nil && len(p.Errors) > 0 {
		return "This plan has errors. Fix them in the config and plan again."
	}
	// A pinned tile whose node group has changed. The apply cannot move a
	// volume, that is a copy between two machines, so it waits until each
	// one has been moved (docs/plans/31-node-agent-open-questions.md, step 8).
	if p != nil && len(p.Moves) > 0 {
		return "Tiles below hold volumes on a node their new group does not cover. Move each one first."
	}
	// A stored error on a plan still pending is a failed apply, not a broken
	// plan: the row keeps its decision so the apply can be retried once the
	// cause is gone (a name conflict, a registry blip).
	if cfg.StoredErr != "" && cfg.Status != "pending" {
		return "This plan did not build."
	}
	return ""
}

func planDestructive(p *stackconf.Plan) bool { return p != nil && p.Destructive() }

// planConfirm names what an apply destroys, before the click.
func planConfirm(p *stackconf.Plan) string {
	if p == nil {
		return "Apply this plan?"
	}
	var dels []string
	for _, ch := range p.Changes {
		if ch.Kind == "delete" || ch.Kind == "delete-env" || ch.Destroys {
			dels = append(dels, strings.TrimSuffix(ch.Env+"/"+ch.Tile, "/"))
		}
	}
	if len(dels) == 0 {
		return "Apply this plan?"
	}
	return "This apply DESTROYS: " + strings.Join(dels, ", ") + ". Continue?"
}

func planSign(kind string) string {
	switch kind {
	case "create", "create-env":
		return "+"
	case "delete", "delete-env":
		return "-"
	}
	return "~"
}

func planSignClass(kind string) string {
	switch kind {
	case "create", "create-env":
		return "text-rw-success shrink-0 w-4"
	case "delete", "delete-env":
		return "text-rw-danger shrink-0 w-4"
	}
	return "text-rw-warning shrink-0 w-4"
}

templ PlanBody(c echo.Context, cfg PlanViewCfg, p *stackconf.Plan) {
	<div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-rw-muted mb-5">
		<span>{ cfg.Summary }</span>
		if cfg.Commit != "" {
			<span class="text-rw-faint font-mono">{ shortSHA(cfg.Commit) }</span>
		}
		if cfg.EnvSlug != "" {
			<span class="text-xs px-1.5 py-0.5 rounded bg-rw-inset text-rw-muted font-mono inline-flex items-center gap-1.5">
				@EnvDot(cfg.EnvColor, "")
				{ cfg.EnvSlug }
			</span>
		}
		if cfg.When != "" {
			<span class="text-rw-faint">{ cfg.When }</span>
		}
		if cfg.ReplanURL != "" {
			<form hx-post={ cfg.ReplanURL } class="ml-auto">
				@form.CSRFField(c)
				<input type="hidden" name="plan_only" value="1"/>
				<button type="submit" class="btn btn-ghost btn-sm">Plan again</button>
			</form>
		}
	</div>
	if cfg.StoredErr != "" {
		<div class="panel border-rw-danger/40 p-4 mb-4">
			<pre class="text-sm text-rw-danger whitespace-pre-wrap">{ cfg.StoredErr }</pre>
		</div>
	}
	if p != nil {
		for _, e := range p.Errors {
			<div class="panel border-rw-danger/40 p-3 mb-2 text-sm text-rw-danger">{ e }</div>
		}
		for _, w := range p.Warnings {
			<div class="panel border-rw-warning/40 p-3 mb-2 text-sm text-rw-warning">{ w }</div>
		}
		// Pinned tiles the file wants on a different group of nodes. Each one
		// is a copy between two machines, which no apply can do on its own, so
		// each gets the same Move modal the tile drawer and drain use
		// (docs/plans/32-multi-node-ui.md, Move modal).
		for _, m := range p.Moves {
			<div class="panel border-rw-warn/40 p-3 mb-2 flex flex-wrap items-center gap-3 text-sm">
				<span class="text-rw-text font-mono">{ m.Env }/{ m.Tile }</span>
				<span class="text-rw-muted text-xs">
					holds a volume on { m.FromNode }, and the config now asks for group
					<span class="font-mono text-rw-text">{ m.ToGroup }</span>
				</span>
				<button
					type="button"
					class="ml-auto btn btn-ghost btn-sm"
					hx-get={ "/servers/move/" + m.TileID }
					hx-target="#modal-host"
					hx-swap="innerHTML"
				>Move</button>
			</div>
		}
		if len(p.Changes) == 0 && cfg.StoredErr == "" {
			<p class="text-sm text-rw-muted">No changes. Everything already matches the config.</p>
		} else {
			<ul class="space-y-1.5">
				for _, ch := range p.Changes {
					@planChange(c, cfg, ch)
				}
			</ul>
		}
	}
	if cfg.ApproveURL != "" || cfg.RejectURL != "" || cfg.Extra != nil {
		{{ blocked := planBlocked(cfg, p) }}
		<div class="flex flex-wrap items-center gap-2 mt-6">
			if cfg.ApproveURL != "" {
				<form
					hx-post={ cfg.ApproveURL }
					if planDestructive(p) {
						hx-confirm={ planConfirm(p) }
					}
				>
					@form.CSRFField(c)
					<button type="submit" class="btn btn-primary btn-sm" disabled?={ blocked != "" }>Approve &amp; apply</button>
				</form>
			}
			if cfg.RejectURL != "" {
				<form hx-post={ cfg.RejectURL }>
					@form.CSRFField(c)
					<button type="submit" class="btn btn-ghost btn-sm">Reject</button>
				</form>
			}
			if cfg.Extra != nil {
				@cfg.Extra
			}
			if planDestructive(p) {
				<span class="text-xs text-rw-danger">destructive</span>
			}
		</div>
		if cfg.ApproveURL != "" {
			if blocked != "" {
				<p class="text-xs text-rw-danger mt-3">{ blocked }</p>
			} else {
				<p class="text-xs text-rw-faint mt-3">Applying reconciles every environment to the commit above. Moving an image up the ladder is a promote, on the releases page.</p>
			}
		}
	}
}

// planChange is one row. Rows with something to say (a note, or the fields of
// a create) open; rows without stay a plain line, so a page of one-line
// updates does not grow a column of dead arrows. The summary line is the
// diff itself, nothing else: the explanations were what made the page noisy.
templ planChange(c echo.Context, cfg PlanViewCfg, ch stackconf.Change) {
	<li class={ "panel px-4 py-2.5 text-sm", templ.KV("border-rw-danger/40", ch.Input) }>
		if len(ch.Fields) > 0 || ch.Note != "" {
			<details class="group">
				<summary class="flex flex-wrap items-center gap-2 font-mono cursor-pointer list-none [&::-webkit-details-marker]:hidden">
					<span class="text-rw-faint text-xs transition-transform group-open:rotate-90" aria-hidden="true">&#9656;</span>
					@planChangeLine(ch)
				</summary>
				<div class="mt-2.5 pl-6 space-y-2">
					if ch.Note != "" {
						<p class="text-xs text-rw-muted">{ ch.Note }</p>
					}
					if ch.Input && cfg.InputURL != "" {
						<form hx-post={ cfg.InputURL } class="flex items-end gap-2">
							@form.CSRFField(c)
							<input type="hidden" name="name" value={ ch.Field }/>
							<div class="flex-1 min-w-0">
								<label class="sr-only" for={ "plan-input-" + ch.Field }>{ ch.Field }</label>
								<input
									type="password"
									id={ "plan-input-" + ch.Field }
									name="value"
									required
									autocomplete="new-password"
									class="input"
								/>
							</div>
							<button type="submit" class="btn btn-ghost btn-sm">Set</button>
						</form>
					}
					if len(ch.Fields) > 0 {
						<dl class="grid grid-cols-[7rem_1fr] gap-x-3 gap-y-1 text-xs">
							for _, f := range ch.Fields {
								<dt class="text-rw-faint">{ f.Name }</dt>
								<dd class="text-rw-muted font-mono break-all">{ f.Value }</dd>
							}
						</dl>
					}
				</div>
			</details>
		} else {
			<div class="flex flex-wrap items-center gap-2 font-mono">
				<span class="w-3 shrink-0" aria-hidden="true"></span>
				@planChangeLine(ch)
			</div>
		}
	</li>
}

templ planChangeLine(ch stackconf.Change) {
	<span class={ planSignClass(ch.Kind) }>{ planSign(ch.Kind) }</span>
	<span class="text-rw-faint">{ ch.Env }</span>
	if ch.Tile != "" {
		<span class="text-rw-text">{ ch.Tile }</span>
	} else if ch.Kind == "create-env" || ch.Kind == "delete-env" {
		<span class="text-rw-text">(environment)</span>
	}
	if ch.Field != "" {
		<span class="text-rw-muted">{ ch.Field }</span>
	}
	if ch.Old != "" || ch.New != "" {
		<span class="text-rw-faint ml-auto truncate max-w-[50%]">
			if ch.Old != "" {
				<span class="text-rw-danger line-through">{ ch.Old }</span>
			}
			if ch.Old != "" && ch.New != "" {
				<span class="mx-1">→</span>
			}
			if ch.New == "unset" {
				// Red, not amber: this row is why a tile will not come up. It
				// still does not block the apply, see InputChange.
				<span class="text-rw-danger">{ ch.New }</span>
			} else if ch.New != "" {
				<span class="text-rw-success">{ ch.New }</span>
			}
		</span>
	}
}
