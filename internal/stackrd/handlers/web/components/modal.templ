package components

// Modal is the panel's dialog shell.
//
// Every confirm in stackr was the browser's native one (hx-confirm) until the
// node screens needed a dialog that shows two lists and takes a typed name
// (docs/plans/32-multi-node-ui.md, Drain and Remove). The existing confirms
// are left alone; they move onto this later, under the "consolidate all the
// UIs" note.
//
// State lives in the DOM and nowhere else: htmx swaps the dialog into
// #modal-host, and closing it is emptying that element. Nothing to open, so
// nothing to leave open.
templ Modal(title, subtitle string) {
	<div class="modal-backdrop" role="dialog" aria-modal="true" aria-label={ title } data-modal>
		<div class="modal-panel">
			<div class="modal-head">
				<div class="min-w-0">
					<h2 class="modal-title">{ title }</h2>
					if subtitle != "" {
						<p class="text-xs text-rw-faint mt-0.5">{ subtitle }</p>
					}
				</div>
				<button type="button" class="ml-auto text-rw-faint hover:text-rw-text transition-colors" data-modal-close aria-label="Close">
					<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
						<line x1="18" y1="6" x2="6" y2="18"></line>
						<line x1="6" y1="6" x2="18" y2="18"></line>
					</svg>
				</button>
			</div>
			{ children... }
		</div>
	</div>
}

// ModalHost is the empty element every modal is swapped into. One per page,
// in the shell.
templ ModalHost() {
	<div id="modal-host"></div>
}
