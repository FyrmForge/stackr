package components

import (
	"github.com/FyrmForge/hamr/pkg/middleware"
	"github.com/labstack/echo/v4"
)

// FlashToast renders the pending flash, if any. Reading it clears the cookie,
// so it shows exactly once.
templ FlashToast(c echo.Context) {
	if flash := middleware.GetFlash(c); flash != nil {
		@Toast(flash.Message, flash.Type)
	}
}

// Toast is the message itself: fixed, floats over the page (no layout shift),
// fades out after a few seconds, dismissible on click.
templ Toast(message string, kind middleware.FlashType) {
	<div id="flash-toast" class="fixed top-4 right-4 z-50 max-w-sm rounded-lg bg-rw-surface shadow-rw transition-opacity duration-500">
		<div class={ "rounded-lg border px-4 py-3 text-sm cursor-pointer", FlashTailwindClass(kind) }>
			{ message }
		</div>
	</div>
	<script>
		(function(){
			var f=document.getElementById('flash-toast');
			if(!f)return;
			f.addEventListener('click',function(){f.remove();});
			setTimeout(function(){f.classList.add('opacity-0');setTimeout(function(){f.remove();},500);},4000);
		})();
	</script>
}

// ToastOOB drops a toast into the page's flash slot on an htmx response. The
// cookie route (SetFlash + FlashOOB) only surfaces on the *next* request, so a
// message about the response being written right now has to go direct.
templ ToastOOB(message string, kind middleware.FlashType) {
	<div id="flash-slot" hx-swap-oob="true">
		@Toast(message, kind)
	</div>
}

// FlashOOB carries a flash on an htmx fragment response. A panel save swaps
// only its own region, so without this out-of-band swap the confirmation the
// handler set would never reach the user at the moment they saved.
templ FlashOOB(c echo.Context) {
	<div id="flash-slot" hx-swap-oob="true">
		@FlashToast(c)
	</div>
}

// WithFlash pairs a fragment with the out-of-band flash slot, so any handler
// answering an htmx request confirms in place.
templ WithFlash(c echo.Context, body templ.Component) {
	@body
	@FlashOOB(c)
}
