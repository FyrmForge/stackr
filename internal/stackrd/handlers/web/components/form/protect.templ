package form

import "github.com/FyrmForge/stackr/internal/stackrd/config/settings"

// ProtectFields is the basic-auth gate at one level of the settings cascade
// (docs/plans/48-install-domains-and-basic-auth.md). A select rather than a
// checkbox: a checkbox cannot say inherit, so saving the form would pin the
// level off over whatever the level above says.
templ ProtectFields(own settings.Settings, above settings.Resolved, disabled bool) {
	@Field("Password protect URLs", "Basic auth on every URL under this level.") {
		<select name="protect" disabled?={ disabled } class="input">
			<option value="" selected?={ own.Protect == nil }>Inherit ({ onOff(above.Protect) })</option>
			<option value="1" selected?={ own.Protect != nil && *own.Protect }>On</option>
			<option value="0" selected?={ own.Protect != nil && !*own.Protect }>Off</option>
		</select>
	}
	@Field("Protect user", "") {
		<input type="text" name="protect_user" value={ strPtr(own.ProtectUser) } placeholder={ inheritOr(above.ProtectUser) } autocomplete="off" disabled?={ disabled } class="input"/>
	}
	@Field("Protect password", passwordHint(own.ProtectPassword)) {
		<input type="password" name="protect_password" value="" placeholder={ passwordPlaceholder(own.ProtectPassword) } autocomplete="new-password" disabled?={ disabled } class="input font-mono"/>
	}
}

// The stored password is never rendered: the page would hand it to everyone
// who can open the settings screen. Blank leaves it as it is, and clearing the
// user is how a level gives both back to the one above.
func passwordHint(own *string) string {
	if own == nil {
		return "Text or a ${{ }} secret reference."
	}
	return "Set. Type a new one to replace it, or clear the user to inherit both."
}

func passwordPlaceholder(own *string) string {
	if own == nil {
		return "inherit"
	}
	return "unchanged"
}

func onOff(b bool) string {
	if b {
		return "on"
	}
	return "off"
}

func strPtr(p *string) string {
	if p == nil {
		return ""
	}
	return *p
}

func inheritOr(v string) string {
	if v == "" {
		return "inherit"
	}
	return v
}
