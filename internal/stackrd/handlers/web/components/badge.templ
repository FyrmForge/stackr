package components

// StatusBadge renders a colored status pill for app/db/deployment states.
templ StatusBadge(status string) {
	switch status {
	case "running", "done":
		<span class="inline-flex items-center gap-1.5 text-xs px-2 py-0.5 rounded-full bg-rw-success/12 text-rw-success">
			<span class="h-1.5 w-1.5 rounded-full bg-rw-success"></span>{ status }
		</span>
	case "error":
		<span class="inline-flex items-center gap-1.5 text-xs px-2 py-0.5 rounded-full bg-rw-danger/12 text-rw-danger">
			<span class="h-1.5 w-1.5 rounded-full bg-rw-danger"></span>{ status }
		</span>
	case "unhealthy":
		<span class="inline-flex items-center gap-1.5 text-xs px-2 py-0.5 rounded-full bg-rw-warn/12 text-rw-warn">
			<span class="h-1.5 w-1.5 rounded-full bg-rw-warn"></span>{ status }
		</span>
	case "queued", "building":
		<span class="inline-flex items-center gap-1.5 text-xs px-2 py-0.5 rounded-full bg-rw-warn/12 text-rw-warn">
			<span class="h-1.5 w-1.5 rounded-full bg-rw-warn"></span>{ status }
		</span>
	case "waiting_ci":
		<span class="inline-flex items-center gap-1.5 text-xs px-2 py-0.5 rounded-full bg-rw-warn/12 text-rw-warn" title="parked until the commit's checks pass">
			<span class="h-1.5 w-1.5 rounded-full bg-rw-warn"></span>waiting for CI
		</span>
	default:
		<span class="inline-flex items-center gap-1.5 text-xs px-2 py-0.5 rounded-full bg-rw-inset text-rw-muted">
			<span class="h-1.5 w-1.5 rounded-full bg-rw-faint"></span>{ status }
		</span>
	}
}
