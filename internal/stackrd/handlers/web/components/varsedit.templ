package components

import (
	"github.com/labstack/echo/v4"

	"github.com/FyrmForge/stackr/internal/stackrd/config/secrets"
	"github.com/FyrmForge/stackr/internal/stackrd/store/repo"
	"github.com/FyrmForge/stackr/internal/stackrd/handlers/web/components/form"
)

// VarsEdit is the variables editor: rows edit inline in place, and the +
// button appends one editable row at the bottom. There is no standing form,
// every action (edit, add, save, cancel, delete) is a round trip that
// re-renders the whole editor, so the markup is only ever in one state.
//
// The same component is both surfaces. In the canvas drawer it renders one
// class of one scope (the card that was clicked) and swaps into #drawer-body;
// on a settings page it renders every variable of the scope, secret flag and
// all, and swaps itself. Class == "" is what tells the two apart.
//
// Secrets render masked and their plaintext stays off the DOM: Copy fetches
// the value from ValueURL (audited server-side), and only an explicit Reveal
// or edit pre-fill puts it in the markup, both of which the server logs.
type VarsEditCfg struct {
	PostURL  string // upsert endpoint; PostURL+"/delete" removes a row
	PanelURL string // where view-state round trips go; class/edit/new ride as queries
	ValueURL string // plaintext endpoint for secret Copy; ?name=X, audited
	Class    string // "plain" | "secret" for one drawer card; "" for a whole page
	// RefScope is the scope a row is read through: "stack" or "org". An
	// environment's rows use "stack" too, they shadow the stack-wide value at
	// resolution time rather than having a scope of their own. Blank hides the
	// reference hint.
	RefScope string

	EditName   string // row currently open for inline editing ("" = none)
	EditValue  string // that row's value
	EditSecret bool   // whether that row is a secret
	RevealName string // secret row currently shown unmasked ("" = none)
	Adding     bool   // render the empty new-variable row
	CanWrite   bool
}

// query builds a round-trip URL, carrying the class so the drawer comes back
// as the same card. Page mode has no class and gets a bare query.
func (cfg VarsEditCfg) query(extra string) string {
	url := cfg.PanelURL + "?class=" + cfg.Class
	if extra != "" {
		url += "&" + extra
	}
	return url
}

// VarsEditor is the page-mode wrapper: it targets itself, so every round trip
// swaps the editor in place instead of reloading the settings page.
templ VarsEditor(c echo.Context, vars []repo.Variable, cfg VarsEditCfg) {
	<div id="vars-editor" hx-target="#vars-editor" hx-swap="outerHTML">
		@VarsEdit(c, vars, cfg)
	</div>
}

// VarsEdit renders the rows. Page mode splits them into the two namespaces a
// reference names (${{ stack.vars.X }} / ${{ stack.secrets.X }}), because a
// mixed list gives no clue which one a row is reachable under. A drawer card is
// already one namespace, so it renders a single list.
templ VarsEdit(c echo.Context, vars []repo.Variable, cfg VarsEditCfg) {
	if cfg.Class == "" {
		for _, g := range varGroups(vars) {
			<h4 class="text-xs uppercase tracking-wide text-rw-faint mb-2">{ g.Title }</h4>
			if len(g.Vars) == 0 {
				<p class="text-sm text-rw-faint mb-5">Nothing here yet.</p>
			} else {
				@varsList(c, g.Vars, cfg)
			}
		}
		if cfg.Adding {
			<ul class="space-y-2 mb-5">
				@varsEditRow(c, cfg, repo.Variable{})
			</ul>
		}
	} else if len(vars) == 0 && !cfg.Adding {
		<p class="text-sm text-rw-faint mb-5">Nothing here yet.</p>
	} else {
		@varsList(c, vars, cfg)
	}
	if cfg.CanWrite && !cfg.Adding && cfg.EditName == "" {
		<button type="button" hx-get={ cfg.query("new=1") } class="btn btn-ghost btn-sm w-full border border-dashed border-rw-border" aria-label={ "Add " + varsNoun(cfg.Class) }>
			+ Add { varsNoun(cfg.Class) }
		</button>
	}
}

templ varsList(c echo.Context, vars []repo.Variable, cfg VarsEditCfg) {
	<ul class="space-y-2 mb-5">
			for _, v := range vars {
			if cfg.CanWrite && v.Name == cfg.EditName {
					@varsEditRow(c, cfg, v)
				} else {
					<li class="panel px-3 py-2.5 flex flex-wrap items-center gap-2">
						<span class="font-mono text-sm text-rw-text">{ v.Name }</span>
						if v.Secret && v.Name != cfg.RevealName {
							<span class="font-mono text-xs text-rw-muted select-none">••••••••</span>
						} else {
							<span class="font-mono text-xs text-rw-muted truncate">{ v.Value }</span>
						}
						if cfg.Class == "" && v.Secret {
							<span class="text-[10px] px-1.5 py-0.5 rounded bg-rw-warn/15 text-rw-warn">secret</span>
						}
						if cfg.CanWrite {
							<div class="ml-auto flex items-center gap-1">
								if v.Secret && v.Name != cfg.RevealName {
									<button type="button" hx-get={ cfg.query("reveal=" + v.Name) } class="btn btn-ghost btn-sm">Reveal</button>
								} else if v.Secret {
									<button type="button" hx-get={ cfg.query("") } class="btn btn-ghost btn-sm">Hide</button>
								}
								if v.Secret {
									<button type="button" data-copy-url={ cfg.ValueURL + "?name=" + v.Name } class="btn btn-ghost btn-sm">Copy</button>
								} else {
									<button type="button" data-copy={ v.Value } class="btn btn-ghost btn-sm">Copy</button>
								}
								if ref := varRef(cfg, v); ref != "" {
									<button type="button" data-copy={ ref } title={ ref } class="btn btn-ghost btn-sm">Copy ref</button>
								}
								<button type="button" hx-get={ cfg.query("edit=" + v.Name) } class="btn btn-ghost btn-sm">Edit</button>
								<form hx-post={ cfg.PostURL + "/delete" } hx-confirm={ "Delete " + v.Name + "? Anything referencing it fails on the next deploy." }>
									@form.CSRFField(c)
									<input type="hidden" name="name" value={ v.Name }/>
									<button type="submit" class="btn btn-ghost btn-sm">Delete</button>
								</form>
							</div>
						}
					</li>
				}
			}
		if cfg.Adding && cfg.Class != "" {
			@varsEditRow(c, cfg, repo.Variable{Secret: cfg.Class == "secret"})
		}
	</ul>
}

// varsEditRow is one row in its editable state, an existing row (name fixed,
// value pre-filled and editable) or, with an empty name, the new row the +
// button added. In page mode the secret flag is a checkbox, since one page
// holds both classes; a drawer card already knows which class it is.
templ varsEditRow(c echo.Context, cfg VarsEditCfg, v repo.Variable) {
	<li class="panel px-3 py-2.5 border-rw-accent/60">
		<form hx-post={ cfg.PostURL } class="flex flex-wrap items-center gap-2">
			@form.CSRFField(c)
			<input type="hidden" name="class" value={ cfg.Class }/>
			if v.Name != "" {
				<input type="hidden" name="name" value={ v.Name }/>
				<span class="font-mono text-sm text-rw-text">{ v.Name }</span>
			} else {
				<input type="text" name="name" required placeholder="NAME" autofocus class="input font-mono flex-1 min-w-32"/>
			}
			<input
				type="text"
				name="value"
				value={ cfg.EditValue }
				placeholder="value"
				required?={ v.Secret }
				autocomplete="off"
				class="input font-mono flex-1 min-w-32"
			/>
			// Server-side: the value is minted by the same generator the config
			// file's `default: generated` uses, so a secret made here and one
			// made by an apply are the same kind of thing.
			<button type="submit" name="generate" value="1" formnovalidate class="btn btn-ghost btn-sm" title="Mint a random value">
				Generate
			</button>
			if cfg.Class == "" {
				<label class="flex items-center gap-1.5 text-xs text-rw-muted">
					<input type="checkbox" name="secret" value="1" checked?={ v.Secret }/>
					secret
				</label>
			} else if v.Secret {
				<input type="hidden" name="secret" value="1"/>
			}
			<div class="ml-auto flex items-center gap-1">
				<button type="submit" class="btn btn-primary btn-sm">Save</button>
				<button type="button" hx-get={ cfg.query("") } class="btn btn-ghost btn-sm">Cancel</button>
			</div>
		</form>
	</li>
}

// varGroup is one namespace's rows on a settings page.
type varGroup struct {
	Title string
	Vars  []repo.Variable
}

// varGroups splits a page's rows into vars and secrets, in that order. Both
// groups always render, so an empty one still shows where a row would land.
func varGroups(vars []repo.Variable) []varGroup {
	g := []varGroup{{Title: "Vars"}, {Title: "Secrets"}}
	for _, v := range vars {
		if v.Secret {
			g[1].Vars = append(g[1].Vars, v)
		} else {
			g[0].Vars = append(g[0].Vars, v)
		}
	}
	return g
}

// varRef is the expression a tile uses to read this row, "" when the caller
// did not say which scope it is rendering.
func varRef(cfg VarsEditCfg, v repo.Variable) string {
	if cfg.RefScope == "" {
		return ""
	}
	bucket := "vars"
	if v.Secret {
		bucket = "secrets"
	}
	return "${{ " + cfg.RefScope + "." + bucket + "." + v.Name + " }}"
}

func varsNoun(class string) string {
	if class == "secret" {
		return "secret"
	}
	return "variable"
}

// VarValue reads the value a variable form submitted, minting one when the
// Generate button was the submit.
//
// Server-side on purpose: it is the same generator the config file's
// `default: generated` uses (config/secrets), so a secret made by hand and one
// made by an apply are the same kind of thing, and the plaintext never has to
// come back out of the browser to be stored.
func VarValue(c echo.Context) string {
	if c.FormValue("generate") != "" {
		return secrets.Generate(generatedLength, true, false)
	}
	return c.FormValue("value")
}

// generatedLength matches the config file's default for `default: generated`.
const generatedLength = 32
