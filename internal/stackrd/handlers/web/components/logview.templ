package components

// The live log viewer: SSE follow, search, level filter, timestamp/wrap
// toggles, JSON-aware rows (static/js/logs.js drives it). multi marks merged
// environment streams whose lines carry a "tile|" prefix.
//
// LogView is the compact variant for drawer tabs; LogViewFull fills the
// remaining viewport height (use inside ShellFull), the Dozzle-style
// full-page experience. LogText is the same viewer over output that is already
// finished and stored (a cron run), with no stream behind it.

templ LogView(streamURL string, multi bool) {
	@logView(streamURL, "", multi, false)
}

templ LogViewFull(streamURL string, multi bool) {
	@logView(streamURL, "", multi, true)
}

// LogText renders stored output through the same viewer: search, level
// colouring and wrap, no SSE. The text is written into the lines element so it
// still reads without JavaScript; logs.js takes it from there.
templ LogText(text string) {
	@logView("", text, false, false)
}

templ logView(streamURL, text string, multi bool, full bool) {
	<div
		if streamURL != "" {
			data-logs-stream={ streamURL }
		}
		if text != "" {
			data-logs-text
		}
		data-logs-multi?={ multi }
		class={ "logview", templ.KV("flex flex-col flex-1 min-h-0", full) }
	>
		<div class={ "flex flex-wrap items-center gap-3",
			templ.KV("px-4 sm:px-6 py-3 border-b border-rw-border bg-rw-surface shrink-0", full),
			templ.KV("mb-2", !full) }>
			<div class={ "relative", templ.KV("flex-1 min-w-64 max-w-2xl", full) }>
				<svg class="absolute left-3 top-1/2 -translate-y-1/2 h-3.5 w-3.5 text-rw-faint pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
				<input
					type="search"
					data-logs-search
					placeholder="Filter and search logs"
					class={ "input !pl-9 !py-1.5 text-sm font-mono", templ.KV("!w-full", full), templ.KV("!w-64", !full) }
				/>
			</div>
			<select data-logs-level class="input !w-auto !py-1.5 text-xs" aria-label="Minimum level">
				<option value="-1" selected>all levels</option>
				<option value="1">info+</option>
				<option value="2">warn+</option>
				<option value="3">errors</option>
			</select>
			<label class="flex items-center gap-1.5 text-xs text-rw-muted cursor-pointer">
				<input type="checkbox" data-logs-ts checked class="accent-rw-accent"/>
				timestamps
			</label>
			<label class="flex items-center gap-1.5 text-xs text-rw-muted cursor-pointer">
				<input type="checkbox" data-logs-wrap checked class="accent-rw-accent"/>
				wrap
			</label>
			<label class="flex items-center gap-1.5 text-xs text-rw-muted cursor-pointer">
				<input type="checkbox" data-logs-follow checked class="accent-rw-accent"/>
				follow
			</label>
			<span data-logs-status class="text-xs text-rw-faint ml-auto">connecting…</span>
		</div>
		<div
			data-logs-lines
			class={ "font-mono text-xs leading-5 overflow-y-auto overflow-x-hidden whitespace-pre-wrap break-all",
				templ.KV("flex-1 min-h-0 px-4 sm:px-6 py-3", full),
				templ.KV("panel p-3 h-[65vh]", full == false && text == ""),
				templ.KV("panel p-3 max-h-64", text != "") }
		>{ text }</div>
	</div>
}
