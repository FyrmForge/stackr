package components

import (
	"encoding/json"
	"fmt"
	"strings"

	"github.com/FyrmForge/stackr/internal/stackrd/service"
)

// TimePoint is one sample on a metric chart. An alias, not a copy: the
// bucketing that produces these lives in the service now (point 19), and two
// identical structs either side of the boundary is a conversion loop waiting
// to be written.
type TimePoint = service.TimePoint

// Chart geometry: fixed viewBox so gridlines/labels stay crisp; the svg
// scales to its container width preserving aspect. Mirrored in metrics.js
// for the hover crosshair, keep in sync.
const (
	chartW  = 640.0
	chartH  = 240.0
	plotX0  = 46.0
	plotX1  = 632.0
	plotY0  = 10.0
	plotY1  = 200.0
	axisY   = 226.0 // x-axis label baseline
	tickLbl = 3     // interior x labels (plus first and last)
)

// MetricChart renders one metric as a proper line chart: real y scale,
// recessive quarter gridlines, y/x axis labels, and current/avg/peak header
// stats. fixedMax pins the scale (e.g. 100 for CPU %); 0 = scale to data.
// Hovering shows a crosshair + tooltip (static/js/metrics.js).
templ MetricChart(label string, unit string, pts []TimePoint, fixedMax float64) {
	<div class="panel p-4">
		<div class="flex items-baseline justify-between gap-3 mb-3">
			<span class="text-sm text-rw-muted">{ label }</span>
			if len(pts) > 0 {
				<span class="flex items-baseline gap-3 font-mono text-xs">
					<span class="text-rw-text text-sm">{ fmtVal(pts[len(pts)-1].V) + unit }</span>
					<span class="text-rw-faint">avg { fmtVal(avgOf(pts)) + unit }</span>
					<span class="text-rw-faint">peak { fmtVal(peakOf(pts)) + unit }</span>
				</span>
			}
		</div>
		if len(pts) < 2 {
			<p class="text-xs text-rw-faint">Collecting data…</p>
		} else {
			<div class="relative" data-chart data-unit={ unit } data-points={ chartPointsJSON(pts, fixedMax) }>
				<svg viewBox={ fmt.Sprintf("0 0 %.0f %.0f", chartW, chartH) } class="w-full block">
					for _, q := range []float64{0, 0.25, 0.5, 0.75, 1} {
						<line
							x1={ fmt.Sprintf("%.0f", plotX0) } x2={ fmt.Sprintf("%.0f", plotX1) }
							y1={ fmt.Sprintf("%.1f", yFor(q)) } y2={ fmt.Sprintf("%.1f", yFor(q)) }
							stroke="currentColor" class="text-rw-border" stroke-width="1"
							if q != 0 {
								stroke-dasharray="2 4"
							}
						></line>
					}
					for _, q := range []float64{0, 0.5, 1} {
						<text
							x={ fmt.Sprintf("%.0f", plotX0-8) } y={ fmt.Sprintf("%.1f", yFor(q)+3) }
							text-anchor="end" class="fill-rw-faint" font-size="11" font-family="monospace"
						>{ axisVal(scaleMax(pts, fixedMax) * q) }</text>
					}
					for i, t := range timeTicks(pts) {
						<text
							x={ fmt.Sprintf("%.1f", plotX0+(plotX1-plotX0)*float64(i)/float64(tickLbl+1)) }
							y={ fmt.Sprintf("%.0f", axisY) }
							text-anchor={ tickAnchor(i) } class="fill-rw-faint" font-size="11" font-family="monospace"
						>{ t }</text>
					}
					<polyline
						points={ chartPoints(pts, fixedMax) }
						fill="none" stroke="currentColor" stroke-width="2"
						stroke-linejoin="round" stroke-linecap="round" class="text-rw-accentHi"
					></polyline>
				</svg>
				<div data-crosshair class="hidden absolute top-0 w-px bg-rw-strong pointer-events-none"></div>
				<div data-dot class="hidden absolute h-2 w-2 -ml-1 -mt-1 rounded-full bg-rw-accentHi pointer-events-none"></div>
				<div data-tooltip class="hidden absolute panel px-2.5 py-1.5 text-xs font-mono whitespace-nowrap pointer-events-none z-10 shadow-rw"></div>
			</div>
		}
	</div>
}

func yFor(q float64) float64 { return plotY1 - q*(plotY1-plotY0) }

func avgOf(pts []TimePoint) float64 {
	if len(pts) == 0 {
		return 0
	}
	s := 0.0
	for _, p := range pts {
		s += p.V
	}
	return s / float64(len(pts))
}

func peakOf(pts []TimePoint) float64 {
	m := 0.0
	for _, p := range pts {
		if p.V > m {
			m = p.V
		}
	}
	return m
}

// scaleMax picks the y-axis top: the pinned scale (grown only if data
// exceeds it, e.g. multi-core CPU >100%), or a 1-2-5 nice ceiling above the
// peak so the line doesn't kiss the frame.
func scaleMax(pts []TimePoint, fixedMax float64) float64 {
	peak := peakOf(pts)
	if fixedMax > 0 {
		if peak > fixedMax {
			return niceCeil(peak)
		}
		return fixedMax
	}
	return niceCeil(peak * 1.15)
}

func niceCeil(v float64) float64 {
	if v <= 0 {
		return 1
	}
	mag := 1.0
	for mag*10 <= v {
		mag *= 10
	}
	for _, m := range []float64{1, 2, 5, 10} {
		if v <= m*mag {
			return m * mag
		}
	}
	return 10 * mag
}

// Deliberately no extra precision for tiny values. Round 7 added a two
// significant figure branch below 0.05, aimed at a ping chart reading
// "0.0 ms", and round 8 found it printing an idle container's CPU as
// "2.5e-05%" on the tile Metrics tab. It was
// never the fix anyway: that chart was reading the wrong column, and a
// readout of "0.0" for a value four orders of magnitude below the axis is
// the honest answer.
func fmtVal(v float64) string {
	if v >= 100 {
		return fmt.Sprintf("%.0f", v)
	}
	return fmt.Sprintf("%.1f", v)
}

func axisVal(v float64) string {
	if v == float64(int64(v)) {
		return fmt.Sprintf("%.0f", v)
	}
	return fmt.Sprintf("%.1f", v)
}

func tickAnchor(i int) string {
	switch i {
	case 0:
		return "start"
	case tickLbl + 1:
		return "end"
	}
	return "middle"
}

// timeTicks returns tickLbl+2 evenly spaced HH:MM labels across the range.
func timeTicks(pts []TimePoint) []string {
	n := len(pts)
	out := make([]string, 0, tickLbl+2)
	for i := 0; i <= tickLbl+1; i++ {
		idx := i * (n - 1) / (tickLbl + 1)
		out = append(out, pts[idx].T.Local().Format("15:04"))
	}
	return out
}

func chartPoints(pts []TimePoint, fixedMax float64) string {
	max := scaleMax(pts, fixedMax)
	var b strings.Builder
	n := len(pts)
	for i, p := range pts {
		x := plotX0 + float64(i)/float64(n-1)*(plotX1-plotX0)
		y := plotY1 - (p.V/max)*(plotY1-plotY0)
		fmt.Fprintf(&b, "%.1f,%.1f ", x, y)
	}
	return strings.TrimSpace(b.String())
}

// chartPointsJSON feeds the hover layer: per point the x/y as fractions of
// the viewBox, plus display time and value.
func chartPointsJSON(pts []TimePoint, fixedMax float64) string {
	max := scaleMax(pts, fixedMax)
	type jp struct {
		X float64 `json:"x"`
		Y float64 `json:"y"`
		T string  `json:"t"`
		V string  `json:"v"`
	}
	n := len(pts)
	out := make([]jp, 0, n)
	for i, p := range pts {
		out = append(out, jp{
			X: (plotX0 + float64(i)/float64(n-1)*(plotX1-plotX0)) / chartW,
			Y: (plotY1 - (p.V/max)*(plotY1-plotY0)) / chartH,
			T: p.T.Local().Format("Jan 2 15:04"),
			V: fmtVal(p.V),
		})
	}
	j, _ := json.Marshal(out)
	return string(j)
}
