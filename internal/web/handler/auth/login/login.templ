package login

import (
	"github.com/labstack/echo/v4"
	"github.com/FyrmForge/stackr/internal/web/components"
	"github.com/FyrmForge/stackr/internal/web/components/form"
)

templ loginPage(c echo.Context, f LoginForm, errors map[string]string) {
	@components.Layout(c, "Log In") {
		<div class="max-w-md mx-auto mt-16 bg-slate-800 border border-slate-700 rounded-lg p-8">
			<h2 class="text-2xl font-bold text-slate-100 mb-6 text-center">Log In</h2>
			@loginForm(c, f, errors)
		</div>
	}
}

templ loginForm(c echo.Context, f LoginForm, errors map[string]string) {
	<form
		id="login-form"
		hx-post="/login"
		hx-swap="outerHTML"
		hx-target="#login-form"
		method="POST"
		action="/login"
	>
		@form.CSRFField(c)
		if form.GetError(errors, "general") != "" {
			<div class="mb-4 px-4 py-3 rounded-md border bg-red-900/50 border-red-700 text-red-300 text-sm">
				{ form.GetError(errors, "general") }
			</div>
		}
		<div class="mb-6">
			<label for="email" class="block text-sm font-medium text-slate-400 mb-1">Email</label>
			<input
				type="email"
				id="email"
				name="email"
				value={ f.Email }
				class="w-full px-4 py-2 bg-slate-700 border border-slate-600 rounded-md text-slate-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20"
				hx-post="/login/validate/email"
				hx-trigger="blur, hamr:revalidate"
				hx-swap="none"
			/>
			@form.FieldError("email", form.GetError(errors, "email"))
		</div>
		<div class="mb-6">
			<label for="password" class="block text-sm font-medium text-slate-400 mb-1">Password</label>
			<input
				type="password"
				id="password"
				name="password"
				class="w-full px-4 py-2 bg-slate-700 border border-slate-600 rounded-md text-slate-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20"
				hx-post="/login/validate/password"
				hx-trigger="blur, hamr:revalidate"
				hx-swap="none"
			/>
			@form.FieldError("password", form.GetError(errors, "password"))
		</div>
		<button type="submit" class="w-full py-2 px-4 bg-blue-500 hover:bg-blue-400 text-white font-medium rounded-md transition-colors">Log In</button>
	</form>
}
