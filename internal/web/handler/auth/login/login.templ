package login

import (
	"net/url"

	c "github.com/FyrmForge/stackr/internal/ui/components"
)

// withNext carries a login's way back to a sibling page's link.
func withNext(path, next string) string {
	if next == "" {
		return path
	}
	return path + "?next=" + url.QueryEscape(next)
}

templ loginPage(f LoginForm, errors map[string]string) {
	@c.AuthCard("Log in to your account", nil) {
		@loginForm(f, errors)
		<p class="text-sm text-rw-muted text-center">No account? <a class="link" href={ templ.SafeURL(withNext("/register", f.Next)) }>Register</a></p>
	}
}

templ loginForm(f LoginForm, errors map[string]string) {
	@c.Form("login-form", "/login") {
		@c.FormError(errors["general"])
		<input type="hidden" name="next" value={ f.Next }/>
		@c.Field(c.FieldView{Name: "email", Label: "Email", Type: "email", Value: f.Email, Required: true, Error: errors["email"], ValidateURL: "/login/validate/email"})
		@c.Field(c.FieldView{Name: "password", Label: "Password", Type: "password", Required: true, Error: errors["password"], ValidateURL: "/login/validate/password"})
		@c.Submit("Log in")
	}
}
