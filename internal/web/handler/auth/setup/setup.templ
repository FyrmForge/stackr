package setup

import (
	c "github.com/FyrmForge/stackr/internal/ui/components"
	"github.com/FyrmForge/stackr/internal/ui/dialog"
)

// View is the first-run page: the signed-in user has no org yet. An admin
// names the first one (the home canvas's create form); anyone else is told
// how to get in.
type View struct {
	Create *dialog.CreateLevelView // nil = may not create an org
}

templ page(v View) {
	if v.Create != nil {
		@c.AuthCard("Set up stackr", c.Text("You are this server's admin. Name the first organization: stacks, environments and tiles live in it.")) {
			@dialog.CreateLevel(*v.Create)
		}
	} else {
		@c.AuthCard("Set up stackr", nil) {
			<p class="text-sm text-rw-muted text-center">You are not in an organization yet. Ask an organization owner for an invite link.</p>
		}
	}
}
