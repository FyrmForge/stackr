package invite

import c "github.com/FyrmForge/stackr/internal/ui/components"

// View is one invite link. Gone = used, expired or never was. A signed-in
// viewer accepts with one button; a visitor registers here (the invite's
// email filled in) or logs in and comes back.
type View struct {
	Base   string // /invite/<token>
	Gone   bool
	Role   string
	Email  string
	Signed bool
	Form   Form
}

type Form struct {
	Name, Email string
	Errors      map[string]string
}

templ page(v View) {
	@c.AuthCard("Join an org") {
		if v.Gone {
			<p class="text-sm">This invite link is used or expired. Ask the org owner for a new one.</p>
		} else {
			<p class="text-sm">You are invited as <strong>{ v.Role }</strong> ({ v.Email }).</p>
			if v.Signed {
				@accept(v.Base, "")
			} else {
				@register(v.Base, v.Form)
				<p class="text-sm text-slate-500">Have an account? <a class="link" href={ templ.SafeURL("/login?next=" + v.Base) }>Log in</a> and open this link again.</p>
			}
		}
	}
}

templ accept(base, err string) {
	@c.Form("invite-accept", base) {
		@c.FormError(err)
		@c.Submit("Accept")
	}
}

templ register(base string, f Form) {
	@c.Form("invite-register", base+"/register") {
		@c.FormError(f.Errors["general"])
		@c.Field(c.FieldView{Name: "name", Label: "Name", Value: f.Name, Required: true, Error: f.Errors["name"]})
		@c.Field(c.FieldView{Name: "email", Label: "Email", Type: "email", Value: f.Email, Required: true, Error: f.Errors["email"]})
		@c.Field(c.FieldView{Name: "password", Label: "Password", Type: "password", Required: true, Error: f.Errors["password"]})
		@c.Submit("Register and join")
	}
}
