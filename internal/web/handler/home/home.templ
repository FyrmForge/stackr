package home

import (
	"github.com/labstack/echo/v4"
	"github.com/FyrmForge/stackr/internal/web/components"
)

templ homePage(c echo.Context) {
	@components.Layout(c, "Home") {
		<main class="max-w-4xl mx-auto px-6 py-16 text-center">
			<h1 class="text-4xl font-bold text-hamr-metal-steel mb-4">stackr</h1>
			<p class="text-lg text-hamr-metal-light max-w-xl mx-auto">Your HAMR project is up and running.</p>
			<div class="mt-8">
				<code class="inline-block bg-hamr-metal-mid border border-hamr-metal-light/20 rounded-md px-6 py-2 font-mono text-sm text-hamr-fire-glow">hamr dev</code>
			</div>
		</main>
	}
}
