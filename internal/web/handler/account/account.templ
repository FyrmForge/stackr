package account

import c "github.com/FyrmForge/stackr/internal/ui/components"

// PageView is v0's account settings: a nav beside one tab (profile, keys
// or appearance).
type PageView struct {
	Tab   string // profile | keys | appearance
	Name  string
	Email string
	Theme string // system | light | dark
	Pw    PasswordView
	Keys  KeysView
}

// PasswordView is the change-password form; Done says it worked.
type PasswordView struct {
	Errors map[string]string
	Done   bool
}

// KeysView is the caller's API keys across orgs. Minting stays in each
// org's drawer (a key is bound to one org); here a key is only revoked.
type KeysView struct {
	Rows  []Key
	Error string
}

type Key struct{ ID, Name, Org, Created string }

var tabs = []struct{ Key, Label, Sub string }{
	{"profile", "Profile", "Your details and sign-in credentials."},
	{"keys", "API keys", "Programmatic access for the CLI and CI."},
	{"appearance", "Appearance", "How stackr looks for you."},
}

// themes are v0's three choices, in its order and words.
var themes = []struct{ Value, Label string }{
	{"system", "Match my system"},
	{"light", "Light"},
	{"dark", "Dark"},
}

func sub(tab string) string {
	for _, t := range tabs {
		if t.Key == tab {
			return t.Sub
		}
	}
	return ""
}

func navClass(on bool) string {
	if on {
		return "settings-nav-item is-active"
	}
	return "settings-nav-item"
}

templ page(v PageView) {
	<div class="page">
		<h1 class="text-2xl font-semibold text-rw-text tracking-tight">Account</h1>
		<p class="text-sm text-rw-muted mt-1 mb-8">{ sub(v.Tab) }</p>
		<div class="settings-layout">
			<nav class="settings-nav" aria-label="Account settings">
				for _, t := range tabs {
					<a href={ templ.SafeURL("/account?tab=" + t.Key) } class={ navClass(t.Key == v.Tab) } aria-current?={ t.Key == v.Tab }>{ t.Label }</a>
				}
			</nav>
			<div class="settings-body">
				if v.Tab == "appearance" {
					@c.Section("Theme", "you", "Applies wherever you sign in.") {
						@appearance(v.Theme)
					}
				} else if v.Tab == "keys" {
					@c.Section("Your keys", "you", "Mint a key from an organization's drawer (keys tab) or with stackr login. A key is bound to that organization.") {
						@keyList(v.Keys)
					}
				} else {
					@c.Section("Profile", "you", "How you appear in this install. Your email is also your sign-in identifier.") {
						<div class="space-y-4">
							<div>
								<span class="label">Avatar</span>
								<span class="flex items-center justify-center rounded bg-rw-inset font-bold uppercase text-rw-accentHi h-12 w-12 text-sm" aria-hidden="true">{ c.Initials(nameOr(v.Name, v.Email)) }</span>
							</div>
							@c.Field(c.FieldView{Name: "display_name", Label: "Display name", Value: v.Name, Disabled: true, Why: "Set when the account was created; it can not be changed here yet."})
							@c.Field(c.FieldView{Name: "email", Label: "Email", Type: "email", Value: v.Email, Disabled: true, Why: "Your sign-in identifier; it can not be changed here yet."})
						</div>
					}
					@c.Section("Password", "you", "Changing your password does not sign out your other sessions.") {
						@password(v.Pw)
					}
				}
			</div>
		</div>
	</div>
}

func nameOr(name, email string) string {
	if name != "" {
		return name
	}
	return email
}

templ password(v PasswordView) {
	@c.Form("account-password", "/account/password") {
		@c.FormError(v.Errors["general"])
		if v.Done {
			<p class="text-sm text-rw-success" role="status">Password changed.</p>
		}
		@c.Field(c.FieldView{Name: "current_password", Label: "Current password", Type: "password", Required: true, Error: v.Errors["current_password"]})
		@c.Field(c.FieldView{Name: "password", Label: "New password", Type: "password", Required: true, Error: v.Errors["password"],
			Help: "At least 8 characters with upper and lower case, a number and a symbol."})
		@c.Field(c.FieldView{Name: "confirm_password", Label: "Confirm new password", Type: "password", Required: true, Error: v.Errors["confirm_password"]})
		<button type="submit" class="btn btn-primary btn-sm">Change password</button>
	}
}

// appearance is v0's theme radio. Saving reloads the page (the handler
// redirects), the only way the <html> class changes.
templ appearance(theme string) {
	<form hx-post="/account/appearance" class="space-y-4">
		<div class="space-y-2" role="radiogroup" aria-label="Theme">
			for _, o := range themes {
				<label class="flex items-center gap-2 text-sm text-rw-muted cursor-pointer">
					<input type="radio" name="theme" value={ o.Value } checked?={ theme == o.Value } class="accent-rw-accent"/>
					{ o.Label }
				</label>
			}
		</div>
		<button type="submit" class="btn btn-primary btn-sm">Save</button>
	</form>
}

templ keyList(v KeysView) {
	<div id="account-keys" class="space-y-2">
		@c.FormError(v.Error)
		if len(v.Rows) == 0 {
			<p class="text-sm text-rw-muted">No API keys yet.</p>
		} else {
			<ul class="space-y-2">
				for _, k := range v.Rows {
					<li class="panel px-4 py-3 flex flex-wrap items-center gap-3">
						<span class="min-w-0 flex-1">
							<span class="block text-sm text-rw-text">{ k.Name }</span>
							<span class="block text-xs text-rw-faint">{ k.Org } · created { k.Created }</span>
						</span>
						@c.Confirm(c.ConfirmView{
							Button:  "Revoke",
							Title:   "Revoke " + k.Name + "?",
							Warning: "Anything using this key stops working at once.",
							Action:  "/account/keys/" + k.ID + "/revoke",
							Target:  "#account-keys",
						})
					</li>
				}
			</ul>
		}
	</div>
}
