package components

import (
	"net/http"
	"strconv"
)

// ErrorPage returns a templ component that renders an error page.
// This satisfies the middleware.ErrorPage signature.
func ErrorPage(code int, message string) templ.Component {
	return errorPage(code, message)
}

// The nil context is deliberate: middleware.ErrorPages renders this from a
// func(code int, message string) — there is no request to hand down. hamr's
// ctx.Get tolerates a nil context, so Layout's flash/subject lookups return
// their zero values rather than panicking.
templ errorPage(code int, message string) {
	@Layout(nil, http.StatusText(code)) {
		<div class="max-w-lg mx-auto mt-16 text-center p-8 bg-hamr-metal-mid border border-hamr-metal-light/20 rounded-lg">
			<h2 class="text-5xl font-bold text-hamr-metal-steel mb-2">{ strconv.Itoa(code) }</h2>
			<p class="text-hamr-metal-light">{ message }</p>
		</div>
	}
}
