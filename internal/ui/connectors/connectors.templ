// Package connectors is the Connectors tab, the same in Admin, the org
// drawer and the setup wizard's Certificates step: a list of registered
// connectors, the guided add dialog and each connector's settings dialog.
// The dialogs land in the Slot, open, on a native <dialog> driven by
// <confirm-dialog> (its [data-step] Back and Next).
package connectors

import (
	"strconv"
	"strings"

	c "github.com/FyrmForge/stackr/internal/ui/components"
)

// Ids the dialogs swap: one dialog is open at a time.
const (
	ListID   = "connectors-list"
	SlotID   = "connector-modal"
	dialogID = "connector-dialog"
	BodyID   = "connector-dialog-body"
)

// ListView is the list. Add "" = may not add one.
type ListView struct {
	Title, Scope, Help string
	Add                string // GET the add dialog into the Slot
	AddLabel           string // "" = "+ Add connector"
	Rows               []Row
	Synced             string          // the last DNS records sync's failure, "" = fine
	Foot               templ.Component // under the list, refreshed with it (the wizard's Continue)
}

// Row is one connector, a card: Kind as its title, Name under it, a status
// pill right. Actions are its own buttons (Settings opens its dialog into
// the Slot; Drawer instead opens a drawer, an org's git connector has its
// own), Link a page at the provider, Remove apart on the right. Status is
// its last check gone wrong ("" = fine); Hook where the provider delivers
// events.
type Row struct {
	ID, Kind, Name, Summary string
	Check                   string // POST answering an install-status chip as the row loads
	Pending                 bool
	Status                  string
	Detail                  string
	Hook                    string
	Link, LinkLabel         string
	Settings                string
	Drawer, Push            string // GET into #drawer-body, and the URL it pushes
	Actions                 []Action
	Remove                  c.ConfirmView // Action "" = none
}

// Action is a button on a card: GET URL into the Slot, or with Drawer into
// #drawer-body pushing Push.
type Action struct {
	Label, URL string
	Drawer     bool
	Push       string
}

// short is a webhook URL as a card shows it: no scheme, the middle cut.
func short(u string) string {
	if _, rest, ok := strings.Cut(u, "://"); ok {
		u = rest
	}
	if r := []rune(u); len(r) > 36 {
		return string(r[:22]) + "…" + string(r[len(r)-10:])
	}
	return u
}

func addLabel(v ListView) string {
	if v.AddLabel != "" {
		return v.AddLabel
	}
	return "+ Add connector"
}

// Tab is the list and the dialog slot (outside the list: a refresh of the
// list keeps the slot). Open fills the slot on arrival.
templ Tab(v ListView, open templ.Component) {
	<div id="tab-connectors">
		@List(v)
		@Slot(open)
	</div>
}

templ Slot(open templ.Component) {
	<div id={ SlotID }>
		if open != nil {
			@open
		}
	</div>
}

templ List(v ListView) {
	<div id={ ListID }>
		if v.Add != "" {
			<div class="flex justify-end mb-3">
				<button type="button" class="btn btn-primary btn-sm" hx-get={ v.Add } hx-target={ "#" + SlotID }>{ addLabel(v) }</button>
			</div>
		}
		@c.Section(v.Title, v.Scope, v.Help) {
			if v.Synced != "" {
				<div class="banner banner-danger mb-3 text-sm" role="alert">
					<p>DNS records are out of date. stackr tries again on the next change.</p>
					<p class="mt-1 font-mono text-xs break-all">{ v.Synced }</p>
				</div>
			}
			if len(v.Rows) == 0 {
				<p class="text-sm text-rw-faint mb-4">No connectors yet.</p>
			} else {
				<ul class="space-y-3 mb-4">
					for _, r := range v.Rows {
						@row(r)
					}
				</ul>
			}
		}
		if v.Foot != nil {
			@v.Foot
		}
	</div>
}

templ row(r Row) {
	<li class="rounded-lg border border-rw-border p-4 text-sm space-y-2">
		<div class="flex flex-wrap items-center gap-x-3 gap-y-1">
			<div class="min-w-0">
				<p class="font-medium text-rw-text">{ r.Kind }</p>
				<p class="text-xs text-rw-muted break-all">{ r.Name }</p>
			</div>
			<span class="ml-auto flex items-center gap-2">
				if r.Summary != "" {
					<span class="text-xs text-rw-faint">{ r.Summary }</span>
				}
				if r.Pending {
					@c.Chip("pending", "warn")
				} else if r.Status != "" {
					@c.Chip("not working", "danger")
				} else if r.Check != "" {
					<span hx-post={ r.Check } hx-trigger="load" hx-swap="outerHTML" aria-busy="true" class="text-xs text-rw-faint">checking…</span>
				} else {
					@c.Chip("connected", "success")
				}
			</span>
		</div>
		if r.Detail != "" {
			<p class="font-mono text-xs text-rw-faint break-all">{ r.Detail }</p>
		}
		if r.Hook != "" {
			<p class="flex items-center gap-2 text-xs text-rw-faint">
				<span>Webhook</span>
				<span class="font-mono" title={ r.Hook }>{ short(r.Hook) }</span>
				<button type="button" data-copy={ r.Hook } class="btn btn-ghost btn-sm">Copy</button>
			</p>
		}
		<div class="flex flex-wrap items-center gap-2">
			if r.Link != "" {
				<a href={ templ.SafeURL(r.Link) } target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm">{ r.LinkLabel }</a>
			}
			for _, a := range r.Actions {
				if a.Drawer {
					<button type="button" class="btn btn-ghost btn-sm" hx-get={ a.URL } hx-target="#drawer-body" hx-push-url={ a.Push }>{ a.Label }</button>
				} else {
					<button type="button" class="btn btn-ghost btn-sm" hx-get={ a.URL } hx-target={ "#" + SlotID }>{ a.Label }</button>
				}
			}
			if len(r.Actions) == 0 && r.Settings != "" {
				<button type="button" class="btn btn-ghost btn-sm" hx-get={ r.Settings } hx-target={ "#" + SlotID }>Settings</button>
			} else if len(r.Actions) == 0 && r.Drawer != "" {
				<button type="button" class="btn btn-ghost btn-sm" hx-get={ r.Drawer } hx-target="#drawer-body" hx-push-url={ r.Push }>Manage</button>
			}
			if r.Remove.Action != "" {
				<span class="ml-auto">
					@c.Confirm(r.Remove)
				</span>
			}
		</div>
	</li>
}

// Modal is a connector dialog, open as it lands in the Slot. Refresh, if
// set, is fetched as it closes, its list swapped over the one behind.
templ Modal(title, refresh string, body templ.Component) {
	<confirm-dialog open>
		<dialog id={ dialogID } class="modal-panel modal-tall text-rw-text" aria-labelledby={ dialogID + "-title" }>
			<div class="modal-head">
				<div class="min-w-0">
					<h2 id={ dialogID + "-title" } class="modal-title">{ title }</h2>
				</div>
				<button type="button" class="ml-auto text-rw-faint hover:text-rw-text transition-colors" data-cancel aria-label="Close">
					<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<line x1="18" y1="6" x2="6" y2="18"></line>
						<line x1="6" y1="6" x2="18" y2="18"></line>
					</svg>
				</button>
			</div>
			@body
		</dialog>
	</confirm-dialog>
	if refresh != "" {
		<span hidden hx-get={ refresh } hx-trigger={ "close from:#" + dialogID } hx-select={ "#" + ListID } hx-target={ "#" + ListID } hx-swap="outerHTML"></span>
	}
}

// Kind is one entry of the picker: Cloudflare or a custom connector is one
// more.
type Kind struct{ Name, Hint, URL string }

// Picker is the add dialog's first screen: which kind.
templ Picker(kinds []Kind) {
	<div id={ BodyID }>
		<div class="modal-body">
			<p>Pick what to connect.</p>
			<ul class="space-y-2">
				for _, k := range kinds {
					<li>
						<button type="button" class="w-full text-left rounded-lg border border-rw-border px-4 py-3 hover:border-rw-accent transition-colors" hx-get={ k.URL } hx-target={ "#" + BodyID } hx-swap="outerHTML">
							<span class="block text-rw-text font-medium">{ k.Name }</span>
							<span class="block text-xs text-rw-faint">{ k.Hint }</span>
						</button>
					</li>
				}
			</ul>
		</div>
		<div class="modal-foot">
			<button type="button" class="btn btn-ghost btn-sm" data-cancel>Cancel</button>
		</div>
	</div>
}

// steps is a kind's stepper, at the 1-based step.
templ steps(names []string, at int) {
	<nav aria-label={ "Step " + strconv.Itoa(at) + " of " + strconv.Itoa(len(names)) }>
		<ol class="flex items-center gap-2 text-xs">
			for i, n := range names {
				<li
					class={ "flex items-center gap-1.5", templ.KV("text-rw-text font-medium", i+1 == at), templ.KV("text-rw-faint", i+1 != at) }
					if i+1 == at {
						aria-current="step"
					}
				>
					<span class={ "h-5 w-5 shrink-0 rounded-full flex items-center justify-center text-[11px]", templ.KV("bg-rw-accent text-white", i+1 == at), templ.KV("border border-rw-border", i+1 != at) } aria-hidden="true">{ strconv.Itoa(i + 1) }</span>
					<span class={ templ.KV("hidden sm:inline", i+1 != at) }>{ n }</span>
				</li>
			}
		</ol>
	</nav>
}

// back is the button to the screen before: a server screen (url) or, with
// url "", the step before in this form.
templ back(url string) {
	if url != "" {
		<button type="button" class="btn btn-ghost btn-sm mr-auto" hx-get={ url } hx-target={ "#" + BodyID } hx-swap="outerHTML">Back</button>
	} else {
		<button type="button" class="btn btn-ghost btn-sm mr-auto" data-back>Back</button>
	}
}

