package cluster

import (
	"strconv"

	"github.com/FyrmForge/stackr/internal/ui/graph"
)

// Page is the Cluster page: its own bar (the shell's top bar shows only
// where the URL has crumbs), then #graph, which holds the canvas and swaps
// its inside on a timer. The swap waits while someone is typing in a note.
templ Page(v graph.View, m Map) {
	<div class="flex flex-wrap items-center gap-x-3 gap-y-2 px-4 sm:px-6 py-3 min-h-14 border-b border-rw-border bg-rw-surface shrink-0">
		<h1 class="text-lg font-semibold text-rw-text tracking-tight">Cluster</h1>
		<span class="text-xs text-rw-faint">{ Subtitle(m) }</span>
		if len(v.Create) > 0 {
			<div class="ml-auto flex items-center gap-2">
				@graph.Actions(v.Create)
			</div>
		}
	</div>
	<div
		id="graph"
		class="flex min-h-0 flex-1 flex-col"
		hx-get={ Base + "/map" }
		hx-trigger="every 15s"
		hx-swap="innerHTML"
	>
		@graph.Canvas(v)
	</div>
}

// netLayer is everything behind the cards, in world coordinates under the
// canvas's own pan and zoom (svg[data-net], graph.css).
templ netLayer(s Shape) {
	<svg data-net data-extent={ itoa(s.X) + " " + itoa(s.Y) + " " + itoa(s.W) + " " + itoa(s.H) } aria-hidden="true">
		<defs>
			<marker id="cluster-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
				<path d="M0,0 L10,5 L0,10 z" fill="rgb(var(--rw-accent))"></path>
			</marker>
			<marker id="cluster-arrow-faint" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
				<path d="M0,0 L10,5 L0,10 z" fill="rgb(var(--rw-faint))"></path>
			</marker>
		</defs>
		for _, b := range s.Boxes {
			<rect x={ itoa(b.X) } y={ itoa(b.Y) } width={ itoa(b.W) } height={ itoa(b.H) } rx="16" fill="rgb(var(--rw-inset) / .45)" stroke="rgb(var(--rw-strong))" stroke-width="1" stroke-dasharray="2 4"></rect>
		}
		for _, t := range s.Tunnels {
			<path d={ t.D } fill="none" stroke="rgb(var(--rw-muted))" stroke-width="1.6" stroke-linecap="round"></path>
		}
		for _, a := range s.Arrows {
			switch a.Kind {
				case "ingress", "exit":
					<path d={ a.D } fill="none" stroke="rgb(var(--rw-accent))" stroke-width="2.2" stroke-dasharray="7 4" marker-end="url(#cluster-arrow)"></path>
				case "short":
					<path d={ a.D } fill="none" stroke="rgb(var(--rw-accent))" stroke-width="2" marker-end="url(#cluster-arrow)"></path>
				default:
					<path d={ a.D } fill="none" stroke="rgb(var(--rw-faint))" stroke-width="1.8" stroke-dasharray="2 4" stroke-linecap="round" marker-end="url(#cluster-arrow-faint)"></path>
			}
		}
		for _, r := range s.Routers {
			<rect x={ itoa(r.X) } y={ itoa(r.Y) } width="44" height="44" rx="8" fill="rgb(var(--rw-surface))" stroke="rgb(var(--rw-strong))" stroke-width="1"></rect>
			<text x={ itoa(r.X + 22) } y={ itoa(r.Y + 26) } text-anchor="middle" fill="rgb(var(--rw-muted))" font-size="11" font-family="ui-sans-serif">NAT</text>
		}
		for _, l := range s.Labels {
			<rect x={ itoa(l.plateX()) } y={ itoa(l.Y - 13) } width={ itoa(l.W) } height="18" rx="4" fill="rgb(var(--rw-bg))"></rect>
			<text x={ itoa(l.X) } y={ itoa(l.Y) } text-anchor={ l.Anchor } fill="rgb(var(--rw-text))" font-size="11" font-family="ui-monospace, monospace">{ l.Text }</text>
		}
		for _, b := range s.S3s {
			<rect x={ itoa(b.X) } y={ itoa(b.Y) } width={ itoa(b.W) } height={ itoa(b.H) } rx="10" fill="rgb(var(--rw-surface))" stroke="rgb(var(--rw-strong))" stroke-width="1"></rect>
			<text x={ itoa(b.X + 18) } y={ itoa(b.Y + 27) } fill="rgb(var(--rw-text))" font-size="13" font-weight="600" font-family="ui-sans-serif">{ b.Name }</text>
		}
	</svg>
}

// netHandle is a box's name and sub, and what drags the box.
templ netHandle(name, sub string) {
	<div class="h-full cursor-move select-none px-[18px] pt-[14px]" title="Drag to move this network">
		<div class="text-sm font-semibold text-rw-text truncate">{ name }</div>
		<div class="text-xs text-rw-faint font-mono truncate">{ sub }</div>
	</div>
}

// nodeCard is a node's face and the env sub-cards dealt under it. The face
// opens the node's drawer (lane U1); a sub-card goes to its env.
templ nodeCard(n Node) {
	{{ word, tone, dot := statusTone(n.Status) }}
	<div
		class="card-face relative block h-full rounded-xl border bg-rw-surface border-rw-border hover:border-rw-accent/60 shadow-rw"
		hx-get={ NodeDrawer(n.ID, "") }
		hx-target="#drawer-body"
		hx-push-url={ NodePush(n.ID, "") }
		tabindex="0"
		role="button"
	>
		<div class="p-3.5">
			<div class="flex items-center gap-2.5">
				<span class="node-icon flex h-7 w-7 items-center justify-center rounded-md bg-rw-inset text-rw-muted shrink-0">
					<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<rect width="20" height="8" x="2" y="2" rx="2"></rect>
						<rect width="20" height="8" x="2" y="14" rx="2"></rect>
						<path d="M6 6h.01M6 18h.01"></path>
					</svg>
				</span>
				<div class="min-w-0">
					<div class="font-semibold text-rw-text truncate text-sm leading-tight">{ n.Name }</div>
					<div class="flex items-center gap-1.5 min-w-0">
						<span class="text-xs text-rw-faint truncate">{ plural(len(n.Envs), "env") }</span>
						<span class={ "shrink-0 rounded-md border px-1.5 py-0.5 text-[10px]",
							templ.KV("border-rw-accent/40 bg-rw-accent/10 text-rw-accentHi", n.Role == "controller"),
							templ.KV("border-rw-border bg-rw-inset text-rw-muted", n.Role != "controller") }>{ n.Role }</span>
					</div>
				</div>
			</div>
			<div class="flex flex-wrap gap-1 mt-2 h-[18px] overflow-hidden">
				for _, t := range n.Tags {
					<span class="shrink-0 rounded-md border border-rw-border bg-rw-inset px-1.5 py-0.5 text-[10px] text-rw-muted">{ t }</span>
				}
			</div>
			<div class="mt-2 flex items-center justify-between gap-2 text-xs min-w-0 h-4">
				if ip := publicIP(n); ip != "" {
					<span class="text-rw-faint shrink-0">Public IP</span>
					<span class="font-mono text-rw-text truncate">{ ip }</span>
				} else {
					<span class="text-rw-faint">No public IP</span>
				}
			</div>
			<div class="node-footer mt-3 pt-3 border-t border-rw-border flex items-center justify-between gap-2 min-w-0">
				<span class={ "node-status flex items-center gap-2 text-xs", tone }>
					<span class={ "h-1.5 w-1.5 rounded-full shrink-0", dot }></span>
					<span class="truncate">{ word }</span>
				</span>
				if n.Docker != "" {
					<span class="text-xs text-rw-faint font-mono whitespace-nowrap">docker { n.Docker }</span>
				}
			</div>
		</div>
	</div>
	for i, e := range subs(n) {
		<graph-node node-id={ "env:" + n.ID + ":" + strconv.Itoa(i) } static>
			<div
				class="graph-node-sub relative h-full rounded-xl border cursor-pointer bg-rw-inset border-rw-border hover:border-rw-accent/60"
				role="button"
				tabindex="0"
				if e.Health == "more" {
					hx-get={ NodeDrawer(n.ID, "envs") }
					hx-target="#drawer-body"
					hx-push-url={ NodePush(n.ID, "envs") }
				} else {
					hx-get={ e.Href }
					hx-target="#main"
					hx-push-url="true"
				}
			>
				<div class="absolute inset-x-0 bottom-0 flex h-7 items-center gap-2 px-3 min-w-0 text-rw-muted">
					if e.Health == "more" {
						<span class="text-xs text-rw-faint truncate">{ e.Name }</span>
					} else {
						<span class={ "env-dot shrink-0", dotClass(e.Health) } title={ healthWord(e.Health) }></span>
						<span class="sr-only">{ healthWord(e.Health) }:</span>
						<span class="text-xs font-medium text-rw-text truncate font-mono">{ e.Name }</span>
					}
				</div>
			</div>
		</graph-node>
	}
}

// legends are the key to the map: the links, and what the env dots mean.
templ legends() {
	<div class="absolute top-4 left-4 z-10 panel px-3 py-2.5 text-xs text-rw-muted shadow-rw pointer-events-none">
		<p class="font-medium text-rw-text mb-1.5">Links</p>
		<ul class="space-y-1">
			<li class="flex items-center gap-2">
				<svg width="28" height="8" aria-hidden="true"><line x1="0" y1="4" x2="28" y2="4" stroke="rgb(var(--rw-muted))" stroke-width="2"></line></svg>
				Tunnel link, with latency
			</li>
			<li class="flex items-center gap-2">
				<svg width="28" height="8" aria-hidden="true"><line x1="0" y1="4" x2="22" y2="4" stroke="rgb(var(--rw-accent))" stroke-width="2" stroke-dasharray="5 3"></line><path d="M22,0 L28,4 L22,8 z" fill="rgb(var(--rw-accent))"></path></svg>
				Public traffic in (ingress)
			</li>
			<li class="flex items-center gap-2">
				<svg width="28" height="8" aria-hidden="true"><line x1="0" y1="4" x2="22" y2="4" stroke="rgb(var(--rw-accent))" stroke-width="2" stroke-dasharray="5 3"></line><path d="M22,0 L28,4 L22,8 z" fill="rgb(var(--rw-accent))"></path></svg>
				Public traffic out (exit)
			</li>
			<li class="flex items-center gap-2">
				<svg width="28" height="8" aria-hidden="true"><line x1="0" y1="4" x2="28" y2="4" stroke="rgb(var(--rw-faint))" stroke-width="2" stroke-dasharray="2 3"></line></svg>
				Backups to an external service
			</li>
		</ul>
		<p class="mt-2 text-rw-faint max-w-[13rem]">Every link is encrypted.</p>
	</div>
	<div class="absolute bottom-4 left-4 z-10 panel px-3 py-2.5 text-xs text-rw-muted shadow-rw pointer-events-none">
		<p class="font-medium text-rw-text mb-1.5">Env health on this node</p>
		<ul class="flex flex-wrap gap-x-3 gap-y-1 max-w-[13rem]">
			for _, h := range []string{"healthy", "degraded", "down", "stopped", "moving"} {
				<li class="flex items-center gap-1.5">
					<span class={ "env-dot shrink-0", dotClass(h) }></span>
					{ healthWord(h) }
				</li>
			}
		</ul>
	</div>
}
