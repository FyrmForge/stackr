package cluster

import "github.com/FyrmForge/stackr/internal/ui/graph"
// Page is the Cluster page under the shell's top bar: #graph, which holds the canvas and swaps
// its inside on a timer. The swap waits while someone is typing in a note.
templ Page(v graph.View, m Map) {
	<div
		id="graph"
		class="flex min-h-0 flex-1 flex-col"
		hx-get={ Base + "/map" }
		hx-trigger="every 15s"
		hx-swap="innerHTML"
	>
		@graph.Canvas(v)
	</div>
}

// netCard is a network box: a dashed frame with its name and sub on top.
// The canvas wraps it around its cards; pressing anywhere on it drags them.
templ netCard(name, sub string) {
	<div class="h-full cursor-move select-none rounded-2xl border border-dashed border-rw-strong bg-rw-inset/40 px-5 pt-4" title="Drag to move this network">
		<div class="text-sm font-semibold text-rw-text truncate">{ name }</div>
		<div class="text-xs text-rw-faint font-mono truncate">{ sub }</div>
	</div>
}

// natCard is a network's router: public traffic for the box goes through it.
// public is the address the network is seen from outside, "" = not seen.
templ natCard(public string) {
	<div class="card-face h-full rounded-xl border border-rw-strong bg-rw-surface shadow-rw flex flex-col items-center justify-center min-w-0 px-1">
		<span class="text-sm font-semibold text-rw-text leading-tight">NAT</span>
		if public != "" {
			<span class="text-[11px] text-rw-faint font-mono leading-tight truncate max-w-full" title="Public IP">{ public }</span>
		} else {
			<span class="text-[11px] text-rw-faint leading-tight">router</span>
		}
	</div>
}

// sideCard is the internet or a backup store.
templ sideCard(name, icon string, attrs templ.Attributes) {
	<div class="card-face h-full rounded-xl border border-rw-border bg-rw-surface shadow-rw flex items-center gap-2.5 px-3.5" { attrs... }>
		<span class="flex h-7 w-7 items-center justify-center rounded-md bg-rw-inset text-rw-muted shrink-0">
			<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				if icon == "globe" {
					<circle cx="12" cy="12" r="10"></circle>
					<path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"></path>
				} else {
					<ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
					<path d="M3 5v14c0 1.7 4 3 9 3s9-1.3 9-3V5M3 12c0 1.7 4 3 9 3s9-1.3 9-3"></path>
				}
			</svg>
		</span>
		<span class="text-sm font-semibold text-rw-text truncate">{ name }</span>
	</div>
}

// inetCard is a node's (or NAT's) internet: the face opens a drawer listing
// what comes in and goes out through it.
templ inetCard(from string) {
	@sideCard("Internet", "globe", templ.Attributes{
		"hx-get": InternetDrawer(from), "hx-target": "#drawer-body", "hx-push-url": InternetPush(from),
		"role": "button", "tabindex": "0", "aria-label": "What reaches the internet here",
	})
}

// nodeCard is a node's face with its envs listed inside. The face opens
// the node's drawer (lane U1); an env row goes to its env.
templ nodeCard(n Node) {
	{{ word, tone, dot := statusTone(n.Status) }}
	<div
		class="card-face relative flex h-full flex-col overflow-hidden rounded-xl border bg-rw-surface border-rw-border hover:border-rw-accent/60 shadow-rw"
		hx-get={ NodeDrawer(n.ID, "") }
		hx-target="#drawer-body"
		hx-push-url={ templ.SafeURL(NodePush(n.ID, "")) }
		tabindex="0"
		role="button"
	>
		<div class="flex h-[162px] shrink-0 flex-col p-[14px]">
			<div class="flex items-center gap-[10px]">
				<span class="node-icon flex h-[28px] w-[28px] items-center justify-center rounded-md bg-rw-inset text-rw-muted shrink-0">
					<svg class="h-[16px] w-[16px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<rect width="20" height="8" x="2" y="2" rx="2"></rect>
						<rect width="20" height="8" x="2" y="14" rx="2"></rect>
						<path d="M6 6h.01M6 18h.01"></path>
					</svg>
				</span>
				<div class="min-w-0">
					<div class="font-semibold text-rw-text truncate text-[14px] leading-[17.5px]">{ n.Name }</div>
					<div class="flex items-center gap-[6px] min-w-0">
						<span class="text-[12px] leading-[16px] text-rw-faint truncate">{ plural(len(n.Envs), "env") }</span>
						<span class={ "shrink-0 rounded-md border px-[6px] py-[2px] text-[12px] leading-[16px]",
							templ.KV("border-rw-accent/40 bg-rw-accent/10 text-rw-accentHi", n.Role == "controller"),
							templ.KV("border-rw-border bg-rw-inset text-rw-muted", n.Role != "controller") }>{ n.Role }</span>
					</div>
				</div>
			</div>
			<div class="flex flex-wrap gap-[4px] mt-[8px] h-[18px] shrink-0 overflow-hidden">
				for _, t := range n.Tags {
					<span class="shrink-0 rounded-md border border-rw-border bg-rw-inset px-[6px] py-[2px] text-[12px] leading-[12px] text-rw-muted">{ t }</span>
				}
			</div>
			<div class={ "mt-[8px] flex items-center justify-between gap-[8px] text-[12px] leading-[16px] min-w-0 h-[16px]", templ.KV("mb-[12px]", !hasNote(n)), templ.KV("mb-[4px]", hasNote(n)) }>
				if ip := publicIP(n); ip != "" {
					<span class="text-rw-faint shrink-0">Public IP</span>
					<span class="font-mono text-rw-text truncate">{ ip }</span>
				} else if len(n.ReachedVia) > 0 {
					<span class="text-rw-faint shrink-0">Reached via</span>
					<span class={ "font-mono truncate", viaClass(n) }>{ viaList(n) }</span>
				} else if n.NoForward {
					<span class="text-rw-warn truncate" title="The internet does not reach this node. Check the port forward on its router.">No port forward</span>
				} else {
					<span class="text-rw-faint">No public IP</span>
				}
			</div>
			if hasNote(n) {
				<div class="mb-[4px] flex items-center gap-[8px] text-[12px] leading-[16px] min-w-0 h-[16px] overflow-hidden whitespace-nowrap">
					for _, w := range n.Warnings {
						<span
							class={ "node-warning truncate", templ.KV("shrink-0 rounded-md border px-[6px] leading-[14px]", w.Kind == "version"),
								templ.KV("border-rw-danger/40", w.Kind == "version" && w.Critical), templ.KV("border-rw-warn/40", w.Kind == "version" && !w.Critical),
								templ.KV("text-rw-danger", w.Critical), templ.KV("text-rw-warn", !w.Critical) }
							title={ w.Detail }
						>{ w.Label }</span>
					}
				</div>
			}
			<div class="node-footer mt-auto pt-[12px] border-t border-rw-border flex items-center justify-between gap-[8px] min-w-0">
				<span class={ "node-status flex items-center gap-[8px] text-[12px] leading-[16px]", tone }>
					<span class={ "h-[6px] w-[6px] rounded-full shrink-0", dot }></span>
					<span class="truncate">{ word }</span>
				</span>
				if info := buildInfo(n); info != "" {
					<span class="text-[12px] leading-[16px] text-rw-faint font-mono whitespace-nowrap">{ info }</span>
				}
			</div>
		</div>
		if rs := rows(n); len(rs) > 0 {
			<ul class="border-t border-rw-border px-[8px] py-[6px]">
				for _, e := range rs {
					<li>
						<div
							class="flex h-[22px] items-center gap-[8px] rounded-md px-[6px] min-w-0 cursor-pointer hover:bg-rw-inset"
							role="button"
							tabindex="0"
							hx-trigger="click consume"
							if e.Health == "more" {
								hx-get={ NodeDrawer(n.ID, "envs") }
								hx-target="#drawer-body"
								hx-push-url={ templ.SafeURL(NodePush(n.ID, "envs")) }
							} else {
								hx-get={ e.Href }
								hx-target="#main"
								hx-push-url="true"
							}
						>
							if e.Health == "more" {
								<span class="text-[12px] leading-[16px] text-rw-faint truncate">{ e.Name }</span>
							} else {
								<span class={ "env-dot shrink-0", dotClass(e.Health) } title={ healthWord(e.Health) }></span>
								<span class="sr-only">{ healthWord(e.Health) }:</span>
								<span class="text-[12px] leading-[16px] font-medium text-rw-text truncate font-mono">{ e.Name }</span>
							}
						</div>
					</li>
				}
			</ul>
		}
	</div>
}

// legend is what the env dots mean; the edge kinds are in the canvas's own
// legend.
templ legend() {
	<div data-legend class="absolute bottom-4 left-4 z-10 panel px-3 py-2.5 text-xs text-rw-muted shadow-rw pointer-events-none">
		<p class="font-medium text-rw-text mb-1.5">Env health</p>
		<ul class="flex flex-wrap gap-x-3 gap-y-1 max-w-[13rem]">
			for _, h := range []string{"healthy", "degraded", "down", "stopped", "moving"} {
				<li class="flex items-center gap-1.5">
					<span class={ "env-dot shrink-0", dotClass(h) }></span>
					{ healthWord(h) }
				</li>
			}
		</ul>
	</div>
}
