// Package instance is the managed instance drawer (v0's db panel):
// Overview (how to reach it and the slices cut from it), Logs, Backups
// and Settings (sharing, delete). v0's Metrics and Data tabs are out of v1.
package instance

import (
	"slices"

	c "github.com/FyrmForge/stackr/internal/ui/components"
	"github.com/FyrmForge/stackr/internal/ui/dialog"
	"github.com/FyrmForge/stackr/internal/ui/drawer/volume"
)

// Root is the id every drawer answer replaces (outerHTML).
const Root = c.DrawerRoot

// Tabs in v0's order. Overview keeps the key "slices": the canvas opens it.
var Tabs = []string{"slices", "logs", "backups", "settings"}

var labels = map[string]string{"slices": "Overview"}

// Tab is the tab a request asks for; an unknown one opens Overview.
func Tab(tab string) string {
	if !slices.Contains(Tabs, tab) {
		return Tabs[0]
	}
	return tab
}

// View is the drawer around one tab.
type View struct {
	Node, Name, Engine string
	Base               string // the drawer URL: tabs add ?tab=, actions add /<verb>
	Tab                string
	Status             string // a TileBadge word
	Running            bool   // offer Stop, not Deploy (v0 dbActions)
	Scope              string // env | stack | org: who may cut slices
	Location, EnvColor string
	Error, Note        string
}

func Drawer(v View, body templ.Component) templ.Component {
	return c.Drawer(c.DrawerView{
		Node:     v.Node,
		Title:    v.Name,
		Kind:     v.Engine,
		Base:     v.Base,
		Tabs:     Tabs,
		Labels:   labels,
		Tab:      v.Tab,
		Error:    v.Error,
		Note:     v.Note,
		Icon:     "managed",
		Status:   v.Status,
		Scope:    v.Scope + "-scoped",
		Location: v.Location,
		EnvColor: v.EnvColor,
		Actions:  actions(v),
	}, body)
}

templ actions(v View) {
	if v.Running {
		@c.Confirm(stop(v))
	} else {
		@c.PrimaryPost("Deploy", v.Base+"/deploy")
	}
}

func stop(v View) c.ConfirmView {
	s := dialog.Stop(v.Name, v.Base+"/stop", "#"+Root)
	s.Quiet = true
	return s
}

type OverviewView struct {
	Endpoint, AdminUser string
	Slices              []SliceRow
}

// SliceRow opens the slice's own drawer.
type SliceRow struct {
	ID, Name, DB, OnRemove, Drawer string
	UsedBy                         string // the consumer's name; "" = none
	Public, Orphan                 bool   // Orphan: its consumer is gone
}

// Overview is v0's connection panel (no password: it never reaches the
// page) and the "Provisioned" list.
templ Overview(v View, o OverviewView) {
	<div id="tab-slices">
		@c.Facts() {
			@c.Fact("Endpoint", o.Endpoint)
			@c.Fact("Admin user", o.AdminUser)
			@c.Fact("Slices from", scopeWord(v.Scope))
		}
		<h3 class="section-title">Provisioned slices</h3>
		if len(o.Slices) == 0 {
			<p class="text-rw-muted text-sm">No tile has a slice of it yet.</p>
		} else {
			<ul class="space-y-2">
				for _, s := range o.Slices {
					<li class="panel px-4 py-3 flex items-center justify-between gap-3">
						<span class="text-sm text-rw-text min-w-0">
							<span class="font-mono">{ s.DB }</span>
							if s.UsedBy != "" {
								<span class="text-rw-faint text-xs ml-1">used by { s.UsedBy }</span>
							} else if s.Orphan {
								<span class="text-rw-warn text-xs ml-1">consumer gone, { s.OnRemove } pending</span>
							}
							<span class="block mt-0.5">
								<a
									href={ templ.SafeURL("?drawer=" + s.ID + "&tab=bindings") }
									hx-get={ s.Drawer }
									hx-target="#drawer-body"
									hx-push-url={ "?drawer=" + s.ID + "&tab=bindings" }
									class="font-mono text-xs text-rw-faint hover:text-rw-text"
								>{ s.Name }</a>
							</span>
						</span>
						if s.Public {
							@c.Chip("public", "accent")
						}
					</li>
				}
			</ul>
		}
	</div>
}

func scopeWord(scope string) string {
	switch scope {
	case "stack":
		return "the whole stack"
	case "org":
		return "the whole organization"
	}
	return "this environment"
}

type LogsView struct {
	Running bool
	Pane    c.LogPaneView
}

templ Logs(v View, l LogsView) {
	<div id="tab-logs">
		if l.Running {
			@c.LogPane(l.Pane)
		} else {
			<p class="text-rw-muted text-sm">No container is running yet.</p>
		}
	</div>
}

// Backups is v0's backup panel for each of the instance's volumes; its
// actions answer that volume's drawer.
templ Backups(v View, vols []volume.BackupsView) {
	<div id="tab-backups" class="space-y-6">
		if len(vols) == 0 {
			<p class="text-rw-muted text-sm">This instance has no volume yet. The first deploy makes one.</p>
		}
		for _, b := range vols {
			if len(vols) > 1 {
				<h3 class="section-title">{ b.Name }</h3>
			}
			@volume.Backups(b)
		}
	</div>
}

// Settings is v0's Sharing section and its danger zone.
templ Settings(v View) {
	<div id="tab-settings">
		<h3 class="section-title">Sharing</h3>
		<form hx-post={ v.Base + "/scope" } hx-target={ "#" + Root } hx-swap="outerHTML" class="flex flex-wrap gap-2 items-end">
			<div>
				<label class="label" for="instance-scope">Shared with</label>
				<select id="instance-scope" name="scope_kind" class="input w-auto">
					<option value="env" selected?={ v.Scope != "stack" && v.Scope != "org" }>This environment</option>
					<option value="stack" selected?={ v.Scope == "stack" }>Whole stack</option>
					<option value="org" selected?={ v.Scope == "org" }>Whole organization</option>
				</select>
			</div>
			<button type="submit" class="btn btn-ghost btn-sm">Save scope</button>
			<p class="w-full text-xs text-rw-faint">Controls which tiles may cut a slice here. This environment keeps it private; stack or organization lets tiles elsewhere share this instance.</p>
		</form>
		@c.DangerZone("Deleting this database removes its container and everything provisioned from it.", v.Name, "The data volume is kept, orphaned for the retention window.") {
			@c.Confirm(remove(v))
		}
	</div>
}

func remove(v View) c.ConfirmView {
	d := dialog.Delete(v.Name, v.Base+"/delete", "#"+Root)
	d.Button = "Delete database"
	return d
}
