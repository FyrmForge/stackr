// Package instance is the operated instance drawer (v0's db panel):
// Overview (how to reach it and the slices cut from it), Logs, Backups
// and Settings (the allow list, env pairs, delete). v0's Metrics and Data
// tabs are out of v1.
package instance

import (
	"slices"
	"strconv"
	"strings"
	"time"

	c "github.com/FyrmForge/stackr/internal/ui/components"
	"github.com/FyrmForge/stackr/internal/ui/dialog"
	"github.com/FyrmForge/stackr/internal/ui/drawer/volume"
)

// Root is the id every drawer answer replaces (outerHTML).
const Root = c.DrawerRoot

// Tabs in v0's order. Overview keeps the key "slices": the canvas opens it.
var Tabs = []string{"slices", "logs", "backups", "settings"}

// DatabaseTab is postgres's own: its health and costliest statements.
const DatabaseTab = "database"

// tabsFor is the tabs an engine's drawer shows.
func tabsFor(engine string) []string {
	if engine != "postgres" {
		return Tabs
	}
	return append([]string{Tabs[0], DatabaseTab}, Tabs[1:]...)
}

var labels = map[string]string{"slices": "Overview"}

// Tab is the tab a request asks for; an unknown one opens Overview.
func Tab(tab string) string {
	if tab != DatabaseTab && !slices.Contains(Tabs, tab) {
		return Tabs[0]
	}
	return tab
}

// View is the drawer around one tab.
type View struct {
	Node, Name, Engine string
	Base               string // the drawer URL: tabs add ?tab=, actions add /<verb>
	Tab                string
	Status             string // a TileBadge word
	Running            bool   // offer Stop, not Deploy (v0 dbActions)
	ReadOnly           bool   // the viewer may not write: no Deploy, Stop, pairs or delete
	Location, EnvColor string
	Error, Note        string
}

func Drawer(v View, body templ.Component) templ.Component {
	return c.Drawer(c.DrawerView{
		Node:     v.Node,
		Title:    v.Name,
		Kind:     v.Engine,
		Base:     v.Base,
		Tabs:     tabsFor(v.Engine),
		Labels:   labels,
		Tab:      v.Tab,
		Error:    v.Error,
		Note:     v.Note,
		Icon:     "operated",
		Status:   v.Status,
		Location: v.Location,
		EnvColor: v.EnvColor,
		Actions:  actions(v),
	}, body)
}

templ actions(v View) {
	if !v.ReadOnly {
		if v.Running {
			@c.Confirm(stop(v))
		} else {
			@c.PrimaryPost("Deploy", v.Base+"/deploy")
		}
	}
}

func stop(v View) c.ConfirmView {
	s := dialog.Stop(v.Name, v.Base+"/stop", "#"+Root)
	s.Quiet = true
	return s
}

type OverviewView struct {
	Endpoint, AdminUser string
	Slices              []SliceRow
	Pooler              *PoolerView // nil = the engine has none
	Job                 *c.JobStatusView // the newest job, a failed seed's error with it; nil = none yet
	JobWhen             time.Time
	Version             *VersionView // postgres only
	Protection          string       // postgres only: the standby line, "" = not shown
	Members             []MemberRow  // postgres only: the primary and its standbys; none = not shown
}

// MemberRow is one member of a postgres instance. Lag and Slot are
// ready-made words ("" = nothing to say, as for the primary): Slot is the
// WAL the member's replication slot holds against the cap.
type MemberRow struct {
	Node, Role, State, Lag, Slot string
	Tone                         string // the state's chip tone
}

// VersionView is the image a postgres instance runs. UpdateTo is the image a
// minor update moves it to, "" = none; EOL says its major gets no more
// security fixes.
type VersionView struct {
	Image, UpdateTo, EOLDate string
	EOL                      bool
}

// PoolerView is the instance's pgbouncer. Counted says the console answered,
// so Active and Waiting are real.
type PoolerView struct {
	Status          string // none | running | stopped | unhealthy
	Host            string
	Port            int
	Active, Waiting int
	Counted         bool
}

// SliceRow is one slice cut from the instance: its slice tile, which may
// live in another env or stack, so Link is that env's canvas with the
// slice's drawer open.
type SliceRow struct {
	Slice    string // the slice tile's slug
	Where    string // "stack/env" when not this env; "" = here
	Link     string
	Name     string // the database or bucket
	Bindings int
	Public   bool
}

// Overview is v0's connection panel (no password: it never reaches the
// page) and the slices on the instance.
templ Overview(v View, o OverviewView) {
	<div id="tab-slices">
		@c.Facts() {
			@c.Fact("Endpoint", o.Endpoint)
			@c.Fact("Admin user", o.AdminUser)
			if o.Protection != "" {
				@c.Fact("Protection", o.Protection)
			}
			if o.Version != nil {
				@c.Fact("Image", o.Version.Image)
			}
		}
		if o.Version != nil && o.Version.EOL {
			<p class="banner border-rw-warn/40 bg-rw-warn/10 text-rw-warn" role="status">This postgres version gets no more security fixes since { o.Version.EOLDate }.</p>
		}
		if o.Version != nil && o.Version.UpdateTo != "" {
			<div class="banner border-rw-warn/40 bg-rw-warn/10 text-rw-warn flex items-center justify-between gap-3" role="status">
				<span>Update available: { o.Version.UpdateTo }.</span>
				if !v.ReadOnly {
					@c.PrimaryPost("Apply", v.Base+"/version")
				}
			</div>
		}
		if o.Pooler != nil {
			<h3 class="section-title">Pooler</h3>
			<div class="panel p-4 space-y-1">
				@c.Facts() {
					@c.Fact("Status", o.Pooler.Status)
					@c.Fact("Address", o.Pooler.Host+":"+strconv.Itoa(o.Pooler.Port))
					if o.Pooler.Counted {
						@c.Fact("Connections in use", strconv.Itoa(o.Pooler.Active))
						@c.Fact("Waiting", strconv.Itoa(o.Pooler.Waiting))
					}
				}
			</div>
		}
		if len(o.Members) > 0 {
			<h3 class="section-title">Members</h3>
			<ul class="space-y-2">
				for _, m := range o.Members {
					<li class="panel px-4 py-3 flex items-center justify-between gap-3">
						<span class="text-sm text-rw-text min-w-0">
							<span class="font-medium">{ m.Node }</span>
							<span class="text-rw-faint text-xs ml-1">{ m.Role }</span>
							if m.Lag != "" {
								<span class="block mt-0.5 text-xs text-rw-faint">{ m.Lag }</span>
							}
							if m.Slot != "" {
								<span class="block text-xs text-rw-faint">{ m.Slot }</span>
							}
						</span>
						@c.Chip(m.State, m.Tone)
					</li>
				}
			</ul>
		}
		if o.Job != nil {
			<h3 class="section-title">Last job</h3>
			<div class="panel p-4">
				@c.JobStatus(*o.Job)
				<div class="text-xs text-rw-faint mt-1.5">@c.When(o.JobWhen)
</div>
			</div>
		}
		<h3 class="section-title">Slices on this instance</h3>
		if len(o.Slices) == 0 {
			<p class="text-rw-muted text-sm">No slice tile has been provisioned here yet.</p>
		} else {
			<ul class="space-y-2">
				for _, s := range o.Slices {
					<li class="panel px-4 py-3 flex items-center justify-between gap-3">
						<span class="text-sm text-rw-text min-w-0">
							<a href={ templ.SafeURL(s.Link) } class="font-medium text-rw-accentHi hover:underline">{ s.Slice }</a>
							if s.Where != "" {
								<span class="text-rw-faint text-xs ml-1">in { s.Where }</span>
							}
							<span class="block mt-0.5 font-mono text-xs text-rw-faint">{ s.Name }</span>
						</span>
						<span class="flex items-center gap-2 shrink-0">
							<span class="text-xs text-rw-muted">{ bindings(s.Bindings) }</span>
							if s.Public {
								@c.Chip("public", "accent")
							}
						</span>
					</li>
				}
			</ul>
		}
	</div>
}

func bindings(n int) string {
	if n == 1 {
		return "1 binding"
	}
	return strconv.Itoa(n) + " bindings"
}

type LogsView struct {
	Running bool
	Pane    c.LogPaneView
}

templ Logs(v View, l LogsView) {
	<div id="tab-logs">
		if l.Running {
			@c.LogPane(l.Pane)
		} else {
			<p class="text-rw-muted text-sm">No container is running yet.</p>
		}
	</div>
}

// ChartSpec is one chart of the Database tab (components.Chart's arguments).
type ChartSpec struct{ Title, Measures, Labels, Unit string }

// QueryRow is one of the costliest statements.
type QueryRow struct {
	Calls, Total, Mean, Rows string
	Text                     string
}

// DatabaseView is the Database tab: the live charts, the headline and the
// statements read when it opened.
type DatabaseView struct {
	Metrics c.MetricsView
	Sampled bool
	Headline [][2]string // label, value
	Charts  []ChartSpec
	Top     []QueryRow
	TopNote string
}

// Line is one line of a chart: its series suffix and its label.
type Line struct{ Key, Label string }

// DatabaseCharts is the charts for the series an instance has: the fixed
// ones, then one line per database, standby and slot.
func DatabaseCharts(dbs, replicas, slots []Line, archiving bool) []ChartSpec {
	lines := func(prefix string, ls []Line) (measures, labels string) {
		for i, l := range ls {
			if i > 0 {
				measures, labels = measures+" ", labels+","
			}
			measures, labels = measures+prefix+l.Key, labels+l.Label
		}
		return
	}
	out := []ChartSpec{
		{"Connections", "conn_active conn_idle conn_idle_tx conn_max", "active,idle,idle in transaction,max", ""},
		{"Transactions", "commits_s rollbacks_s", "commits,rollbacks", "rps"},
		{"Cache hit ratio", "cache_hit", "", "ratio"},
		{"Oldest open transaction", "xact_oldest_s", "", "s"},
		{"Deadlocks", "deadlocks_s", "", "rps"},
	}
	if len(dbs) > 0 {
		m, l := lines("db_", dbs)
		out = append(out, ChartSpec{"Database size", m, l, "bytes"})
	}
	if len(replicas) > 0 {
		m, l := lines("repl_s_", replicas)
		out = append(out, ChartSpec{"Replica lag", m, l, "s"})
		m, l = lines("repl_bytes_", replicas)
		out = append(out, ChartSpec{"Replica lag (bytes)", m, l, "bytes"})
	}
	if len(slots) > 0 {
		m, l := lines("slot_", slots)
		out = append(out, ChartSpec{"WAL held by slots", m, l, "bytes"})
	}
	if archiving {
		out = append(out, ChartSpec{"WAL waiting to archive", "archive_bytes", "", "bytes"})
	}
	return out
}

// Database is the instance's health: charts, then the top statements.
templ Database(v View, d DatabaseView) {
	<div id="tab-database">
		if len(d.Headline) > 0 {
			@c.Facts() {
				for _, h := range d.Headline {
					@c.Fact(h[0], h[1])
				}
			}
		} else if !d.Sampled {
			<p class="text-rw-muted text-sm">No sample yet. The first one lands within a minute of the instance running.</p>
		}
		@c.Metrics(d.Metrics) {
			for _, ch := range d.Charts {
				@c.Chart(d.Metrics, ch.Title, ch.Measures, ch.Labels, ch.Unit)
			}
		}
		<h3 class="section-title">Top statements by time</h3>
		if len(d.Top) == 0 {
			<p class="text-rw-muted text-sm">{ cmpOr(d.TopNote, "No statements recorded yet.") }</p>
		} else {
			<ul class="space-y-2">
				for _, q := range d.Top {
					<li class="panel px-4 py-3">
						<code class="block font-mono text-xs text-rw-text break-all">{ q.Text }</code>
						<span class="block mt-1 text-xs text-rw-muted">{ q.Calls } calls, { q.Total } total, { q.Mean } mean, { q.Rows } rows</span>
					</li>
				}
			</ul>
		}
	</div>
}

func cmpOr(a, b string) string {
	if a != "" {
		return a
	}
	return b
}

// PITRView is the instance's point-in-time recovery health: what it can
// restore, the last base backup, the archive. Zero times are "not yet".
type PITRView struct {
	On, Edit bool
	Days     int
	Dest     string
	Local    bool // the archive sits on this server's disk
	From, To time.Time
	Base     *PITRBase
	Bundles  int
	Size     string
	Waiting  int
	Error    string
	// Of is set on a restored copy: the instance it was restored from and
	// the time. Promote puts its data under that instance.
	Of, At string
}

// PITRBase is the newest base backup attempt.
type PITRBase struct {
	At     time.Time
	OK     bool
	Active bool
	Error  string
}

const localLayout = "2006-01-02T15:04:05"

// localMin and localMax are the restorable range as datetime-local bounds, in
// UTC, whole seconds inside the range. A zero To (not yet known) = no max.
func localMin(t time.Time) string {
	return t.UTC().Add(time.Second - 1).Truncate(time.Second).Format(localLayout)
}

func localMax(t time.Time) string {
	if t.IsZero() {
		return ""
	}
	return t.UTC().Truncate(time.Second).Format(localLayout)
}

// pitr is the point-in-time panel at the top of the Backups tab: the health
// lines when on, the switch when off. Turning it on or off restarts the
// database, and says so.
templ pitr(v View, p PITRView) {
	<div id="pitr" class="panel p-5 space-y-2">
		<h4 class="text-sm font-medium text-rw-text">Point-in-time restore</h4>
		if p.Of != "" {
			<p class="text-sm text-rw-muted">Restored from { p.Of } at { p.At }.</p>
			if p.Edit {
				@c.Confirm(c.ConfirmView{
					Button:  "Promote",
					Title:   "Promote this copy?",
					Warning: "Replaces " + p.Of + "'s data with this copy and restarts it. Its apps keep their address and login.",
					Kept:    []string{"the old data, as an orphaned volume until retention ends"},
					Action:  v.Base + "/promote-restore",
					Target:  "#" + Root,
					Primary: true,
				})
			}
		} else if !p.On {
			<p class="text-sm text-rw-muted">Point-in-time restore is off.</p>
			if p.Edit {
				<form hx-post={ v.Base + "/pitr" } hx-target={ "#" + Root } hx-swap="outerHTML" class="space-y-2">
					@c.Field(c.FieldView{Name: "days", Label: "Days to keep", Type: "number", Value: "7", Min: "1", Max: "365", Help: "Restarts the database once, a few seconds."})
					<button type="submit" class="btn btn-primary btn-sm">Turn on</button>
				</form>
			}
		} else {
			<ul class="text-sm text-rw-muted space-y-1">
				<li class="flex flex-wrap gap-x-1">
					if p.From.IsZero() {
						<span>Restorable: not yet, no base backup is finished and shipped.</span>
					} else if p.To.IsZero() {
						<span>Restorable from</span>
						@c.When(p.From)
					} else {
						<span>Restorable from</span>
						@c.When(p.From)
						<span>to</span>
						@c.When(p.To)
					}
				</li>
				<li class="flex flex-wrap gap-x-1">
					if p.Base == nil {
						<span>Last base backup: none yet.</span>
					} else if p.Base.Active {
						<span>Last base backup: running.</span>
					} else if p.Base.OK {
						<span>Last base backup: ok,</span>
						@c.When(p.Base.At)
					} else {
						<span>Last base backup: failed,</span>
						@c.When(p.Base.At)
						<span>{ p.Base.Error }</span>
					}
				</li>
				<li>WAL archive: { strconv.Itoa(p.Bundles) } bundles, { p.Size } on { p.Dest }; { strconv.Itoa(p.Waiting) } segments waiting on the box.</li>
				if p.Error != "" {
					<li class="text-rw-danger">{ p.Error }</li>
				}
			</ul>
			if p.Local {
				<p class="text-xs text-rw-faint">The archive is on this server's disk: it covers a bad migration, not a lost server.</p>
			}
			if p.Edit {
				<form novalidate hx-post={ v.Base + "/pitr" } hx-target={ "#" + Root } hx-swap="outerHTML" class="space-y-2">
					@c.Field(c.FieldView{Name: "days", Label: "Days to keep", Type: "number", Value: strconv.Itoa(p.Days), Min: "1", Max: "365", Help: "Keeps " + strconv.Itoa(p.Days) + " days. Changing it restarts the database once."})
					<button type="submit" class="btn btn-sm">Save</button>
				</form>
			}
			if p.Edit && !p.From.IsZero() {
				<form novalidate hx-post={ v.Base + "/restore" } hx-target={ "#" + Root } hx-swap="outerHTML" class="space-y-2">
					@c.Field(c.FieldView{Name: "time", Label: "Time (UTC)", Type: "datetime-local", Step: "1", Min: localMin(p.From), Max: localMax(p.To), Help: "Makes a new instance; this one is not touched."})
					<div class="flex gap-2">
						<button type="submit" class="btn btn-sm">Restore</button>
						<button type="submit" name="at" value="latest" class="btn btn-sm">Latest</button>
					</div>
				</form>
			}
			if p.Edit {
				@c.Confirm(c.ConfirmView{
					Button:  "Turn off",
					Title:   "Turn off point-in-time restore?",
					Warning: "Restarts the database once and stops archiving.",
					Kept:    []string{"base backups and WAL already in the destination"},
					Action:  v.Base + "/pitr?days=0",
					Target:  "#" + Root,
					Quiet:   true,
				})
			}
		}
	</div>
}

// Backups is v0's backup panel for each of the instance's volumes; its
// actions answer that volume's drawer.
templ Backups(v View, p PITRView, vols []volume.BackupsView) {
	<div id="tab-backups" class="space-y-6">
		@pitr(v, p)
		if len(vols) == 0 {
			<p class="text-rw-muted text-sm">This instance has no volume yet. The first deploy makes one.</p>
		}
		for _, b := range vols {
			if len(vols) > 1 {
				<h3 class="section-title">{ b.Name }</h3>
			}
			@volume.Backups(b)
		}
	</div>
}

// SettingsView is who may cut a slice here: the allow list and the env
// pairs. Each form posts the whole list or map; a row's × posts it
// without that row.
type SettingsView struct {
	Allow    []string
	Add      string // the add input: "<org>:" or what was typed
	CanAllow bool   // the allow list is an owner's (operated.allow)
	Pairs    []Pair
	AddFrom  string
	AddTo    string
	Envs     []string          // this stack's envs, a pair's right side
	Name     *string           // a refused rename's name as typed; nil = the stored one
	Errors   map[string]string // allow | env_pairs | name | delete → why the save was refused
	Open     string            // the accordion row open on load: the saved one, or ?open=
	PG       *PGView           // a postgres instance's own settings; nil = another engine
}

// PGView is a postgres instance's settings page: each value with where it
// comes from, and what waits for a restart.
type PGView struct {
	Restart  bool // some change waits for a restart
	Risk     bool // work_mem times max_connections outgrows the node
	MemoryMB int  // the tile's memory limit, 0 = none
	Main     []PGRow
	Advanced []PGRow
	Other    []PGRow
	AddName  string // the typed name and value of a refused add
	AddValue string
}

// PGRow is one setting. Source is default, computed or yours; Mine is the
// value the form shows (an override), Value what is in force.
type PGRow struct {
	Name, Value, Source string
	Mine                string
	Pending             bool
}

// Pair is one env pair: a consumer's env → this stack's env.
type Pair struct{ From, To string }

// Settings is the allow list, the env pairs and the danger zone, one
// accordion row each like the other tiles' Settings.
templ Settings(v View, s SettingsView) {
	<div id="tab-settings">
		@c.SettingsAccordion(c.SettingsAcc{ID: "instance-settings", Rows: settingsRows(v, s), Open: s.Open})
	</div>
}

func settingsRows(v View, s SettingsView) []c.AccRow {
	rows := []c.AccRow{
		{Key: "general", Title: "Name", Summary: v.Name, Body: nameRow(v, s)},
		{Key: "allow", Title: "Allow", Summary: AllowSummary(s.Allow), Changed: len(s.Allow) > 0, Body: allowRow(v, s)},
		{Key: "pairs", Title: "Env pairs", Summary: PairsSummary(s.Pairs), Changed: len(s.Pairs) > 0, Body: pairsRow(v, s)},
	}
	if s.PG != nil {
		rows = append(rows, c.AccRow{Key: "postgres", Title: "Postgres", Summary: PGSummary(*s.PG), Changed: s.PG.Restart, Body: pgRow(v, s)})
	}
	if !v.ReadOnly {
		rows = append(rows, c.AccRow{Key: "delete", Title: "Delete", Body: deleteRow(v, s)})
	}
	return rows
}

// PGSummary is the Postgres row closed.
func PGSummary(p PGView) string {
	if p.Restart {
		return "needs a restart"
	}
	n := 0
	for _, rs := range [][]PGRow{p.Main, p.Advanced, p.Other} {
		for _, r := range rs {
			if r.Source == "yours" {
				n++
			}
		}
	}
	if n == 0 {
		return "defaults"
	}
	return strconv.Itoa(n) + " of yours"
}

templ pgRow(v View, s SettingsView) {
	<p class="text-xs text-rw-faint" data-hint>stackr manages a few settings itself, so they are not listed.</p>
	<div class="space-y-4">
		if s.PG.Restart {
			<div class="banner border-rw-warn/40 bg-rw-warn/10 text-rw-warn flex items-center justify-between gap-3" role="status">
				<span>Some changes wait for a restart.</span>
				if !v.ReadOnly {
					@c.PrimaryPost("Restart", v.Base+"/deploy")
				}
			</div>
		}
		if s.PG.Risk {
			<p class="banner border-rw-warn/40 bg-rw-warn/10 text-rw-warn" role="status">work_mem times max_connections is more than the node's memory.</p>
		}
		<form hx-post={ v.Base + "/memory" } hx-target={ "#" + Root } hx-swap="outerHTML" class="flex flex-wrap items-end gap-2">
			<div class="flex-1 min-w-48">
				<label for="pg-memory" class="label">Memory limit (MB)</label>
				<input id="pg-memory" name="memory_mb" inputmode="numeric" value={ pgMem(s.PG.MemoryMB) } placeholder="none" class="input font-mono" disabled?={ v.ReadOnly } { c.Invalid("memory", s.Errors["memory"])... }/>
				<p class="mt-1.5 text-xs text-rw-faint" data-hint>Empty shares the node's memory.</p>
			</div>
			if !v.ReadOnly {
				<button type="submit" class="btn btn-ghost btn-sm">Save</button>
			}
			<div class="w-full">
				@c.FieldError("memory", s.Errors["memory"])
			</div>
		</form>
		<form hx-post={ v.Base + "/settings" } hx-target={ "#" + Root } hx-swap="outerHTML" class="space-y-4">
			@pgRows(v, s.PG.Main)
			<details class="text-sm">
				<summary class="cursor-pointer text-rw-muted hover:text-rw-text">Advanced</summary>
				<div class="mt-3">
					@pgRows(v, s.PG.Advanced)
				</div>
			</details>
			if len(s.PG.Other) > 0 {
				<h4 class="label">Other</h4>
				@pgRows(v, s.PG.Other)
			}
			if !v.ReadOnly {
				<div class="flex flex-wrap items-end gap-2">
					<div class="flex-1 min-w-32">
						<label for="pg-add-name" class="label">Another setting</label>
						<input id="pg-add-name" name="add_name" value={ s.PG.AddName } placeholder="name" class="input font-mono" { c.Invalid("settings", s.Errors["settings"])... }/>
					</div>
					<div class="flex-1 min-w-32">
						<label for="pg-add-value" class="label">Value</label>
						<input id="pg-add-value" name="add_value" value={ s.PG.AddValue } class="input font-mono"/>
					</div>
				</div>
				<div>
					@c.FieldError("settings", s.Errors["settings"])
				</div>
				<button type="submit" class="btn btn-primary btn-sm">Save settings</button>
			}
		</form>
	</div>
}

func pgMem(mb int) string {
	if mb <= 0 {
		return ""
	}
	return strconv.Itoa(mb)
}

// pgRows is one list of settings: an input each, empty = no override of
// yours, with the value in force as its placeholder.
templ pgRows(v View, rows []PGRow) {
	<ul class="space-y-1.5">
		for _, r := range rows {
			<li class="flex items-center gap-3 text-sm" data-field data-changed?={ r.Source == "yours" }>
				<label for={ "pg-" + r.Name } class="w-64 shrink-0 font-mono text-rw-text break-all">{ r.Name }</label>
				<input id={ "pg-" + r.Name } name={ "v_" + r.Name } value={ r.Mine } placeholder={ r.Value } class="input font-mono flex-1" disabled?={ v.ReadOnly }/>
				@c.Chip(r.Source, pgTone(r.Source))
				if r.Pending {
					@c.Chip("needs restart", "warn")
				}
			</li>
		}
	</ul>
}

func pgTone(source string) string {
	if source == "yours" {
		return "accent"
	}
	return "muted"
}

// AllowSummary is the Allow row closed: its patterns, or who may by default.
func AllowSummary(allow []string) string {
	if len(allow) == 0 {
		return "this environment only"
	}
	return strings.Join(allow, ", ")
}

// PairsSummary is the Env pairs row closed: "staging → dev", or "none".
func PairsSummary(ps []Pair) string {
	if len(ps) == 0 {
		return "none"
	}
	out := make([]string, len(ps))
	for i, p := range ps {
		out[i] = p.From + " → " + p.To
	}
	return strings.Join(out, ", ")
}

// allowRow and pairsRow: a row's × posts from its button, not its form,
// so a save's answer lands after the Add form (the one form posting there).
templ allowRow(v View, s SettingsView) {
	<p class="text-xs text-rw-faint" data-hint>Who may cut a slice here: org:stack:env:tile patterns, a trailing * for the rest.</p>
	<div class="space-y-4">
		if len(s.Allow) == 0 {
			<p class="text-sm text-rw-muted">No pattern yet: only slice tiles in this environment.</p>
		} else {
			<ul class="space-y-1.5">
				for i, p := range s.Allow {
					<li class="panel px-4 py-2.5 flex items-center gap-3 text-sm" data-field data-changed>
						<span class="flex-1 font-mono text-rw-text break-all">{ p }</span>
						if s.CanAllow {
							<form>
								for _, q := range drop(s.Allow, i) {
									<input type="hidden" name="allow" value={ q }/>
								}
								<button type="submit" hx-post={ v.Base + "/allow" } hx-target={ "#" + Root } hx-swap="outerHTML" class="text-rw-faint hover:text-rw-danger" aria-label={ "Remove " + p }>×</button>
							</form>
						}
					</li>
				}
			</ul>
		}
		if s.CanAllow {
			<form hx-post={ v.Base + "/allow" } hx-target={ "#" + Root } hx-swap="outerHTML" class="flex flex-wrap items-end gap-2">
				for _, q := range s.Allow {
					<input type="hidden" name="allow" value={ q }/>
				}
				<div class="flex-1 min-w-48">
					<label for="allow-add" class="label">Add a pattern</label>
					<input id="allow-add" name="add" value={ s.Add } placeholder="acme:shop:*" class="input font-mono" { c.Invalid("allow", s.Errors["allow"])... }/>
				</div>
				<button type="submit" class="btn btn-ghost btn-sm">Add</button>
				<div class="w-full">
					@c.FieldError("allow", s.Errors["allow"])
				</div>
			</form>
		} else {
			<p class="text-xs text-rw-faint" data-hint>Only an owner of the organization changes this list.</p>
		}
	</div>
}

templ pairsRow(v View, s SettingsView) {
	<p class="text-xs text-rw-faint" data-hint>Which of this stack's envs a slice lands in, by the env the slice asks for.</p>
	<div class="space-y-4">
		if len(s.Pairs) == 0 {
			<p class="text-sm text-rw-muted">No pair yet: a slice lands in the env it names.</p>
		} else {
			<ul class="space-y-1.5">
				for i, p := range s.Pairs {
					<li class="panel px-4 py-2.5 flex items-center gap-3 text-sm font-mono" data-field data-changed>
						<span class="text-rw-text">{ p.From }</span>
						<span class="text-rw-faint">→</span>
						<span class="flex-1 text-rw-text">{ p.To }</span>
						if !v.ReadOnly {
							<form>
								for _, q := range dropPair(s.Pairs, i) {
									<input type="hidden" name="from" value={ q.From }/>
									<input type="hidden" name="to" value={ q.To }/>
								}
								<button type="submit" hx-post={ v.Base + "/env-pairs" } hx-target={ "#" + Root } hx-swap="outerHTML" class="text-rw-faint hover:text-rw-danger" aria-label={ "Remove " + p.From }>×</button>
							</form>
						}
					</li>
				}
			</ul>
		}
		if v.ReadOnly {
			<p class="text-xs text-rw-faint" data-hint>Only members and owners can change the pairs.</p>
		} else {
		<form hx-post={ v.Base + "/env-pairs" } hx-target={ "#" + Root } hx-swap="outerHTML" class="flex flex-wrap items-end gap-2">
			<input type="hidden" name="adding" value="1"/>
			for _, q := range s.Pairs {
				<input type="hidden" name="from" value={ q.From }/>
				<input type="hidden" name="to" value={ q.To }/>
			}
			<div class="flex-1 min-w-32">
				<label for="pair-from" class="label">Consumer env</label>
				<input id="pair-from" name="add_from" value={ s.AddFrom } placeholder="staging" class="input font-mono" { c.Invalid("env_pairs", s.Errors["env_pairs"])... }/>
			</div>
			<div class="flex-1 min-w-32">
				<label for="pair-to" class="label">This stack's env</label>
				<select id="pair-to" name="add_to" class="input">
					for _, e := range s.Envs {
						<option value={ e } selected?={ e == s.AddTo }>{ e }</option>
					}
				</select>
			</div>
			<button type="submit" class="btn btn-ghost btn-sm">Add</button>
			<div class="w-full">
				@c.FieldError("env_pairs", s.Errors["env_pairs"])
			</div>
		</form>
		}
	</div>
}

func typedName(v View, s SettingsView) string {
	if s.Name != nil {
		return *s.Name
	}
	return v.Name
}

// nameRow renames the database; its slices follow it.
templ nameRow(v View, s SettingsView) {
	if v.ReadOnly {
		<div data-field>
			<p class="label">Name</p>
			<p class="text-sm text-rw-text">{ v.Name }</p>
			<p class="text-xs text-rw-faint" data-hint>Only members and owners can rename it.</p>
		</div>
	} else {
		<form novalidate hx-post={ v.Base + "/rename" } hx-target={ "#" + Root } hx-swap="outerHTML" class="space-y-4">
			@c.Field(c.FieldView{Name: "name", Label: "Name", Value: typedName(v, s), Error: s.Errors["name"], Help: "Its slices follow the new name."})
			<button type="submit" class="btn btn-primary btn-sm">Rename</button>
		</form>
	}
}

templ deleteRow(v View, s SettingsView) {
	@c.DangerZone("Deleting this database removes its container. Its slice tiles must go first.", v.Name, "The data volume is kept, orphaned for the retention window.") {
		@c.Confirm(remove(v))
	}
	@c.FormError(s.Errors["delete"])
}

// drop is list without its i-th entry.
func drop(list []string, i int) []string {
	return slices.Delete(slices.Clone(list), i, i+1)
}

func dropPair(list []Pair, i int) []Pair {
	return slices.Delete(slices.Clone(list), i, i+1)
}

func remove(v View) c.ConfirmView {
	d := dialog.Delete(v.Name, v.Base+"/delete", "#"+Root)
	d.Button = "Delete database"
	d.Warning = "Its container and domains go. Refused while slice tiles still live on it."
	return d
}
