// Package instance is the managed instance drawer (v0's db panel):
// Overview (how to reach it and the slices cut from it), Logs, Backups
// and Settings (the allow list, env pairs, delete). v0's Metrics and Data
// tabs are out of v1.
package instance

import (
	"slices"
	"strconv"
	"strings"

	c "github.com/FyrmForge/stackr/internal/ui/components"
	"github.com/FyrmForge/stackr/internal/ui/dialog"
	"github.com/FyrmForge/stackr/internal/ui/drawer/volume"
)

// Root is the id every drawer answer replaces (outerHTML).
const Root = c.DrawerRoot

// Tabs in v0's order. Overview keeps the key "slices": the canvas opens it.
var Tabs = []string{"slices", "logs", "backups", "settings"}

var labels = map[string]string{"slices": "Overview"}

// Tab is the tab a request asks for; an unknown one opens Overview.
func Tab(tab string) string {
	if !slices.Contains(Tabs, tab) {
		return Tabs[0]
	}
	return tab
}

// View is the drawer around one tab.
type View struct {
	Node, Name, Engine string
	Base               string // the drawer URL: tabs add ?tab=, actions add /<verb>
	Tab                string
	Status             string // a TileBadge word
	Running            bool   // offer Stop, not Deploy (v0 dbActions)
	ReadOnly           bool   // the viewer may not write: no Deploy, Stop, pairs or delete
	Location, EnvColor string
	Error, Note        string
}

func Drawer(v View, body templ.Component) templ.Component {
	return c.Drawer(c.DrawerView{
		Node:     v.Node,
		Title:    v.Name,
		Kind:     v.Engine,
		Base:     v.Base,
		Tabs:     Tabs,
		Labels:   labels,
		Tab:      v.Tab,
		Error:    v.Error,
		Note:     v.Note,
		Icon:     "managed",
		Status:   v.Status,
		Location: v.Location,
		EnvColor: v.EnvColor,
		Actions:  actions(v),
	}, body)
}

templ actions(v View) {
	if !v.ReadOnly {
		if v.Running {
			@c.Confirm(stop(v))
		} else {
			@c.PrimaryPost("Deploy", v.Base+"/deploy")
		}
	}
}

func stop(v View) c.ConfirmView {
	s := dialog.Stop(v.Name, v.Base+"/stop", "#"+Root)
	s.Quiet = true
	return s
}

type OverviewView struct {
	Endpoint, AdminUser string
	Slices              []SliceRow
}

// SliceRow is one slice cut from the instance: its slice tile, which may
// live in another env or stack, so Link is that env's canvas with the
// slice's drawer open.
type SliceRow struct {
	Slice    string // the slice tile's slug
	Where    string // "stack/env" when not this env; "" = here
	Link     string
	Name     string // the database or bucket
	Bindings int
	Public   bool
}

// Overview is v0's connection panel (no password: it never reaches the
// page) and the slices on the instance.
templ Overview(v View, o OverviewView) {
	<div id="tab-slices">
		@c.Facts() {
			@c.Fact("Endpoint", o.Endpoint)
			@c.Fact("Admin user", o.AdminUser)
		}
		<h3 class="section-title">Slices on this instance</h3>
		if len(o.Slices) == 0 {
			<p class="text-rw-muted text-sm">No slice tile has been provisioned here yet.</p>
		} else {
			<ul class="space-y-2">
				for _, s := range o.Slices {
					<li class="panel px-4 py-3 flex items-center justify-between gap-3">
						<span class="text-sm text-rw-text min-w-0">
							<a href={ templ.SafeURL(s.Link) } class="font-medium text-rw-accentHi hover:underline">{ s.Slice }</a>
							if s.Where != "" {
								<span class="text-rw-faint text-xs ml-1">in { s.Where }</span>
							}
							<span class="block mt-0.5 font-mono text-xs text-rw-faint">{ s.Name }</span>
						</span>
						<span class="flex items-center gap-2 shrink-0">
							<span class="text-xs text-rw-muted">{ bindings(s.Bindings) }</span>
							if s.Public {
								@c.Chip("public", "accent")
							}
						</span>
					</li>
				}
			</ul>
		}
	</div>
}

func bindings(n int) string {
	if n == 1 {
		return "1 binding"
	}
	return strconv.Itoa(n) + " bindings"
}

type LogsView struct {
	Running bool
	Pane    c.LogPaneView
}

templ Logs(v View, l LogsView) {
	<div id="tab-logs">
		if l.Running {
			@c.LogPane(l.Pane)
		} else {
			<p class="text-rw-muted text-sm">No container is running yet.</p>
		}
	</div>
}

// Backups is v0's backup panel for each of the instance's volumes; its
// actions answer that volume's drawer.
templ Backups(v View, vols []volume.BackupsView) {
	<div id="tab-backups" class="space-y-6">
		if len(vols) == 0 {
			<p class="text-rw-muted text-sm">This instance has no volume yet. The first deploy makes one.</p>
		}
		for _, b := range vols {
			if len(vols) > 1 {
				<h3 class="section-title">{ b.Name }</h3>
			}
			@volume.Backups(b)
		}
	</div>
}

// SettingsView is who may cut a slice here: the allow list and the env
// pairs. Each form posts the whole list or map; a row's × posts it
// without that row.
type SettingsView struct {
	Allow    []string
	Add      string // the add input: "<org>:" or what was typed
	CanAllow bool   // the allow list is an owner's (managed.allow)
	Pairs    []Pair
	AddFrom  string
	AddTo    string
	Envs     []string          // this stack's envs, a pair's right side
	Errors   map[string]string // allow | env_pairs | delete → why the save was refused
	Open     string            // the accordion row open on load: the saved one, or ?open=
}

// Pair is one env pair: a consumer's env → this stack's env.
type Pair struct{ From, To string }

// Settings is the allow list, the env pairs and the danger zone, one
// accordion row each like the other tiles' Settings.
templ Settings(v View, s SettingsView) {
	<div id="tab-settings">
		@c.SettingsAccordion(c.SettingsAcc{ID: "instance-settings", Rows: settingsRows(v, s), Open: s.Open})
	</div>
}

func settingsRows(v View, s SettingsView) []c.AccRow {
	rows := []c.AccRow{
		{Key: "general", Title: "Name", Summary: v.Name, Body: nameRow(v, s)},
		{Key: "allow", Title: "Allow", Summary: AllowSummary(s.Allow), Changed: len(s.Allow) > 0, Body: allowRow(v, s)},
		{Key: "pairs", Title: "Env pairs", Summary: PairsSummary(s.Pairs), Changed: len(s.Pairs) > 0, Body: pairsRow(v, s)},
	}
	if !v.ReadOnly {
		rows = append(rows, c.AccRow{Key: "delete", Title: "Delete", Body: deleteRow(v, s)})
	}
	return rows
}

// AllowSummary is the Allow row closed: its patterns, or who may by default.
func AllowSummary(allow []string) string {
	if len(allow) == 0 {
		return "this environment only"
	}
	return strings.Join(allow, ", ")
}

// PairsSummary is the Env pairs row closed: "staging → dev", or "none".
func PairsSummary(ps []Pair) string {
	if len(ps) == 0 {
		return "none"
	}
	out := make([]string, len(ps))
	for i, p := range ps {
		out[i] = p.From + " → " + p.To
	}
	return strings.Join(out, ", ")
}

templ allowRow(v View, s SettingsView) {
	<p class="text-xs text-rw-faint" data-hint>Who may cut a slice here: org:stack:env:tile patterns, a trailing * for the rest.</p>
	<div class="space-y-4">
		if len(s.Allow) == 0 {
			<p class="text-sm text-rw-muted">No pattern yet: only slice tiles in this environment.</p>
		} else {
			<ul class="space-y-1.5">
				for i, p := range s.Allow {
					<li class="panel px-4 py-2.5 flex items-center gap-3 text-sm" data-field data-changed>
						<span class="flex-1 font-mono text-rw-text break-all">{ p }</span>
						if s.CanAllow {
							<form hx-post={ v.Base + "/allow" } hx-target={ "#" + Root } hx-swap="outerHTML">
								for _, q := range drop(s.Allow, i) {
									<input type="hidden" name="allow" value={ q }/>
								}
								<button type="submit" class="text-rw-faint hover:text-rw-danger" aria-label={ "Remove " + p }>×</button>
							</form>
						}
					</li>
				}
			</ul>
		}
		if s.CanAllow {
			<form hx-post={ v.Base + "/allow" } hx-target={ "#" + Root } hx-swap="outerHTML" class="flex flex-wrap items-end gap-2">
				for _, q := range s.Allow {
					<input type="hidden" name="allow" value={ q }/>
				}
				<div class="flex-1 min-w-48">
					<label for="allow-add" class="label">Add a pattern</label>
					<input id="allow-add" name="add" value={ s.Add } placeholder="acme:shop:*" class="input font-mono" { c.Invalid("allow", s.Errors["allow"])... }/>
				</div>
				<button type="submit" class="btn btn-ghost btn-sm">Add</button>
				<div class="w-full">
					@c.FieldError("allow", s.Errors["allow"])
				</div>
			</form>
		} else {
			<p class="text-xs text-rw-faint" data-hint>Only an owner of the organization changes this list.</p>
		}
	</div>
}

templ pairsRow(v View, s SettingsView) {
	<p class="text-xs text-rw-faint" data-hint>Which of this stack's envs a slice lands in, by the env the slice asks for.</p>
	<div class="space-y-4">
		if len(s.Pairs) == 0 {
			<p class="text-sm text-rw-muted">No pair yet: a slice lands in the env it names.</p>
		} else {
			<ul class="space-y-1.5">
				for i, p := range s.Pairs {
					<li class="panel px-4 py-2.5 flex items-center gap-3 text-sm font-mono" data-field data-changed>
						<span class="text-rw-text">{ p.From }</span>
						<span class="text-rw-faint">→</span>
						<span class="flex-1 text-rw-text">{ p.To }</span>
						if !v.ReadOnly {
							<form hx-post={ v.Base + "/env-pairs" } hx-target={ "#" + Root } hx-swap="outerHTML">
								for _, q := range dropPair(s.Pairs, i) {
									<input type="hidden" name="from" value={ q.From }/>
									<input type="hidden" name="to" value={ q.To }/>
								}
								<button type="submit" class="text-rw-faint hover:text-rw-danger" aria-label={ "Remove " + p.From }>×</button>
							</form>
						}
					</li>
				}
			</ul>
		}
		if v.ReadOnly {
			<p class="text-xs text-rw-faint" data-hint>Only members and owners can change the pairs.</p>
		} else {
		<form hx-post={ v.Base + "/env-pairs" } hx-target={ "#" + Root } hx-swap="outerHTML" class="flex flex-wrap items-end gap-2">
			<input type="hidden" name="adding" value="1"/>
			for _, q := range s.Pairs {
				<input type="hidden" name="from" value={ q.From }/>
				<input type="hidden" name="to" value={ q.To }/>
			}
			<div class="flex-1 min-w-32">
				<label for="pair-from" class="label">Consumer env</label>
				<input id="pair-from" name="add_from" value={ s.AddFrom } placeholder="staging" class="input font-mono" { c.Invalid("env_pairs", s.Errors["env_pairs"])... }/>
			</div>
			<div class="flex-1 min-w-32">
				<label for="pair-to" class="label">This stack's env</label>
				<select id="pair-to" name="add_to" class="input">
					for _, e := range s.Envs {
						<option value={ e } selected?={ e == s.AddTo }>{ e }</option>
					}
				</select>
			</div>
			<button type="submit" class="btn btn-ghost btn-sm">Add</button>
			<div class="w-full">
				@c.FieldError("env_pairs", s.Errors["env_pairs"])
			</div>
		</form>
		}
	</div>
}

// nameRow renames the database; its slices follow it.
templ nameRow(v View, s SettingsView) {
	<form novalidate if !v.ReadOnly { hx-post={ v.Base + "/rename" } } hx-target={ "#" + Root } hx-swap="outerHTML" class="space-y-4">
		@c.Field(c.FieldView{Name: "name", Label: "Name", Value: v.Name, Error: s.Errors["name"], Disabled: v.ReadOnly, Why: "Only members and owners can rename it.", Help: "Its slices follow the new name."})
		if !v.ReadOnly {
			<button type="submit" class="btn btn-primary btn-sm">Rename</button>
		}
	</form>
}

templ deleteRow(v View, s SettingsView) {
	@c.DangerZone("Deleting this database removes its container. Its slice tiles must go first.", v.Name, "The data volume is kept, orphaned for the retention window.") {
		@c.Confirm(remove(v))
	}
	@c.FormError(s.Errors["delete"])
}

// drop is list without its i-th entry.
func drop(list []string, i int) []string {
	return slices.Delete(slices.Clone(list), i, i+1)
}

func dropPair(list []Pair, i int) []Pair {
	return slices.Delete(slices.Clone(list), i, i+1)
}

func remove(v View) c.ConfirmView {
	d := dialog.Delete(v.Name, v.Base+"/delete", "#"+Root)
	d.Button = "Delete database"
	d.Warning = "Its container and domains go. Refused while slice tiles still live on it."
	return d
}
