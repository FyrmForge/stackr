package admin

import (
	"fmt"

	c "github.com/FyrmForge/stackr/internal/ui/components"
	"github.com/FyrmForge/stackr/internal/ui/connectors"
)

// ServerConnector is a server GitHub connector's settings dialog.
// InstallURL "" = the handshake has not finished.
type ServerConnector struct {
	ID, Name, InstallURL string
	All                  bool
	Orgs                 []OrgShare
	Rename, Share        string // POST
	Delete               c.ConfirmView
}

// OrgShare is an organization and whether the connector is shared with it.
type OrgShare struct {
	ID, Name string
	On       bool
}

// ConnectorSettings is the dialog's body: name, sharing, Remove. Each
// answers the whole drawer, which closes the dialog.
templ ConnectorSettings(v ServerConnector) {
	<div id={ connectors.BodyID }>
		<div class="modal-body">
			if v.InstallURL != "" {
				<a href={ templ.SafeURL(v.InstallURL) } target="_blank" rel="noopener noreferrer" class="text-xs text-rw-accent hover:underline">Manage on GitHub</a>
			} else {
				<p class="text-xs text-rw-warn">Not finished on GitHub yet.</p>
			}
			<form hx-post={ v.Rename } hx-target={ target() } hx-swap="outerHTML" class="flex items-end gap-2">
				<div class="grow">
					<label for={ "conn-name-" + v.ID } class="label">Name</label>
					<input id={ "conn-name-" + v.ID } name="name" value={ v.Name } class="input" required/>
				</div>
				<button type="submit" class="btn btn-ghost btn-sm">Rename</button>
			</form>
			<form hx-post={ v.Share } hx-target={ target() } hx-swap="outerHTML" class="space-y-2">
				<fieldset class="space-y-1">
					<legend class="label">Shared with</legend>
					<label class="flex items-center gap-2 text-rw-text"><input type="checkbox" name="all" value="1" checked?={ v.All } class="accent-rw-accent"/> All organizations</label>
					<p class="text-xs text-rw-faint">Every owner of every organization can clone every repository this app is installed on.</p>
					for _, o := range v.Orgs {
						<label class="flex items-center gap-2 text-rw-text"><input type="checkbox" name="org" value={ o.ID } checked?={ o.On } class="accent-rw-accent"/> { o.Name }</label>
					}
				</fieldset>
				<button type="submit" class="btn btn-ghost btn-sm">Save sharing</button>
			</form>
		</div>
		<div class="modal-foot">
			<span class="mr-auto">
				@c.Confirm(v.Delete)
			</span>
			<button type="button" class="btn btn-ghost btn-sm" data-cancel>Close</button>
		</div>
	</div>
}

// InstallStatus is what GitHub answered for a row: the repos the app may
// read, none (not installed, or installed on nothing), or no answer.
templ InstallStatus(repos int, failed bool) {
	switch {
		case failed:
			@c.Chip("GitHub did not answer", "danger")
		case repos == 0:
			@c.Chip("not installed", "warn")
		case repos == 1:
			@c.Chip("installed · 1 repo", "success")
		default:
			@c.Chip(fmt.Sprintf("installed · %d repos", repos), "success")
	}
}
