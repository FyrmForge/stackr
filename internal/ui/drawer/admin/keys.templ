package admin

import c "github.com/FyrmForge/stackr/internal/ui/components"

// KeysView is every key the server holds: the master key, the recovery key,
// the node tunnel keys and the cluster root (Trust.Fingerprint "" = no
// cluster yet).
type KeysView struct {
	Master   MasterKeyView
	Recovery RecoveryView
	Tunnel   TunnelKeysView
	Trust    TrustView
}

// TunnelKeysView is the WireGuard keys between nodes. Every (POST days=)
// sets the schedule, Days the one in force (0 = off) or a refused one as
// typed; Rotate (POST) rotates them all now. "" = may not.
type TunnelKeysView struct {
	Every, Rotate string
	Days          string
}

templ Keys(v KeysView) {
	<div id="tab-keys">
		@MasterKey(v.Master)
		@Recovery(v.Recovery)
		if v.Tunnel.Every != "" {
			@c.Section("Node tunnel keys", "instance", "WireGuard keys between nodes.") {
				<div class="flex flex-wrap items-end gap-2">
					<form hx-post={ v.Tunnel.Every } hx-target={ target() } hx-swap="outerHTML" class="flex items-end gap-2">
						<div>
							<label for="rotate-days" class="label">Rotate every (days)</label>
							<input id="rotate-days" name="days" type="number" min="0" max="365" value={ v.Tunnel.Days } class="input w-24"/>
						</div>
						<button type="submit" class="btn btn-primary btn-sm">Save</button>
					</form>
					<form hx-post={ v.Tunnel.Rotate } hx-target={ target() } hx-swap="outerHTML">
						<button type="submit" class="btn btn-ghost btn-sm">Rotate all now</button>
					</form>
				</div>
				<p class="mt-1.5 text-xs text-rw-faint">0 turns scheduled rotation off.</p>
			}
		}
		if v.Trust.Fingerprint != "" {
			@trustSection(v.Trust)
		}
	</div>
}
