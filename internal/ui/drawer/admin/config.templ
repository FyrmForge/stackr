package admin

import c "github.com/FyrmForge/stackr/internal/ui/components"

// ConfigView is the server file as a tab: the export, the binding form, the
// latest plan with its answers, the queued apply, then the last plans.
type ConfigView struct {
	Base       string // POST /config, /plan; "" = may not bind
	Export     string // GET the stackr-server.yml
	Connectors []ConnectorOption
	Connector  string
	Repo       string
	Branch     string
	Path       string
	Auto       bool
	Refused    bool // the form's last post was refused: its fields stay open
	Unbind     c.ConfirmView // Action "" = nothing bound, or may not
	Job        *c.JobStatusView
	Latest     *ConfigPlan // nil = no plan yet
	Plans      []c.PlanRow // the plans before the latest, newest first
	// Vars is the server variables editor; only the server file reads
	// them. nil = not shown.
	Vars templ.Component
}

type ConnectorOption struct{ Value, Label string }

// ConfigPlan is the latest plan: its row, and the dry run with its answers.
type ConfigPlan struct {
	Row    c.PlanRow
	Review c.PlanReviewView
}

// last is the latest plan's row, nil = no plan yet.
func (v ConfigView) last() *c.PlanRow {
	if v.Latest == nil {
		return nil
	}
	return &v.Latest.Row
}

templ Config(v ConfigView) {
	<div id="tab-config">
		if v.Job == nil || !v.Job.Live {
			@c.LiveTab(Href("config"), "tab-config")
		}
		@c.JobSlot(v.Job, "server-plan,server-apply")
		// a plan that waits comes first; one already decided reads after the facts
		if v.Latest != nil && v.Latest.Row.Status == "pending" {
			@latestPlan(v)
		}
		@c.Section("Config as code", "instance", "One file declares the server. Its plans wait for an admin's approval unless Auto apply is on.") {
			if v.Repo != "" {
				@c.ConfigFacts(c.ConfigFactsView{Repo: v.Repo, Branch: v.Branch, Path: v.Path, File: "stackr-server.yml", Auto: v.Auto, Last: v.last()})
				<details class="mt-4" open?={ v.Refused }>
					<summary class="cursor-pointer text-sm text-rw-muted hover:text-rw-text">Change</summary>
					<div class="mt-3">
						@configForm(v)
					</div>
				</details>
			} else {
				@configForm(v)
			}
			<details class="mt-2">
				<summary class="cursor-pointer text-sm text-rw-muted hover:text-rw-text">Export</summary>
				<div class="mt-3 space-y-3">
					<p class="text-xs text-rw-faint">This server's live state as a stackr-server.yml. Secrets come out as names, never values.</p>
					<a href={ templ.SafeURL(v.Export) } download="stackr-server.yml" class="btn btn-ghost btn-sm">Download stackr-server.yml</a>
				</div>
			</details>
		}
		if v.Latest != nil && v.Latest.Row.Status != "pending" {
			@latestPlan(v)
		}
		if len(v.Plans) > 0 {
			<h2 class="text-sm font-medium text-rw-muted mb-2">Plans</h2>
			<ul class="space-y-2">
				for _, r := range v.Plans {
					<li class="panel px-4 py-3">
						@c.PlanLine(r)
					</li>
				}
			</ul>
		}
		if v.Vars != nil {
			<div class="mt-6">
				@c.Section("Variables and secrets", "instance", "") {
					@v.Vars
				}
			</div>
		}
	</div>
}

templ latestPlan(v ConfigView) {
	@c.Section("Latest plan", "instance", "") {
		<div class="space-y-4">
			@c.PlanLine(v.Latest.Row)
			if v.Latest.Row.Error != "" {
				<div class="banner banner-danger whitespace-pre-wrap font-mono text-xs" role="alert">{ v.Latest.Row.Error }</div>
			} else {
				@c.PlanReview(v.Latest.Review)
			}
		</div>
	}
}

// configForm is the binding fields, Save and plan, Plan now, and Unbind.
// Bound, it is folded behind "Change".
templ configForm(v ConfigView) {
	if len(v.Connectors) == 0 && v.Repo == "" {
		<p class="text-sm text-rw-muted">Create a server connector first, in <a href={ templ.SafeURL(Href("connectors")) } hx-get={ Href("connectors") } hx-target="#main" hx-push-url="true" class="link">Connectors</a>. The server file is fetched through it.</p>
	} else {
		<form novalidate hx-post={ v.Base + "/config" } hx-target={ target() } hx-swap="outerHTML">
			<fieldset disabled?={ v.Base == "" } class="space-y-4">
				<legend class="sr-only">Config repository</legend>
				<div>
					<label for="server-connector" class="label">Connector</label>
					<select id="server-connector" name="connector" class="input">
						<option value="">None</option>
						for _, o := range v.Connectors {
							<option value={ o.Value } selected?={ o.Value == v.Connector }>{ o.Label }</option>
						}
					</select>
				</div>
				@c.Field(c.FieldView{Name: "repo", Label: "Repository", Value: v.Repo, Placeholder: "acme/stackr-server"})
				@c.Field(c.FieldView{Name: "branch", Label: "Branch", Value: v.Branch, Help: "Empty uses the default branch."})
				@c.Field(c.FieldView{Name: "path", Label: "File path", Value: v.Path, Placeholder: "stackr-server.yml", Help: "Empty reads stackr-server.yml."})
				<label class="flex items-center gap-2 text-sm text-rw-text"><input type="checkbox" name="auto" value="1" checked?={ v.Auto } class="accent-rw-accent"/> Auto apply a plan with no impact lines and no removals</label>
				if v.Base != "" {
					<div class="flex flex-wrap items-center gap-2">
						<button type="submit" class="btn btn-primary btn-sm">Save and plan</button>
						if v.Repo != "" {
							<button type="button" class="btn btn-ghost btn-sm" hx-post={ v.Base + "/config/plan" } hx-target={ target() } hx-swap="outerHTML">Plan now</button>
						}
					</div>
				}
			</fieldset>
		</form>
	}
	if v.Unbind.Action != "" {
		<div class="flex flex-wrap items-center gap-2 mt-5 pt-5 border-t border-rw-border">
			@c.Confirm(v.Unbind)
		</div>
	}
}
