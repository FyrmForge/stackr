package admin

import (
	"fmt"
	"strconv"
	"time"

	c "github.com/FyrmForge/stackr/internal/ui/components"
)

// SecurityView is the Security log tab: filters, then one row per audited
// act, newest first. A row opens to the detail the act recorded.
type SecurityView struct {
	Filter  SecurityFilter
	Rows    []SecurityRow
	Actions []AccessOption // the action picker
	Actors  []AccessOption // the actor picker
	Windows []AccessOption // the time picker
	More    string         // GET for older rows; "" = this is all of them
	KeepDays int           // how long events are kept
}

// MasterKeyView is the master key section. Rotate is the POST target; ""
// = may not (the key comes from the environment). Done is the answer to a
// rotation just started.
type MasterKeyView struct {
	Gen            int
	Since          time.Time // zero = never rotated
	Pending        bool
	Rotate         string
	Error, Done    string
}

// SecurityFilter is what the pickers hold now.
type SecurityFilter struct{ Action, Actor, Window string }

// SecurityRow is one event. Refused marks an act that was turned away.
type SecurityRow struct {
	When                  time.Time
	Actor, Action, Target string
	Refused               bool
	Details               []SecurityDetail
}

type SecurityDetail struct{ Label, Value string }

templ Security(v SecurityView) {
	<div id="tab-security">
		@c.Section("", "", fmt.Sprintf("Kept %d days.", v.KeepDays)) {
			<form hx-get={ Href("security-log") } hx-target={ target() } hx-swap="outerHTML" hx-trigger="change" novalidate data-nosubmit class="mb-4 flex flex-wrap gap-2">
				@securityPicker("action", "Action", "Any action", v.Actions, v.Filter.Action)
				@securityPicker("actor", "Actor", "Anyone", v.Actors, v.Filter.Actor)
				@securityPicker("window", "Time", "All time", v.Windows, v.Filter.Window)
			</form>
			if len(v.Rows) == 0 {
				<p class="text-sm text-rw-faint">Nothing matches.</p>
			} else {
				<ul class="divide-y divide-rw-border">
					for _, r := range v.Rows {
						<li class="text-sm">
							<details>
								<summary class="flex cursor-pointer flex-wrap items-center gap-x-3 gap-y-1 py-3">
									<span class="w-28 shrink-0 text-xs text-rw-faint">@c.When(r.When)</span>
									<span class="text-rw-text">{ r.Actor }</span>
									<span class="text-rw-muted">{ r.Action }</span>
									<span class="font-mono text-xs text-rw-muted">{ r.Target }</span>
									<span class="ml-auto">
										if r.Refused {
											@c.Chip("refused", "warn")
										} else {
											@c.Chip("ok", "")
										}
									</span>
								</summary>
								if len(r.Details) > 0 {
									<dl class="grid grid-cols-[8rem_minmax(0,1fr)] [&>dd]:[overflow-wrap:anywhere] gap-x-3 gap-y-1 border-t border-rw-border py-3 text-xs">
										for _, d := range r.Details {
											<dt class="text-rw-faint">{ d.Label }</dt>
											<dd class="whitespace-pre-wrap break-all font-mono text-rw-muted">{ d.Value }</dd>
										}
									</dl>
								}
							</details>
						</li>
					}
				</ul>
				@c.ZoneNote()
				if v.More != "" {
					<button type="button" hx-get={ v.More } hx-target={ target() } hx-swap="outerHTML" class="btn btn-ghost btn-sm mt-3">Show older</button>
				}
			}
		}
	</div>
}

templ securityPicker(name, label, any string, opts []AccessOption, cur string) {
	<select name={ name } class="input w-auto" aria-label={ label }>
		<option value="">{ any }</option>
		for _, o := range opts {
			<option value={ o.Value } selected?={ o.Value == cur }>{ o.Label }</option>
		}
	</select>
}

templ masterKeyDialog(v MasterKeyView) {
	{{ d := keyAsk{
		ID: "master-key-dialog", Button: "Rotate the master key", Title: "Rotate the master key?", Submit: "Rotate",
		Warning: "Every stored secret is sealed again under a new key. The panel restarts, and older backups keep the old key.",
		Action: v.Rotate, Target: "#master-key", Error: v.Error, Open: v.Error != "",
	} }}
	@keyDialog(d) {
		@passwordForm(d)
	}
}

// MasterKey is the master key section; the rotation answers with it alone.
templ MasterKey(v MasterKeyView) {
	<div id="master-key">
		@c.Section("Master key", "instance", "Seals every secret stored on this server.") {
			<div class="space-y-3">
				<p class="text-sm text-rw-muted">
					{ "Key generation " + strconv.Itoa(v.Gen) }
					if !v.Since.IsZero() {
						{ " since " }
						@c.When(v.Since)
					}
					{ "." }
				</p>
				if v.Done != "" {
					<p class="text-sm text-rw-warn" role="status">{ v.Done }</p>
				} else if v.Pending {
					<p class="text-sm text-rw-warn" role="status">A new key is waiting for the panel to restart.</p>
				} else if v.Rotate != "" {
					@masterKeyDialog(v)
				} else {
					<p class="text-sm text-rw-faint">This key is set in the environment.</p>
				}
			</div>
		}
	</div>
}

// keyAsk is a password-confirmed action's modal. Its form posts to
// Action and the answer replaces the whole section (Target), so a refusal
// comes back as the section drawn again with the dialog open on the error,
// and a success without it. Open is set on that answer; the element then
// opens the dialog as it lands.
type keyAsk struct {
	ID, Button, Title, Warning, Submit, Action, Target, Error string
	Open                                                      bool
}

templ keyDialog(d keyAsk) {
	<confirm-dialog open?={ d.Open }>
		<button type="button" class="btn btn-sm btn-primary" data-open disabled>{ d.Button }</button>
		<dialog id={ d.ID } class="modal-panel text-rw-text" aria-labelledby={ d.ID + "-title" }>
			<div class="modal-head">
				<div class="min-w-0">
					<h2 id={ d.ID + "-title" } class="modal-title">{ d.Title }</h2>
				</div>
				<button type="button" class="ml-auto text-rw-faint hover:text-rw-text transition-colors" data-cancel aria-label="Close">
					<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<line x1="18" y1="6" x2="6" y2="18"></line>
						<line x1="6" y1="6" x2="18" y2="18"></line>
					</svg>
				</button>
			</div>
			{ children... }
		</dialog>
	</confirm-dialog>
}

// passwordForm is the ask inside a keyDialog: what the action does, the
// password, and the refusal under it.
templ passwordForm(d keyAsk) {
	<form hx-post={ d.Action } hx-target={ d.Target } hx-swap="outerHTML" class="contents">
		<div class="modal-body">
			<p>{ d.Warning }</p>
			<div>
				<label for={ d.ID + "-password" } class="label">Your password</label>
				<input id={ d.ID + "-password" } name="password" type="password" autocomplete="current-password" class="input" required autofocus { c.Invalid(d.ID+"-password", d.Error)... }/>
				if d.Error != "" {
					<p id={ "error-" + d.ID + "-password" } class="mt-1.5 text-sm text-rw-danger" role="alert">{ d.Error }</p>
				}
			</div>
		</div>
		<div class="modal-foot">
			<button type="button" class="btn btn-ghost btn-sm" data-cancel>Cancel</button>
			<button type="submit" class="btn btn-primary btn-sm">{ d.Submit }</button>
		</div>
	</form>
}
