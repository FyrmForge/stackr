// Package admin is the admin drawer, opened from the nav on any page:
// server settings (the catalogue's install and server knobs), users, the
// self-upgrade, raw Caddy and the panel's own backups.
package admin

import (
	"time"

	c "github.com/FyrmForge/stackr/internal/ui/components"
)

var Tabs = []string{"settings", "users", "nodes", "placements", "access", "security", "routes", "update", "caddy", "backups", "alerts", "config", "params", "connectors", "registry", "observability"}

// Base is where every tab and action lives.
const Base = "/-/admin"

type UsersView struct {
	Rows []User
}

// User is one account. Action URLs are "" when the viewer may not use them.
type User struct {
	Email, Name   string
	Admin, Active bool
	Promote       string // POST, flips admin
	Disable       string // POST
	Enable        string // POST
}

// UpdateView is the self-upgrade. Checked says a check has run (this
// answer, or the last one remembered); the check reaches GitHub, so a tab
// open never runs one.
type UpdateView struct {
	Version  string
	Checked  bool
	// Upgrading: an upgrade is queued, running, or this panel is about to
	// be swapped for the new one; no buttons until it is back.
	Upgrading bool
	// Live is the tab's GET, re-polled while something moves (an upgrade,
	// a rollout) so a panel restart cannot leave it stale; "" = settled.
	Live string
	Latest   string // "" after a check = a dev build
	Newer    bool
	CheckErr string
	Run      c.ConfirmView // Action "" = may not run
	Job      *c.JobStatusView
	Workers  *WorkersView // nil = no workers to roll out to
}

// WorkersView is the worker rollout: one row per worker. Action (POST) is the
// Update workers button, or Retry after a stop; "" = nothing to offer.
type WorkersView struct {
	Stopped string // "h3 failed to upgrade, rolled back"; "" = not stopped
	Running bool   // a rollout job is queued or running
	Pending bool   // the panel starts the rollout itself once its image is published
	Rows    []WorkerRow
	Action  string
	Button  string
}

// WorkerRow is one worker. State is waiting, upgrading, done, failed or
// skipped; "" = never rolled. Behind says its build is not the panel's.
type WorkerRow struct {
	Name, Current, State, Error string
	Behind                      bool
}

// live: the tab follows something, a poll or a job stream, that a panel
// restart breaks; main.js shows Reconnecting and holds the buttons then.
func live(v UpdateView) bool { return v.Live != "" || (v.Job != nil && v.Job.Live) }

func workerTone(r WorkerRow) string {
	switch r.State {
	case "done":
		return "success"
	case "failed":
		return "danger"
	case "upgrading", "waiting", "skipped":
		return "warn"
	}
	if r.Behind {
		return "warn"
	}
	return ""
}

func workerState(r WorkerRow) string {
	switch {
	case r.State != "":
		return r.State
	case r.Behind:
		return "behind"
	}
	return "up to date"
}

type CaddyView struct {
	Action string // POST value; "" = read-only
	Sync   string // POST; "" = may not
	Value  string
}

// BackupsView is v0's admin backups: the install's destinations, then the
// panel's own database.
type BackupsView struct {
	Dests c.DestsView
	Now   string // POST; "" = may not
	Job   *c.JobStatusView
	Rows  []Backup
	Sched PanelSchedule
}

// PanelSchedule is the panel backup's switch, cron line, how many archives
// stay and where they go. Action "" = read-only.
type PanelSchedule struct {
	Action, Schedule, Keep, Dest string
	Enabled                      bool
	Dests                        []DestOption
}

type DestOption struct{ Value, Label string }

type Backup struct {
	Status, Trigger, Size, Error, Dest string
	When                              time.Time
}

func target() string { return "#" + c.DrawerRoot }

templ Users(v UsersView) {
	<div id="tab-users">
		@c.Section("Users", "instance", "Server admins bypass every organization check. To invite someone to an organization, use that organization's settings.") {
			<ul class="space-y-2">
				for _, u := range v.Rows {
					<li class="panel px-4 py-3 text-sm flex flex-wrap items-center gap-2">
						<span class="text-rw-text">{ nameOr(u.Name, u.Email) }</span>
						if u.Name != "" {
							<span class="text-rw-faint">{ u.Email }</span>
						}
						if u.Admin {
							@c.Chip("admin", "accent")
						}
						if !u.Active {
							@c.Chip("disabled", "danger")
						}
						<span class="ml-auto flex items-center gap-2">
							if u.Promote != "" {
								@c.PostButton(promoteLabel(u.Admin), u.Promote)
							}
							if u.Disable != "" {
								@c.Confirm(c.ConfirmView{
									Button:  "Disable",
									Title:   "Disable " + u.Email + "?",
									Warning: "Their sessions and API keys stop working at once.",
									Action:  u.Disable,
									Target:  target(),
								})
							}
							if u.Enable != "" {
								@c.Confirm(c.ConfirmView{
									Button:  "Enable",
									Title:   "Enable " + u.Email + "?",
									Warning: "Their old sessions and API keys stay revoked.",
									Action:  u.Enable,
									Target:  target(),
								})
							}
						</span>
					</li>
				}
			</ul>
		}
	</div>
}

func nameOr(name, email string) string {
	if name != "" {
		return name
	}
	return email
}

func promoteLabel(admin bool) string {
	if admin {
		return "Remove admin"
	}
	return "Make admin"
}

templ Update(v UpdateView) {
	<div id="tab-update" data-live?={ live(v) }>
		if v.Live != "" {
			<span hidden hx-get={ v.Live } hx-trigger="every 3s" hx-select="#tab-update" hx-target="#tab-update" hx-swap="outerHTML"></span>
		}
		@c.Section("Update", "instance", "Backs up the panel, then restarts it on the new release.") {
			<div class="space-y-3 text-sm">
				if live(v) {
					<p class="text-rw-warn" role="status" data-reconnecting hidden>Reconnecting...</p>
				}
				<p class="text-rw-text">Running <span class="font-mono">{ v.Version }</span></p>
				if v.CheckErr != "" {
					<p class="text-rw-danger" role="status">Could not check for an update: { v.CheckErr }</p>
				} else if v.Checked && v.Latest == "" {
					<p class="text-rw-muted">A dev build cannot upgrade itself. Run stackr-install from the release to move this box onto it.</p>
				} else if v.Checked && v.Newer {
					<p class="flex items-center gap-2">
						@c.Chip("update available", "warn")
						<span class="font-mono text-rw-text">{ v.Latest }</span>
					</p>
					if v.Run.Action != "" {
						@c.Confirm(v.Run)
					}
				} else if v.Checked {
					<p class="text-rw-muted">Up to date: <span class="font-mono">{ v.Latest }</span> is the latest release.</p>
				}
				if v.Upgrading {
					<p class="text-rw-text" role="status">Upgrading. The panel restarts and this tab reloads when it is back.</p>
				}
				if v.Job != nil {
					@c.JobStatus(*v.Job)
				}
				if !v.Upgrading && !v.Checked {
					@c.PostButton("Check for update", Base+"/update/check")
				} else if !v.Upgrading && (v.Latest != "" || v.CheckErr != "") {
					@c.PostButton("Check again", Base+"/update/check")
				}
			</div>
		}
		if v.Workers != nil {
			@c.Section("Workers", "instance", "Each worker upgrades one at a time and rolls back if it fails.") {
				if v.Workers.Stopped != "" {
					<p class="mb-3 text-sm text-rw-danger" role="status">{ v.Workers.Stopped }</p>
				}
				if v.Workers.Pending {
					<p class="mb-3 text-sm text-rw-muted" role="status">The rollout starts once the panel's image is published.</p>
				}
				<ul class="space-y-2 mb-3">
					for _, r := range v.Workers.Rows {
						<li class="panel px-4 py-2 text-sm">
							<div class="flex flex-wrap items-center gap-3">
								<span class="text-rw-text font-medium">{ r.Name }</span>
								if r.Current != "" {
									<span class="font-mono text-xs text-rw-muted">{ r.Current }</span>
								}
								<span class="ml-auto">@c.Chip(workerState(r), workerTone(r))</span>
							</div>
							if r.Error != "" {
								<p class="mt-1 text-xs text-rw-danger">{ r.Error }</p>
							}
						</li>
					}
				</ul>
				if v.Workers.Action != "" {
					@c.PrimaryPost(v.Workers.Button, v.Workers.Action)
				}
			}
		}
	</div>
}

// RoutesView is the admin's routes: hosts that go to an address outside
// stackr. Add "" = read-only.
type RoutesView struct {
	Add  string // POST the new route
	Rows []Route
}

// Route is one row; Remove.Action "" = may not.
type Route struct {
	Host, Mode, Target string
	Insecure           bool
	Remove             c.ConfirmView
}

templ Routes(v RoutesView) {
	<div id="tab-routes">
		if v.Add != "" {
			@c.Section("Add a route", "instance", "Pass-through sends raw TLS by name and keeps the target's own certificate. http and https terminate TLS here.") {
				<form hx-post={ v.Add } hx-target={ target() } hx-swap="outerHTML" class="space-y-4">
					@c.Field(c.FieldView{Name: "route_host", Label: "Host", Placeholder: "pve.example.com", Required: true, Help: "*.example.com works for pass-through."})
					<div>
						<label for="route_mode" class="label">Mode</label>
						<select id="route_mode" name="route_mode" class="input">
							<option value="passthrough">passthrough</option>
							<option value="http">http</option>
							<option value="https">https</option>
						</select>
					</div>
					@c.Field(c.FieldView{Name: "route_target", Label: "Target", Placeholder: "192.168.1.10:8006", Required: true, Help: "host or host:port. Port defaults to 80 for http, 443 otherwise."})
					<label class="flex items-center gap-2 text-sm text-rw-text"><input type="checkbox" name="route_insecure" value="1" class="accent-rw-accent"/> Do not verify the target's certificate (https only)</label>
					<button type="submit" class="btn btn-primary btn-sm">Add route</button>
				</form>
			}
		}
		@c.Section("Routes", "instance", "Hosts that go to an address outside stackr.") {
			if len(v.Rows) == 0 {
				<p class="text-sm text-rw-faint">No routes yet.</p>
			} else {
				<ul class="space-y-2">
					for _, r := range v.Rows {
						<li class="panel px-4 py-3 text-sm flex flex-wrap items-center gap-2">
							<span class="text-rw-text">{ r.Host }</span>
							@c.Chip(r.Mode, "")
							if r.Insecure {
								@c.Chip("unverified", "warn")
							}
							<span class="font-mono text-xs text-rw-faint truncate">{ r.Target }</span>
							if r.Remove.Action != "" {
								<span class="ml-auto">
									@c.Confirm(r.Remove)
								</span>
							}
						</li>
					}
				</ul>
			}
		}
	</div>
}

templ Caddy(v CaddyView) {
	<div id="tab-caddy">
		@c.Section("Extra Caddy config", "instance", "A JSON array of Caddy routes, added after stackr's own. Per-domain raw Caddy lives in a tile's domains tab.") {
			<form hx-post={ v.Action } hx-target={ target() } hx-swap="outerHTML" class="space-y-3">
				<label for="proxy_custom" class="sr-only">Extra Caddy config (proxy_custom)</label>
				<textarea id="proxy_custom" name="proxy_custom" rows="12" class="input font-mono text-xs" placeholder="[]" disabled?={ v.Action == "" }>{ v.Value }</textarea>
				if v.Action != "" {
					<button type="submit" class="btn btn-primary btn-sm">Save</button>
				}
			</form>
			if v.Sync != "" {
				<div class="mt-5 pt-5 border-t border-rw-border">
					@c.PostButton("Re-push the proxy config", v.Sync)
				</div>
			}
		}
	</div>
}

templ Backups(v BackupsView) {
	<div id="tab-backups">
		@c.Dests(v.Dests)
		@c.Section("Stackr's own database", "instance", "A consistent copy of the panel database, taken while it is serving. The archive carries the master key that decrypts every secret in it, so keep it somewhere private. Restore it on the host with stackr-install restore.") {
			<div class="space-y-3">
				if v.Sched.Action != "" {
					<form hx-post={ v.Sched.Action } hx-target={ target() } hx-swap="outerHTML" class="space-y-3">
						<label class="flex items-center gap-2 text-sm text-rw-text"><input type="checkbox" id="panel_backup_enabled" name="panel_backup_enabled" value="1" checked?={ v.Sched.Enabled } class="accent-rw-accent"/> Back up on a schedule</label>
						@c.Field(c.FieldView{Name: "panel_backup_schedule", Label: "Schedule", Value: v.Sched.Schedule, Help: "Five-field cron. Empty is 3:00 daily."})
						@c.Field(c.FieldView{Name: "panel_backup_keep", Label: "Keep", Type: "number", Value: v.Sched.Keep, Help: "Archives kept at the destination."})
						<div>
							<label for="panel_backup_dest" class="label">Destination</label>
							<select id="panel_backup_dest" name="panel_backup_dest" class="input">
								<option value="" selected?={ v.Sched.Dest == "" }>Local</option>
								for _, d := range v.Sched.Dests {
									<option value={ d.Value } selected?={ v.Sched.Dest == d.Value }>{ d.Label }</option>
								}
							</select>
						</div>
						<button type="submit" class="btn btn-primary btn-sm">Save</button>
					</form>
				}
				if len(v.Rows) == 0 {
					<p class="text-sm text-rw-muted">Last run: none yet.</p>
				} else {
					<p class="text-sm text-rw-muted">
						{ "Last run: " }
						@c.Time(v.Rows[0].When, "Jan 2 15:04")
						{ ", " + v.Rows[0].Status + ", to " + v.Rows[0].Dest + "." }
					</p>
				}
				if v.Now != "" {
					<form hx-post={ v.Now } hx-target={ target() } hx-swap="outerHTML" class="flex flex-wrap items-center gap-2">
						<label for="backup_now_dest" class="text-sm text-rw-muted">Destination</label>
						<select id="backup_now_dest" name="dest" class="input w-auto">
							<option value="local" selected?={ v.Sched.Dest == "" }>Local</option>
							for _, d := range v.Sched.Dests {
								<option value={ d.Value } selected?={ v.Sched.Dest == d.Value }>{ d.Label }</option>
							}
						</select>
						<button type="submit" class="btn btn-ghost btn-sm">Back up now</button>
					</form>
				}
				if v.Job != nil {
					@c.JobStatus(*v.Job)
				}
				if len(v.Rows) == 0 {
					<p class="text-sm text-rw-muted">No panel backups yet.</p>
				} else {
					<ul class="space-y-2">
						for _, b := range v.Rows {
							<li class="panel px-4 py-3 text-sm flex flex-wrap items-center gap-2">
								@c.JobBadge(b.Status)
								<span class="text-rw-text">@c.Time(b.When, "Jan 2 15:04")</span>
								<span class="text-rw-faint">{ b.Trigger }, { b.Dest }</span>
								if b.Error != "" {
									<span class="text-xs text-rw-danger">{ b.Error }</span>
								}
								<span class="ml-auto font-mono text-xs text-rw-muted">{ b.Size }</span>
							</li>
						}
					</ul>
				}
			</div>
		}
	</div>
}
