package admin

import (
	"fmt"
	"strings"
	"time"

	c "github.com/FyrmForge/stackr/internal/ui/components"
)

// NodesView is the Nodes section. Add "" = may not add a node.
type NodesView struct {
	Add   string // GET: opens the add-node steps
	// Placements is the Placements section, for the lost envs' hint.
	Placements string
	Lost       []LostEnvRow
	// Pending are the machines that called in and wait for a confirm.
	Pending []PendingRow
	Rows  []NodeRow
	Adder *AddNodeView // the open add-node steps, nil = closed
}

// TrafficView is the Traffic section: the cluster-wide default ingress and
// exit (nil = a single node, nothing to pick), then the external routes.
type TrafficView struct {
	Defaults *DefaultsView
	Routes   RoutesView
}

// TrustView is the cluster root in the Keys section: the root, the
// rotate, break glass and revoke buttons, and the nodes break glass left
// unjoined. A ConfirmView with no Action is not offered.
type TrustView struct {
	Fingerprint                   string
	Expires                       time.Time // years out: its date with the year
	Created                       time.Time
	RollingOver                   bool
	Since                         time.Time // when the rollover started
	OnOldRoot                     []string // node names still on the old root
	BreakGlassAt                  time.Time // zero = never
	Rotate, Finish                c.ConfirmView
	BreakGlass, RevokeController  c.ConfirmView
	NotRejoined                   []NotRejoinedRow
}

// NotRejoinedRow is a node waiting for its rejoin command. Command is set on
// the row whose command was just made.
type NotRejoinedRow struct {
	Name, Rejoin       string // Rejoin is a POST
	Command, Expires   string
	TwoStep            string // the command without the panel's script; "" = not needed
}

// DefaultsView is the "Default ingress / exit" control. Each form POSTs node=.
type DefaultsView struct {
	IngressAction, ExitAction string
	Ingress, Exit             string // node id in force; Exit "" = each node's own uplink
	IngressNodes, ExitNodes   []Option
	// Preview is the DNS check of a switch to a node, nil = none asked. The
	// ingress form posts to IngressAction for it; Confirm then moves the default.
	Preview *IngressPreview
}

// IngressPreview is what moving the default ingress to Node changes: the hosts
// that follow it, panel domain first, and where each points now.
type IngressPreview struct {
	Node, PanelNote, Cancel string // PanelNote "The panel moves to h4." ; "" = no panel domain
	Hosts                   []IngressHostRow
	Confirm                 c.ConfirmView
}

// IngressHostRow is one host. Points reads "points here", "points to 1.2.3.4"
// or the lookup's failure; OK says it already points at the node.
type IngressHostRow struct {
	Host, Points string
	OK           bool
}

// BreakGlassBody is the break glass dialog's tick: on by default, it makes the
// dialog queue a backup of every node instead of breaking glass.
templ BreakGlassBody() {
	<label class="flex items-center gap-2 text-rw-text"><input type="checkbox" name="backup" value="on" checked class="accent-rw-accent"/> Back up every node first</label>
	<p class="text-xs text-rw-muted">Ticked, this only queues the backups. Break glass again once they finish, with the box unticked.</p>
}

templ ingressPreview(p IngressPreview) {
	<div class="panel px-4 py-3 mb-3 text-sm space-y-3" id="ingress-preview">
		<h3 class="font-semibold text-rw-text">Move the default ingress to { p.Node }</h3>
		if p.PanelNote != "" {
			<p class="text-rw-muted">{ p.PanelNote }</p>
		}
		if len(p.Hosts) == 0 {
			<p class="text-rw-faint">No hosts use the default ingress.</p>
		} else {
			<table class="w-full text-left">
				<thead><tr class="text-xs text-rw-muted"><th scope="col" class="font-normal pr-3">Host</th><th scope="col" class="font-normal">Points</th></tr></thead>
				<tbody>
					for _, h := range p.Hosts {
						<tr>
							<td class="font-mono text-xs text-rw-text pr-3">{ h.Host }</td>
							<td class={ "text-xs", templ.KV("text-rw-success", h.OK), templ.KV("text-rw-warn", !h.OK) }>{ h.Points }</td>
						</tr>
					}
				</tbody>
			</table>
		}
		<div class="flex gap-2">
			<button type="button" hx-get={ p.Cancel } hx-target={ target() } hx-swap="outerHTML" class="btn btn-ghost btn-sm">Cancel</button>
			@c.Confirm(p.Confirm)
		</div>
	</div>
}

// NodeRow is one node card. Open is a GET that answers the node drawer,
// which opens over the page; Push is the URL it leaves (?drawer=node:<id>).
type NodeRow struct {
	Name, Role, Status, Open string
	Push                     string
	Hint                     string // what to do about Status, NodeHint's
	Tags                     []string
	Envs                     int
	Disk                     string // "34 GB free", "" = not reported
	Cores, Mem               string // "4 cores", "8 GB"
}

// LostEnvRow is an env of a forgotten node. It comes back by repointing its
// placement; Open is a GET to the Placements tab.
type LostEnvRow struct {
	Path, Node, Placement string
	Volumes               int
}

// Option is a select choice.
type Option struct{ Value, Label string }

// AddNodeView is the three steps: Step 1 asks name and tags, 2 shows the
// command and waits, 3 confirms the machine that called in.
type AddNodeView struct {
	Step  int
	Error string
	// Step 1
	Name       string
	// Address is the node's own DNS name; AddressSuffix (".<panel address>",
	// "" = none) follows the name as it is typed until the field is edited.
	Address, AddressSuffix, AddressError string
	Tags       []string // the choices
	Picked     []string
	Create     string // POST name, tag
	Cancel     string // GET: closes the steps
	// Step 2
	Command string
	TwoStep string // "" = not needed
	Expires string
	Poll    string // GET, 204 until the node has called in
	// Step 3
	Pending *PendingRow
	// Target is what the steps' answers replace; "" = the drawer (the
	// setup wizard's Nodes step puts its own here).
	Target string
}

func (v AddNodeView) target() string {
	if v.Target != "" {
		return v.Target
	}
	return target()
}

// PendingRow is a machine that called in and waits for a confirm. System
// "" = it reported none; Confirm and Reject are POSTs.
type PendingRow struct {
	Name, System, Confirm, Reject string
	Requested                     string // "5 min ago"
	Addresses, Tags               []string
}

// NodeView is the node drawer's body. Only the active tab's fields are set.
type NodeView struct {
	ID, Name, Role, Status string
	Hint                   string // what to do about Status, NodeHint's
	Controller             bool
	Tags                   []string
	// Overview
	Range, WGAddress               string
	Docker, Kernel, Disk, Uptime   string
	Version, LastSeen, CertExpiry  string // Version "" = not reported
	Arch, Mem                      string
	Cores                          int
	HasFacts                       bool
	Behind, TooOld, CertExpired    bool // the build is not the panel's; not one it allows; no live certificate
	Warnings                       []WarningRow // what is off on the node, said in full
	// Backup is the Back up node POST; Backups its groups, newest first; Job
	// the job an action just queued.
	Backup  string
	Backups []BackupGroupRow
	Job     *c.JobStatusView
	Tunnels                        []TunnelRow
	// Metrics: the node's live graphs; MemTotal and DiskTotal the newest
	// sizes, for the chart titles ("" when unknown)
	Metrics             c.MetricsView
	MemTotal, DiskTotal string
	// Envs
	Envs []NodeEnvRow
	// Network
	Ifaces []IfaceRow
	// Tags
	TagsAction  string // POST tag=, exit=
	// PublicIP is the DNS records' address override ("" = detected);
	// DownDomains the domains it serves while it is down.
	PublicIP, PublicIPAction string
	DownDomains              []DownDomainRow
	// Address is the node's own DNS name (AddressAction posts node_address).
	// Managed: stackr writes AddressRecords; else they are the records to
	// set by hand. NoPublic: no public address, so no record.
	Address, AddressAction, AddressError string
	AddressManaged, AddressNoPublic      bool
	AddressRecords                       []RecordRow
	Exits       [3]string // default exit picks by node name, "" = none
	ExitNodes   []Option  // nodes tagged egress, Value = name
	AllTags     []string
	RoutesNote  string
	// Security
	Certs  []CertRow
	Rotate      string // POST: replace the node's mesh keys
	Rejoin      string // POST: a new join command; "" = the controller
	JoinCommand string // the answer, shown once
	JoinTwoStep string
	JoinExpires string
	Remove c.ConfirmView
	Forget c.ConfirmView
	Back   string
}

// BackupGroupRow is one node backup: its volumes sit in a details element.
type BackupGroupRow struct {
	Label, Status, Dest, Warning, Error string
	Volumes                             []BackupVolumeRow
}

type BackupVolumeRow struct{ Volume, Where, Method, Status, Size, Error string }

type NodeEnvRow struct {
	Path, Pin string
	Tiles     int
}

// RecordRow is one DNS record.
type RecordRow struct{ Type, Host, Value string }

// addressEdited says the Address was typed, not the name's default: it
// stops following the name.
func addressEdited(v AddNodeView) bool {
	return v.Address != "" && v.Address != v.Name+v.AddressSuffix
}

// DownDomainRow is a domain a down ingress node serves; Move opens its
// env's Placement tab, where the ingress moves.
type DownDomainRow struct{ Host, Env, Move string }

// IfaceRow is one address; Group is a service.Iface* constant.
type IfaceRow struct{ Group, Name, Addr, Label string }

// TunnelRow is one peer of the node. Open is a GET answering the tunnel drawer.
type TunnelRow struct{ Name, Dials, Ping, Open string }

type CertRow struct {
	Serial, Expires, RenewFrom, State string
	Issued                           time.Time
}

// WarningRow is one of the node's warnings, said in full.
type WarningRow struct {
	Detail   string
	Critical bool
}

// ForgetBody is the list inside the forget dialog.
type ForgetBody struct {
	Name string
	Lost []string
}

// versionNote reads "0.6.0-dev.12, behind" or "0.6.0-dev.9, too old".
func versionNote(v NodeView) string {
	ver := v.Version
	if ver == "" {
		ver = "not reported"
	}
	switch {
	case v.TooOld:
		return ver + ", too old"
	case v.Behind:
		return ver + ", behind"
	}
	return ver
}

func plural(n int, one string) string {
	if n == 1 {
		return fmt.Sprintf("%d %s", n, one)
	}
	return fmt.Sprintf("%d %ss", n, one)
}

func statusTone(s string) string {
	switch s {
	case "online":
		return "success"
	case "joined", "tunnel-down", "not-rejoined", "needs-rejoin", "rejoining":
		return "warn"
	}
	return "danger"
}

// statusDot and statusText spell every class in full so tailwind keeps them;
// the tones match the cluster map's.
func statusDot(s string) string {
	switch statusTone(s) {
	case "success":
		return "bg-rw-success"
	case "warn":
		return "bg-rw-warn"
	}
	return "bg-rw-danger"
}

func statusText(s string) string {
	switch statusTone(s) {
	case "success":
		return "text-rw-success"
	case "warn":
		return "text-rw-warn"
	}
	return "text-rw-danger"
}

// ifaces are the rows of one group.
func ifaces(rows []IfaceRow, group string) []IfaceRow {
	var out []IfaceRow
	for _, r := range rows {
		if r.Group == group {
			out = append(out, r)
		}
	}
	return out
}

// NodeHint is what to do about a node's status, "" for nothing. stalled is
// a joined node never seen past the wait (service NodeCard.Stalled).
func NodeHint(status string, stalled bool) string {
	switch {
	case status == "joined" && stalled:
		return "Run the join again on the box. It picks up where it stopped."
	case status == "needs-rejoin":
		return "Run the join command on the box. Lost it? Get a new one under Security."
	case status == "rejoining":
		return "It called in. Add it under Waiting to join."
	}
	return ""
}

// StatusWord is a node status as people read it.
func StatusWord(s string) string {
	switch s {
	case "online":
		return "Online"
	case "joined":
		return "Joined, not seen yet"
	case "tunnel-down":
		return "Tunnel down, host alive"
	case "cert-expired":
		return "Certificate expired: rejoin"
	case "not-rejoined":
		return "Not rejoined"
	case "needs-rejoin", "rejoining":
		return "Waiting to rejoin"
	}
	return strings.ToUpper(s[:1]) + s[1:]
}

func picked(v *AddNodeView, t string) bool {
	for _, p := range v.Picked {
		if p == t {
			return true
		}
	}
	return false
}

templ Nodes(v NodesView) {
	<div id="tab-nodes">
		if len(v.Lost) > 0 {
			@c.Section("Lost envs", "instance", "Their node was forgotten. Repoint the placement they belong to and they come back from backups.") {
				<ul class="space-y-3">
					for _, l := range v.Lost {
						<li class="panel px-4 py-3 text-sm flex flex-wrap items-center gap-2">
							<span class="text-rw-text">{ l.Path }</span>
							@c.Chip(l.Node+" was forgotten", "warn")
							<span class="text-xs text-rw-muted">placement { l.Placement }</span>
							<span class="text-xs text-rw-faint">{ plural(l.Volumes, "volume") }</span>
						</li>
					}
				</ul>
				if v.Placements != "" {
					<a href={ templ.SafeURL(v.Placements) } hx-get={ v.Placements } hx-target="#main" hx-push-url="true" class="btn btn-primary btn-sm mt-3">Open placements</a>
				}
			}
		}
		if len(v.Pending) > 0 {
			@c.Section("Waiting to join", "instance", "Machines that ran a join command. Add the ones you expect, reject the rest.") {
				<ul class="space-y-3">
					for _, p := range v.Pending {
						<li class="panel px-4 py-3 text-sm space-y-2">
							<div class="flex flex-wrap items-center gap-2">
								<span class="text-rw-text font-medium">{ p.Name }</span>
								for _, t := range p.Tags {
									@c.Chip(t, "accent")
								}
								<span class="ml-auto">@c.Chip("pending", "warn")</span>
							</div>
							<p class="text-xs text-rw-muted">
								called in { p.Requested }
								if p.System != "" {
									· { p.System }
								}
							</p>
							if len(p.Addresses) > 0 {
								<p class="font-mono text-xs text-rw-text break-all">{ strings.Join(p.Addresses, ", ") }</p>
							}
							<div class="flex gap-2">
								<form hx-post={ p.Reject } hx-target={ target() } hx-swap="outerHTML">
									<button type="submit" class="btn btn-ghost btn-sm">Reject</button>
								</form>
								<form hx-post={ p.Confirm } hx-target={ target() } hx-swap="outerHTML">
									<button type="submit" class="btn btn-primary btn-sm">Add { p.Name }</button>
								</form>
							</div>
						</li>
					}
				</ul>
			}
		}
		@c.Section("", "", "") {
			if v.Adder != nil {
				@AddNode(*v.Adder)
			}
			<ul class="space-y-3">
				for _, r := range v.Rows {
					<li class="panel px-4 py-3 text-sm">
						<div class="flex flex-wrap items-center gap-2">
							<button type="button" hx-get={ r.Open } hx-target="#drawer-body" hx-push-url={ r.Push } class="text-rw-text font-medium hover:underline">{ r.Name }</button>
							@c.Chip(r.Role, "")
							for _, t := range r.Tags {
								@c.Chip(t, "accent")
							}
							if len(r.Tags) == 0 {
								<span class="text-xs text-rw-faint">no tags</span>
							}
							<span class="ml-auto">@c.Chip(StatusWord(r.Status), statusTone(r.Status))</span>
						</div>
						if r.Hint != "" {
							<p class="mt-2 text-xs text-rw-warn">{ r.Hint }</p>
						}
						<p class="mt-2 text-xs text-rw-muted">
							{ plural(r.Envs, "env") }
							if r.Cores != "" {
								· { r.Cores } · { r.Mem }
							}
							if r.Disk != "" {
								· { r.Disk }
							}
						</p>
					</li>
				}
			</ul>
			if len(v.Rows) == 1 && v.Adder == nil {
				<div class="mt-4">
					<p class="text-rw-text">Only this server so far</p>
					<p class="text-sm text-rw-muted">Add a node to run envs on another machine.</p>
				</div>
			}
			if v.Add != "" && v.Adder == nil {
				<div class="mt-4">
					<button type="button" hx-get={ v.Add } hx-target={ target() } hx-swap="outerHTML" class="btn btn-primary btn-sm">Add node</button>
				</div>
			}
		}
	</div>
}

templ trustSection(t TrustView) {
	@c.Section("Cluster root", "instance", "Signs every node certificate.") {
		<dl class="panel px-4 py-3 text-sm grid grid-cols-[8rem_minmax(0,1fr)] [&>dd]:[overflow-wrap:anywhere] gap-y-1 mb-3">
			<dt class="text-rw-muted">Root</dt>
			<dd class="font-mono text-xs text-rw-text break-all">{ t.Fingerprint }</dd>
			<dt class="text-rw-muted">Created</dt>
			<dd class="text-rw-text">@c.When(t.Created)</dd>
			<dt class="text-rw-muted">Expires</dt>
			<dd class="text-rw-text">@c.Time(t.Expires, "Jan 2, 2006")</dd>
			<dt class="text-rw-muted">Rollover</dt>
			<dd class="text-rw-text">
				if t.RollingOver {
					{ "Running since " }
					@c.When(t.Since)
					{ ". " }
					if len(t.OnOldRoot) > 0 {
						Still on the old root: { strings.Join(t.OnOldRoot, ", ") }.
					}
				} else {
					None running.
				}
			</dd>
			if !t.BreakGlassAt.IsZero() {
				<dt class="text-rw-muted">Break glass</dt>
				<dd class="text-rw-text">@c.When(t.BreakGlassAt)</dd>
			}
		</dl>
		<div class="flex flex-wrap gap-2">
			@c.Confirm(t.Rotate)
			if t.RollingOver {
				@c.Confirm(t.Finish)
			}
			@c.Confirm(t.RevokeController)
			@c.Confirm(t.BreakGlass)
		</div>
		if len(t.NotRejoined) > 0 {
			<h3 class="mt-4 mb-2 text-sm font-semibold text-rw-text">Not rejoined</h3>
			<p class="mb-2 text-xs text-rw-muted">Run each command on its machine as root. A command works once.</p>
			<ul class="space-y-2">
				for _, r := range t.NotRejoined {
					<li class="panel px-4 py-3 text-sm space-y-2">
						<div class="flex flex-wrap items-center gap-2">
							<span class="text-rw-text">{ r.Name }</span>
							@c.Chip("Not rejoined", "warn")
							<form hx-post={ r.Rejoin } hx-target={ target() } hx-swap="outerHTML" class="ml-auto">
								<button type="submit" class="btn btn-ghost btn-sm">Rejoin command</button>
							</form>
						</div>
						if r.Command != "" || r.TwoStep != "" {
							<p class="text-xs text-rw-muted">Expires { r.Expires }.</p>
							@joinCommand(r.Command, r.TwoStep)
						}
					</li>
				}
			</ul>
		}
	}
}

templ addSteps(step int) {
	<ol class="flex items-center gap-4 text-xs text-rw-muted mb-4">
		for i, s := range []string{"Name", "Run the command", "Confirm"} {
			<li class={ templ.KV("text-rw-text font-medium", i+1 == step) }>{ fmt.Sprint(i+1) } { s }</li>
		}
	</ol>
}

// AddNode is the add-node dialog's body: the three steps on the join API.
templ AddNode(v AddNodeView) {
	<div id="add-node" class="panel px-4 py-4 mb-4 space-y-4" if v.Step == 2 { hx-get={ v.Poll } hx-trigger="every 3s" hx-target="#add-node" hx-swap="outerHTML" }>
		<h3 class="text-sm font-semibold text-rw-text">Add a node</h3>
		@addSteps(v.Step)
		if v.Error != "" {
			<p class="text-sm text-rw-danger" role="alert">{ v.Error }</p>
		}
		switch v.Step {
			case 1:
				<form hx-post={ v.Create } hx-target={ v.target() } hx-swap="outerHTML" class="space-y-4">
					@c.Field(c.FieldView{Name: "name", Label: "Name", Value: v.Name, Placeholder: "vps-fsn1", Help: "Lowercase, used in placements and the CLI."})
					<div data-field>
						<label for="node_address" class="label">Address</label>
						<input id="node_address" name="node_address" type="text" value={ v.Address } placeholder={ "vps-fsn1" + v.AddressSuffix } class="input font-mono" data-follows="name" data-suffix={ v.AddressSuffix } data-edited?={ addressEdited(v) } { c.Invalid("node_address", v.AddressError)... }/>
						<p class="mt-1.5 text-xs text-rw-faint" data-hint>The node's own name. Optional.</p>
						@c.FieldError("node_address", v.AddressError)
					</div>
					<fieldset class="space-y-1">
						<legend class="label">Tags</legend>
						for _, t := range v.Tags {
							<label class="flex items-center gap-2 text-rw-text"><input type="checkbox" name="tag" value={ t } checked?={ t == "egress" || picked(&v, t) } disabled?={ t == "egress" } class="accent-rw-accent"/> { t }if t == "egress" {
								<span class="text-xs text-rw-faint">Every node starts with egress.</span>
							}</label>
						}
						<p class="text-xs text-rw-faint">You can change these later.</p>
					</fieldset>
					<div class="flex gap-2">
						<button type="button" hx-get={ v.Cancel } hx-target={ v.target() } hx-swap="outerHTML" class="btn btn-ghost btn-sm">Cancel</button>
						<button type="submit" class="btn btn-primary btn-sm">Get join command</button>
					</div>
				</form>
			case 2:
				<p class="text-sm text-rw-muted">Run this on the new machine as root. It works once and expires { v.Expires }.</p>
				@joinCommand(v.Command, v.TwoStep)
				<p class="text-sm text-rw-muted" aria-live="polite">Waiting for { v.Name } to call in…</p>
				<button type="button" hx-get={ v.Cancel } hx-target={ v.target() } hx-swap="outerHTML" class="btn btn-ghost btn-sm">Cancel</button>
			case 3:
				if v.Pending != nil {
					<p class="text-sm text-rw-muted">{ v.Pending.Name } called in. Check it is the machine you expect.</p>
					<dl class="text-sm grid grid-cols-[8rem_minmax(0,1fr)] [&>dd]:[overflow-wrap:anywhere] gap-y-1">
						<dt class="text-rw-muted">Name</dt>
						<dd class="text-rw-text">{ v.Pending.Name }</dd>
						<dt class="text-rw-muted">Addresses</dt>
						<dd class="text-rw-text font-mono text-xs">{ strings.Join(v.Pending.Addresses, ", ") }</dd>
						if v.Pending.System != "" {
							<dt class="text-rw-muted">System</dt>
							<dd class="text-rw-text">{ v.Pending.System }</dd>
						}
					</dl>
					<div class="flex gap-2">
						<form hx-post={ v.Pending.Reject } hx-target={ v.target() } hx-swap="outerHTML">
							<button type="submit" class="btn btn-ghost btn-sm">Reject</button>
						</form>
						<form hx-post={ v.Pending.Confirm } hx-target={ v.target() } hx-swap="outerHTML">
							<button type="submit" class="btn btn-primary btn-sm">Add { v.Pending.Name }</button>
						</form>
					</div>
				}
		}
	</div>
}

// addressRecords is what the node's Address needs in DNS: stackr's to
// keep, or the records to set by hand.
templ addressRecords(v NodeView) {
	if v.Address != "" {
		if v.AddressNoPublic {
			<p class="mt-2 text-sm text-rw-muted">No public address, so no record. Fine for a box on a LAN.</p>
		} else {
			if v.AddressManaged {
				<p class="mt-2 text-sm text-rw-muted">stackr keeps this record.</p>
			} else {
				<p class="mt-2 text-sm text-rw-muted">stackr does not manage this name. Set this record at your DNS host.</p>
			}
			<ul class="mt-1 space-y-1">
				for _, r := range v.AddressRecords {
					<li class="font-mono text-xs text-rw-text">{ r.Type } { r.Host } { r.Value }</li>
				}
			</ul>
		}
	}
}

templ ForgetWarning(b ForgetBody) {
	if len(b.Lost) > 0 {
		<p class="text-sm text-rw-muted mt-2">Lost until you redeploy:</p>
		<ul class="text-sm text-rw-text list-disc pl-5">
			for _, l := range b.Lost {
				<li>{ l }</li>
			}
		</ul>
	}
	<p class="text-sm text-rw-muted mt-2">Cut off at once:</p>
	<ul class="text-sm text-rw-text list-disc pl-5">
		<li>its certificate and registry access</li>
		<li>its links to every other node</li>
	</ul>
}

// ofTotal is a chart title with its total, when known: "Memory of 8.2 GB".
func ofTotal(title, total string) string {
	if total == "" {
		return title
	}
	return title + " of " + total
}

// NodeBody is one tab of the node drawer.
templ NodeBody(tab string, v NodeView) {
	<div id={ "node-" + tab }>
		if v.Job != nil {
			<div class="mb-4">@c.JobStatus(*v.Job)</div>
		}
		if len(v.DownDomains) > 0 {
			@c.Section("Domains on this node", "", "This ingress is down, so these stop answering. Move each env's ingress to another node.") {
				<ul class="space-y-2 mb-4">
					for _, d := range v.DownDomains {
						<li class="panel px-4 py-3 text-sm flex flex-wrap items-center gap-2">
							<span class="text-rw-text">{ d.Host }</span>
							<span class="text-xs text-rw-faint">{ d.Env }</span>
							<a href={ templ.SafeURL(d.Move) } class="btn btn-ghost btn-sm ml-auto">Move ingress</a>
						</li>
					}
				</ul>
			}
		}
		switch tab {
			case "metrics":
				@c.Metrics(v.Metrics) {
					@c.Chart(v.Metrics, "CPU", "cpu_pct", "used", "pct")
					@c.Chart(v.Metrics, ofTotal("Memory", v.MemTotal), "mem_used", "used", "bytes")
					@c.Chart(v.Metrics, ofTotal("Disk", v.DiskTotal), "disk_used", "used", "bytes")
				}
			case "envs":
				@c.Section("Envs on this node", "", "Placements decide where envs run. Repoint a placement to move its envs.") {
					if len(v.Envs) == 0 {
						<p class="text-sm text-rw-faint">No envs on this node.</p>
					} else {
						<ul class="space-y-2">
							for _, e := range v.Envs {
								<li class="panel px-4 py-3 text-sm flex flex-wrap items-center gap-2">
									<span class="text-rw-text">{ e.Path }</span>
									<span class="text-xs text-rw-faint">{ e.Pin }</span>
									<span class="ml-auto text-xs text-rw-muted">{ plural(e.Tiles, "tile") }</span>
								</li>
							}
						</ul>
					}
				}
			case "network":
				@c.Section("Address", "", "This node's own name.") {
					<form hx-post={ v.AddressAction } hx-target={ drawerTarget() } hx-swap="outerHTML" class="flex flex-wrap gap-2 items-center">
						<input type="text" name="node_address" value={ v.Address } aria-label="Address" placeholder="n2.stackr.example.com" class="input !w-64 font-mono" { c.Invalid("node_address", v.AddressError)... }/>
						<button type="submit" class="btn btn-primary">Save</button>
					</form>
					@c.FieldError("node_address", v.AddressError)
					@addressRecords(v)
				}
				@c.Section("Public IP", "", "DNS records of managed domains point here. Empty uses the detected address.") {
					<form hx-post={ v.PublicIPAction } hx-target={ drawerTarget() } hx-swap="outerHTML" class="flex flex-wrap gap-2 items-center">
						<input type="text" name="public_ip" value={ v.PublicIP } aria-label="Public IP" placeholder="detected" class="input !w-48 font-mono"/>
						<button type="submit" class="btn btn-primary">Save</button>
					</form>
				}
				if len(v.Ifaces) == 0 {
					@c.Section("Interfaces", "", "Reported by the node.") {
						<p class="text-sm text-rw-faint">Nothing reported yet.</p>
					}
				}
				@ifaceSection("Public", "Reachable from the internet.", ifaces(v.Ifaces, "public"))
				@ifaceSection("LAN", "Private networks this machine sits on.", ifaces(v.Ifaces, "lan"))
				@ifaceSection("Cluster", "The tunnel and the env networks.", ifaces(v.Ifaces, "cluster"))
				@ifaceSection("Docker", "Docker's own bridges.", ifaces(v.Ifaces, "docker"))
				if hidden := ifaces(v.Ifaces, "hidden"); len(hidden) > 0 {
					<details class="mb-6 text-sm">
						<summary class="cursor-pointer text-rw-muted hover:text-rw-text">Show all</summary>
						@ifaceList(hidden)
					</details>
				}
			case "tags":
				@c.Section("Tags", "", "What this node can do.") {
					if v.RoutesNote != "" {
						<p class="text-sm text-rw-muted mb-3">{ v.RoutesNote } Tag another node as ingress before removing this tag.</p>
					}
					<form hx-post={ v.TagsAction } hx-target={ drawerTarget() } hx-swap="outerHTML" class="group space-y-2">
						for _, t := range v.AllTags {
							if t != "egress" {
								<label class="flex items-center gap-2 text-rw-text"><input type="checkbox" name="tag" value={ t } checked?={ hasTag(v.Tags, t) } class="accent-rw-accent"/> { t } <span class="text-xs text-rw-faint">{ tagHelp(t) }</span></label>
							}
						}
						for _, t := range v.AllTags {
							if t == "egress" {
								<label class="flex items-center gap-2 text-rw-text"><input type="checkbox" name="tag" value={ t } checked?={ hasTag(v.Tags, t) } class="accent-rw-accent"/> { t } <span class="text-xs text-rw-faint">{ tagHelp(t) }</span></label>
							}
						}
						<fieldset class="pt-2 pl-6 group-has-[input[value=egress]:checked]:hidden" data-testid="exit-list">
							<legend class="label">Exit through</legend>
							<p class="text-xs text-rw-faint mb-1">Internet traffic leaves through the first that's online.</p>
							<div class="flex flex-wrap gap-2">
								for i, sel := range v.Exits {
									<select name="exit" class="input" aria-label={ fmt.Sprintf("Exit %d", i+1) }>
										<option value="">None</option>
										for _, o := range v.ExitNodes {
											<option value={ o.Value } selected?={ o.Value == sel }>{ o.Label }</option>
										}
									</select>
								}
							</div>
						</fieldset>
						<button type="submit" class="btn btn-primary btn-sm">Save tags</button>
					</form>
				}
			case "security":
				@c.Section("Connection", "", "") {
					if len(v.Certs) == 0 {
						<p class="text-sm text-rw-faint">No certificate issued.</p>
					}
					for _, ce := range v.Certs {
						<dl class="panel px-4 py-3 text-sm grid grid-cols-[8rem_minmax(0,1fr)] [&>dd]:[overflow-wrap:anywhere] gap-y-1 mb-2">
							<dt class="text-rw-muted">Serial</dt>
							<dd class="font-mono text-xs text-rw-text">{ ce.Serial }</dd>
							<dt class="text-rw-muted">Issued</dt>
							<dd class="text-rw-text">@c.When(ce.Issued)</dd>
							<dt class="text-rw-muted">Expires</dt>
							<dd class="text-rw-text">{ ce.Expires } · renews on its own from { ce.RenewFrom }</dd>
							<dt class="text-rw-muted">State</dt>
							<dd class="text-rw-text">{ ce.State }</dd>
						</dl>
					}
				}
				@c.Section("Keys", "", "Replace this node's WireGuard keys without a rejoin. Its tunnels blip for a moment; the security log shows when it is done.") {
					<form hx-post={ v.Rotate } hx-target={ drawerTarget() } hx-swap="outerHTML">
						<button type="submit" class="btn btn-ghost btn-sm">Rotate keys</button>
					</form>
				}
				if !v.Controller {
					@c.Section("Rejoin", "", "If this node broke or was reinstalled, get a new join command. It keeps its name, range and envs; the old certificate stops working once the new request is confirmed.") {
						if v.JoinCommand != "" || v.JoinTwoStep != "" {
							<p class="text-sm text-rw-muted mb-2">Run this on the machine as root. It works once and expires { v.JoinExpires }.</p>
							<div class="mb-3">@joinCommand(v.JoinCommand, v.JoinTwoStep)</div>
						}
						<form hx-post={ v.Rejoin } hx-target={ drawerTarget() } hx-swap="outerHTML">
							<button type="submit" class="btn btn-ghost btn-sm">Rejoin</button>
						</form>
					}
					@c.Section("Remove this node", "", "Remove needs its envs moved first. Forget is for a node that is gone for good.") {
						<div class="flex gap-2">
							@c.Confirm(v.Remove)
							@c.Confirm(v.Forget)
						</div>
					}
				}
			default:
				if v.CertExpired || len(v.Warnings) > 0 {
					<div class="node-warnings panel px-4 py-3 mb-4 text-sm flex flex-wrap items-center gap-3" role="alert">
						<ul class="space-y-1">
							for _, w := range v.Warnings {
								<li class={ templ.KV("text-rw-danger", w.Critical), templ.KV("text-rw-warn", !w.Critical) }>{ w.Detail }</li>
							}
						</ul>
						if v.CertExpired && v.Rejoin != "" {
							<form hx-post={ v.Rejoin } hx-target={ drawerTarget() } hx-swap="outerHTML" class="ml-auto">
								<button type="submit" class="btn btn-primary btn-sm">Rejoin</button>
							</form>
						}
					</div>
				}
				@c.Section("Node", "", "") {
					<dl class="panel px-4 py-3 text-sm grid grid-cols-[8rem_minmax(0,1fr)] [&>dd]:[overflow-wrap:anywhere] gap-y-1">
						<dt class="text-rw-muted">Status</dt>
						<dd class="text-rw-text flex items-center gap-2">
							<span class={ "inline-block size-2 rounded-full", statusDot(v.Status) } aria-hidden="true"></span>
							<span class={ statusText(v.Status) }>{ StatusWord(v.Status) }</span>
						</dd>
						if v.Hint != "" {
							<dt class="sr-only">What to do</dt>
							<dd class="col-start-2 text-xs text-rw-warn">{ v.Hint }</dd>
						}
						<dt class="text-rw-muted">Role</dt>
						<dd class="text-rw-text">{ v.Role }</dd>
						<dt class="text-rw-muted">Tags</dt>
						<dd class="flex flex-wrap gap-1">
							for _, t := range v.Tags {
								@c.Chip(t, "accent")
							}
							if len(v.Tags) == 0 {
								<span class="text-rw-faint">no tags</span>
							}
						</dd>
						<dt class="text-rw-muted">Stackr</dt>
						<dd class={ "font-mono text-xs", templ.KV("text-rw-text", !v.Behind && !v.TooOld), templ.KV("text-rw-warn", v.Behind || v.TooOld) }>{ versionNote(v) }</dd>
						<dt class="text-rw-muted">Last seen</dt>
						<dd class="text-rw-text">{ v.LastSeen }</dd>
						if v.CertExpiry != "" {
							<dt class="text-rw-muted">Certificate</dt>
							<dd class="text-rw-text">
								expires { v.CertExpiry }
							</dd>
						}
					</dl>
				}
				@c.Section("Addresses", "", "") {
					<dl class="panel px-4 py-3 text-sm grid grid-cols-[8rem_minmax(0,1fr)] [&>dd]:[overflow-wrap:anywhere] gap-y-1">
						@addrRow("Public", ifaces(v.Ifaces, "public"))
						@addrRow("LAN", ifaces(v.Ifaces, "lan"))
						if v.WGAddress != "" {
							<dt class="text-rw-muted">Tunnel</dt>
							<dd class="font-mono text-xs text-rw-text">{ v.WGAddress }</dd>
						}
						if v.Range != "" {
							<dt class="text-rw-muted">Env range</dt>
							<dd class="font-mono text-xs text-rw-text">{ v.Range }</dd>
						}
					</dl>
				}
				@c.Section("Machine", "", "") {
					if v.HasFacts {
						<dl class="panel px-4 py-3 text-sm grid grid-cols-[8rem_minmax(0,1fr)] [&>dd]:[overflow-wrap:anywhere] gap-y-1">
							<dt class="text-rw-muted">Arch</dt>
							<dd>
								if v.Arch != "" {
									@c.Chip(v.Arch, "")
								} else {
									<span class="text-rw-faint">not reported</span>
								}
							</dd>
							<dt class="text-rw-muted">Cores</dt>
							<dd class="text-rw-text">{ plural(v.Cores, "core") }</dd>
							<dt class="text-rw-muted">Memory</dt>
							<dd class="text-rw-text">{ v.Mem }</dd>
							<dt class="text-rw-muted">Disk</dt>
							<dd class="text-rw-text">{ v.Disk }</dd>
							<dt class="text-rw-muted">Kernel</dt>
							<dd class="font-mono text-xs text-rw-text">{ v.Kernel }</dd>
							<dt class="text-rw-muted">Docker</dt>
							<dd class="font-mono text-xs text-rw-text">{ v.Docker }</dd>
							<dt class="text-rw-muted">Up</dt>
							<dd class="text-rw-text">{ v.Uptime }</dd>
						</dl>
					} else {
						<p class="text-sm text-rw-faint">Not reported yet.</p>
					}
				}
				@c.Section("Tunnels", "", "Click one for its detail.") {
					if len(v.Tunnels) == 0 {
						<p class="text-sm text-rw-faint">No tunnels.</p>
					} else {
						<ul class="space-y-2">
							for _, t := range v.Tunnels {
								<li>
									<button type="button" hx-get={ t.Open } hx-target="#drawer-body" hx-push-url="false" class="panel w-full px-4 py-2 text-sm flex flex-wrap items-center gap-3 text-left hover:bg-rw-raised">
										<span class="text-rw-text font-medium">{ t.Name }</span>
										if t.Ping != "" {
											<span class="font-mono text-xs text-rw-muted">{ t.Ping }</span>
										}
										if t.Dials != "" {
											<span class="ml-auto text-xs text-rw-muted">{ t.Dials }</span>
										}
									</button>
								</li>
							}
						</ul>
					}
				}
				if v.Backup != "" {
					@c.Section("Backups", "", "Every volume on this node, into one group.") {
						<div class="mb-3">@c.PostButton("Back up node", v.Backup)</div>
						if len(v.Backups) == 0 {
							<p class="text-sm text-rw-faint">No node backups yet.</p>
						}
						<ul class="space-y-2">
							for _, g := range v.Backups {
								<li class="panel px-4 py-3 text-sm space-y-1">
									<div class="flex flex-wrap items-center gap-2">
										<span class="text-rw-text">{ g.Label }</span>
										@c.Chip(g.Status, backupTone(g.Status))
										if g.Dest != "" {
											<span class="ml-auto text-xs text-rw-muted">{ g.Dest }</span>
										}
									</div>
									if g.Warning != "" {
										<p class="text-xs text-rw-warn">{ g.Warning }</p>
									}
									if g.Error != "" {
										<p class="text-xs text-rw-danger">{ g.Error }</p>
									}
									if len(g.Volumes) > 0 {
										<details>
											<summary class="cursor-pointer text-xs text-rw-muted hover:text-rw-text">{ plural(len(g.Volumes), "volume") }</summary>
											<ul class="mt-2 space-y-1">
												for _, vr := range g.Volumes {
													<li class="flex flex-wrap items-center gap-2 text-xs">
														<span class="font-mono text-rw-text">{ vr.Volume }</span>
														if vr.Where != "" {
															<span class="text-rw-muted">{ vr.Where }</span>
														}
														<span class="text-rw-faint">{ vr.Method }</span>
														if vr.Size != "" {
															<span class="text-rw-faint">{ vr.Size }</span>
														}
														@c.Chip(vr.Status, backupTone(vr.Status))
														if vr.Error != "" {
															<span class="basis-full text-rw-danger">{ vr.Error }</span>
														}
													</li>
												}
											</ul>
										</details>
									}
								</li>
							}
						</ul>
					}
				}
		}
	</div>
}

func backupTone(s string) string {
	switch s {
	case "done":
		return "success"
	case "failed":
		return "danger"
	}
	return "warn"
}

func hasTag(tags []string, t string) bool {
	for _, x := range tags {
		if x == t {
			return true
		}
	}
	return false
}

func tagHelp(t string) string {
	switch t {
	case "ingress":
		return "Takes public web traffic."
	case "egress":
		return "Internet traffic may leave from this node's IP."
	case "builder":
		return "Builds images."
	case "storage":
		return "Holds volumes and managed databases."
	}
	return ""
}

templ addrRow(label string, rows []IfaceRow) {
	if len(rows) > 0 {
		<dt class="text-rw-muted">{ label }</dt>
		<dd class="font-mono text-xs text-rw-text">
			for _, r := range rows {
				<div>{ r.Addr }</div>
			}
		</dd>
	}
}

templ ifaceSection(title, help string, rows []IfaceRow) {
	if len(rows) > 0 {
		@c.Section(title, "", help) {
			@ifaceList(rows)
		}
	}
}

templ ifaceList(rows []IfaceRow) {
	<ul class="space-y-2 mt-2">
		for _, i := range rows {
			<li class="panel px-4 py-2 text-sm flex flex-wrap items-center gap-3">
				<span class="font-mono text-rw-text">{ i.Name }</span>
				<span class="min-w-0 font-mono text-xs text-rw-muted break-all">{ i.Addr }</span>
				if i.Label != "" {
					@c.Chip(i.Label, "")
				}
			</li>
		}
	</ul>
}


// joinCommand is the one line to run on a joining machine, or the two-step
// version when the panel's certificate is not one a fresh box trusts.
// joinCommand carries a join token: kept out of htmx's history cache.
templ joinCommand(oneLine, twoStep string) {
	if oneLine != "" {
		<pre class="panel px-3 py-2 text-xs font-mono whitespace-pre-wrap break-all select-all" hx-history="false">{ oneLine }</pre>
	}
	if twoStep != "" {
		<p class="text-xs text-rw-muted mb-2">The panel has no trusted certificate, so it takes two steps.</p>
		<pre class="panel px-3 py-2 text-xs font-mono whitespace-pre-wrap break-all select-all" hx-history="false">{ twoStep }</pre>
	}
}
