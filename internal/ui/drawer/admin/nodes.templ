package admin

import (
	"fmt"
	"strings"

	c "github.com/FyrmForge/stackr/internal/ui/components"
)

// NodesView is the admin Nodes tab. Add "" = may not add a node.
type NodesView struct {
	Add   string // GET: opens the add-node steps
	Lost  []LostEnvRow
	Rows  []NodeRow
	Adder *AddNodeView // the open add-node steps, nil = closed
	// Defaults is the cluster-wide default ingress and exit; nil = single node.
	Defaults *DefaultsView
	Trust    TrustView
}

// TrustView is the cluster trust section of the Nodes tab: the root, the
// rotate, break glass and revoke buttons, and the nodes break glass left
// unjoined. A ConfirmView with no Action is not offered.
type TrustView struct {
	Fingerprint, Created, Expires string
	RollingOver                   bool
	Since                         string   // when the rollover started
	OnOldRoot                     []string // node names still on the old root
	BreakGlassAt                  string   // "" = never
	Rotate, Finish                c.ConfirmView
	BreakGlass, RevokeController  c.ConfirmView
	NotRejoined                   []NotRejoinedRow
}

// NotRejoinedRow is a node waiting for its rejoin command. Command is set on
// the row whose command was just made.
type NotRejoinedRow struct {
	Name, Rejoin       string // Rejoin is a POST
	Command, Expires   string
}

// DefaultsView is the "Default ingress / exit" control. Each form POSTs node=.
type DefaultsView struct {
	IngressAction, ExitAction string
	Ingress, Exit             string // node id in force; Exit "" = each node's own uplink
	IngressNodes, ExitNodes   []Option
	// RotateAction (POST) rotates every node's keys; RotateEvery (POST
	// days=) sets the schedule, RotateDays the one in force (0 = off).
	RotateAction, RotateEvery string
	RotateDays                int
}

// NodeRow is one node card. Open is a GET that answers the node drawer.
type NodeRow struct {
	Name, Role, Status, Open string
	Tags                     []string
	Envs                     int
	Disk                     string // "34 GB free", "" = not reported
	Cores, Mem               string // "4 cores", "8 GB"
}

// LostEnvRow is an env of a forgotten node, with the nodes it can go to.
type LostEnvRow struct {
	Path, Node string
	Volumes    int
	Action     string // POST env=&node=
	EnvID      string
	Nodes      []Option
}

// Option is a select choice.
type Option struct{ Value, Label string }

// AddNodeView is the three steps: Step 1 asks name and tags, 2 shows the
// command and waits, 3 confirms the machine that called in.
type AddNodeView struct {
	Step  int
	Error string
	// Step 1
	Name   string
	Tags   []string // the choices
	Picked []string
	Create string // POST name, tag
	Cancel string // GET: closes the steps
	// Step 2
	Command string
	Expires string
	Poll    string // GET, 204 until the node has called in
	// Step 3
	Pending *PendingRow
}

// PendingRow is the machine that called in.
type PendingRow struct {
	Name, System, Confirm, Reject string
	Addresses                     []string
}

// NodeView is the node drawer's body. Only the active tab's fields are set.
type NodeView struct {
	ID, Name, Role, Status string
	Controller             bool
	Tags                   []string
	// Overview
	Range, WGAddress               string
	Docker, Kernel, Disk, Uptime   string
	Version, LastSeen, CertExpiry  string // Version "" = not reported
	Arch, Mem                      string
	Cores                          int
	HasFacts                       bool
	Behind, TooOld, CertExpired    bool // the build is not the panel's; not one it allows; no live certificate
	CertDays                       int  // the certificate ends in this many days, under 14; 0 = not
	// Backup is the Back up node POST; Backups its groups, newest first; Job
	// the job an action just queued.
	Backup  string
	Backups []BackupGroupRow
	Job     *c.JobStatusView
	Tunnels                        []TunnelRow
	// Envs
	Envs []NodeEnvRow
	// Network
	Ifaces []IfaceRow
	// Tags and open to orgs
	TagsAction  string // POST tag=, exit=
	Exits       [3]string // default exit picks by node name, "" = none
	ExitNodes   []Option  // nodes tagged egress, Value = name
	AllTags     []string
	RoutesNote  string
	OrgsAction  string // POST org=; "" = the controller, open to all
	Orgs        []NodeOrgRow
	// Security
	Certs  []CertRow
	Rotate      string // POST: replace the node's mesh keys
	Rejoin      string // POST: a new join command; "" = the controller
	JoinCommand string // the answer, shown once
	JoinExpires string
	Remove c.ConfirmView
	Forget c.ConfirmView
	Back   string
}

// BackupGroupRow is one node backup: its volumes sit in a details element.
type BackupGroupRow struct {
	Label, Status, Dest, Warning, Error string
	Volumes                             []BackupVolumeRow
}

type BackupVolumeRow struct{ Volume, Where, Method, Status, Size, Error string }

type NodeEnvRow struct {
	Path, Pin string
	Tiles     int
}

// IfaceRow is one address; Group is a service.Iface* constant.
type IfaceRow struct{ Group, Name, Addr, Label string }

// TunnelRow is one peer of the node. Open is a GET answering the tunnel drawer.
type TunnelRow struct{ Name, Dials, Ping, Open string }

type NodeOrgRow struct {
	ID, Name string
	On       bool
}

type CertRow struct{ Serial, Issued, Expires, RenewFrom, State string }

// ForgetBody is the list inside the forget dialog.
type ForgetBody struct {
	Name string
	Lost []string
}

// versionNote reads "0.6.0-dev.12, behind" or "0.6.0-dev.9, too old".
func versionNote(v NodeView) string {
	ver := v.Version
	if ver == "" {
		ver = "not reported"
	}
	switch {
	case v.TooOld:
		return ver + ", too old"
	case v.Behind:
		return ver + ", behind"
	}
	return ver
}

func plural(n int, one string) string {
	if n == 1 {
		return fmt.Sprintf("%d %s", n, one)
	}
	return fmt.Sprintf("%d %ss", n, one)
}

func statusTone(s string) string {
	switch s {
	case "online":
		return "success"
	case "joined", "tunnel-down", "not-rejoined":
		return "warn"
	}
	return "danger"
}

// statusDot and statusText spell every class in full so tailwind keeps them;
// the tones match the cluster map's.
func statusDot(s string) string {
	switch statusTone(s) {
	case "success":
		return "bg-rw-success"
	case "warn":
		return "bg-rw-warn"
	}
	return "bg-rw-danger"
}

func statusText(s string) string {
	switch statusTone(s) {
	case "success":
		return "text-rw-success"
	case "warn":
		return "text-rw-warn"
	}
	return "text-rw-danger"
}

// ifaces are the rows of one group.
func ifaces(rows []IfaceRow, group string) []IfaceRow {
	var out []IfaceRow
	for _, r := range rows {
		if r.Group == group {
			out = append(out, r)
		}
	}
	return out
}

func statusWord(s string) string {
	switch s {
	case "online":
		return "Online"
	case "joined":
		return "Joined, not seen yet"
	case "tunnel-down":
		return "Tunnel down, host alive"
	case "cert-expired":
		return "Certificate expired: rejoin"
	case "not-rejoined":
		return "Not rejoined"
	}
	return strings.ToUpper(s[:1]) + s[1:]
}

func picked(v *AddNodeView, t string) bool {
	for _, p := range v.Picked {
		if p == t {
			return true
		}
	}
	return false
}

templ Nodes(v NodesView) {
	<div id="tab-nodes">
		if len(v.Lost) > 0 {
			@c.Section("Lost envs", "instance", "Pick a node for each. They start empty; restore a volume's backup after.") {
				<ul class="space-y-3">
					for _, l := range v.Lost {
						<li class="panel px-4 py-3 text-sm space-y-2">
							<div class="flex flex-wrap items-center gap-2">
								<span class="text-rw-text">{ l.Path }</span>
								@c.Chip(l.Node+" was forgotten", "warn")
								<span class="text-xs text-rw-faint">{ plural(l.Volumes, "volume") }</span>
							</div>
							if len(l.Nodes) > 0 {
								<form hx-post={ l.Action } hx-target={ target() } hx-swap="outerHTML" class="flex items-end gap-2">
									<input type="hidden" name="env" value={ l.EnvID }/>
									<div>
										<label for={ "lost-" + l.EnvID } class="label">Redeploy on</label>
										<select id={ "lost-" + l.EnvID } name="node" class="input">
											for _, n := range l.Nodes {
												<option value={ n.Value }>{ n.Label }</option>
											}
										</select>
									</div>
									<button type="submit" class="btn btn-primary btn-sm">Redeploy empty</button>
								</form>
							}
						</li>
					}
				</ul>
			}
		}
		@c.Section("Nodes", "instance", "Machines this panel runs envs on.") {
			if v.Adder != nil {
				@AddNode(*v.Adder)
			}
			if v.Defaults != nil {
				@defaultsControl(*v.Defaults)
			}
			<ul class="space-y-3">
				for _, r := range v.Rows {
					<li class="panel px-4 py-3 text-sm">
						<div class="flex flex-wrap items-center gap-2">
							<button type="button" hx-get={ r.Open } hx-target={ target() } hx-swap="outerHTML" class="text-rw-text font-medium hover:underline">{ r.Name }</button>
							@c.Chip(r.Role, "")
							for _, t := range r.Tags {
								@c.Chip(t, "accent")
							}
							if len(r.Tags) == 0 {
								<span class="text-xs text-rw-faint">no tags</span>
							}
							<span class="ml-auto">@c.Chip(statusWord(r.Status), statusTone(r.Status))</span>
						</div>
						<p class="mt-2 text-xs text-rw-muted">
							{ plural(r.Envs, "env") }
							if r.Cores != "" {
								· { r.Cores } · { r.Mem }
							}
							if r.Disk != "" {
								· { r.Disk }
							}
						</p>
					</li>
				}
			</ul>
			if len(v.Rows) == 1 && v.Adder == nil {
				<div class="mt-4">
					<p class="text-rw-text">Only this server so far</p>
					<p class="text-sm text-rw-muted">Add a node to run envs on another machine.</p>
				</div>
			}
			if v.Add != "" && v.Adder == nil {
				<div class="mt-4">
					<button type="button" hx-get={ v.Add } hx-target={ target() } hx-swap="outerHTML" class="btn btn-primary btn-sm">Add node</button>
				</div>
			}
		}
		if v.Trust.Fingerprint != "" {
			@trustSection(v.Trust)
		}
	</div>
}

templ trustSection(t TrustView) {
	@c.Section("Cluster trust", "instance", "The root every node's certificate comes from.") {
		<dl class="panel px-4 py-3 text-sm grid grid-cols-[8rem_1fr] gap-y-1 mb-3">
			<dt class="text-rw-muted">Root</dt>
			<dd class="font-mono text-xs text-rw-text break-all">{ t.Fingerprint }</dd>
			<dt class="text-rw-muted">Created</dt>
			<dd class="text-rw-text">{ t.Created }</dd>
			<dt class="text-rw-muted">Expires</dt>
			<dd class="text-rw-text">{ t.Expires }</dd>
			<dt class="text-rw-muted">Rollover</dt>
			<dd class="text-rw-text">
				if t.RollingOver {
					Running since { t.Since }.
					if len(t.OnOldRoot) > 0 {
						Still on the old root: { strings.Join(t.OnOldRoot, ", ") }.
					}
				} else {
					None running.
				}
			</dd>
			if t.BreakGlassAt != "" {
				<dt class="text-rw-muted">Break glass</dt>
				<dd class="text-rw-text">{ t.BreakGlassAt }</dd>
			}
		</dl>
		<div class="flex flex-wrap gap-2">
			@c.Confirm(t.Rotate)
			if t.RollingOver {
				@c.Confirm(t.Finish)
			}
			@c.Confirm(t.RevokeController)
			@c.Confirm(t.BreakGlass)
		</div>
		if len(t.NotRejoined) > 0 {
			<h3 class="mt-4 mb-2 text-sm font-semibold text-rw-text">Not rejoined</h3>
			<p class="mb-2 text-xs text-rw-muted">Run each command on its machine as root. A command works once.</p>
			<ul class="space-y-2">
				for _, r := range t.NotRejoined {
					<li class="panel px-4 py-3 text-sm space-y-2">
						<div class="flex flex-wrap items-center gap-2">
							<span class="text-rw-text">{ r.Name }</span>
							@c.Chip("Not rejoined", "warn")
							<form hx-post={ r.Rejoin } hx-target={ target() } hx-swap="outerHTML" class="ml-auto">
								<button type="submit" class="btn btn-ghost btn-sm">Rejoin command</button>
							</form>
						</div>
						if r.Command != "" {
							<p class="text-xs text-rw-muted">Expires { r.Expires }.</p>
							<pre class="panel px-3 py-2 text-xs font-mono whitespace-pre-wrap break-all select-all">{ r.Command }</pre>
						}
					</li>
				}
			</ul>
		}
	}
}

templ addSteps(step int) {
	<ol class="flex items-center gap-4 text-xs text-rw-muted mb-4">
		for i, s := range []string{"Name", "Run the command", "Confirm"} {
			<li class={ templ.KV("text-rw-text font-medium", i+1 == step) }>{ fmt.Sprint(i+1) } { s }</li>
		}
	</ol>
}

// AddNode is the add-node dialog's body: the three steps on the join API.
templ AddNode(v AddNodeView) {
	<div id="add-node" class="panel px-4 py-4 mb-4 space-y-4" if v.Step == 2 { hx-get={ v.Poll } hx-trigger="every 3s" hx-target="#add-node" hx-swap="outerHTML" }>
		<h3 class="text-sm font-semibold text-rw-text">Add a node</h3>
		@addSteps(v.Step)
		if v.Error != "" {
			<p class="text-sm text-rw-danger" role="alert">{ v.Error }</p>
		}
		switch v.Step {
			case 1:
				<form hx-post={ v.Create } hx-target={ target() } hx-swap="outerHTML" class="space-y-4">
					@c.Field(c.FieldView{Name: "name", Label: "Name", Value: v.Name, Placeholder: "vps-fsn1", Help: "Lowercase, used in pins and the CLI."})
					<fieldset class="space-y-1">
						<legend class="label">Tags</legend>
						for _, t := range v.Tags {
							<label class="flex items-center gap-2 text-rw-text"><input type="checkbox" name="tag" value={ t } checked?={ t == "egress" || picked(&v, t) } disabled?={ t == "egress" } class="accent-rw-accent"/> { t }if t == "egress" {
								<span class="text-xs text-rw-faint">Every node starts with egress.</span>
							}</label>
						}
						<p class="text-xs text-rw-faint">You can change these later.</p>
					</fieldset>
					<div class="flex gap-2">
						<button type="button" hx-get={ v.Cancel } hx-target={ target() } hx-swap="outerHTML" class="btn btn-ghost btn-sm">Cancel</button>
						<button type="submit" class="btn btn-primary btn-sm">Get join command</button>
					</div>
				</form>
			case 2:
				<p class="text-sm text-rw-muted">Run this on the new machine as root. It works once and expires { v.Expires }.</p>
				<pre class="panel px-3 py-2 text-xs font-mono whitespace-pre-wrap break-all select-all">{ v.Command }</pre>
				<p class="text-sm text-rw-muted" aria-live="polite">Waiting for { v.Name } to call in…</p>
				<button type="button" hx-get={ v.Cancel } hx-target={ target() } hx-swap="outerHTML" class="btn btn-ghost btn-sm">Cancel</button>
			case 3:
				if v.Pending != nil {
					<p class="text-sm text-rw-muted">{ v.Pending.Name } called in. Check it is the machine you expect.</p>
					<dl class="text-sm grid grid-cols-[8rem_1fr] gap-y-1">
						<dt class="text-rw-muted">Name</dt>
						<dd class="text-rw-text">{ v.Pending.Name }</dd>
						<dt class="text-rw-muted">Addresses</dt>
						<dd class="text-rw-text font-mono text-xs">{ strings.Join(v.Pending.Addresses, ", ") }</dd>
						<dt class="text-rw-muted">System</dt>
						<dd class="text-rw-text">{ v.Pending.System }</dd>
					</dl>
					<div class="flex gap-2">
						<form hx-post={ v.Pending.Reject } hx-target={ target() } hx-swap="outerHTML">
							<button type="submit" class="btn btn-ghost btn-sm">Reject</button>
						</form>
						<form hx-post={ v.Pending.Confirm } hx-target={ target() } hx-swap="outerHTML">
							<button type="submit" class="btn btn-primary btn-sm">Add { v.Pending.Name }</button>
						</form>
					</div>
				}
		}
	</div>
}

templ ForgetWarning(b ForgetBody) {
	<p class="text-sm text-rw-text">Use this only if { b.Name } is gone for good.</p>
	if len(b.Lost) > 0 {
		<p class="text-sm text-rw-muted mt-2">Lost until you redeploy:</p>
		<ul class="text-sm text-rw-text list-disc pl-5">
			for _, l := range b.Lost {
				<li>{ l }</li>
			}
		</ul>
	}
	<p class="text-sm text-rw-muted mt-2">Cut off at once:</p>
	<ul class="text-sm text-rw-text list-disc pl-5">
		<li>its certificate and registry access</li>
		<li>its links to every other node</li>
	</ul>
}

// NodeBody is one tab of the node drawer.
templ NodeBody(tab string, v NodeView) {
	<div id={ "node-" + tab }>
		if v.Job != nil {
			<div class="mb-4">@c.JobStatus(*v.Job)</div>
		}
		switch tab {
			case "envs":
				@c.Section("Envs on this node", "", "Pins decide where new envs go. Moving an existing env is a separate step.") {
					if len(v.Envs) == 0 {
						<p class="text-sm text-rw-faint">No envs on this node.</p>
					} else {
						<ul class="space-y-2">
							for _, e := range v.Envs {
								<li class="panel px-4 py-3 text-sm flex flex-wrap items-center gap-2">
									<span class="text-rw-text">{ e.Path }</span>
									<span class="text-xs text-rw-faint">{ e.Pin }</span>
									<span class="ml-auto text-xs text-rw-muted">{ plural(e.Tiles, "tile") }</span>
								</li>
							}
						</ul>
					}
				}
			case "network":
				if len(v.Ifaces) == 0 {
					@c.Section("Interfaces", "", "Reported by the node.") {
						<p class="text-sm text-rw-faint">Nothing reported yet.</p>
					}
				}
				@ifaceSection("Public", "Reachable from the internet.", ifaces(v.Ifaces, "public"))
				@ifaceSection("LAN", "Private networks this machine sits on.", ifaces(v.Ifaces, "lan"))
				@ifaceSection("Cluster", "The tunnel and the env networks.", ifaces(v.Ifaces, "cluster"))
				@ifaceSection("Docker", "Docker's own bridges.", ifaces(v.Ifaces, "docker"))
				if hidden := ifaces(v.Ifaces, "hidden"); len(hidden) > 0 {
					<details class="mb-6 text-sm">
						<summary class="cursor-pointer text-rw-muted hover:text-rw-text">Show all</summary>
						@ifaceList(hidden)
					</details>
				}
			case "tags":
				@c.Section("Tags", "", "What this node can do.") {
					if v.RoutesNote != "" {
						<p class="text-sm text-rw-muted mb-3">{ v.RoutesNote } Tag another node as ingress before removing this tag.</p>
					}
					<form hx-post={ v.TagsAction } hx-target={ target() } hx-swap="outerHTML" class="space-y-2">
						for _, t := range v.AllTags {
							<label class="flex items-center gap-2 text-rw-text"><input type="checkbox" name="tag" value={ t } checked?={ hasTag(v.Tags, t) } class="accent-rw-accent"/> { t } <span class="text-xs text-rw-faint">{ tagHelp(t) }</span></label>
						}
						<fieldset class="pt-2">
							<legend class="label">Default exit</legend>
							<div class="flex flex-wrap gap-2">
								for i, sel := range v.Exits {
									<select name="exit" class="input" aria-label={ fmt.Sprintf("Default exit %d", i+1) }>
										<option value="">None</option>
										for _, o := range v.ExitNodes {
											<option value={ o.Value } selected?={ o.Value == sel }>{ o.Label }</option>
										}
									</select>
								}
							</div>
							<p class="text-xs text-rw-faint mt-1">Used when this node has no egress tag.</p>
						</fieldset>
						<button type="submit" class="btn btn-primary btn-sm">Save tags</button>
					</form>
				}
				@c.Section("Open to orgs", "", "Owners of an open org can pin envs here. Admins can pin anywhere.") {
					if v.OrgsAction == "" {
						<p class="text-sm text-rw-muted">The controller is open to every organization.</p>
					} else {
						<form hx-post={ v.OrgsAction } hx-target={ target() } hx-swap="outerHTML" class="space-y-2">
							for _, o := range v.Orgs {
								<label class="flex items-center gap-2 text-rw-text"><input type="checkbox" name="org" value={ o.ID } checked?={ o.On } class="accent-rw-accent"/> { o.Name }</label>
							}
							if len(v.Orgs) == 0 {
								<p class="text-sm text-rw-faint">No organizations yet.</p>
							}
							<button type="submit" class="btn btn-ghost btn-sm">Save</button>
						</form>
					}
				}
			case "security":
				@c.Section("Connection", "", "") {
					if len(v.Certs) == 0 {
						<p class="text-sm text-rw-faint">No certificate issued.</p>
					}
					for _, ce := range v.Certs {
						<dl class="panel px-4 py-3 text-sm grid grid-cols-[8rem_1fr] gap-y-1 mb-2">
							<dt class="text-rw-muted">Serial</dt>
							<dd class="font-mono text-xs text-rw-text">{ ce.Serial }</dd>
							<dt class="text-rw-muted">Issued</dt>
							<dd class="text-rw-text">{ ce.Issued }</dd>
							<dt class="text-rw-muted">Expires</dt>
							<dd class="text-rw-text">{ ce.Expires } · renews on its own from { ce.RenewFrom }</dd>
							<dt class="text-rw-muted">State</dt>
							<dd class="text-rw-text">{ ce.State }</dd>
						</dl>
					}
				}
				@c.Section("Keys", "", "Replace this node's WireGuard keys without a rejoin. Its tunnels blip for a moment; the security log shows when it is done.") {
					<form hx-post={ v.Rotate } hx-target={ target() } hx-swap="outerHTML">
						<button type="submit" class="btn btn-ghost btn-sm">Rotate keys</button>
					</form>
				}
				if !v.Controller {
					@c.Section("Rejoin", "", "If this node broke or was reinstalled, get a new join command. It keeps its name, range and envs; the old certificate stops working once the new request is confirmed.") {
						if v.JoinCommand != "" {
							<p class="text-sm text-rw-muted mb-2">Run this on the machine as root. It works once and expires { v.JoinExpires }.</p>
							<pre class="panel px-3 py-2 text-xs font-mono whitespace-pre-wrap break-all select-all mb-3">{ v.JoinCommand }</pre>
						}
						<form hx-post={ v.Rejoin } hx-target={ target() } hx-swap="outerHTML">
							<button type="submit" class="btn btn-ghost btn-sm">Rejoin</button>
						</form>
					}
					@c.Section("Remove this node", "", "Remove needs its envs moved first. Forget is for a node that is gone for good.") {
						<div class="flex gap-2">
							@c.Confirm(v.Remove)
							@c.Confirm(v.Forget)
						</div>
					}
				}
			default:
				if v.CertExpired {
					<div class="panel px-4 py-3 mb-4 text-sm flex flex-wrap items-center gap-3" role="alert">
						<span class="text-rw-danger">Cert expired, rejoin needed</span>
						if v.Rejoin != "" {
							<form hx-post={ v.Rejoin } hx-target={ target() } hx-swap="outerHTML" class="ml-auto">
								<button type="submit" class="btn btn-primary btn-sm">Rejoin</button>
							</form>
						}
					</div>
				}
				@c.Section("Node", "", "") {
					<dl class="panel px-4 py-3 text-sm grid grid-cols-[8rem_1fr] gap-y-1">
						<dt class="text-rw-muted">Status</dt>
						<dd class="text-rw-text flex items-center gap-2">
							<span class={ "inline-block size-2 rounded-full", statusDot(v.Status) } aria-hidden="true"></span>
							<span class={ statusText(v.Status) }>{ statusWord(v.Status) }</span>
						</dd>
						<dt class="text-rw-muted">Role</dt>
						<dd class="text-rw-text">{ v.Role }</dd>
						<dt class="text-rw-muted">Tags</dt>
						<dd class="flex flex-wrap gap-1">
							for _, t := range v.Tags {
								@c.Chip(t, "accent")
							}
							if len(v.Tags) == 0 {
								<span class="text-rw-faint">no tags</span>
							}
						</dd>
						<dt class="text-rw-muted">Stackr</dt>
						<dd class={ "font-mono text-xs", templ.KV("text-rw-text", !v.Behind && !v.TooOld), templ.KV("text-rw-warn", v.Behind || v.TooOld) }>{ versionNote(v) }</dd>
						<dt class="text-rw-muted">Last seen</dt>
						<dd class="text-rw-text">{ v.LastSeen }</dd>
						if v.CertExpiry != "" {
							<dt class="text-rw-muted">Certificate</dt>
							<dd class="text-rw-text">
								expires { v.CertExpiry }
								if v.CertDays > 0 {
									<p class="text-rw-warn">Cert expires in { plural(v.CertDays, "day") }</p>
								}
							</dd>
						}
					</dl>
				}
				@c.Section("Addresses", "", "") {
					<dl class="panel px-4 py-3 text-sm grid grid-cols-[8rem_1fr] gap-y-1">
						@addrRow("Public", ifaces(v.Ifaces, "public"))
						@addrRow("LAN", ifaces(v.Ifaces, "lan"))
						if v.WGAddress != "" {
							<dt class="text-rw-muted">Tunnel</dt>
							<dd class="font-mono text-xs text-rw-text">{ v.WGAddress }</dd>
						}
						if v.Range != "" {
							<dt class="text-rw-muted">Env range</dt>
							<dd class="font-mono text-xs text-rw-text">{ v.Range }</dd>
						}
					</dl>
				}
				@c.Section("Machine", "", "") {
					if v.HasFacts {
						<dl class="panel px-4 py-3 text-sm grid grid-cols-[8rem_1fr] gap-y-1">
							<dt class="text-rw-muted">Arch</dt>
							<dd>
								if v.Arch != "" {
									@c.Chip(v.Arch, "")
								} else {
									<span class="text-rw-faint">not reported</span>
								}
							</dd>
							<dt class="text-rw-muted">Cores</dt>
							<dd class="text-rw-text">{ plural(v.Cores, "core") }</dd>
							<dt class="text-rw-muted">Memory</dt>
							<dd class="text-rw-text">{ v.Mem }</dd>
							<dt class="text-rw-muted">Disk</dt>
							<dd class="text-rw-text">{ v.Disk }</dd>
							<dt class="text-rw-muted">Kernel</dt>
							<dd class="font-mono text-xs text-rw-text">{ v.Kernel }</dd>
							<dt class="text-rw-muted">Docker</dt>
							<dd class="font-mono text-xs text-rw-text">{ v.Docker }</dd>
							<dt class="text-rw-muted">Up</dt>
							<dd class="text-rw-text">{ v.Uptime }</dd>
						</dl>
					} else {
						<p class="text-sm text-rw-faint">Not reported yet.</p>
					}
				}
				@c.Section("Tunnels", "", "Click one for its detail.") {
					if len(v.Tunnels) == 0 {
						<p class="text-sm text-rw-faint">No tunnels.</p>
					} else {
						<ul class="space-y-2">
							for _, t := range v.Tunnels {
								<li>
									<button type="button" hx-get={ t.Open } hx-target="#drawer-body" hx-push-url="false" class="panel w-full px-4 py-2 text-sm flex flex-wrap items-center gap-3 text-left hover:bg-rw-raised">
										<span class="text-rw-text font-medium">{ t.Name }</span>
										if t.Ping != "" {
											<span class="font-mono text-xs text-rw-muted">{ t.Ping }</span>
										}
										if t.Dials != "" {
											<span class="ml-auto text-xs text-rw-muted">{ t.Dials }</span>
										}
									</button>
								</li>
							}
						</ul>
					}
				}
				if v.Backup != "" {
					@c.Section("Backups", "", "Every volume on this node, into one group.") {
						<div class="mb-3">@c.PostButton("Back up node", v.Backup)</div>
						if len(v.Backups) == 0 {
							<p class="text-sm text-rw-faint">No node backups yet.</p>
						}
						<ul class="space-y-2">
							for _, g := range v.Backups {
								<li class="panel px-4 py-3 text-sm space-y-1">
									<div class="flex flex-wrap items-center gap-2">
										<span class="text-rw-text">{ g.Label }</span>
										@c.Chip(g.Status, backupTone(g.Status))
										if g.Dest != "" {
											<span class="ml-auto text-xs text-rw-muted">{ g.Dest }</span>
										}
									</div>
									if g.Warning != "" {
										<p class="text-xs text-rw-warn">{ g.Warning }</p>
									}
									if g.Error != "" {
										<p class="text-xs text-rw-danger">{ g.Error }</p>
									}
									if len(g.Volumes) > 0 {
										<details>
											<summary class="cursor-pointer text-xs text-rw-muted hover:text-rw-text">{ plural(len(g.Volumes), "volume") }</summary>
											<ul class="mt-2 space-y-1">
												for _, vr := range g.Volumes {
													<li class="flex flex-wrap items-center gap-2 text-xs">
														<span class="font-mono text-rw-text">{ vr.Volume }</span>
														if vr.Where != "" {
															<span class="text-rw-muted">{ vr.Where }</span>
														}
														<span class="text-rw-faint">{ vr.Method }</span>
														if vr.Size != "" {
															<span class="text-rw-faint">{ vr.Size }</span>
														}
														@c.Chip(vr.Status, backupTone(vr.Status))
														if vr.Error != "" {
															<span class="basis-full text-rw-danger">{ vr.Error }</span>
														}
													</li>
												}
											</ul>
										</details>
									}
								</li>
							}
						</ul>
					}
				}
		}
	</div>
}

func backupTone(s string) string {
	switch s {
	case "done":
		return "success"
	case "failed":
		return "danger"
	}
	return "warn"
}

func hasTag(tags []string, t string) bool {
	for _, x := range tags {
		if x == t {
			return true
		}
	}
	return false
}

func tagHelp(t string) string {
	switch t {
	case "ingress":
		return "Takes public web traffic."
	case "egress":
		return "Internet traffic may leave from this node's IP."
	case "builder":
		return "Builds images."
	}
	return ""
}

templ addrRow(label string, rows []IfaceRow) {
	if len(rows) > 0 {
		<dt class="text-rw-muted">{ label }</dt>
		<dd class="font-mono text-xs text-rw-text">
			for _, r := range rows {
				<div>{ r.Addr }</div>
			}
		</dd>
	}
}

templ ifaceSection(title, help string, rows []IfaceRow) {
	if len(rows) > 0 {
		@c.Section(title, "", help) {
			@ifaceList(rows)
		}
	}
}

templ ifaceList(rows []IfaceRow) {
	<ul class="space-y-2 mt-2">
		for _, i := range rows {
			<li class="panel px-4 py-2 text-sm flex flex-wrap items-center gap-3">
				<span class="font-mono text-rw-text">{ i.Name }</span>
				<span class="font-mono text-xs text-rw-muted">{ i.Addr }</span>
				if i.Label != "" {
					@c.Chip(i.Label, "")
				}
			</li>
		}
	</ul>
}

// NodeBack is the link from a node drawer to the Nodes tab.
templ NodeBack(href string) {
	<button type="button" hx-get={ href } hx-target={ target() } hx-swap="outerHTML" class="text-xs text-rw-accent hover:underline mb-3">Back to nodes</button>
}

templ defaultsControl(d DefaultsView) {
	<div class="panel px-4 py-3 mb-3 text-sm grid gap-3 sm:grid-cols-2">
		<form hx-post={ d.IngressAction } hx-target={ target() } hx-swap="outerHTML" class="flex items-end gap-2">
			<div>
				<label for="default-ingress" class="label">Default ingress</label>
				<select id="default-ingress" name="node" class="input">
					for _, n := range d.IngressNodes {
						<option value={ n.Value } selected?={ n.Value == d.Ingress }>{ n.Label }</option>
					}
				</select>
			</div>
			<button type="submit" class="btn btn-ghost btn-sm">Set</button>
		</form>
		<form hx-post={ d.ExitAction } hx-target={ target() } hx-swap="outerHTML" class="flex items-end gap-2">
			<div>
				<label for="default-exit" class="label">Default exit</label>
				<select id="default-exit" name="node" class="input">
					<option value="" selected?={ d.Exit == "" }>Each node's own uplink</option>
					for _, n := range d.ExitNodes {
						<option value={ n.Value } selected?={ n.Value == d.Exit }>{ n.Label }</option>
					}
				</select>
			</div>
			<button type="submit" class="btn btn-ghost btn-sm">Set</button>
		</form>
		<form hx-post={ d.RotateEvery } hx-target={ target() } hx-swap="outerHTML" class="flex items-end gap-2">
			<div>
				<label for="rotate-days" class="label">Rotate keys every (days, 0 = off)</label>
				<input id="rotate-days" name="days" type="number" min="0" max="365" value={ fmt.Sprint(d.RotateDays) } class="input w-24"/>
			</div>
			<button type="submit" class="btn btn-ghost btn-sm">Set</button>
		</form>
		<form hx-post={ d.RotateAction } hx-target={ target() } hx-swap="outerHTML" class="flex items-end">
			<button type="submit" class="btn btn-ghost btn-sm">Rotate all keys now</button>
		</form>
	</div>
}
