package admin

import (
	"fmt"

	c "github.com/FyrmForge/stackr/internal/ui/components"
)

// PlacementsView is the admin Placements tab: every placement, the add form
// and, while one is open, the move wizard or a move's progress.
type PlacementsView struct {
	Rows     []PlacementRow
	Add      PlacementFormView // Action "" = may not add
	Wizard   *MoveWizardView   // nil = closed
	Progress *MoveProgressView // nil = none open
	Nodes    string            // GET: the Nodes tab
}

// PlacementRow is one placement. Node "" = no node yet. State is the one
// word under the name; Tone is its chip tone.
type PlacementRow struct {
	Name, Node string
	Tags       []string
	Open       string // "all orgs" or the org names
	Envs       int
	State, Tone string
	Default    bool
	Move       string // GET: opens the move wizard
	Progress   string // GET: a move's progress; "" = none to show
	Edit       PlacementFormView
	Delete     c.ConfirmView // Action "" = not offered
}

// PlacementFormView is the add form, or a row's open-to edit. Name and Nodes
// are used by the add form only.
type PlacementFormView struct {
	Action string // POST
	Error  string
	Name   string
	Node   string   // picked node name
	Nodes  []Option // Value = node name
	All    bool     // open to all orgs
	Orgs   []OrgPick
}

// OrgPick is one org of the open-to list.
type OrgPick struct {
	Slug, Name string
	On         bool
}

// MoveWizardView is the repoint wizard. Step 1 picks the node, step 2 shows
// the checks and, once they all pass, the confirm.
type MoveWizardView struct {
	Placement, From string
	Step            int
	Error           string
	To              string
	Nodes           []Option // Value = node name
	Check           string   // GET to= : runs the checks (step 1's form, Re-check)
	Cancel          string   // GET: closes the wizard
	Checks          []CheckRow
	Envs            []MoveEnvRow
	Restore         bool // the source node was forgotten
	OK              bool
	Confirm         c.ConfirmView
}

// CheckRow is one line of the CI-style list.
type CheckRow struct {
	Name, Detail string
	OK           bool
}

// MoveEnvRow is an env the move takes along. Size is "" when unknown.
type MoveEnvRow struct {
	Path, Size, Downtime string
	Volumes              int
}

// MoveProgressView is a repoint's progress. Poll is a GET while it runs;
// Retry a POST once it failed.
type MoveProgressView struct {
	Placement, State, From, To, Error string
	Done, All                         int
	Envs                              []MoveProgressEnv
	Poll, Retry, Back                 string
}

// MoveProgressEnv is one env move: its path, state word and the step it is on.
type MoveProgressEnv struct {
	Path, State, Step, Error string
}

templ placementForm(f PlacementFormView, id string, withName bool) {
	<form hx-post={ f.Action } hx-target={ target() } hx-swap="outerHTML" class="space-y-4">
		if f.Error != "" {
			<p class="text-sm text-rw-danger" role="alert">{ f.Error }</p>
		}
		if withName {
			@c.Field(c.FieldView{Name: "name", Label: "Name", Value: f.Name, Placeholder: "eu-prod", Help: "Lowercase, used in pins and the CLI."})
			<div>
				<label for={ id + "-node" } class="label">Node</label>
				<select id={ id + "-node" } name="node" class="input">
					<option value="">None yet</option>
					for _, n := range f.Nodes {
						<option value={ n.Value } selected?={ n.Value == f.Node }>{ n.Label }</option>
					}
				</select>
				<p class="text-xs text-rw-faint mt-1">With no node, envs wait until you give it one.</p>
			</div>
		}
		<fieldset class="space-y-1">
			<legend class="label">Open to</legend>
			<input type="checkbox" id={ id + "-all" } name="all" value="on" checked?={ f.All } class="peer accent-rw-accent"/>
			<label for={ id + "-all" } class="text-rw-text">All orgs</label>
			<div class="space-y-1 pl-6 peer-checked:hidden">
				for _, o := range f.Orgs {
					<label class="flex items-center gap-2 text-rw-text"><input type="checkbox" name="org" value={ o.Slug } checked?={ o.On } class="accent-rw-accent"/> { o.Name }</label>
				}
				if len(f.Orgs) == 0 {
					<p class="text-sm text-rw-faint">No organizations yet.</p>
				}
			</div>
			<p class="text-xs text-rw-faint">Closing keeps the envs already here.</p>
		</fieldset>
		<button type="submit" class="btn btn-primary btn-sm">
			if withName {
				Add placement
			} else {
				Save
			}
		</button>
	</form>
}

templ Placements(v PlacementsView) {
	<div id="tab-placements">
		if v.Wizard != nil {
			@MoveWizard(*v.Wizard)
		}
		if v.Progress != nil {
			@MoveProgress(*v.Progress)
		}
		@c.Section("Placements", "instance", "A name envs belong to, standing on one node. Orgs pin to placements; you point each at a node.") {
			if len(v.Rows) == 0 {
				<p class="text-sm text-rw-faint">No placements yet.</p>
			}
			<ul class="space-y-3">
				for _, r := range v.Rows {
					<li class="panel px-4 py-3 text-sm space-y-2">
						<div class="flex flex-wrap items-center gap-2">
							<span class="text-rw-text font-medium">{ r.Name }</span>
							if r.Default {
								@c.Chip("default", "")
							}
							if r.Node != "" {
								<span class="text-xs text-rw-muted">on { r.Node }</span>
							}
							for _, t := range r.Tags {
								@c.Chip(t, "accent")
							}
							<span class="ml-auto">@c.Chip(r.State, r.Tone)</span>
						</div>
						<p class="text-xs text-rw-muted">{ plural(r.Envs, "env") } · open to { r.Open }</p>
						<div class="flex flex-wrap items-center gap-2">
							if r.Move != "" {
								<button type="button" hx-get={ r.Move } hx-target={ target() } hx-swap="outerHTML" class="btn btn-ghost btn-sm">Repoint</button>
							}
							if r.Progress != "" {
								<button type="button" hx-get={ r.Progress } hx-target={ target() } hx-swap="outerHTML" class="btn btn-ghost btn-sm">Move progress</button>
							}
							if r.Delete.Action != "" {
								@c.Confirm(r.Delete)
							}
						</div>
						if r.Edit.Action != "" {
							<details>
								<summary class="cursor-pointer text-xs text-rw-muted hover:text-rw-text">Open to orgs</summary>
								<div class="mt-2">
									@placementForm(r.Edit, "pl-"+r.Name, false)
								</div>
							</details>
						}
					</li>
				}
			</ul>
		}
		if v.Add.Action != "" {
			@c.Section("Add a placement", "instance", "") {
				@placementForm(v.Add, "pl-add", true)
			}
		}
	</div>
}

// MoveWizard is the repoint wizard's body, above the list.
templ MoveWizard(v MoveWizardView) {
	<div id="move-wizard" class="panel px-4 py-4 mb-4 space-y-4">
		<h3 class="text-sm font-semibold text-rw-text">Repoint { v.Placement }</h3>
		<ol class="flex items-center gap-4 text-xs text-rw-muted">
			for i, s := range []string{"Pick a node", "Checks", "Confirm"} {
				<li class={ templ.KV("text-rw-text font-medium", moveStepOn(v, i+1)) }>{ fmt.Sprint(i+1) } { s }</li>
			}
		</ol>
		if v.Error != "" {
			<p class="text-sm text-rw-danger" role="alert">{ v.Error }</p>
		}
		if v.Step == 1 {
			<form hx-get={ v.Check } hx-target={ target() } hx-swap="outerHTML" class="space-y-3">
				<div>
					<label for="move-to" class="label">Move to</label>
					<select id="move-to" name="to" class="input">
						for _, n := range v.Nodes {
							<option value={ n.Value } selected?={ n.Value == v.To }>{ n.Label }</option>
						}
					</select>
					if v.From != "" {
						<p class="text-xs text-rw-faint mt-1">Now on { v.From }.</p>
					}
				</div>
				<div class="flex gap-2">
					<button type="button" hx-get={ v.Cancel } hx-target={ target() } hx-swap="outerHTML" class="btn btn-ghost btn-sm">Cancel</button>
					<button type="submit" class="btn btn-primary btn-sm">Run checks</button>
				</div>
			</form>
		} else {
			if v.Restore {
				<p class="text-sm text-rw-warn">{ v.From } was forgotten. The envs are restored from backups on { v.To }.</p>
			}
			<ul class="space-y-1" aria-label="Checks">
				for _, k := range v.Checks {
					<li class="flex flex-wrap items-baseline gap-2 text-sm">
						if k.OK {
							<span class="text-rw-success w-4 shrink-0" aria-hidden="true">✓</span>
							<span class="sr-only">Passed:</span>
						} else {
							<span class="text-rw-danger w-4 shrink-0" aria-hidden="true">✗</span>
							<span class="sr-only">Failed:</span>
						}
						<span class="text-rw-text">{ k.Name }</span>
						if k.Detail != "" {
							<span class={ "text-xs", templ.KV("text-rw-muted", k.OK), templ.KV("text-rw-danger", !k.OK) }>{ k.Detail }</span>
						}
					</li>
				}
			</ul>
			if len(v.Envs) > 0 {
				<ul class="space-y-1 text-sm" aria-label="Envs">
					for _, e := range v.Envs {
						<li class="flex flex-wrap items-center gap-2">
							<span class="text-rw-text">{ e.Path }</span>
							<span class="text-xs text-rw-faint">{ plural(e.Volumes, "volume") }
								if e.Size != "" {
									· { e.Size }
								}
							</span>
							<span class="ml-auto text-xs text-rw-muted">{ e.Downtime }</span>
						</li>
					}
				</ul>
			} else {
				<p class="text-sm text-rw-faint">No envs to move; the placement repoints at once.</p>
			}
			<div class="flex flex-wrap gap-2">
				<button type="button" hx-get={ v.Cancel } hx-target={ target() } hx-swap="outerHTML" class="btn btn-ghost btn-sm">Cancel</button>
				<button type="button" hx-get={ v.Check } hx-vals={ moveVals(v.To) } hx-target={ target() } hx-swap="outerHTML" class="btn btn-ghost btn-sm">Re-check</button>
				if v.OK {
					@c.Confirm(v.Confirm)
				} else {
					<button type="button" class="btn btn-primary btn-sm" disabled>Apply</button>
				}
			</div>
		}
	</div>
}

func moveVals(to string) string { return fmt.Sprintf(`{"to":%q}`, to) }

// moveStepOn marks the step the wizard is on: 1 pick, 2 checks, 3 once they pass.
func moveStepOn(v MoveWizardView, i int) bool {
	if v.Step == 1 {
		return i == 1
	}
	return i == 2 && !v.OK || i == 3 && v.OK
}

// MoveProgress is a repoint's progress; it polls itself while running.
templ MoveProgress(v MoveProgressView) {
	<div id="move-progress" class="panel px-4 py-4 mb-4 space-y-3"
		if v.Poll != "" {
			hx-get={ v.Poll } hx-trigger="every 3s" hx-target="#move-progress" hx-swap="outerHTML"
		}
	>
		<div class="flex flex-wrap items-center gap-2">
			<h3 class="text-sm font-semibold text-rw-text">{ v.Placement }: { v.From } to { v.To }</h3>
			<span class="ml-auto">@c.Chip(moveStateWord(v.State), moveStateTone(v.State))</span>
		</div>
		<p class="text-sm text-rw-muted" aria-live="polite">{ fmt.Sprint(v.Done) } of { plural(v.All, "env") } moved.</p>
		if v.Error != "" {
			<p class="text-sm text-rw-danger" role="alert">{ v.Error }</p>
		}
		<ul class="space-y-1 text-sm">
			for _, e := range v.Envs {
				<li class="flex flex-wrap items-center gap-2">
					<span class="text-rw-text">{ e.Path }</span>
					<span class="text-rw-faint">{ e.State }</span>
					<span class="text-rw-muted">{ e.Step }</span>
					if e.Error != "" {
						<span class="text-xs text-rw-danger">{ e.Error }</span>
					}
				</li>
			}
		</ul>
		<div class="flex gap-2">
			<button type="button" hx-get={ v.Back } hx-target={ target() } hx-swap="outerHTML" class="btn btn-ghost btn-sm">Close</button>
			if v.Retry != "" {
				<button type="button" hx-post={ v.Retry } hx-target={ target() } hx-swap="outerHTML" class="btn btn-primary btn-sm">Retry</button>
			}
		</div>
	</div>
}

func moveStateWord(s string) string {
	switch s {
	case "running":
		return "Moving"
	case "failed":
		return "Failed"
	case "done":
		return "Done"
	}
	return s
}

func moveStateTone(s string) string {
	switch s {
	case "failed":
		return "danger"
	case "done":
		return "success"
	}
	return "warn"
}

// ConfirmBody is the confirm dialog's body: where, what moves and how long
// each env is down. It reads as a list inside the dialog.
templ ConfirmBody(from, to string, envs []MoveEnvRow, restore bool) {
	<p class="text-sm text-rw-text">
		if restore {
			Restores from backups onto { to }.
		} else {
			Moves from { from } to { to }.
		}
	</p>
	if len(envs) > 0 {
		<ul class="modal-list">
			for _, e := range envs {
				<li class="modal-list-row text-rw-text">{ e.Path } <span class="text-rw-muted">{ e.Downtime }</span></li>
			}
		</ul>
	}
}
