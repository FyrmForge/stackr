// Package volume is the volume drawer in v0's tabs: Overview (what it is
// and who mounts it), Backups (schedules, back up now, history, restore)
// and Settings (delete an orphan). v0's Tree tab reads files: out of v1.
package volume

import (
	"cmp"
	"context"
	"io"
	"slices"
	"strconv"
	"time"

	c "github.com/FyrmForge/stackr/internal/ui/components"
)

// Root is the id every drawer answer replaces (outerHTML).
const Root = c.DrawerRoot

var Tabs = []string{"overview", "backups", "settings"}

// Tab is the tab a request asks for; an unknown one opens Overview.
func Tab(tab string) string {
	if !slices.Contains(Tabs, tab) {
		return Tabs[0]
	}
	return tab
}

// View is the drawer around one tab.
type View struct {
	Node, Name         string
	Scope              string // env | stack | org
	Base               string // the drawer URL: tabs add ?tab=, actions add /<verb>
	Tab                string
	Status             string // idle, or a backup run's state while one is live
	Location, EnvColor string
	Error, Note        string
}

func Drawer(v View, body templ.Component) templ.Component {
	d := c.DrawerView{
		Node:     v.Node,
		Title:    v.Name,
		Kind:     "volume",
		Base:     v.Base,
		Tabs:     Tabs,
		Tab:      v.Tab,
		Error:    v.Error,
		Note:     v.Note,
		Icon:     "volume",
		Status:   v.Status,
		Location: v.Location,
		EnvColor: v.EnvColor,
	}
	if v.Scope != "env" {
		d.Scope = v.Scope + "-scoped"
	}
	if Tab(v.Tab) == "overview" && v.Base != "" {
		// the poller sits beside #tab-overview (its builder is the env handler's, which has
		// no URL to hand): it lives and dies with the drawer's body
		inner := body
		body = templ.ComponentFunc(func(ctx context.Context, w io.Writer) error {
			if err := c.LiveTab(v.Base+"?tab=overview", "tab-overview").Render(ctx, w); err != nil {
				return err
			}
			return inner.Render(ctx, w)
		})
	}
	return c.Drawer(d, body)
}

type OverviewView struct {
	Docker            string
	Created, Orphaned time.Time // Orphaned: since when; zero = in use
	OldCopy           bool      // the orphan is a move's old copy: no date, it goes when the move ends
	Mounts            []Mount
	Storage           *Storage // nil = where it lives is not known
	Cap               *CapFact // nil = no cap fact (a read that failed)

	// The node disk screens: each is nil when there is nothing to offer.
	Job   *c.JobStatusView // the newest volume-to-disk job of the volume
	Move  *MoveView
	Ghost *GhostView
}

// Storage is where the volume lives. Disk and Docker both = two copies.
// Node and NodeOpen are for a node admin only ("" = not shown). Size "" =
// unknown; SizeAt "" = no read time (a Docker volume).
type Storage struct {
	Disk, Docker bool
	State        string // the disk's: adding | ready | missing
	Folder, Node string
	Mismatch     bool // an object bound to Folder, not to the volume's own folder
	NodeOpen     string
	Size         string
	SizeBytes    int64  // -1 = unknown
	SizeAt       string // "2 min ago"; "" = no read time
}

// Mount is a tile that mounts the volume, and where.
type Mount struct{ Tile, Path string }

// Overview is v0's stat cards.
templ Overview(o OverviewView) {
	<div id="tab-overview" class="flex flex-col gap-4">
		@volGhost(o)
		@volFinish(o)
		@volJob(o)
		if s := o.Storage; s != nil && s.Disk && s.State == "missing" {
			<div class="banner banner-danger flex items-start gap-2" role="status">
				@alertIcon()
				<div>
					<p class="font-medium">Its disk is missing.</p>
					<p class="text-sm mt-0.5">
						Tiles that use it do not start.
						if s.NodeOpen != "" {
							<a href={ templ.SafeURL(s.NodeOpen) } class="underline">Open { s.Node }</a>
						}
					</p>
				</div>
			</div>
		}
		<div class="grid gap-4 sm:grid-cols-2">
			@stat("Attached to") {
				if len(o.Mounts) == 0 {
					<p class="text-sm text-rw-muted">nothing</p>
				}
				for _, m := range o.Mounts {
					<p class="text-sm text-rw-text">{ m.Tile }</p>
					<p class="text-xs text-rw-faint font-mono">{ m.Path }</p>
				}
			}
			if s := o.Storage; s != nil {
				@stat("Stored on") {
					<div class="flex flex-wrap items-center gap-1.5">
						if s.Disk {
							@c.Chip("Node disk", "accent")
						}
						if s.Docker {
							@c.Chip("Docker storage", "")
						}
						if s.Mismatch {
							@c.Chip("Mismatch", "danger")
						}
						if s.Disk && !s.Docker && !s.Mismatch {
							switch s.State {
								case "ready":
									@c.Chip("Ready", "success")
								case "missing":
									@c.Chip("Disk missing", "danger")
								default:
									@c.Chip("Adding", "warn")
							}
						}
					</div>
					if s.Folder != "" && !s.Docker {
						<p class="mt-2 text-xs text-rw-text font-mono break-all">{ s.Folder }</p>
					}
					if s.Node != "" {
						<p class="mt-1 text-xs text-rw-faint">{ s.Node }</p>
					}
					@volMove(o)
				}
				if s.Size != "" || s.Disk {
					@stat("Size") {
						if s.Size == "" {
							<p class="text-sm text-rw-muted">unknown</p>
						} else {
							<p class="text-sm text-rw-text">{ s.Size }</p>
							if s.SizeAt != "" {
								<p class="text-xs text-rw-faint">as of { s.SizeAt }</p>
							}
						}
					}
				}
			}
			@stat("Created") {
				<p class="text-sm text-rw-text">@c.When(o.Created)</p>
			}
			if o.Cap != nil {
				@capFact(o.Cap)
			}
			<div class="panel p-4 sm:col-span-2">
				<p class="text-xs text-rw-muted mb-1.5">Docker volume</p>
				<p class="text-sm text-rw-text font-mono break-all">{ o.Docker }</p>
			</div>
		</div>
		<div class="space-y-1">
			<p class="text-xs text-rw-muted">Data persists across redeploys and tile deletion.</p>
			if o.OldCopy {
				<p class="text-xs text-rw-warn">Old copy, kept until the move finishes.</p>
			} else if !o.Orphaned.IsZero() {
				<p class="text-xs text-rw-warn">
					{ "Orphaned since " }
					@c.When(o.Orphaned) {
						{ ": no tile mounts it." }
					}
				</p>
			}
		</div>
	</div>
}

templ alertIcon() {
	<svg class="h-4 w-4 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg>
}

templ stat(label string) {
	<div class="panel p-4">
		<p class="text-xs text-rw-muted mb-1.5">{ label }</p>
		{ children... }
	</div>
}

// BackupsView is one volume's backups, drawn in its own drawer and in its
// instance's Backups tab. Every action answers the volume's drawer.
type BackupsView struct {
	ID, Name  string
	Base      string // the volume's drawer URL
	Schedules []Schedule
	Runs      []Run
	Dests     []Option // "" = local disk
	Methods   []string
	Live      bool // a run is queued or running: History polls
	Poll      int  // polls left while a just-queued job has no run row yet
	Edit      bool // the viewer may add and delete schedules and back up now
}

type Schedule struct{ ID, Method, Cron, TZ, Dest, Keep, Mode string }

type Run struct {
	ID, Status, Trigger, Size, Error, Dest string
	When                                   time.Time
	Restorable                             bool
}

type Option struct{ Value, Label string }

// methodLabel is how v0 spells a backup kind.
func methodLabel(m string) string {
	switch m {
	case "dump":
		return "Database dump"
	case "volume":
		return "Volume archive"
	case "base":
		return "Point-in-time base backup"
	}
	return m
}

// Backups is the volume's one panel: a flat group per schedule (Runs, Keep,
// While it runs; a pencil edits a row in place, Apply saves), then Add a
// schedule and Back up now, then the history. Edit gates every button.
templ Backups(b BackupsView) {
	<div class="space-y-4">
		<section class="panel p-4 sm:p-6 overflow-hidden">
			<h2 class="text-base font-semibold text-rw-text tracking-tight">{ b.Name }</h2>
			if len(b.Schedules) == 0 {
				<p class="mt-1 text-sm text-rw-muted">No backups are scheduled.</p>
			}
			for _, s := range b.Schedules {
				<div class="mt-4">
					<div class="mb-1 flex flex-wrap items-baseline gap-x-2">
						<h3 class="text-sm font-medium text-rw-text">{ methodLabel(s.Method) }</h3>
						<span class="text-xs text-rw-faint">to { s.Dest }</span>
						if b.Edit {
							<span class="ml-auto">
								@c.Confirm(c.ConfirmView{
									Button:  "Remove",
									Title:   "Remove this schedule?",
									Warning: "Backups stop on it.",
									Kept:    []string{"archives already in the destination"},
									Action:  b.Base + "/schedules/" + s.ID + "/delete",
									Target:  "#" + Root,
									Quiet:   true,
								})
							</span>
						}
					</div>
					@c.SettingsForm(scheduleRows(b, s))
				</div>
			}
			if b.Edit {
				@addControls(b)
			}
		</section>
		@History(b)
	</div>
}

// scheduleRows is one schedule as facts. Runs is shown only (a changed time
// is a new schedule); Keep and While it runs have their pencils.
func scheduleRows(b BackupsView, s Schedule) c.SettingsFormView {
	v := c.SettingsFormView{
		ID: "sched-" + s.ID, Action: b.Base + "/schedules/" + s.ID, Target: "#" + Root,
		Scope: methodLabel(s.Method), Flat: true,
	}
	v.Rows = append(v.Rows, c.SettingRowView{Key: "runs", Label: "Runs", Value: Runs(s.Cron), Fact: true,
		Sub: &c.RowSub{Text: s.TZ + ", " + s.Cron}})
	if s.Keep == "" {
		v.Rows = append(v.Rows, c.SettingRowView{Key: "keep", Label: "Keep", Value: "the recovery window", Fact: true})
	} else {
		v.Rows = append(v.Rows, c.SettingRowView{Key: "keep", Label: "Keep", Type: "int", Value: s.Keep, NoInherit: true, Desc: "Archives kept. 0 keeps all."})
	}
	v.Rows = append(v.Rows, c.SettingRowView{Key: "mode", Label: "While it runs", Type: "string", Value: cmp.Or(s.Mode, "pause"), NoInherit: true,
		Options: []c.Option{{Value: "pause", Label: "Pause tiles"}, {Value: "stop", Label: "Stop tiles"}, {Value: "live", Label: "Leave running"}}})
	if !b.Edit { // read only: facts, no pencils, nothing to post to
		v.ReadOnly = true
		for i := range v.Rows {
			v.Rows[i].Fact = true
		}
	}
	return v
}

// addControls: the two buttons open their form below by a checkbox each, so
// no script is needed and a swap closes both.
templ addControls(b BackupsView) {
	<input type="checkbox" id="add-sched" class="peer/add sr-only" aria-label="Add a schedule"/>
	<input type="checkbox" id="back-now" class="peer/now sr-only" aria-label="Back up now"/>
	<div class="mt-2 flex flex-wrap items-center gap-2 border-t border-rw-border pt-3">
		<label for="add-sched" class={ "btn btn-sm cursor-pointer", templ.KV("btn-primary", len(b.Schedules) == 0) }>Add a schedule</label>
		<label for="back-now" class="btn btn-sm cursor-pointer">Back up now</label>
	</div>
	@scheduleForm(b)
	@backupNow(b)
}

// scheduleForm adds a schedule. Nothing is prefilled; an empty field takes
// the default its hint names.
templ scheduleForm(b BackupsView) {
	<form hx-post={ b.Base + "/schedules" } hx-target={ "#" + Root } hx-swap="outerHTML" class="mt-2 hidden gap-4 border-t border-rw-border pt-4 sm:grid-cols-2 peer-checked/add:grid">
		<div>
			<label class="label" for="sched-method">What to back up</label>
			<select id="sched-method" name="method" class="input">
				<option value="">Choose</option>
				for _, m := range b.Methods {
					<option value={ m }>{ methodLabel(m) }</option>
				}
			</select>
		</div>
		<div>
			<label class="label" for="sched-dest">Store on</label>
			<select id="sched-dest" name="dest" class="input">
				<option value="">Choose</option>
				for _, d := range b.Dests {
					if d.Value != "" {
						<option value={ d.Value }>{ d.Label }</option>
					}
				}
			</select>
			<span class="settings-help">Empty uses local disk.</span>
		</div>
		<div>
			<label class="label" for="sched-repeat">Repeat</label>
			<select id="sched-repeat" name="repeat" class="input" required>
				<option value="">Choose</option>
				<option value="day">Every day</option>
				<option value="week">Every week</option>
				<option value="hour">Every hour</option>
			</select>
		</div>
		<div>
			<label class="label" for="sched-at">At</label>
			<input id="sched-at" name="at" type="time" class="input"/>
			<span class="settings-help">Empty uses 03:00.</span>
		</div>
		<div>
			<label class="label" for="sched-tz">Time zone</label>
			<input id="sched-tz" name="tz" class="input" placeholder="UTC" autocomplete="off"/>
			<span class="settings-help">Empty uses UTC.</span>
		</div>
		<div>
			<label class="label" for="sched-keep">Keep</label>
			<input id="sched-keep" name="keep" type="number" min="0" class="input" placeholder="7"/>
			<span class="settings-help">Archives kept. 0 keeps all.</span>
		</div>
		<div>
			<label class="label" for="sched-mode">While it runs</label>
			<select id="sched-mode" name="mode" class="input">
				<option value="">Choose</option>
				<option value="pause">Pause tiles</option>
				<option value="stop">Stop tiles</option>
				<option value="live">Leave running</option>
			</select>
			<span class="settings-help">Empty pauses tiles.</span>
		</div>
		<div class="flex items-center gap-2 sm:col-span-2">
			<button type="submit" class="btn btn-primary btn-sm">Add schedule</button>
			<label for="add-sched" class="btn btn-sm cursor-pointer">Cancel</label>
		</div>
	</form>
}

// backupNow is the one-off backup, behind its button.
templ backupNow(b BackupsView) {
	<form hx-post={ b.Base + "/backup" } hx-target={ "#" + Root } hx-swap="outerHTML" class="mt-2 hidden gap-4 border-t border-rw-border pt-4 sm:grid-cols-2 peer-checked/now:grid">
		<div>
			<label class="label" for="now-method">What to back up</label>
			<select id="now-method" name="method" class="input">
				for _, m := range b.Methods {
					<option value={ m }>{ methodLabel(m) }</option>
				}
			</select>
		</div>
		<div>
			<label class="label" for="now-dest">Store on</label>
			<select id="now-dest" name="dest" class="input">
				for _, d := range b.Dests {
					<option value={ d.Value }>{ d.Label }</option>
				}
			</select>
		</div>
		<div>
			<label class="label" for="now-mode">While it runs</label>
			<select id="now-mode" name="mode" class="input" aria-describedby="backup-mode-help">
				<option value="pause">Pause tiles</option>
				<option value="stop">Stop tiles</option>
				<option value="live">Leave running</option>
			</select>
			<span id="backup-mode-help" class="settings-help" data-hint>Pausing or stopping holds the tiles on this volume until the copy is done.</span>
		</div>
		<div class="flex items-center gap-2 sm:col-span-2">
			<button type="submit" class="btn btn-primary btn-sm">Back up now</button>
			<label for="back-now" class="btn btn-sm cursor-pointer">Cancel</label>
		</div>
	</form>
}

// historyEvery is the poll beat: 2 s while a run is live or just queued (the
// job writes its run row when it starts), else 3 s so a run started
// elsewhere still shows.
func historyEvery(b BackupsView) string {
	if b.Live || b.Poll > 0 {
		return "every 2s"
	}
	return "every 3s"
}

// History polls its own drawer, always, and keeps only itself from the answer.
templ History(b BackupsView) {
	<div
		id={ "backup-history-" + b.ID }
		class="panel p-5"
		if b.Base != "" {
			data-poll-guard=""
			hx-get={ b.Base + "?tab=backups&poll="+ strconv.Itoa(max(b.Poll-1, 0)) }
			hx-trigger={ historyEvery(b) }
			hx-select={ "#backup-history-" + b.ID }
			hx-target="this"
			hx-swap="outerHTML"
		}
	>
		<h4 class="text-xs font-semibold uppercase tracking-wide text-rw-faint mb-2">History</h4>
		if len(b.Runs) == 0 {
			<p class="text-xs text-rw-faint">No runs yet.</p>
		} else {
			<ul class="space-y-1.5">
				for _, r := range b.Runs {
					<li class="flex flex-wrap items-center gap-2 text-xs">
						<span class="text-rw-muted font-mono">@c.When(r.When)</span>
						switch r.Status {
							case "done":
								<span class="text-rw-muted">{ r.Size }</span>
							case "queued", "running":
								<span class="text-rw-muted">{ r.Status }</span>
							default:
								<span class="text-rw-danger">{ r.Status }</span>
						}
						if r.Trigger != "schedule" {
							<span class="text-rw-faint">{ r.Trigger }</span>
						}
						if r.Dest != "" {
							<span class="text-rw-faint">to { r.Dest }</span>
						}
						if r.Error != "" {
							<span class="text-rw-danger truncate">{ r.Error }</span>
						}
						if r.Restorable {
							<span class="ml-auto">
								@c.Confirm(restore(b, r))
							</span>
						}
					</li>
				}
			</ul>
		}
	</div>
}

func restore(b BackupsView, r Run) c.ConfirmView {
	return c.ConfirmView{
		Button:  "Restore",
		Title:   "Restore " + b.Name + " from " + r.When.UTC().Format(c.WhenLayout) + " UTC?",
		Warning: "The current data is overwritten; its tiles stop while it restores.",
		Kept:    []string{"this backup and every other in the destination"},
		Action:  b.Base + "/restore?run=" + r.ID,
		Target:  "#" + Root,
		Quiet:   true,
	}
}

// Settings is the size cap (cap nil = none to show) and the delete. blocked
// says why it cannot go ("" = it can): v0's "Detach before deleting".
templ Settings(v View, blocked string, cap *CapCard) {
	<div id="tab-settings" class="flex flex-col gap-4">
		if cap != nil && cap.Mode == "read" && v.Base != "" {
			// "Cap not applied yet." comes and goes by itself; an edit or a staged change is not polled
			@c.LiveTab(v.Base+"?tab=settings", "tab-settings")
		}
		if cap != nil {
			@capCard(*cap)
		}
		if blocked != "" {
			<p class="text-sm text-rw-muted">{ blocked }</p>
		} else {
			@c.DangerZone("Deleting this volume keeps its data for the retention window, then backs it up once and removes it.", v.Name, "Backups already in a destination are kept.") {
				@c.Confirm(c.ConfirmView{
					Button:  "Delete volume",
					Title:   "Delete " + v.Name + "?",
					Warning: "Its data is kept for the retention window, then backed up once and removed.",
					Kept:    []string{"backups already in a destination"},
					Word:    v.Name,
					Action:  v.Base + "/delete",
					Target:  "#" + Root,
				})
			}
		}
	</div>
}

// Deleted replaces the drawer once the volume is gone.
templ Deleted() {
	@c.Drawer(c.DrawerView{Title: "Volume deleted", Icon: "volume"}, deleted())
}

templ deleted() {
	<p class="banner" role="status">The volume and its data are gone. Backups in a destination are kept.</p>
}
