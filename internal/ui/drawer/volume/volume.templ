// Package volume is the volume drawer in v0's tabs: Overview (what it is
// and who mounts it), Backups (schedules, back up now, history, restore)
// and Settings (delete an orphan). v0's Tree tab reads files: out of v1.
package volume

import (
	"context"
	"io"
	"slices"
	"strconv"
	"time"

	c "github.com/FyrmForge/stackr/internal/ui/components"
)

// Root is the id every drawer answer replaces (outerHTML).
const Root = c.DrawerRoot

var Tabs = []string{"overview", "backups", "settings"}

// Tab is the tab a request asks for; an unknown one opens Overview.
func Tab(tab string) string {
	if !slices.Contains(Tabs, tab) {
		return Tabs[0]
	}
	return tab
}

// View is the drawer around one tab.
type View struct {
	Node, Name         string
	Scope              string // env | stack | org
	Base               string // the drawer URL: tabs add ?tab=, actions add /<verb>
	Tab                string
	Status             string // idle, or a backup run's state while one is live
	Location, EnvColor string
	Error, Note        string
}

func Drawer(v View, body templ.Component) templ.Component {
	d := c.DrawerView{
		Node:     v.Node,
		Title:    v.Name,
		Kind:     "volume",
		Base:     v.Base,
		Tabs:     Tabs,
		Tab:      v.Tab,
		Error:    v.Error,
		Note:     v.Note,
		Icon:     "volume",
		Status:   v.Status,
		Location: v.Location,
		EnvColor: v.EnvColor,
	}
	if v.Scope != "env" {
		d.Scope = v.Scope + "-scoped"
	}
	if Tab(v.Tab) == "overview" && v.Base != "" {
		// the poller sits beside #tab-overview (its builder is the env handler's, which has
		// no URL to hand): it lives and dies with the drawer's body
		inner := body
		body = templ.ComponentFunc(func(ctx context.Context, w io.Writer) error {
			if err := c.LiveTab(v.Base+"?tab=overview", "tab-overview").Render(ctx, w); err != nil {
				return err
			}
			return inner.Render(ctx, w)
		})
	}
	return c.Drawer(d, body)
}

type OverviewView struct {
	Docker            string
	Created, Orphaned time.Time // Orphaned: since when; zero = in use
	Mounts            []Mount
	Storage           *Storage // nil = where it lives is not known
}

// Storage is where the volume lives. Disk and Docker both = two copies.
// Node and NodeOpen are for a node admin only ("" = not shown). Size "" =
// unknown; SizeAt "" = no read time (a Docker volume).
type Storage struct {
	Disk, Docker bool
	State        string // the disk's: adding | ready | missing
	Folder, Node string
	NodeOpen     string
	Size         string
	SizeAt       string // "2 min ago"; "" = no read time
}

// Mount is a tile that mounts the volume, and where.
type Mount struct{ Tile, Path string }

// Overview is v0's stat cards.
templ Overview(o OverviewView) {
	<div id="tab-overview">
		if s := o.Storage; s != nil && s.Disk && s.Docker {
			<div class="banner banner-danger flex items-start gap-2 mb-3" role="status">
				@alertIcon()
				<div>
					<p class="font-medium">Two copies of this volume.</p>
					<p class="text-sm mt-0.5">One on the node disk, one in Docker storage. Deploys, backups and delete are refused.</p>
				</div>
			</div>
		} else if s != nil && s.Disk && s.State == "missing" {
			<div class="banner banner-danger flex items-start gap-2 mb-3" role="status">
				@alertIcon()
				<div>
					<p class="font-medium">Its disk is missing.</p>
					<p class="text-sm mt-0.5">
						Tiles that use it do not start.
						if s.NodeOpen != "" {
							<a href={ templ.SafeURL(s.NodeOpen) } class="underline">Open { s.Node }</a>
						}
					</p>
				</div>
			</div>
		}
		<div class="grid gap-3 sm:grid-cols-2">
			@stat("Attached to") {
				if len(o.Mounts) == 0 {
					<p class="text-sm text-rw-muted">nothing</p>
				}
				for _, m := range o.Mounts {
					<p class="text-sm text-rw-text">{ m.Tile }</p>
					<p class="text-xs text-rw-faint font-mono">{ m.Path }</p>
				}
			}
			if s := o.Storage; s != nil {
				@stat("Stored on") {
					<div class="flex flex-wrap items-center gap-1.5">
						if s.Disk {
							@c.Chip("Node disk", "accent")
						}
						if s.Docker {
							@c.Chip("Docker storage", "")
						}
						if s.Disk && !s.Docker {
							switch s.State {
								case "ready":
									@c.Chip("Ready", "success")
								case "missing":
									@c.Chip("Disk missing", "danger")
								default:
									@c.Chip("Adding", "warn")
							}
						}
					</div>
					if s.Folder != "" && !s.Docker {
						<p class="mt-2 text-xs text-rw-text font-mono break-all">{ s.Folder }</p>
					}
					if s.Node != "" {
						<p class="mt-1 text-xs text-rw-faint">{ s.Node }</p>
					}
				}
				@stat("Size") {
					if s.Size == "" {
						<p class="text-sm text-rw-muted">unknown</p>
					} else {
						<p class="text-sm text-rw-text">{ s.Size }</p>
						if s.SizeAt != "" {
							<p class="text-xs text-rw-faint">as of { s.SizeAt }</p>
						}
					}
				}
			}
			@stat("Created") {
				<p class="text-sm text-rw-text">@c.When(o.Created)</p>
			}
			<div class="panel p-4 sm:col-span-2">
				<p class="text-xs text-rw-muted mb-1.5">Docker volume</p>
				<p class="text-sm text-rw-text font-mono break-all">{ o.Docker }</p>
			</div>
		</div>
		<p class="mt-3 text-xs text-rw-muted">Data persists across redeploys and tile deletion.</p>
		if !o.Orphaned.IsZero() {
			<p class="mt-1 text-xs text-rw-warn">
				{ "Orphaned since " }
				@c.When(o.Orphaned) {
					{ ": no tile mounts it." }
				}
			</p>
		}
	</div>
}

templ alertIcon() {
	<svg class="h-4 w-4 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg>
}

templ stat(label string) {
	<div class="panel p-4">
		<p class="text-xs text-rw-muted mb-1.5">{ label }</p>
		{ children... }
	</div>
}

// BackupsView is one volume's backups, drawn in its own drawer and in its
// instance's Backups tab. Every action answers the volume's drawer.
type BackupsView struct {
	ID, Name  string
	Base      string // the volume's drawer URL
	Schedules []Schedule
	Runs      []Run
	Dests     []Option // "" = local disk
	Methods   []string
	Live      bool // a run is queued or running: History polls
	Poll      int  // polls left while a just-queued job has no run row yet
	Edit      bool // the viewer may add and delete schedules and back up now
}

type Schedule struct{ ID, Method, Cron, TZ, Dest, Keep, Mode string }

type Run struct {
	ID, Status, Trigger, Size, Error, Dest string
	When                                   time.Time
	Restorable                             bool
}

type Option struct{ Value, Label string }

// methodLabel is how v0 spells a backup kind.
func methodLabel(m string) string {
	switch m {
	case "dump":
		return "Database dump"
	case "volume":
		return "Volume archive"
	case "base":
		return "Point-in-time base backup"
	}
	return m
}

// Backups is v0's backup panel: a panel per schedule, Back up now, the
// history. Schedules are added and deleted here; Edit gates the buttons.
templ Backups(b BackupsView) {
	<div class="space-y-4">
		for _, s := range b.Schedules {
			<div class="panel p-5 space-y-2">
				<div class="flex items-center gap-2">
					<span class="text-sm font-medium text-rw-text">{ methodLabel(s.Method) }</span>
					<span class="text-xs text-rw-faint">{ s.Dest }</span>
				</div>
				<p class="text-xs text-rw-muted">
					<span class="font-mono text-rw-text">{ s.Cron }</span> { s.TZ } ·
					if s.Keep == "" {
						keeps the recovery window
					} else {
						keeps the newest { s.Keep }
					}
				</p>
				if b.Edit {
					@c.Confirm(c.ConfirmView{
						Button:  "Delete",
						Title:   "Delete this schedule?",
						Warning: "Backups stop on it.",
						Kept:    []string{"archives already in the destination"},
						Action:  b.Base + "/schedules/" + s.ID + "/delete",
						Target:  "#" + Root,
						Quiet:   true,
					})
				}
			</div>
		}
		if b.Edit {
			@scheduleForm(b)
		}
		if b.Edit {
		<form hx-post={ b.Base + "/backup" } hx-target={ "#" + Root } hx-swap="outerHTML" class="panel p-5 space-y-4">
			<h4 class="text-sm font-medium text-rw-text">Back up now</h4>
			<div class="grid gap-4 sm:grid-cols-2">
				<label class="block">
					<span class="block text-xs text-rw-faint mb-1">What to back up</span>
					<select name="method" class="input">
						for _, m := range b.Methods {
							<option value={ m }>{ methodLabel(m) }</option>
						}
					</select>
				</label>
				<label class="block">
					<span class="block text-xs text-rw-faint mb-1">Destination</span>
					<select name="dest" class="input">
						for _, d := range b.Dests {
							<option value={ d.Value }>{ d.Label }</option>
						}
					</select>
				</label>
				<label class="block">
					<span class="block text-xs text-rw-faint mb-1">While it runs</span>
					<select name="mode" class="input" aria-describedby="backup-mode-help">
						<option value="pause">Pause tiles</option>
						<option value="stop">Stop tiles</option>
						<option value="live">Leave running</option>
					</select>
				</label>
			</div>
			<p id="backup-mode-help" class="text-xs text-rw-faint" data-hint>Pausing or stopping holds the tiles on this volume until the copy is done.</p>
			<button type="submit" class="btn btn-primary btn-sm">Back up now</button>
		</form>
		}
		@History(b)
	</div>
}

// scheduleForm adds a schedule: the CLI's fields.
templ scheduleForm(b BackupsView) {
	<form hx-post={ b.Base + "/schedules" } hx-target={ "#" + Root } hx-swap="outerHTML" class="panel p-5 space-y-4">
		<h4 class="text-sm font-medium text-rw-text">Schedule backups</h4>
		<div class="grid gap-4 sm:grid-cols-2">
			@c.Field(c.FieldView{Name: "schedule", Label: "Schedule", Help: "Five-field cron."})
			@c.Field(c.FieldView{Name: "tz", Label: "Time zone", Value: "UTC"})
			<label class="block">
				<span class="block text-xs text-rw-faint mb-1">What to back up</span>
				<select name="method" class="input">
					for _, m := range b.Methods {
						<option value={ m }>{ methodLabel(m) }</option>
					}
				</select>
			</label>
			<label class="block">
				<span class="block text-xs text-rw-faint mb-1">Destination</span>
				<select name="dest" class="input">
					for _, d := range b.Dests {
						<option value={ d.Value }>{ d.Label }</option>
					}
				</select>
			</label>
			@c.Field(c.FieldView{Name: "keep", Label: "Keep", Type: "number", Value: "7", Help: "Archives kept. 0 keeps all."})
			<label class="block">
				<span class="block text-xs text-rw-faint mb-1">While it runs</span>
				<select name="mode" class="input">
					<option value="pause">Pause tiles</option>
					<option value="stop">Stop tiles</option>
					<option value="live">Leave running</option>
				</select>
			</label>
		</div>
		<button type="submit" class="btn btn-primary btn-sm">Add schedule</button>
	</form>
}

// historyEvery is the poll beat: 2 s while a run is live or just queued (the
// job writes its run row when it starts), else 3 s so a run started
// elsewhere still shows.
func historyEvery(b BackupsView) string {
	if b.Live || b.Poll > 0 {
		return "every 2s"
	}
	return "every 3s"
}

// History polls its own drawer, always, and keeps only itself from the answer.
templ History(b BackupsView) {
	<div
		id={ "backup-history-" + b.ID }
		class="panel p-5"
		if b.Base != "" {
			data-poll-guard=""
			hx-get={ b.Base + "?tab=backups&poll="+ strconv.Itoa(max(b.Poll-1, 0)) }
			hx-trigger={ historyEvery(b) }
			hx-select={ "#backup-history-" + b.ID }
			hx-target="this"
			hx-swap="outerHTML"
		}
	>
		<h4 class="text-xs font-semibold uppercase tracking-wide text-rw-faint mb-2">History</h4>
		if len(b.Runs) == 0 {
			<p class="text-xs text-rw-faint">No runs yet.</p>
		} else {
			<ul class="space-y-1.5">
				for _, r := range b.Runs {
					<li class="flex flex-wrap items-center gap-2 text-xs">
						<span class="text-rw-muted font-mono">@c.When(r.When)</span>
						switch r.Status {
							case "done":
								<span class="text-rw-muted">{ r.Size }</span>
							case "queued", "running":
								<span class="text-rw-muted">{ r.Status }</span>
							default:
								<span class="text-rw-danger">{ r.Status }</span>
						}
						if r.Trigger != "schedule" {
							<span class="text-rw-faint">{ r.Trigger }</span>
						}
						if r.Dest != "" {
							<span class="text-rw-faint">to { r.Dest }</span>
						}
						if r.Error != "" {
							<span class="text-rw-danger truncate">{ r.Error }</span>
						}
						if r.Restorable {
							<span class="ml-auto">
								@c.Confirm(restore(b, r))
							</span>
						}
					</li>
				}
			</ul>
		}
	</div>
}

func restore(b BackupsView, r Run) c.ConfirmView {
	return c.ConfirmView{
		Button:  "Restore",
		Title:   "Restore " + b.Name + " from " + r.When.UTC().Format(c.WhenLayout) + " UTC?",
		Warning: "The current data is overwritten; its tiles stop while it restores.",
		Kept:    []string{"this backup and every other in the destination"},
		Action:  b.Base + "/restore?run=" + r.ID,
		Target:  "#" + Root,
		Quiet:   true,
	}
}

// Settings is the delete. blocked says why it cannot go ("" = it can):
// v0's "Detach before deleting".
templ Settings(v View, blocked string) {
	<div id="tab-settings">
		if blocked != "" {
			<p class="text-sm text-rw-muted">{ blocked }</p>
		} else {
			@c.DangerZone("Deleting this volume keeps its data for the retention window, then backs it up once and removes it.", v.Name, "Backups already in a destination are kept.") {
				@c.Confirm(c.ConfirmView{
					Button:  "Delete volume",
					Title:   "Delete " + v.Name + "?",
					Warning: "Its data is kept for the retention window, then backed up once and removed.",
					Kept:    []string{"backups already in a destination"},
					Word:    v.Name,
					Action:  v.Base + "/delete",
					Target:  "#" + Root,
				})
			}
		}
	</div>
}

// Deleted replaces the drawer once the volume is gone.
templ Deleted() {
	@c.Drawer(c.DrawerView{Title: "Volume deleted", Icon: "volume"}, deleted())
}

templ deleted() {
	<p class="banner" role="status">The volume and its data are gone. Backups in a destination are kept.</p>
}
