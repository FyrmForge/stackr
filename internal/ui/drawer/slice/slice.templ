// Package slice is the slice tile drawer: Overview (what it is cut from,
// or why it resolves nowhere, its consumers and its database or bucket)
// and Settings (default access, each consumer's access, what removing it
// does, and the delete) as accordion rows with their own Save. A slice
// has no container, so no logs of its own (its instance's drawer has them).
package slice

import (
	"cmp"
	"fmt"
	"slices"
	"strconv"
	"time"

	c "github.com/FyrmForge/stackr/internal/ui/components"
)

// Root is the id every drawer answer replaces (outerHTML).
const Root = c.DrawerRoot

// Tabs in order; the canvas opens the first.
var Tabs = []string{"overview", "settings"}

// Tab is the tab a request asks for; an unknown one opens Overview.
func Tab(tab string) string {
	if !slices.Contains(Tabs, tab) {
		return Tabs[0]
	}
	return tab
}

// View is one slice tile.
type View struct {
	Node, Name         string
	Base               string // the drawer URL: tabs add ?tab=, actions add /<verb>
	Tab                string
	Open               string // the Settings row open on load: the saved one, or ?open=
	Status             string // a TileBadge word
	Location, EnvColor string
	Error, Note        string
	ReadOnly           bool // the viewer may not write: no forms, no delete
	CanBranch          bool // a provisioned postgres slice: the Branch row

	ProvisionFrom string // as written
	Target        string // "stack/env/tile" it resolves to; "" = Blocker says why
	TargetLink    string // that env's canvas with the instance's drawer open
	Blocker       string
	DefaultAccess string // "" = unset, which grants write
	FileOwned     bool   // config-managed: default access is the stack file's
	OnRemove      string
	Consumers     []Consumer
	Provisioned   bool
	DBName        string // the database or bucket, once provisioned
	// A bucket slice's protection: days old versions are kept (0 = off),
	// the size cap in GB (0 = none) and the CORS origins, comma-joined.
	IsBucket    bool
	VersionDays int
	QuotaGB     int
	CORS        string
	Job           *c.JobStatusView // the newest job, a failed seed's error with it; nil = none yet
	JobWhen       time.Time
}

// Consumer is one tile holding a cred on the slice.
type Consumer struct {
	Slug, Name, Link, Kind, Access, User string // Slug posts; Name shows
	Since                                time.Time
}

func Drawer(v View, body templ.Component) templ.Component {
	return c.Drawer(c.DrawerView{
		Node:     v.Node,
		Title:    v.Name,
		Kind:     "slice",
		Base:     v.Base,
		Tabs:     Tabs,
		Tab:      Tab(v.Tab),
		Error:    v.Error,
		Note:     v.Note,
		Icon:     "slice",
		Status:   v.Status,
		Location: v.Location,
		EnvColor: v.EnvColor,
	}, body)
}

templ Overview(v View) {
	<div id="tab-overview">
		@c.PanelSection("slice-target", "Target", "") {
			if v.Target != "" {
				<a href={ templ.SafeURL(v.TargetLink) } class="font-mono text-sm text-rw-accentHi hover:underline">{ v.Target }</a>
			} else {
				<p class="text-sm text-rw-danger" role="alert">{ v.Blocker }</p>
				<p class="text-xs text-rw-faint font-mono" data-hint>{ "Written as " + v.ProvisionFrom }</p>
			}
		}
		@c.PanelSection("slice-consumers", "Consumers", "") {
			@c.Table(c.TableView{
				Headers:   []string{"Consumer", "Kind", "Access", "User", "Since"},
				Rows:      consumerRows(v),
				EmptyText: "No tile uses it yet. A consumer gets access at its next deploy.",
			})
		}
		@c.PanelSection("slice-status", "Status", "") {
			@c.Facts() {
				@c.Fact("Provisioned", yesNo(v.Provisioned))
				@c.Fact("Name", v.DBName)
			}
		}
		if v.IsBucket && v.Provisioned {
			@c.PanelSection("slice-storage", "Storage", "") {
				<div hx-get={ v.Base + "/usage" } hx-trigger="load" hx-swap="outerHTML" aria-busy="true" class="text-xs text-rw-faint">Measuring…</div>
			}
		}
		if v.Job != nil {
			@c.PanelSection("slice-job", "Last job", "") {
				@c.JobStatus(*v.Job)
				<div class="text-xs text-rw-faint mt-1.5">@c.When(v.JobWhen)
</div>
			}
		}
	</div>
}

// Settings is one accordion row per thing the slice sets, each with its
// own Save.
templ Settings(v View) {
	<div id="tab-settings">
		@c.SettingsAccordion(c.SettingsAcc{ID: "slice-settings", Rows: settingsRows(v), Open: v.Open})
	</div>
}

func settingsRows(v View) []c.AccRow {
	rows := []c.AccRow{
		{Key: "general", Title: "Name", Summary: v.Name, Body: nameRow(v)},
		{Key: "access", Title: "Default access", Summary: access(v.DefaultAccess), Changed: v.DefaultAccess == "read", Body: accessRow(v)},
	}
	if len(v.Consumers) > 0 {
		rows = append(rows, c.AccRow{Key: "consumers", Title: "Consumer access", Summary: ConsumersSummary(v.Consumers), Body: consumersRow(v)})
	}
	if v.CanBranch && !v.ReadOnly {
		rows = append(rows, c.AccRow{Key: "branch", Title: "Branch", Summary: "copy now or as of a time", Body: branchRow(v)})
	}
	if v.IsBucket {
		rows = append(rows, c.AccRow{Key: "bucket", Title: "Versions and limits", Summary: bucketSummary(v), Body: bucketRow(v)})
		if v.Provisioned && !v.ReadOnly {
			rows = append(rows, c.AccRow{Key: "restore", Title: "Restore", Summary: "to an earlier time", Body: restoreRow(v)})
		}
	}
	rows = append(rows, c.AccRow{Key: "remove", Title: "On remove", Summary: onRemoveWord(v.OnRemove), Changed: v.OnRemove == "drop", Body: removeRow(v)})
	if !v.ReadOnly {
		rows = append(rows, c.AccRow{Key: "delete", Title: "Delete", Body: deleteRow(v)})
	}
	return rows
}

// access is the default access in force: unset grants write.
func access(a string) string { return cmp.Or(a, "write") }

// ConsumersSummary counts the consumers by their access: "2 write · 1 read".
func ConsumersSummary(cs []Consumer) string {
	w, r := 0, 0
	for _, x := range cs {
		if x.Access == "read" {
			r++
		} else {
			w++
		}
	}
	switch {
	case r == 0:
		return strconv.Itoa(w) + " write"
	case w == 0:
		return strconv.Itoa(r) + " read"
	}
	return strconv.Itoa(w) + " write · " + strconv.Itoa(r) + " read"
}

templ accessRow(v View) {
	<p class="text-xs text-rw-faint" data-hint>What a tile that uses this slice gets unless it asks for other access.</p>
	if v.FileOwned || v.ReadOnly {
		<div data-field data-changed?={ v.DefaultAccess == "read" }>
			<p class="label">Default access</p>
			<p class="text-sm text-rw-text font-mono">{ access(v.DefaultAccess) }</p>
			if v.FileOwned {
				<p class="text-xs text-rw-faint" data-hint>Set in the stack file.</p>
			} else {
				<p class="text-xs text-rw-faint" data-hint>Only members and owners can change this.</p>
			}
		</div>
	} else {
		<form hx-post={ v.Base + "/default-access" } hx-target={ "#" + Root } hx-swap="outerHTML" class="space-y-3">
			@c.KeepOpen("access")
			<div data-field data-changed?={ v.DefaultAccess == "read" }>
				<label for="slice-default" class="label">
					Default access
					@c.FieldMarks(v.DefaultAccess == "read", "")
				</label>
				@accessSelect("slice-default", "access", v.DefaultAccess)
			</div>
			<button type="submit" class="btn btn-primary btn-sm">Save</button>
		</form>
	}
}

templ consumersRow(v View) {
	if v.ReadOnly {
		<p class="text-xs text-rw-faint" data-hint>Each consumer keeps its own access. Only members and owners can change it.</p>
	} else {
		<p class="text-xs text-rw-faint" data-hint>Each consumer keeps its own access until you change it here.</p>
	}
	<ul class="space-y-1.5">
		for _, cs := range v.Consumers {
			<li class="panel px-4 py-2.5 flex flex-wrap items-center gap-3 text-sm" data-field>
				<span class="flex-1 min-w-0">
					<label for={ "access-" + cs.Slug } class="settings-label">{ cmp.Or(cs.Name, cs.Slug) }</label>
				</span>
				if v.ReadOnly {
					<span class="font-mono text-rw-text">{ cs.Access }</span>
				} else {
					<form hx-post={ v.Base + "/access" } hx-target={ "#" + Root } hx-swap="outerHTML" class="flex items-center gap-2">
						@c.KeepOpen("consumers")
						<input type="hidden" name="consumer" value={ cs.Slug }/>
						@accessSelect("access-"+cs.Slug, "access", cs.Access)
						<button type="submit" class="btn btn-ghost btn-sm">Save</button>
					</form>
				}
			</li>
		}
	</ul>
}

// nameRow renames the slice tile; its consumers keep their binding.
templ nameRow(v View) {
	if v.ReadOnly {
		<div data-field>
			<p class="label">Name</p>
			<p class="text-sm text-rw-text">{ v.Name }</p>
			<p class="text-xs text-rw-faint" data-hint>Only members and owners can rename it.</p>
		</div>
	} else {
		<form novalidate hx-post={ v.Base + "/rename" } hx-target={ "#" + Root } hx-swap="outerHTML" class="space-y-4">
			@c.KeepOpen("general")
			@c.Field(c.FieldView{Name: "name", Label: "Name", Value: v.Name})
			<button type="submit" class="btn btn-primary btn-sm">Rename</button>
		</form>
	}
}

// branchRow copies the database as of now into a new slice tile. The dump
// runs against the live instance.
templ branchRow(v View) {
	<p class="text-xs text-rw-faint" data-hint>A copy of the data as of now, with its own login.</p>
	<form novalidate hx-post={ v.Base + "/branch" } hx-target={ "#" + Root } hx-swap="outerHTML" class="space-y-4">
		@c.KeepOpen("branch")
		@c.Field(c.FieldView{Name: "env", Label: "Env", Placeholder: "same env", Help: "An env of this stack, or stack:env."})
		@c.Field(c.FieldView{Name: "instance", Label: "Instance", Placeholder: "same instance", Help: "stack:env:tile of another postgres."})
		@c.Field(c.FieldView{Name: "expires", Label: "Expires", Placeholder: "never", Help: "For example 3d or 36h."})
		@c.Field(c.FieldView{Name: "at", Label: "As of (UTC)", Type: "datetime-local", Step: "1", Help: "A past time; empty is now. Needs point-in-time restore."})
		<button type="submit" class="btn btn-primary btn-sm">Branch</button>
	</form>
}

func bucketSummary(v View) string {
	s := "no versions"
	if v.VersionDays > 0 {
		s = "old versions " + strconv.Itoa(v.VersionDays) + " d"
	}
	if v.QuotaGB > 0 {
		s += " · " + strconv.Itoa(v.QuotaGB) + " GB cap"
	}
	return s
}

// bucketRow is versioning, the size cap and CORS, saved together.
templ bucketRow(v View) {
	<p class="text-xs text-rw-faint" data-hint>Old versions let you restore what an app overwrote or deleted.</p>
	if v.FileOwned || v.ReadOnly {
		@c.Facts() {
			@c.Fact("Old versions kept", fmt.Sprintf("%d days", v.VersionDays))
			@c.Fact("Size cap", fmt.Sprintf("%d GB", v.QuotaGB))
			@c.Fact("CORS origins", cmp.Or(v.CORS, "none"))
		}
		if v.FileOwned {
			<p class="text-xs text-rw-faint" data-hint>Set in the stack file.</p>
		} else {
			<p class="text-xs text-rw-faint" data-hint>Only members and owners can change this.</p>
		}
	} else {
		<form novalidate hx-post={ v.Base + "/bucket" } hx-target={ "#" + Root } hx-swap="outerHTML" class="space-y-4">
			@c.KeepOpen("bucket")
			@c.Field(c.FieldView{Name: "version_days", Label: "Keep old versions (days)", Type: "number", Min: "0", Value: strconv.Itoa(v.VersionDays), Help: "0 turns versioning off."})
			@c.Field(c.FieldView{Name: "quota_gb", Label: "Size cap (GB)", Type: "number", Min: "0", Value: strconv.Itoa(v.QuotaGB), Help: "0 means no cap."})
			@c.Field(c.FieldView{Name: "cors", Label: "CORS origins", Value: v.CORS, Placeholder: "https://app.example.com", Help: "Separate with commas."})
			<button type="submit" class="btn btn-primary btn-sm">Save</button>
		</form>
	}
}

// restoreRow copies the versions current at a time back as new versions.
templ restoreRow(v View) {
	<p class="text-xs text-rw-faint" data-hint>Copies each file back as it was then. Nothing is deleted.</p>
	<form novalidate hx-post={ v.Base + "/restore" } hx-target={ "#" + Root } hx-swap="outerHTML" class="space-y-4">
		@c.KeepOpen("restore")
		@c.Field(c.FieldView{Name: "at", Label: "As of (UTC)", Type: "datetime-local", Step: "1", Required: true, Help: "A past time."})
		@c.Field(c.FieldView{Name: "key", Label: "One file", Placeholder: "whole bucket", Help: "The exact key."})
		@c.Field(c.FieldView{Name: "prefix", Label: "Or a folder", Placeholder: "whole bucket", Help: "Keys that start with it."})
		<p class="text-xs text-rw-faint" data-hint>It runs file by file, so a stop partway leaves some restored.</p>
		<button type="submit" class="btn btn-primary btn-sm">Restore</button>
	</form>
}

// Usage is the bucket's size now, answering the Overview's lazy load.
templ Usage(current, old int64, errText string) {
	if errText != "" {
		<p class="text-sm text-rw-danger" role="alert">{ errText }</p>
	} else {
		@c.Facts() {
			@c.Fact("Current objects", SizeText(current))
			@c.Fact("Old versions", SizeText(old))
		}
	}
}

// SizeText is a byte count for people.
func SizeText(n int64) string {
	switch {
	case n >= 1<<30:
		return fmt.Sprintf("%.1f GB", float64(n)/(1<<30))
	case n >= 1<<20:
		return fmt.Sprintf("%.1f MB", float64(n)/(1<<20))
	case n >= 1<<10:
		return fmt.Sprintf("%.1f KB", float64(n)/(1<<10))
	}
	return fmt.Sprintf("%d B", n)
}

templ removeRow(v View) {
	<p class="text-xs text-rw-faint" data-hint>What removing this tile does to its database or bucket. An ephemeral env always drops.</p>
	if v.ReadOnly {
		<div data-field data-changed?={ v.OnRemove == "drop" }>
			<p class="label">On remove</p>
			<p class="text-sm text-rw-text font-mono">{ onRemoveWord(v.OnRemove) }</p>
			<p class="text-xs text-rw-faint" data-hint>Only members and owners can change this.</p>
		</div>
	} else {
		<form hx-post={ v.Base + "/on-remove" } hx-target={ "#" + Root } hx-swap="outerHTML" class="space-y-3">
			@c.KeepOpen("remove")
			<div data-field data-changed?={ v.OnRemove == "drop" }>
				<label for="slice-on-remove-select" class="label">
					On remove
					@c.FieldMarks(v.OnRemove == "drop", "")
				</label>
				<select id="slice-on-remove-select" name="on_remove" class="input w-auto">
					<option value="keep" selected?={ v.OnRemove != "drop" }>keep</option>
					<option value="drop" selected?={ v.OnRemove == "drop" }>drop</option>
				</select>
			</div>
			<button type="submit" class="btn btn-primary btn-sm">Save</button>
		</form>
	}
}

templ deleteRow(v View) {
	@c.DangerZone("Deleting this tile unbinds its consumers, then keeps or drops its data as On remove says.", v.Name, "") {
		@c.Confirm(c.ConfirmView{
			Button:  "Delete tile",
			Title:   "Delete " + v.Name + "?",
			Warning: "Its consumers lose their access; the data is " + onRemoveWord(v.OnRemove) + ".",
			Kept:    []string{kept(v.OnRemove)},
			Word:    v.Name,
			Action:  v.Base + "/delete",
			Target:  "#" + Root,
		})
	}
}

// accessSelect is a read | write select named name; unset is write.
templ accessSelect(id, name, cur string) {
	<select id={ id } name={ name } class="input w-auto">
		<option value="read" selected?={ cur == "read" }>read</option>
		<option value="write" selected?={ cur != "read" }>write</option>
	</select>
}

templ link(text, href string) {
	<a href={ templ.SafeURL(href) } class="font-mono text-rw-accentHi hover:underline">{ text }</a>
}

func consumerRows(v View) [][]templ.Component {
	rows := make([][]templ.Component, 0, len(v.Consumers))
	for _, cs := range v.Consumers {
		rows = append(rows, []templ.Component{
			link(cmp.Or(cs.Name, cs.Slug), cs.Link),
			c.Text(cs.Kind),
			c.Text(cs.Access),
			c.Text(cs.User),
			c.When(cs.Since),
		})
	}
	return rows
}

func yesNo(b bool) string {
	if b {
		return "yes"
	}
	return "no"
}

func kept(onRemove string) string {
	if onRemove == "drop" {
		return "backups already in a destination"
	}
	return "the database or bucket, orphaned for its instance to keep"
}

func onRemoveWord(w string) string {
	if w == "drop" {
		return "dropped"
	}
	return "kept"
}
