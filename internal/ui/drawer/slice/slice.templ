// Package slice is the slice drawer: Overview (the database, its bindings,
// a way to its instance, detach) and, when the instance runs in this env,
// the instance's logs (v0: a slice has no container of its own).
package slice

import c "github.com/FyrmForge/stackr/internal/ui/components"

// Root is the id every drawer answer replaces (outerHTML).
const Root = c.DrawerRoot

var labels = map[string]string{"bindings": "Overview"}

// Tabs are the tabs a slice has: logs only with its instance in view.
func Tabs(logs bool) []string {
	if logs {
		return []string{"bindings", "logs"}
	}
	return []string{"bindings"}
}

// Tab is the tab a request asks for; an unknown one opens Overview.
func Tab(tab string, logs bool) string {
	if tab == "logs" && logs {
		return tab
	}
	return "bindings"
}

// View is one provision. Outputs are the binding names the consumer gets,
// never their values.
type View struct {
	Node, Name, DB, User, OnRemove string
	Base                           string // the drawer URL
	Tab                            string
	Instance                       string // the instance tile's name
	InstanceNode, InstanceDrawer   string // "" = its instance is not in this env
	Logs                           bool
	Public, Consumer               bool
	Outputs                        []string
	Detach                         string // POST; "" = no consumer to detach
	Location, EnvColor             string
	Error, Note                    string
}

func Drawer(v View, body templ.Component) templ.Component {
	kind := "slice"
	if v.Instance != "" {
		kind = "slice of " + v.Instance
	}
	return c.Drawer(c.DrawerView{
		Node:     v.Node,
		Title:    v.Name,
		Kind:     kind,
		Base:     v.Base,
		Tabs:     Tabs(v.Logs),
		Labels:   labels,
		Tab:      v.Tab,
		Error:    v.Error,
		Note:     v.Note,
		Icon:     "slice",
		Scope:    visibility(v.Public),
		Location: v.Location,
		EnvColor: v.EnvColor,
	}, body)
}

func visibility(public bool) string {
	if public {
		return "public"
	}
	return "private"
}

templ Overview(v View) {
	<div id="tab-bindings">
		@c.Facts() {
			@c.Fact("Database", v.DB)
			@c.Fact("User", v.User)
			@c.Fact("Instance", v.Instance)
			@c.Fact("On remove", v.OnRemove)
		}
		if v.InstanceDrawer != "" {
			<a
				href={ templ.SafeURL("?drawer=" + v.InstanceNode + "&tab=slices") }
				hx-get={ v.InstanceDrawer }
				hx-target="#drawer-body"
				hx-push-url={ "?drawer=" + v.InstanceNode + "&tab=slices" }
				class="btn btn-ghost btn-sm mt-3"
			>Open { v.Instance }</a>
		}
		<h3 class="section-title">Bindings</h3>
		if len(v.Outputs) == 0 {
			<p class="text-sm text-rw-muted">None yet: the attach job has not run.</p>
		} else {
			<ul class="space-y-2">
				for _, o := range v.Outputs {
					<li class="panel px-4 py-3 text-sm font-mono text-rw-text">{ o }</li>
				}
			</ul>
			<p class="mt-2 text-xs text-rw-faint">The consumer gets these as variables; their values never reach this page.</p>
		}
		if v.Detach != "" {
			@c.DangerZone("Detaching redeploys the consumer without these bindings; then the slice is "+v.OnRemove+".", v.Name, "") {
				@c.Confirm(c.ConfirmView{
					Button:  "Detach",
					Title:   "Detach " + v.Name + "?",
					Warning: "The consumer redeploys without these bindings; then the slice is " + v.OnRemove + ".",
					Action:  v.Detach,
					Target:  "#" + Root,
				})
			}
		}
	</div>
}

templ Logs(v View, pane c.LogPaneView, running bool) {
	<div id="tab-logs">
		<p class="mb-3 text-xs text-rw-muted">These are { v.Instance }'s container logs. A provisioned database has no container of its own.</p>
		if running {
			@c.LogPane(pane)
		} else {
			<p class="text-rw-muted text-sm">No container is running yet.</p>
		}
	</div>
}
