// Package slice is the slice tile drawer: Overview (what it is cut from,
// or why it resolves nowhere, its consumers and its database or bucket)
// and Settings (default access, each consumer's access, what removing it
// does, and the delete) as accordion rows with their own Save. A slice
// has no container, so no logs of its own (its instance's drawer has them).
package slice

import (
	"cmp"
	"slices"
	"strconv"
	"time"

	c "github.com/FyrmForge/stackr/internal/ui/components"
)

// Root is the id every drawer answer replaces (outerHTML).
const Root = c.DrawerRoot

// Tabs in order; the canvas opens the first.
var Tabs = []string{"overview", "settings"}

// Tab is the tab a request asks for; an unknown one opens Overview.
func Tab(tab string) string {
	if !slices.Contains(Tabs, tab) {
		return Tabs[0]
	}
	return tab
}

// View is one slice tile.
type View struct {
	Node, Name         string
	Base               string // the drawer URL: tabs add ?tab=, actions add /<verb>
	Tab                string
	Open               string // the Settings row open on load: the saved one, or ?open=
	Status             string // a TileBadge word
	Location, EnvColor string
	Error, Note        string
	ReadOnly           bool // the viewer may not write: no forms, no delete

	ProvisionFrom string // as written
	Target        string // "stack/env/tile" it resolves to; "" = Blocker says why
	TargetLink    string // that env's canvas with the instance's drawer open
	Blocker       string
	DefaultAccess string // "" = unset, which grants write
	FileOwned     bool   // config-managed: default access is the stack file's
	OnRemove      string
	Consumers     []Consumer
	Provisioned   bool
	DBName        string // the database or bucket, once provisioned
}

// Consumer is one tile holding a cred on the slice.
type Consumer struct {
	Slug, Link, Kind, Access, User string
	Since                          time.Time
}

func Drawer(v View, body templ.Component) templ.Component {
	return c.Drawer(c.DrawerView{
		Node:     v.Node,
		Title:    v.Name,
		Kind:     "slice",
		Base:     v.Base,
		Tabs:     Tabs,
		Tab:      Tab(v.Tab),
		Error:    v.Error,
		Note:     v.Note,
		Icon:     "slice",
		Status:   v.Status,
		Location: v.Location,
		EnvColor: v.EnvColor,
	}, body)
}

templ Overview(v View) {
	<div id="tab-overview">
		@c.PanelSection("slice-target", "Target", "") {
			if v.Target != "" {
				<a href={ templ.SafeURL(v.TargetLink) } class="font-mono text-sm text-rw-accentHi hover:underline">{ v.Target }</a>
			} else {
				<p class="text-sm text-rw-danger" role="alert">{ v.Blocker }</p>
				<p class="text-xs text-rw-faint font-mono">{ "Written as " + v.ProvisionFrom }</p>
			}
		}
		@c.PanelSection("slice-consumers", "Consumers", "") {
			@c.Table(c.TableView{
				Headers:   []string{"Consumer", "Kind", "Access", "User", "Since"},
				Rows:      consumerRows(v),
				EmptyText: "No tile uses it yet. A consumer gets access at its next deploy.",
			})
		}
		@c.PanelSection("slice-status", "Status", "") {
			@c.Facts() {
				@c.Fact("Provisioned", yesNo(v.Provisioned))
				@c.Fact("Name", v.DBName)
			}
		}
	</div>
}

// Settings is one accordion row per thing the slice sets, each with its
// own Save.
templ Settings(v View) {
	<div id="tab-settings">
		@c.SettingsAccordion(c.SettingsAcc{ID: "slice-settings", Rows: settingsRows(v), Open: v.Open})
	</div>
}

func settingsRows(v View) []c.AccRow {
	rows := []c.AccRow{
		{Key: "access", Title: "Default access", Summary: access(v.DefaultAccess), Changed: v.DefaultAccess == "read", Body: accessRow(v)},
	}
	if len(v.Consumers) > 0 {
		rows = append(rows, c.AccRow{Key: "consumers", Title: "Consumer access", Summary: ConsumersSummary(v.Consumers), Body: consumersRow(v)})
	}
	rows = append(rows, c.AccRow{Key: "remove", Title: "On remove", Summary: onRemoveWord(v.OnRemove), Changed: v.OnRemove == "drop", Body: removeRow(v)})
	if !v.ReadOnly {
		rows = append(rows, c.AccRow{Key: "delete", Title: "Delete", Body: deleteRow(v)})
	}
	return rows
}

// access is the default access in force: unset grants write.
func access(a string) string { return cmp.Or(a, "write") }

// ConsumersSummary counts the consumers by their access: "2 write · 1 read".
func ConsumersSummary(cs []Consumer) string {
	w, r := 0, 0
	for _, x := range cs {
		if x.Access == "read" {
			r++
		} else {
			w++
		}
	}
	switch {
	case r == 0:
		return strconv.Itoa(w) + " write"
	case w == 0:
		return strconv.Itoa(r) + " read"
	}
	return strconv.Itoa(w) + " write · " + strconv.Itoa(r) + " read"
}

templ accessRow(v View) {
	<p class="text-xs text-rw-faint" data-hint>What a tile that uses this slice gets unless it asks for other access.</p>
	if v.FileOwned || v.ReadOnly {
		<div data-field data-changed?={ v.DefaultAccess == "read" }>
			<p class="label">Default access</p>
			<p class="text-sm text-rw-text font-mono">{ access(v.DefaultAccess) }</p>
			if v.FileOwned {
				<p class="text-xs text-rw-faint">Set in the stack file.</p>
			} else {
				<p class="text-xs text-rw-faint">Only members and owners can change this.</p>
			}
		</div>
	} else {
		<form hx-post={ v.Base + "/default-access" } hx-target={ "#" + Root } hx-swap="outerHTML" class="space-y-3">
			@c.KeepOpen("access")
			<div data-field data-changed?={ v.DefaultAccess == "read" }>
				<label for="slice-default" class="label">
					Default access
					@c.FieldMarks(v.DefaultAccess == "read", "")
				</label>
				@accessSelect("slice-default", "access", v.DefaultAccess)
			</div>
			<button type="submit" class="btn btn-primary btn-sm">Save</button>
		</form>
	}
}

templ consumersRow(v View) {
	<p class="text-xs text-rw-faint" data-hint>Each consumer keeps its own access until you change it here.</p>
	<ul class="space-y-1.5">
		for _, cs := range v.Consumers {
			<li class="panel px-4 py-2.5 flex flex-wrap items-center gap-3 text-sm" data-field>
				<span class="flex-1 min-w-0">
					<label for={ "access-" + cs.Slug } class="settings-label font-mono">{ cs.Slug }</label>
				</span>
				if v.ReadOnly {
					<span class="font-mono text-rw-text">{ cs.Access }</span>
				} else {
					<form hx-post={ v.Base + "/access" } hx-target={ "#" + Root } hx-swap="outerHTML" class="flex items-center gap-2">
						@c.KeepOpen("consumers")
						<input type="hidden" name="consumer" value={ cs.Slug }/>
						@accessSelect("access-"+cs.Slug, "access", cs.Access)
						<button type="submit" class="btn btn-ghost btn-sm">Save</button>
					</form>
				}
			</li>
		}
	</ul>
}

templ removeRow(v View) {
	<p class="text-xs text-rw-faint" data-hint>What removing this tile does to its database or bucket. An ephemeral env always drops.</p>
	if v.ReadOnly {
		<div data-field data-changed?={ v.OnRemove == "drop" }>
			<p class="label">On remove</p>
			<p class="text-sm text-rw-text font-mono">{ onRemoveWord(v.OnRemove) }</p>
			<p class="text-xs text-rw-faint">Only members and owners can change this.</p>
		</div>
	} else {
		<form hx-post={ v.Base + "/on-remove" } hx-target={ "#" + Root } hx-swap="outerHTML" class="space-y-3">
			@c.KeepOpen("remove")
			<div data-field data-changed?={ v.OnRemove == "drop" }>
				<label for="slice-on-remove-select" class="label">
					On remove
					@c.FieldMarks(v.OnRemove == "drop", "")
				</label>
				<select id="slice-on-remove-select" name="on_remove" class="input w-auto">
					<option value="keep" selected?={ v.OnRemove != "drop" }>keep</option>
					<option value="drop" selected?={ v.OnRemove == "drop" }>drop</option>
				</select>
			</div>
			<button type="submit" class="btn btn-primary btn-sm">Save</button>
		</form>
	}
}

templ deleteRow(v View) {
	@c.DangerZone("Deleting this tile unbinds its consumers, then keeps or drops its data as On remove says.", v.Name, "") {
		@c.Confirm(c.ConfirmView{
			Button:  "Delete tile",
			Title:   "Delete " + v.Name + "?",
			Warning: "Its consumers lose their access; the data is " + onRemoveWord(v.OnRemove) + ".",
			Kept:    []string{kept(v.OnRemove)},
			Word:    v.Name,
			Action:  v.Base + "/delete",
			Target:  "#" + Root,
		})
	}
}

// accessSelect is a read | write select named name; unset is write.
templ accessSelect(id, name, cur string) {
	<select id={ id } name={ name } class="input w-auto">
		<option value="read" selected?={ cur == "read" }>read</option>
		<option value="write" selected?={ cur != "read" }>write</option>
	</select>
}

templ link(text, href string) {
	<a href={ templ.SafeURL(href) } class="font-mono text-rw-accentHi hover:underline">{ text }</a>
}

func consumerRows(v View) [][]templ.Component {
	rows := make([][]templ.Component, 0, len(v.Consumers))
	for _, cs := range v.Consumers {
		rows = append(rows, []templ.Component{
			link(cs.Slug, cs.Link),
			c.Text(cs.Kind),
			c.Text(cs.Access),
			c.Text(cs.User),
			c.When(cs.Since),
		})
	}
	return rows
}

func yesNo(b bool) string {
	if b {
		return "yes"
	}
	return "no"
}

func kept(onRemove string) string {
	if onRemove == "drop" {
		return "backups already in a destination"
	}
	return "the database or bucket, orphaned for its instance to keep"
}

func onRemoveWord(w string) string {
	if w == "drop" {
		return "dropped"
	}
	return "kept"
}
