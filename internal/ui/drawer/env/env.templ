// Package env is the env card's drawer tabs (stack canvas): settings
// (name, where releases come from, colour, delete), releases (dry run,
// promote, roll back), order and logs.
// Params is the vars editor, composed by the handler.
package env

import c "github.com/FyrmForge/stackr/internal/ui/components"

var Tabs = []string{"settings", "releases", "params", "order", "logs"}

type SettingsView struct {
	Base   string // POST /rename, /from, /color; "" = read-only
	Name   string
	From   string // branch | promote
	Branch string
	Auto   bool
	Color  string
	Delete c.ConfirmView
}

// OrderView is the ladder, bottom rung first; each move posts the whole
// new order.
type OrderView struct {
	Action string // POST ids...; "" = read-only
	Rungs  []Rung
}

type Rung struct {
	ID, Name, Color string
	Up, Down        []string // the order after moving this rung; nil = at the end
}

// ReleasesView is the stack's releases as this env sees them: which one
// it runs, a dry run of taking another, and the job a promote queued.
type ReleasesView struct {
	Rows []ReleaseRow
	Plan *c.PlanView
	Take c.ConfirmView // the plan's deploy; Action "" = blocked or read-only
	Job  *c.JobStatusView
}

type ReleaseRow struct {
	Number, By, Created string
	Current             bool
	DryRun              string // GET the tab with this plan
}

func target() string { return "#" + c.DrawerRoot }

templ Settings(v SettingsView) {
	<div class="space-y-6" id="tab-settings">
		<fieldset disabled?={ v.Base == "" } class="space-y-6">
			<form hx-post={ v.Base + "/rename" } hx-target={ target() } hx-swap="outerHTML" class="space-y-3">
				@c.Field(c.FieldView{Name: "name", Label: "Name", Value: v.Name, Required: true})
				@c.Submit("Rename")
			</form>
			<form hx-post={ v.Base + "/from" } hx-target={ target() } hx-swap="outerHTML" class="space-y-3">
				<h3 class="font-semibold">Releases come from</h3>
				<label class="flex items-center gap-2 text-sm"><input type="radio" name="from" value="branch" checked?={ v.From != "promote" }/> a branch</label>
				<label class="flex items-center gap-2 text-sm"><input type="radio" name="from" value="promote" checked?={ v.From == "promote" }/> promotion from the rung below</label>
				@c.Field(c.FieldView{Name: "branch", Label: "Branch", Value: v.Branch, Placeholder: "main"})
				<label class="flex items-center gap-2 text-sm"><input type="checkbox" name="auto" value="1" checked?={ v.Auto }/> deploy every push</label>
				@c.Submit("Save")
			</form>
			<form hx-post={ v.Base + "/color" } hx-trigger="change" hx-target={ target() } hx-swap="outerHTML">
				<fieldset class="flex flex-wrap gap-3 text-sm">
					<legend class="label">Colour</legend>
					for _, col := range c.EnvColors {
						<label class="flex items-center gap-1"><input type="radio" name="color" value={ col } checked?={ col == v.Color }/> @c.EnvBadge(col, col)</label>
					}
				</fieldset>
			</form>
		</fieldset>
		if v.Base != "" {
			<section class="space-y-2">
				<h3 class="font-semibold">Delete</h3>
				<p class="text-sm text-slate-500">Refused while the env has tiles.</p>
				@c.Confirm(v.Delete)
			</section>
		}
	</div>
}

templ Order(v OrderView) {
	<ol class="space-y-2 text-sm" id="tab-order">
		for _, r := range v.Rungs {
			<li class="flex items-center gap-2">
				<span class="flex-1">@c.EnvBadge(r.Name, r.Color)</span>
				if v.Action != "" {
					@move("Up", v.Action, r.Up)
					@move("Down", v.Action, r.Down)
				}
			</li>
		}
	</ol>
}

templ move(label, action string, ids []string) {
	if ids != nil {
		<form hx-post={ action } hx-target={ target() } hx-swap="outerHTML">
			for _, id := range ids {
				<input type="hidden" name="ids" value={ id }/>
			}
			<button type="submit" class="btn">{ label }</button>
		</form>
	}
}

// ponytail: no env-wide log verb yet; each tile's drawer has its logs.
templ Logs() {
	<p class="text-sm text-slate-500" id="tab-logs">Logs are per tile: open a tile on this env's canvas.</p>
}

templ Releases(v ReleasesView) {
	<div class="space-y-4" id="tab-releases">
		if v.Job != nil {
			@c.JobStatus(*v.Job)
		}
		if v.Plan != nil {
			@c.Plan(*v.Plan)
			if v.Take.Action != "" {
				@c.Confirm(v.Take)
			}
		}
		if len(v.Rows) == 0 {
			<p class="text-sm text-slate-500">No releases yet: the first deploy makes one.</p>
		}
		<ul class="divide-y divide-slate-200 text-sm dark:divide-slate-800">
			for _, r := range v.Rows {
				<li class="flex items-center gap-3 py-2">
					<span class="font-mono">#{ r.Number }</span>
					<span class="flex-1">{ r.By } <span class="text-slate-500">{ r.Created }</span></span>
					if r.Current {
						@c.Pill("current", "ok")
					} else {
						<button type="button" class="btn" hx-get={ r.DryRun } hx-target={ target() } hx-swap="outerHTML">Dry run</button>
					}
				</li>
			}
		</ul>
	</div>
}
