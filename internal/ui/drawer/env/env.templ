// Package env is the env card's drawer tabs (stack canvas): settings
// (name, resource overrides, where releases come from, colour, delete),
// sync, order and logs, drawn as v0's environment settings page. Releases
// and params are shared views, composed by the handler.
package env

import (
	"strconv"

	c "github.com/FyrmForge/stackr/internal/ui/components"
)

var Tabs = []string{"settings", "releases", "sync", "params", "order", "logs"}

type SettingsView struct {
	Base    string // POST /rename, /from, /color; "" = read-only
	Name    string
	Tiles   int
	Canvas  string // the env page
	Path    string // "smoke / shop / dev"
	From    string // branch | promote
	Branch  string
	Auto    bool
	Color   string
	Cascade c.SettingsFormView
	Delete  c.ConfirmView
	Lock    LockView
}

// LockView is the env's lock. Show false = a PR env, which has none. Tiered:
// the lock is the org tier's, so the box is checked and fixed. Base is the
// POST; "" = the viewer cannot change it.
type LockView struct {
	Show   bool
	Tiered bool
	Locked bool
	Base   string
	Name   string
}

// OrderView is the ladder, bottom rung first; each move posts the whole
// new order.
type OrderView struct {
	Action string // POST ids...; "" = read-only
	Rungs  []Rung
}

type Rung struct {
	ID, Name, Color string
	Up, Down        []string // the order after moving this rung; nil = at the end
}

// SyncView is the sync tab: the review of making this env match another.
type SyncView struct {
	Pick       string // the env page with this drawer open; the picker GETs it with sync=<slug>, which moves the canvas too
	Sources    []SyncSource
	From       string
	CanvasHref string // the env page with this review drawn on it
	Why        string // set: the env cannot sync, and this says why
	Blockers   []string
	Warnings   []string
	Tiles      []SyncTileView
	Other      []c.ChangeView // params and volumes, which belong to no tile
	Deploy     *c.ConfirmView // nil = the viewer cannot, or the plan is blocked or empty
	Job        *c.JobStatusView
}

type SyncSource struct {
	Slug, Name string
	Selected   bool
}

// SyncTileView is one tagged tile. Drop and Undo are the env page with the
// review that results: its canvas re-tags and the count moves.
type SyncTileView struct {
	Slug, Kind, Tag string // tag: new | edited | removed
	Dropped         bool
	Changes         []c.ChangeView
	Drop, Undo      string
}

func target() string { return "#" + c.DrawerRoot }

func tiles(n int) string {
	if n == 1 {
		return "1 tile"
	}
	return strconv.Itoa(n) + " tiles"
}

templ Settings(v SettingsView) {
	<div id="tab-settings">
		<p class="text-sm text-rw-muted mb-6">
			{ tiles(v.Tiles) } · <a href={ templ.SafeURL(v.Canvas) } class="link">open the canvas</a>
		</p>
		@c.Section("Environment", "environment", "") {
			<form hx-post={ v.Base + "/rename" } hx-target={ target() } hx-swap="outerHTML" class="space-y-4">
				@c.Field(c.FieldView{Name: "name", Label: "Name", Value: v.Name, Required: true, Disabled: v.Base == "", Why: "Renaming needs write access to this environment."})
				if v.Base != "" {
					<button type="submit" class="btn btn-primary btn-sm">Rename</button>
				}
			</form>
		}
		if v.Lock.Show {
			@c.Section("Lock", "environment", "Whether other envs can read this env's values.") {
				if v.Lock.Tiered {
					<label class="flex items-center gap-2 text-sm text-rw-text"><input type="checkbox" checked?={ v.Lock.Locked } disabled class="accent-rw-accent"/> Locked</label>
					<p class="mt-2 text-xs text-rw-faint">{ v.Lock.Name }'s lock is the org's tier lock. Change it in the org's tiers.</p>
				} else {
					<form novalidate hx-post={ v.Lock.Base } hx-target={ target() } hx-swap="outerHTML" class="space-y-4">
						<label class="flex items-center gap-2 text-sm text-rw-text"><input type="checkbox" name="locked" value="1" checked?={ v.Lock.Locked } aria-label={ "Lock " + v.Lock.Name } disabled?={ v.Lock.Base == "" } class="accent-rw-accent"/> Locked</label>
						<p class="text-xs text-rw-faint">Other envs can't read this env's values with [env] refs while locked.</p>
						if v.Lock.Base != "" {
							<button type="submit" class="btn btn-primary btn-sm">Save</button>
						}
					</form>
				}
			}
		}
		@c.Section("Resource overrides", "environment", "Applied to every service in this environment that does not set its own. Leave a field empty to inherit from the level above.") {
			@c.SettingsForm(v.Cascade)
		}
		@c.Section("Releases", "environment", "Where this environment's releases come from, and whether a push deploys by itself.") {
			<form hx-post={ v.Base + "/from" } hx-target={ target() } hx-swap="outerHTML">
				<fieldset disabled?={ v.Base == "" } class="space-y-4">
					<legend class="sr-only">Releases come from</legend>
					<div class="space-y-2">
						<label class="flex items-center gap-2 text-sm text-rw-text"><input type="radio" name="from" value="branch" checked?={ v.From != "promote" } class="accent-rw-accent"/> A branch</label>
						<label class="flex items-center gap-2 text-sm text-rw-text"><input type="radio" name="from" value="promote" checked?={ v.From == "promote" } class="accent-rw-accent"/> Promotion from the rung below</label>
					</div>
					@c.Field(c.FieldView{Name: "branch", Label: "Branch", Value: v.Branch, Placeholder: "main", Help: "The branch a push builds from, when releases come from a branch."})
					<label class="flex items-center gap-2 text-sm text-rw-text"><input type="checkbox" name="auto" value="1" checked?={ v.Auto } class="accent-rw-accent"/> Deploy every push</label>
					if v.Base != "" {
						<button type="submit" class="btn btn-primary btn-sm">Save</button>
					}
				</fieldset>
			</form>
		}
		@c.Section("Colour", "environment", "How this environment is drawn on the canvases, plan rows and tile pages.") {
			<form hx-post={ v.Base + "/color" } hx-target={ target() } hx-swap="outerHTML">
				<fieldset disabled?={ v.Base == "" } class="panel px-4 py-3 flex flex-wrap items-center gap-3">
					<legend class="sr-only">Colour</legend>
					<span class="text-sm text-rw-text w-28 truncate">{ v.Name }</span>
					<div class="flex flex-wrap items-center gap-2">
						for _, col := range c.EnvColors {
							@c.EnvSwatch(col, col == v.Color)
						}
					</div>
					if v.Base != "" {
						<button type="submit" class="btn btn-ghost btn-sm ml-auto">Save</button>
					}
				</fieldset>
			</form>
		}
		if v.Base != "" {
			@c.DangerSection("Deleting this environment removes it and its params. It is refused while it still has tiles.", v.Path, "The stack's releases are kept.") {
				@c.Confirm(v.Delete)
			}
		}
	</div>
}

templ Order(v OrderView) {
	<div id="tab-order">
		<p class="text-sm text-rw-muted mb-4">The ladder, bottom rung first: releases climb it by promotion.</p>
		<ol class="space-y-2">
			for _, r := range v.Rungs {
				<li class="panel px-4 py-3 flex items-center gap-2 text-sm">
					<span class="flex-1">
						@c.EnvBadge(r.Name, r.Color)
					</span>
					if v.Action != "" {
						@move("Up", v.Action, r.Up)
						@move("Down", v.Action, r.Down)
					}
				</li>
			}
		</ol>
	</div>
}

templ move(label, action string, ids []string) {
	if ids != nil {
		<form hx-post={ action } hx-target={ target() } hx-swap="outerHTML">
			for _, id := range ids {
				<input type="hidden" name="ids" value={ id }/>
			}
			<button type="submit" class="btn btn-ghost btn-sm">{ label }</button>
		</form>
	}
}

// ponytail: no env-wide log verb yet; each tile's drawer has its logs.
templ Logs() {
	<p class="panel px-4 py-3 text-sm text-rw-faint" id="tab-logs">Logs are per tile: open a tile on this environment's canvas.</p>
}

// Sync is the review: the source picker, what blocks or needs a look, one
// block per tagged tile with its changes and a Drop, the params and volumes
// that go with them, and Deploy. Once queued, the job takes its place.
templ Sync(v SyncView) {
	<div id="tab-sync" class="space-y-4">
		if v.Why != "" {
			<p class="panel px-4 py-3 text-sm text-rw-faint">{ v.Why }</p>
		} else if v.Job != nil {
			@c.JobStatus(*v.Job)
		} else {
			<div class="flex flex-wrap items-center gap-3">
				<label for="sync-from" class="text-sm text-rw-muted">Sync from</label>
				<select id="sync-from" name="sync" class="input w-auto" hx-get={ v.Pick } hx-target="#main" hx-push-url="true">
					for _, s := range v.Sources {
						<option value={ s.Slug } selected?={ s.Selected }>{ s.Name }</option>
					}
				</select>
				<a href={ templ.SafeURL(v.CanvasHref) } hx-get={ v.CanvasHref } hx-target="#main" hx-push-url="true" class="link text-sm ml-auto">Show on canvas</a>
			</div>
			if len(v.Blockers) > 0 {
				<div class="banner banner-danger" role="alert">
					<p class="font-medium">Blocked:</p>
					<ul class="list-disc pl-5">
						for _, b := range v.Blockers {
							<li>{ b }</li>
						}
					</ul>
				</div>
			}
			if len(v.Warnings) > 0 {
				<div class="banner border-rw-warn/40 bg-rw-warn/10 text-rw-warn">
					<ul class="list-disc pl-5">
						for _, w := range v.Warnings {
							<li>{ w }</li>
						}
					</ul>
				</div>
			}
			if len(v.Tiles) == 0 {
				<p class="text-sm text-rw-faint">Nothing to sync.</p>
			}
			<ul class="space-y-3">
				for _, t := range v.Tiles {
					<li class={ "panel px-4 py-3 space-y-2", templ.KV("opacity-60", t.Dropped) }>
						<div class="flex flex-wrap items-center gap-2 text-sm">
							<span class="font-mono text-rw-text">{ t.Slug }</span>
							<span class="rounded-md border border-rw-border bg-rw-inset px-1.5 py-0.5 text-[10px] text-rw-muted">{ t.Kind }</span>
							<span class={ "rounded-md border px-1.5 py-0.5 text-[10px]", tagClass(t.Tag) }>{ t.Tag }</span>
							<span class="ml-auto text-xs">
								if t.Dropped {
									<span class="text-rw-faint">dropped · </span>
									<a href={ templ.SafeURL(t.Undo) } hx-get={ t.Undo } hx-target="#main" hx-push-url="true" class="link">Undo</a>
								} else {
									<a href={ templ.SafeURL(t.Drop) } hx-get={ t.Drop } hx-target="#main" hx-push-url="true" class="link">Drop</a>
								}
							</span>
						</div>
						@changes(t.Changes, false)
					</li>
				}
			</ul>
			if len(v.Other) > 0 {
				<h3 class="section-title">Params and volumes</h3>
				@changes(v.Other, true)
			}
			if v.Deploy != nil {
				@c.Confirm(*v.Deploy)
			}
		}
	</div>
}

// changes are a tile's rows, old and new side by side (the plan's look).
templ changes(cs []c.ChangeView, named bool) {
	<ul class="space-y-1.5 text-sm">
		for _, ch := range cs {
			<li>
				<div class="flex flex-wrap items-center gap-2 font-mono">
					<span class={ signClass(ch.Kind) } aria-hidden="true">{ sign(ch.Kind) }</span>
					<span class="text-rw-faint">{ ch.Kind }</span>
					if named && ch.Tile != "" {
						<span class="text-rw-text">{ ch.Tile }</span>
					}
					if ch.Field != "" {
						<span class="text-rw-muted">{ ch.Field }</span>
					}
					if ch.Old != "" || ch.New != "" {
						<span class="text-rw-faint ml-auto truncate max-w-[50%]">
							if ch.Old != "" {
								<span class="text-rw-danger line-through">{ ch.Old }</span>
							}
							if ch.Old != "" && ch.New != "" {
								<span class="mx-1">→</span>
							}
							if ch.New != "" {
								<span class="text-rw-success">{ ch.New }</span>
							}
						</span>
					}
				</div>
				if ch.Note != "" {
					<p class="mt-0.5 pl-6 text-xs text-rw-muted">{ ch.Note }</p>
				}
			</li>
		}
	</ul>
}

func sign(kind string) string {
	switch kind {
	case "create":
		return "+"
	case "delete", "orphan", "detach":
		return "-"
	}
	return "~"
}

// signClass and tagClass spell every class in full so tailwind keeps them.
func signClass(kind string) string {
	switch sign(kind) {
	case "+":
		return "text-rw-success shrink-0 w-4"
	case "-":
		return "text-rw-danger shrink-0 w-4"
	}
	return "text-rw-warn shrink-0 w-4"
}

func tagClass(tag string) string {
	switch tag {
	case "new":
		return "border-rw-success/40 bg-rw-success/10 text-rw-success"
	case "removed":
		return "border-rw-danger/40 bg-rw-danger/10 text-rw-danger"
	}
	return "border-rw-warn/40 bg-rw-warn/10 text-rw-warn"
}
