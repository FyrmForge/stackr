// Package env is the env card's drawer tabs (stack canvas): settings as
// accordion rows (general, deploys, resources, variables, placement,
// delete), releases, sync and logs. Releases, variables and placement are
// shared views, composed by the handler.
package env

import (
	"strconv"

	c "github.com/FyrmForge/stackr/internal/ui/components"
)

// Tabs as the stack drawer's: releases first, the tab a drawer opened
// without one (an env card) shows; the top bar's Settings asks for settings.
var Tabs = []string{"releases", "sync", "logs", "settings"}

type SettingsView struct {
	Base      string // POST /rename, /from, /color; "" = read-only
	Name      string
	Tiles     int
	Canvas    string // the env page
	Path      string // "smoke / shop / dev"
	From      string // branch | promote
	Branch    string
	Auto      bool
	Below     string // the rung below's name; "" = the bottom rung
	Color     string
	Cascade   c.SettingsFormView
	Vars      templ.Component // the variables editor
	Placement templ.Component // the placement tab, loaded on its own
	Delete    c.ConfirmView
	Lock      LockView
	Open      string // the row open on load (?open=)
	Refresh   string // this tab's GET: the row heads redraw from it after a row saves alone
	Sums      Sums
}

// Sums are the closed rows' one-line summaries, built by the funcs in
// summary.go.
type Sums struct {
	General, Deploys, Resources, Variables, Placement string
	ResourcesChanged                                  bool // a resource is set on this env
	VariablesChanged                                  bool // a variable is set on this env
	PlacementChanged                                  bool // the env picks its own ingress or exits
}

// DNSBannerView is hosts that still resolve away from their ingress node.
// Hand wants a record set; Held are managed hosts the user left alone.
type DNSBannerView struct {
	URL  string
	Hand []DNSRow
	Held []DNSRow
}

func (v DNSBannerView) Empty() bool { return len(v.Hand)+len(v.Held) == 0 }

type DNSRow struct {
	Host    string
	Records string   // "A 203.0.113.4, AAAA ..."
	Points  string   // where it resolves now
}

// LockView is the env's lock. Show false = a PR env, which has none. Tiered:
// the lock is the org tier's, so the box is checked and fixed. Base is the
// POST; "" = the viewer cannot change it.
type LockView struct {
	Show   bool
	Tiered bool
	Locked bool
	Base   string
	Name   string
	Tiers  string // the org drawer, where a tier's lock is changed
}

// SyncView is the sync tab: the review of making this env match another.
type SyncView struct {
	Pick       string // the env page with this drawer open; the picker GETs it with sync=<slug>, which moves the canvas too
	Sources    []SyncSource
	From       string
	CanvasHref string // the env page with this review drawn on it
	Why        string // set: the env cannot sync, and this says why
	Blockers   []string
	Warnings   []string
	Tiles      []SyncTileView
	Other      []c.ChangeView // params and volumes, which belong to no tile
	Deploy     *c.ConfirmView // nil = the viewer cannot, or the plan is blocked or empty
	Job        *c.JobStatusView
}

type SyncSource struct {
	Slug, Name string
	Selected   bool
}

// SyncTileView is one tagged tile. Drop and Undo are the env page with the
// review that results: its canvas re-tags and the count moves.
type SyncTileView struct {
	Slug, Kind, Tag string // tag: new | edited | removed
	Dropped         bool
	Changes         []c.ChangeView
	Drop, Undo      string
}

func target() string { return "#" + c.DrawerRoot }

func tiles(n int) string {
	if n == 1 {
		return "1 tile"
	}
	return strconv.Itoa(n) + " tiles"
}

templ Settings(v SettingsView) {
	<div id="tab-settings">
		<p class="text-sm text-rw-muted mb-6">
			{ tiles(v.Tiles) } · <a href={ templ.SafeURL(v.Canvas) } class="link">open the canvas</a>
		</p>
		@c.SettingsAccordion(c.SettingsAcc{ID: "env-settings", Open: v.Open, Rows: rows(v), Refresh: v.Refresh})
	</div>
}

// rows are the Settings tab's accordion rows; Delete only for a writer.
func rows(v SettingsView) []c.AccRow {
	rs := []c.AccRow{
		{Key: "general", Title: "General", Summary: v.Sums.General, Body: general(v)},
		{Key: "deploys", Title: "Deploys", Summary: v.Sums.Deploys, Body: deploys(v)},
		{Key: "resources", Title: "Resources", Summary: v.Sums.Resources, Changed: v.Sums.ResourcesChanged, Body: resources(v.Cascade)},
		{Key: "variables", Title: "Variables", Summary: v.Sums.Variables, Changed: v.Sums.VariablesChanged, Body: v.Vars},
		{Key: "placement", Title: "Placement", Summary: v.Sums.Placement, Changed: v.Sums.PlacementChanged, Body: v.Placement},
	}
	if v.Base != "" {
		rs = append(rs, c.AccRow{Key: "delete", Title: "Delete", Body: remove(v)})
	}
	return rs
}

// keepOpen names the row a form saves: the answer redraws the whole drawer
// with that row open again.
templ keepOpen(key string) {
	<input type="hidden" name="open" value={ key }/>
}

templ general(v SettingsView) {
	<form if v.Base != "" { hx-post={ v.Base + "/rename" } } hx-target={ target() } hx-swap="outerHTML" class="space-y-4">
		@keepOpen("general")
		@c.Field(c.FieldView{Name: "name", Label: "Name", Value: v.Name, Required: true, Disabled: v.Base == "", Why: "Only members and owners can rename it."})
		if v.Base != "" {
			<button type="submit" class="btn btn-primary btn-sm">Rename</button>
		}
	</form>
	<form if v.Base != "" { hx-post={ v.Base + "/color" } } hx-target={ target() } hx-swap="outerHTML">
		@keepOpen("general")
		<fieldset disabled?={ v.Base == "" } class="space-y-2" data-field>
			<legend class="label">Colour</legend>
			<div class="flex flex-wrap items-center gap-2">
				for _, col := range c.EnvColors {
					@c.EnvSwatch(col, col == v.Color)
				}
				<label class="ml-1 inline-flex items-center gap-1.5 text-xs text-rw-muted cursor-pointer"><input type="radio" name="color" value="" checked?={ v.Color == "" } class="accent-rw-accent"/> None</label>
			</div>
			if v.Base != "" {
				<button type="submit" class="btn btn-primary btn-sm">Save</button>
			}
		</fieldset>
	</form>
	if v.Lock.Show {
		if v.Lock.Tiered {
			<div class="rounded-lg bg-rw-inset px-3 py-2 text-sm text-rw-muted" data-field>
				<span class="label">Lock</span>
				<p>{ tierLine(v.Lock) } <a href={ templ.SafeURL(v.Lock.Tiers) } class="link">Change in org tiers</a></p>
			</div>
		} else {
			<form novalidate if v.Lock.Base != "" { hx-post={ v.Lock.Base } } hx-target={ target() } hx-swap="outerHTML" class="space-y-2" data-field>
				@keepOpen("general")
				<label class="flex items-center gap-2 text-sm text-rw-text"><input type="checkbox" name="locked" value="1" checked?={ v.Lock.Locked } aria-label={ "Lock " + v.Lock.Name } disabled?={ v.Lock.Base == "" } class="accent-rw-accent"/> Locked</label>
				<p class="text-xs text-rw-faint">Other envs can't read this env's values while it is locked.</p>
				if v.Lock.Base != "" {
					<button type="submit" class="btn btn-primary btn-sm">Save</button>
				}
			</form>
		}
	}
}

// deploys is where releases come from. The bottom rung has nothing below it
// to promote from, so it offers a branch only.
templ deploys(v SettingsView) {
	<form if v.Base != "" { hx-post={ v.Base + "/from" } } hx-target={ target() } hx-swap="outerHTML" class="group/deploys">
		@keepOpen("deploys")
		<input type="hidden" name="fields" value="auto"/>
		<fieldset disabled?={ v.Base == "" } class="space-y-4">
			<legend class="sr-only">How releases reach this env</legend>
			<div class="space-y-2" data-field>
				<label class="flex items-center gap-2 text-sm text-rw-text"><input type="radio" name="from" value="branch" checked?={ c.Kept(ctx, "from", v.From) != "promote" } class="accent-rw-accent"/> Deploy a branch</label>
				if v.Below != "" || v.From == "promote" {
					<label class="flex items-center gap-2 text-sm text-rw-text"><input type="radio" name="from" value="promote" checked?={ c.Kept(ctx, "from", v.From) == "promote" } class="accent-rw-accent"/> Promote from { Below(v.Below) }</label>
				}
			</div>
			@c.Field(c.FieldView{Name: "branch", Label: "Branch", Value: v.Branch, Placeholder: "main", Help: "Used when deploying a branch."})
			<label class="flex items-center gap-2 text-sm text-rw-text group-has-[input[value=promote]:checked]/deploys:hidden" data-field><input type="checkbox" name="auto" value="1" checked?={ c.KeptOn(ctx, "auto", v.Auto) } class="accent-rw-accent"/> Deploy every push</label>
			if v.Base != "" {
				<button type="submit" class="btn btn-primary btn-sm">Save</button>
			}
		</fieldset>
	</form>
}

templ resources(f c.SettingsFormView) {
	<p class="text-xs text-rw-faint">Tiles below use these unless they set their own.</p>
	@c.SettingsForm(f)
}

templ remove(v SettingsView) {
	@c.DangerZone("Deleting this environment removes it and its variables. It is refused while it still has tiles.", v.Path, "The stack's releases are kept.") {
		@c.Confirm(v.Delete)
	}
}

// DNSBanner lists the hosts to repoint; it asks again every few minutes and
// goes away once none are left.
templ DNSBanner(v DNSBannerView) {
	if v.Empty() {
		<div id="dns-banner" hidden></div>
	} else {
		<div id="dns-banner" hx-get={ v.URL } hx-trigger="every 5m" hx-swap="outerHTML" role="status" class="relative z-40 px-4 sm:px-6 py-2 text-sm border-b border-rw-border bg-rw-surface shrink-0">
			<p class="text-rw-text">DNS does not point at this environment yet.</p>
			<ul class="mt-2 space-y-1">
				for _, r := range v.Hand {
					<li class="text-rw-muted"><span class="text-rw-text">{ r.Host }</span>: { "set " + r.Records + ". Now " + r.Points + "." }</li>
				}
				for _, r := range v.Held {
					<li class="text-rw-muted"><span class="text-rw-text">{ r.Host }</span>: left as is, points at { r.Points }. Stackr takes it back once it matches.</li>
				}
			</ul>
		</div>
	}
}

// Logs is the env's kept log lines: the viewer, built by the handler.
templ Logs(v c.LogHistoryView) {
	<div id="tab-logs">
		@c.LogHistory(v)
		if v.Purge != nil {
			<div class="mt-3">
				@c.Confirm(*v.Purge)
			</div>
		}
	</div>
}

// Sync is the review: the source picker, what blocks or needs a look, one
// block per tagged tile with its changes and a Drop, the params and volumes
// that go with them, and Deploy. Once queued, the job takes its place.
templ Sync(v SyncView) {
	<div id="tab-sync" class="space-y-4">
		if v.Why != "" {
			<p class="panel px-4 py-3 text-sm text-rw-faint">{ v.Why }</p>
		} else if v.Job != nil {
			@c.JobStatus(*v.Job)
		} else {
			<div class="flex flex-wrap items-center gap-3">
				<label for="sync-from" class="text-sm text-rw-muted">Sync from</label>
				<select id="sync-from" name="sync" class="input w-auto" hx-get={ v.Pick } hx-target="#main" hx-push-url="true">
					for _, s := range v.Sources {
						<option value={ s.Slug } selected?={ s.Selected }>{ s.Name }</option>
					}
				</select>
				<a href={ templ.SafeURL(v.CanvasHref) } hx-get={ v.CanvasHref } hx-target="#main" hx-push-url="true" class="link text-sm ml-auto">Show on canvas</a>
			</div>
			if len(v.Blockers) > 0 {
				<div class="banner banner-danger" role="alert">
					<p class="font-medium">Blocked:</p>
					<ul class="list-disc pl-5">
						for _, b := range v.Blockers {
							<li>{ b }</li>
						}
					</ul>
				</div>
			}
			if len(v.Warnings) > 0 {
				<div class="banner border-rw-warn/40 bg-rw-warn/10 text-rw-warn">
					<ul class="list-disc pl-5">
						for _, w := range v.Warnings {
							<li>{ w }</li>
						}
					</ul>
				</div>
			}
			if len(v.Tiles) == 0 {
				<p class="text-sm text-rw-faint">Nothing to sync.</p>
			}
			<ul class="space-y-3">
				for _, t := range v.Tiles {
					<li class={ "panel px-4 py-3 space-y-2", templ.KV("opacity-60", t.Dropped) }>
						<div class="flex flex-wrap items-center gap-2 text-sm">
							<span class="font-mono text-rw-text">{ t.Slug }</span>
							<span class="rounded-md border border-rw-border bg-rw-inset px-1.5 py-0.5 text-[10px] text-rw-muted">{ t.Kind }</span>
							<span class={ "rounded-md border px-1.5 py-0.5 text-[10px]", tagClass(t.Tag) }>{ t.Tag }</span>
							<span class="ml-auto text-xs">
								if t.Dropped {
									<span class="text-rw-faint">dropped · </span>
									<a href={ templ.SafeURL(t.Undo) } hx-get={ t.Undo } hx-target="#main" hx-push-url="true" class="link">Undo</a>
								} else {
									<a href={ templ.SafeURL(t.Drop) } hx-get={ t.Drop } hx-target="#main" hx-push-url="true" class="link">Drop</a>
								}
							</span>
						</div>
						@changes(t.Changes, false)
					</li>
				}
			</ul>
			if len(v.Other) > 0 {
				<h3 class="section-title">Variables and volumes</h3>
				@changes(v.Other, true)
			}
			if v.Deploy != nil {
				@c.Confirm(*v.Deploy)
			}
		}
	</div>
}

// changes are a tile's rows, old and new side by side (the plan's look).
templ changes(cs []c.ChangeView, named bool) {
	<ul class="space-y-1.5 text-sm">
		for _, ch := range cs {
			<li>
				<div class="flex flex-wrap items-center gap-2 font-mono">
					<span class={ signClass(ch.Kind) } aria-hidden="true">{ sign(ch.Kind) }</span>
					<span class="text-rw-faint">{ ch.Kind }</span>
					if named && ch.Tile != "" {
						<span class="text-rw-text">{ ch.Tile }</span>
					}
					if ch.Field != "" {
						<span class="text-rw-muted">{ ch.Field }</span>
					}
					if ch.Old != "" || ch.New != "" {
						<span class="text-rw-faint ml-auto min-w-0 break-all">
							if ch.Old != "" {
								<span class="text-rw-danger line-through">{ ch.Old }</span>
							}
							if ch.Old != "" && ch.New != "" {
								<span class="mx-1">→</span>
							}
							if ch.New != "" {
								<span class="text-rw-success">{ ch.New }</span>
							}
						</span>
					}
				</div>
				if ch.Note != "" {
					<p class="mt-0.5 pl-6 text-xs text-rw-muted">{ ch.Note }</p>
				}
			</li>
		}
	</ul>
}

func sign(kind string) string {
	switch kind {
	case "create":
		return "+"
	case "delete", "orphan", "detach":
		return "-"
	}
	return "~"
}

// signClass and tagClass spell every class in full so tailwind keeps them.
func signClass(kind string) string {
	switch sign(kind) {
	case "+":
		return "text-rw-success shrink-0 w-4"
	case "-":
		return "text-rw-danger shrink-0 w-4"
	}
	return "text-rw-warn shrink-0 w-4"
}

func tagClass(tag string) string {
	switch tag {
	case "new":
		return "border-rw-success/40 bg-rw-success/10 text-rw-success"
	case "removed":
		return "border-rw-danger/40 bg-rw-danger/10 text-rw-danger"
	}
	return "border-rw-warn/40 bg-rw-warn/10 text-rw-warn"
}
