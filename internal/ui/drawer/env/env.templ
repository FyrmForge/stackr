// Package env is the env card's drawer tabs (stack canvas): settings
// (name, resource overrides, where releases come from, colour, delete),
// order and logs, drawn as v0's environment settings page. Releases and
// params are shared views, composed by the handler.
package env

import (
	"strconv"

	c "github.com/FyrmForge/stackr/internal/ui/components"
)

var Tabs = []string{"settings", "releases", "params", "order", "logs"}

type SettingsView struct {
	Base    string // POST /rename, /from, /color; "" = read-only
	Name    string
	Tiles   int
	Canvas  string // the env page
	Path    string // "smoke / shop / dev"
	From    string // branch | promote
	Branch  string
	Auto    bool
	Color   string
	Cascade c.SettingsFormView
	Delete  c.ConfirmView
}

// OrderView is the ladder, bottom rung first; each move posts the whole
// new order.
type OrderView struct {
	Action string // POST ids...; "" = read-only
	Rungs  []Rung
}

type Rung struct {
	ID, Name, Color string
	Up, Down        []string // the order after moving this rung; nil = at the end
}

func target() string { return "#" + c.DrawerRoot }

func tiles(n int) string {
	if n == 1 {
		return "1 tile"
	}
	return strconv.Itoa(n) + " tiles"
}

templ Settings(v SettingsView) {
	<div id="tab-settings">
		<p class="text-sm text-rw-muted mb-6">
			{ tiles(v.Tiles) } · <a href={ templ.SafeURL(v.Canvas) } class="link">open the canvas</a>
		</p>
		@c.Section("Environment", "environment", "") {
			<form hx-post={ v.Base + "/rename" } hx-target={ target() } hx-swap="outerHTML" class="space-y-4">
				@c.Field(c.FieldView{Name: "name", Label: "Name", Value: v.Name, Required: true, Disabled: v.Base == "", Why: "Renaming needs write access to this environment."})
				if v.Base != "" {
					<button type="submit" class="btn btn-primary btn-sm">Rename</button>
				}
			</form>
		}
		@c.Section("Resource overrides", "environment", "Applied to every service in this environment that does not set its own. Leave a field empty to inherit from the level above.") {
			@c.SettingsForm(v.Cascade)
		}
		@c.Section("Releases", "environment", "Where this environment's releases come from, and whether a push deploys by itself.") {
			<form hx-post={ v.Base + "/from" } hx-target={ target() } hx-swap="outerHTML">
				<fieldset disabled?={ v.Base == "" } class="space-y-4">
					<legend class="sr-only">Releases come from</legend>
					<div class="space-y-2">
						<label class="flex items-center gap-2 text-sm text-rw-text"><input type="radio" name="from" value="branch" checked?={ v.From != "promote" } class="accent-rw-accent"/> A branch</label>
						<label class="flex items-center gap-2 text-sm text-rw-text"><input type="radio" name="from" value="promote" checked?={ v.From == "promote" } class="accent-rw-accent"/> Promotion from the rung below</label>
					</div>
					@c.Field(c.FieldView{Name: "branch", Label: "Branch", Value: v.Branch, Placeholder: "main", Help: "The branch a push builds from, when releases come from a branch."})
					<label class="flex items-center gap-2 text-sm text-rw-text"><input type="checkbox" name="auto" value="1" checked?={ v.Auto } class="accent-rw-accent"/> Deploy every push</label>
					if v.Base != "" {
						<button type="submit" class="btn btn-primary btn-sm">Save</button>
					}
				</fieldset>
			</form>
		}
		@c.Section("Colour", "environment", "How this environment is drawn on the canvases, plan rows and tile pages.") {
			<form hx-post={ v.Base + "/color" } hx-target={ target() } hx-swap="outerHTML">
				<fieldset disabled?={ v.Base == "" } class="panel px-4 py-3 flex flex-wrap items-center gap-3">
					<legend class="sr-only">Colour</legend>
					<span class="text-sm text-rw-text w-28 truncate">{ v.Name }</span>
					<div class="flex flex-wrap items-center gap-2">
						for _, col := range c.EnvColors {
							@c.EnvSwatch(col, col == v.Color)
						}
					</div>
					if v.Base != "" {
						<button type="submit" class="btn btn-ghost btn-sm ml-auto">Save</button>
					}
				</fieldset>
			</form>
		}
		if v.Base != "" {
			@c.DangerSection("Deleting this environment removes it and its params. It is refused while it still has tiles.", v.Path, "The stack's releases are kept.") {
				@c.Confirm(v.Delete)
			}
		}
	</div>
}

templ Order(v OrderView) {
	<div id="tab-order">
		<p class="text-sm text-rw-muted mb-4">The ladder, bottom rung first: releases climb it by promotion.</p>
		<ol class="space-y-2">
			for _, r := range v.Rungs {
				<li class="panel px-4 py-3 flex items-center gap-2 text-sm">
					<span class="flex-1">
						@c.EnvBadge(r.Name, r.Color)
					</span>
					if v.Action != "" {
						@move("Up", v.Action, r.Up)
						@move("Down", v.Action, r.Down)
					}
				</li>
			}
		</ol>
	</div>
}

templ move(label, action string, ids []string) {
	if ids != nil {
		<form hx-post={ action } hx-target={ target() } hx-swap="outerHTML">
			for _, id := range ids {
				<input type="hidden" name="ids" value={ id }/>
			}
			<button type="submit" class="btn btn-ghost btn-sm">{ label }</button>
		</form>
	}
}

// ponytail: no env-wide log verb yet; each tile's drawer has its logs.
templ Logs() {
	<p class="panel px-4 py-3 text-sm text-rw-faint" id="tab-logs">Logs are per tile: open a tile on this environment's canvas.</p>
}
