package vars

import (
	"context"
	"encoding/json"
	"net/url"
	"slices"
	"strings"

	c "github.com/FyrmForge/stackr/internal/ui/components"
)

// Grid is a params editor with one column per env (stack: its envs and pr;
// org: its tiers and pr). A cell edits that column's scope. A secret cell
// is a mask: its value never reaches the page unless its Show was pressed.
type Grid struct {
	Action       string // hx-post of a save and of Add; the edit, preview and reveal routes hang off it
	DeleteAction string // hx-post of Unset
	Cols         []Col
	Groups       []Group
	ReadOnly     bool
	Why          string
	// Added is the add form a save came from (its group, "" = a new
	// group) and Note what it did: the note sits right after that form.
	Added *string
	Note  string
	// Edit is the one cell open as an input; Shown the one secret on view;
	// Held the changes waiting for Apply.
	Edit  *CellRef
	Shown *Shown
	Held  *Held
}

// CellRef names one cell: its column's scope token, group and name.
type CellRef struct{ Scope, Group, Name string }

// Shown is a revealed secret. Value is that one cell's, fetched on demand.
type Shown struct {
	CellRef
	Value string
}

// Pending is an edit held until Apply: what it replaces and what it becomes.
// Field and Value are the form field it posts back (param.g.n or secret.g.n).
// A Draft is the secret whose input is still open: listed in the footer, its
// value posted by the input itself.
type Pending struct {
	CellRef
	Label    string
	Old, New string
	Field    string
	Value    string
	Draft    bool
}

// Held is the changes waiting for Apply, all in one column, and what applying
// does to running tiles.
type Held struct {
	Changes []Pending
	Impact  []string // one sentence each
	Starts  bool     // the tiles wait for it: applying starts them, it does not restart them
	Tiles   int
}

type Col struct {
	Token  string // the scope this column edits, posted as scope
	Label  string
	Sub    string // tier | own env | env | sandbox
	Hue    string // one of components.EnvColors
	Locked bool
	Own    bool // chip: an off-tier env of the stack
}

type Group struct {
	Name string
	Rows []Row
}

type Row struct {
	Name   string
	Secret bool // every set cell is secret; an unset cell then takes a secret
	Cells  []Cell // one per Col
}

// Set: a cell of this row is set here, so Only changed keeps it.
func (r Row) Set() bool {
	return slices.ContainsFunc(r.Cells, func(c Cell) bool { return c.Set })
}

type Cell struct {
	Value  string // "" for a secret
	Set    bool
	Secret bool     // this cell's own kind; a name may be plain in one env, secret in another
	Waits  []string // an unset secret: the tiles that wait for it
}

templ grid(v View) {
	<div id={ GridID } data-wide data-grid class="space-y-4">
		if v.Grid.ReadOnly {
			<p class="banner">{ v.Grid.Why }</p>
		}
		if len(v.Grid.Cols) > 1 {
			<div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-rw-faint">
				<span class="flex items-center gap-1.5"><span class="text-rw-warn">@lockIcon(true)</span> locked, read from inside only</span>
				<span class="flex items-center gap-1.5"><span class="inline-block h-3 w-6 rounded border border-dashed border-rw-border"></span> unset</span>
			</div>
		}
		if !v.Grid.ReadOnly {
			<p class="text-xs text-rw-faint" data-hint>Saving or unsetting a value can redeploy the running tiles that read it.</p>
		}
		if len(v.Grid.Groups) == 0 {
			<p class="text-sm text-rw-faint">Nothing here yet.</p>
		}
		for _, g := range v.Grid.Groups {
			@groupPanel(*v.Grid, g)
		}
		if !v.Grid.ReadOnly {
			@addForm(*v.Grid, "")
		}
	</div>
}

// one is the env view: a single column shows as flat rows, not a table.
func (g Grid) one() bool { return len(g.Cols) == 1 }

func (g Grid) editing(col Col, group, name string) bool {
	return g.Edit != nil && g.Edit.Scope == col.Token && g.Edit.Group == group && g.Edit.Name == name
}

func (g Grid) shown(col Col, group, name string) *Shown {
	if s := g.Shown; s != nil && s.Scope == col.Token && s.Group == group && s.Name == name {
		return s
	}
	return nil
}

func (g Grid) pending(col Col, group, name string) *Pending {
	if g.Held == nil {
		return nil
	}
	for i, p := range g.Held.Changes {
		if !p.Draft && p.Scope == col.Token && p.Group == group && p.Name == name {
			return &g.Held.Changes[i]
		}
	}
	return nil
}

// editVals are the fields of the POST that draws the editor with one cell open.
func editVals(col Col, group, name string, secret bool) string {
	m := map[string]string{"scope": col.Token, "group": group, "name": name}
	if secret {
		m["secret"] = "1" // the footer lists it while its input is open
	}
	b, _ := json.Marshal(m)
	return string(b)
}

// heldSel is the form of the held changes: every request that redraws the
// editor posts it, so no click loses them.
const heldSel = "#vars-held"

// plainURL draws the editor with nothing open and nothing held.
func (g Grid) plainURL() string { return g.Action + "/edit" }

templ groupPanel(g Grid, grp Group) {
	<section class="panel p-4 sm:p-6 overflow-hidden">
		<div class="flex items-baseline gap-3 mb-1">
			<h3 class="font-mono text-sm font-semibold text-rw-text">{ grp.Name }</h3>
		</div>
		if g.one() {
			<ul class="divide-y divide-rw-border">
				for _, r := range grp.Rows {
					<li class="py-3" data-field data-changed?={ r.Set() }>
						@listRow(g, g.Cols[0], grp.Name, r, r.Cells[0])
					</li>
				}
			</ul>
		} else {
			<div class="overflow-x-auto">
				<table class="w-full text-sm">
					<thead>
						<tr class="text-left text-xs uppercase tracking-wide text-rw-faint">
							<th class="pb-2 pr-3 font-medium align-bottom w-28">name</th>
							for _, col := range g.Cols {
								<th class="pb-2 pr-3 font-medium align-bottom min-w-[10rem]">
									<span class="flex items-center gap-1.5 normal-case tracking-normal text-sm">
										@c.EnvBadge(col.Label, col.Hue)
										<span class={ lockTone(col.Locked) } title={ lockTitle(col) }>@lockIcon(col.Locked)</span>
										if col.Own {
											@c.Chip("own env", "accent")
										}
									</span>
									<span class="block text-[10px] normal-case tracking-normal text-rw-faint font-normal">{ col.Sub }</span>
								</th>
							}
						</tr>
					</thead>
					<tbody>
						for _, r := range grp.Rows {
							<tr class="border-t border-rw-border" data-field data-changed?={ r.Set() }>
								<td class="py-2 pr-3 align-middle">
									<span class="font-mono text-sm text-rw-text">{ r.Name }</span>
									if r.Secret {
										@c.Chip("secret", "warn")
									}
								</td>
								for i, cell := range r.Cells {
									<td class="py-2 pr-3 align-middle">
										@cellView(g, g.Cols[i], grp.Name, r, cell)
									</td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		if !g.ReadOnly {
			@addForm(g, grp.Name)
		}
		if h := g.Held; h != nil && h.Group() == grp.Name {
			@pendingFooter(g, *h)
		}
	</section>
}

// listRow is one variable of the env view: name, value, actions.
templ listRow(g Grid, col Col, group string, r Row, cell Cell) {
	{{ refused := cellRefused(ctx, col, group, r.Name) }}
	if !g.ReadOnly && (g.editing(col, group, r.Name) || refused != nil) {
		<form data-hold class="vars-edit grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 gap-y-1 sm:grid-cols-[11rem_minmax(0,1fr)_auto]" hx-post={ g.Action + "/preview" } hx-trigger="submit, change" hx-include={ heldSel } hx-target="#vars-editor" hx-swap="outerHTML">
			<div class="min-w-0 col-span-2 sm:col-span-1">@nameOf(r)</div>
			<div class="min-w-0">
				@editInput(g, col, group, r, cell, refused)
			</div>
			<div class="flex items-center justify-end gap-1">
				<button type="button" class="btn btn-sm" hx-post={ g.Action + "/edit" } hx-include={ heldSel } hx-target="#vars-editor" hx-swap="outerHTML">Cancel</button>
			</div>
		</form>
		if cell.Set && g.DeleteAction != "" {
			@unsetButton(g, col, group, r)
		}
	} else {
		<div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 gap-y-1 sm:grid-cols-[11rem_minmax(0,1fr)_auto]">
			<div class="min-w-0 col-span-2 sm:col-span-1">@nameOf(r)</div>
			<div class="min-w-0 text-sm [overflow-wrap:anywhere]">
				@cellValue(g, col, group, r, cell)
				if len(cell.Waits) > 0 {
					<p class="mt-0.5 text-xs text-rw-warn">{ waitsLine(cell.Waits) }</p>
				}
				if g.shown(col, group, r.Name) != nil {
					@shownNote(g)
				}
			</div>
			<div class="flex items-center justify-end gap-1">
				@cellActions(g, col, group, r, cell)
			</div>
		</div>
	}
}

templ nameOf(r Row) {
	<span class="font-mono text-sm text-rw-text">{ r.Name }</span>
	if r.Secret {
		@c.Chip("secret", "warn")
	}
}

// cellView is a cell of the stack and org tables: value, actions, and the
// input when it is being edited.
templ cellView(g Grid, col Col, group string, r Row, cell Cell) {
	{{ refused := cellRefused(ctx, col, group, r.Name) }}
	if !g.ReadOnly && (g.editing(col, group, r.Name) || refused != nil) {
		<form data-hold class="vars-edit flex flex-wrap items-center gap-1" hx-post={ g.Action + "/preview" } hx-trigger="submit, change" hx-include={ heldSel } hx-target="#vars-editor" hx-swap="outerHTML">
			@editInput(g, col, group, r, cell, refused)
			<button type="button" class="btn btn-sm" hx-post={ g.Action + "/edit" } hx-include={ heldSel } hx-target="#vars-editor" hx-swap="outerHTML">Cancel</button>
		</form>
		if cell.Set && g.DeleteAction != "" {
			@unsetButton(g, col, group, r)
		}
	} else {
		<div class="flex items-center gap-1">
			<span class="min-w-0 flex-1">
				@cellValue(g, col, group, r, cell)
			</span>
			@cellActions(g, col, group, r, cell)
		</div>
		if g.shown(col, group, r.Name) != nil {
			@shownNote(g)
		}
	}
}

// cellValue is what the cell holds: the value, a mask, or unset. A pending
// edit shows the new value with the old one struck. A secret's value shows
// only when it was asked for.
templ cellValue(g Grid, col Col, group string, r Row, cell Cell) {
	if p := g.pending(col, group, r.Name); p != nil {
		<span class="inline-flex items-center gap-1.5 flex-wrap">
			<span class="h-1.5 w-1.5 rounded-full bg-rw-accent shrink-0" aria-hidden="true"></span>
			<span class="font-mono text-xs text-rw-text">{ p.New }</span>
			<span class="text-xs text-rw-faint line-through font-mono">{ p.Old }</span>
		</span>
	} else if s := g.shown(col, group, r.Name); s != nil {
		<span class="font-mono text-xs text-rw-text">{ s.Value }</span>
	} else if cell.Set && cell.Secret {
		<span class="font-mono text-xs text-rw-muted select-none" aria-label="hidden">••••••••</span>
	} else if cell.Set {
		<span class="block font-mono text-xs text-rw-text [overflow-wrap:anywhere]" title={ cell.Value }>{ cell.Value }</span>
	} else {
		<span class="text-sm text-rw-faint">unset</span>
	}
}

// cellActions: a plain value has its pencil; a secret has Show and Replace,
// or Set while it is unset. A cell with an edit waiting has Undo.
templ cellActions(g Grid, col Col, group string, r Row, cell Cell) {
	if g.ReadOnly {
	} else if g.pending(col, group, r.Name) != nil {
		<button type="button" class="inline-flex h-7 w-7 items-center justify-center rounded-md text-rw-faint hover:text-rw-text hover:bg-rw-inset transition-colors" title="Undo" aria-label={ "Undo " + group + "." + r.Name } hx-post={ g.Action + "/preview" } hx-vals={ dropVals(g.pending(col, group, r.Name).Field) } hx-include={ heldSel } hx-target="#vars-editor" hx-swap="outerHTML">@undoIcon()</button>
	} else if cell.Set && cell.Secret {
		if g.shown(col, group, r.Name) != nil {
			<button type="button" class="btn btn-sm" hx-post={ g.Action + "/edit" } hx-include={ heldSel } hx-target="#vars-editor" hx-swap="outerHTML">Hide</button>
		} else {
			<button type="button" class="btn btn-sm" hx-post={ g.Action + "/reveal" } hx-vals={ delVals(col.Token, group, r.Name) } hx-include={ heldSel } hx-target="#vars-editor" hx-swap="outerHTML" aria-label={ "Show " + group + "." + r.Name }>Show</button>
		}
		<button type="button" class="btn btn-sm" hx-post={ g.Action + "/edit" } hx-vals={ editVals(col, group, r.Name, true) } hx-include={ heldSel } hx-target="#vars-editor" hx-swap="outerHTML" aria-label={ "Replace " + group + "." + r.Name }>Replace</button>
	} else if r.Secret {
		<button type="button" class="btn btn-primary btn-sm" hx-post={ g.Action + "/edit" } hx-vals={ editVals(col, group, r.Name, true) } hx-include={ heldSel } hx-target="#vars-editor" hx-swap="outerHTML" aria-label={ "Set " + group + "." + r.Name }>Set</button>
	} else {
		<button type="button" class="inline-flex h-7 w-7 items-center justify-center rounded-md text-rw-faint hover:text-rw-text hover:bg-rw-inset transition-colors" title="Edit" aria-label={ "Edit " + group + "." + r.Name } hx-post={ g.Action + "/edit" } hx-vals={ editVals(col, group, r.Name, false) } hx-include={ heldSel } hx-target="#vars-editor" hx-swap="outerHTML">@penIcon()</button>
	}
}

// shownNote: the revealed value goes back to a mask on Hide, and by itself.
templ shownNote(g Grid) {
	<p class="mt-1 text-xs text-rw-faint" data-hold>
		Shown to you. Logged. Hides in 30 s.
		<span hidden hx-post={ g.Action + "/edit" } hx-trigger="load delay:30s" hx-include={ heldSel } hx-target="#vars-editor" hx-swap="outerHTML"></span>
	</p>
}

templ editInput(g Grid, col Col, group string, r Row, cell Cell, refused *c.Refused) {
	<input type="hidden" name="scope" value={ col.Token }/>
	if cell.Secret || (!cell.Set && r.Secret) {
		<input class="input font-mono ff" type="password" autocomplete="new-password" name={ "secret." + group + "." + r.Name } aria-label={ "Value of " + group + "." + r.Name } placeholder="new value"/>
	} else {
		<input class="input font-mono ff" name={ "param." + group + "." + r.Name } value={ keptCell(refused, "param."+group+"."+r.Name, cell.Value) } autocomplete="off" aria-label={ "Value of " + group + "." + r.Name }/>
	}
	if len(cell.Waits) > 0 {
		<p class="mt-1 text-xs text-rw-warn">Saving starts { NaturalList(cell.Waits) }.</p>
	}
	if refused != nil {
		<p class="field-error basis-full" role="alert">{ refused.Msg }</p>
	}
}

templ unsetButton(g Grid, col Col, group string, r Row) {
	<div class="mt-1">
		@c.Confirm(c.ConfirmView{
			Button:  "Unset",
			Label:   "Unset " + group + "." + r.Name + " in " + col.Label,
			Title:   "Unset " + group + "." + r.Name + " in " + col.Label + "?",
			Warning: "Tiles that read it wait until it is set again.",
			Action:  g.DeleteAction,
			Target:  "#vars-editor",
			Vals:    delVals(col.Token, group, r.Name),
			Quiet:   true,
		})
	</div>
}

templ pendingFooter(g Grid, h Held) {
	@c.PendingFooter(c.PendingView{
		ID:      "vars-held",
		Include: ".vars-edit",
		Action:  g.Action,
		Target:  "#vars-editor",
		Cancel:  g.plainURL(),
		Changes: h.views(),
		Impact:  h.Impact,
		Apply:   c.PendingApply(h.verb(), h.Tiles),
		Later:   h.later(),
	}) {
		<input type="hidden" name="held_scope" value={ h.Changes[0].Scope }/>
		for _, p := range h.Changes {
			if !p.Draft {
				<input type="hidden" name={ "held." + p.Field } value={ p.Value }/>
			}
		}
	}
}

// Group is the group whose panel carries the footer: the one last changed.
func (h Held) Group() string { return h.Changes[len(h.Changes)-1].Group }

func (h Held) views() []c.PendingChange {
	out := make([]c.PendingChange, len(h.Changes))
	for i, p := range h.Changes {
		out[i] = c.PendingChange{Label: p.Label, Old: p.Old, New: p.New}
	}
	return out
}

func (h Held) verb() string {
	if h.Starts {
		return "start"
	}
	return "redeploy"
}

func (h Held) later() string {
	if h.Tiles == 0 {
		return ""
	}
	return "Apply, " + h.verb() + " later"
}

func dropVals(field string) string {
	b, _ := json.Marshal(map[string]string{"drop": field})
	return string(b)
}

func waitsLine(tiles []string) string {
	return NaturalList(tiles) + " wait for it."
}

// NaturalList is "a", "a and b", "a, b and c".
func NaturalList(xs []string) string {
	switch len(xs) {
	case 0:
		return ""
	case 1:
		return xs[0]
	}
	return strings.Join(xs[:len(xs)-1], ", ") + " and " + xs[len(xs)-1]
}

templ penIcon() {
	<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>
}

templ undoIcon() {
	<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7v6h6"></path><path d="M3 13a9 9 0 1 0 3-7"></path></svg>
}

// addForm is a row: group (fixed inside a group's panel), name, kind and a
// value per column; blank = unset there.
templ addForm(g Grid, group string) {
	{{ r := addRefused(ctx, group) }}
	<details class="group" open?={ r != nil }>
		<summary class="btn btn-ghost btn-sm w-full border border-dashed border-rw-border cursor-pointer list-none select-none">
			if group == "" {
				+ Add group
			} else {
				+ Add variable
			}
		</summary>
		<form class="mt-2 grid gap-4 border-t border-rw-border pt-4 sm:grid-cols-2" hx-post={ g.Action } hx-target="#vars-editor" hx-swap="outerHTML">
			<input type="hidden" name="add_form" value={ group }/>
			<input type="checkbox" id={ "add-secret-" + group } name="add_kind" value="secret" class="peer sr-only" aria-label="Secret" checked?={ typed(r, "add_kind") == "secret" }/>
			if group == "" {
				<div>
					<label class="label">Group</label>
					<input class="input font-mono ff" name="add_group" placeholder="app" autocomplete="off" value={ typed(r, "add_group") } { c.Invalid(errID(group, "add_group"), fieldErr(r, "add_group"))... }/>
					@c.FieldError(errID(group, "add_group"), fieldErr(r, "add_group"))
				</div>
			} else {
				<input type="hidden" name="add_group" value={ group }/>
			}
			<div>
				<label class="label">Name</label>
				<input class="input font-mono ff" name="add_name" placeholder="DB_HOST" autocomplete="off" data-1p-ignore data-lpignore="true" value={ typed(r, "add_name") } { c.Invalid(errID(group, "add_name"), fieldErr(r, "add_name"))... }/>
				<span class="settings-help">Letters, digits and underscore.</span>
				@c.FieldError(errID(group, "add_name"), fieldErr(r, "add_name"))
			</div>
			for _, col := range g.Cols {
				<div class="peer-checked:hidden">
					<label class="label">{ valueLabel(g, col.Label) }</label>
					<input class="input font-mono" name={ "add_value." + col.Token } value={ typed(r, "add_value."+col.Token) } autocomplete="off" placeholder="unset" { c.Invalid(errID(group, "add_value"), fieldErr(r, "add_value"))... }/>
					<span class="settings-help">Leave empty to set it later.</span>
				</div>
				<div class="hidden peer-checked:block">
					<label class="label">{ valueLabel(g, col.Label) }</label>
					<input class="input font-mono" type="password" name={ "add_secret." + col.Token } autocomplete="new-password" placeholder="unset" { c.Invalid(errID(group, "add_value"), fieldErr(r, "add_value"))... }/>
					<span class="settings-help">Leave empty to set it later.</span>
				</div>
			}
			@c.FieldError(errID(group, "add_value"), fieldErr(r, "add_value"))
			<label for={ "add-secret-" + group } class="sm:col-span-2 flex cursor-pointer flex-wrap items-center gap-3 peer-checked:[&_.trk]:bg-rw-accent peer-checked:[&_.knob]:translate-x-4 peer-checked:[&_.off]:hidden peer-checked:[&_.on]:inline peer-focus-visible:[&_.trk]:ring-2">
				<span class="trk relative inline-flex h-5 w-9 shrink-0 items-center rounded-full bg-rw-border transition-colors" aria-hidden="true">
					<span class="knob inline-block h-4 w-4 translate-x-0.5 rounded-full bg-rw-text transition-transform"></span>
				</span>
				<span class="text-sm text-rw-text">Secret</span>
				<span class="off text-xs text-rw-faint">Off. Shown in the grid.</span>
				<span class="on hidden text-xs text-rw-faint">On. Hidden in the grid.</span>
			</label>
			if r != nil && len(r.More) == 0 {
				<p class="field-error sm:col-span-2" role="alert">{ r.Msg }</p>
			}
			<div class="sm:col-span-2 flex items-center gap-2">
				<button type="submit" class="btn btn-primary btn-sm">Add variable</button>
				<button type="button" class="btn btn-sm" hx-get={ g.plainURL() } hx-target="#vars-editor" hx-swap="outerHTML">Cancel</button>
			</div>
		</form>
	</details>
	if g.Added != nil && *g.Added == group && g.Note != "" {
		<div class="mt-3" data-acted>
			@c.Note(g.Note)
		</div>
	}
}

// valueLabel is "Value in prod" for a one-column grid (an env), the column's
// own label otherwise.
func valueLabel(g Grid, col string) string {
	if len(g.Cols) == 1 {
		return "Value in " + col
	}
	return col
}

// errID is an add form's field error id: one per group's form, so two
// forms on the page never share one.
func errID(group, field string) string {
	if group == "" {
		return field
	}
	return field + "-" + group
}

// fieldErr is the refusal's reason for one field of an add form.
func fieldErr(r *c.Refused, field string) string {
	if r == nil {
		return ""
	}
	return r.More[field]
}

templ lockIcon(locked bool) {
	<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
		if locked {
			<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
		} else {
			<path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
		}
	</svg>
}

func lockTone(locked bool) string {
	if locked {
		return "text-rw-warn"
	}
	return "text-rw-faint"
}

func lockTitle(col Col) string {
	if col.Sub == "sandbox" {
		return "Never locked"
	}
	if col.Locked {
		return "Locked: read only from inside " + col.Label
	}
	return "Open: other envs can read it"
}

// Takes: a refusal of this form shows in it, open with what was typed (an
// add or a cell save), not over the editor.
func Takes(form url.Values) bool {
	if form.Has("add_form") {
		return true
	}
	for k := range form {
		if strings.HasPrefix(k, "param.") || strings.HasPrefix(k, "secret.") || strings.HasPrefix(k, "held.") {
			return true
		}
	}
	return false
}

// addRefused is the refusal when this add form (its group, "" = a new
// group) posted it; nil otherwise.
func addRefused(ctx context.Context, group string) *c.Refused {
	if r := c.RefusedHere(ctx); r != nil && r.Vals.Has("add_form") && r.Vals.Get("add_form") == group {
		return r
	}
	return nil
}

// cellRefused is the refusal when this cell's form posted it.
func cellRefused(ctx context.Context, col Col, group, name string) *c.Refused {
	r := c.RefusedHere(ctx)
	if r == nil || r.Vals.Get("scope") != col.Token {
		return nil
	}
	if r.Vals.Has("param."+group+"."+name) || r.Vals.Has("secret."+group+"."+name) {
		return r
	}
	return nil
}

// typed is what the refused form posted for k; a secret is never asked.
func typed(r *c.Refused, k string) string {
	if r == nil {
		return ""
	}
	return r.Vals.Get(k)
}

// keptCell is a plain cell's value: what was typed when its save was
// refused, else stored.
func keptCell(r *c.Refused, k, stored string) string {
	if r == nil {
		return stored
	}
	return r.Vals.Get(k)
}

func delVals(scope, group, name string) string {
	b, _ := json.Marshal(map[string]string{"scope": scope, "collection": group, "name": name})
	return string(b)
}
