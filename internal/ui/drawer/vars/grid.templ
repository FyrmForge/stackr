package vars

import (
	"encoding/json"

	c "github.com/FyrmForge/stackr/internal/ui/components"
)

// Grid is a params editor with one column per env (stack: its envs and pr;
// org: its tiers and pr). A cell edits that column's scope. A secret cell
// is a mask: its value never reaches the page, so no reveal.
type Grid struct {
	Action       string // hx-post of a cell save and of Add
	DeleteAction string // hx-post of Unset
	Cols         []Col
	Groups       []Group
	ReadOnly     bool
	Why          string
}

type Col struct {
	Token  string // the scope this column edits, posted as scope
	Label  string
	Sub    string // tier | own env | env | sandbox
	Hue    string // one of components.EnvColors
	Locked bool
	Own    bool // chip: an off-tier env of the stack
}

type Group struct {
	Name string
	Rows []Row
}

type Row struct {
	Name   string
	Secret bool // every set cell is secret; an unset cell then takes a secret
	Cells  []Cell // one per Col
}

type Cell struct {
	Value  string // "" for a secret
	Set    bool
	Secret bool // this cell's own kind; a name may be plain in one env, secret in another
}

templ grid(v View) {
	<div data-wide class="space-y-4">
		if v.Grid.ReadOnly {
			<p class="banner">{ v.Grid.Why }</p>
		}
		<div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-rw-faint">
			<span class="flex items-center gap-1.5"><span class="text-rw-warn">@lockIcon(true)</span> locked, read from inside only</span>
			<span class="flex items-center gap-1.5"><span class="inline-block h-3 w-6 rounded border border-dashed border-rw-border"></span> unset</span>
		</div>
		if len(v.Grid.Groups) == 0 {
			<p class="text-sm text-rw-faint">Nothing here yet.</p>
		}
		for _, g := range v.Grid.Groups {
			@groupPanel(*v.Grid, g)
		}
		if !v.Grid.ReadOnly {
			@addForm(*v.Grid, "")
		}
	</div>
}

templ groupPanel(g Grid, grp Group) {
	<section class="panel p-4">
		<div class="flex items-baseline gap-3 mb-3">
			<h3 class="font-mono text-sm font-semibold text-rw-text">{ grp.Name }</h3>
		</div>
		<div class="overflow-x-auto">
			<table class="w-full text-sm">
				<thead>
					<tr class="text-left text-xs uppercase tracking-wide text-rw-faint">
						<th class="pb-2 pr-3 font-medium align-bottom w-28">name</th>
						for _, col := range g.Cols {
							<th class="pb-2 pr-3 font-medium align-bottom min-w-[9.5rem]">
								<span class="flex items-center gap-1.5 normal-case tracking-normal text-sm">
									@c.EnvBadge(col.Label, col.Hue)
									<span class={ lockTone(col.Locked) } title={ lockTitle(col) }>@lockIcon(col.Locked)</span>
									if col.Own {
										@c.Chip("own env", "accent")
									}
								</span>
								<span class="block text-[10px] normal-case tracking-normal text-rw-faint font-normal">{ col.Sub }</span>
							</th>
						}
					</tr>
				</thead>
				<tbody>
					for _, r := range grp.Rows {
						<tr class="border-t border-rw-border">
							<td class="py-1.5 pr-3 align-middle">
								<span class="font-mono text-sm text-rw-text">{ r.Name }</span>
								if r.Secret {
									@c.Chip("secret", "warn")
								}
							</td>
							for i, cell := range r.Cells {
								<td class="py-1.5 pr-3 align-middle">
									@cellView(g, g.Cols[i], grp.Name, r, cell)
								</td>
							}
						</tr>
					}
				</tbody>
			</table>
		</div>
		if !g.ReadOnly {
			@addForm(g, grp.Name)
		}
	</section>
}

templ cellView(g Grid, col Col, group string, r Row, cell Cell) {
	if g.ReadOnly {
		if cell.Set && cell.Secret {
			<span class="font-mono text-xs text-rw-muted select-none" aria-label="hidden">••••••••</span>
		} else if cell.Set {
			<span class="font-mono text-xs text-rw-text truncate">{ cell.Value }</span>
		} else {
			<span class="text-xs text-rw-faint">unset</span>
		}
	} else {
		<details class="group">
			<summary class="cursor-pointer list-none select-none rounded-md px-2 py-1.5 hover:bg-rw-inset text-xs">
				if cell.Set && cell.Secret {
					<span class="font-mono text-rw-muted" aria-label="hidden">••••••••</span>
					<span class="ml-2 text-[10px] text-rw-faint">Replace</span>
				} else if cell.Set {
					<span class="font-mono text-rw-text truncate">{ cell.Value }</span>
				} else if r.Secret {
					<span class="block rounded-md border border-dashed border-rw-danger/50 px-2 py-1 text-rw-danger">Set</span>
				} else {
					<span class="block rounded-md border border-dashed border-rw-border px-2 py-1 text-rw-faint">unset</span>
				}
			</summary>
			<form class="flex flex-wrap items-center gap-2 mt-1" hx-post={ g.Action } hx-target="#vars-editor" hx-swap="outerHTML">
				<input type="hidden" name="scope" value={ col.Token }/>
				if cell.Secret || (!cell.Set && r.Secret) {
					<input class="input font-mono flex-1 min-w-24" type="password" autocomplete="new-password" name={ "secret." + group + "." + r.Name } placeholder="new value" aria-label={ group + "." + r.Name + " in " + col.Label + " (secret)" }/>
				} else {
					<input class="input font-mono flex-1 min-w-24" name={ "param." + group + "." + r.Name } value={ cell.Value } autocomplete="off" aria-label={ group + "." + r.Name + " in " + col.Label }/>
				}
				<button type="submit" class="btn btn-primary btn-sm">Save</button>
			</form>
			if cell.Set && g.DeleteAction != "" {
				@c.Confirm(c.ConfirmView{
					Button:  "Unset",
					Label:   "Unset " + group + "." + r.Name + " in " + col.Label,
					Title:   "Unset " + group + "." + r.Name + " in " + col.Label + "?",
					Warning: "Tiles that read it wait until it is set again.",
					Action:  g.DeleteAction,
					Target:  "#vars-editor",
					Vals:    delVals(col.Token, group, r.Name),
					Quiet:   true,
				})
			}
		</details>
	}
}

// addForm is a row: group (fixed inside a group's panel), name, kind and a
// value per column; blank = unset there.
templ addForm(g Grid, group string) {
	<details class="group">
		<summary class="btn btn-ghost btn-sm w-full border border-dashed border-rw-border cursor-pointer list-none select-none">
			if group == "" {
				+ Add group
			} else {
				+ Add variable
			}
		</summary>
		<form class="panel px-3 py-2.5 mt-2 border-rw-accent/60 space-y-2" hx-post={ g.Action } hx-target="#vars-editor" hx-swap="outerHTML">
			<input type="checkbox" id={ "add-secret-" + group } name="add_kind" value="secret" class="peer sr-only" aria-label="Secret"/>
			<div class="flex flex-wrap items-center gap-2">
				if group == "" {
					<input class="input font-mono !w-32" name="add_group" placeholder="group" aria-label="Group" required/>
				} else {
					<input type="hidden" name="add_group" value={ group }/>
				}
				<input class="input font-mono flex-1 min-w-32" name="add_name" placeholder="name" aria-label="Name" required/>
				<label for={ "add-secret-" + group } class="btn btn-ghost btn-sm cursor-pointer">Secret?</label>
			</div>
			<div class="grid grid-cols-2 sm:grid-cols-4 gap-2 peer-checked:hidden">
				for _, col := range g.Cols {
					<label class="text-xs text-rw-faint">
						{ col.Label }
						<input class="input font-mono mt-0.5" name={ "add_value." + col.Token } autocomplete="off" placeholder="unset"/>
					</label>
				}
			</div>
			<div class="hidden grid-cols-2 sm:grid-cols-4 gap-2 peer-checked:grid">
				<p class="col-span-full text-xs text-rw-faint">Secret values are never shown again.</p>
				for _, col := range g.Cols {
					<label class="text-xs text-rw-faint">
						{ col.Label }
						<input class="input font-mono mt-0.5" type="password" name={ "add_secret." + col.Token } autocomplete="new-password" placeholder="unset"/>
					</label>
				}
			</div>
			<button type="submit" class="btn btn-primary btn-sm">Save</button>
		</form>
	</details>
}

templ lockIcon(locked bool) {
	<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
		if locked {
			<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
		} else {
			<path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
		}
	</svg>
}

func lockTone(locked bool) string {
	if locked {
		return "text-rw-warn"
	}
	return "text-rw-faint"
}

func lockTitle(col Col) string {
	if col.Sub == "sandbox" {
		return "Never locked"
	}
	if col.Locked {
		return "Locked: read only from inside " + col.Label
	}
	return "Open: other envs can read it"
}

func delVals(scope, group, name string) string {
	b, _ := json.Marshal(map[string]string{"scope": scope, "collection": group, "name": name})
	return string(b)
}
