// Package vars is the params and secrets editor of one scope: the vars
// card's drawer, and the params tab of the org, stack and env drawers.
package vars

import c "github.com/FyrmForge/stackr/internal/ui/components"

// Root is what a save answers into (outerHTML), wherever the editor sits.
const Root = "vars-editor"

type View struct {
	Scope  string // "org acme", for the heading
	Lead   string // the opening line; "" = the tiles' (a save redeploys what reads them)
	Error  string
	Note   string
	Editor c.ParamEditorView
	Grid   *Grid // set: the per-env grid instead of Editor
}

templ Editor(v View) {
	<div id={ Root } class="space-y-4">
		if v.Lead != "" {
			<p class="text-sm text-rw-muted">{ v.Lead }</p>
		} else {
			<p class="text-sm text-rw-muted">Params and secrets of { v.Scope }. A save redeploys the running tiles that read them.</p>
		}
		@c.FormError(v.Error)
		if v.Note != "" {
			<p class="banner" role="status">{ v.Note }</p>
		}
		if v.Grid != nil {
			@grid(v)
		} else {
			@c.ParamEditor(v.Editor)
		}
	</div>
}
