package tile

import (
	"cmp"
	"strings"

	c "github.com/FyrmForge/stackr/internal/ui/components"
	"github.com/FyrmForge/stackr/internal/ui/dialog"
	placementui "github.com/FyrmForge/stackr/internal/ui/placement"
)

// actions are the header buttons (v0 appActions): a service or image tile
// stops, restarts and deploys; a cron runs and pauses; a function runs and
// deploys.
templ actions(v View) {
	if !v.ReadOnly {
		switch v.Kind {
			case "cron":
				@c.PrimaryPost("Run now", v.Base+"/run")
				<button type="button" class="btn btn-ghost btn-sm" hx-post={ v.Base + "/pause" } hx-vals={ pauseVals(!v.Paused) } hx-target={ "#" + Root } hx-swap="outerHTML">
					if v.Paused {
						Resume
					} else {
						Pause
					}
				</button>
			case "function":
				@c.PrimaryPost("Run now", v.Base+"/run")
				@c.PostButton("Deploy", v.Base+"/deploy")
			default:
				if v.Stopped {
					@c.PostButton("Start", v.Base+"/start")
				} else {
					@c.Confirm(quiet(dialog.Stop(v.Name, v.Base+"/stop", "#"+Root)))
					@c.PostButton("Restart", v.Base+"/restart")
				}
				@c.PrimaryPost("Deploy", v.Base+"/deploy")
		}
	}
}

func quiet(v c.ConfirmView) c.ConfirmView {
	v.Quiet = true
	return v
}

func pauseVals(paused bool) string {
	if paused {
		return `{"paused":"true"}`
	}
	return `{"paused":"false"}`
}

// imageStrip is v0's "New image version available" line above the tabs.
templ imageStrip(v View) {
	<div class="px-6 py-2 bg-rw-warn/10 border-y border-rw-warn/40 text-sm text-rw-warn flex items-center gap-2 flex-wrap">
		<span class="font-semibold">New image version available</span>
		<span class="font-mono text-xs">{ shortDigest(v.NewDigest) }</span>
		if v.AutoUpdate {
			<span class="text-xs opacity-75">auto-update queued by the watcher</span>
		} else {
			<span class="text-xs opacity-75">deploy to update</span>
		}
	</div>
}

func shortDigest(d string) string {
	s := strings.TrimPrefix(d, "sha256:")
	if len(s) > 12 {
		s = s[:12]
	}
	return s
}

// tabLink opens another tab of this drawer.
templ tabLink(v View, query, label string) {
	<a
		href={ templ.SafeURL("?drawer=" + v.Node + "&tab=" + query) }
		hx-get={ v.Base + "?tab=" + query }
		hx-target={ "#" + Root }
		hx-swap="outerHTML"
		hx-push-url={ "?drawer=" + v.Node + "&tab=" + query }
		class="link"
	>{ label }</a>
}

// Status is v0's Overview: the status and last deployment boxes, the URLs
// and the ports.
templ Status(v View, s StatusView) {
	<div class="space-y-5" id="tab-status">
		<div class="grid grid-cols-2 gap-3">
			<div class="panel p-4">
				<div class="label">Status</div>
				@c.TileBadge(s.Word)
				for _, r := range s.Replicas {
					<div class="text-xs text-rw-faint mt-1.5">
						<span class="font-mono">{ r.Name }</span> { r.State }
						if r.Health != "" {
							· { r.Health }
						}
					</div>
				}
			</div>
			<div class="panel p-4">
				<div class="label">Last deployment</div>
				if s.Job == nil {
					<span class="text-sm text-rw-faint">never deployed</span>
				} else {
					@c.JobStatus(*s.Job)
					<div class="text-xs text-rw-faint mt-1.5">@c.When(s.JobWhen)
</div>
				}
			</div>
		</div>
		<div>
			<div class="label">URLs</div>
			if len(s.URLs) == 0 {
				<p class="text-sm text-rw-faint">
					No domains attached.
					if !v.ReadOnly {
						{ " Add one in Settings." }
					}
				</p>
			} else {
				<ul class="space-y-1.5">
					for _, d := range s.URLs {
						<li class="flex flex-wrap items-center gap-2 text-sm">
							<a href={ templ.SafeURL(scheme(d.HTTPS) + d.Host + d.Path) } target="_blank" rel="noopener" class="link font-mono text-xs">{ scheme(d.HTTPS) + d.Host + d.Path }</a>
							if d.HTTPS {
								<span class="text-[10px] font-semibold uppercase tracking-wide text-rw-success">https</span>
							} else {
								<span class="text-[10px] font-semibold uppercase tracking-wide text-rw-warn">http only</span>
							}
							<span class="text-rw-faint text-xs">→ :{ d.Port }</span>
						</li>
					}
				</ul>
			}
		</div>
		<div>
			<div class="label">Access</div>
			if s.Port == "" && len(s.Ports) == 0 && len(s.Access) == 0 {
				<p class="text-sm text-rw-faint">No ports configured.</p>
			} else {
				<ul class="space-y-1 text-sm text-rw-muted">
					if s.Port != "" {
						<li>container port <span class="font-mono text-rw-text">{ s.Port }</span> (proxied via domains above)</li>
					}
					for _, p := range s.Ports {
						<li>host port <span class="font-mono text-rw-text">{ p }</span> published directly</li>
					}
					for _, p := range s.Access {
						<li class="flex flex-wrap items-center gap-2">
							<span class="text-rw-text">{ p.Label }</span>
							if p.Detail != "" {
								<span class="font-mono text-xs">{ p.Detail }</span>
							}
							if p.Waiting {
								@c.Chip("waiting", "warn")
							} else {
								@c.Chip("approved", "success")
							}
						</li>
					}
				</ul>
			}
		</div>
	</div>
}

func scheme(https bool) string {
	if https {
		return "https://"
	}
	return "http://"
}

templ Logs(v View, l LogsView) {
	<div class="space-y-3" id="tab-logs">
		if l.History != "" {
			<div class="flex items-center gap-2">
				<span class="btn btn-sm btn-primary pointer-events-none" aria-current="true">Live</span>
				<button type="button" class="btn btn-ghost btn-sm" hx-get={ l.History } hx-target="#tab-logs" hx-swap="innerHTML">History</button>
			</div>
		}
		if l.Run != "" {
			<p class="text-xs text-rw-faint">
				Run <span class="font-mono text-rw-muted">{ l.Run }</span> ·
				@tabLink(v, "runs", "all runs")
			</p>
		} else if len(l.Replicas) > 1 {
			<div class="flex items-center gap-2">
				<label class="text-xs text-rw-faint" for="log-container">Replica</label>
				<select id="log-container" name="container" class="input !w-60 !py-1.5 text-sm" hx-get={ v.Base + "?tab=logs" } hx-target={ "#" + Root } hx-swap="outerHTML">
					for _, r := range l.Replicas {
						<option value={ r.ID } selected?={ r.ID == l.Container }>{ r.Name }</option>
					}
				</select>
			</div>
		}
		if l.Run == "" && l.Container == "" {
			if l.Runs {
				<p class="text-rw-muted text-sm">No runs yet. Hit Run now to make one.</p>
			} else {
				<p class="text-rw-muted text-sm">No container is running yet.</p>
			}
		} else {
			@c.LogPane(l.Pane)
		}
	</div>
}

// Terminal is a shell in the chosen replica: xterm over a websocket, both
// loaded here (the vendored scripts are classic, the element a module).
templ Terminal(v View, t TerminalView) {
	<div class="space-y-3" id="tab-terminal">
		if len(t.Replicas) > 1 {
			<div class="flex items-center gap-2">
				<label class="text-xs text-rw-faint" for="term-container">Replica</label>
				<select id="term-container" name="container" class="input !w-60 !py-1.5 text-sm" hx-get={ v.Base + "?tab=terminal" } hx-target={ "#" + Root } hx-swap="outerHTML">
					for _, r := range t.Replicas {
						<option value={ r.ID } selected?={ r.ID == t.Container }>{ r.Name }</option>
					}
				</select>
			</div>
		}
		if t.Container == "" {
			<p class="text-rw-muted text-sm">No container is running yet.</p>
		} else {
			<link rel="stylesheet" href={ c.StaticURL("css/xterm.css") }/>
			<script src={ c.StaticURL("js/vendor/xterm.js") }></script>
			<script src={ c.StaticURL("js/vendor/xterm-addon-fit.js") }></script>
			<script type="module" src={ c.StaticURL("js/elements/term-pane.js") }></script>
			<term-pane url={ t.URL } class="block h-96 overflow-hidden rounded-lg bg-black p-2"></term-pane>
		}
	</div>
}

// Metrics is the tile's live graphs, one line per replica; a cron or
// function tile has one point per run instead.
templ Metrics(v View, m c.MetricsView) {
	<div id="tab-metrics">
		@c.Metrics(m) {
			if v.Kind == "cron" || v.Kind == "function" {
				@c.Chart(m, "Run duration", "run_s", "duration", "s")
				@c.Chart(m, "Peak memory", "run_mem_peak", "peak", "bytes")
				@c.Chart(m, "CPU", "run_cpu_s", "cpu time", "s")
				@c.Chart(m, "Failure rate", "run_failed", "failed", "ratio")
			} else {
				@c.Chart(m, "CPU", "cpu_pct", "", "pct")
				@c.Chart(m, "Memory", "mem", "", "bytes")
				@c.Chart(m, "Network", "net_rx_bps net_tx_bps", "in,out", "bps")
				@c.Chart(m, "Disk IO", "io_read_bps io_write_bps", "read,write", "bps")
				if v.Domained {
					@c.Chart(m, "Requests", "req_s 4xx_s 5xx_s", "all,4xx,5xx", "rps")
					@c.Chart(m, "Response time", "latency_ms", "average", "ms")
				}
			}
		}
	</div>
}

// Jobs is v0's Deployments: one panel row per job, newest first.
templ Jobs(v View, j JobsView) {
	<div id="tab-jobs">
		if len(j.Rows) == 0 {
			<p class="text-rw-muted text-sm">No deployments yet. Hit Deploy to build the first one.</p>
		} else {
			<ul class="space-y-2">
				for _, r := range j.Rows {
					<li class="panel px-4 py-3 flex flex-wrap items-center gap-x-3 gap-y-2">
						<span class="text-sm text-rw-text font-mono">{ r.Kind }</span>
						<span class="text-xs text-rw-faint whitespace-nowrap">@c.When(r.When)
</span>
						<span class="ml-auto flex items-center gap-2">
							if r.Cancel != "" {
								@c.Confirm(c.ConfirmView{
									Button:  "Cancel",
									Title:   "Cancel this job?",
									Warning: "A job already swapping in cannot be cancelled.",
									Action:  r.Cancel,
									Target:  "#" + Root,
									Quiet:   true,
								})
							}
							@c.JobBadge(r.State)
						</span>
						if r.Error != "" {
							<p class="basis-full text-xs text-rw-danger">{ r.Error }</p>
						}
					</li>
				}
			</ul>
			@c.ZoneNote()
		}
	</div>
}

// Env is the Variables row: the rows, each with its ×, then the
// KEY=VALUE editor behind "Edit variables".
templ Env(v View, e EnvView) {
	<div id="tab-env">
		<p class="text-xs text-rw-faint mb-3">
			Values may reference params or another tile:
			<span class="font-mono text-rw-muted">{ "${{ params.app.key }}" }</span>,
			<span class="font-mono text-rw-muted">{ "${{ tile.api.url }}" }</span>.
			References resolve at deploy time.
		</p>
		if len(e.Rows) == 0 {
			<p class="text-rw-muted text-sm">No variables set yet.</p>
		} else {
			<ul class="space-y-1.5">
				for _, r := range e.Rows {
					<li class="panel px-4 py-2.5 flex items-start gap-3 text-sm font-mono" data-field data-changed>
						<span class="text-rw-accentHi shrink-0">{ r.Name }</span>
						<span class="text-rw-faint">=</span>
						<span class="flex-1 break-all text-rw-text">{ r.Value }</span>
						if r.Ref {
							@c.Chip("reference", "accent")
						}
						if !v.ReadOnly {
							<button type="button" class="text-rw-faint hover:text-rw-danger shrink-0" aria-label={ "Delete " + r.Name } hx-post={ v.Base + "/env?open=variables" } hx-vals={ dropVals(r.Name) } hx-target={ "#" + Root } hx-swap="outerHTML">×</button>
						}
					</li>
				}
			</ul>
		}
		if !v.ReadOnly {
			<details class="group/edit mt-4" open?={ c.Kept(ctx, "env", "") != "" }>
				<summary class="btn btn-ghost btn-sm cursor-pointer list-none select-none group-open/edit:hidden">Edit variables</summary>
				<form novalidate hx-post={ v.Base + "/env?open=variables" } hx-target={ "#" + Root } hx-swap="outerHTML" class="space-y-4">
					<div>
						<label class="label" for="env-text">Variables</label>
						<textarea id="env-text" name="env" rows="10" placeholder={ "KEY=value\nAPI=${{ tile.api.url }}" } class="input font-mono text-sm">{ c.Kept(ctx, "env", e.Text) }</textarea>
						if len(e.Kept) > 0 {
							<p class="settings-help">Kept as they are, a value on more than one line: { strings.Join(e.Kept, ", ") }.</p>
						}
					</div>
					<div class="flex gap-2">
						<button type="submit" class="btn btn-primary">Save variables</button>
						<button type="button" class="btn btn-ghost" hx-get={ v.Base + "?tab=settings&open=variables" } hx-target={ "#" + Root } hx-swap="outerHTML">Cancel</button>
					</div>
				</form>
			</details>
		}
	</div>
}

// Access is the Database access row: each slice_access entry's
// access saves with its Save, its × drops it (the slice's default applies);
// bindings are the creds the tile holds.
templ Access(v View, a AccessView) {
	<div id="tab-access">
		@c.PanelSection("access-entries", "Slice access", "What this tile gets on each slice it names. A slice it only refs gets that slice's default access.") {
			if len(a.Entries) == 0 {
				<p class="text-sm text-rw-muted">No slice named yet.</p>
			} else {
				<ul class="space-y-1.5">
					for _, e := range a.Entries {
						<li class="panel px-4 py-2.5 flex items-center gap-3 text-sm" data-field data-changed>
							<span class="flex-1 font-mono">
								@sliceLink(e.Slice, e.Link)
							</span>
							<form novalidate hx-post={ v.Base + "/access?open=dbaccess" } hx-target={ "#" + Root } hx-swap="outerHTML" class="flex items-center gap-2">
								<input type="hidden" name="slice" value={ e.Slice }/>
								<label for={ "access-entry-" + e.Slice } class="sr-only">{ e.Slice } access</label>
								@accessSelect("access-entry-"+e.Slice, e.Access)
								<button type="submit" class="btn btn-ghost btn-sm">Save</button>
							</form>
							<form novalidate hx-post={ v.Base + "/access?open=dbaccess" } hx-target={ "#" + Root } hx-swap="outerHTML">
								<input type="hidden" name="slice" value={ e.Slice }/>
								<input type="hidden" name="access" value="default"/>
								<button type="submit" class="text-rw-faint hover:text-rw-danger" title="Use default" aria-label={ "Use the default access on " + e.Slice }>×</button>
							</form>
						</li>
					}
				</ul>
			}
		}
		@c.PanelSection("access-bindings", "Bindings", "") {
			@c.Table(c.TableView{
				Headers:   []string{"Slice", "Access", "User", "Since"},
				Rows:      bindingRows(a),
				EmptyText: "No cred yet: the tile binds at its next deploy.",
			})
		}
		@c.PanelSection("access-add", "Add access", "") {
			if len(a.Slices) == 0 {
				if len(a.Entries) > 0 {
					<p class="text-sm text-rw-muted">Every slice here has its access set.</p>
				} else {
					<p class="text-sm text-rw-muted">No slice tile in this environment yet.</p>
				}
			} else {
				<form novalidate hx-post={ v.Base + "/access?open=dbaccess" } hx-target={ "#" + Root } hx-swap="outerHTML" class="flex flex-wrap items-end gap-2">
					<div class="flex-1 min-w-32">
						<label for="access-slice" class="label">Slice</label>
						<select id="access-slice" name="slice" class="input">
							for _, s := range a.Slices {
								<option value={ s }>{ s }</option>
							}
						</select>
					</div>
					<div>
						<label for="access-new" class="label">Access</label>
						@accessSelect("access-new", "write")
					</div>
					<button type="submit" class="btn btn-ghost btn-sm">Add</button>
				</form>
			}
		}
	</div>
}

templ accessSelect(id, cur string) {
	<select id={ id } name="access" class="input w-auto">
		<option value="read" selected?={ cur == "read" }>read</option>
		<option value="write" selected?={ cur != "read" }>write</option>
	</select>
}

templ sliceLink(slug, href string) {
	if href == "" {
		<span class="text-rw-muted">{ slug }</span>
	} else {
		<a href={ templ.SafeURL(href) } class="text-rw-accentHi hover:underline">{ slug }</a>
	}
}

func bindingRows(a AccessView) [][]templ.Component {
	rows := make([][]templ.Component, 0, len(a.Bindings))
	for _, b := range a.Bindings {
		rows = append(rows, []templ.Component{
			sliceLink(b.Slice, b.Link),
			c.Text(b.Access),
			c.Text(b.User),
			c.When(b.Since),
		})
	}
	return rows
}

func dropVals(name string) string {
	return `{"drop":"` + name + `"}`
}

// Runs is v0's runs list: a <details> row per run, the log behind it.
templ Runs(v View, r RunsView) {
	<div class="space-y-3" id="tab-runs">
		if r.Poll != "" {
			<span hidden hx-get={ r.Poll } hx-trigger="every 2s" hx-target={ "#" + Root } hx-swap="outerHTML"></span>
		}
		if !r.Next.IsZero() {
			<p class="text-xs text-rw-faint">
				{ "next run " }
				@c.When(r.Next)
			</p>
		}
		if len(r.Rows) == 0 {
			<p class="text-rw-muted text-sm">No runs yet.</p>
		} else {
			<ul class="space-y-1.5">
				for _, x := range r.Rows {
					<li class="panel px-4 py-2.5">
						<details id={ "run-" + x.ID }>
							<summary class="flex items-center gap-3 text-sm cursor-pointer list-none">
								<span class={ "shrink-0", runTone(x) }>{ runWord(x) }</span>
								<span class="text-rw-faint text-xs font-mono">{ shortID(x.ID) }</span>
								<span class="text-rw-faint text-xs">@c.When(x.Started)
</span>
								<span class="text-rw-muted text-xs">{ x.Trigger }</span>
								<span class="text-rw-faint text-xs ml-auto">{ x.Took }</span>
								if x.Mem != "" {
									<span class="text-rw-faint text-xs">{ x.Mem } peak</span>
								}
								if x.CPU != "" {
									<span class="text-rw-faint text-xs">{ x.CPU } cpu</span>
								}
							</summary>
							<div class="mt-2 flex items-center gap-3 text-xs text-rw-faint">
								if x.Exit != "" {
									<span>exit { x.Exit }</span>
								}
								@tabLink(v, "logs&run="+x.ID, "Open the log")
								if x.Live {
									@c.PostButton("Stop", v.Base+"/runs/"+x.ID+"/stop")
								}
							</div>
						</details>
					</li>
				}
			</ul>
			@c.ZoneNote()
		}
	</div>
}

func runWord(x RunRow) string {
	if x.Live {
		return "running"
	}
	return x.Status
}

// runTone is v0's run word colour: live amber, ok green, a stop faint.
func runTone(x RunRow) string {
	switch {
	case x.Live:
		return "text-rw-warn"
	case x.Status == "ok":
		return "text-rw-success"
	case x.Status == "cancelled", x.Status == "skipped":
		return "text-rw-faint"
	}
	return "text-rw-danger"
}

func shortID(id string) string {
	if len(id) > 8 {
		return id[:8]
	}
	return id
}

// volumes are the tile's volumes, each opening its drawer's Backups tab.
templ volumes(rows []VolumeRow) {
	<div class="space-y-2">
		<p class="label">Volume backups</p>
		<ul class="space-y-2">
			for _, r := range rows {
				<li class="panel px-4 py-3 flex items-center gap-3 text-sm">
					<a
						href={ templ.SafeURL("?drawer=" + r.ID + "&tab=backups") }
						hx-get={ r.Drawer }
						hx-target="#drawer-body"
						hx-push-url={ "?drawer=" + r.ID + "&tab=backups" }
						class="link font-mono"
					>{ r.Name }</a>
					<span class="ml-auto text-xs text-rw-faint">{ r.State }</span>
				</li>
			}
		</ul>
	</div>
}

// Settings is the tab: one accordion row per group, each its own Save.
templ Settings(v View, s SettingsView) {
	<div id="tab-settings">
		@c.SettingsAccordion(c.SettingsAcc{ID: "tile-settings", Rows: settingsRows(v, s), Open: s.Open, Refresh: v.Base + "?tab=settings"})
	</div>
}

// rowForm is one row's own form: it posts only its keys, so the others
// keep their stored values, and the answer keeps the row open. A reader
// gets the fields disabled, no form and no Save.
templ rowForm(v View, s SettingsView, row string, keys []string) {
	if v.ReadOnly {
		<fieldset disabled class="space-y-4">
			{ children... }
		</fieldset>
	} else {
		<form novalidate hx-post={ v.Base + "/settings?open=" + row } hx-target={ "#" + Root } hx-swap="outerHTML" class="space-y-4">
			<input type="hidden" name="fields" value={ s.Keys(keys...) }/>
			{ children... }
			<button type="submit" class="btn btn-primary btn-sm">Save</button>
		</form>
	}
}

// advanced folds a row's rare fields, open when one of them is set.
templ advanced(open bool) {
	<details class="text-sm" open?={ open }>
		<summary class="cursor-pointer text-rw-muted select-none">Show advanced</summary>
		<div class="space-y-4 mt-3">
			{ children... }
		</div>
	</details>
}

templ general(v View, s SettingsView) {
	if v.ReadOnly {
		<fieldset disabled>
			@generalFields(s)
		</fieldset>
	} else {
		<form novalidate hx-post={ v.Base + "/rename?open=general" } hx-target={ "#" + Root } hx-swap="outerHTML" class="space-y-4">
			@generalFields(s)
			<button type="submit" class="btn btn-primary btn-sm">Save</button>
		</form>
	}
}

templ generalFields(s SettingsView) {
	<div class="grid grid-cols-2 gap-4">
		<div data-field>
			<label class="label" for="set-name">Name</label>
			<input type="text" id="set-name" name="name" value={ c.Kept(ctx, "name", s.Name) } required class="input"/>
			<p class="mt-1.5 text-xs text-rw-faint">A new name changes its URL.</p>
			@c.FieldError("name", c.KeptErr(ctx, "name", ""))
		</div>
		<div data-field>
			<span class="label">Kind</span>
			<p class="text-sm text-rw-text py-2">{ s.Kind }</p>
		</div>
	</div>
}

templ sourceRow(v View, s SettingsView) {
	@rowForm(v, s, "source", sourceKeys) {
		if s.Has("git_url") && s.Has("image") {
			<p class="text-xs text-rw-faint" data-hint>Build from a repo or run an image: set one of the two.</p>
		}
		@text(s, "git_url", "Git URL", "https://git.example.com/owner/repo", "", true)
		@text(s, "branch", "Branch", "main", "", true)
		@text(s, "image", "Image", "nginx:1", "", true)
		@choice(s, "update_policy", "Update policy", []opt{{"manual", "Notify on a new version"}, {"auto", "Deploy new versions"}}, "")
		if s.Has("tag_policy") {
			@advanced(s.Changed("tag_policy")) {
				@text(s, "tag_policy", "Tag policy", "", "Empty watches this tag's digest only.", true)
			}
		}
	}
	if s.Image != nil {
		<div class="space-y-2">
			<p class="label">Image watch</p>
			@image(v, *s.Image)
		</div>
	}
}

templ buildRow(v View, s SettingsView) {
	@rowForm(v, s, "build", buildKeys) {
		<div class="grid grid-cols-2 gap-4">
			@text(s, "dockerfile", "Dockerfile", "Dockerfile", "", true)
			@text(s, "build_context", "Build context", ".", "", true)
		</div>
		@area(s, "watch_paths", "Watch paths", "^apps/web/\n!\\.md$", "Empty deploys on any push.")
		@area(s, "build_args", "Build args", "ARG=value", "")
	}
}

templ scheduleRow(v View, s SettingsView) {
	@rowForm(v, s, "schedule", scheduleKeys) {
		@text(s, "schedule", "Schedule", "0 3 * * *", "Cron, with an optional CRON_TZ= prefix.", true)
		@choice(s, "trigger", "Runs", []opt{{"manual", "manually"}, {"on_deploy", "on every deploy"}}, "")
		@number(s, "timeout_minutes", "Max runtime (minutes)", "30", "1", "")
	}
}

templ runRow(v View, s SettingsView) {
	@rowForm(v, s, "run", runKeys) {
		@text(s, "command", "Command", "", "Overrides the image's command.", true)
		if s.Any("user", "restart_policy") {
			<div class="grid grid-cols-2 gap-4">
				@text(s, "user", "User", "1000:1000", "Empty uses the image's user.", true)
				@choice(s, "restart_policy", "Restart policy", []opt{{"always", "Always"}, {"on-failure", "On failure"}, {"no", "Never"}}, "")
			</div>
		}
		@number(s, "replicas", "Replicas", "1", "1", "A tile with a volume runs one.")
		if s.Any("shm_size_mb", "depends_on") {
			@advanced(s.Changed("shm_size_mb") || s.Changed("depends_on")) {
				@number(s, "shm_size_mb", "Shm size (MB)", "", "1", "Empty uses the default.")
				@area(s, "depends_on", "Depends on", "db:healthy\nmigrate:completed", "A config apply starts these first.")
			}
		}
	}
}

templ networkRow(v View, s SettingsView) {
	if s.Any(networkKeys...) {
		@rowForm(v, s, "network", networkKeys) {
			<div class="grid grid-cols-2 gap-4">
				@number(s, "port", "Container port", "", "1", "")
				@text(s, "endpoint_protocol", "Protocol", "http", "How other tiles reach it: http, https or tcp.", true)
			</div>
		}
	}
	if s.Domains != nil {
		<div class="space-y-3">
			<p class="label">Domains <span class="font-normal text-rw-faint" data-find-skip>saves on its own</span></p>
			@domains(v, *s.Domains)
		</div>
	}
	if s.Placement != "" {
		@placementui.Load(s.Placement)
	}
}

templ storageRow(v View, s SettingsView) {
	@rowForm(v, s, "storage", storageKeys) {
		@area(s, "volumes", "Volumes", "pgdata:/var/lib/postgresql/data", "Add :ro to mount one read-only.")
		@area(s, "files", "Files", "config/loki.yml:/etc/loki/config.yml", "Read-only from the repo; add :template to resolve references.")
	}
	if len(s.Volumes) > 0 {
		@volumes(s.Volumes)
	}
}

templ healthRow(v View, s SettingsView) {
	@rowForm(v, s, "health", healthKeys) {
		@text(s, "health_path", "Health path", "/healthz", "Empty means no check.", true)
		@text(s, "healthcheck_cmd", "Healthcheck command", "curl -f http://localhost:8080/health", "", true)
		<div class="grid grid-cols-4 gap-2">
			@number(s, "healthcheck_interval_s", "Interval (s)", "5", "1", "")
			@number(s, "healthcheck_timeout_s", "Timeout (s)", "30", "1", "")
			@number(s, "healthcheck_retries", "Retries", "3", "1", "")
			@number(s, "healthcheck_start_period_s", "Start period (s)", "0", "1", "")
		</div>
		<p class="text-xs text-rw-faint">A failing check holds a deploy and turns the tile amber.</p>
	}
}

templ resourcesRow(v View, s SettingsView) {
	@rowForm(v, s, "resources", resourceKeys) {
		<div class="grid grid-cols-2 gap-4">
			@number(s, "cpu_limit", "CPU limit (cores)", s.Inherit["cpu_limit"], "any", "")
			@number(s, "mem_limit_mb", "Memory limit (MB)", s.Inherit["mem_limit_mb"], "1", "")
		</div>
		<p class="text-xs text-rw-faint">Empty inherits from the env, stack, org or server.</p>
	}
}

templ hostRow(v View, s SettingsView) {
	@rowForm(v, s, "host", hostKeys) {
		<p class="text-xs text-rw-faint">A server admin approves these before the deploy goes on.</p>
		@check(s, "privileged", "Privileged", "can do anything root on the host can")
		@area(s, "devices", "Devices", "/dev/kmsg", "")
		@area(s, "lan", "LAN access", "192.168.1.10:8123", "An address, a range or all.")
		@area(s, "published_ports", "Server ports", "8443:8443", "Bypasses the proxy.")
		@check(s, "host_network", "Host network", "uses the server's network, no isolation; one replica")
	}
}

templ deleteRow(v View) {
	@c.DangerZone("Deleting this tile removes its containers, its domains and its run history.", v.Name, "Its volumes are kept, orphaned for the retention window.") {
		@c.Confirm(deleteConfirm(v))
	}
}

func deleteConfirm(v View) c.ConfirmView {
	d := dialog.Delete(v.Name, v.Base+"/delete", "#"+Root)
	d.Button = "Delete tile"
	return d
}

// opt is one choice of a select: the value posted, the words shown.
type opt struct{ v, l string }

// text, number, area, choice and check are one field: the label with its
// changed and from marks, the control, a hint, the refusal under it. A
// key the kind does not carry draws nothing.
templ text(s SettingsView, key, label, placeholder, hint string, mono bool) {
	if s.Has(key) {
		<div data-field data-changed?={ s.Changed(key) }>
			@fieldLabel(s, key, label)
			<input type="text" id={ "set-" + key } name={ key } value={ s.kept(ctx, key) } placeholder={ placeholder } class={ "input", templ.KV("font-mono", mono) }/>
			@fieldFoot(s, key, hint)
		</div>
	}
}

templ number(s SettingsView, key, label, placeholder, step, hint string) {
	if s.Has(key) {
		<div data-field data-changed?={ s.Changed(key) }>
			@fieldLabel(s, key, label)
			<input type="number" id={ "set-" + key } name={ key } value={ s.kept(ctx, key) } placeholder={ placeholder } step={ step } min="0" class="input"/>
			@fieldFoot(s, key, hint)
		</div>
	}
}

templ area(s SettingsView, key, label, placeholder, hint string) {
	if s.Has(key) {
		<div data-field data-changed?={ s.Changed(key) }>
			@fieldLabel(s, key, label)
			<textarea id={ "set-" + key } name={ key } rows="2" placeholder={ placeholder } class="input font-mono text-sm">{ s.kept(ctx, key) }</textarea>
			@fieldFoot(s, key, hint)
		</div>
	}
}

templ choice(s SettingsView, key, label string, opts []opt, hint string) {
	if s.Has(key) {
		<div data-field data-changed?={ s.Changed(key) }>
			@fieldLabel(s, key, label)
			<select id={ "set-" + key } name={ key } class="input">
				for _, o := range opts {
					<option value={ o.v } selected?={ o.v == cmp.Or(s.kept(ctx, key), defaults[key]) }>{ o.l }</option>
				}
			</select>
			@fieldFoot(s, key, hint)
		</div>
	}
}

templ check(s SettingsView, key, label, warn string) {
	if s.Has(key) {
		<div data-field data-changed?={ s.Changed(key) }>
			<label class="text-sm flex items-center gap-2">
				<input type="checkbox" name={ key } value="1" checked?={ s.on(ctx, key) } class="accent-rw-accent"/>
				<span>{ label }</span>
				@c.FieldMarks(s.Changed(key), "")
				<span class="text-xs text-rw-danger" data-find-skip>{ warn }</span>
			</label>
			@c.FieldError(key, keptErr(ctx, key))
		</div>
	}
}

templ fieldLabel(s SettingsView, key, label string) {
	<label class="label" for={ "set-" + key }>
		{ label }
		@c.FieldMarks(s.Changed(key), s.From[key])
	</label>
}

templ fieldFoot(s SettingsView, key, hint string) {
	if hint != "" {
		<p class="mt-1.5 text-xs text-rw-faint" data-hint>{ hint }</p>
	}
	@c.FieldError(key, keptErr(ctx, key))
}

// domains is v0's domainsSection: "+ Add domain" folded (a literal host, or
// the auto one under the nearest domain resource), then a panel row per
// host with its Remove (and an admin's raw Caddy route).
templ domains(v View, d DomainsView) {
	if !v.ReadOnly {
		@addDomain(v, d)
	}
	@domainList(v, d)
}

templ addDomain(v View, d DomainsView) {
	<details class="mb-4" open?={ d.Replace != nil || d.Kept != nil }>
		<summary class="btn btn-ghost btn-sm cursor-pointer inline-flex items-center gap-1.5 select-none list-none">
			<span class="text-rw-accentHi">+</span> Add domain
		</summary>
		<form novalidate hx-post={ v.Base + "/domains?open=network" } hx-target={ "#" + Root } hx-swap="outerHTML" class="group/dom space-y-3 mt-3" oninput="var f=this,h=(f.domain&&f.domain.value)?((f.sub.value.trim()?f.sub.value.trim()+'.':'')+f.domain.value):f.host.value.trim();var m=f.querySelector('[data-dom]');if(m&&f.domain.value)m.textContent=f.domain.value;f.querySelector('[data-preview]').textContent='http'+(f.https.checked?'s':'')+'://'+h">
			<div class="flex flex-wrap gap-2 items-center">
				if len(d.Managed) > 0 {
					<input type="text" name="sub" value={ d.typed("sub") } aria-label="Subdomain" placeholder="subdomain" class="input !w-32 group-has-[.dns-other:checked]/dom:hidden"/>
					<span class="text-rw-faint group-has-[.dns-other:checked]/dom:hidden" aria-hidden="true">.</span>
					<select name="domain" aria-label="Domain" title="stackr sets the DNS of these domains" class="input !w-auto">
						for _, m := range d.Managed {
							<option value={ m } selected?={ d.typed("domain") == m }>{ m }</option>
						}
						<option value="" class="dns-other" selected?={ (d.Replace != nil || d.Kept != nil) && d.typed("domain") == "" }>Other (I'll set DNS myself)</option>
					</select>
					<input type="text" name="host" value={ d.typed("host") } aria-label="Host" placeholder="app.example.com" class="input !w-56 hidden group-has-[.dns-other:checked]/dom:block"/>
				} else {
					<input type="text" name="host" value={ d.typed("host") } aria-label="Host" placeholder="app.example.com" required class="input !w-56"/>
				}
				<input type="number" name="port" value={ cmp.Or(d.typed("port"), d.Port) } aria-label="Container port" placeholder="port" min="1" max="65535" class="input !w-24"/>
			</div>
			<p class="text-sm text-rw-muted">
				<span data-preview class="font-mono text-rw-text">{ d.preview() }</span>
				if len(d.Managed) > 0 {
					<span class="block text-xs text-rw-faint group-has-[.dns-other:checked]/dom:hidden">Leave empty to use <b data-dom class="font-normal">{ d.Managed[0] }</b> itself.</span>
				}
			</p>
			<details class="text-sm" open?={ d.typed("path") != "" || d.typed("redirect_to") != "" || d.typed("forward_auth") != "" }>
				<summary class="cursor-pointer text-rw-muted select-none">More</summary>
				<div class="flex flex-wrap gap-2 mt-2 items-center">
					<input type="text" name="path" value={ d.typed("path") } aria-label="Path prefix" placeholder="/ (path prefix)" title="Route only requests under this path prefix to this tile" class="input !w-32"/>
					<input type="text" name="redirect_to" value={ d.typed("redirect_to") } aria-label="Redirect to" placeholder="redirect to (optional)" title="Requests to this host get a 301 to the given host instead of being served" class="input !w-48"/>
					<input type="url" name="forward_auth" value={ d.typed("forward_auth") } aria-label="Forward auth URL" placeholder="forward auth URL (optional)" title="Each request is checked against this URL first; 2xx lets it through" class="input !w-56"/>
					<label class="text-sm text-rw-muted flex items-center gap-1.5">
						<input type="checkbox" name="https" value="1" checked?={ (d.Replace == nil && d.Kept == nil) || d.typed("https") != "" } class="accent-rw-accent"/> HTTPS
					</label>
				</div>
			</details>
			<button type="submit" class="btn btn-primary">Add</button>
		</form>
		if d.Replace != nil && !d.Replace.Adopt {
			<p class="mt-2 text-sm text-rw-muted">{ d.Replace.Host } already has a DNS record.</p>
		}
		<form novalidate hx-post={ v.Base + "/domains?open=network" } hx-target={ "#" + Root } hx-swap="outerHTML" class="mt-2">
			<input type="hidden" name="auto" value="1"/>
			<button type="submit" class="btn btn-ghost btn-sm" title="Generate a hostname under the nearest domain resource (stack, organization, or server)">
				Use the generated name
				if d.AutoHost != "" {
					<span class="font-mono ml-1">{ d.AutoHost }</span>
				}
			</button>
		</form>
	</details>
	if d.Replace != nil && d.Replace.Adopt {
		@c.Confirm(c.ConfirmView{
			Open:    true,
			Button:  "Manage it",
			Title:   d.Replace.Host + " already points at your node. Let stackr manage it?",
			Warning: "Stackr keeps the record pointed at your node from now on.",
			Action:  v.Base + "/domains?open=network",
			Target:  "#" + Root,
			Vals:    d.Replace.Vals,
		})
	} else if d.Replace != nil {
		@c.Confirm(c.ConfirmView{
			Open:    true,
			Button:  "Replace it",
			Title:   "Replace the DNS record of " + d.Replace.Host + "?",
			Warning: d.Replace.Host + " already has a DNS record stackr did not create. Replace it to point it here; stackr then manages it.",
			Action:  v.Base + "/domains?open=network",
			Target:  "#" + Root,
			Vals:    d.Replace.Vals,
		})
	}
	if d.NoIP != nil {
		<p class="banner banner-danger mb-4" role="alert">
			Node { d.NoIP.Node } has no public IP address for DNS records.
			if d.NoIP.Link != "" {
				<a href={ templ.SafeURL(d.NoIP.Link) } class="underline hover:text-rw-text">Set one on its Network tab.</a>
			} else {
				A server admin sets one on the node.
			}
		</p>
	}
}

templ domainList(v View, d DomainsView) {
	if len(d.Rows) == 0 {
		<p class="text-rw-muted text-sm">No domains yet.</p>
	} else {
		<ul class="space-y-2">
			for _, r := range d.Rows {
				<li class="panel px-4 py-3" data-field data-changed>
					<div class="flex flex-wrap items-center justify-between gap-2">
						<span class="text-sm text-rw-text min-w-0">
							<a href={ templ.SafeURL(scheme(r.HTTPS) + r.Host) } target="_blank" rel="noopener" class="hover:underline hover:text-rw-accentHi transition-colors">{ scheme(r.HTTPS) + r.Host }</a>
							if r.Path != "" && r.Path != "/" {
								<span class="font-mono text-rw-faint">{ r.Path }</span>
							}
							if r.Redirect != "" {
								<span class="text-rw-faint">{ r.RedirectCode() } → { r.Redirect }</span>
							} else {
								<span class="text-rw-faint">→ :{ r.Port }</span>
							}
							if r.Auto {
								<span class="text-xs text-rw-faint ml-1">generated</span>
							}
						</span>
						if !v.ReadOnly {
							<span class="flex items-center gap-2 shrink-0 ml-auto">
								@c.Confirm(c.ConfirmView{
									Button:  "Remove",
									Title:   "Remove " + r.Host + "?",
									Warning: "The proxy stops routing it.",
									Action:  v.Base + "/domains/" + r.ID + "/detach?open=network",
									Target:  "#" + Root,
								})
							</span>
						}
					</div>
					if d.Admin && !v.ReadOnly {
						<details class="mt-1" open?={ r.Raw != "" }>
							<summary class="text-xs text-rw-faint hover:text-rw-text cursor-pointer select-none">Raw Caddy route (admin)</summary>
							<form novalidate hx-post={ v.Base + "/domains/" + r.ID + "/raw?open=network" } hx-target={ "#" + Root } hx-swap="outerHTML" class="space-y-2 mt-2">
								<label class="settings-help" for={ "raw-" + r.ID }>Replaces the generated route verbatim (empty = generated).</label>
								<textarea id={ "raw-" + r.ID } name="raw_caddy" rows="3" class="input font-mono text-xs">{ r.Raw }</textarea>
								<button type="submit" class="btn btn-primary btn-sm">Save</button>
							</form>
						</details>
					}
				</li>
			}
		</ul>
	}
}

// image is what the registry watcher knows of the tile's image.
templ image(v View, i ImageView) {
	<div class="panel p-4 space-y-3">
		<dl class="grid grid-cols-[8rem_minmax(0,1fr)] [&>dd]:[overflow-wrap:anywhere] gap-x-3 gap-y-1.5 text-sm">
			<dt class="text-rw-faint">Image</dt>
			<dd class="truncate font-mono text-rw-text">{ i.Ref }</dd>
			<dt class="text-rw-faint">Running digest</dt>
			<dd class="truncate font-mono text-rw-text" title={ i.Digest }>{ orNone(shortDigest(i.Digest)) }</dd>
			<dt class="text-rw-faint">Latest seen</dt>
			<dd class="truncate font-mono text-rw-text" title={ i.LastDigest }>{ orNone(shortDigest(i.LastDigest)) } { i.LastTag }</dd>
			<dt class="text-rw-faint">Checked</dt>
			<dd class="text-rw-text">
				if i.Checked.IsZero() {
					none
				} else {
					@c.When(i.Checked)
				}
			</dd>
		</dl>
		if i.LastError != "" {
			<p class="text-xs text-rw-danger">{ i.LastError }</p>
		}
		if !v.ReadOnly {
			@c.PostButton("Check now", v.Base+"/image/check?open=source")
		}
	</div>
}

func orNone(s string) string {
	if s == "" {
		return "none"
	}
	return s
}
