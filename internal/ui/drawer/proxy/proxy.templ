// Package proxy is the proxy card's drawer: one tab, the env's routes.
package proxy

import c "github.com/FyrmForge/stackr/internal/ui/components"

// View is the routes; Live is the URL that redraws them, "" in a test.
type View struct {
	Rows []Route
	Live string
}

type Route struct {
	Host, Path, Tile, Port string
	HTTPS, Auto, Raw       bool
	Gate, Lock             string // basic-auth user; why the address is locked
	Cert                   c.CertView
}

templ Routes(v View) {
	@c.Drawer(c.DrawerView{Title: "Proxy", Kind: "caddy", Icon: "proxy"}, routes(v))
}

templ routes(v View) {
	@c.Section("Routes", "env", "Every host this environment's tiles answer on. Add or change one in the tile's Settings.") {
		if len(v.Rows) == 0 {
			<p class="text-sm text-rw-muted">No tile in this env has a domain.</p>
		}
		<div id="proxy-routes">
		if v.Live != "" {
			@c.LiveTab(v.Live, "proxy-routes")
		}
		<ul class="divide-y divide-rw-border">
			for _, r := range v.Rows {
				<li class="flex flex-wrap items-center gap-2 py-2.5 text-sm">
					<span class="font-mono text-rw-text">{ r.Host }{ r.Path }</span>
					<span class="text-rw-muted">→ { r.Tile }:{ r.Port }</span>
					<span class="ml-auto flex items-center gap-1.5">
						if r.HTTPS {
							@c.Chip("https", "accent")
						} else {
							@c.Chip("http only", "warn")
						}
						if r.Auto {
							@c.Chip("generated", "")
						}
						if r.Raw {
							@c.Chip("raw Caddy", "")
						}
						if r.Lock != "" {
							@c.Chip("locked", "danger")
						} else if r.Gate != "" {
							@c.Chip("gate: "+r.Gate, "")
						}
					</span>
					if r.Lock != "" {
						<span class="w-full text-xs text-rw-danger">Locked for everyone: { r.Lock }.</span>
					}
					if r.HTTPS {
						<div class="w-full">@c.Cert(r.Cert)</div>
					}
				</li>
			}
		</ul>
		</div>
	}
}
