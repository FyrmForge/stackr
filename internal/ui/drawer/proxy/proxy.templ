// Package proxy is the proxy card's drawer: one tab, the env's routes.
package proxy

import c "github.com/FyrmForge/stackr/internal/ui/components"

type View struct{ Rows []Route }

type Route struct {
	Host, Path, Tile, Port string
	HTTPS, Auto, Raw       bool
}

templ Routes(v View) {
	@c.Drawer(c.DrawerView{Title: "Proxy", Kind: "caddy", Icon: "proxy"}, routes(v))
}

templ routes(v View) {
	@c.Section("Routes", "env", "Every host this environment's tiles answer on. Add or change one in the tile's Settings.") {
		if len(v.Rows) == 0 {
			<p class="text-sm text-rw-muted">No tile in this env has a domain.</p>
		}
		<ul class="space-y-2">
			for _, r := range v.Rows {
				<li class="flex flex-wrap items-center gap-2 rounded-lg border border-rw-border px-3 py-2.5 text-sm">
					<span class="font-mono text-rw-text">{ r.Host }{ r.Path }</span>
					<span class="text-rw-muted">→ { r.Tile }:{ r.Port }</span>
					<span class="ml-auto flex items-center gap-1.5">
						if r.HTTPS {
							@c.Chip("https", "accent")
						} else {
							@c.Chip("http only", "warn")
						}
						if r.Auto {
							@c.Chip("generated", "")
						}
						if r.Raw {
							@c.Chip("raw Caddy", "")
						}
					</span>
				</li>
			}
		</ul>
	}
}
