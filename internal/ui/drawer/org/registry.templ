package org

import (
	"time"

	c "github.com/FyrmForge/stackr/internal/ui/components"
)

// RegistryView is the Registry tab: how to log in and push, then the org's
// repositories, or with Repo set that repository's versions. Host "" = no
// panel domain is set, so there is no registry address to show. Err is the
// registry's own failure text.
type RegistryView struct {
	Host  string
	Org   string
	Repos []RepoRow
	Err   string

	// Repo is the repository open; Back returns to the list.
	Repo     string
	Back     string
	Versions []VersionRow
}

// RepoRow is one repository; Latest is its newest tag, "" when unknown,
// pushed at LatestAt. Open is the GET that shows its versions.
type RepoRow struct {
	Name, Tags, Latest, Size, Open string
	LatestAt                       time.Time
}

// VersionRow is one version. UsedBy names the envs that run it. Delete.Action
// is "" when the viewer may not delete.
type VersionRow struct {
	Tag, Size, Platforms, Source string
	Arrived                      time.Time // zero = unknown
	UsedBy                       []string
	Delete                                c.ConfirmView
}

templ Registry(v RegistryView) {
	<div id="tab-registry">
		if v.Repo != "" {
			@registryVersions(v)
		} else {
			@registryRepos(v)
		}
	</div>
}

templ registryRepos(v RegistryView) {
	<div>
		<p class="text-xs text-rw-faint mb-3" data-hint>Push your own images to a repository here and deploy them as tiles.</p>
		if v.Host == "" {
			<p class="text-sm text-rw-faint">Set the panel domain first: the registry lives at registry.&lt;panel domain&gt;.</p>
		} else {
			<pre class="panel overflow-x-auto px-4 py-3 font-mono text-xs text-rw-text">{ "$ stackr registry login\n$ docker push " + v.Host + "/" + v.Org + "/<stack>/<tile>:<tag>" }</pre>
			<p class="mt-2 text-xs text-rw-faint">Tokens last 12 hours. Members can pull; owners can push.</p>
		}
	</div>
	<div class="mt-5">
		<h3 class="text-sm font-semibold text-rw-text mb-2">Repositories</h3>
		if v.Err != "" {
			<p class="text-sm text-rw-warn">{ v.Err }</p>
		} else if len(v.Repos) == 0 {
			<p class="text-sm text-rw-faint">No images yet.</p>
		} else {
			<div class="overflow-x-auto">
				<table class="w-full text-left text-sm">
					<thead class="text-xs text-rw-faint">
						<tr>
							<th class="pb-2 pr-3 font-normal">Repository</th>
							<th class="pb-2 pr-3 font-normal">Tags</th>
							<th class="pb-2 pr-3 font-normal hidden sm:table-cell">Latest</th>
							<th class="pb-2 text-right font-normal">Size</th>
						</tr>
					</thead>
					<tbody>
						for _, r := range v.Repos {
							<tr class="border-t border-rw-border hover:bg-rw-surface">
								<td class="py-2 pr-3 font-mono text-rw-text break-all"><button type="button" class="font-mono text-left hover:underline" hx-get={ r.Open } hx-target={ target() } hx-swap="outerHTML">{ r.Name }</button></td>
								<td class="py-2 pr-3 text-rw-muted">{ r.Tags }</td>
								<td class="py-2 pr-3 font-mono text-xs text-rw-muted hidden sm:table-cell">
									if r.Latest != "" {
										{ r.Latest + " · " }
										@c.When(r.LatestAt)
									}
								</td>
								<td class="py-2 text-right text-rw-muted whitespace-nowrap">{ r.Size }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

templ registryVersions(v RegistryView) {
	<button type="button" hx-get={ v.Back } hx-target={ target() } hx-swap="outerHTML" class="text-xs text-rw-accent hover:underline mb-3">Back to repositories</button>
	<div>
		<h3 class="text-sm font-semibold text-rw-text mb-1">{ v.Repo }</h3>
		<p class="text-xs text-rw-faint mb-3">Deleting a version removes every tag on it.</p>
		if v.Err != "" {
			<p class="text-sm text-rw-warn">{ v.Err }</p>
		} else if len(v.Versions) == 0 {
			<p class="text-sm text-rw-faint">No versions.</p>
		} else {
			<ul class="space-y-2">
				for _, r := range v.Versions {
					<li class="panel px-4 py-3 text-sm flex flex-wrap items-center gap-x-3 gap-y-1">
						<span class="font-mono text-rw-text">{ r.Tag }</span>
						<span class="text-rw-muted">{ r.Size }</span>
						<span class="text-xs text-rw-faint">{ r.Platforms }</span>
						<span class="text-xs text-rw-faint">@c.When(r.Arrived)</span>
						<span class="text-xs text-rw-muted">{ r.Source }</span>
						if len(r.UsedBy) == 0 {
							<span class="text-xs text-rw-faint">Not in use</span>
						} else {
							<span class="flex flex-wrap gap-1">
								for _, e := range r.UsedBy {
									@c.Chip(e, "accent")
								}
							</span>
						}
						if r.Delete.Action != "" {
							<span class="ml-auto">
								@c.Confirm(r.Delete)
							</span>
						}
					</li>
				}
			</ul>
		}
	</div>
}
