package org

import c "github.com/FyrmForge/stackr/internal/ui/components"

// RegistryView is the Registry tab: how to log in and push, then the org's
// repositories. Host "" = no panel domain is set, so there is no registry
// address to show. Err is the registry's own failure text.
type RegistryView struct {
	Host  string
	Org   string
	Repos []RepoRow
	Err   string
}

// RepoRow is one repository; Latest is "tag · when", "" when unknown.
type RepoRow struct{ Name, Tags, Latest, Size string }

templ Registry(v RegistryView) {
	<div id="tab-registry">
		@c.Section("Registry", "organization", "Push your own images and deploy them as tiles.") {
			if v.Host == "" {
				<p class="text-sm text-rw-faint">Set the panel domain first: the registry lives at registry.&lt;panel domain&gt;.</p>
			} else {
				<pre class="panel overflow-x-auto px-4 py-3 font-mono text-xs text-rw-text">$ stackr registry login
$ docker push { v.Host }/{ v.Org }/&lt;stack&gt;/&lt;tile&gt;:&lt;tag&gt;</pre>
				<p class="mt-2 text-xs text-rw-faint">Tokens last 12 hours. Members can pull; owners can push.</p>
			}
		}
		@c.Section("Repositories", "organization", "") {
			if v.Err != "" {
				<p class="text-sm text-rw-warn">{ v.Err }</p>
			} else if len(v.Repos) == 0 {
				<p class="text-sm text-rw-faint">No images pushed yet.</p>
			} else {
				<table class="w-full text-left text-sm">
					<thead class="text-xs text-rw-faint">
						<tr>
							<th class="pb-2 font-normal">Repository</th>
							<th class="pb-2 font-normal">Tags</th>
							<th class="pb-2 font-normal">Latest</th>
							<th class="pb-2 text-right font-normal">Size</th>
						</tr>
					</thead>
					<tbody>
						for _, r := range v.Repos {
							<tr class="border-t border-rw-border">
								<td class="py-2 font-mono text-rw-text">{ r.Name }</td>
								<td class="py-2 text-rw-muted">{ r.Tags }</td>
								<td class="py-2 font-mono text-xs text-rw-muted">{ r.Latest }</td>
								<td class="py-2 text-right text-rw-muted">{ r.Size }</td>
							</tr>
						}
					</tbody>
				</table>
			}
		}
	</div>
}
