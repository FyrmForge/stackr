// Package org is the org card's drawer tabs (home canvas): settings,
// members + invites, keys, domains, backups, config, drawn as v0's
// organization settings.
// Params is the vars editor, composed by the handler. Each tab is drawn
// inside components.Drawer.
package org

import (
	"strconv"

	c "github.com/FyrmForge/stackr/internal/ui/components"
)

// Tabs in strip order.
var Tabs = []string{"settings", "members", "keys", "params", "domains", "backups", "config"}

// Roles an owner can give.
var Roles = []string{"owner", "member", "viewer"}

type SettingsView struct {
	Name    string
	Slug    string
	Rename  string // POST name; "" = not an owner
	Cascade c.SettingsFormView
	Stacks  int           // a delete is refused while any remain
	Delete  c.ConfirmView // shown when Rename is set
}

type MembersView struct {
	Base    string // actions: /invite, /members/<user>/role, /members/<user>/remove
	Manage  bool   // member.manage: change roles, remove, invite
	Self    string // the viewer's user id: no role change or remove on their own row
	Members []MemberRow
	Invites []InviteRow
}

type MemberRow struct{ UserID, Name, Email, Role string }

type InviteRow struct{ Email, Role, Expires string }

type KeysView struct {
	Base string // POST /keys (name), /keys/<id>/revoke
	Keys []KeyRow
}

type KeyRow struct{ ID, Name, Created string }

// DomainsView is v0's orgDomainsPage: the org's domain resources, then the
// instance's it also names tiles under.
type DomainsView struct {
	Add     string // POST host, include_env_on_default, acme_email; "" = not an owner
	Example string // the help text's host: the org's first, or example.com
	Host    string // the add form's prefill: <slug>.<instance host> while the org has no row
	Rows    []DomainRow
}

type DomainRow struct {
	Host       string
	Level      string // instance | org
	IncludeEnv bool
	ACMEEmail  string
	Delete     c.ConfirmView // Action "" = none (the instance's row, or not an owner)
}

// levelWord is how v0 names a resource's level.
func levelWord(level string) string {
	switch level {
	case "instance":
		return "server"
	case "org":
		return "organization"
	}
	return level
}

// ConfigView is v0's Config as code page as a tab: the export, the
// binding form, the latest plan with its Approve and Reject, the queued
// apply, then the last plans.
type ConfigView struct {
	Base       string // POST /config, /plan; "" = not an owner
	Export     string // GET the stackr-org.yml
	Connectors []Option
	Connector  string
	Repo       string
	Branch     string
	Path       string
	Auto       bool
	Unbind     c.ConfirmView // Action "" = nothing bound, or not an owner
	Job        *c.JobStatusView
	Latest     *PlanBox  // nil = no plan, or the viewer may not read plans
	Plans      []PlanRow // the last plans, newest first
}

type Option struct{ Value, Label string }

// PlanBox is the latest plan: its row, the dry run, and the two answers.
type PlanBox struct {
	Row     PlanRow
	Ask     c.PromoteAsk
	Approve string // POST; "" = not pending, blocked, or not an owner
	Reject  string // POST; "" = not pending, or not an owner
}

type PlanRow struct {
	Status  string
	Summary string
	When    string
	Commit  string // short
	Error   string
}

func target() string { return "#" + c.DrawerRoot }

// planTone is v0's planStatus chip: pending warns, error is danger.
func planTone(status string) string {
	switch status {
	case "pending":
		return "warn"
	case "error":
		return "danger"
	}
	return ""
}

func stacks(n int) string {
	if n == 1 {
		return "1 stack"
	}
	return strconv.Itoa(n) + " stacks"
}

templ Settings(v SettingsView) {
	<div id="tab-settings">
		@c.Section("Organization", "organization", "The name is the slug in every URL below it, so renaming moves them.") {
			<form hx-post={ v.Rename } hx-target={ target() } hx-swap="outerHTML" class="space-y-4">
				@c.Field(c.FieldView{Name: "name", Label: "Name", Value: v.Name, Required: true, Help: "Renaming breaks existing links.", Disabled: v.Rename == "", Why: "Only an owner can rename this organization."})
				if v.Rename != "" {
					<button type="submit" class="btn btn-primary btn-sm">Rename</button>
				}
			</form>
		}
		@c.Section("Resource defaults", "organization", "Applied to every service in this organization that does not set its own. Stacks, environments and services can still override them.") {
			@c.SettingsForm(v.Cascade)
		}
		if v.Rename != "" {
			if v.Stacks > 0 {
				@c.DangerSection("This organization still holds "+stacks(v.Stacks)+". Move or delete them before it can be deleted.", "/"+v.Slug, "")
			} else {
				@c.DangerSection("Deleting this organization removes its members, keys, connectors and params.", "/"+v.Slug, "Backups already in a destination are kept.") {
					@c.Confirm(v.Delete)
				}
			}
		}
	</div>
}

// roleButtons is v0's segmented role picker: three radios as one control.
templ roleButtons(name, picked string) {
	<div class="flex gap-2" role="radiogroup" aria-label="Role">
		for _, r := range Roles {
			<label class="flex-1">
				<input type="radio" name={ name } value={ r } checked?={ r == picked } class="peer sr-only"/>
				<span class="block text-center rounded-lg border border-rw-border bg-rw-inset px-3 py-1.5 text-sm text-rw-muted transition-colors hover:text-rw-text cursor-pointer peer-checked:border-rw-accent peer-checked:bg-rw-accent/10 peer-checked:text-rw-text peer-focus-visible:ring-2 peer-focus-visible:ring-rw-accent/40">{ r }</span>
			</label>
		}
	</div>
}

templ avatar(name string) {
	<span class="flex items-center justify-center rounded bg-rw-inset font-bold uppercase text-rw-accentHi shrink-0 h-8 w-8 text-xs" aria-hidden="true">{ c.Initials(name) }</span>
}

templ Members(v MembersView) {
	<div id="tab-members">
		if v.Manage {
			@c.Section("Add people", "organization", "Everyone gets an invite link to accept, and that link is a credential.") {
				<form hx-post={ v.Base + "/invite" } hx-target={ target() } hx-swap="outerHTML" class="people-add space-y-4">
					<div>
						<label for="people-email" class="label">Email address</label>
						<input id="people-email" name="email" type="email" required placeholder="person@example.com" class="input"/>
						<p class="mt-1.5 text-xs text-rw-faint">They get an invitation to accept. This server sends no mail, so the link is yours to send.</p>
					</div>
					<div>
						<span class="label">Role</span>
						@roleButtons("role", "owner")
					</div>
					<button type="submit" class="btn btn-ghost btn-sm people-add-submit">Add to organization</button>
				</form>
			}
		}
		@c.Section("People", "organization", "Owners manage the organization. Members have full access to its stacks, viewers are read-only.") {
			<ul class="space-y-2">
				for _, m := range v.Members {
					<li class="panel px-3 py-2.5 flex flex-wrap items-center gap-2">
						@avatar(nameOr(m.Name, m.Email))
						<span class="min-w-[12rem] flex-1">
							<span class="block text-sm text-rw-text">{ nameOr(m.Name, m.Email) }</span>
							if m.Name != "" {
								<span class="block text-xs text-rw-muted">{ m.Email }</span>
							}
						</span>
						if v.Manage && m.UserID != v.Self {
							<form hx-post={ v.Base + "/members/" + m.UserID + "/role" } hx-target={ target() } hx-swap="outerHTML" class="flex items-center gap-2">
								<select name="role" class="input !w-24 !py-1 text-xs" aria-label={ "Role of " + m.Email }>
									for _, r := range Roles {
										<option value={ r } selected?={ r == m.Role }>{ r }</option>
									}
								</select>
								<button type="submit" class="btn btn-ghost btn-sm">Set</button>
							</form>
							<button type="button" class="btn btn-danger btn-sm" hx-post={ v.Base + "/members/" + m.UserID + "/remove" } hx-target={ target() } hx-swap="outerHTML">Remove</button>
						} else {
							<span class="text-xs px-1.5 py-0.5 rounded bg-rw-inset text-rw-muted">{ m.Role }</span>
						}
					</li>
				}
				for _, i := range v.Invites {
					<li class="panel px-3 py-2.5 flex flex-wrap items-center gap-2">
						@avatar(i.Email)
						<span class="min-w-[12rem] flex-1">
							<span class="block text-sm text-rw-text">{ i.Email }</span>
							<span class="block text-xs text-rw-warning">Invited, expires { i.Expires }</span>
						</span>
						<span class="text-xs px-1.5 py-0.5 rounded bg-rw-inset text-rw-muted">{ i.Role }</span>
					</li>
				}
			</ul>
		}
	</div>
}

func nameOr(name, email string) string {
	if name != "" {
		return name
	}
	return email
}

templ Keys(v KeysView) {
	<div id="tab-keys">
		@c.Section("Mint a key", "organization", "An API key for the stackr CLI, scoped to this organization. It is shown once, when minted.") {
			<form hx-post={ v.Base + "/keys" } hx-target={ target() } hx-swap="outerHTML" class="space-y-4">
				@c.Field(c.FieldView{Name: "key_name", Label: "Name", Placeholder: "laptop", Required: true})
				<button type="submit" class="btn btn-primary btn-sm">Mint key</button>
			</form>
		}
		@c.Section("Your keys", "organization", "") {
			if len(v.Keys) == 0 {
				<p class="text-sm text-rw-muted">No API keys yet.</p>
			} else {
				<ul class="space-y-2">
					for _, k := range v.Keys {
						<li class="panel px-4 py-3 flex items-center justify-between gap-3">
							<span class="min-w-0">
								<span class="text-sm text-rw-text">{ k.Name }</span>
								<span class="text-rw-faint text-xs">{ k.Created }</span>
							</span>
							<button type="button" class="btn btn-danger btn-sm" hx-post={ v.Base + "/keys/" + k.ID + "/revoke" } hx-target={ target() } hx-swap="outerHTML">Revoke</button>
						</li>
					}
				</ul>
			}
		}
	</div>
}

templ Domains(v DomainsView) {
	<div id="tab-domains">
		@c.Section("Organization domains", "organization", "Every stack in this organization can generate per-environment hostnames under one of these, like app.stack."+v.Example+". Hosts are unique across the whole server.") {
			if len(v.Rows) > 0 {
				<ul class="space-y-2 mb-5">
					for _, r := range v.Rows {
						<li class="panel px-3 py-2.5 flex flex-wrap items-center gap-2">
							<span class="font-mono text-sm text-rw-text">{ r.Host }</span>
							<span class="text-xs px-1.5 py-0.5 rounded bg-rw-inset text-rw-muted">{ levelWord(r.Level) }</span>
							if r.IncludeEnv {
								<span class="text-xs px-1.5 py-0.5 rounded bg-rw-inset text-rw-muted">env slug on default env</span>
							}
							if r.ACMEEmail != "" {
								<span class="text-xs text-rw-faint">ACME { r.ACMEEmail }</span>
							}
							if r.Delete.Action != "" {
								<span class="ml-auto">
									@c.Confirm(r.Delete)
								</span>
							}
						</li>
					}
				</ul>
			} else {
				<p class="text-sm text-rw-faint mb-5">No domains yet.</p>
			}
			if v.Add != "" {
				<form hx-post={ v.Add } hx-target={ target() } hx-swap="outerHTML" class="space-y-4">
					<div>
						<label for="domain-host" class="label">Host</label>
						<input id="domain-host" name="host" type="text" required placeholder="example.com" value={ v.Host } class="input font-mono"/>
						<p class="mt-1.5 text-xs text-rw-faint">A bare lowercase hostname, e.g. example.com.</p>
					</div>
					<label class="flex items-center gap-2 text-sm text-rw-muted cursor-pointer">
						<input type="checkbox" name="include_env_on_default" value="1" class="accent-rw-accent"/>
						Include env slug on default env (api.prod.stack instead of api.stack)
					</label>
					@c.Field(c.FieldView{Name: "acme_email", Label: "ACME email", Type: "email", Placeholder: "ops@example.com", Help: "Certificates under this host are issued on this account. Empty uses the server's."})
					<button type="submit" class="btn btn-primary btn-sm">Add domain</button>
				</form>
			}
		}
	</div>
}

templ Backups(v c.DestsView) {
	<div id="tab-backups">
		@c.Dests(v)
	</div>
}

templ Config(v ConfigView) {
	<div id="tab-config">
		@c.Section("Export", "organization", "This organization's live state as a stackr-org.yml, the way out of panel-first and into config-as-code. Secrets come out as declarations, never values.") {
			<a href={ templ.SafeURL(v.Export) } download="stackr-org.yml" class="btn btn-ghost btn-sm">Download stackr-org.yml</a>
		}
		@c.Section("Config as code", "organization", "One file declares the whole organization. Its plans wait for an owner's approve unless Auto apply is on.") {
			if len(v.Connectors) == 0 && v.Repo == "" {
				<p class="text-sm text-rw-muted">Connect GitHub first. The org file is fetched through a connector.</p>
			} else {
				<form hx-post={ v.Base + "/config" } hx-target={ target() } hx-swap="outerHTML">
					<fieldset disabled?={ v.Base == "" } class="space-y-4">
						<legend class="sr-only">Config repository</legend>
						<div>
							<label for="org-connector" class="label">Connector</label>
							<select id="org-connector" name="connector" class="input">
								<option value="">(unbind)</option>
								for _, o := range v.Connectors {
									<option value={ o.Value } selected?={ o.Value == v.Connector }>{ o.Label }</option>
								}
							</select>
						</div>
						@c.Field(c.FieldView{Name: "repo", Label: "Repository (owner/name)", Value: v.Repo, Placeholder: "you/serverconfig"})
						@c.Field(c.FieldView{Name: "branch", Label: "Branch (empty = default)", Value: v.Branch})
						@c.Field(c.FieldView{Name: "path", Label: "File path (empty = stackr-org.yml)", Value: v.Path})
						<label class="flex items-center gap-2 text-sm text-rw-text"><input type="checkbox" name="auto" value="1" checked?={ v.Auto } class="accent-rw-accent"/> Auto apply a plan with no blocker</label>
						if v.Base != "" {
							<div class="flex flex-wrap items-center gap-2">
								<button type="submit" class="btn btn-primary btn-sm">Save and plan</button>
								if v.Repo != "" {
									<button type="button" class="btn btn-ghost btn-sm" hx-post={ v.Base + "/plan" } hx-target={ target() } hx-swap="outerHTML">Plan now</button>
								}
							</div>
						}
					</fieldset>
				</form>
			}
			if v.Unbind.Action != "" {
				<div class="flex flex-wrap items-center gap-2 mt-5 pt-5 border-t border-rw-border">
					@c.Confirm(v.Unbind)
				</div>
			}
		}
		if v.Job != nil {
			<div class="mb-4">
				@c.JobStatus(*v.Job)
			</div>
		}
		if v.Latest != nil {
			@c.Section("Latest plan", "organization", "") {
				<div class="space-y-4">
					@planLine(v.Latest.Row)
					if v.Latest.Row.Error != "" {
						<div class="banner banner-danger" role="alert">{ v.Latest.Row.Error }</div>
					} else {
						@c.Ask(v.Latest.Ask)
					}
					if v.Latest.Approve != "" || v.Latest.Reject != "" {
						<div class="flex flex-wrap items-center gap-2">
							if v.Latest.Approve != "" {
								<button type="button" class="btn btn-primary btn-sm" hx-post={ v.Latest.Approve } hx-target={ target() } hx-swap="outerHTML">Approve</button>
							}
							if v.Latest.Reject != "" {
								<button type="button" class="btn btn-ghost btn-sm" hx-post={ v.Latest.Reject } hx-target={ target() } hx-swap="outerHTML">Reject</button>
							}
						</div>
					}
				</div>
			}
		}
		if len(v.Plans) > 0 {
			<h2 class="text-sm font-medium text-rw-muted mb-2">Plans</h2>
			<ul class="space-y-2">
				for _, r := range v.Plans {
					<li class="panel px-4 py-3">
						@planLine(r)
					</li>
				}
			</ul>
		}
	</div>
}

// planLine is one plan as v0's plans page drew it: status, summary, the
// commit, when.
templ planLine(r PlanRow) {
	<div class="flex flex-wrap items-center gap-3 text-sm">
		@c.Chip(r.Status, planTone(r.Status))
		<span class="text-rw-text">{ r.Summary }</span>
		if r.Commit != "" {
			<span class="text-xs text-rw-faint font-mono">{ r.Commit }</span>
		}
		<span class="text-xs text-rw-faint ml-auto">{ r.When }</span>
	</div>
}
