// Package org is the org card's drawer tabs (home canvas): settings,
// members + invites, keys, domains, backups, config, drawn as v0's
// organization settings.
// Params is the vars editor, composed by the handler. Each tab is drawn
// inside components.Drawer.
package org

import (
	"strconv"

	c "github.com/FyrmForge/stackr/internal/ui/components"
)

// Tabs in strip order.
var Tabs = []string{"settings", "members", "keys", "params", "domains", "shares", "backups", "config"}

type SettingsView struct {
	Name    string
	Slug    string
	Rename  string // POST name; "" = not an owner
	Cascade c.SettingsFormView
	Stacks  int           // a delete is refused while any remain
	Delete  c.ConfirmView // shown when Rename is set
}

type MembersView struct {
	Base    string   // actions: /invite, /invites/<id>/revoke, /members/<user>/role, /members/<user>/remove
	Manage  bool     // member.manage: change roles, remove, invite
	Self    string   // the viewer's user id: no role change or remove on their own row
	Roles   []string // what the org takes, the pickers' options
	Members []MemberRow
	Invites []InviteRow
}

type MemberRow struct{ UserID, Name, Email, Role string }

type InviteRow struct{ ID, Email, Role, Expires, Link string } // Link: the full invite URL

type KeysView struct {
	Base   string // POST /keys (name, level, stack), /keys/<id>/revoke
	Minted string // the token a mint just made; "" = none
	Roles  []string // the ceilings the viewer may mint: up to their own role (admin only for admins)
	Stacks []StackOpt // the org's stacks, for a key limited to one
	Keys   []KeyRow
}

type StackOpt struct{ Slug, Name string }

// KeyRow: Role is the key's ceiling ("" = the user's full rights), Stack the
// slug it is limited to ("" = the whole org).
type KeyRow struct{ ID, Name, Created, Role, Stack string }

// roleHelp is the one line under each role in a picker.
func roleHelp(r string) string {
	switch r {
	case "viewer":
		return "Sees everything, changes nothing."
	case "member":
		return "Deploys and edits stacks."
	case "owner":
		return "Also people and org settings."
	case "admin":
		return "Server admin, every org."
	}
	return ""
}

// DomainsView is v0's orgDomainsPage: the org's domain resources, then the
// instance's it also names tiles under.
type DomainsView struct {
	Add     string // POST host, include_env_on_default, acme_email; "" = not an owner
	Example string // the help text's host: the org's first, or example.com
	Host    string // the add form's prefill: <slug>.<instance host> while the org has no row
	Rows    []DomainRow
	// NoWildcard: no DNS-01, so every host is its own certificate
	NoWildcard bool
}

type DomainRow struct {
	Host       string
	Level      string // instance | org
	IncludeEnv bool
	ACMEEmail  string
	Delete     c.ConfirmView // Action "" = none (the instance's row, or not an owner)
	Rename     string        // POST host; "" = none (the instance's row, or not an owner)
}

// levelWord is how v0 names a resource's level.
func levelWord(level string) string {
	switch level {
	case "instance":
		return "server"
	case "org":
		return "organization"
	}
	return level
}

// ConfigView is v0's Config as code page as a tab: the export, the
// binding form, the latest plan with its Approve and Reject, the queued
// apply, then the last plans.
type ConfigView struct {
	Base       string // POST /config, /plan; "" = not an owner
	Export     string // GET the stackr-org.yml
	Canvas     string // the org's canvas, where its connectors are
	Connectors []Option
	Connector  string
	Repo       string
	Branch     string
	Path       string
	Auto       bool
	Unbind     c.ConfirmView // Action "" = nothing bound, or not an owner
	Job        *c.JobStatusView
	Latest     *PlanBox  // nil = no plan, or the viewer may not read plans
	Plans      []c.PlanRow // the last plans, newest first
}

type Option struct{ Value, Label string }

// PlanBox is the latest plan: its row, and the dry run with its answers.
type PlanBox struct {
	Row    c.PlanRow
	Review c.PlanReviewView
}

func target() string { return "#" + c.DrawerRoot }

func stacks(n int) string {
	if n == 1 {
		return "1 stack"
	}
	return strconv.Itoa(n) + " stacks"
}

templ Settings(v SettingsView) {
	<div id="tab-settings">
		@c.Section("Organization", "organization", "The name is the slug in every URL below it, so renaming moves them.") {
			<form novalidate hx-post={ v.Rename } hx-target={ target() } hx-swap="outerHTML" class="space-y-4">
				@c.Field(c.FieldView{Name: "name", Label: "Name", Value: v.Name, Required: true, Help: "Renaming breaks existing links.", Disabled: v.Rename == "", Why: "Only an owner can rename this organization."})
				if v.Rename != "" {
					<button type="submit" class="btn btn-primary btn-sm">Rename</button>
				}
			</form>
		}
		@c.Section("Resource defaults", "organization", "Applied to every service in this organization that does not set its own. Stacks, environments and services can still override them.") {
			@c.SettingsForm(v.Cascade)
		}
		if v.Rename != "" {
			if v.Stacks > 0 {
				@c.DangerSection("This organization still holds "+stacks(v.Stacks)+". Move or delete them before it can be deleted.", "/"+v.Slug, "")
			} else {
				@c.DangerSection("Deleting this organization removes its members, keys, connectors and params.", "/"+v.Slug, "Backups already in a destination are kept.") {
					@c.Confirm(v.Delete)
				}
			}
		}
	</div>
}

// roleButtons is v0's segmented role picker: the roles as radios in one
// control.
templ roleButtons(roles []string, name, picked string) {
	<div class="flex gap-2" role="radiogroup" aria-label="Role">
		for _, r := range roles {
			<label class="flex-1">
				<input type="radio" name={ name } value={ r } checked?={ r == picked } class="peer sr-only"/>
				<span class="block text-center rounded-lg border border-rw-border bg-rw-inset px-3 py-1.5 text-sm text-rw-muted transition-colors hover:text-rw-text cursor-pointer peer-checked:border-rw-accent peer-checked:bg-rw-accent/10 peer-checked:text-rw-text peer-focus-visible:ring-2 peer-focus-visible:ring-rw-accent/40">
					{ r }
					<span class="block text-xs text-rw-faint">{ roleHelp(r) }</span>
				</span>
			</label>
		}
	</div>
}

templ avatar(name string) {
	<span class="flex items-center justify-center rounded bg-rw-inset font-bold uppercase text-rw-accentHi shrink-0 h-8 w-8 text-xs" aria-hidden="true">{ c.Initials(name) }</span>
}

templ Members(v MembersView) {
	<div id="tab-members">
		if v.Manage {
			@c.Section("Add people", "organization", "Everyone gets an invite link to accept, and that link is a credential.") {
				<form novalidate hx-post={ v.Base + "/invite" } hx-target={ target() } hx-swap="outerHTML" class="people-add space-y-4">
					<div>
						<label for="people-email" class="label">Email address</label>
						<input id="people-email" name="email" type="email" required placeholder="person@example.com" class="input"/>
						<p class="mt-1.5 text-xs text-rw-faint">They get an invitation to accept. This server sends no mail, so the link is yours to send.</p>
					</div>
					<div>
						<span class="label">Role</span>
						@roleButtons(v.Roles, "role", "owner")
					</div>
					<button type="submit" class="btn btn-ghost btn-sm people-add-submit">Add to organization</button>
				</form>
			}
		}
		@c.Section("People", "organization", "Viewers see everything. Members deploy and edit stacks. Owners also manage people and settings.") {
			<ul class="space-y-2">
				for _, m := range v.Members {
					<li class="panel px-3 py-2.5 flex flex-wrap items-center gap-2">
						@avatar(nameOr(m.Name, m.Email))
						<span class="min-w-[12rem] flex-1">
							<span class="block text-sm text-rw-text">{ nameOr(m.Name, m.Email) }</span>
							if m.Name != "" {
								<span class="block text-xs text-rw-muted">{ m.Email }</span>
							}
						</span>
						if v.Manage && m.UserID != v.Self {
							<form novalidate hx-post={ v.Base + "/members/" + m.UserID + "/role" } hx-target={ target() } hx-swap="outerHTML" class="flex items-center gap-2">
								<select name="role" class="input !w-28 !py-1 text-xs" aria-label={ "Role of " + m.Email }>
									for _, r := range v.Roles {
										<option value={ r } selected?={ r == m.Role }>{ r }</option>
									}
								</select>
								<button type="submit" class="btn btn-ghost btn-sm">Set</button>
							</form>
							@c.Confirm(c.ConfirmView{
								Button:  "Remove",
								Title:   "Remove " + nameOr(m.Name, m.Email) + "?",
								Warning: "They lose access to this organization.",
								Action:  v.Base + "/members/" + m.UserID + "/remove",
								Target:  target(),
							})
						} else {
							<span class="text-xs px-1.5 py-0.5 rounded bg-rw-inset text-rw-muted">{ m.Role }</span>
						}
					</li>
				}
				for _, i := range v.Invites {
					<li class="panel px-3 py-2.5 flex flex-wrap items-center gap-2">
						@avatar(i.Email)
						<span class="min-w-[12rem] flex-1">
							<span class="block text-sm text-rw-text">{ i.Email }</span>
							<span class="block text-xs text-rw-warning">Invited, expires { i.Expires }</span>
						</span>
						<span class="text-xs px-1.5 py-0.5 rounded bg-rw-inset text-rw-muted">{ i.Role }</span>
						// the link is a credential: keep it out of htmx's history cache
						<button type="button" data-copy={ i.Link } hx-history="false" class="btn btn-ghost btn-sm">Copy link</button>
						@c.Confirm(c.ConfirmView{
							Button:  "Revoke",
							Title:   "Revoke the invite for " + i.Email + "?",
							Warning: "The link stops working.",
							Action:  v.Base + "/invites/" + i.ID + "/revoke",
							Target:  target(),
						})
					</li>
				}
			</ul>
		}
	</div>
}

func stackWord(slug string) string {
	if slug == "" {
		return "whole org"
	}
	return slug
}

func nameOr(name, email string) string {
	if name != "" {
		return name
	}
	return email
}

templ Keys(v KeysView) {
	<div id="tab-keys">
		@c.Section("Mint a key", "organization", "An API key for the stackr CLI, scoped to this organization. It is shown once, when minted.") {
			<form novalidate hx-post={ v.Base + "/keys" } hx-target={ target() } hx-swap="outerHTML" class="space-y-4">
				@c.Field(c.FieldView{Name: "key_name", Label: "Name", Placeholder: "laptop", Required: true})
				if len(v.Roles) > 0 {
					<div>
						<label for="key-level" class="label">Role</label>
						<select id="key-level" name="level" class="input">
							for _, r := range v.Roles {
								<option value={ r } selected?={ r == "member" }>{ r + ": " + roleHelp(r) }</option>
							}
						</select>
					</div>
				}
				<div>
					<label for="key-stack" class="label">Stack</label>
					<select id="key-stack" name="stack" class="input">
						<option value="">Whole org</option>
						for _, st := range v.Stacks {
							<option value={ st.Slug }>{ nameOr(st.Name, st.Slug) }</option>
						}
					</select>
				</div>
				<button type="submit" class="btn btn-primary btn-sm">Mint key</button>
			</form>
			if v.Minted != "" {
				// a one-time token: keep it out of htmx's history cache
				<div class="panel p-4 mt-4 space-y-2" role="status" hx-history="false">
					<p class="text-sm text-rw-text">Copy this key now. It is not shown again.</p>
					<div class="flex items-center gap-2">
						<code class="min-w-0 flex-1 break-all font-mono text-xs text-rw-text">{ v.Minted }</code>
						<button type="button" data-copy={ v.Minted } class="btn btn-ghost btn-sm">Copy</button>
					</div>
				</div>
			}
		}
		@c.Section("Your keys", "organization", "") {
			if len(v.Keys) == 0 {
				<p class="text-sm text-rw-muted">No API keys yet.</p>
			} else {
				<ul class="space-y-2">
					for _, k := range v.Keys {
						<li class="panel px-4 py-3 flex items-center justify-between gap-3">
							<span class="min-w-0">
								<span class="text-sm text-rw-text">{ k.Name }</span>
								<span class="text-rw-faint text-xs">{ k.Created }</span>
								if k.Role != "" {
									<span class="text-xs px-1.5 py-0.5 rounded bg-rw-inset text-rw-muted">{ k.Role }</span>
								}
								<span class="text-xs px-1.5 py-0.5 rounded bg-rw-inset text-rw-muted">{ stackWord(k.Stack) }</span>
							</span>
							@c.Confirm(c.ConfirmView{
								Button:  "Revoke",
								Title:   "Revoke " + k.Name + "?",
								Warning: "Anything using this key stops working.",
								Action:  v.Base + "/keys/" + k.ID + "/revoke",
								Target:  target(),
							})
						</li>
					}
				</ul>
			}
		}
	</div>
}

templ Domains(v DomainsView) {
	<div id="tab-domains">
		@c.Section("Organization domains", "organization", "Every stack in this organization can generate per-environment hostnames under one of these, like app.stack."+v.Example+". Hosts are unique across the whole server.") {
			if len(v.Rows) > 0 {
				<ul class="space-y-2 mb-5">
					for _, r := range v.Rows {
						<li class="panel px-3 py-2.5 flex flex-wrap items-center gap-2">
							<span class="font-mono text-sm text-rw-text">{ r.Host }</span>
							<span class="text-xs px-1.5 py-0.5 rounded bg-rw-inset text-rw-muted">{ levelWord(r.Level) }</span>
							if r.IncludeEnv {
								<span class="text-xs px-1.5 py-0.5 rounded bg-rw-inset text-rw-muted">env slug on default env</span>
							}
							if r.ACMEEmail != "" {
								<span class="text-xs text-rw-faint">ACME { r.ACMEEmail }</span>
							}
							if r.Delete.Action != "" {
								<span class="ml-auto">
									@c.Confirm(r.Delete)
								</span>
							}
							if r.Rename != "" {
								<form novalidate onsubmit="return false" class="basis-full flex flex-wrap items-center gap-2">
									<label for={ "rename-" + r.Host } class="sr-only">New host for { r.Host }</label>
									<input id={ "rename-" + r.Host } name="host" type="text" required placeholder="new host" class="input font-mono flex-1 min-w-40"/>
									@c.Confirm(c.ConfirmView{
										Button:  "Rename",
										Title:   "Rename " + r.Host + "?",
										Warning: "Every hostname under it moves and the old one redirects. Point DNS at the new name first.",
										Action:  r.Rename,
										Target:  target(),
										Primary: true,
									})
									<p class="basis-full text-xs text-rw-faint">Names under it move; the old ones redirect. Point DNS first.</p>
								</form>
							}
						</li>
					}
				</ul>
			} else {
				<p class="text-sm text-rw-faint mb-5">No domains yet.</p>
			}
			if v.NoWildcard {
				<p class="text-xs text-rw-faint mb-5">No wildcard certificates: each host gets its own, and Let's Encrypt allows about 50 a week per domain.</p>
			}
			if v.Add != "" {
				<form novalidate hx-post={ v.Add } hx-target={ target() } hx-swap="outerHTML" class="space-y-4">
					<div>
						<label for="domain-host" class="label">Host</label>
						<input id="domain-host" name="host" type="text" required placeholder="example.com" value={ v.Host } class="input font-mono"/>
						<p class="mt-1.5 text-xs text-rw-faint">A bare lowercase hostname, e.g. example.com.</p>
					</div>
					<label class="flex items-center gap-2 text-sm text-rw-muted cursor-pointer">
						<input type="checkbox" name="include_env_on_default" value="1" class="accent-rw-accent"/>
						Include env slug on default env (api.prod.stack instead of api.stack)
					</label>
					@c.Field(c.FieldView{Name: "acme_email", Label: "ACME email", Type: "email", Placeholder: "ops@example.com", Help: "Certificates under this host are issued on this account. Empty uses the server's."})
					<button type="submit" class="btn btn-primary btn-sm">Add domain</button>
				</form>
			}
		}
	</div>
}

// SharesView is the org's network shares: NFS or SMB exports a tile line
// share:<slug>/<sub>:/path mounts.
type SharesView struct {
	Add  string // POST slug, kind, source, options, user, password; "" = not an owner
	Rows []ShareRow
}

type ShareRow struct {
	Slug, Kind, Source, Options, User, Password string
	Delete                                      c.ConfirmView // Action "" = not an owner
}

templ Shares(v SharesView) {
	<div id="tab-shares">
		@c.Section("Network shares", "organization", "NFS or SMB exports tiles can mount.") {
			if len(v.Rows) > 0 {
				<ul class="space-y-2 mb-5">
					for _, r := range v.Rows {
						<li class="panel px-3 py-2.5 flex flex-wrap items-center gap-2">
							<span class="font-mono text-sm text-rw-text">{ r.Slug }</span>
							<span class="text-xs px-1.5 py-0.5 rounded bg-rw-inset text-rw-muted">{ r.Kind }</span>
							<span class="font-mono text-xs text-rw-faint">{ r.Source }</span>
							if r.Options != "" {
								<span class="font-mono text-xs text-rw-faint">{ r.Options }</span>
							}
							if r.User != "" {
								<span class="text-xs text-rw-faint">user { r.User }</span>
							}
							if r.Delete.Action != "" {
								<span class="ml-auto">
									@c.Confirm(r.Delete)
								</span>
							}
						</li>
					}
				</ul>
			} else {
				<p class="text-sm text-rw-faint mb-5">No shares yet.</p>
			}
			if v.Add != "" {
				<form novalidate hx-post={ v.Add } hx-target={ target() } hx-swap="outerHTML" class="space-y-4">
					@c.Field(c.FieldView{Name: "slug", Label: "Name", Placeholder: "media", Required: true})
					<div>
						<label for="share-kind" class="label">Kind</label>
						<select id="share-kind" name="kind" class="input">
							<option value="nfs">nfs</option>
							<option value="smb">smb</option>
						</select>
					</div>
					@c.Field(c.FieldView{Name: "source", Label: "Source", Placeholder: "nas.lan:/export", Help: "nfs: host:/path. smb: //host/share.", Required: true})
					@c.Field(c.FieldView{Name: "options", Label: "Options", Placeholder: "nfsvers=4"})
					@c.Field(c.FieldView{Name: "user", Label: "SMB user", Placeholder: "bob"})
					@c.Field(c.FieldView{Name: "password", Label: "SMB password ref", Placeholder: "${{ org.params.nas.password }}", Help: "A param ref, never the password."})
					<button type="submit" class="btn btn-primary btn-sm">Add share</button>
				</form>
			}
		}
	</div>
}

templ Backups(v c.DestsView) {
	<div id="tab-backups">
		@c.Dests(v)
	</div>
}

templ Config(v ConfigView) {
	<div id="tab-config">
		@c.Section("Export", "organization", "This organization's live state as a stackr-org.yml, the way out of panel-first and into config-as-code. Secrets come out as declarations, never values.") {
			<a href={ templ.SafeURL(v.Export) } download="stackr-org.yml" class="btn btn-ghost btn-sm">Download stackr-org.yml</a>
		}
		@c.Section("Config as code", "organization", "One file declares the whole organization. Its plans wait for an owner's approve unless Auto apply is on.") {
			if len(v.Connectors) == 0 && v.Repo == "" {
				<p class="text-sm text-rw-muted">Connect GitHub first. The org file is fetched through a connector. <a href={ templ.SafeURL(v.Canvas) } class="link">Connectors</a></p>
			} else {
				<form novalidate hx-post={ v.Base + "/config" } hx-target={ target() } hx-swap="outerHTML">
					<fieldset disabled?={ v.Base == "" } class="space-y-4">
						<legend class="sr-only">Config repository</legend>
						<div>
							<label for="org-connector" class="label">Connector</label>
							<select id="org-connector" name="connector" class="input">
								<option value="">(unbind)</option>
								for _, o := range v.Connectors {
									<option value={ o.Value } selected?={ o.Value == v.Connector }>{ o.Label }</option>
								}
							</select>
						</div>
						@c.Field(c.FieldView{Name: "repo", Label: "Repository (owner/name)", Value: v.Repo, Placeholder: "you/serverconfig"})
						@c.Field(c.FieldView{Name: "branch", Label: "Branch (empty = default)", Value: v.Branch})
						@c.Field(c.FieldView{Name: "path", Label: "File path (empty = stackr-org.yml)", Value: v.Path})
						<label class="flex items-center gap-2 text-sm text-rw-text"><input type="checkbox" name="auto" value="1" checked?={ v.Auto } class="accent-rw-accent"/> Auto apply a plan with no impact lines and no removals</label>
						if v.Base != "" {
							<div class="flex flex-wrap items-center gap-2">
								<button type="submit" class="btn btn-primary btn-sm">Save and plan</button>
								if v.Repo != "" {
									<button type="button" class="btn btn-ghost btn-sm" hx-post={ v.Base + "/plan" } hx-target={ target() } hx-swap="outerHTML">Plan now</button>
								}
							</div>
						}
					</fieldset>
				</form>
			}
			if v.Unbind.Action != "" {
				<div class="flex flex-wrap items-center gap-2 mt-5 pt-5 border-t border-rw-border">
					@c.Confirm(v.Unbind)
				</div>
			}
		}
		if v.Job != nil {
			<div class="mb-4">
				@c.JobStatus(*v.Job)
			</div>
		}
		if v.Latest != nil {
			@c.Section("Latest plan", "organization", "") {
				<div class="space-y-4">
					@c.PlanLine(v.Latest.Row)
					if v.Latest.Row.Error != "" {
						<div class="banner banner-danger" role="alert">{ v.Latest.Row.Error }</div>
					} else {
						@c.PlanReview(v.Latest.Review)
					}
				</div>
			}
		}
		if len(v.Plans) > 0 {
			<h2 class="text-sm font-medium text-rw-muted mb-2">Plans</h2>
			<ul class="space-y-2">
				for _, r := range v.Plans {
					<li class="panel px-4 py-3">
						@c.PlanLine(r)
					</li>
				}
			</ul>
		}
	</div>
}
