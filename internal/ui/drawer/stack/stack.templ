// Package stack is the stack card's drawer tabs (org canvas): releases and
// settings. Settings is one accordion: general, env order, config as code,
// resources, variables, placement, host access and delete. Releases,
// variables and placement are shared views, composed by the handler.
package stack

import (
	"github.com/FyrmForge/stackr/internal/ui/access"
	c "github.com/FyrmForge/stackr/internal/ui/components"
	"strconv"
	"strings"
)

var Tabs = []string{"releases", "settings"}

type SettingsView struct {
	Base          string // POST /rename, /config, /order; "" = read-only
	Open          string // the accordion row open on load (?open=)
	Refresh       string // this tab's GET: the row heads redraw from it after a row saves alone
	Name          string
	Slug          string
	Where         string // "smoke / shop", under the danger zone
	Order         OrderView
	Cascade       c.SettingsFormView
	Connectors    []Option
	Connector     string
	Repo          string
	Branch        string
	Path          string
	Unbind        c.ConfirmView // Action "" = nothing bound, or read-only
	Vars          string        // the Variables row's summary
	VarsSet       bool          // a variable is set on this stack
	VarsBody      templ.Component
	Placement     string // the row's summary
	PlacementSet  bool   // the stack pins, picks an ingress or lists its own exits
	PlacementBody templ.Component
	Delete        c.ConfirmView
	Host          HostView
}

// OrderView is the ladder, bottom rung first; each move posts the whole
// new order.
type OrderView struct {
	Action string // POST ids...; "" = read-only
	Rungs  []Rung
	Moved  string // the move just made, "<id>:up" or "<id>:down"; "" = none
}

// Focus: after a move, the moved rung's button in the same direction gets
// the focus back, or the other one once it reached the end.
func (v OrderView) Focus(r Rung, dir string) bool {
	id, moved, ok := strings.Cut(v.Moved, ":")
	if !ok || id != r.ID {
		return false
	}
	end := (moved == "up" && r.Up == nil) || (moved == "down" && r.Down == nil)
	return (dir == moved) != end
}

type Rung struct {
	ID, Name, Color string
	Detail          string   // where its releases come from: "branch main", "from dev"
	Up, Down        []string // the order after moving this rung up or down the list; nil = at the end
}

// HostView is the stack's host access, per tile: what a server admin
// approved and what its parked jobs still ask for. Approve is the form for
// a server admin when something waits; nil = the viewer cannot approve, or
// nothing waits.
type HostView struct {
	Tiles   []access.TilePerms
	Approve *access.ApproveView
}

type Option = c.Option

func target() string { return "#" + c.DrawerRoot }

templ Settings(v SettingsView) {
	<div id="tab-settings">
		@c.SettingsAccordion(c.SettingsAcc{ID: "stack-settings", Rows: Rows(v), Open: v.Open, Refresh: v.Refresh})
	</div>
}

templ general(v SettingsView) {
	<form novalidate if v.Base != "" { hx-post={ v.Base + "/rename" } } hx-target={ target() } hx-swap="outerHTML" class="space-y-4">
		@c.KeepOpen("general")
		@c.Field(c.FieldView{Name: "name", Label: "Name", Value: v.Name, Required: true, Disabled: v.Base == "", Why: "Only members and owners can rename it."})
		<div data-field>
			<label for="stack-slug" class="label">URL slug</label>
			<input id="stack-slug" type="text" value={ v.Slug } class="input font-mono" disabled/>
			<p class="mt-1.5 text-xs text-rw-faint" data-hint>Set from the name on rename, which moves every URL under this stack.</p>
		</div>
		if v.Base != "" {
			<button type="submit" class="btn btn-primary btn-sm">Rename</button>
		}
	</form>
}

templ order(v OrderView) {
	<p class="text-xs text-rw-faint" data-hint>Releases move down this list.</p>
	if len(v.Rungs) == 0 {
		<p class="text-sm text-rw-muted">No environments yet.</p>
	} else {
		<ol class="rounded-lg border border-rw-border divide-y divide-rw-border text-sm">
			for i, r := range v.Rungs {
				<li class="flex items-center gap-3 px-3 py-2">
					<span class="text-rw-faint w-4">{ strconv.Itoa(i + 1) }</span>
					<span class="flex-1">
						@c.EnvBadge(r.Name, r.Color)
					</span>
					if r.Detail != "" {
						<span class="text-xs text-rw-faint">{ r.Detail }</span>
					}
					if v.Action != "" && len(v.Rungs) > 1 {
						@move("↑", "Move "+r.Name+" up", v.Action, r.Up, r.ID+":up", v.Focus(r, "up"))
						@move("↓", "Move "+r.Name+" down", v.Action, r.Down, r.ID+":down", v.Focus(r, "down"))
					}
				</li>
			}
		</ol>
	}
}

// move posts the order after one move; moved names it, so the answer puts
// the focus back on the moved rung's button (focus).
templ move(icon, label, action string, ids []string, moved string, focus bool) {
	if ids != nil {
		<form hx-post={ action } hx-target={ target() } hx-swap="outerHTML">
			@c.KeepOpen("order")
			<input type="hidden" name="moved" value={ moved }/>
			for _, id := range ids {
				<input type="hidden" name="ids" value={ id }/>
			}
			<button type="submit" class="btn btn-ghost btn-sm" aria-label={ label } title={ label } autofocus?={ focus }>{ icon }</button>
		</form>
	} else {
		<span class="btn btn-ghost btn-sm invisible" aria-hidden="true">{ icon }</span>
	}
}

templ config(v SettingsView) {
	<p class="text-xs text-rw-faint" data-hint>Bind a repository holding stackr-compose.yml and deploys read the stack from it.</p>
	<form novalidate if v.Base != "" { hx-post={ v.Base + "/config" } } hx-target={ target() } hx-swap="outerHTML">
		@c.KeepOpen("config")
		<fieldset disabled?={ v.Base == "" } class="space-y-4">
			<legend class="sr-only">Config repository</legend>
			if v.Base == "" {
				<p class="text-xs text-rw-faint" data-hint>Only members and owners can bind a repository.</p>
			}
			@c.ConfigRepoFields(c.ConfigRepoView{ID: "stack-config", Connectors: v.Connectors, Connector: v.Connector, Repo: v.Repo, Branch: v.Branch, Path: v.Path, File: "stackr-compose.yml", Placeholder: "acme/infra"})
			if v.Base != "" {
				<button type="submit" class="btn btn-primary btn-sm">Save</button>
			}
		</fieldset>
	</form>
	if v.Unbind.Action != "" {
		<div class="flex flex-wrap items-center gap-2 pt-4 border-t border-rw-border">
			@c.Confirm(v.Unbind)
		</div>
	}
}

templ resources(f c.SettingsFormView) {
	<p class="text-xs text-rw-faint" data-hint>Tiles below use these unless they set their own.</p>
	@c.SettingsForm(f)
}

templ host(v HostView) {
	if len(v.Tiles) == 0 {
		<p class="text-sm text-rw-muted">No tile has host access.</p>
	} else {
		<p class="text-xs text-rw-faint" data-hint>Set by a server admin, per tile.</p>
		<div id="host-access" class="space-y-3">
			for _, t := range v.Tiles {
				<div>
					<div class="mb-1 font-mono text-xs text-rw-muted">{ t.Tile }</div>
					@access.Rows(t.Perms)
				</div>
			}
		</div>
		if v.Approve != nil {
			<div class="pt-4 border-t border-rw-border">
				<div class="label">Review request</div>
				<p class="mb-3 text-xs text-rw-faint" data-hint>Untick what you do not grant.</p>
				@access.Approve(*v.Approve)
			</div>
		}
	}
}

templ danger(v SettingsView) {
	@c.DangerZone("Deleting this stack removes its tiles, envs, releases and variables.", v.Where, "Backups already in a destination are kept.") {
		@c.Confirm(v.Delete)
	}
}
