// Package stack is the stack card's drawer tabs (org canvas): settings
// (name, resource defaults, config as code, delete), drawn as v0's stack
// settings page. Params and releases are shared views, composed by the
// handler.
package stack

import c "github.com/FyrmForge/stackr/internal/ui/components"

var Tabs = []string{"settings", "params", "releases"}

type SettingsView struct {
	Base       string // POST /rename, /config; "" = read-only
	Name       string
	Slug       string
	Where      string // "smoke / shop", under the danger zone
	Cascade    c.SettingsFormView
	Connectors []Option
	Connector  string
	Repo       string
	Branch     string
	Path       string
	Unbind     c.ConfirmView // Action "" = nothing bound, or read-only
	Delete     c.ConfirmView
}

type Option struct{ Value, Label string }

func target() string { return "#" + c.DrawerRoot }

templ Settings(v SettingsView) {
	<div id="tab-settings">
		@c.Section("Stack", "stack", "") {
			<form hx-post={ v.Base + "/rename" } hx-target={ target() } hx-swap="outerHTML" class="space-y-4">
				@c.Field(c.FieldView{Name: "name", Label: "Name", Value: v.Name, Required: true, Disabled: v.Base == "", Why: "Renaming needs write access to this stack."})
				<div>
					<label for="stack-slug" class="label">URL slug</label>
					<input id="stack-slug" type="text" value={ v.Slug } class="input font-mono" disabled/>
					<p class="mt-1.5 text-xs text-rw-faint">Follows the name: renaming moves every URL under this stack.</p>
				</div>
				if v.Base != "" {
					<button type="submit" class="btn btn-primary btn-sm">Rename</button>
				}
			</form>
		}
		@c.Section("Resource defaults", "stack", "Applied to every service in this stack that does not set its own. Environments and individual services can still override them; leave a field empty to inherit from the level above.") {
			@c.SettingsForm(v.Cascade)
		}
		@c.Section("Config as code", "stack", "Bind a repository holding stackr-compose.yml and deploys read the stack from it. An empty repository leaves the stack managed from the UI.") {
			<form hx-post={ v.Base + "/config" } hx-target={ target() } hx-swap="outerHTML">
				<fieldset disabled?={ v.Base == "" } class="space-y-4">
					<legend class="sr-only">Config repository</legend>
					<div>
						<label for="connector" class="label">Connector</label>
						<select id="connector" name="connector" class="input">
							<option value="">None (a public repository)</option>
							for _, o := range v.Connectors {
								<option value={ o.Value } selected?={ o.Value == v.Connector }>{ o.Label }</option>
							}
						</select>
						<p class="mt-1.5 text-xs text-rw-faint">Which GitHub App supplies the credentials.</p>
					</div>
					@c.Field(c.FieldView{Name: "repo", Label: "Repository", Value: v.Repo, Placeholder: "acme/infra", Help: "In owner/name form."})
					@c.Field(c.FieldView{Name: "branch", Label: "Branch", Value: v.Branch, Placeholder: "main", Help: "Empty uses the repository's default branch."})
					@c.Field(c.FieldView{Name: "path", Label: "Config path", Value: v.Path, Placeholder: "stackr-compose.yml"})
					if v.Base != "" {
						<button type="submit" class="btn btn-primary btn-sm">Save</button>
					}
				</fieldset>
			</form>
			if v.Unbind.Action != "" {
				<div class="flex flex-wrap items-center gap-2 mt-5 pt-5 border-t border-rw-border">
					@c.Confirm(v.Unbind)
				</div>
			}
		}
		if v.Base != "" {
			@c.DangerSection("Deleting this stack removes its releases and params. It is refused while it still has environments.", v.Where, "Backups already in a destination are kept.") {
				@c.Confirm(v.Delete)
			}
		}
	</div>
}
