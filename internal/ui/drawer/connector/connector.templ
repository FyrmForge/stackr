// Package connector is a connector card's drawer (org canvas): settings
// (rename, delete, the install link) and repos (the install check).
package connector

import (
	"strconv"

	c "github.com/FyrmForge/stackr/internal/ui/components"
)

var Tabs = []string{"settings", "repos"}

type SettingsView struct {
	Base       string // POST /rename; "" = read-only
	Name       string
	Label      string // the kind, as the copy names it
	Host       string
	InstallURL string // the provider's install page; "" = setup not finished
	Shared     bool   // a server connector: read-only here
	Admin      bool   // the viewer is a server admin: Server settings changes it
	Delete     c.ConfirmView
}

func renameWhy(v SettingsView) string {
	if v.Shared && v.Admin {
		return v.Label + " connector on " + v.Host + ". Shared from the server: rename it in Server settings."
	}
	if v.Shared {
		return v.Label + " connector on " + v.Host + ". Only a server admin can rename it."
	}
	return v.Label + " connector on " + v.Host + ". Renaming needs write."
}

func settingsHelp(v SettingsView) string {
	if v.Shared {
		return "Shared with this organization by a server admin; only they can change it."
	}
	return "A " + v.Label + " connector for this organization, so there are no tokens to copy around."
}

templ Settings(v SettingsView) {
	<div id="tab-settings">
		@c.Section("Connector", "organization", settingsHelp(v)) {
			<div class="panel px-4 py-3 flex flex-wrap items-center gap-3 mb-5">
				<span class="text-sm text-rw-text">{ v.Name }</span>
				if v.Shared {
					<span class="text-rw-faint text-xs ml-auto">shared from the server</span>
				} else if v.InstallURL != "" {
					<a href={ templ.SafeURL(v.InstallURL) } class="btn btn-ghost btn-sm ml-auto">Manage installation</a>
					if v.Base != "" {
						<button type="button" class="btn btn-ghost btn-sm" hx-post={ v.Base + "/check" } hx-target={ "#" + c.DrawerRoot } hx-swap="outerHTML">Check installation</button>
					}
				} else {
					<span class="text-rw-faint text-xs ml-auto">setup not finished</span>
				}
			</div>
			if v.InstallURL != "" && !v.Shared {
				<p class="text-sm text-rw-muted mb-4">It must be installed on your { v.Label } account or org before a repo can be cloned through it. Manage installation opens { v.Label }'s page for that; pick the repos there, then Check installation.</p>
			}
			<form hx-post={ v.Base + "/rename" } hx-target={ "#" + c.DrawerRoot } hx-swap="outerHTML" class="space-y-4">
				@c.Field(c.FieldView{Name: "name", Label: "Name", Value: v.Name, Required: true, Help: v.Label + " connector on " + v.Host + ".", Disabled: v.Base == "", Why: renameWhy(v)})
				if v.Base != "" {
					<button type="submit" class="btn btn-primary btn-sm">Rename</button>
				}
			</form>
			if v.Shared && v.Admin {
				<a href="/-/admin/connectors" class="link text-sm mt-3 inline-block">Open Server settings, Connectors</a>
			}
		}
		if v.Base != "" {
			@c.DangerZone("A stack or tile that clones through it stops building.", v.Host, "It stays installed on "+v.Label+"; uninstall it there too.") {
				@c.Confirm(v.Delete)
			}
		}
	</div>
}

// ReposView is the install check: Checked false asks the provider as the
// tab loads, true shows what it answered (v0's setup step 2 states).
type ReposView struct {
	Label      string // the kind, as the copy names it
	Check      string // POST, answers the drawer on this tab
	InstallURL string // "" = handshake not finished
	Shared     bool   // a server connector: no install links
	Checked    bool
	Repos      []string // full names
}

func repoCount(n int) string {
	if n == 1 {
		return "1 repository"
	}
	return strconv.Itoa(n) + " repositories"
}

templ Repos(v ReposView) {
	<div id="tab-repos">
		@c.Section("Repositories", "organization", "The repositories it may read. Making it is not installing it: one installed nowhere can clone nothing.") {
			if v.InstallURL == "" && !v.Shared {
				<p class="text-sm text-rw-muted">The setup at { v.Label } did not finish. Delete this connector and create it again.</p>
			} else if !v.Checked {
				<p class="text-sm text-rw-muted" hx-post={ v.Check } hx-trigger="load" hx-target={ "#" + c.DrawerRoot } hx-swap="outerHTML" aria-busy="true">Asking { v.Label }…</p>
			} else if len(v.Repos) == 0 && v.Shared {
				<p class="text-sm text-rw-muted">It is installed on no repositories. Ask a server admin to add some.</p>
			} else if len(v.Repos) == 0 {
				<p class="text-sm text-rw-muted mb-5">The connector is made. Now choose the repositories it may access, otherwise stackr cannot read any of them.</p>
				<div class="flex flex-wrap gap-2">
					<a href={ templ.SafeURL(v.InstallURL) } class="btn btn-primary btn-sm">Install it on { v.Label }</a>
					<button type="button" class="btn btn-ghost btn-sm" hx-post={ v.Check } hx-target={ "#" + c.DrawerRoot } hx-swap="outerHTML">I installed it, check again</button>
				</div>
			} else {
				<p class="text-sm text-rw-muted mb-3">Connected and installed on { repoCount(len(v.Repos)) }.</p>
				<ul class="space-y-2 mb-5">
					for _, r := range v.Repos {
						<li class="panel px-3 py-2 font-mono text-xs text-rw-muted">{ r }</li>
					}
				</ul>
				<div class="flex flex-wrap gap-2">
					if !v.Shared {
						<a href={ templ.SafeURL(v.InstallURL) } class="btn btn-ghost btn-sm">Change which repositories it can see</a>
					}
					<button type="button" class="btn btn-ghost btn-sm" hx-post={ v.Check } hx-target={ "#" + c.DrawerRoot } hx-swap="outerHTML">Check again</button>
				</div>
			}
		}
	</div>
}
