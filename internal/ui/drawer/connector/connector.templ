// Package connector is a connector card's drawer (org canvas): settings
// (rename, delete) and repos.
package connector

import c "github.com/FyrmForge/stackr/internal/ui/components"

var Tabs = []string{"settings", "repos"}

type SettingsView struct {
	Base       string // POST /rename; "" = read-only
	Name       string
	Host       string
	InstallURL string // GitHub's install page; "" = handshake not finished
	Delete     c.ConfirmView
}

templ Settings(v SettingsView) {
	<div id="tab-settings">
		@c.Section("Connector", "organization", "A private GitHub App for this organization, so there are no tokens to copy around.") {
			<div class="panel px-4 py-3 flex flex-wrap items-center gap-3 mb-5">
				<span class="text-sm text-rw-text">{ v.Name }</span>
				if v.InstallURL != "" {
					<a href={ templ.SafeURL(v.InstallURL) } target="_blank" rel="noopener" class="btn btn-ghost btn-sm ml-auto">Manage installation</a>
				} else {
					<span class="text-rw-faint text-xs ml-auto">setup not finished</span>
				}
			</div>
			if v.InstallURL != "" {
				<p class="text-sm text-rw-muted mb-4">The app must be installed on your GitHub account or org before a repo can be cloned through it. Manage installation opens GitHub's page for that; pick the repos there.</p>
			}
			<form hx-post={ v.Base + "/rename" } hx-target={ "#" + c.DrawerRoot } hx-swap="outerHTML" class="space-y-4">
				@c.Field(c.FieldView{Name: "name", Label: "Name", Value: v.Name, Required: true, Help: "GitHub App on " + v.Host + ".", Disabled: v.Base == "", Why: "GitHub App on " + v.Host + ". Renaming needs write."})
				if v.Base != "" {
					<button type="submit" class="btn btn-primary btn-sm">Rename</button>
				}
			</form>
		}
		if v.Base != "" {
			@c.DangerSection("A stack or tile that clones through it stops building.", v.Host, "The app stays installed on GitHub; uninstall it there too.") {
				@c.Confirm(v.Delete)
			}
		}
	</div>
}

// ponytail: no verb lists an installation's repos yet.
templ Repos() {
	<div id="tab-repos">
		@c.Section("Repositories", "organization", "The repos this app can reach are listed on GitHub, under the app's installation.") {
			<p class="text-sm text-rw-faint">Pick a repo when you create a service tile.</p>
		}
	</div>
}
