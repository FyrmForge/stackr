package cards

import (
	"strings"
	"time"

	c "github.com/FyrmForge/stackr/internal/ui/components"
)

// Card is an env card's face (v0 nodeCardFace): a volume is its bottom
// strip, anything else the head and the live footer. A card with a drawer
// opens it on click and pushes ?drawer=&tab=.
templ Card(v CardView) {
	<div
		class={ Class(v.Kind), templ.KV("border-dashed opacity-70", v.Ghost), templ.KV("opacity-70", v.Faded) }
		data-kind={ v.Kind }
		if v.Drawer != "" {
			hx-get={ v.Drawer }
			hx-target="#drawer-body"
			hx-push-url={ templ.SafeURL("?drawer=" + v.ID + "&tab=" + v.Tab) }
			tabindex="0"
			role="button"
		}
	>
		if v.Kind == "volume" {
			<div class="absolute inset-x-0 bottom-0 flex items-center gap-2 px-3.5 py-1.5 min-w-0 text-rw-muted">
				<span class="shrink-0">
					@Icon(v.Kind)
				</span>
				<span class="text-xs font-medium text-rw-text truncate shrink-0 max-w-[65%]">{ v.Name }</span>
				if v.NoBackup {
					<span class="text-[10px] text-rw-faint truncate ml-auto">No backup</span>
					<span class="text-[10px] text-rw-faint font-mono truncate">{ v.Detail }</span>
				} else {
					<span class="text-[10px] text-rw-faint font-mono truncate ml-auto">{ v.Detail }</span>
				}
			</div>
		} else {
			<div class="flex h-full flex-col p-3.5">
				@top(v.Kind, v.Name, v.Detail, v.Host, v.Access, v.Footer.Fail != "" || v.Footer.StoppedAt != "" || v.Footer.Note != "")
				if v.Sync != "" {
					{{ text, class := syncChip(v.Sync) }}
					<span class={ "absolute -top-2.5 right-3 z-10 rounded-md border bg-rw-surface px-1.5 py-0.5 text-[10px]", class }>{ text }</span>
				}
				if v.RestartPending && v.Sync == "" {
					<span class="absolute -top-2.5 right-3 z-10 rounded-md border border-rw-warn/40 bg-rw-surface px-1.5 py-0.5 text-[10px] text-rw-warn">Redeploy pending</span>
				}
				@Footer(v.ID, v.Footer)
			</div>
		}
	</div>
}

// Top is a card's head: the icon, the name, the detail (the image) on its
// own line, and one line of tags.
templ Top(kind, name, detail string, host bool) {
	@top(kind, name, detail, host, Access{}, false)
}

// top: noted drops the kind chip, so the line above the footer (it sits over
// the head's last row in the card's fixed height) never lands on it. The tags
// stay on one line: past maxChips the rest fold into "+N".
templ top(kind, name, detail string, host bool, acc Access, noted bool) {
	{{ chips, more := Chips(kind, host, acc, noted) }}
	<div class="flex items-center gap-2.5">
		<span class="node-icon flex h-7 w-7 items-center justify-center rounded-md bg-rw-inset text-rw-muted shrink-0">
			@Icon(kind)
		</span>
		<div class="min-w-0">
			<div class="font-semibold text-rw-text truncate text-sm leading-tight">{ name }</div>
			<div class="text-[11px] leading-[14px] text-rw-faint truncate">{ detail }</div>
			if len(chips) > 0 {
				<div class="node-chips flex flex-nowrap items-center gap-1 min-w-0 overflow-hidden">
					for _, ch := range chips {
						<span class={ "shrink-0 rounded-md border px-1.5 py-px text-[10px] leading-none", ch.Class } title={ ch.Title }>{ ch.Text }</span>
					}
					if more > 0 {
						<span class="shrink-0 text-[10px] text-rw-faint">+{ itoa(more) }</span>
					}
				</div>
			}
		</div>
	</div>
}

// Footer is the swap unit of a card's live strip (v0 NodeFooter): the
// stream sends it whole as "footer:<id>" and it replaces itself
// (hx-target="this", or it would inherit the card's #drawer-body).
templ Footer(id string, f FooterView) {
	<div
		class={ "node-footer mt-auto border-t border-rw-border flex items-center justify-between gap-2 min-w-0 relative", templ.KV("pt-3", f.Fail == "" && f.StoppedAt == "" && f.Note == ""), templ.KV("pt-1.5", f.Fail != "" || f.StoppedAt != "" || f.Note != "") }
		data-kind={ f.Kind }
		sse-swap={ "footer:" + id }
		hx-target="this"
		hx-swap="outerHTML"
	>
		if f.Note != "" {
			<p class="node-fail absolute bottom-full mb-px inset-x-0 flex gap-1.5 text-[11px] leading-none text-rw-warn">
				<span class="min-w-0 flex-1 truncate" title={ f.Note }>{ f.Note }@c.Time(f.NoteAt, "15:04")</span>
				if f.NoteHref != "" {
					<a href={ templ.SafeURL(f.NoteHref) } hx-get={ f.NoteHref } hx-target="#main" hx-push-url="true" hx-trigger="click consume" class="shrink-0 underline">{ f.NoteLink }</a>
				}
			</p>
		} else if short, full := FailLine(f.Fail); short != "" {
			if f.FailHref != "" {
				<p class="node-fail absolute bottom-full mb-px inset-x-0 flex gap-1.5 text-[11px] leading-none text-rw-danger">
					<span class="min-w-0 flex-1 truncate" title={ full }>{ short }</span>
					<a href={ templ.SafeURL(f.FailHref) } hx-get={ f.FailHref } hx-target="#main" hx-push-url="true" hx-trigger="click consume" class="shrink-0 underline">Job log</a>
				</p>
			} else {
				<p class="node-fail absolute bottom-full mb-px inset-x-0 truncate text-[11px] leading-none text-rw-danger" title={ full }>{ short }</p>
			}
		}
		if f.StoppedAt != "" {
			<p class="node-fail absolute bottom-full mb-px inset-x-0 truncate text-[11px] leading-none text-rw-faint">
				{ "Stopped at " + f.StoppedAt + "." }
				if f.StopHref != "" {
					{ " " }<a href={ templ.SafeURL(f.StopHref) } class="underline">Job log</a>
				}
			</p>
		}
		switch f.Kind {
			case "cron", "function":
				@line(run(f.LastRun, f.Status), f.LastRun) {
					@c.Time(f.LastAt, f.LastFmt)
				}
				if !f.NextRun.IsZero() {
					<span class="text-xs text-rw-faint shrink-0">
						{ "next " }
						@c.Time(f.NextRun, "15:04")
					</span>
				} else if f.Kind == "function" {
					<span class="text-xs text-rw-faint shrink-0">{ f.Trigger }</span>
				} else {
					<span class="text-xs text-rw-warn shrink-0">paused</span>
				}
			case "ref":
				<span class="flex items-center gap-1 text-xs text-rw-accentHi min-w-0">
					<svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						@glyph("connector")
					</svg>
					<span class="truncate">operated tile, open home</span>
				</span>
			case "slice":
				@Status(f.Status, f.Waiting)
				<span class="text-xs text-rw-faint shrink-0">{ consumers(f.Consumers) }</span>
			case "vars", "secrets", "connector":
				<span class="flex items-center gap-1 text-xs text-rw-faint min-w-0">
					<svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M7 17 17 7M7 7h10v10"></path>
					</svg>
					<span class="truncate">open settings</span>
				</span>
			default:
				if !f.Since.IsZero() {
					@progress(f)
				} else if f.Want > 1 && f.Up > 0 && f.Up < f.Want {
					@line("warn", "degraded · "+itoa(f.Up)+"/"+itoa(f.Want))
				} else if f.Want > 1 && f.Status == "running" {
					@line("success", "running · "+itoa(f.Up)+"/"+itoa(f.Want))
				} else if f.Wait > 0 {
					@statusDot(f.Status, f.Waiting)
				} else {
					@Status(f.Status, f.Waiting)
				}
				if f.Wait > 0 {
					<span class="node-wait flex items-center gap-1.5 text-xs min-w-0"><span class="text-rw-accentHi truncate" title={ "Release " + itoa(f.Wait) + " waiting" }>{ "Release " + itoa(f.Wait) + " waiting" }</span></span>
				}
				if f.NewVersion && f.Wait == 0 {
					<span class="shrink-0 rounded-md border border-rw-warn/40 bg-rw-warn/10 px-1.5 py-0.5 text-[10px] text-rw-warn" title="a newer image is in the registry. Deploy to update">New version</span>
				}
				if f.ExtUpdates > 0 {
					<span class="shrink-0 rounded-md border border-rw-warn/40 bg-rw-warn/10 px-1.5 py-0.5 text-[10px] text-rw-warn" title="newer extension builds are available">Extension updates</span>
				}
				// the chip yields to "Release N waiting": the card has room for one
				if (f.Domain != "" || f.Domains > 0) && f.Wait == 0 && !f.NewVersion {
					@exposure(f)
				}
		}
	</div>
}

// Status is a card's status line (v0 nodeStatus).
templ Status(status, waiting string) {
	{{ tone, text := word(status, waiting) }}
	@mark(tone, text, status == "waiting" || status == "queued", false)
}

// statusDot is Status as its dot alone, for a card that also says "Release N
// waiting": the card is 220px and the word would truncate that. The word stays
// in the title and for screen readers.
templ statusDot(status, waiting string) {
	{{ tone, text := word(status, waiting) }}
	<span class="node-status flex shrink-0 items-center" title={ text }>
		if status == "waiting" || status == "queued" {
			<span class={ "h-1.5 w-1.5 rounded-full shrink-0 border", toneBorder(tone) } aria-hidden="true"></span>
		} else {
			<span class={ "h-1.5 w-1.5 rounded-full shrink-0", toneDot(tone) } aria-hidden="true"></span>
		}
		<span class="sr-only">{ text }</span>
	</span>
}

// progress is a live deploy beside the tile's state: "Online" with a faint
// "updating 0:14" at the right, the step with its clock at the right, or
// while the job only waits (queued, or for a dependency) the faint word with
// a hollow dot and no clock. <local-time since> ticks the clock in the
// browser; its server text is fixed so a poll's footer never differs and the
// canvas stream does not resend it.
templ progress(f FooterView) {
	{{ w := progressWord(f) }}
	if f.Under == "running" && f.Job != "stop" {
		@line("success", "Online")
		<span class="text-xs text-rw-faint tabular-nums shrink-0">{ "updating " }@clock(f)</span>
	} else if f.Status == "queued" || strings.HasPrefix(w, "Waiting for ") {
		@mark("faint", w, true, false)
	} else {
		@mark("warn", w, false, true)
		<span class="text-xs text-rw-faint tabular-nums shrink-0">@clock(f)</span>
	}
}

templ clock(f FooterView) {
	<local-time since={ f.Since.UTC().Format(time.RFC3339) }>00:00</local-time>
}

templ line(tone, text string) {
	@mark(tone, text, false, false) {
		{ children... }
	}
}

// mark is line with the dot of a phase: hollow while it waits, a spinner
// while it runs.
templ mark(tone, text string, hollow, spin bool) {
	<span class={ "node-status flex items-center gap-2 text-xs", toneText(tone) }>
		if spin {
			<span class={ "h-3 w-3 rounded-full shrink-0 border-2 border-t-transparent animate-spin", toneBorder(tone) } aria-hidden="true"></span>
		} else if hollow {
			<span class={ "h-1.5 w-1.5 rounded-full shrink-0 border", toneBorder(tone) } aria-hidden="true"></span>
		} else {
			<span class={ "h-1.5 w-1.5 rounded-full shrink-0", toneDot(tone) }></span>
		}
		<span class="truncate">{ text }{ children... }</span>
	</span>
}

// exposure is the globe and the first domain, or on the org canvas how
// many (v0 nodeExposure); the canvas's "badges" look shows it. A drill-down
// card is itself a link, so its host is plain text: a nested anchor would
// split the card.
templ exposure(f FooterView) {
	<span class="node-exposure flex items-center gap-1 text-xs text-rw-accentHi min-w-0">
		<svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
			@glyph("proxy")
		</svg>
		if f.Domain == "" {
			<span class="shrink-0" title="proxied domains. Open the stack to see them">{ domains(f.Domains) }</span>
		} else if f.Nav {
			<span class="truncate">{ f.Domain }</span>
		} else {
			<a href={ templ.SafeURL("https://" + f.Domain) } target="_blank" rel="noopener" class="truncate hover:underline">{ f.Domain }</a>
		}
		if f.More > 0 {
			<span class="shrink-0 text-rw-faint">+{ itoa(f.More) }</span>
		}
	</span>
}

// Subs are a card's sub-tiles, dealt under it like the next cards of a
// deck (CSS offsets each by its place). Each is a static <graph-node>
// with its own drawer; the canvas measures them in place.
templ Subs(v CardView) {
	for _, s := range v.Subs {
		<graph-node node-id={ s.ID } static>
			<div
				class="graph-node-sub relative h-full rounded-xl border cursor-pointer bg-rw-inset border-rw-border hover:border-rw-accent/60"
				data-kind={ s.Kind }
				if s.Drawer != "" {
					hx-get={ s.Drawer }
					hx-target="#drawer-body"
					hx-push-url={ templ.SafeURL("?drawer=" + s.ID + "&tab=" + s.Tab) }
					tabindex="0"
					role="button"
				}
			>
				<div class="absolute inset-x-0 bottom-0 flex h-7 items-center gap-2 px-3 min-w-0 text-rw-muted">
					if s.Kind == "replica" {
						<span class={ "h-1.5 w-1.5 rounded-full shrink-0", toneDot(replica(s.Status)) }></span>
					} else {
						<svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							@glyph(s.Kind)
						</svg>
					}
					<span class="text-xs font-medium text-rw-text truncate shrink-0 max-w-[65%]">{ s.Label }</span>
					if s.NoBackup {
						<span class="text-[10px] text-rw-faint truncate ml-auto">No backup</span>
						<span class="text-[10px] text-rw-faint font-mono truncate">{ s.Detail }</span>
					} else {
						<span class="text-[10px] text-rw-faint font-mono truncate ml-auto">{ s.Detail }</span>
					}
				</div>
			</div>
		</graph-node>
	}
}

// Icon is a kind's 16 px stroke glyph (v0 strokeIcon).
templ Icon(kind string) {
	<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		@glyph(kind)
	</svg>
}

templ glyph(kind string) {
	switch kind {
		case "volume":
			<path d="M22 12H2"></path>
			<path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path>
			<line x1="6" x2="6.01" y1="16" y2="16"></line>
		case "cron":
			<circle cx="12" cy="12" r="10"></circle>
			<path d="M12 6v6l4 2"></path>
		case "function":
			<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
		case "proxy", "internet":
			<circle cx="12" cy="12" r="10"></circle>
			<path d="M2 12h20M12 2a15.3 15.3 0 0 1 0 20 15.3 15.3 0 0 1 0-20z"></path>
		case "operated", "ref":
			<ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
			<path d="M3 5v14a9 3 0 0 0 18 0V5"></path>
			<path d="M3 12a9 3 0 0 0 18 0"></path>
		case "slice":
			<ellipse cx="12" cy="7" rx="9" ry="3"></ellipse>
			<path d="M3 7v10a9 3 0 0 0 18 0V7"></path>
		case "vars", "secrets":
			<path d="M4 7V5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v2"></path>
			<path d="M9 20h6"></path>
			<path d="M12 4v16"></path>
		case "connector":
			<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
			<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
		case "org":
			<path d="M3 21h18"></path>
			<path d="M5 21V5a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v16"></path>
			<path d="M15 21V9h3a1 1 0 0 1 1 1v11"></path>
			<path d="M8 8h4M8 12h4M8 16h4"></path>
		case "stack", "env":
			<path d="m12 2 9 5-9 5-9-5 9-5Z"></path>
			<path d="m3 12 9 5 9-5"></path>
			<path d="m3 17 9 5 9-5"></path>
		default:
			<path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
			<path d="m3.3 7 8.7 5 8.7-5"></path>
			<path d="M12 22V12"></path>
	}
}

// Lanes is the traffic layer the "traffic" event replaces whole: one <g>
// per direction, a path (the stroke width is the rate) and its rate label.
// The canvas lays each on the edge it rides (either way round) and fills
// the arrow; a whole <svg> parses into the SVG namespace, bare paths would
// not.
templ Lanes(ls []Lane) {
	<svg data-lanes id="graph-lanes" aria-hidden="true" sse-swap="traffic" hx-target="this" hx-swap="outerHTML">
		for _, l := range ls {
			<g data-from={ l.From } data-to={ l.To }>
				<path data-edge-kind="traffic" d="M0,0" fill="none" stroke-linecap="round" stroke-width={ l.Width() }></path>
				<text><tspan></tspan>{ Rate(l.BPS) }</text>
			</g>
		}
	</svg>
}
