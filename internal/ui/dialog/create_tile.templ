package dialog

import c "github.com/FyrmForge/stackr/internal/ui/components"

// CreateTileView is the create-tile form. Source picks the fields: image
// (a ref), service (a repo: connector + URL; it builds from the env's branch), cron (image +
// schedule), function (image + trigger), managed (an engine). Switching
// the source re-GETs the form with the typed values kept. ponytail: the
// repo pick is a URL field (a private repo goes through the connector for
// its host); no verb lists a connector's repos yet.
type CreateTileView struct {
	Action     string // POST
	Switch     string // GET that re-renders the form for another source
	Source     string
	Name       string
	Image      string
	Hosts      string // the org's connector hosts, for the repo field's help
	GitURL     string
	Schedule   string
	Trigger    string
	Command    string
	Engine     string
	From       string            // slice: provision_from
	Access     string            // slice: default_access
	Errors     map[string]string // field -> message; "general" = the form's
	FromFile   bool              // the stack runs from a stack file: a promote drops what it lacks
}

type Option struct{ Value, Label string }

func hostsHelp(hosts string) string {
	if hosts == "" {
		return "Builds from this environment's branch; a private repo needs a connector."
	}
	return "Builds from this environment's branch; private repos on " + hosts + " clone through the org's connector."
}

// Sources are the create form's source switch.
var Sources = []Option{{"image", "Image"}, {"service", "Repo"}, {"cron", "Cron"}, {"function", "Function"}, {"managed", "Managed"}, {"slice", "Slice"}}

templ CreateTile(v CreateTileView) {
	<form id="create-tile" hx-post={ v.Action } hx-target="#create-tile" hx-swap="outerHTML">
		@c.DrawerHead("New tile", "")
		<div class="p-6 space-y-4">
			if v.FromFile {
				<p class="text-sm text-rw-warn">This stack runs from its stack file. The next promote removes apps that are not in it.</p>
			}
			@c.FormError(v.Errors["general"])
			<fieldset class="flex flex-wrap gap-3 text-sm" hx-get={ v.Switch } hx-trigger="change" hx-include="#create-tile" hx-target="#create-tile" hx-swap="outerHTML">
				<legend class="label">Source</legend>
				for _, s := range Sources {
					<label class="flex items-center gap-1">
						<input type="radio" name="source" value={ s.Value } checked?={ s.Value == v.Source }/> { s.Label }
					</label>
				}
			</fieldset>
			@c.Field(c.FieldView{Name: "name", Label: "Name", Value: v.Name, Required: true, Error: v.Errors["name"]})
			switch v.Source {
				case "service":
					@c.Field(c.FieldView{Name: "git_url", Label: "Repo URL", Value: v.GitURL, Placeholder: "https://git.example.com/acme/api", Required: true, Help: hostsHelp(v.Hosts), Error: v.Errors["git_url"]})
				case "managed":
					<div>
						<label for="engine" class="label">Engine</label>
						<select id="engine" name="engine" class="input" { c.Invalid("engine", v.Errors["engine"])... }>
							<option value="postgres" selected?={ v.Engine != "s3" }>postgres</option>
							<option value="s3" selected?={ v.Engine == "s3" }>s3</option>
						</select>
						@c.FieldError("engine", v.Errors["engine"])
					</div>
				case "slice":
					@c.Field(c.FieldView{Name: "provision_from", Label: "Provision from", Value: v.From, Placeholder: "infra:${{ env.name }}:pg-db", Required: true, Help: "The managed tile to cut it from: stack:env:tile.", Error: v.Errors["provision_from"]})
					<div>
						<label for="default_access" class="label">Default access</label>
						<select id="default_access" name="default_access" class="input" { c.Invalid("default_access", v.Errors["default_access"])... }>
							<option value="write" selected?={ v.Access != "read" }>write</option>
							<option value="read" selected?={ v.Access == "read" }>read</option>
						</select>
						@c.FieldError("default_access", v.Errors["default_access"])
					</div>
				default:
					@c.Field(c.FieldView{Name: "image_ref", Label: "Image", Value: v.Image, Placeholder: "nginx:1", Required: true, Error: v.Errors["image_ref"]})
			}
			if v.Source != "managed" && v.Source != "slice" {
				@c.Field(c.FieldView{Name: "command", Label: "Command", Value: v.Command, Placeholder: "echo hi", Help: "Optional; replaces the image's command. Split like a shell line.", Error: v.Errors["command"]})
			}
			if v.Source == "cron" {
				@c.Field(c.FieldView{Name: "schedule", Label: "Schedule", Value: v.Schedule, Placeholder: "0 3 * * *", Required: true, Help: "Cron, five fields.", Error: v.Errors["schedule"]})
			}
			if v.Source == "function" {
				<div>
					<label for="trigger" class="label">Runs</label>
					<select id="trigger" name="trigger" class="input">
						<option value="manual" selected?={ v.Trigger != "on_deploy" }>manually</option>
						<option value="on_deploy" selected?={ v.Trigger == "on_deploy" }>on every deploy</option>
					</select>
				</div>
			}
			@c.Submit("Create")
		</div>
	</form>
}
