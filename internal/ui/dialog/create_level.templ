package dialog

import c "github.com/FyrmForge/stackr/internal/ui/components"

// CreateLevelView is the create form of a stack or an env: a name and,
// for an env, where its releases come from. A refusal re-renders it (422)
// with the field marked; success redirects to the new card's page. An org
// is the setup wizard's.
type CreateLevelView struct {
	Kind   string // stack | env
	Action string
	Name   string
	From   string // env: branch | promote
	Branch string
	Errors map[string]string // field -> message; "general" = the form's
}

func (v CreateLevelView) id() string { return "create-" + v.Kind }

templ CreateLevel(v CreateLevelView) {
	<form id={ v.id() } hx-post={ v.Action } hx-target={ "#" + v.id() } hx-swap="outerHTML">
		@c.DrawerHead("New "+v.Kind, "")
		<div class="p-6 space-y-4">
			@c.FormError(v.Errors["general"])
			@c.Field(c.FieldView{Name: "name", Label: "Name", Value: v.Name, Required: true, Error: v.Errors["name"]})
			if v.Kind == "env" {
				<fieldset class="space-y-2 text-sm">
					<legend class="label">Releases come from</legend>
					<label class="flex items-center gap-2"><input type="radio" name="from" value="branch" checked?={ v.From != "promote" }/> a branch</label>
					<label class="flex items-center gap-2"><input type="radio" name="from" value="promote" checked?={ v.From == "promote" }/> promotion from the rung below</label>
				</fieldset>
				@c.Field(c.FieldView{Name: "branch", Label: "Branch", Value: v.Branch, Placeholder: "main", Error: v.Errors["branch"]})
			}
			@c.Submit("Create")
		</div>
	</form>
}

// InstallConnectorView is the two-step GitHub App install: the org to
// install on, then (Action set) a form that posts the app manifest to
// GitHub, which calls stackr back.
type InstallConnectorView struct {
	Begin    string // POST github_org
	Error    string
	Action   string // GitHub's manifest URL; "" = step one
	Manifest string
}

templ InstallConnector(v InstallConnectorView) {
	<div id="install-connector">
		@c.DrawerHead("Install a GitHub connector", "")
		<div class="p-6 space-y-4">
			@c.FormError(v.Error)
			if v.Action == "" {
				<form hx-post={ v.Begin } hx-target="#install-connector" hx-swap="outerHTML" class="space-y-4">
					@c.Field(c.FieldView{Name: "github_org", Label: "GitHub org", Placeholder: "acme", Help: "Empty = your personal account."})
					@c.Submit("Continue")
				</form>
			} else {
				// templint:ignore no-native-form-actions -- GitHub's manifest flow requires a browser form POST
				<form method="post" action={ templ.SafeURL(v.Action) } class="space-y-4">
					<input type="hidden" name="manifest" value={ v.Manifest }/>
					<p class="text-sm text-rw-muted">GitHub creates the app, then sends you back here.</p>
					@c.Submit("Continue on GitHub")
				</form>
			}
		</div>
	</div>
}
