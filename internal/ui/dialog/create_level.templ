package dialog

import c "github.com/FyrmForge/stackr/internal/ui/components"

// CreateLevelView is the create form of a stack or an env: a name and,
// for an env, where its releases come from. A refusal re-renders it (422)
// with the field marked; success redirects to the new card's page. An org
// is the setup wizard's.
type CreateLevelView struct {
	Kind   string // stack | env
	Action string
	Name   string
	From   string // env: branch | promote
	First  bool   // env: the stack's first, which can only build a branch
	Branch string
	Errors map[string]string // field -> message; "general" = the form's
}

func (v CreateLevelView) id() string { return "create-" + v.Kind }

templ CreateLevel(v CreateLevelView) {
	<form id={ v.id() } hx-post={ v.Action } hx-target={ "#" + v.id() } hx-swap="outerHTML">
		@c.DrawerHead("New "+v.Kind, "")
		<div class="p-6 space-y-4">
			@c.FormError(v.Errors["general"])
			@c.Field(c.FieldView{Name: "name", Label: "Name", Value: v.Name, Required: true, Error: v.Errors["name"]})
			if v.Kind == "env" {
				<fieldset class="space-y-2 text-sm">
					<legend class="label">Releases come from</legend>
					<label class="flex items-center gap-2"><input type="radio" name="from" value="branch" checked?={ v.From != "promote" }/> a branch</label>
					if !v.First {
						<label class="flex items-center gap-2"><input type="radio" name="from" value="promote" checked?={ v.From == "promote" }/> promotion from the rung below</label>
					}
				</fieldset>
				@c.Field(c.FieldView{Name: "branch", Label: "Branch", Value: v.Branch, Help: "Pushes to this branch build the environment.", Error: v.Errors["branch"]})
			}
			@c.Submit("Create")
		</div>
	</form>
}

