// Package dns is the DNS connector screens, the same in Admin, the org
// drawer and the setup wizard: Namecheap's steps in the add dialog, and a
// connector's settings dialog with its domains.
package dns

import (
	"encoding/json"
	"strconv"
	"strings"

	c "github.com/FyrmForge/stackr/internal/ui/components"
	"github.com/FyrmForge/stackr/internal/ui/connectors"
)

// AddView is Namecheap's screens in the add dialog. Domains set = the
// account is connected: pick the domains.
type AddView struct {
	Back        string // GET the kind picker; "" = opened straight on Namecheap
	Add         string // POST user, key, ip
	User        string // kept on a refused add; the key never is
	IP          string // prefilled with stackr's public IPv4 when known
	Errors      map[string]string
	ID, Domains string
}

var steps = []string{"API access", "Account", "Allow list", "Check", "Domains"}

// start is the step shown first: the one holding the first error.
func (v AddView) start() int {
	switch {
	case v.Errors["user"] != "" || v.Errors["key"] != "":
		return 2
	case v.Errors["ip"] != "":
		return 3
	case len(v.Errors) > 0:
		return 4
	}
	return 1
}

// Missing names every field an add refused, for the line over the steps:
// the fields sit on different steps.
func Missing(errs map[string]string) string {
	var out []string
	for _, f := range []struct{ key, label string }{{"user", "Namecheap username"}, {"key", "API key"}, {"ip", "Server IPv4"}} {
		if errs[f.key] != "" {
			out = append(out, f.label)
		}
	}
	if len(out) == 0 {
		return ""
	}
	return "Check these fields: " + strings.Join(out, ", ") + "."
}

// SettingsView is a connector's settings dialog: its domains, and Remove
// (Delete.Action "" = none).
type SettingsView struct {
	ID, Domains string
	Delete      c.ConfirmView
}

// DomainsView is a connector's account: every domain and its state.
type DomainsView struct {
	ID     string // the connector, for the swap target
	Error  string
	Note   string
	Shared bool // a server connector: managed domains say who may use them
	Rows   []DomainRow
}

// DomainRow is one domain. State is managed, not_managed or
// dns_elsewhere; the action URLs post domain (and org, confirm).
type DomainRow struct {
	Name, State                string
	Manage, Unmanage, TakeOver string
	All                        bool
	Orgs                       []Org
}

// Org is an organization and whether a domain is available to it.
type Org struct {
	ID, Name string
	On       bool
}

func listID(id string) string { return "dns-domains-" + id }

func vals(m map[string]string) string {
	b, _ := json.Marshal(m)
	return string(b)
}

templ stepLine(n int) {
	<p class="text-xs text-rw-faint">Step { strconv.Itoa(n) } of { strconv.Itoa(len(steps)) }: { steps[n-1] }</p>
}

// Add is Namecheap's screens. Steps 1 to 4 are one form posted at
// Connect, so the API key never comes back from the server.
templ Add(v AddView) {
	<div id={ connectors.BodyID }>
		if v.Domains != "" {
			<div class="modal-body">
				@stepLine(5)
				<p>Connected. Pick the domains stackr manages.</p>
				@Load(v.ID, v.Domains)
			</div>
			<div class="modal-foot">
				<button type="button" class="btn btn-primary btn-sm" data-cancel>Done</button>
			</div>
		} else {
			<form hx-post={ v.Add } hx-target={ "#" + connectors.BodyID } hx-swap="outerHTML" novalidate>
				if Missing(v.Errors) != "" || v.Errors["general"] != "" {
					<div class="px-5 pt-4 space-y-2">
						@c.FormError(Missing(v.Errors))
						@c.FormError(v.Errors["general"])
					</div>
				}
				<div>
					<section data-step hidden?={ v.start() != 1 }>
						<div class="modal-body">
							@stepLine(1)
							<p>Turn on API access in Namecheap.</p>
							<ol class="list-decimal pl-5 space-y-1">
								<li>Open Profile, Tools, Business & Dev Tools, Namecheap API Access.</li>
								<li>Turn API access on and copy the API key.</li>
							</ol>
						</div>
						<div class="modal-foot">
							if v.Back != "" {
								<button type="button" class="btn btn-ghost btn-sm mr-auto" hx-get={ v.Back } hx-target={ "#" + connectors.BodyID } hx-swap="outerHTML">Back</button>
							}
							<button type="button" class="btn btn-primary btn-sm" data-next>Next</button>
						</div>
					</section>
					<section data-step hidden?={ v.start() != 2 }>
						<div class="modal-body">
							@stepLine(2)
							@c.Field(c.FieldView{Name: "user", Label: "Namecheap username", Value: v.User, Required: true, Error: c.GetError(v.Errors, "user"), Autocomplete: "off"})
							@c.Field(c.FieldView{Name: "key", Label: "API key", Type: "password", Required: true, Help: "Controls your whole Namecheap account.", Error: c.GetError(v.Errors, "key"), Autocomplete: "off"})
						</div>
						@nav()
					</section>
					<section data-step hidden?={ v.start() != 3 }>
						<div class="modal-body">
							@stepLine(3)
							@c.Field(c.FieldView{Name: "ip", Label: "Server IPv4", Value: v.IP, Required: true, Help: "Add this IP to Namecheap's API allow list.", Error: c.GetError(v.Errors, "ip")})
							<p class="text-xs text-rw-faint">Behind NAT, use your router's public IPv4.</p>
						</div>
						@nav()
					</section>
					<section data-step hidden?={ v.start() != 4 }>
						<div class="modal-body">
							@stepLine(4)
							<p>stackr asks Namecheap for your domains to check the account.</p>
						</div>
						<div class="modal-foot">
							<button type="button" class="btn btn-ghost btn-sm mr-auto" data-back>Back</button>
							<button type="submit" class="btn btn-primary btn-sm">Connect</button>
						</div>
					</section>
				</div>
			</form>
		}
	</div>
}

templ nav() {
	<div class="modal-foot">
		<button type="button" class="btn btn-ghost btn-sm mr-auto" data-back>Back</button>
		<button type="button" class="btn btn-primary btn-sm" data-next>Next</button>
	</div>
}

// Load is a connector's domain list, asked of the provider as it lands.
templ Load(id, url string) {
	<div id={ listID(id) } hx-post={ url } hx-trigger="load" hx-swap="outerHTML" aria-busy="true" class="text-xs text-rw-faint">Asking Namecheap…</div>
}

// Settings is a DNS connector's settings dialog body.
templ Settings(v SettingsView) {
	<div id={ connectors.BodyID }>
		<div class="modal-body">
			@Load(v.ID, v.Domains)
		</div>
		<div class="modal-foot">
			if v.Delete.Action != "" {
				<span class="mr-auto">
					@c.Confirm(v.Delete)
				</span>
			}
			<button type="button" class="btn btn-ghost btn-sm" data-cancel>Close</button>
		</div>
	</div>
}

func stateWord(s string) (string, string) {
	switch s {
	case "managed":
		return "Managed", "success"
	case "dns_elsewhere":
		return "DNS elsewhere", "warn"
	}
	return "Not managed", ""
}

// Domains is a connector's domain list; every action answers it again.
templ Domains(v DomainsView) {
	<div id={ listID(v.ID) } class="space-y-2">
		if v.Error != "" {
			<p class="text-sm text-rw-danger" role="alert">{ v.Error }</p>
		}
		if v.Note != "" {
			<p class="text-sm text-rw-success" role="status">{ v.Note }</p>
		}
		if len(v.Rows) == 0 && v.Error == "" {
			<p class="text-sm text-rw-faint">No domains on this account.</p>
		}
		<ul class="space-y-2">
			for _, d := range v.Rows {
				<li class="border-t border-rw-border pt-2 space-y-2">
					<div class="flex flex-wrap items-center gap-2">
						<span class="font-mono text-xs text-rw-text">{ d.Name }</span>
						@stateChip(d.State)
						<span class="ml-auto flex gap-2">
							if d.Manage != "" && d.State == "not_managed" {
								<button type="button" class="btn btn-ghost btn-sm" hx-post={ d.Manage } hx-vals={ vals(map[string]string{"domain": d.Name}) } hx-target={ "#" + listID(v.ID) } hx-swap="outerHTML">Manage</button>
							}
							if d.Unmanage != "" && d.State == "managed" {
								@c.Confirm(c.ConfirmView{Button: "Stop managing", Quiet: true, Title: "Stop managing " + d.Name + "?", Warning: "stackr deletes the records it made. Other records stay.", Action: d.Unmanage, Target: "#" + listID(v.ID), Vals: vals(map[string]string{"domain": d.Name})})
							}
							if d.TakeOver != "" && d.State == "dns_elsewhere" {
								@c.Confirm(c.ConfirmView{
									Button:  "Take over DNS",
									Quiet:   true,
									Title:   "Switch " + d.Name + " to Namecheap DNS?",
									Warning: "Records at its current DNS host stop applying. Copy any you need first.",
									Kept:    []string{"The domain stays registered to you."},
									Word:    d.Name,
									Action:  d.TakeOver,
									Target:  "#" + listID(v.ID),
									Vals:    vals(map[string]string{"domain": d.Name, "confirm": d.Name}),
								})
							}
						</span>
					</div>
					if v.Shared && d.State == "managed" && d.Manage != "" && len(d.Orgs) == 0 {
						<p class="text-xs text-rw-faint">Available to every organization.</p>
					}
					if v.Shared && d.State == "managed" && d.Manage != "" && len(d.Orgs) > 0 {
						<form hx-post={ d.Manage } hx-target={ "#" + listID(v.ID) } hx-swap="outerHTML" class="space-y-1">
							<input type="hidden" name="domain" value={ d.Name }/>
							<fieldset class="space-y-1">
								<legend class="label">Available to</legend>
								for _, o := range d.Orgs {
									<label class="flex items-center gap-2 text-rw-text"><input type="checkbox" name="org" value={ o.ID } checked?={ o.On } class="accent-rw-accent"/> { o.Name }</label>
								}
								<p class="text-xs text-rw-faint">None ticked: every organization.</p>
							</fieldset>
							<button type="submit" class="btn btn-ghost btn-sm">Save</button>
						</form>
					}
				</li>
			}
		</ul>
	</div>
}

templ stateChip(state string) {
	{{ word, tone := stateWord(state) }}
	@c.Chip(word, tone)
}

