// Package dns is the DNS capability's section of a connector's screens,
// the same for every DNS kind in Admin, the org drawer and the setup
// wizard: its domain list in the settings dialog, and the add dialog's last
// step that picks the domains.
package dns

import (
	"cmp"
	"encoding/json"
	"strconv"

	c "github.com/FyrmForge/stackr/internal/ui/components"
	"github.com/FyrmForge/stackr/internal/ui/connectors"
)

// Title is the add dialog's step this capability adds after connecting.
const Title = "Domains"

// DomainsView is a connector's account: every domain and its state.
// Provider is the kind as the copy names it.
type DomainsView struct {
	ID       string // the connector, for the swap target
	Provider string
	Error    string
	Note     string
	Shared   bool // a server connector: managed domains say who may use them
	InUse    templ.Component // a refusal that lists where a domain is used, linked; nil = Error alone
	Rows     []DomainRow
	Plan     *PlanView // the confirm that comes before managing a domain; nil = none
	Suggest  []Suggestion // the setup card: a domain the panel or the tiles sit on
}

// Suggestion offers managing Host (the panel address when Panel, else the
// root for tiles) on Domain, a domain of the account. Sub is Host under
// Domain, "" = the domain itself. Preview posts domain, part and under;
// NotNow is the list without the card.
type Suggestion struct {
	Domain, Host, Sub string
	Panel             bool
	Preview, NotNow   string
}

// PlanView is the confirm before managing Domain: what to manage (all of
// it, or only under Under), the records stackr writes, the ones already in
// the zone it may adopt and the ones outside the scope it leaves alone.
// Preview posts the scope form again; Manage posts domain, part, under and
// the ticked adopt values ("" = a scope refused, UnderError says why).
type PlanView struct {
	Domain     string
	Under      string // the name under Domain typed, "" = the whole domain
	Scope      string // Under in full, "" = the whole domain
	UnderError string
	Preview    string
	Manage     string
	Writes     []PlanWrite
	Adopt      []PlanAdopt
	LeftAlone  []PlanWrite
}

// PlanWrite is a record stackr writes now.
type PlanWrite struct{ Host, Type, Value string }

// PlanAdopt is an existing record stackr may adopt. Value is the form
// value the service reads back; On starts it ticked.
type PlanAdopt struct {
	Host, Type, Address, Value string
	On                         bool
}

// DomainRow is one domain. State is managed, not_managed or
// dns_elsewhere; the action URLs post domain (and org, confirm). Scope is
// the name a managed domain is managed under, "" = all of it.
type DomainRow struct {
	Name, State, Scope         string
	Manage, Unmanage, TakeOver string
	Preview                    string // the confirm before managing; posts domain
	All                        bool
	Orgs                       []Org
}

// Org is an organization and whether a domain is available to it.
type Org struct {
	ID, Name string
	On       bool
}

func listID(id string) string { return "dns-domains-" + id }

// leftAlone reads "3 records outside stackr.example.com".
func leftAlone(p PlanView) string {
	if len(p.LeftAlone) == 1 {
		return "1 record outside " + p.Scope + ". stackr never changes it."
	}
	return strconv.Itoa(len(p.LeftAlone)) + " records outside " + p.Scope + ". stackr never changes them."
}

// share is a managed domain's "Available to": every org when none is
// ticked, as the service reads an empty list.
func share(v DomainsView, d DomainRow) connectors.ShareView {
	sv := connectors.ShareView{ID: listID(v.ID) + "-" + d.Name, Action: d.Manage, Target: "#" + listID(v.ID), Hidden: map[string]string{"domain": d.Name}, All: true}
	for _, o := range d.Orgs {
		sv.Orgs = append(sv.Orgs, connectors.ShareOrg{ID: o.ID, Name: o.Name, On: o.On})
		if o.On {
			sv.All = false
		}
	}
	return sv
}

// planVals is what the plan's Manage posts.
func planVals(p PlanView) string {
	part := "all"
	if p.Under != "" {
		part = "under"
	}
	return vals(map[string]string{"domain": p.Domain, "part": part, "under": p.Under})
}

func planTitle(p PlanView) string {
	if p.Scope != "" {
		return "Manage " + p.Scope + "?"
	}
	return "Manage " + p.Domain + "?"
}

func vals(m map[string]string) string {
	b, _ := json.Marshal(m)
	return string(b)
}

// Connected is the add dialog's last step: pick the domains.
templ Connected(id, url, provider string) {
	<p>Connected. Pick the domains stackr manages.</p>
	@Load(id, url, provider)
}

// Load is a connector's domain list, asked of the provider as it lands:
// the settings dialog's section.
templ Load(id, url, provider string) {
	<div id={ listID(id) } hx-post={ url } hx-trigger="load" hx-swap="outerHTML" aria-busy="true" class="text-xs text-rw-faint">Asking { provider }…</div>
}

func stateWord(s string) (string, string) {
	switch s {
	case "managed":
		return "Managed", "success"
	case "dns_elsewhere":
		return "DNS elsewhere", "warn"
	}
	return "Not managed", ""
}

// Domains is a connector's domain list; every action answers it again.
templ Domains(v DomainsView) {
	<div id={ listID(v.ID) } class="space-y-2">
		if v.InUse != nil {
			@v.InUse
		} else if v.Error != "" {
			<p class="text-sm text-rw-danger" role="alert">{ v.Error }</p>
		}
		if v.Note != "" {
			<p class="text-sm text-rw-success" role="status">{ v.Note }</p>
		}
		if len(v.Rows) == 0 && v.Error == "" {
			<p class="text-sm text-rw-faint">No domains on this account.</p>
		}
		for _, s := range v.Suggest {
			@suggestion(v, s)
		}
		if v.Plan != nil {
			@c.Confirm(c.ConfirmView{
				Open:    true,
				Primary: true,
				Button:  "Manage",
				Title:   planTitle(*v.Plan),
				Action:  v.Plan.Manage,
				Target:  "#" + listID(v.ID),
				Vals:    planVals(*v.Plan),
				Include: "input[name=adopt]:checked",
				Body:    plan(v, *v.Plan),
			})
		}
		<ul class="space-y-2">
			for _, d := range v.Rows {
				<li class="border-t border-rw-border pt-2 space-y-2">
					<div class="flex flex-wrap items-center gap-2">
						<span class="font-mono text-xs text-rw-text">{ d.Name }</span>
						@stateChip(d.State)
						if d.State == "managed" && d.Scope != "" {
							<span class="text-xs text-rw-muted">under <span class="font-mono">{ d.Scope }</span></span>
						}
						<span class="ml-auto flex gap-2">
							if d.Manage != "" && d.State == "not_managed" {
								<button type="button" class="btn btn-ghost btn-sm" hx-post={ cmp.Or(d.Preview, d.Manage) } hx-vals={ vals(map[string]string{"domain": d.Name}) } hx-target={ "#" + listID(v.ID) } hx-swap="outerHTML">Manage</button>
							}
							if d.Unmanage != "" && d.State == "managed" {
								@c.Confirm(c.ConfirmView{Button: "Stop managing", Quiet: true, Title: "Stop managing " + d.Name + "?", Warning: "stackr deletes the tile records it made. Other records stay, the panel and node records too.", Action: d.Unmanage, Target: "#" + listID(v.ID), Vals: vals(map[string]string{"domain": d.Name})})
							}
							if d.TakeOver != "" && d.State == "dns_elsewhere" {
								@c.Confirm(c.ConfirmView{
									Button:  "Take over DNS",
									Quiet:   true,
									Title:   "Switch " + d.Name + " to " + v.Provider + " DNS?",
									Warning: "Records at its current DNS host stop applying. Copy any you need first.",
									Kept:    []string{"The domain stays registered to you."},
									Word:    d.Name,
									Action:  d.TakeOver,
									Target:  "#" + listID(v.ID),
									Vals:    vals(map[string]string{"domain": d.Name, "confirm": d.Name}),
								})
							}
						</span>
					</div>
					if v.Shared && d.State == "managed" && d.Manage != "" {
						@connectors.Share(share(v, d))
					}
				</li>
			}
		</ul>
	</div>
}

templ stateChip(state string) {
	{{ word, tone := stateWord(state) }}
	@c.Chip(word, tone)
}

// suggestion is the setup card: manage the part of a domain the panel or
// the tiles sit on, all of it, or not now.
templ suggestion(v DomainsView, s Suggestion) {
	<div class="panel px-4 py-3 space-y-2">
		if s.Panel {
			<p class="text-sm text-rw-text">Your panel runs at <span class="font-mono">{ s.Host }</span>, on { s.Domain } in this account.</p>
		} else {
			<p class="text-sm text-rw-text">Your tiles go under <span class="font-mono">{ s.Host }</span>, on { s.Domain } in this account.</p>
		}
		if s.Sub != "" {
			<p class="text-sm text-rw-muted">Let stackr manage { s.Host } and everything under it? Your other { s.Domain } records stay untouched.</p>
		} else {
			<p class="text-sm text-rw-muted">Let stackr manage { s.Domain }?</p>
		}
		<div class="flex flex-wrap gap-2">
			<button type="button" class="btn btn-primary btn-sm" hx-post={ s.Preview } hx-vals={ vals(map[string]string{"domain": s.Domain, "part": "under", "under": s.Sub}) } hx-target={ "#" + listID(v.ID) } hx-swap="outerHTML">Manage { s.Host }</button>
			if s.Sub != "" {
				<button type="button" class="btn btn-ghost btn-sm" hx-post={ s.Preview } hx-vals={ vals(map[string]string{"domain": s.Domain, "part": "all"}) } hx-target={ "#" + listID(v.ID) } hx-swap="outerHTML">Manage all of { s.Domain }</button>
			}
			<button type="button" class="btn btn-ghost btn-sm" hx-post={ s.NotNow } hx-vals={ vals(map[string]string{"not_now": "1"}) } hx-target={ "#" + listID(v.ID) } hx-swap="outerHTML">Not now</button>
		</div>
	</div>
}

// scopeForm is the plan's first question: all of the domain, or only a
// name under it. Changing it asks for the plan again.
templ scopeForm(v DomainsView, p PlanView) {
	<form hx-post={ p.Preview } hx-target={ "#" + listID(v.ID) } hx-swap="outerHTML" class="space-y-2" novalidate>
		<input type="hidden" name="domain" value={ p.Domain }/>
		<fieldset class="space-y-1">
			<legend class="label">What stackr manages</legend>
			<label class="flex items-center gap-2 text-sm text-rw-text"><input type="radio" name="part" value="all" checked?={ p.Under == "" && p.UnderError == "" } class="accent-rw-accent"/> All of { p.Domain }</label>
			<label class="flex flex-wrap items-center gap-2 text-sm text-rw-text">
				<input type="radio" name="part" value="under" checked?={ p.Under != "" || p.UnderError != "" } class="accent-rw-accent"/> Only under
				<input type="text" name="under" value={ p.Under } aria-label={ "Name under " + p.Domain } placeholder="stackr" class="input !w-32 font-mono" { c.Invalid("under", p.UnderError)... }/>
				<span class="font-mono text-xs text-rw-muted">.{ p.Domain }</span>
			</label>
			@c.FieldError("under", p.UnderError)
		</fieldset>
		<button type="submit" class="btn btn-ghost btn-sm">Show what changes</button>
	</form>
}

// plan is the confirm's body: what to manage, what stackr writes, what it
// may adopt, then what it leaves alone.
templ plan(v DomainsView, p PlanView) {
	@scopeForm(v, p)
	if len(p.Writes) > 0 {
		<div>
			<p class="mb-1.5 text-xs font-medium text-rw-muted">stackr writes these now.</p>
			<ul class="modal-list">
				for _, w := range p.Writes {
					<li class="modal-list-row font-mono text-xs text-rw-text">{ w.Type } { w.Host } { w.Value }</li>
				}
			</ul>
		</div>
	}
	if len(p.Adopt) > 0 {
		<div>
			<p class="mb-1.5 text-xs font-medium text-rw-muted">Already in the zone and pointing at your nodes. Ticked ones follow your ingress and are never deleted.</p>
			<ul class="modal-list">
				for _, a := range p.Adopt {
					<li class="modal-list-row">
						<label class="flex items-center gap-2 font-mono text-xs text-rw-text">
							<input type="checkbox" name="adopt" value={ a.Value } checked?={ a.On }/>
							{ a.Type } { a.Host } { a.Address }
						</label>
					</li>
				}
			</ul>
		</div>
	}
	if len(p.Writes) == 0 && len(p.Adopt) == 0 && len(p.LeftAlone) == 0 && p.UnderError == "" {
		<p class="text-sm text-rw-muted">Nothing changes in the zone now.</p>
	}
	if len(p.LeftAlone) > 0 {
		<details>
			<summary class="cursor-pointer text-xs font-medium text-rw-muted">Left alone: { leftAlone(p) }</summary>
			<ul class="modal-list mt-1.5">
				for _, w := range p.LeftAlone {
					<li class="modal-list-row font-mono text-xs text-rw-text">{ w.Type } { w.Host } { w.Value }</li>
				}
			</ul>
		</details>
	}
}
