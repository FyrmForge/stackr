// Package placement is the Placement tab of an org, stack, env and tile:
// Runs on, Ingress and Exits, the exit ladder editor, the move dialog and the
// move progress view. The handler fills the views from the service; nothing
// here decides.
package placement

import (
	"strconv"
	"time"

	c "github.com/FyrmForge/stackr/internal/ui/components"
)

// Root is the id every answer replaces (outerHTML).
const Root = "placement"

func target() string { return "#" + Root }

// Option is a placement the viewer may pick. Hint is its fit, e.g.
// " (ingress, storage)" or " (offline)"; never a node name.
type Option struct{ ID, Name, Hint string }

// Rung is one exit in the ladder. Up and Down are the whole ladder after
// moving it; nil = at that end. State is in use, standby, down or "".
type Rung struct {
	NodeID, Name, State, Detail string
	Own                         bool
	Up, Down                    []string
}

// Offer is one row of the org's list of placements it may use.
type Offer struct {
	Name, Tags string
	Public     bool
	Online     bool
	Usable     bool
	Why        string
}

// View is the tab. Base is the placement route all actions hang off; ""
// means the viewer may not change anything.
type View struct {
	Base  string
	Scope string // org | stack | env | tile
	Error string // a refused action
	Note  string // what an action did

	// Runs on (not for a tile)
	RunsOn  bool
	Nodes   []Option        // the placements open to the org
	Pin     string          // picked placement; "" = inherit (org, stack)
	PinFrom string          // "From stack: eu-prod."
	Moving  string          // env: link to the progress tab while a move runs
	Offers  []Offer         // org: what it may use
	Move    templ.Component // env: the pin change dialog, when the pin moves it

	// Ingress
	Ingress     string
	IngressFrom string
	IngressOpts []Option        // placements tagged ingress
	IngressAsk  templ.Component // the question when a pick moves hosts

	// Exits
	Inherited bool
	ExitsFrom string
	Rungs     []Rung
	Spare     []Option // egress placements not in the ladder
	OwnListed bool
	NoNet     bool
	NoNetWhy  string
}

func (v View) editable() bool { return v.Base != "" }

templ Placement(v View) {
	<div id={ Root } class="space-y-6">
		<p class="text-sm text-rw-muted">Where it runs and how traffic gets in and out.</p>
		if v.Error != "" {
			<p class="banner banner-danger" role="alert">{ v.Error }</p>
		}
		if v.Note != "" {
			<p class="banner" role="status">{ v.Note }</p>
		}
		if v.RunsOn {
			@runsOn(v)
		}
		@ingress(v)
		@exits(v)
	</div>
}

templ runsOn(v View) {
	@c.Section("Runs on", v.Scope, "") {
		if v.Moving != "" {
			<p class="banner" role="status"><a href={ templ.SafeURL(v.Moving) } class="link">Moving: see progress</a></p>
		}
		<form if v.editable() { hx-post={ v.Base + "/pin" } } hx-target={ target() } hx-swap="outerHTML" class="flex flex-wrap items-center gap-2">
			<label for="runs-on" class="sr-only">Runs on</label>
			<select id="runs-on" name="placement" class="input w-auto max-w-full" disabled?={ !v.editable() }>
				if v.Scope != "env" {
					<option value="" selected?={ v.Pin == "" }>Inherit</option>
				}
				for _, n := range v.Nodes {
					<option value={ n.ID } selected?={ n.ID == v.Pin }>{ n.Name + n.Hint }</option>
				}
			</select>
			if v.editable() {
				<button type="submit" class="btn btn-primary btn-sm">Save</button>
			}
		</form>
		<p class="mt-2 text-xs text-rw-faint">
			if v.Scope == "env" {
				Changing it moves this env.
			} else {
				New envs below this start here. A change that moves a running env asks first.
			}
			if v.PinFrom != "" {
				{ " " + v.PinFrom }
			}
		</p>
		if v.Move != nil {
			@v.Move
		}
		if len(v.Offers) > 0 {
			@offers(v.Offers)
		}
	}
}

templ offers(rows []Offer) {
	<table class="mt-4 w-full text-sm">
		<caption class="text-left text-xs text-rw-faint pb-1">Placements this organization may use</caption>
		<thead>
			<tr class="text-left text-xs text-rw-faint">
				<th scope="col" class="font-normal pr-4">Name</th>
				<th scope="col" class="font-normal pr-4">Tags</th>
				<th scope="col" class="font-normal pr-4">Public IP</th>
				<th scope="col" class="font-normal pr-4">State</th>
			</tr>
		</thead>
		<tbody>
			for _, r := range rows {
				<tr>
					<td class="pr-4 text-rw-text whitespace-nowrap">{ r.Name }</td>
					<td class="pr-4 text-rw-muted">{ r.Tags }</td>
					<td class="pr-4 text-rw-muted">{ yesNo(r.Public) }</td>
					<td class="pr-4 text-rw-muted">
						if r.Usable {
							Usable
						} else {
							{ r.Why }
						}
					</td>
				</tr>
			}
		</tbody>
	</table>
}

func yesNo(b bool) string {
	if b {
		return "yes"
	}
	return "no"
}

templ ingress(v View) {
	@c.Section("Ingress", v.Scope, "") {
		<form if v.editable() { hx-post={ v.Base + "/ingress" } } hx-target={ target() } hx-swap="outerHTML" class="flex flex-wrap items-center gap-2">
			<label for="ingress-node" class="sr-only">Ingress</label>
			<select id="ingress-node" name="placement" class="input w-auto max-w-full" disabled?={ !v.editable() }>
				<option value="" selected?={ v.Ingress == "" }>Inherit</option>
				for _, n := range v.IngressOpts {
					<option value={ n.ID } selected?={ n.ID == v.Ingress }>{ n.Name + n.Hint }</option>
				}
			</select>
			if v.editable() {
				<button type="submit" class="btn btn-primary btn-sm">Save</button>
			}
		</form>
		<p class="mt-2 text-xs text-rw-faint">
			Public traffic comes in here.
			if v.IngressFrom != "" {
				{ " " + v.IngressFrom }
			}
		</p>
		if v.IngressAsk != nil {
			@v.IngressAsk
		}
	}
}

// IngressHostsView is the ingress save's question when the pick moves hosts
// to another proxy. Vals posts the pick again with confirm.
type IngressHostsView struct {
	Action, To, Vals string
	Hosts            []string
	DNS              DNSView
}

// IngressHosts asks before a pick moves hosts whose DNS points elsewhere.
templ IngressHosts(v IngressHostsView) {
	@c.Confirm(c.ConfirmView{
		Open:    true,
		Primary: true,
		Button:  "Save",
		Title:   "Serve these hosts from " + v.To + "?",
		Warning: "They stop answering until their DNS points at " + v.To + ".",
		Action:  v.Action,
		Target:  target(),
		Vals:    v.Vals,
		Include: v.DNS.Include(),
		Body:    hostsBody(v),
	})
}

templ hostsBody(v IngressHostsView) {
	if v.DNS.Empty() {
		@hostList(v.Hosts)
	} else {
		@DNS(v.DNS)
	}
}

// DNSRow is one record a hand-managed host needs.
type DNSRow struct{ Type, Name, Value string }

// DNSHost is one host in the move's DNS list. Rows are what a hand-managed
// host needs; Old, New and Connector are a managed host's repoint. Now is
// where it resolves now; OK, it matches.
type DNSHost struct {
	Host, Old, New, Now, Err string
	Note                     string // set: nothing to point at, listed apart
	Rows                     []DNSRow
	OK                       bool
}

// DNSView is the DNS list of a move: Hand the hosts the owner points,
// Managed the ones a connector repoints, which the repoint tick covers.
// CheckAction and CheckVals post the list back to look it up again.
type DNSView struct {
	Hand, Managed          []DNSHost
	Held                   []DNSHost // hosts left as they are, whichever kind
	Connectors             string // "Cloudflare", "Cloudflare, Namecheap"
	CheckAction, CheckVals string
}

func (v DNSView) Empty() bool { return len(v.Hand) == 0 && len(v.Managed) == 0 && len(v.Held) == 0 }

// Include is the confirm's hx-include: the repoint tick, when there is one.
func (v DNSView) Include() string {
	if len(v.Managed) == 0 {
		return ""
	}
	return "[name=repoint]"
}

func nowLabel(h DNSHost) string {
	switch {
	case h.Err != "":
		return "not found yet"
	case h.Now == "":
		return "not checked"
	}
	return h.Now
}

// DNS is the move's DNS list. The #dns-check part swaps on Check again; the
// repoint tick sits outside it, so a check keeps it.
templ DNS(v DNSView) {
	<div class="space-y-3">
		<div id="dns-check" class="space-y-4">
			if len(v.Hand) > 0 {
				<div class="space-y-2">
					<p class="text-sm font-medium text-rw-text">Point these hosts here</p>
					for _, h := range v.Hand {
						@dnsHand(h)
					}
				</div>
			}
			if len(v.Managed) > 0 {
				<div class="space-y-2">
					<p class="text-sm font-medium text-rw-text">Repointed for you</p>
					for _, h := range v.Managed {
						<p class="text-sm font-mono text-rw-text">
							{ h.Host }
							<span class="text-rw-faint">{ " " + h.Old + " to " + h.New }</span>
							@dnsNow(h)
						</p>
					}
				</div>
			}
			if len(v.Held) > 0 {
				<div class="space-y-2">
					<p class="text-sm font-medium text-rw-text">Left as they are</p>
					for _, h := range v.Held {
						<p class="text-sm font-mono text-rw-text">
							{ h.Host }
							<span class="text-rw-faint">{ " " + h.Note }</span>
						</p>
					}
				</div>
			}
			if v.CheckAction != "" {
				<button type="button" class="btn btn-ghost btn-sm" hx-post={ v.CheckAction } hx-vals={ v.CheckVals } hx-target="#dns-check" hx-swap="outerHTML">Check again</button>
			}
		</div>
		if len(v.Managed) > 0 {
			<label class="flex items-center gap-2 text-sm text-rw-text">
				<input type="checkbox" name="repoint" value="yes" checked/>
				{ "Let " + v.Connectors + " repoint these" }
			</label>
		}
	</div>
}

templ dnsHand(h DNSHost) {
	<div class="space-y-1">
		<p class="text-sm font-mono text-rw-text">{ h.Host } @dnsNow(h)</p>
		<ul class="text-xs font-mono space-y-1" aria-label={ "Records for " + h.Host }>
			for _, r := range h.Rows {
				<li class="flex items-center gap-2">
					<span class="text-rw-faint">{ r.Type }</span>
					<span class="text-rw-muted">{ r.Name }</span>
					<span class="text-rw-text">{ r.Value }</span>
					<button type="button" data-copy={ r.Value } class="btn btn-ghost btn-sm" aria-label={ "Copy " + r.Value }>Copy</button>
				</li>
			}
		</ul>
	</div>
}

templ dnsNow(h DNSHost) {
	<span class="text-xs text-rw-faint">
		{ " Now: " + nowLabel(h) }
		if h.OK {
			<span class="text-rw-ok">{ " Matches" }</span>
		}
	</span>
}

templ hostList(hosts []string) {
	<ul class="text-sm space-y-1 font-mono">
		for _, h := range hosts {
			<li class="text-rw-text">{ h }</li>
		}
	</ul>
}

templ exits(v View) {
	@c.Section("Exits", v.Scope, "") {
		if v.NoNet {
			<div class="banner banner-danger mb-3" role="alert">
				<p class="font-medium">No internet for these apps.</p>
				<p>Every exit in the list is down. Add own placement to fall back to it.</p>
				if v.NoNetWhy != "" {
					<p class="text-xs">{ v.NoNetWhy }</p>
				}
			</div>
		}
		if len(v.Rungs) == 0 || v.Inherited {
			<p class="text-sm text-rw-muted">
				if v.ExitsFrom != "" {
					{ v.ExitsFrom }
				} else {
					Inherit: out through the placement the app runs on.
				}
			</p>
		}
		if len(v.Rungs) > 0 {
			<ol class={ "space-y-2", templ.KV("opacity-70", v.Inherited) }>
				for i, r := range v.Rungs {
					<li class="panel px-4 py-3 flex flex-wrap items-center gap-3 text-sm">
						<span class="w-5 text-rw-faint">{ strconv.Itoa(i+1) }</span>
						<span class="flex-1 min-w-0 truncate text-rw-text">{ r.Name }</span>
						if r.State != "" {
							@c.Pill(r.State, stateTone(r.State))
						}
						if r.Detail != "" {
							<span class="text-xs text-rw-faint">{ r.Detail }</span>
						}
						if v.editable() && !v.Inherited {
							@reorder("Up", v.Base+"/exits", r.Up)
							@reorder("Down", v.Base+"/exits", r.Down)
							<form hx-post={ v.Base + "/exits/remove" } hx-target={ target() } hx-swap="outerHTML">
								<input type="hidden" name="placement" value={ r.NodeID }/>
								<button type="submit" class="btn btn-ghost btn-sm" aria-label={ "Remove " + r.Name }>Remove</button>
							</form>
						}
					</li>
				}
			</ol>
		}
		if v.editable() && (len(v.Spare) > 0 || !v.OwnListed) {
			<form hx-post={ v.Base + "/exits/add" } hx-target={ target() } hx-swap="outerHTML" class="mt-3 flex flex-wrap items-center gap-2">
				<label for="exit-add" class="sr-only">Add exit</label>
				<select id="exit-add" name="placement" class="input w-auto max-w-full">
					for _, n := range v.Spare {
						<option value={ n.ID }>{ n.Name + n.Hint }</option>
					}
					if !v.OwnListed {
						<option value="own">own placement (no exit)</option>
					}
				</select>
				<button type="submit" class="btn btn-ghost btn-sm">Add exit</button>
			</form>
		}
		<p class="mt-2 text-xs text-rw-faint">Tried top to bottom. Never falls back unless listed.</p>
	}
}

templ reorder(label, action string, ids []string) {
	if ids != nil {
		<form hx-post={ action } hx-target={ target() } hx-swap="outerHTML">
			for _, id := range ids {
				<input type="hidden" name="ids" value={ id }/>
			}
			<button type="submit" class="btn btn-ghost btn-sm">{ label }</button>
		</form>
	}
}

func stateTone(s string) string {
	switch s {
	case "in use":
		return "ok"
	case "down":
		return "bad"
	}
	return ""
}

func count(n int, noun string) string {
	if n == 1 {
		return "1 " + noun
	}
	return strconv.Itoa(n) + " " + noun + "s"
}

// Load is the tab's body in a drawer: it fetches the Placement answer.
templ Load(url string) {
	<div hx-get={ url } hx-trigger="load" hx-target="this" hx-swap="outerHTML" hx-push-url="false" aria-busy="true" class="text-sm text-rw-muted">Loading…</div>
}

// MoveLine is one env a pin change moves.
type MoveLine struct{ Path, Detail string }

// CheckLine is one line of the move's checks.
type CheckLine struct {
	Name, Detail string
	OK           bool
}

// MoveView is the pin change dialog for one env: what moves, the checks, and
// the downtime. Vals is the JSON the confirm posts (placement, confirm).
type MoveView struct {
	Action   string // POST: confirms the move
	Env      string // the slug typed to confirm: the env's, stack's or org's
	From, To string // placement names
	Envs     []MoveLine
	Checks   []CheckLine
	OK       bool // every check passed
	Restore  bool
	Vals     string
	Downtime string
	DNS      DNSView
	Idle     bool // nothing stops or holds data: no word to type
}

// word is what the confirm types: nothing for an idle move.
func (v MoveView) word() string {
	if v.Idle {
		return ""
	}
	return v.Env
}

// Move is the dialog. A failing check shows the list and no Confirm.
templ Move(v MoveView) {
	if v.OK {
		@c.Confirm(c.ConfirmView{
			Open:    true,
			Primary: true,
			Button:  "Move " + v.Env,
			Title:   "Move " + v.Env + " to " + v.To + "?",
			Action:  v.Action,
			Target:  target(),
			Word:    v.word(),
			Kept:    []string{"The data stays on " + v.From + " until you remove it."},
			Vals:    v.Vals,
			Include: v.DNS.Include(),
			Body:    moveBody(v),
		})
	} else {
		<div class="panel p-4 mt-4 space-y-3" role="alert">
			<p class="text-sm font-medium text-rw-text">{ v.Env } cannot move to { v.To } yet.</p>
			@moveBody(v)
		</div>
	}
}

templ moveBody(v MoveView) {
	<div class="space-y-4">
		<p class="text-sm text-rw-muted">
			Moves from { v.From } to { v.To }.
			if v.Restore {
				{ " " + "The old copy is gone: data comes back from backups." }
			}
			if v.Downtime != "" {
				{ " Stops for " + v.Downtime + "." }
			}
		</p>
		<ul class="text-sm space-y-1">
			for _, e := range v.Envs {
				<li class="text-rw-text">{ e.Path } <span class="text-rw-faint">{ e.Detail }</span></li>
			}
		</ul>
		if !v.DNS.Empty() {
			@DNS(v.DNS)
		}
		<ul class="text-sm space-y-1" aria-label="Checks">
			for _, k := range v.Checks {
				<li>
					if k.OK {
						<span class="text-rw-ok">Pass</span>
					} else {
						<span class="text-rw-danger">Fail</span>
					}
					{ " " + k.Name }
					if k.Detail != "" {
						<span class="text-xs text-rw-faint">{ " " + k.Detail }</span>
					}
				</li>
			}
		</ul>
	</div>
}

// StepView is one line of the progress view; State is done, running or
// waiting.
type StepView struct{ Label, State, Detail string }

// ProgressView is the move progress tab. Refresh, while set, polls it.
type ProgressView struct {
	Env, From, To string
	Started       time.Time
	State         string // running | done | rolled_back
	Error         string
	Steps         []StepView
	Refresh       string
}

templ Progress(v ProgressView) {
	<div
		id={ Root }
		class="space-y-4"
		if v.Refresh != "" {
			hx-get={ v.Refresh }
			hx-trigger="every 2s"
			hx-swap="outerHTML"
		}
	>
		<div>
			if v.To != "" {
				<h3 class="text-base font-semibold text-rw-text">Move to { v.To }</h3>
			} else {
				<h3 class="text-base font-semibold text-rw-text">Move</h3>
			}
			<p class="text-xs text-rw-faint">
				if v.From != "" {
					from { v.From } ·
				}
				{ "started " }
				@c.Time(v.Started, "15:04")
			</p>
		</div>
		<ol class="space-y-2">
			for i, s := range v.Steps {
				<li class="panel px-4 py-3 flex flex-wrap items-center gap-3 text-sm">
					<span class="w-5 text-rw-faint">{ strconv.Itoa(i+1) }</span>
					<span class="flex-1 min-w-0 truncate text-rw-text">{ s.Label }</span>
					if s.Detail != "" {
						<span class="text-xs text-rw-faint">{ s.Detail }</span>
					}
					@c.Pill(s.State, stepTone(s.State))
				</li>
			}
		</ol>
		switch v.State {
			case "running":
				<p class="text-xs text-rw-faint">If it fails, { v.Env } starts again where it was.</p>
			case "rolled_back":
				<p class="banner banner-danger" role="alert">
					Rolled back: { v.Env } runs where it did.
					if v.Error != "" {
						{ " " + v.Error }
					}
				</p>
			case "done":
				<p class="banner" role="status">Done: { v.Env } moved.</p>
		}
	</div>
}

func stepTone(s string) string {
	switch s {
	case "done":
		return "ok"
	case "running":
		return "busy"
	}
	return ""
}
