package components

import "time"

// ReleasesView is v0's releases page as a drawer tab (stack and env): the
// ladder strip (what each env runs), one row per release with the envs
// running it and a Promote / Roll back per env, and the promote question
// when a row's button asked for it.
// ponytail: v0's config plans list, Plan now and Review have no verb here.
type ReleasesView struct {
	Ladder []EnvRun
	Rows   []ReleaseRow
	Job    *JobStatusView
	Live   string       // the tab's own GET, polled while no question is open; "" = static
	// PushFail is the line over the list after a failed push; nil = none.
	PushFail *PushFailView
	// Lines is the work in progress: the push building, a value a job waits for.
	Lines []LiveLine
}

// EnvRun is one env and the release it runs ("" = nothing deployed).
type EnvRun struct{ Name, Color, Runs string }

type ReleaseRow struct {
	Number string
	By     string // who or what cut it
	Commit string // full commit sha ("" = none)
	Message string // commit message, first line ("" = none)
	When   time.Time
	Envs   []EnvRun // the envs running it
	Moves  []ReleaseMove
	// Waiting: the env below runs it and the viewed env does not.
	Waiting bool
}

// ReleaseMove is one env's button on a row; it opens the review.
type ReleaseMove struct {
	Label string // "Review plan", "Review rollback"
	Ask   string // GET the tab with the review open
}

templ Releases(v ReleasesView) {
	<div id="tab-releases">
		if v.Live != "" && (v.Job == nil || !v.Job.Live) {
			@LiveTab(v.Live, "tab-releases")
		}
		if v.PushFail != nil {
			<div class="mb-4">
				@PushFailed(*v.PushFail)
			</div>
		}
		if len(v.Lines) > 0 {
			<div class="mb-4">
				@LiveLines(v.Lines)
			</div>
		}
		@JobSlot(v.Job, "promote,deploy")
		if len(v.Ladder) > 0 {
			<ul class="flex flex-wrap gap-2 mb-6">
				for _, e := range v.Ladder {
					<li class="panel px-3 py-2 flex items-center gap-2 text-sm">
						<span class={ "env-dot", envClass(e.Color) }></span>
						<span class="text-rw-text">{ e.Name }</span>
						if e.Runs != "" {
							<span class="font-mono text-xs text-rw-muted">#{ e.Runs }</span>
						} else {
							<span class="text-xs text-rw-faint">nothing deployed</span>
						}
					</li>
				}
			</ul>
		}
		<h2 class="text-sm font-medium text-rw-muted mb-2">Releases</h2>
		if len(v.Rows) == 0 {
			<p class="panel px-4 py-3 text-sm text-rw-faint">No releases yet. The first deploy makes one.</p>
		} else {
			<ul class="panel divide-y divide-rw-border">
				for _, r := range v.Rows {
					<li class="flex flex-col gap-1.5 px-4 py-2.5 text-sm min-w-0 sm:flex-row sm:items-center sm:gap-2">
						<span class="flex items-center gap-2 min-w-0 flex-1">
							<span class="flex h-5 w-5 items-center justify-center rounded bg-rw-inset text-[9px] font-bold uppercase text-rw-accentHi shrink-0">{ Initials(r.By) }</span>
							<span class="font-mono text-xs text-rw-muted shrink-0">#{ r.Number }</span>
							<span class="min-w-0 flex-1">
								<span class="block text-rw-text sm:truncate [overflow-wrap:anywhere]">
									Release { r.Number }
									if r.Waiting {
										{ " " }
										@Chip("Waiting", "accent")
									}
								</span>
								<span class="block text-[10px] text-rw-faint sm:truncate [overflow-wrap:anywhere]">
									{ r.By + " · " }
									@When(r.When)
								</span>
								if r.Message != "" {
									<span class="block text-[10px] text-rw-muted sm:truncate [overflow-wrap:anywhere]" title={ r.Message }>{ r.Message }</span>
								}
							</span>
						</span>
						<span class="flex flex-wrap items-center gap-2 pl-7 sm:pl-0 sm:shrink-0 empty:hidden">
						if r.Commit != "" {
							<span class="font-mono text-[10px] text-rw-faint" title={ r.Commit }>{ r.Commit[:min(12, len(r.Commit))] }</span>
						}
						for _, e := range r.Envs {
							<span class={ "log-chip", envClass(e.Color) }>{ e.Name }</span>
						}
						if len(r.Moves) > 0 {
							// the buttons wrap as one group, on their own line on a phone
							<span class="flex flex-wrap items-center gap-2 basis-full sm:basis-auto">
								for _, m := range r.Moves {
									<button
										type="button"
										class="btn btn-ghost btn-sm shrink-0"
										hx-get={ m.Ask }
										hx-target={ "#" + DrawerRoot }
										hx-swap="outerHTML"
									>{ m.Label }</button>
								}
							</span>
						}
						</span>
					</li>
				}
			</ul>
		}
	</div>
}

func plural(n int) string {
	if n == 1 {
		return ""
	}
	return "s"
}
