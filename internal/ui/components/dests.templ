package components

// DestsView is v0's backups settings (org and admin): the destinations,
// then the add form. A destination's keys never reach a view.
type DestsView struct {
	Scope    string // the chip: organization | instance
	Add      string // POST the new destination; "" = read-only
	Share    bool   // the form asks who may use it (admin)
	ListHelp string
	Rows     []DestView
	Target   string // what its forms answer into; "" = the drawer
	// Draft is a refused add as typed, never its secret key; nil = a fresh
	// form.
	Draft *DestDraft
}

// DestDraft is the add form's fields as posted.
type DestDraft struct {
	Name, Endpoint, Bucket, Region, AccessKey string
	Shared                                    bool
}

// draft is the add form's values: what was typed, or a fresh form
// offered to every org.
func (v DestsView) draft() DestDraft {
	if v.Draft != nil {
		return *v.Draft
	}
	return DestDraft{Shared: true}
}

type DestView struct {
	Name     string
	Bucket   string
	Endpoint string // "" = AWS
	Note     string // a chip: "install-wide", "local disk"
	Shared   bool
	// ShareAction (POST share=all|server) is the row's own sharing form,
	// with its Save; "" = none.
	ShareAction string
	Remove      ConfirmView // Action "" = none
}

func endpointWord(e string) string {
	if e == "" {
		return "AWS"
	}
	return e
}

func sharedWord(shared bool) string {
	if shared {
		return "Every org"
	}
	return "Server only"
}

// destShare is the one sharing control for a destination: it keeps no org
// list, so every org or the server alone.
func destShare(shared bool) ShareView {
	v := ShareView{ModeName: "share", NoOnly: true, Mode: ShareServer}
	if shared {
		v.Mode = ShareAll
	}
	return v
}

templ Dests(v DestsView) {
	@Section("Destinations", v.Scope, v.ListHelp) {
		if len(v.Rows) == 0 {
			<p class="text-sm text-rw-muted">None yet.</p>
		} else {
			<ul class="space-y-2">
				for _, d := range v.Rows {
					<li class="panel px-4 py-3 text-sm">
						<div class="flex flex-wrap items-center gap-2">
							<span class="text-rw-text">{ d.Name }</span>
							if d.Bucket != "" {
								<span class="font-mono text-xs text-rw-faint truncate">{ d.Bucket } at { endpointWord(d.Endpoint) }</span>
							}
							if d.Note != "" {
								@Chip(d.Note, "")
							}
							<span class="ml-auto flex items-center gap-2">
								if d.ShareAction != "" {
									<span class="text-xs text-rw-faint">{ sharedWord(d.Shared) }</span>
								}
								if d.Remove.Action != "" {
									@Confirm(d.Remove)
								}
							</span>
						</div>
						if d.ShareAction != "" {
							<details class="mt-2">
								<summary class="cursor-pointer text-xs text-rw-muted hover:text-rw-text">Sharing</summary>
								<form hx-post={ d.ShareAction } hx-target={ orDrawer(v.Target) } hx-swap="outerHTML" class="mt-2 space-y-3 text-sm">
									@Share(destShare(d.Shared))
									<button type="submit" class="btn btn-primary btn-sm">Save</button>
								</form>
							</details>
						}
					</li>
				}
			</ul>
		}
	}
	if v.Add != "" {
		@Section("Add a destination", v.Scope, "Any S3-compatible bucket: AWS, MinIO, Backblaze B2, a RustFS instance.") {
			<form hx-post={ v.Add } hx-target={ orDrawer(v.Target) } hx-swap="outerHTML" class="space-y-4">
				@Field(FieldView{Name: "dest_name", Label: "Name", Value: v.draft().Name, Placeholder: "offsite", Required: true})
				@Field(FieldView{Name: "endpoint", Label: "Endpoint", Value: v.draft().Endpoint, Placeholder: "https://s3.eu-west-1.amazonaws.com", Help: "Full URL, including the scheme. Empty is AWS."})
				@Field(FieldView{Name: "bucket", Label: "Bucket", Value: v.draft().Bucket, Placeholder: "stackr-backups", Required: true})
				@Field(FieldView{Name: "region", Label: "Region", Value: v.draft().Region, Placeholder: "us-east-1", Help: "Optional: servers that ignore regions still need one for signing."})
				@Field(FieldView{Name: "access_key", Label: "Access key", Value: v.draft().AccessKey, Required: true})
				@Field(FieldView{Name: "secret_key", Label: "Secret key", Type: "password", Required: true, Help: "Stored encrypted and never shown again."})
				if v.Share {
					<div class="text-sm">
						@Share(destShare(v.draft().Shared))
					</div>
				}
				<button type="submit" class="btn btn-primary btn-sm">Add destination</button>
			</form>
		}
	}
}
