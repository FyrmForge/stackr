package components

// TileCardView is one tile on an env page. Volumes are the ones it mounts,
// drawn stacked under it (REWRITE.md "Volumes": the card rule); an
// unmounted volume is drawn alone with VolumeCard.
type TileCardView struct {
	Name    string
	Href    string
	Kind    string // service | image | managed
	State   string // leaf/tile State.Word
	Source  string // image ref or repo@branch
	Volumes []VolumeCardView
}

// VolumeCardView is one volume. Orphaned is the service's word for "its
// entry left the stack file"; the data is kept until retention runs out.
type VolumeCardView struct {
	Name     string
	Href     string
	Size     string
	Orphaned bool
}

templ TileCard(t TileCardView) {
	<div class="space-y-1">
		<a href={ templ.SafeURL(t.Href) } hx-get={ t.Href } hx-target="#main" hx-push-url="true" class="card block">
			<div class="flex items-center justify-between gap-2">
				<span class="font-medium text-rw-text">{ t.Name }</span>
				@TileBadge(t.State)
			</div>
			<p class="mt-1 truncate text-xs text-rw-faint">{ t.Kind } · { t.Source }</p>
		</a>
		for _, v := range t.Volumes {
			<div class="ml-4">
				@VolumeCard(v)
			</div>
		}
	</div>
}

templ VolumeCard(v VolumeCardView) {
	<a href={ templ.SafeURL(v.Href) } hx-get={ v.Href } hx-target="#main" hx-push-url="true" class="card block py-2 text-sm">
		<div class="flex items-center justify-between gap-2">
			<span>{ v.Name }</span>
			<span class="text-xs text-rw-faint">{ v.Size }</span>
		</div>
		if v.Orphaned {
			<p class="mt-1 text-xs text-rw-warn">orphaned: kept until retention runs out</p>
		}
	</a>
}
