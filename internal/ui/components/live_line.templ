package components

import "time"

// LiveLine is one piece of work in progress that a result will replace: a
// push building, a job parked on a value. Text, then At (the start time, zero
// = none), then a link.
type LiveLine struct {
	Text, Link, Href string
	At               time.Time
}

// NewBuilding is the line of a push that is building (or, queued, waiting
// to), with the job log.
func NewBuilding(stack, sha string, started time.Time, queued bool, href string) LiveLine {
	l := LiveLine{Text: "Building " + stack + AtSha(sha) + ", started ", At: started, Link: "Job log", Href: href}
	if queued {
		l.Text = "Waiting to build " + stack + AtSha(sha) + ", queued "
	}
	return l
}

// AtSha is " at f9cdc50", or nothing for a push that carries no commit.
func AtSha(sha string) string {
	if sha == "" {
		return ""
	}
	return " at " + sha
}

// NewParkedOn is the line of a job parked on a value, with where to set it.
func NewParkedOn(param, href string) LiveLine {
	return LiveLine{Text: "Waiting for " + param, Link: "Set it", Href: href}
}

// LiveLines is the amber lines over an env page, its Releases tab and the
// empty stack page. They are in the pages that refetch themselves, so a line
// goes by itself when its job ends.
templ LiveLines(ls []LiveLine) {
	if len(ls) > 0 {
		<div class="flex flex-col gap-2" role="status">
			for _, l := range ls {
				<div class="flex items-center gap-3 rounded-md border border-rw-warn/40 bg-rw-warn/10 px-3 py-2 text-sm text-rw-warn">
					<span class="min-w-0 flex-1 truncate">{ l.Text }@Time(l.At, "15:04")</span>
					if l.Href != "" {
						<a href={ templ.SafeURL(l.Href) } class="shrink-0 underline">{ l.Link }</a>
					}
				</div>
			}
		</div>
	}
}
