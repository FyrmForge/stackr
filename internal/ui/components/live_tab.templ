package components

// LiveTab is the hidden poller a region carries to stay current: every 3s it
// refetches url and swaps #id with the same element from the answer (which
// brings the next poller). main.js's poll guard skips a tick while a dialog is
// open, focus is inside the region, a <details> in it is open, a drawer
// field has focus or a field in the region holds what was typed (dirty).
// Put it as a direct child of #id: when the region leaves the page htmx
// stops the poll.
templ LiveTab(url, id string) {
	@LiveTabGuard(url, id, "region rows fields dirty")
}

// LiveTabGuard is LiveTab with its own poll guard tokens. The Waiting page
// passes "rows": a ticked box is focused and dirty, and the poll must go on
// (the page rehydrates its ticks); only an open dialog or details pause it.
templ LiveTabGuard(url, id, guard string) {
	<span hidden data-live-tab data-poll-guard={ guard } hx-get={ url } hx-trigger="every 3s" hx-select={ "#" + id } hx-target={ "#" + id } hx-swap="outerHTML"></span>
}
