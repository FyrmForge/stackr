package components

import (
	"strings"
	"time"
)

// LogPaneView is a followed log. The SSE stream sends "line" events, each
// one rendered LogLine, and "end" when the source is done. Level and
// Search are the starting filters, read from the page URL by the handler.
type LogPaneView struct {
	StreamURL string
	Level     string // "" | error | warn | info | debug
	Search    string
}

// LogPane wraps <log-pane> in v0's LogView look: the element owns follow,
// filter, search, the toggles and the stream state ([state], shown by
// [data-status]); htmx owns the stream.
templ LogPane(v LogPaneView) {
	<log-pane class="block" level={ v.Level } search={ v.Search }>
		<div class="flex flex-wrap items-center gap-3 mb-2">
			<div class="relative">
				<svg class="absolute left-3 top-1/2 -translate-y-1/2 h-3.5 w-3.5 text-rw-faint pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
				<input type="search" class="input !pl-9 !py-1.5 text-sm font-mono !w-64" placeholder="Filter and search logs" value={ v.Search } data-search aria-label="Filter and search logs"/>
			</div>
			<select class="input !w-auto !py-1.5 text-xs" data-level aria-label="Minimum level">
				<option value="">all levels</option>
				<option value="info">info+</option>
				<option value="warn">warn+</option>
				<option value="error">errors</option>
			</select>
			<label class="flex items-center gap-1.5 text-xs text-rw-muted cursor-pointer"><input type="checkbox" class="accent-rw-accent" data-toggle="timestamps" checked/> timestamps</label>
			<label class="flex items-center gap-1.5 text-xs text-rw-muted cursor-pointer"><input type="checkbox" class="accent-rw-accent" data-toggle="wrap" checked/> wrap</label>
			<label class="flex items-center gap-1.5 text-xs text-rw-muted cursor-pointer"><input type="checkbox" class="accent-rw-accent" data-toggle="follow" checked/> follow</label>
			<span data-status aria-live="polite"></span>
		</div>
		<div
			class="panel p-3 h-[65vh] overflow-y-auto font-mono text-xs leading-5"
			role="log"
			data-lines
			data-wrap
			hx-ext="sse"
			sse-connect={ v.StreamURL }
			sse-swap="line"
			hx-swap="beforeend"
			sse-close="end"
		></div>
		<div class="mt-2">
			@ZoneNote()
		</div>
	</log-pane>
}

// LogLineView is one line as the stream sends it. Level is the parsed
// level ("" = unknown); the element filters on it and the CSS colours the
// edge by it. Tok is the level word as Text spells it, drawn bold. Segs is
// a line that came with terminal colours: Text without them, Segs drawn.
type LogLineView struct {
	Time   time.Time // zero = the line had no stamp
	Level  string
	Text   string
	Tok    string
	Segs   []LogSeg
	Fields []LogField // a JSON line's other keys; Text is its message
}

// LogLine is one line on one line: the lines box is white-space: pre, so
// templ's spacing around statements would show.
templ LogLine(l LogLineView) {
	if len(l.Fields) > 0 {
		<div data-level={ l.Level }><details class="open:bg-rw-inset/40 open:rounded-sm"><summary class="cursor-pointer list-none"><span data-ts>@Time(l.Time, "15:04:05") { { " " } }</span>{ l.Text } <span class="text-rw-faint">{ fieldsLabel(len(l.Fields)) }@logChevron()</span></summary>@logFields(l.Fields, l.fieldsPad())</details></div>
	} else if l.Segs != nil {
		<div data-level={ l.Level }><span data-ts>@Time(l.Time, "15:04:05") { { " " } }</span>@logSegs(l.Segs)</div>
	} else {
		<div data-level={ l.Level }><span data-ts>@Time(l.Time, "15:04:05") { { " " } }</span>{ l.part(0) }<span data-tok>{ l.part(1) }</span>{ l.part(2) }</div>
	}
}

// logSegs draws a coloured line's runs; the look is CSS on the data attrs.
templ logSegs(segs []LogSeg) {
	for _, g := range segs {
		<span
			if g.Color != "" {
				data-c={ g.Color }
			}
			data-b?={ g.Bold }
			data-d?={ g.Dim }
		>{ g.Text }</span>
	}
}

// fieldsPad starts a JSON line's field list under its message: past the time
// cell (8 characters and a space) unless the timestamps toggle hides it.
func (l LogLineView) fieldsPad() string {
	if l.Time.IsZero() {
		return ""
	}
	return "pl-[9ch] [[data-no-ts]_&]:pl-0"
}

// part is Text split around its first Tok: before, the token, after.
func (l LogLineView) part(i int) string {
	pre, post, ok := strings.Cut(l.Text, l.Tok)
	if !ok || l.Tok == "" {
		return []string{l.Text, "", ""}[i]
	}
	return []string{pre, l.Tok, post}[i]
}

// logChevron marks a row that opens; it turns down when its details open.
templ logChevron() {
	<svg class="inline-block h-3 w-3 ml-1 align-[-2px] transition-transform [details[open]_&]:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"></path></svg>
}

// logFields is a JSON line's keys as a key and value grid under its row; pad
// is the padding that starts it under the row's message column.
templ logFields(fs []LogField, pad string) {
	<dl class={ "grid grid-cols-[fit-content(16ch)_1fr] gap-x-3 mt-0.5 mb-1.5 font-mono text-xs text-rw-muted", pad }>
		for _, f := range fs {
			<dt class="text-rw-faint break-all">{ f.Key }</dt>
			<dd class="min-w-0 whitespace-pre-wrap break-all">{ f.Val }</dd>
		}
	</dl>
}
