package components

import "strings"

// TileBadge and JobBadge colour one status word. The set of words is the
// service's (leaf/tile State.Word, leaf/job states); the badge only picks a
// colour and spells it for humans ("waiting_ci" -> "waiting ci").
templ TileBadge(word string) {
	@badge(word, tileTone[word])
}

templ JobBadge(state string) {
	@badge(state, jobTone[state])
}

// EnvBadge is an environment's name beside its colour dot, so prod looks
// like prod everywhere. Color is one of EnvColors; anything else, no dot.
templ EnvBadge(name, color string) {
	<span class="inline-flex items-center gap-1.5 text-xs text-rw-text">
		if dot := envClass(color); dot != "" {
			<span class={ "env-dot", dot }></span>
		}
		<span>{ name }</span>
	</span>
}

// Pill is a word in a named tone (ok, warn, bad, busy; else neutral).
templ Pill(word, tone string) {
	@badge(word, tone)
}

// badge is v0's StatusBadge as it rendered: coloured text and dot on no
// fill (its bg-*/12 tint never compiled).
templ badge(word, tone string) {
	<span class={ "inline-flex items-center gap-1.5 text-xs px-2 py-0.5 rounded-full", toneClass(tone) }>
		<span class={ "h-1.5 w-1.5 rounded-full", dotClass(tone) }></span>{ strings.ReplaceAll(word, "_", " ") }
	</span>
}

// provisioned is a slice tile's word (it has no container).
var tileTone = map[string]string{
	"running":     "ok",
	"provisioned": "ok",
	"degraded":    "warn",
	"unhealthy":   "bad",
}

var jobTone = map[string]string{"queued": "busy", "running": "busy", "waiting": "warn", "done": "ok", "failed": "bad"}

// toneClass and dotClass spell every class in full so tailwind keeps them.
// busy has no v0 twin; v0 painted queued and building warn, so busy is warn.
func toneClass(tone string) string {
	switch tone {
	case "ok":
		return "text-rw-success"
	case "warn", "busy":
		return "text-rw-warn"
	case "bad":
		return "text-rw-danger"
	}
	return "bg-rw-inset text-rw-muted"
}

func dotClass(tone string) string {
	switch tone {
	case "ok":
		return "bg-rw-success"
	case "warn", "busy":
		return "bg-rw-warn"
	case "bad":
		return "bg-rw-danger"
	}
	return "bg-rw-faint"
}

// EnvColors is the palette an environment's colour is picked from: v0's
// six hues, in its ladder order.
var EnvColors = []string{"teal", "sky", "lime", "amber", "rose", "violet"}

// envClass is the class that sets --env-c for a hue (input.css); "" for
// anything outside EnvColors.
func envClass(color string) string {
	switch color {
	case "teal":
		return "env-c-teal"
	case "sky":
		return "env-c-sky"
	case "lime":
		return "env-c-lime"
	case "amber":
		return "env-c-amber"
	case "rose":
		return "env-c-rose"
	case "violet":
		return "env-c-violet"
	}
	return ""
}

// EnvSwatch is v0's colour picker dot: one hue as a radio named color.
// A disabled fieldset around it makes it read-only.
templ EnvSwatch(color string, checked bool) {
	<label class={ "env-swatch", envClass(color) } title={ color }>
		<input type="radio" name="color" value={ color } checked?={ checked } class="sr-only" aria-label={ color }/>
	</label>
}
