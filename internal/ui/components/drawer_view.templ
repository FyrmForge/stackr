package components

// DrawerRoot is the id every drawer answer replaces (outerHTML).
const DrawerRoot = "drawer-view"

// DrawerView is the frame of a home, org or stack level drawer: the card's
// name, its tab strip, a refused action's message or what an action did,
// then the tab. Tabs hx-get Base?tab= and push ?drawer=Node&tab=, which a
// fresh load reads back.
type DrawerView struct {
	Node  string
	Title string
	Kind  string
	Base  string
	Tabs  []string
	Tab   string
	Error string
	Note  string
}

templ Drawer(v DrawerView, body templ.Component) {
	<div id={ DrawerRoot }>
		<h2 class="text-lg font-semibold">{ v.Title } <span class="text-sm font-normal text-slate-500">{ v.Kind }</span></h2>
		if len(v.Tabs) > 1 {
			<nav class="my-3 flex flex-wrap gap-3 text-sm" aria-label="Tabs">
				for _, t := range v.Tabs {
					<a
						href={ templ.SafeURL("?drawer=" + v.Node + "&tab=" + t) }
						hx-get={ v.Base + "?tab=" + t }
						hx-target={ "#" + DrawerRoot }
						hx-swap="outerHTML"
						hx-push-url={ "?drawer=" + v.Node + "&tab=" + t }
						class="link aria-[current=page]:font-semibold"
						if t == v.Tab {
							aria-current="page"
						}
					>{ t }</a>
				}
			</nav>
		}
		if v.Error != "" {
			<p class="banner my-3 border-red-300 bg-red-50 text-red-700 dark:border-red-800 dark:bg-red-950 dark:text-red-300" role="alert">{ v.Error }</p>
		}
		if v.Note != "" {
			// a note may hold a one-time token: keep it out of htmx's history cache
			<p class="banner my-3" role="status" hx-history="false">{ v.Note }</p>
		}
		@body
	</div>
}

// PostButton is a one-button POST answered with the drawer.
templ PostButton(label, action string) {
	<button type="button" class="btn" hx-post={ action } hx-target={ "#" + DrawerRoot } hx-swap="outerHTML">{ label }</button>
}
