package components

import (
	"cmp"
	"strconv"
	"time"
)

// RelWindow is the releases window, bottom left of the stack and env canvas
// (releases view RFC, section 4): a collapsed bar with what needs a person
// and the env links, and the list under it when open. It takes the env pill
// in.
type RelWindow struct {
	Envs            []RelEnv
	Waiting, Failed int
	Rows            []RelRow
	All             string // the Releases screen at this scope
	Err             bool   // the rows could not be read
	// Retry is the page to load again when they could not be; AsOf is the
	// time of the counts the bar keeps then ("21:04"), "" = they are current.
	Retry, AsOf string
	Open            bool // ?rel=1; main.js keeps the rest
	// Title is the bar's word, "Releases" when "" (the cluster chart's is
	// "Server config").
	Title string
	// Switch draws the org chart's two-way switch: "Org config" and "All".
	// View is the one shown ("all" | "org"); the counts of the first are
	// OrgWaiting and OrgFailed, rows of a stack are OfStack.
	Switch                bool
	View                  string
	OrgWaiting, OrgFailed int
	// Note stands where a config file has nothing to list (not bound: with
	// its link; bound: no plans yet).
	Note RelNote
}

// RelNote is a line with an optional link after it.
type RelNote struct{ Text, Link, Href string }

// RelEnv is one env link of the bar.
type RelEnv struct{ Name, Color, Href string }

// RelLink is a text link: a review, or a job log. Ask, when set, is a GET
// into the side drawer instead of a page load (the Releases screen opens a
// review that way, full width); Href stays the fallback.
type RelLink struct{ Label, Href, Ask string }

// RelJob is one job of a release, for its open row.
type RelJob struct {
	Text string
	Href string
}

// RelRow is one line: a release, a failed push or a build under way.
type RelRow struct {
	Kind    string // release | failed | building | plan
	ID            string
	Number        string // "" = none
	// Scope stands in place of Number on the org chart: where the row belongs
	// ("org config", "media 15").
	Scope string
	// OfStack marks a row of a stack: the org chart's "Org config" view
	// leaves it out.
	OfStack bool
	Commit        string // short
	Message       string // the headline; the source when the cut had none
	State, Tone   string // one word, a Chip tone
	Envs          []EnvRun
	Newest        bool
	Lacks         string // the number of a waiting release this one does not hold
	Link          RelLink
	Reviews       []RelLink
	Log           string
	At            time.Time
	By            string
	Jobs          []RelJob
	CommitURL     string
	CommitFull    string
	Stack         string // building: the stack
	Queued        bool
	// The Releases screen's column: what cut it. (Scope is above.)
	Source string
	Plan   bool // a config plan, not a release
	Fixed  bool // a failure a later push or promote cured
	Err    string // a failed release: the end of its error, on a line of its own
}

// RelBody is what the "releases" event swaps: the bar's markers and the list.
templ RelBody(w RelWindow) {
	<div id="rel-body" class="max-h-[50vh] overflow-y-auto border-t border-rw-border " sse-swap="releases" hx-swap="innerHTML" hx-target="this">
		@relRows(w)
	</div>
}

// RelUpdate is what the "releases" event swaps: the list, and the bar's
// counts alongside (an out-of-band swap, so the bar is patched in place).
templ RelUpdate(w RelWindow) {
	@relRows(w)
	<span id="rel-counts" hx-swap-oob="outerHTML" class="contents">
		@relCounts(w)
	</span>
}

// relCounts are the bar's markers: a word and a number, never a colour alone.
// The org chart's switch holds one set per view, the style sheet shows one.
templ relCounts(w RelWindow) {
	if w.Switch {
		<span data-for="all" class="flex items-center gap-2">
			@relChips(w.Waiting, w.Failed)
		</span>
		<span data-for="org" class="flex items-center gap-2">
			@relChips(w.OrgWaiting, w.OrgFailed)
		</span>
	} else {
		@relChips(w.Waiting, w.Failed)
	}
	if w.AsOf != "" {
		<span class="text-xs text-rw-muted">as of { w.AsOf }</span>
	}
}

templ relChips(waiting, failed int) {
	if waiting > 0 {
		@Chip(strconv.Itoa(waiting)+" waiting", "accent")
	}
	if failed > 0 {
		@Chip(strconv.Itoa(failed)+" failed", "danger")
	}
}

templ relNote(n RelNote) {
	{ n.Text }
	if n.Link != "" {
		{ " " }<a href={ templ.SafeURL(n.Href) } class="link">{ n.Link }</a>
	}
}

templ relRows(w RelWindow) {
	switch {
		case w.Err:
			<p class="px-3 py-2 text-sm text-rw-muted">
				Releases could not be loaded.
				if w.Retry != "" {
					{ " " }<a href={ templ.SafeURL(w.Retry) } class="link">Try again</a>
				}
			</p>
		case len(w.Rows) == 0 && w.Note.Text != "":
			<p class="px-3 py-2 text-sm text-rw-muted">@relNote(w.Note)</p>
		case len(w.Rows) == 0:
			<p class="px-3 py-2 text-sm text-rw-muted">No releases yet. A push or a first deploy makes one.</p>
		default:
			<ul class="divide-y divide-rw-border">
				for _, r := range w.Rows {
					@relRow(r)
				}
			</ul>
			if w.Switch && w.Note.Text != "" {
				<p data-for="org" class="border-t border-rw-border px-3 py-2 text-sm text-rw-muted">@relNote(w.Note)</p>
			}
	}
}

templ relRow(r RelRow) {
	<li data-stack?={ r.OfStack }>
		if r.Kind == "release" {
			<details data-id={ r.ID } class="group">
				<summary class="flex min-h-9 cursor-pointer list-none items-center gap-2 px-3 py-1 text-sm hover:bg-rw-inset [&::-webkit-details-marker]:hidden">
					@relHead(r)
				</summary>
				@relOpen(r)
			</details>
			if r.Lacks != "" {
				<div class="px-3 pb-2 pl-12">
					@Chip("Does not hold release "+r.Lacks, "warn")
				</div>
			}
		} else {
			<div class="flex min-h-9 items-center gap-2 px-3 py-1 text-sm">
				@relHead(r)
			</div>
		}
		if r.Err != "" {
			<p class="px-3 pb-2 pl-12 text-xs text-rw-danger [overflow-wrap:anywhere]">{ r.Err }</p>
		}
	</li>
}

templ relHead(r RelRow) {
	if r.Scope != "" {
		<span class="w-24 shrink-0 truncate text-xs text-rw-faint" title={ r.Scope }>{ r.Scope }</span>
	} else if r.Kind != "plan" {
		<span class="w-7 shrink-0 font-mono text-xs text-rw-faint">{ r.Number }</span>
	}
	if r.Kind == "building" {
		<span class="min-w-0 flex-1 truncate text-rw-text">
			if r.Queued {
				Waiting to build { r.Stack } at <span class="font-mono text-xs">{ r.Commit }</span>
			} else {
				Building { r.Stack } at <span class="font-mono text-xs">{ r.Commit }</span>, started
				{ " " }
				@Time(r.At, "15:04")
			}
		</span>
	} else {
		if r.Commit != "" {
			<span class={ "shrink-0 font-mono text-xs whitespace-nowrap", templ.KV("text-rw-text", r.Number == "" || r.State == "waiting"), templ.KV("text-rw-muted", r.Number != "" && r.State != "waiting") }>{ r.Commit }</span>
		}
		<span class="min-w-0 flex-1 truncate text-rw-text" title={ r.Message }>{ r.Message }</span>
		for _, e := range r.Envs {
			<span class={ "chip bg-rw-inset text-rw-text", envClass(e.Color) }><span class="env-dot mr-1"></span>{ e.Name }</span>
		}
	}
	if r.Newest {
		@Chip("newest", "success")
	}
	if r.State != "" {
		@Chip(r.State, r.Tone)
	}
	if r.Link.Label != "" {
		@relLink(r.Link, "link shrink-0 whitespace-nowrap")
	}
}

// relLink is a link of a row: a page, or a review into the side drawer.
templ relLink(l RelLink, class string) {
	if l.Ask != "" {
		<a href={ templ.SafeURL(l.Href) } hx-get={ l.Ask } hx-target="#drawer-body" data-full class={ class }>{ l.Label }</a>
	} else {
		<a href={ templ.SafeURL(l.Href) } class={ class }>{ l.Label }</a>
	}
}

templ relOpen(r RelRow) {
	<div class="flex flex-col gap-1 border-t border-rw-border bg-rw-inset py-2 pl-12 pr-3 text-xs text-rw-muted">
		<div>
			<span class="text-rw-faint">Cut</span>
			{ " " }
			@When(r.At)
			{ " by " + r.By }
		</div>
		for _, j := range r.Jobs {
			<div>
				<span class="text-rw-faint">Job</span> { j.Text }
				{ " " }<a href={ templ.SafeURL(j.Href) } class="link">Job log</a>
			</div>
		}
		for _, l := range r.Reviews {
			<div>@relLink(l, "link")</div>
		}
		if r.CommitURL != "" {
			<div>
				<span class="text-rw-faint">Commit</span>
				{ " " }<a href={ templ.SafeURL(r.CommitURL) } target="_blank" rel="noopener" class="link">Open { r.Commit } on the git host</a>
			</div>
		}
	</div>
}

// RelWindowView is the window: a <details> whose summary is the bar, so it
// opens and closes with no script of its own (main.js keeps it open across
// reloads and the open rows across the stream's patches). The env links sit
// in the bar like the pill's did; a click on one goes there, not open.
templ RelWindowView(w RelWindow) {
	<details
		id="rel-window"
		if w.Switch {
			data-view={ cmp.Or(w.View, "all") }
		}
		class="env-compare group absolute bottom-4 left-4 z-10 open:w-[34rem] open:max-w-[calc(100%-2rem)]"
		open?={ w.Open }
	>
		<summary class="flex h-9 cursor-pointer list-none items-center gap-2 whitespace-nowrap px-3 text-sm [&::-webkit-details-marker]:hidden">
			<span class="font-semibold text-rw-text">{ cmp.Or(w.Title, "Releases") }</span>
			<span id="rel-counts" class="contents">
				@relCounts(w)
			</span>
			if len(w.Envs) > 0 {
				<span class="h-4 w-px bg-rw-border"></span>
				<nav aria-label="Environments" class="flex items-center gap-3 text-xs">
					for _, e := range w.Envs {
						<a href={ templ.SafeURL(e.Href) } hx-get={ e.Href } hx-target="#main" hx-push-url="true" class="flex items-center gap-1.5 text-rw-text transition-colors hover:text-rw-accentHi">
							<span class={ "env-dot", envClass(e.Color) }></span>
							{ e.Name }
						</a>
					}
				</nav>
			}
			<span class="flex-1"></span>
			if w.Switch {
				<span role="group" aria-label="Show" class="flex items-center rounded-md border border-rw-border p-px text-xs">
					<button type="button" data-view-set="org" class="rounded px-2 py-0.5 text-rw-muted hover:text-rw-text">Org config</button>
					<button type="button" data-view-set="all" class="rounded px-2 py-0.5 text-rw-muted hover:text-rw-text">All</button>
				</span>
			}
			<span aria-hidden="true" class="text-rw-faint group-open:rotate-180">&#9652;</span>
		</summary>
		@RelBody(w)
		<div class="flex h-8 items-center border-t border-rw-border px-3 text-xs text-rw-faint">
			<span>Updates by itself</span>
			<span class="flex-1"></span>
			if w.All != "" {
				<a href={ templ.SafeURL(w.All) } hx-get={ w.All } hx-target="#main" hx-push-url="true" class="link">All releases</a>
			}
		</div>
	</details>
}
