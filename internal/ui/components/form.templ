package components

import (
	"context"
	"strconv"
)

// FieldView is one labelled input. Disabled needs Why: a disabled control
// always says why (config-managed, no permission, ...).
type FieldView struct {
	Name        string
	Label       string
	Type        string // text, email, password, number, url; "" = text
	Value       string // never a secret or a password: leave it empty
	Placeholder string
	Help        string
	Error       string
	ValidateURL string // hx-post target for blur validation; "" = none
	Autocomplete string // autocomplete token (username, current-password, new-password, name); "" = none
	Required    bool
	Disabled    bool
	Why         string
	Changed     bool   // set here, not inherited: the dot, and data-changed for settings-find
	From        string // where an inherited value comes from ("org"): a tag after the label
}

// Form is an htmx form that re-renders itself: the handler answers 422
// with the same component and the errors filled in.
templ Form(id, action string) {
	<form id={ id } hx-post={ action } hx-target={ "#" + id } hx-swap="outerHTML" class="space-y-4" novalidate>
		{ children... }
	</form>
}

// FormError is the form-wide message (the "general" key of the errors map).
templ FormError(msg string) {
	if msg != "" {
		<div class="banner banner-danger" role="alert">@ErrText(msg)</div>
	}
}

// Note is what a save did. It may hold a one-time token: kept out of htmx's
// history cache.
templ Note(msg string) {
	<p class="banner" role="status" hx-history="false">{ msg }</p>
}

templ Field(f FieldView) {
	<div data-field data-changed?={ f.Changed }>
		<label for={ f.Name } class="label">
			{ f.Label }
			@FieldMarks(f.Changed, f.From)
		</label>
		if f.Type == "password" {
			<password-toggle class="relative block">
				@fieldInput(f)
				<button type="button" data-toggle aria-pressed="false" class="absolute inset-y-0 right-0 px-3 text-xs text-rw-faint hover:text-rw-text">Show</button>
			</password-toggle>
		} else {
			@fieldInput(f)
		}
		if f.Disabled {
			<p class="mt-1.5 text-xs text-rw-faint">{ f.Why }</p>
		} else if f.Help != "" {
			<p class="mt-1.5 text-xs text-rw-faint" data-hint>{ f.Help }</p>
		}
		@FieldError(f.Name, KeptErr(ctx, f.Name, f.Error))
	</div>
}

templ fieldInput(f FieldView) {
	<input
		id={ f.Name }
		name={ f.Name }
		type={ inputType(f.Type) }
		value={ fieldValue(ctx, f) }
		placeholder={ f.Placeholder }
		class={ "input", templ.KV("pr-14", f.Type == "password") }
		required?={ f.Required }
		disabled?={ f.Disabled }
		{ Invalid(f.Name, KeptErr(ctx, f.Name, f.Error))... }
		if f.Autocomplete != "" {
			autocomplete={ f.Autocomplete }
		}
		if f.ValidateURL != "" {
			hx-post={ f.ValidateURL }
			hx-trigger="blur, hamr:revalidate"
			hx-swap="none"
		}
	/>
}

// Submit is the form's one primary button.
templ Submit(label string) {
	<button type="submit" class="btn btn-primary">{ label }</button>
}

// FieldError renders a validation error for a form field.
// Always renders the element so it can be targeted by OOB swaps.
templ FieldError(field string, err string) {
	<span class="field-error" id={ "error-" + field } data-has-error={ strconv.FormatBool(err != "") } aria-live="polite">@ErrText(err)</span>
}

// FieldErrorOOB renders an out-of-band swap for a field error (used with HTMX blur validation).
templ FieldErrorOOB(field string, err string) {
	<span class="field-error" id={ "error-" + field } data-has-error={ strconv.FormatBool(err != "") } aria-live="polite" hx-swap-oob="true">@ErrText(err)</span>
}

// fieldValue is the stored value, or the typed one of a refused save; a
// password is never echoed.
func fieldValue(ctx context.Context, f FieldView) string {
	if f.Type == "password" {
		return f.Value
	}
	return Kept(ctx, f.Name, f.Value)
}

func inputType(t string) string {
	if t == "" {
		return "text"
	}
	return t
}

// AuthCard is the narrow centred card the signed-out and first-run pages
// (login, register, setup, invite, CLI authorize) sit in: v0's login look,
// the logo row over a panel, the title and v0's one-line subtitle (sub,
// nil = none). .auth-card spaces its form like v0's.
templ AuthCard(title string, sub templ.Component) {
	<div class="w-full max-w-md mx-auto pt-24 px-6">
		<div class="flex items-center gap-2.5 justify-center mb-8">
			<img src={ StaticURL("images/logo-mark.png") } alt="" class="h-10 w-10"/>
			<span class="text-xl font-semibold text-rw-text">stackr</span>
		</div>
		<section class="auth-card panel p-8 shadow-rw">
			if sub != nil {
				<h1 class="text-lg font-semibold text-rw-text mb-1 text-center">{ title }</h1>
				<p class="text-sm text-rw-muted text-center mb-6">
					@sub
				</p>
			} else {
				<h1 class="text-lg font-semibold text-rw-text mb-6 text-center">{ title }</h1>
			}
			<div class="space-y-4">
				{ children... }
			</div>
		</section>
	</div>
}

// Section is v0's settings card (form.Section): a titled panel, its scope
// chip ("org", "stack") and one help line over the controls. Title "" drops
// the heading and the chip, for a card the page heading already names.
templ section(title, scope, help string, note templ.Component) {
	<section class="panel p-6 mb-6">
		if title != "" {
			<div class="flex items-baseline gap-3 mb-1">
				<h2 class="text-base font-semibold text-rw-text tracking-tight">{ title }</h2>
				if scope != "" {
					<span class="settings-scope">{ scope }</span>
				}
			</div>
		}
		if help != "" {
			<p class="text-sm text-rw-muted mb-4 max-w-2xl">{ help }</p>
		} else if title != "" {
			<div class="mb-4"></div>
		}
		{ children... }
		if note != nil {
			<div class="mt-4">
				@note
			</div>
		}
	</section>
}

templ errDetailLine(d string) {
	<span class="mt-0.5 block font-mono text-[11px] opacity-80 [overflow-wrap:anywhere]">{ d }</span>
}

// PanelSection is a titled block inside a drawer's settings tab (v0
// panelSection): a hairline over each block after the first.
templ PanelSection(id, title, help string) {
	<section id={ id } class="pt-6 mt-6 border-t border-rw-border first:pt-0 first:mt-0 first:border-0">
		<h4 class="text-xs font-semibold uppercase tracking-wide text-rw-faint mb-1">{ title }</h4>
		if help != "" {
			<p class="text-xs text-rw-faint mb-3">{ help }</p>
		} else {
			<div class="mb-3"></div>
		}
		<div class="space-y-4">
			{ children... }
		</div>
	</section>
}

// DangerZone is the delete block, always last in its tab or row (v0
// ConfirmDanger): what goes, the path it lives at, what is kept, then the
// button that opens the typed confirm (children).
templ DangerZone(warning, path, kept string) {
	<section class="mt-8 first:mt-0 rounded-lg border border-rw-danger/40 p-4">
		<h3 class="text-sm font-semibold text-rw-danger mb-2">Danger zone</h3>
		<p class="text-sm text-rw-text mb-1">{ warning }</p>
		if path != "" {
			<p class="text-xs text-rw-faint font-mono mb-1">{ path }</p>
		}
		if kept != "" {
			<p class="text-xs text-rw-faint">{ kept }</p>
		}
		<div class="mt-3 empty:hidden">
			{ children... }
		</div>
	</section>
}

// FieldMarks follows a field's label: the changed dot and where an
// inherited value comes from. settings-find skips both when it searches.
templ FieldMarks(changed bool, from string) {
	if changed {
		<span class="changed-dot" title="Changed from default" data-find-skip><span class="sr-only">{ " Changed" }</span></span>
	}
	if from != "" {
		<span class="from-tag" data-find-skip><span class="sr-only">{ " " }</span>from { from }</span>
	}
}

// Inherited is the line under a field left empty: what applies and where
// it comes from.
templ Inherited(value, from string) {
	<span class="settings-help">inherits { value } from { from }</span>
}
