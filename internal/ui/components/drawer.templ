package components

// SideDrawer is the one drawer, placed once in the layout outside #main so
// navigation never replaces it. A card click hx-gets a tab into
// #drawer-body; <side-drawer> opens on that swap, and closes itself on
// [data-close], [data-backdrop] or Escape (dropping ?drawer and ?tab).
// A fresh load of ?drawer=&tab= renders it open with body inside.
templ SideDrawer(body templ.Component, tab string) {
	<side-drawer
		if body != nil {
			open
		}
		if tab != "" {
			tab={ tab }
		}
	>
		<div data-backdrop class="fixed inset-0 z-40 bg-black/40"></div>
		<aside
			role="dialog"
			aria-modal="true"
			aria-label="Details"
			class="fixed inset-y-0 right-0 z-40 w-full max-w-xl overflow-y-auto border-l border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900"
		>
			<button type="button" class="btn float-right" data-close aria-label="Close">Close</button>
			<div id="drawer-body">
				if body != nil {
					@body
				}
			</div>
		</aside>
	</side-drawer>
}

// DrawerLoad is a drawer body that fetches itself: a fresh load of
// ?drawer= for a card whose drawer another handler serves.
templ DrawerLoad(url string) {
	<div hx-get={ url } hx-trigger="load" hx-target="this" hx-swap="outerHTML" hx-push-url="false" aria-busy="true">Loading…</div>
}
