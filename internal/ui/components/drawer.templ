package components

// SideDrawer is the one drawer, placed once in the layout outside #main so
// navigation never replaces it. A card click hx-gets a tab into
// #drawer-body; <side-drawer> opens on that swap, and closes itself on
// [data-close] (the X in every DrawerHead), [data-backdrop] or Escape
// (dropping ?drawer and ?tab). A fresh load of ?drawer=&tab= renders it
// open with body inside. The slide and the scrim are CSS (input.css).
templ SideDrawer(body templ.Component, tab string) {
	<side-drawer
		if body != nil {
			open
		}
		if tab != "" {
			tab={ tab }
		}
	>
		<div data-backdrop></div>
		<aside
			role="dialog"
			aria-modal="true"
			aria-label="Details"
			class="fixed top-0 right-0 z-40 h-full w-full max-w-2xl overflow-y-auto border-l border-rw-border bg-rw-surface"
		>
			<div id="drawer-body">
				if body != nil {
					@body
				}
			</div>
		</aside>
	</side-drawer>
}

// DrawerHead is the top of a drawer body drawn outside Drawer: the
// title, what it is, and the 32px close X (v0 PanelHeader, no extras).
templ DrawerHead(title, kind string) {
	@panelHeader(DrawerView{Title: title, Kind: kind})
}

// DrawerLoad is a drawer body that fetches itself: a fresh load of
// ?drawer= for a card whose drawer another handler serves.
templ DrawerLoad(url string) {
	<div hx-get={ url } hx-trigger="load" hx-target="this" hx-swap="outerHTML" hx-push-url="false" aria-busy="true" class="p-6 text-sm text-rw-muted">Loading…</div>
}
