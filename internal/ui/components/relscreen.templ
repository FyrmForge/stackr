package components

import "strconv"

// RelScreen is the Releases screen (releases view RFC, section 5, mock 5):
// the scope tree on the left, the state filter, source and search above one
// list of every release, failure and config plan in scope. The list is the
// page; there is no filled button.
type RelScreen struct {
	Action  string // GET of the page, without a query
	Live    string // the page's own address, polled
	Scopes  []RelScope
	Scope   string // the picked scope key
	State   string
	Source  string
	Q       string
	States  []RelStateLink
	Sources []RelOption
	Rows    []ReleaseLineView
	Total   int    // rows that matched
	Range   string // "51–100 of 340"; "" = one page, no pager
	Newer   string // the address of the page before; "" = none
	Older   string // the address of the page after; "" = none
	Empty   string // the sentence for no rows
	Clear   string // the address with no filters; "" = none are set
}

// RelScope is one entry of the tree: Depth 0 is an org's, 1 what is in it.
// No Href = a heading.
type RelScope struct {
	Label, Href string
	Depth       int
	Waiting     int
	Active      bool
}

// RelStateLink is one stop of the state switch.
type RelStateLink struct {
	Label, Href string
	Count       int
	Active      bool
}

// RelOption is one source the filter offers.
type RelOption struct{ Value, Label string }

templ RelScreenView(v RelScreen) {
	// the modal slot sits outside #rel-screen: the live poll swaps that and would close it
	@ReleaseModalSlot()
	<div id="rel-screen" class="w-full max-w-[1280px] mx-auto px-4 sm:px-6 py-5">
		@LiveTab(v.Live, "rel-screen")
		<section class="panel flex flex-col overflow-hidden md:flex-row">
			<nav aria-label="Scopes" class="flex shrink-0 flex-row gap-1 overflow-x-auto border-b border-rw-border p-2 md:w-44 md:flex-col md:overflow-visible md:border-b-0 md:border-r">
				for _, s := range v.Scopes {
					if s.Href == "" {
						<span class="mt-2 flex h-6 shrink-0 items-center whitespace-nowrap px-2 text-xs text-rw-faint">{ s.Label }</span>
					} else {
					<a
						href={ templ.SafeURL(s.Href) }
						hx-get={ s.Href }
						hx-target="#main"
						hx-push-url="true"
						class={ "flex h-8 shrink-0 items-center gap-2 whitespace-nowrap rounded-md px-2 text-sm max-sm:h-11",
							templ.KV("pl-6", s.Depth > 0),
							templ.KV("bg-rw-inset text-rw-text", s.Active), templ.KV("text-rw-muted hover:text-rw-text", !s.Active) }
						if s.Active {
							aria-current="page"
						}
					>
						<span class="truncate">{ s.Label }</span>
						if s.Waiting > 0 {
							<span class="ml-auto text-xs text-rw-accentHi">{ strconv.Itoa(s.Waiting) }</span>
						}
					</a>
					}
				}
			</nav>
			<div class="min-w-0 flex-1">
				<form
					class="flex flex-wrap items-center gap-3 border-b border-rw-border p-3"
					hx-get={ v.Action }
					hx-target="#rel-screen"
					hx-select="#rel-screen"
					hx-swap="outerHTML"
					hx-push-url="true"
					hx-trigger="change, submit, input delay:400ms from:#rel-q"
				>
					<input type="hidden" name="scope" value={ v.Scope }/>
					<input type="hidden" name="state" value={ v.State }/>
					<nav aria-label="State" class="inline-flex rounded-md bg-rw-inset p-0.5 text-sm">
						for _, s := range v.States {
							<a
								href={ templ.SafeURL(s.Href) }
								hx-get={ s.Href }
								hx-target="#main"
								hx-push-url="true"
								class={ "flex h-7 items-center gap-1.5 whitespace-nowrap rounded px-2.5 max-sm:h-11",
									templ.KV("bg-rw-raised text-rw-text", s.Active), templ.KV("text-rw-muted hover:text-rw-text", !s.Active) }
								if s.Active {
									aria-current="true"
								}
							>
								{ s.Label }
								if s.Count > 0 {
									<span class="text-xs text-rw-accentHi">{ strconv.Itoa(s.Count) }</span>
								}
							</a>
						}
					</nav>
					<select id="rel-source" name="source" class="input !w-auto !py-1.5 text-sm max-sm:!min-h-11" aria-label="Source">
						<option value="">Any source</option>
						for _, o := range v.Sources {
							<option value={ o.Value } selected?={ o.Value == v.Source }>{ o.Label }</option>
						}
					</select>
					<input id="rel-q" hx-preserve="true" type="search" name="q" value={ v.Q } class="input !w-full sm:!w-60 !py-1.5 text-sm max-sm:!min-h-11" placeholder="Search commit or message" aria-label="Search commit or message"/>
				</form>
				if len(v.Rows) == 0 {
					<div class="flex flex-col items-start gap-2 p-4 text-sm text-rw-muted">
						<p>{ v.Empty }</p>
						if v.Clear != "" {
							<a href={ templ.SafeURL(v.Clear) } hx-get={ v.Clear } hx-target="#main" hx-push-url="true" data-rel-clear class="link">Clear filters</a>
						}
					</div>
				} else {
					<ul class="divide-y divide-rw-border">
						for _, r := range v.Rows {
							<li>
								@ReleaseLine(r)
							</li>
						}
					</ul>
					if v.Range != "" {
						<nav aria-label="Pagination" class="flex items-center justify-between border-t border-rw-border px-3 py-2 text-sm">
							if v.Newer != "" {
								@NavLink(Link{Label: "Newer", Href: v.Newer})
							} else {
								<span></span>
							}
							<span class="text-rw-muted">{ v.Range }</span>
							if v.Older != "" {
								@NavLink(Link{Label: "Older", Href: v.Older})
							} else {
								<span></span>
							}
						</nav>
					}
				}
			</div>
		</section>
	</div>
}
