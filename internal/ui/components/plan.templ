package components

// PlanView is a promote or rollback dry run (service.PromotePlan), or a
// release diff: what would change, what blocks it, what to watch.
// CanDeploy is the service's verdict; the page greys its button on it.
type PlanView struct {
	Title     string // "Promote release 12 to prod"
	Changes   []ChangeView
	Blockers  []string
	Warnings  []string
	CanDeploy bool
}

// ChangeView mirrors promote.Change.
type ChangeView struct {
	Kind  string // env | stack | param | volume | orphan | create | update | delete | domain | slice | detach | image
	Tile  string
	Field string
	Old   string
	New   string
	Note  string
}

// Plan is v0's plan review: blockers and warnings as banners, then one
// row per change, its sign (+ create, - delete, ~ the rest) and old → new.
templ Plan(p PlanView) {
	<section class="space-y-3" aria-label={ p.Title }>
		<h3 class="section-title">{ p.Title }</h3>
		if len(p.Blockers) > 0 {
			<div class="banner banner-danger" role="alert">
				<p class="font-medium">Blocked:</p>
				<ul class="list-disc pl-5">
					for _, b := range p.Blockers {
						<li>{ b }</li>
					}
				</ul>
			</div>
		}
		if len(p.Warnings) > 0 {
			<div class="banner border-rw-warn/40 bg-rw-warn/10 text-rw-warn">
				<ul class="list-disc pl-5">
					for _, w := range p.Warnings {
						<li>{ w }</li>
					}
				</ul>
			</div>
		}
		if len(p.Changes) == 0 {
			<p class="text-sm text-rw-faint">Nothing changes.</p>
		}
		<ul class="space-y-2">
			for _, c := range p.Changes {
				<li class="panel px-4 py-2.5 text-sm">
					<div class="flex flex-wrap items-center gap-2 font-mono">
						<span class={ planSignClass(c.Kind) } aria-hidden="true">{ planSign(c.Kind) }</span>
						<span class="text-rw-faint">{ c.Kind }</span>
						if c.Tile != "" {
							<span class="text-rw-text">{ c.Tile }</span>
						}
						if c.Field != "" {
							<span class="text-rw-muted">{ c.Field }</span>
						}
						if c.Old != "" || c.New != "" {
							<span class="text-rw-faint ml-auto truncate max-w-[50%]">
								if c.Old != "" {
									<span class="text-rw-danger line-through">{ c.Old }</span>
								}
								if c.Old != "" && c.New != "" {
									<span class="mx-1">→</span>
								}
								if c.New != "" {
									<span class="text-rw-success">{ c.New }</span>
								}
							</span>
						}
					</div>
					if c.Note != "" {
						<p class="mt-1 pl-6 text-xs text-rw-muted">{ c.Note }</p>
					}
				</li>
			}
		</ul>
	</section>
}

func planSign(kind string) string {
	switch kind {
	case "create":
		return "+"
	case "delete", "orphan", "detach":
		return "-"
	}
	return "~"
}

// planSignClass spells every class in full so tailwind keeps them.
func planSignClass(kind string) string {
	switch planSign(kind) {
	case "+":
		return "text-rw-success shrink-0 w-4"
	case "-":
		return "text-rw-danger shrink-0 w-4"
	}
	return "text-rw-warn shrink-0 w-4"
}
