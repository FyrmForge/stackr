package components

// SettingsAcc is a Settings tab as accordions: one row per group, at most
// one open, each closed row summing up its values. <settings-find> owns the
// search bar, the one-open rule while searching and the open row in ?open=.
type SettingsAcc struct {
	ID   string // unique on the page: the rows' <details name> and the ids
	Rows []AccRow
	Open string // the Key open on load (from ?open=); "" = all closed
}

// AccRow is one group. Body holds its fields (Field, SettingsForm, ...):
// settings-find searches their labels and reads their data-changed.
type AccRow struct {
	Key     string // ?open= value, unique in the accordion
	Title   string
	Summary string // its values in one line; truncates
	Changed bool   // something in it is set here: a dot after the title
	Body    templ.Component
}

templ SettingsAccordion(v SettingsAcc) {
	<settings-find id={ v.ID } class="block">
		<div class="flex items-center gap-3 mb-5">
			<div class="relative flex-1">
				<svg class="absolute left-3 top-1/2 -translate-y-1/2 h-3.5 w-3.5 text-rw-faint pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
				<label for={ v.ID + "-find" } class="sr-only">Find a setting</label>
				<input type="search" id={ v.ID + "-find" } class="input !pl-9" placeholder="Find a setting" autocomplete="off" data-find/>
			</div>
			<label class="flex items-center gap-2 text-sm text-rw-muted cursor-pointer whitespace-nowrap"><input type="checkbox" class="accent-rw-accent" data-only-changed/> Only changed</label>
		</div>
		<p class="text-xs text-rw-faint mb-2 empty:mb-0" role="status" aria-live="polite" data-find-status></p>
		<div class="space-y-2">
			for _, r := range v.Rows {
				<details id={ v.ID + "-" + r.Key } name={ v.ID } class="panel group" data-acc={ r.Key } data-changed?={ r.Changed } open?={ r.Key == v.Open }>
					<summary class="flex items-center gap-3 px-4 py-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
						<span class="text-sm font-semibold text-rw-text w-36 shrink-0" data-acc-title>
							{ r.Title }
							@FieldMarks(r.Changed, "")
						</span>
						<span class="flex-1 min-w-0 truncate text-sm text-rw-muted">{ r.Summary }</span>
						<svg class="h-4 w-4 shrink-0 text-rw-faint transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
					</summary>
					<div class="px-4 pb-5 pt-4 space-y-4 border-t border-rw-border">
						if r.Body != nil {
							@r.Body
						}
					</div>
				</details>
			}
		</div>
	</settings-find>
}
