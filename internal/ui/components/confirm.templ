package components

// ConfirmView guards a destructive action. Kept says what survives
// ("archives already in the bucket are kept"); a type-the-name confirm
// (Word set) must fill it, and Confirm panics without it so the gallery
// test catches the omission. Target "" = the answer swaps nothing (the
// handler redirects or triggers).
type ConfirmView struct {
	Button  string // the button that opens the dialog
	Title   string
	Warning string
	Kept    []string
	Word    string // type this to enable Confirm; "" = a plain confirm
	Action  string // hx-post on "confirmed"
	Target  string
	Quiet   bool   // the opener is a ghost button (a header Stop / Restart)
	Vals    string // hx-vals JSON posted with the action; "" = none

	Open    bool            // asked on arrival, no opener (the promote question)
	Primary bool            // the yes is not destructive: primary, not danger
	Body    templ.Component // more than Warning (a plan), under it
}

// Confirm wraps <confirm-dialog>. The element fires "confirmed" (bubbling)
// on yes; the wrapper div carries the hx-post that listens for it.
func Confirm(v ConfirmView) templ.Component {
	if v.Word != "" && len(v.Kept) == 0 {
		panic("components.Confirm: a type-the-name confirm must say what is kept")
	}
	return confirm(v, swapOf(v.Target))
}

func swapOf(target string) string {
	if target == "" {
		return "none"
	}
	return "outerHTML"
}

// confirm is v0's typed Modal look (.modal-panel/head/body/foot) on a
// native <dialog>; the X in the head is a second [data-cancel].
templ confirm(v ConfirmView, swap string) {
	<div
		if v.Action != "" {
			hx-post={ v.Action }
			hx-trigger="confirmed"
			hx-target={ v.Target }
			hx-swap={ swap }
		}
		if v.Vals != "" {
			hx-vals={ v.Vals }
		}
	>
		<confirm-dialog word={ v.Word } open?={ v.Open }>
			if !v.Open {
				<button type="button" class={ "btn btn-sm", templ.KV("btn-ghost", v.Quiet), templ.KV("btn-primary", !v.Quiet && v.Primary), templ.KV("btn-danger", !v.Quiet && !v.Primary) } data-open>{ v.Button }</button>
			}
			<dialog class="modal-panel text-rw-text">
				<div class="modal-head">
					<div class="min-w-0">
						<h2 class="modal-title">{ v.Title }</h2>
					</div>
					<button type="button" class="ml-auto text-rw-faint hover:text-rw-text transition-colors" data-cancel aria-label="Close">
						<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<line x1="18" y1="6" x2="6" y2="18"></line>
							<line x1="6" y1="6" x2="18" y2="18"></line>
						</svg>
					</button>
				</div>
				<div class="modal-body">
					if v.Warning != "" {
						<p>{ v.Warning }</p>
					}
					if v.Body != nil {
						@v.Body
					}
					if len(v.Kept) > 0 {
						<div>
							<p class="mb-1.5 text-xs font-medium text-rw-muted">Kept:</p>
							<ul class="modal-list">
								for _, k := range v.Kept {
									<li class="modal-list-row text-rw-text">{ k }</li>
								}
							</ul>
						</div>
					}
					if v.Word != "" {
						<div>
							<label class="label">Type <span class="font-mono text-rw-text">{ v.Word }</span> to confirm</label>
							<input type="text" class="input font-mono" data-word autocomplete="off" aria-label={ "Type " + v.Word + " to confirm" }/>
						</div>
					}
				</div>
				<div class="modal-foot">
					<button type="button" class="btn btn-ghost btn-sm" data-cancel>Cancel</button>
					if v.Action != "" {
						<button type="button" class={ "btn btn-sm", templ.KV("btn-primary", v.Primary), templ.KV("btn-danger", !v.Primary) } data-confirm>{ v.Button }</button>
					}
				</div>
			</dialog>
		</confirm-dialog>
	</div>
}
