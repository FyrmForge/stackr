package components

// ConfirmView guards a destructive action. Kept says what survives
// ("archives already in the bucket are kept"); a type-the-name confirm
// (Word set) must fill it, and Confirm panics without it so the gallery
// test catches the omission. Target "" = the answer swaps nothing (the
// handler redirects or triggers).
type ConfirmView struct {
	Button  string // the button that opens the dialog
	Title   string
	Warning string
	Kept    []string
	Word    string // type this to enable Confirm; "" = a plain confirm
	Action  string // hx-post on "confirmed"
	Target  string
}

// Confirm wraps <confirm-dialog>. The element fires "confirmed" (bubbling)
// on yes; the wrapper div carries the hx-post that listens for it.
func Confirm(v ConfirmView) templ.Component {
	if v.Word != "" && len(v.Kept) == 0 {
		panic("components.Confirm: a type-the-name confirm must say what is kept")
	}
	return confirm(v, swapOf(v.Target))
}

func swapOf(target string) string {
	if target == "" {
		return "none"
	}
	return "outerHTML"
}

templ confirm(v ConfirmView, swap string) {
	<div hx-post={ v.Action } hx-trigger="confirmed" hx-target={ v.Target } hx-swap={ swap }>
		<confirm-dialog word={ v.Word }>
			<button type="button" class="btn btn-danger" data-open>{ v.Button }</button>
			<dialog class="w-full max-w-md rounded-lg border border-slate-200 bg-white p-6 text-slate-900 backdrop:bg-black/50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100">
				<h2 class="text-lg font-semibold">{ v.Title }</h2>
				<p class="mt-2 text-sm">{ v.Warning }</p>
				if len(v.Kept) > 0 {
					<p class="mt-3 text-sm font-medium">Kept:</p>
					<ul class="mt-1 list-disc pl-5 text-sm text-slate-600 dark:text-slate-400">
						for _, k := range v.Kept {
							<li>{ k }</li>
						}
					</ul>
				}
				if v.Word != "" {
					<label class="label mt-4">Type <strong>{ v.Word }</strong> to confirm</label>
					<input type="text" class="input" data-word autocomplete="off" aria-label={ "Type " + v.Word + " to confirm" }/>
				}
				<div class="mt-6 flex justify-end gap-2">
					<button type="button" class="btn" data-cancel>Cancel</button>
					<button type="button" class="btn btn-danger" data-confirm>{ v.Button }</button>
				</div>
			</dialog>
		</confirm-dialog>
	</div>
}
