package components

import "time"

// LogHistoryView is the log viewer over the kept lines. Action is its own
// fragment URL (the form and Older send the filters there); Tiles is the tile
// picker, empty when the scope is one tile (then Live goes back to its live
// tail). Older is the URL of the next page, "" when this is the last.
type LogHistoryView struct {
	Action string
	Live   string
	Tiles  []LogOption
	Tile   string
	Kind   string
	Source string
	Stream string
	Run    string
	Range  string
	Text   string
	Lines  []LogHistoryLine
	Older  string
	Purge  *ConfirmView // the owner's Delete logs; nil = not offered (env tab only)
	Error  string
}

// LogOption is one choice of a viewer filter.
type LogOption struct{ Value, Label string }

// LogHistoryLine is one stored line: Text is ready to show (an access line
// reads "GET /path 200 12ms"); Err marks stderr.
type LogHistoryLine struct {
	Time   time.Time
	Tile   string
	Source string
	Text   string
	Err    bool
}

// LogRanges are the time ranges the viewer offers, as Go durations.
var LogRanges = []LogOption{{"15m", "15 min"}, {"1h", "1 hour"}, {"6h", "6 hours"}, {"24h", "24 hours"}, {"168h", "7 days"}}

var logKinds = []LogOption{{"", "any kind"}, {"service", "service"}, {"image", "image"}, {"managed", "managed"}, {"cron", "cron"}, {"function", "function"}}

var logSources = []LogOption{{"", "any source"}, {"app", "app"}, {"access", "access"}, {"run", "run"}, {"build", "build"}}

var logStreams = []LogOption{{"", "stdout and stderr"}, {"stdout", "stdout"}, {"stderr", "stderr"}}

// LogHistory is the viewer: filters over a box of lines, newest first.
templ LogHistory(v LogHistoryView) {
	<div id="log-history" class="space-y-3">
		<form
			class="flex flex-wrap items-center gap-2"
			hx-get={ v.Action }
			hx-target="#log-history"
			hx-swap="outerHTML"
			hx-trigger="change, submit"
		>
			if len(v.Tiles) > 0 {
				@logSelect("tile", "Tile", v.Tile, v.Tiles)
				@logSelect("kind", "Kind", v.Kind, logKinds)
			} else {
				<input type="hidden" name="from" value="tile"/>
				<input type="hidden" name="tile" value={ v.Tile }/>
			}
			@logSelect("source", "Source", v.Source, logSources)
			@logSelect("stream", "Stream", v.Stream, logStreams)
			@logSelect("since", "Time range", v.Range, LogRanges)
			<input type="search" name="run" value={ v.Run } class="input !w-40 !py-1.5 text-sm font-mono" placeholder="Run id" aria-label="Run id"/>
			<input type="search" name="text" value={ v.Text } class="input !w-56 !py-1.5 text-sm font-mono" placeholder="Search text" aria-label="Search text"/>
			if v.Live != "" {
				<button type="button" class="btn btn-ghost btn-sm" hx-get={ v.Live } hx-target={ "#" + DrawerRoot } hx-swap="outerHTML">Live</button>
			}
		</form>
		if v.Error != "" {
			<p class="text-sm text-rw-danger" role="alert">{ v.Error }</p>
		}
		<div class="panel p-3 h-[65vh] overflow-y-auto font-mono text-xs leading-5" role="log">
			@LogHistoryMore(v)
		</div>
		<p class="text-xs text-rw-faint">
			{ "Newest first. Times in " }
			@Zone()
		</p>
	</div>
}

// LogHistoryMore is the lines of a page and the Older button after them; the
// button swaps itself for the next page.
templ LogHistoryMore(v LogHistoryView) {
	for _, l := range v.Lines {
		<div class="flex gap-2" data-source={ l.Source }>
			<span class="shrink-0 text-rw-faint">@Time(l.Time, "Jan 02 15:04:05")</span>
			if len(v.Tiles) > 0 {
				<span class="shrink-0 text-rw-muted">{ l.Tile }</span>
			}
			<span class={ "min-w-0 whitespace-pre-wrap break-all", templ.KV("text-rw-danger", l.Err), templ.KV("text-rw-muted", l.Source == "access") }>{ l.Text }</span>
		</div>
	}
	if len(v.Lines) == 0 && v.Error == "" {
		<p class="text-rw-muted">No lines in this range.</p>
	}
	if v.Older != "" {
		<button type="button" id="log-older" class="btn btn-ghost btn-sm mt-2" hx-get={ v.Older } hx-target="this" hx-swap="outerHTML">Older</button>
	}
}

templ logSelect(name, label, cur string, opts []LogOption) {
	<select name={ name } class="input !w-auto !py-1.5 text-xs" aria-label={ label }>
		for _, o := range opts {
			<option value={ o.Value } selected?={ o.Value == cur }>{ o.Label }</option>
		}
	</select>
}
