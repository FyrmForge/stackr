package components

import (
	"context"
	"net/url"
	"strconv"
	"strings"
	"time"
)

type pathKey struct{}

// WithPath leaves the request path on ctx, which JobSlot reads to know its
// scope's poll URL.
func WithPath(ctx context.Context, path string) context.Context {
	return context.WithValue(ctx, pathKey{}, path)
}

type tabKey struct{}

// WithTab leaves the URI of the tab fragment being drawn on ctx; a job slot
// passes it to its poll so a job found later refreshes that tab when it ends.
func WithTab(ctx context.Context, uri string) context.Context {
	return context.WithValue(ctx, tabKey{}, uri)
}

func tabOf(ctx context.Context) string {
	u, _ := ctx.Value(tabKey{}).(string)
	return u
}

// jobPoll is the job-live URL of the scope the request path is in: the
// panel's under /-/admin, an org's (one segment before its "/-/") or an
// stack's (two) or an env's (three); "" = no poll. filter is an extra query
// ("tile=<id>", "node=<id>") narrowing the job to one tile or node.
func jobPoll(ctx context.Context, kinds, filter string) string {
	p, _ := ctx.Value(pathKey{}).(string)
	base := ""
	if strings.HasPrefix(p, "/-/admin") {
		base = "/-/admin"
	} else if i := strings.Index(p, "/-/"); i > 0 {
		if n := strings.Count(p[:i], "/"); n >= 1 && n <= 3 {
			base = p[:i]
		}
	}
	if base == "" {
		return ""
	}
	u := base + "/-/job-live"
	if base == "/-/admin" {
		u = base + "/job-live"
	}
	q := []string{}
	if kinds != "" {
		q = append(q, "kind="+kinds)
	}
	if filter != "" {
		q = append(q, filter)
	}
	if t := tabOf(ctx); t != "" {
		q = append(q, "refresh="+url.QueryEscape(t))
	}
	// since: a job created after this render shows even when it ends between polls
	q = append(q, "since="+strconv.FormatInt(time.Now().UnixMilli(), 10))
	return u + "?" + strings.Join(q, "&")
}

// JobSlot is where a tab shows its scope's job: the one the page was handed
// (job), and while that is idle, a poll every 5s for a job of one of kinds
// (comma list) started since, which arrives as its live status. The slot is
// always there, so a poll that finds nothing leaves it alone (204).
templ JobSlot(job *JobStatusView, kinds string) {
	@JobSlotFor(job, kinds, "")
}

// JobSlotFor is JobSlot narrowed by filter ("tile=<id>", "node=<id>"), for a
// drawer showing one tile's or node's job; kinds may be empty (any kind).
templ JobSlotFor(job *JobStatusView, kinds, filter string) {
	<div id="job-slot" class="mb-4">
		if job != nil {
			@JobStatus(*job)
		}
		if u := jobPoll(ctx, kinds, filter); u != "" && (job == nil || !job.Live) {
			<span hidden data-poll-guard="region" hx-get={ u } hx-trigger="every 5s" hx-select="#job-slot" hx-target="#job-slot" hx-swap="outerHTML"></span>
		}
	</div>
}

// JobSlotLive is a slot answer holding a running job: no poll, its own stream.
templ JobSlotLive(job JobStatusView) {
	<div id="job-slot" class="mb-4">
		@JobStatus(job)
	</div>
}
