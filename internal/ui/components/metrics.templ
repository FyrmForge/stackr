package components

import (
	"net/url"
	"slices"
	"strconv"
	"strings"
	"time"
)

// MetricRanges are the ranges a metrics view offers, the first the default.
var MetricRanges = []string{"1h", "6h", "24h"}

// LongRanges are offered too while metrics history is on (Go durations, so
// every reader parses them; rangeLabel names them).
var LongRanges = []string{"168h", "720h"}

// MetricRange is the asked range when it is one on offer, else the default.
func MetricRange(r string) string {
	if slices.Contains(MetricRanges, r) || slices.Contains(LongRanges, r) {
		return r
	}
	return MetricRanges[0]
}

func ranges(long bool) []string {
	if long {
		return append(slices.Clone(MetricRanges), LongRanges...)
	}
	return MetricRanges
}

func rangeLabel(r string) string {
	switch r {
	case "168h":
		return "7d"
	case "720h":
		return "30d"
	}
	return r
}

// WithRange is u with ?range=r set.
func WithRange(u, r string) string {
	p, err := url.Parse(u)
	if err != nil {
		return u
	}
	q := p.Query()
	q.Set("range", r)
	p.RawQuery = q.Encode()
	return p.String()
}

// MetricsView is a live metrics view. Pick is one chart's window (its
// measures, space separated), written into the page; Events streams each
// sampler round's new points; Reload is the view's GET without ?range=.
// Long offers LongRanges (metrics history is on).
type MetricsView struct {
	Range, Reload, Events string
	Pick                  func(measures string) any
	Long                  bool
}

// seconds is the range for the charts' trim.
func (v MetricsView) seconds() string {
	d, _ := time.ParseDuration(v.Range)
	return strconv.Itoa(int(d.Seconds()))
}

// Metrics wraps a view's charts: the range picker, then the charts, which
// append each "points" event of the one stream. A stream that drops and
// comes back reloads the view once (metric-chart asks with metrics-refill),
// so the gap fills.
templ Metrics(v MetricsView) {
	<div
		class="space-y-4"
		hx-ext="sse"
		sse-connect={ v.Events }
		hx-get={ WithRange(v.Reload, v.Range) }
		hx-target={ "#" + DrawerRoot }
		hx-swap="outerHTML"
		hx-trigger="metrics-refill once"
	>
		@RangePicker(v.Reload, v.Range, v.Long)
		{ children... }
	</div>
}

// RangePicker reloads the drawer view at reload with another ?range=.
templ RangePicker(reload, cur string, long bool) {
	<div class="flex items-center gap-1" role="group" aria-label="Time range">
		for _, r := range ranges(long) {
			<button
				type="button"
				hx-get={ WithRange(reload, r) }
				hx-target={ "#" + DrawerRoot }
				hx-swap="outerHTML"
				aria-pressed={ strconv.FormatBool(r == cur) }
				class={ "btn btn-sm", templ.KV("btn-primary", r == cur), templ.KV("btn-ghost", r != cur) }
			>{ rangeLabel(r) }</button>
		}
	</div>
}

// Chart is one titled graph inside Metrics: measures the series it draws
// (space separated), labels their names (comma separated), unit how values
// read: pct, ratio, bytes, bps, rps (per second), ms or s.
templ Chart(v MetricsView, title, measures, labels, unit string) {
	<section class="panel p-4">
		<h3 class="text-sm font-medium text-rw-text mb-2">{ title }</h3>
		<metric-chart class="block min-h-40" measures={ measures } labels={ labels } unit={ unit } range={ v.seconds() } hx-trigger="sse:points">
			@templ.JSONScript("metrics-"+strings.ReplaceAll(measures, " ", "-"), v.Pick(measures))
		</metric-chart>
	</section>
}
