package components

import "strings"

// SettingsFormView is one rung of the settings cascade (server, org, stack,
// env), one row per catalogue knob the rung may set. The same shape at
// every level; the service answers what applies and who decided it.
type SettingsFormView struct {
	ID       string // form id, unique on the page
	Target   string // where a save answers (outerHTML); "" = the form itself
	Action   string
	Scope    string // the rung being edited, for the legend
	Rows     []SettingRowView
	ReadOnly bool
	Why      string
	Error    string // a refusal no one row owns
	Note     string // what a save did
	Flat     bool   // one list, no section heads: a Section around it titles it
	// Flush says the form ends a Section's card: the pending footer then runs
	// edge to edge as that card's footer, as the variables build's does.
	Flush bool
	// Keys is the rows the form shows, in this order; nil = every row. A
	// key with no row is skipped.
	Keys []string
	// Confirm asks before the save is applied, inside the form; its yes
	// posts the form again with what Vals adds.
	Confirm *ConfirmView
}

// SettingRowView mirrors a settings.Knob plus the cascade's answer.
type SettingRowView struct {
	Key       string
	Label     string // the catalogue's; "" shows Key
	Desc      string
	Type      string // int | float | bool | string
	Value     string // this rung's value; "" = inherit
	Effective string // what applies here ("set" / "not set" for a secret)
	DecidedBy string // the rung it comes from
	Secret    bool   // never echoed: a password box, blank keeps it
	ReadOnly  bool   // the installer set it: shown as text, never posted
	Error     string
	Found     bool   // a search hit opened this row: marked, its control (not a secret's) focused
	Changed   bool  // this rung sets it: the dot, and data-changed for settings-find
	From      string // where an inherited value comes from ("org"): a tag after the label
	// NoInherit: a flat knob, no rung above it. No Inherit choice and no
	// "inherit" placeholder.
	NoInherit bool
	// Options: a string knob with a fixed set of values, shown as a select.
	Options []Option
	// Sub is a line under the value in read mode, with an optional link
	// that posts into Target ("Checked 4 min ago. Check now").
	Sub *RowSub
	// Fact: a value shown in the same grid, with no pencil and no field.
	Fact bool
}

// RowSub is a row's note and its link; Action "" = no link.
type RowSub struct{ Text, Label, Action, Target string }

func (v SettingsFormView) target() string {
	if v.Target != "" {
		return v.Target
	}
	return "#" + v.ID
}

// knobSection is the v0 section each catalogue key sits in; the label is
// the catalogue's (SettingRowView.Label).
var knobSection = map[string]string{
	"cpu_limit":                  "Resources",
	"mem_limit_mb":               "Resources",
	"protect":                    "Protect",
	"protect_user":               "Protect",
	"protect_password":           "Protect",
	"workers":                    "Jobs",
	"backup_run_concurrency":     "Jobs",
	"backup_restore_concurrency": "Jobs",
	"image_check_interval":       "Images",
	"cleanup_enabled":            "Images",
	"orphan_retention_days":      "Volumes",
	"orphans_enabled":            "Volumes",
	"orphans_schedule":           "Volumes",
	"cleanup_schedule":           "Images",
	"registry_cleanup_schedule":  "Images",
	"registry_keep":              "Images",
	"panel_backup_enabled":       "Backups",
	"panel_backup_schedule":      "Backups",
	"panel_backup_keep":          "Backups",
	"panel_backup_dest":          "Backups",
	"observe_enabled":            "Observability",
	"observe_metrics_retention":  "Observability",
	"observe_min_free":           "Observability",
	"observe_logs_enabled":       "Observability",
	"observe_logs_retention":     "Observability",
	"observe_logs_max_size":      "Observability",
	"observe_max_memory":         "Observability",
	"observe_access_query":       "Observability",
	"observe_access_ip":          "Observability",
	"observe_access_headers":     "Observability",
	"panel_domain":               "Panel and proxy",
	"panel_address":              "Panel and proxy",
	"acme_email":                 "Panel and proxy",
	"trusted_proxies":            "Panel and proxy",
	"proxy_custom":               "Panel and proxy",
	"root_domain":                "Panel and proxy",
}

var knobSections = []string{"Resources", "Protect", "Jobs", "Images", "Volumes", "Backups", "Observability", "Panel and proxy", "Other"}

// shown is the rows Keys picks, in Keys order; every row when Keys is nil.
func (v SettingsFormView) shown() []SettingRowView {
	if v.Keys == nil {
		return v.Rows
	}
	by := map[string]SettingRowView{}
	for _, r := range v.Rows {
		by[r.Key] = r
	}
	var out []SettingRowView
	for _, k := range v.Keys {
		if r, ok := by[k]; ok {
			out = append(out, r)
		}
	}
	return out
}

func knobLabel(r SettingRowView) string {
	if r.Label != "" {
		return r.Label
	}
	return r.Key
}

// sectioned groups the rows by v0 section, in section order; a key the
// table does not know lands in "Other".
func sectioned(rows []SettingRowView) [][]SettingRowView {
	by := map[string][]SettingRowView{}
	for _, r := range rows {
		s := "Other"
		if k, ok := knobSection[r.Key]; ok {
			s = k
		}
		by[s] = append(by[s], r)
	}
	var out [][]SettingRowView
	for _, s := range knobSections {
		if len(by[s]) > 0 {
			out = append(out, by[s])
		}
	}
	return out
}

func sectionOf(rows []SettingRowView) string {
	if k, ok := knobSection[rows[0].Key]; ok {
		return k
	}
	return "Other"
}

// sentence is a catalogue description as help text.
func sentence(s string) string {
	if s == "" {
		return ""
	}
	s = strings.ToUpper(s[:1]) + s[1:]
	if !strings.HasSuffix(s, ".") {
		s += "."
	}
	return s
}

// Sentence is a catalogue description as help text.
func Sentence(s string) string { return sentence(s) }

// from names the rung a value comes from, as v0's Inherited says it.
func from(rung string) string {
	if rung == "" || rung == "default" {
		return "the built-in default"
	}
	return "the " + rung
}

func onOff(v string) string {
	switch v {
	case "true":
		return "on"
	case "false":
		return "off"
	}
	return v
}

// Option is one choice of a select: the value posted, the words shown.
type Option struct{ Value, Label string }

// ConfigRepoView is the config-as-code binding, the same fields and words
// on the org and the stack.
type ConfigRepoView struct {
	ID          string // the connector select's id
	Connectors  []Option
	Connector   string
	Repo        string
	Branch      string
	Path        string
	File        string // the file read when Path is empty
	Placeholder string // the repository's example
	AutoApply   bool   // offer Auto apply (the org file plans before it applies)
	Auto        bool
}

templ ConfigRepoFields(v ConfigRepoView) {
	<div data-field data-changed?={ v.Connector != "" }>
		<label for={ v.ID + "-connector" } class="label">Connector</label>
		<select id={ v.ID + "-connector" } name="connector" class="input" { Invalid("connector", KeptErr(ctx, "connector", ""))... }>
			<option value="">None (a public repository)</option>
			for _, o := range v.Connectors {
				<option value={ o.Value } selected?={ o.Value == Kept(ctx, "connector", v.Connector) }>{ o.Label }</option>
			}
		</select>
		<p class="mt-1.5 text-xs text-rw-faint" data-hint>Which connector supplies the credentials.</p>
		@FieldError("connector", KeptErr(ctx, "connector", ""))
	</div>
	@Field(FieldView{Name: "repo", Label: "Repository", Value: v.Repo, Changed: v.Repo != "", Placeholder: v.Placeholder, Help: "owner/name or the https URL, either works."})
	@Field(FieldView{Name: "branch", Label: "Branch", Value: v.Branch, Changed: v.Branch != "", Placeholder: "main", Help: "Empty uses the repository's default branch."})
	@Field(FieldView{Name: "path", Label: "Config path", Value: v.Path, Changed: v.Path != "", Placeholder: v.File, Help: "Empty uses " + v.File + "."})
	if v.AutoApply {
		<input type="hidden" name="fields" value="auto"/>
		<label class="flex items-center gap-2 text-sm text-rw-text" data-field data-changed?={ v.Auto }><input type="checkbox" name="auto" value="1" checked?={ KeptOn(ctx, "auto", v.Auto) } class="accent-rw-accent"/> <span class="settings-label">Auto apply a plan with no impact lines and no removals</span></label>
	}
}

templ SettingsForm(v SettingsFormView) {
	<form id={ v.ID } if !v.ReadOnly { hx-post={ v.Action } } hx-target={ v.target() } hx-swap="outerHTML" class="group space-y-4">
		if v.ReadOnly && v.Why != "" {
			<p class="banner">{ v.Why }</p>
		}
		<settings-read class="block">
		<fieldset disabled?={ v.ReadOnly }>
			<legend class="sr-only">{ v.Scope } settings</legend>
			if v.Flat {
				<div class="divide-y divide-rw-border [&>*]:py-2">
					for _, r := range v.shown() {
						@settingRow(v.ID, r, !v.ReadOnly)
					}
				</div>
			} else {
				for _, rows := range sectioned(v.shown()) {
					@PanelSection(v.ID+"-"+strings.ReplaceAll(strings.ToLower(sectionOf(rows)), " ", "-"), sectionOf(rows), "") {
						for _, r := range rows {
							@settingRow(v.ID, r, !v.ReadOnly)
						}
					}
				}
			}
		</fieldset>
		if !v.ReadOnly {
			// the edits held in the rows, listed; <settings-read> shows it while any is held or open
			<div data-pending hidden class={ "mt-4 border-t border-rw-border", templ.KV("-mx-4 sm:-mx-6 -mb-4 sm:-mb-6 bg-rw-inset px-4 py-3 sm:px-6", v.Flush), templ.KV("pt-3", !v.Flush) }>
				<p data-count class="text-xs font-medium text-rw-muted"></p>
				<ul data-list class="mt-1.5 space-y-1"></ul>
				<div class="mt-3 flex flex-wrap items-center gap-2 group-[.htmx-request]:hidden">
					<button type="submit" class="btn btn-primary btn-sm">Apply</button>
					<button type="button" class="btn btn-ghost btn-sm" data-cancel-all>Cancel</button>
				</div>
				<div class="mt-3 hidden items-center gap-2 group-[.htmx-request]:flex">
					<span class="btn btn-primary btn-sm opacity-60 cursor-not-allowed" aria-disabled="true"><span class="spin" style="margin-top:0;margin-right:.4rem;border-color:currentColor;border-top-color:transparent"></span>Applying</span>
				</div>
			</div>
		}
		</settings-read>
		// the answer by the Save that posted it, inside the form it swaps
		if v.Error != "" {
			@actedNote(FormError(v.Error))
		} else if v.Note != "" {
			@actedNote(Note(v.Note))
		}
		if v.Confirm != nil {
			@Confirm(*v.Confirm)
		}
	</form>
}

templ settingRow(form string, r SettingRowView, read bool) {
	if r.Fact {
		@factOnly(r)
	} else if r.ReadOnly {
		@readOnlyRow(r)
	} else if read {
		@factRow(form, r)
	} else {
		@editRow(form, r)
	}
}

// factRow is a knob as a fact: its value and a pencil. The control itself
// sits behind the pencil (<settings-read>), open at once when a search hit it
// or its save was refused.
templ factRow(form string, r SettingRowView) {
	{{ open := r.Found || r.Error != "" }}
	<div data-row data-label={ knobLabel(r) } data-field data-find-key={ r.Key } data-changed?={ r.Changed } if r.Found { class="is-found" }>
		<div data-read hidden?={ open }>
			<div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 gap-y-0.5 py-1 text-sm sm:grid-cols-[14rem_minmax(0,1fr)_auto]">
				<span class="col-span-2 settings-label sm:col-span-1">
					{ knobLabel(r) }
					@FieldMarks(r.Changed, r.From)
				</span>
				<span data-val class="min-w-0 text-rw-text [overflow-wrap:anywhere]">
					@factValue(r)
					@rowSub(r)
				</span>
				<span class="flex items-center justify-end">
					<span data-undo hidden><button type="button" class="inline-flex h-7 w-7 group-[.htmx-request]:pointer-events-none group-[.htmx-request]:opacity-40 items-center justify-center rounded-md text-rw-faint hover:text-rw-text hover:bg-rw-inset transition-colors" title="Undo" aria-label={ "Undo " + knobLabel(r) }>@settingUndoIcon()</button></span>
					<button type="button" data-edit class="inline-flex h-7 w-7 group-[.htmx-request]:pointer-events-none group-[.htmx-request]:opacity-40 items-center justify-center rounded-md text-rw-faint hover:text-rw-text hover:bg-rw-inset transition-colors" title="Edit" aria-label={ "Edit " + knobLabel(r) }>@settingPenIcon()</button>
				</span>
			</div>
		</div>
		<div data-editor hidden?={ !open }>
			@editBody(form, r)
			<button type="button" data-cancel class="btn btn-ghost btn-sm mt-1">Cancel</button>
		</div>
	</div>
}

// rowSub is a row's note under its value, with its link.
templ rowSub(r SettingRowView) {
	if r.Sub != nil {
		<p class="mt-0.5 flex flex-wrap items-center gap-x-1.5 text-xs text-rw-faint">
			<span>{ r.Sub.Text }</span>
			if r.Sub.Action != "" {
				<button type="button" class="link" hx-post={ r.Sub.Action } hx-target={ r.Sub.Target } hx-swap="outerHTML">{ r.Sub.Label }</button>
			}
		</p>
	}
}

// factOnly is a fact the form never edits: the factRow grid without a pencil.
templ factOnly(r SettingRowView) {
	<div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 gap-y-0.5 py-1 text-sm sm:grid-cols-[14rem_minmax(0,1fr)_auto]">
		<span class="col-span-2 settings-label sm:col-span-1">{ knobLabel(r) }</span>
		<span class="min-w-0 text-rw-text [overflow-wrap:anywhere]">
			@factValue(r)
			@rowSub(r)
		</span>
	</div>
}

// factValue is what applies, in words: the value set here, else what is
// inherited, tagged default while only the built-in default is above.
templ factValue(r SettingRowView) {
	if r.Secret {
		if r.Effective == "set" {
			<span>Set</span>
		} else {
			<span class="text-rw-faint">Not set</span>
		}
	} else if r.Value != "" {
		<span>{ factWords(r, r.Value) }</span>
	} else if r.Effective == "" {
		<span class="text-rw-faint">Not set</span>
	} else {
		<span class="text-rw-faint">{ factWords(r, r.Effective) }</span>
		if r.DecidedBy == "" || r.DecidedBy == "default" {
			<span class="ml-1">@Chip("default", "")</span>
		}
	}
}

// factWords is a value as the row's control would say it: a bool as on or
// off, an option by its label.
func factWords(r SettingRowView, v string) string {
	for _, o := range r.Options {
		if o.Value == v {
			return o.Label
		}
	}
	if r.Type == "bool" {
		return onOff(v)
	}
	return v
}

templ settingPenIcon() {
	<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>
}

templ settingUndoIcon() {
	<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7v6h6"></path><path d="M3 13a9 9 0 1 0 3-7"></path></svg>
}

// readOnlyRow is a knob the installer set: its value as text, no input, so
// a save never posts it.
templ readOnlyRow(r SettingRowView) {
	<div data-field data-find-key={ r.Key } data-changed?={ r.Changed } if r.Found { class="is-found" tabindex="-1" autofocus }>
		<span class="settings-label">
			{ knobLabel(r) }
			@FieldMarks(r.Changed, r.From)
		</span>
		if r.Value == "" {
			<p class="text-sm text-rw-faint">Not set.</p>
		} else {
			<p class="font-mono text-sm text-rw-text">{ r.Value }</p>
		}
		if r.Desc != "" {
			<span class="settings-help">{ sentence(r.Desc) }</span>
		}
	</div>
}

templ editRow(form string, r SettingRowView) {
	<div data-field data-find-key={ r.Key } data-changed?={ r.Changed } if r.Found { class="is-found" }>
		@editBody(form, r)
	</div>
}

templ editBody(form string, r SettingRowView) {
		<label for={ form + "-" + r.Key } class="settings-label">
			{ knobLabel(r) }
			@FieldMarks(r.Changed, r.From)
		</label>
		switch {
			case r.Type == "bool":
				<select id={ form + "-" + r.Key } name={ r.Key } data-stored={ r.Value } class="input" autofocus?={ r.Found } { Invalid(r.Key, KeptErr(ctx, r.Key, r.Error))... }>
					if !r.NoInherit {
						<option value="" selected?={ Kept(ctx, r.Key, r.Value) == "" }>{ inheritChoice(r) }</option>
					}
					<option value="true" selected?={ Kept(ctx, r.Key, r.Value) == "true" }>On</option>
					<option value="false" selected?={ Kept(ctx, r.Key, r.Value) == "false" }>Off</option>
				</select>
			case len(r.Options) > 0:
				<select id={ form + "-" + r.Key } name={ r.Key } data-stored={ r.Value } class="input" autofocus?={ r.Found } { Invalid(r.Key, KeptErr(ctx, r.Key, r.Error))... }>
					for _, o := range r.Options {
						<option value={ o.Value } selected?={ Kept(ctx, r.Key, r.Value) == o.Value }>{ o.Label }</option>
					}
				</select>
			case r.Secret:
				<input id={ form + "-" + r.Key } name={ r.Key } type="password" value="" data-stored="" placeholder={ secretHint(r.Effective) } autocomplete="new-password" class="input font-mono" { Invalid(r.Key, KeptErr(ctx, r.Key, r.Error))... }/>
			default:
				<input id={ form + "-" + r.Key } name={ r.Key } data-stored={ r.Value } type={ knobInput(r.Type) } step={ knobStep(r.Type) } value={ Kept(ctx, r.Key, r.Value) } placeholder={ inheritHint(r) } class="input" autofocus?={ r.Found } { Invalid(r.Key, KeptErr(ctx, r.Key, r.Error))... }/>
		}
		if r.Secret {
			<span class="settings-help">{ secretHelp(r.Effective) }</span>
		} else if r.Value == "" && r.Effective != "" && r.From == "" {
			@Inherited(onOff(r.Effective), from(r.DecidedBy))
		}
		if r.Desc != "" {
			<span class="settings-help">{ sentence(r.Desc) }</span>
		}
		@FieldError(r.Key, KeptErr(ctx, r.Key, r.Error))
}

// inheritHint is an empty field's placeholder: nothing on a flat knob, the
// inherited value when the From tag names its rung (the Inherited line is
// then left out), else "inherit".
func inheritHint(r SettingRowView) string {
	if r.NoInherit {
		return ""
	}
	if r.From != "" && r.Effective != "" {
		return r.Effective
	}
	return "inherit"
}

// A stored secret is never rendered: blank keeps it (v0 ProtectFields).
func secretHint(effective string) string {
	if effective == "set" {
		return "unchanged"
	}
	return "not set"
}

func secretHelp(effective string) string {
	if effective == "set" {
		return "Set. Type a new one to replace it."
	}
	return "Not set."
}

func knobInput(t string) string {
	if t == "int" || t == "float" {
		return "number"
	}
	return "text"
}

func knobStep(t string) string {
	if t == "float" {
		return "any"
	}
	return "1"
}

// inheritChoice is the bool's empty option: "Default" when only the
// built-in default sits above this rung, else "Inherit".
func inheritChoice(r SettingRowView) string {
	if r.DecidedBy == "" || r.DecidedBy == "default" {
		return "Default (" + onOff(r.Effective) + ")"
	}
	return "Inherit (" + onOff(r.Effective) + ")"
}
