package components

import "strings"

// SettingsFormView is one rung of the settings cascade (server, org, stack,
// env), one row per catalogue knob the rung may set. The same shape at
// every level; the service answers what applies and who decided it.
type SettingsFormView struct {
	ID       string // form id, unique on the page
	Action   string
	Scope    string // the rung being edited, for the legend
	Rows     []SettingRowView
	ReadOnly bool
	Why      string
	Error    string // a refusal no one row owns
	Note     string // what a save did
	Flat     bool   // one list, no section heads: a Section around it titles it
	// Keys is the rows the form shows, in this order; nil = every row. A
	// key with no row is skipped.
	Keys []string
}

// SettingRowView mirrors a settings.Knob plus the cascade's answer.
type SettingRowView struct {
	Key       string
	Label     string // the catalogue's; "" shows Key
	Desc      string
	Type      string // int | float | bool | string
	Value     string // this rung's value; "" = inherit
	Effective string // what applies here ("set" / "not set" for a secret)
	DecidedBy string // the rung it comes from
	Secret    bool   // never echoed: a password box, blank keeps it
	ReadOnly  bool   // the installer set it: shown as text, never posted
	Error     string
	Changed   bool   // this rung sets it: the dot, and data-changed for settings-find
	From      string // where an inherited value comes from ("org"): a tag after the label
	// NoInherit: a flat knob, no rung above it. No Inherit choice and no
	// "inherit" placeholder.
	NoInherit bool
}

// knobSection is the v0 section each catalogue key sits in; the label is
// the catalogue's (SettingRowView.Label).
var knobSection = map[string]string{
	"cpu_limit":                  "Resources",
	"mem_limit_mb":               "Resources",
	"protect":                    "Protect",
	"protect_user":               "Protect",
	"protect_password":           "Protect",
	"workers":                    "Jobs",
	"backup_run_concurrency":     "Jobs",
	"backup_restore_concurrency": "Jobs",
	"image_check_interval":       "Images",
	"cleanup_enabled":            "Images",
	"orphan_retention_days":      "Volumes",
	"orphans_enabled":            "Volumes",
	"orphans_schedule":           "Volumes",
	"cleanup_schedule":           "Images",
	"registry_cleanup_schedule":  "Images",
	"registry_keep":              "Images",
	"panel_backup_enabled":       "Backups",
	"panel_backup_schedule":      "Backups",
	"panel_backup_keep":          "Backups",
	"panel_backup_dest":          "Backups",
	"observe_enabled":            "Observability",
	"observe_metrics_retention":  "Observability",
	"observe_min_free":           "Observability",
	"observe_logs_enabled":       "Observability",
	"observe_logs_retention":     "Observability",
	"observe_logs_max_size":      "Observability",
	"observe_max_memory":         "Observability",
	"observe_access_query":       "Observability",
	"observe_access_ip":          "Observability",
	"observe_access_headers":     "Observability",
	"panel_domain":               "Panel and proxy",
	"acme_email":                 "Panel and proxy",
	"trusted_proxies":            "Panel and proxy",
	"proxy_custom":               "Panel and proxy",
	"root_domain":                "Panel and proxy",
}

var knobSections = []string{"Resources", "Protect", "Jobs", "Images", "Volumes", "Backups", "Observability", "Panel and proxy", "Other"}

// shown is the rows Keys picks, in Keys order; every row when Keys is nil.
func (v SettingsFormView) shown() []SettingRowView {
	if v.Keys == nil {
		return v.Rows
	}
	by := map[string]SettingRowView{}
	for _, r := range v.Rows {
		by[r.Key] = r
	}
	var out []SettingRowView
	for _, k := range v.Keys {
		if r, ok := by[k]; ok {
			out = append(out, r)
		}
	}
	return out
}

func knobLabel(r SettingRowView) string {
	if r.Label != "" {
		return r.Label
	}
	return r.Key
}

// sectioned groups the rows by v0 section, in section order; a key the
// table does not know lands in "Other".
func sectioned(rows []SettingRowView) [][]SettingRowView {
	by := map[string][]SettingRowView{}
	for _, r := range rows {
		s := "Other"
		if k, ok := knobSection[r.Key]; ok {
			s = k
		}
		by[s] = append(by[s], r)
	}
	var out [][]SettingRowView
	for _, s := range knobSections {
		if len(by[s]) > 0 {
			out = append(out, by[s])
		}
	}
	return out
}

func sectionOf(rows []SettingRowView) string {
	if k, ok := knobSection[rows[0].Key]; ok {
		return k
	}
	return "Other"
}

// sentence is a catalogue description as help text.
func sentence(s string) string {
	if s == "" {
		return ""
	}
	s = strings.ToUpper(s[:1]) + s[1:]
	if !strings.HasSuffix(s, ".") {
		s += "."
	}
	return s
}

// from names the rung a value comes from, as v0's Inherited says it.
func from(rung string) string {
	if rung == "" || rung == "default" {
		return "the built-in default"
	}
	return "the " + rung
}

func onOff(v string) string {
	switch v {
	case "true":
		return "on"
	case "false":
		return "off"
	}
	return v
}

// Option is one choice of a select: the value posted, the words shown.
type Option struct{ Value, Label string }

// ConfigRepoView is the config-as-code binding, the same fields and words
// on the org and the stack.
type ConfigRepoView struct {
	ID          string // the connector select's id
	Connectors  []Option
	Connector   string
	Repo        string
	Branch      string
	Path        string
	File        string // the file read when Path is empty
	Placeholder string // the repository's example
	AutoApply   bool   // offer Auto apply (the org file plans before it applies)
	Auto        bool
}

templ ConfigRepoFields(v ConfigRepoView) {
	<div data-field data-changed?={ v.Connector != "" }>
		<label for={ v.ID + "-connector" } class="label">Connector</label>
		<select id={ v.ID + "-connector" } name="connector" class="input">
			<option value="">None (a public repository)</option>
			for _, o := range v.Connectors {
				<option value={ o.Value } selected?={ o.Value == Kept(ctx, "connector", v.Connector) }>{ o.Label }</option>
			}
		</select>
		<p class="mt-1.5 text-xs text-rw-faint" data-hint>Which connector supplies the credentials.</p>
		@FieldError("connector", KeptErr(ctx, "connector", ""))
	</div>
	@Field(FieldView{Name: "repo", Label: "Repository", Value: v.Repo, Changed: v.Repo != "", Placeholder: v.Placeholder, Help: "owner/name or the https URL, either works."})
	@Field(FieldView{Name: "branch", Label: "Branch", Value: v.Branch, Changed: v.Branch != "", Placeholder: "main", Help: "Empty uses the repository's default branch."})
	@Field(FieldView{Name: "path", Label: "Config path", Value: v.Path, Changed: v.Path != "", Placeholder: v.File, Help: "Empty uses " + v.File + "."})
	if v.AutoApply {
		<input type="hidden" name="fields" value="auto"/>
		<label class="flex items-center gap-2 text-sm text-rw-text" data-field data-changed?={ v.Auto }><input type="checkbox" name="auto" value="1" checked?={ KeptOn(ctx, "auto", v.Auto) } class="accent-rw-accent"/> <span class="settings-label">Auto apply a plan with no impact lines and no removals</span></label>
	}
}

templ SettingsForm(v SettingsFormView) {
	<form id={ v.ID } if !v.ReadOnly { hx-post={ v.Action } } hx-target={ "#" + v.ID } hx-swap="outerHTML" class="space-y-4">
		if v.ReadOnly {
			<p class="banner">{ v.Why }</p>
		}
		@FormError(v.Error)
		if v.Note != "" {
			<p class="banner" role="status">{ v.Note }</p>
		}
		<fieldset disabled?={ v.ReadOnly }>
			<legend class="sr-only">{ v.Scope } settings</legend>
			if v.Flat {
				<div class="space-y-4">
					for _, r := range v.shown() {
						@settingRow(v.ID, r)
					}
				</div>
			} else {
				for _, rows := range sectioned(v.shown()) {
					@PanelSection(v.ID+"-"+strings.ReplaceAll(strings.ToLower(sectionOf(rows)), " ", "-"), sectionOf(rows), "") {
						for _, r := range rows {
							@settingRow(v.ID, r)
						}
					}
				}
			}
			if !v.ReadOnly {
				<div class="flex items-center gap-3 pt-6">
					<button type="submit" class="btn btn-primary btn-sm">Save</button>
				</div>
			}
		</fieldset>
	</form>
}

templ settingRow(form string, r SettingRowView) {
	if r.ReadOnly {
		@readOnlyRow(r)
	} else {
		@editRow(form, r)
	}
}

// readOnlyRow is a knob the installer set: its value as text, no input, so
// a save never posts it.
templ readOnlyRow(r SettingRowView) {
	<div data-field data-changed?={ r.Changed }>
		<span class="settings-label">
			{ knobLabel(r) }
			@FieldMarks(r.Changed, r.From)
		</span>
		if r.Value == "" {
			<p class="text-sm text-rw-faint">Not set.</p>
		} else {
			<p class="font-mono text-sm text-rw-text">{ r.Value }</p>
		}
		if r.Desc != "" {
			<span class="settings-help">{ sentence(r.Desc) }</span>
		}
	</div>
}

templ editRow(form string, r SettingRowView) {
	<div data-field data-changed?={ r.Changed }>
		<label for={ form + "-" + r.Key } class="settings-label">
			{ knobLabel(r) }
			@FieldMarks(r.Changed, r.From)
		</label>
		switch {
			case r.Type == "bool":
				<select id={ form + "-" + r.Key } name={ r.Key } class="input">
					if !r.NoInherit {
						<option value="" selected?={ Kept(ctx, r.Key, r.Value) == "" }>Inherit ({ onOff(r.Effective) })</option>
					}
					<option value="true" selected?={ Kept(ctx, r.Key, r.Value) == "true" }>On</option>
					<option value="false" selected?={ Kept(ctx, r.Key, r.Value) == "false" }>Off</option>
				</select>
			case r.Secret:
				<input id={ form + "-" + r.Key } name={ r.Key } type="password" value="" placeholder={ secretHint(r.Effective) } autocomplete="new-password" class="input font-mono"/>
			default:
				<input id={ form + "-" + r.Key } name={ r.Key } type={ knobInput(r.Type) } step={ knobStep(r.Type) } value={ Kept(ctx, r.Key, r.Value) } placeholder={ inheritHint(r) } class="input"/>
		}
		if r.Secret {
			<span class="settings-help">{ secretHelp(r.Effective) }</span>
		} else if r.Value == "" && r.Effective != "" && r.From == "" {
			@Inherited(onOff(r.Effective), from(r.DecidedBy))
		}
		if r.Desc != "" {
			<span class="settings-help">{ sentence(r.Desc) }</span>
		}
		@FieldError(r.Key, KeptErr(ctx, r.Key, r.Error))
	</div>
}

// inheritHint is an empty field's placeholder: nothing on a flat knob, the
// inherited value when the From tag names its rung (the Inherited line is
// then left out), else "inherit".
func inheritHint(r SettingRowView) string {
	if r.NoInherit {
		return ""
	}
	if r.From != "" && r.Effective != "" {
		return r.Effective
	}
	return "inherit"
}

// A stored secret is never rendered: blank keeps it (v0 ProtectFields).
func secretHint(effective string) string {
	if effective == "set" {
		return "unchanged"
	}
	return "not set"
}

func secretHelp(effective string) string {
	if effective == "set" {
		return "Set. Type a new one to replace it."
	}
	return "Not set."
}

func knobInput(t string) string {
	if t == "int" || t == "float" {
		return "number"
	}
	return "text"
}

func knobStep(t string) string {
	if t == "float" {
		return "any"
	}
	return "1"
}
